# Normalize text line endings in the repository regardless of local Git settings.
* text=auto

/.gitattributes text eol=lf
docs/internal/archive/operations/public_repo_release_allowlist_2026-07-28.txt text eol=lf
docs/internal/archive/operations/public_repo_release_allowlist_2026-08-24.txt -text whitespace=cr-at-eol
docs/internal/public_repo_release_allowlist_2026-11-13.txt text eol=lf
docs/internal/public_repo_release_artifact_manifest_2026-08-12.tsv text eol=lf

# Preserve upstream legal originals without newline conversion.
third_party/pdfium/licenses/dragonbox-Apache2-LLVM.txt -text
third_party/pdfium/licenses/dragonbox-Boost.txt -text
third_party/pdfium/licenses/freetype.txt -text
third_party/pdfium/licenses/harfbuzz.txt -text
third_party/pdfium/licenses/highway.txt -text

# Preserve the reviewed PDFium package hashes across checkouts.
third_party/pdfium/bin/pdfium.dll -text
third_party/pdfium/include/**/*.h -text
third_party/pdfium/lib/pdfium.dll.lib -text

# PDF offsets and linked-note hashes depend on the original bytes.
*.pdf -text

STATISTICS.md text eol=lf
docs/statistics/** text eol=lf

# Preserve reviewed MicroTeX bytes, upstream notices and patch context.
/third_party/microtex/** -text -whitespace
