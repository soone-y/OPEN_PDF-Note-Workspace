+// GetTempFileNameW has a legacy path limit even when file I/O accepts an
+// extended path. Reserve a random name atomically with CREATE_NEW instead.
 oslFileError SAL_CALL osl_createTempFile(
-    rtl_uString*   pustrDirectoryURL,
-    oslFileHandle* pHandle,
-    rtl_uString**  ppustrTempFileURL)
-{
-    rtl_uString*    base_directory = nullptr;
-    LPWSTR          tmp_name;
-    sal_Bool        b_delete_on_close;
-    oslFileError    osl_error;
-
-    osl_error = osl_setup_createTempFile_impl_(
-        pustrDirectoryURL,
-        pHandle,
-        ppustrTempFileURL,
-        &base_directory,
-        &b_delete_on_close);
-
-    if (osl_error != osl_File_E_None)
-        return osl_error;
-
-    /* allocate enough space on the stack, the file name can not be longer than MAX_PATH */
-    STACK_ALLOC(tmp_name, WCHAR, (rtl_uString_getLength(base_directory) + MAX_PATH));
-
-    if (tmp_name)
-    {
-        osl_error = osl_createTempFile_impl_(
-            base_directory,
-            tmp_name,
-            b_delete_on_close,
-            pHandle,
-            ppustrTempFileURL);
-    }
-    else // stack alloc failed
-    {
-        osl_error = osl_File_E_NOMEM;
-    }
-
-    if (base_directory)
-        rtl_uString_release(base_directory);
-
-    return osl_error;
+    rtl_uString* pustrDirectoryURL, oslFileHandle* pHandle,
+    rtl_uString** ppustrTempFileURL)
+{
+    OUString base;
+    sal_Bool deleteOnClose = false;
+    oslFileError error = osl_setup_createTempFile_impl_(
+        pustrDirectoryURL, pHandle, ppustrTempFileURL, &base.pData, &deleteOnClose);
+    if (error != osl_File_E_None)
+        return error;
+    if (pHandle)
+        *pHandle = nullptr;
+
+    std::wstring directory(o3tl::toW(base.getStr()));
+    if (directory.size() >= 3 && directory[1] == L':' && directory[2] == L'\\')
+        directory.insert(0, L"\\\\?\\");
+    if (!directory.empty() && directory.back() != L'\\')
+        directory += L'\\';
+    // 3 prefix characters, 32 random hex characters, suffix and terminating NUL.
+    if (directory.size() + 3 + 32 + 4 + 1 > EXTENDED_MAX_PATH)
+        return osl_File_E_NAMETOOLONG;
+
+    constexpr wchar_t hex[] = L"0123456789abcdef";
+    for (unsigned attempt = 0; attempt < 128; ++attempt)
+    {
+        unsigned char random[16];
+        if (rtl_random_getBytes(nullptr, random, sizeof(random)) != rtl_Random_E_None)
+            return osl_File_E_IO;
+        std::wstring name = directory;
+        LPCWSTR prefix = getEyeCatcher();
+        for (unsigned i = 0; i < 3 && prefix[i]; ++i)
+            name += prefix[i];
+        for (unsigned char value : random)
+        {
+            name += hex[value >> 4];
+            name += hex[value & 15];
+        }
+        name += L".tmp";
+        OUString url;
+        if (ppustrTempFileURL)
+        {
+            OUString native(o3tl::toU(name.c_str()));
+            error = osl_getFileURLFromSystemPath(native.pData, &url.pData);
+            if (error != osl_File_E_None)
+                return error;
+        }
+        HANDLE file = CreateFileW(name.c_str(), GENERIC_READ | GENERIC_WRITE, 0,
+            nullptr, CREATE_NEW, FILE_ATTRIBUTE_NORMAL
+                | (deleteOnClose ? FILE_FLAG_DELETE_ON_CLOSE : 0), nullptr);
+        if (!IsValidHandle(file))
+        {
+            const DWORD cause = GetLastError();
+            if (cause == ERROR_FILE_EXISTS || cause == ERROR_ALREADY_EXISTS)
+                continue;
+            return oslTranslateFileError(cause);
+        }
+        if (pHandle)
+            *pHandle = osl_createFileHandleFromOSHandle(file,
+                osl_File_OpenFlag_Read | osl_File_OpenFlag_Write);
+        else
+            CloseHandle(file);
+        if (ppustrTempFileURL)
+            rtl_uString_assign(ppustrTempFileURL, url.pData);
+        return osl_File_E_None;
+    }
+    return osl_File_E_EXIST;
 }
 
 oslFileError SAL_CALL osl_getTempDirURL(rtl_uString** pustrTempDir)
 {
+    // GetTempPathW can ignore over-MAX_PATH environment values and select the
+    // Windows directory instead. An explicit temporary path must never fall
+    // back to a different writable location, even if it cannot be converted.
+    for (LPCWSTR variable : {L"TMP", L"TEMP"})
+    {
+        DWORD required = GetEnvironmentVariableW(variable, nullptr, 0);
+        if (!required)
+            continue;
+        if (required > EXTENDED_MAX_PATH)
+            return osl_File_E_NAMETOOLONG;
+        std::wstring value(required, L'\0');
+        DWORD count = GetEnvironmentVariableW(variable, value.data(), required);
+        if (!count || count >= required)
+            return osl_File_E_INVAL;
+        value.resize(count);
+        const bool drivePath = value.size() >= 3 && value[1] == L':'
+            && (value[2] == L'\\' || value[2] == L'/');
+        const bool extendedDrivePath = value.size() >= 7
+            && value.compare(0, 4, L"\\\\?\\") == 0 && value[5] == L':'
+            && value[6] == L'\\';
+        if (!drivePath && !extendedDrivePath)
+            return osl_File_E_INVAL;
+        if (value.size() > 3 && value.back() == L'\\')
+            value.pop_back();
+        OUString native(o3tl::toU(value.c_str()));
+        return osl_getFileURLFromSystemPath(native.pData, pustrTempDir);
+    }
+
     osl::LongPathBuffer<sal_Unicode> aBuffer(EXTENDED_MAX_PATH);
     LPWSTR  lpBuffer = o3tl::toW(aBuffer);
     DWORD   nBufferLength = aBuffer.getBufSizeInSymbols() - 1;
