From: PDF Note Workspace <local@example.invalid>
Date: Wed, 7 Oct 2026 02:30:00 +0900
Subject: [PATCH] Support long Windows paths without temporary-directory fallback

Accept absolute long system paths when producing file URLs, avoid duplicate
separators in extended-path directory enumeration, and use explicit TMP/TEMP
without GetTempPathW fallback. Reserve temporary files with CREATE_NEW and
dynamic names instead of the legacy GetTempFileNameW limit.

diff --git a/sal/osl/w32/file_url.cxx b/sal/osl/w32/file_url.cxx
--- a/sal/osl/w32/file_url.cxx
+++ b/sal/osl/w32/file_url.cxx
@@ -580,7 +580,7 @@
     wchar_t* const pPath = szPath;
     wchar_t* pEnd = pPath;
     size_t sysPathOffset = 0;
-    if (sysPath.size() >= MAX_PATH && isAbsolute(sysPath)
+    if (sysPath.size() >= MAX_PATH - 12 && isAbsolute(sysPath)
         && !o3tl::starts_with(sysPath, WSTR_LONG_PATH_PREFIX))
     {
         // Allow GetLongPathNameW consume long paths
@@ -684,14 +684,14 @@
             else
             {
                 /* do not separate the directory and file case, so the maximal path length without prefix is MAX_PATH-12 */
-                if ( nDecodedLen - nSkip <= MAX_PATH - 12 )
+                if ( nDecodedLen - nSkip < MAX_PATH - 12 )
                 {
                     sTempPath = sDecodedURL->subView(nSkip);
                 }
                 else
                 {
                     sDecodedURL = GetCaseCorrectPathName(sDecodedURL->subView(nSkip));
-                    if (sDecodedURL->getLength() <= MAX_PATH - 12
+                    if (sDecodedURL->getLength() < MAX_PATH - 12
                         || sDecodedURL->startsWith(WSTR_SYSTEM_ROOT_PATH)
                         || sDecodedURL->startsWith(WSTR_LONG_PATH_PREFIX))
                     {
@@ -741,13 +741,20 @@
     OUString sTempURL;
     DWORD dwPathType = PATHTYPE_ERROR;
 
+    // System paths returned by Windows and by internal path joins may be
+    // longer than MAX_PATH without an extended prefix. URL conversion is not
+    // a legacy Win32 filesystem call: validate absolute drive paths using the
+    // extended form, then emit the same canonical file URL as prefixed input.
+    OUString sPath = strPath ? OUString::unacquired(&strPath) : OUString();
+    if (sPath.getLength() >= MAX_PATH && startsWithDriveColon(sPath)
+        && sPath[2] == '\\')
+        sPath = WSTR_LONG_PATH_PREFIX + sPath;
     if (strPath)
-        dwPathType = IsValidFilePath(OUString::unacquired(&strPath), VALIDATEPATH_ALLOW_RELATIVE, nullptr);
+        dwPathType = IsValidFilePath(sPath, VALIDATEPATH_ALLOW_RELATIVE, nullptr);
 
     if (dwPathType)
     {
         OUString sTempPath;
-        const OUString& sPath = OUString::unacquired(&strPath);
 
         if ( dwPathType & PATHTYPE_IS_LONGPATH )
         {
