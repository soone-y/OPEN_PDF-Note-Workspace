diff --git a/configure.ac b/configure.ac
--- a/configure.ac
+++ b/configure.ac
@@ -4532,4 +4532,12 @@ find_msvc()
         if test -n "$vswhereoutput"; then
+            # MSYS cannot convert a Visual Studio installation path with
+            # spaces when 8.3 names are disabled.  The local build runner
+            # may provide an equivalent no-space junction, for example
+            # D:/vs18, after vswhere has selected the installed version.
+            if test -n "$LIBO_MSVS_ROOT"; then
+                vctest="$LIBO_MSVS_ROOT"
+            else
             PathFormat "$vswhereoutput"
             vctest=$formatted_path_unix
+            fi
             break
