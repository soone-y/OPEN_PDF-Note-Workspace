diff --git a/src/md4c.c b/src/md4c.c
--- a/src/md4c.c
+++ b/src/md4c.c
@@ -7030,7 +7030,24 @@
         line->type = MD_LINE_TEXT;
         if(pivot_line->type == MD_LINE_TEXT  &&  n_brothers + n_children == 0) {
             /* Lazy continuation. */
-            n_parents = ctx->n_containers;
+            if(ctx->parser.flags & MD_FLAG_NOQUOTE_LAZY_CONTINUATION) {
+                /* Preserve implicit list parents, stopping at a missing quote
+                 * marker. Cache the list-only interval to keep deep lists linear. */
+                n_implicit_parents_beg = n_parents;
+                while(n_parents < ctx->n_containers && ctx->containers[n_parents].ch != _T('>')) {
+                    if(ctx->last_n_implicit_parents_beg <= n_parents &&
+                       n_parents < ctx->last_n_implicit_parents_end &&
+                       ctx->last_n_implicit_parents_end <= ctx->n_containers)
+                    {
+                        n_parents = ctx->last_n_implicit_parents_end;
+                    } else {
+                        n_parents++;
+                    }
+                }
+                n_implicit_parents_end = n_parents;
+            } else {
+                n_parents = ctx->n_containers;
+            }
         }
 
         /* Check for task mark. */
diff --git a/src/md4c.h b/src/md4c.h
--- a/src/md4c.h
+++ b/src/md4c.h
@@ -406,6 +406,7 @@
 #define MD_FLAG_HIGHLIGHT                   0x200000 /* Enable ==highlight== spans. */
 #define MD_FLAG_PRESERVEBLANKLINES          0x400000 /* Report blank line runs as MD_BLOCK_BLANK. */
 #define MD_FLAG_INSERT                      0x800000 /* Enable insert extension. */
+#define MD_FLAG_NOQUOTE_LAZY_CONTINUATION   0x1000000 /* App extension: require explicit quote markers on continuation lines. */
 
 #define MD_FLAG_PERMISSIVEAUTOLINKS         (MD_FLAG_PERMISSIVEEMAILAUTOLINKS | MD_FLAG_PERMISSIVEURLAUTOLINKS | MD_FLAG_PERMISSIVEWWWAUTOLINKS)
 #define MD_FLAG_NOHTML                      (MD_FLAG_NOHTMLBLOCKS | MD_FLAG_NOHTMLSPANS)
