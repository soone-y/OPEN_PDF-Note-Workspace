    {
      "id": "note.persistence",
      "component": "note",
      "level": "contract",
      "owner": "note/workspace persistence",
      "output": "recoverable persisted note",
      "input": "note identity and content"
    },
    {
      "id": "note.presentation",
      "component": "note",
      "level": "contract",
      "owner": "view presentation",
      "output": "geometry/frame/pixels/caret",
      "input": "text snapshot and viewport"
