{
  "schema_version": 1,
  "purpose": "GitHub Pagesの文書ポータルに含めてよいリポジトリ正本を明示する許可リスト",
  "version_source": "REPO_VERSION.txt",
  "documentation_portal": {
    "files": [
      { "source": "site/github/index.html", "destination": "index.html" },
      { "source": "REPO_VERSION.txt", "destination": "REPO_VERSION.txt" },
      { "source": "README.md", "destination": "README.md" },
      { "source": "DOCUMENTATION.md", "destination": "DOCUMENTATION.md" },
      { "source": "LICENSE.md", "destination": "LICENSE.md" },
      { "source": "LICENSES_INDEX.md", "destination": "LICENSES_INDEX.md" },
      { "source": "THIRD_PARTY_NOTICES.md", "destination": "THIRD_PARTY_NOTICES.md" },
      { "source": ".github/SECURITY.md", "destination": ".github/SECURITY.md" },
      { "source": "docs/案内ドキュメントの構成.md", "destination": "docs/案内ドキュメントの構成.md" },
      { "source": "docs/images/app_overview.png", "destination": "docs/images/app_overview.png" },
      { "source": "site/github/en/index.html", "destination": "en/index.html" }
    ],
    "trees": [
      { "source": "introduction", "destination": "introduction" },
      { "source": "docs/ja", "destination": "docs/ja" },
      { "source": "docs/en", "destination": "docs/en" }
    ]
  },
  "pages_submission": {
    "files": [
      { "source": ".github/FUNDING.yml", "destination": ".github/FUNDING.yml" },
      { "source": ".github/workflows/static.yml", "destination": ".github/workflows/static.yml" },
      {
        "source": "site/github/public.gitignore",
        "destination": ".gitignore"
      },
      {
        "source": "site/github/index.html",
        "destination": "site/github/index.html"
      },
      {
        "source": "site/github/en/index.html",
        "destination": "site/github/en/index.html"
      },
      {
        "source": "site/github/documentation_portal_allowlist.json",
        "destination": "site/github/documentation_portal_allowlist.json"
      },
      {
        "source": "site/github/scripts/build_public_site.py",
        "destination": "site/github/scripts/build_public_site.py"
      },
      {
        "source": "site/github/scripts/render_human_docs.py",
        "destination": "site/github/scripts/render_human_docs.py"
      },
      {
        "source": "site/github/scripts/validate_public_site.py",
        "destination": "site/github/scripts/validate_public_site.py"
      }
    ],
    "retired_paths": [
      "index.html"
    ]
  }
