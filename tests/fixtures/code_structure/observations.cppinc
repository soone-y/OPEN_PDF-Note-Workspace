// Literal content must be preserved; comments do not affect lexical clones.
int CloneFirst(int n) {
    int value = 0;
    for (int i = 0; i < n; ++i) {
        if (i % 2 == 0) value += i * 3;
        else value -= i + 4;
    }
    return value + n;
}
