                                                                                                  "note_view/note_view_note_ops.cppinc",
                                                                                                  "note_view/note_view_bottom_panes.cppinc",
                                                                                                  "note_view/note_view_input.cppinc"
                                                                                              ]
                                                          },
                                  "IntentionalUnityBuildRoots":  [
                                                                     "src/main.cpp",
                                                                     "src/note_view/note_view.cpp",
                                                                     "src/pdf_view/pdf_view.cpp"
                                                                 ],
                                  "Strategy":  "Hybrid"
                              },
