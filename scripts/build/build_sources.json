    "TranslationUnitDesign":  {
                                  "Notes":  [
                                                "Standalone .cpp TU: settings, settings_core_api, main/startup_instance, main/wheel_routing, note_view/bottom_math_panel, file_output, clrop, note/*, core/app_core, etc.",
                                                "Unity roots aggregate .cppinc only when shared static state must stay in one TU.",
                                                "Prefer new .cpp TU over new .cppinc when splitting; see docs/internal/app_コード健全化モジュール分割実装計画_2026-05-22.md.",
                                                  "note_parser_checkpoint, note_source_coordinate_transform, note_syntax_snapshot, note_syntax_document, note_render_layout_snapshot, note_render_source_plan, note_render_placement_snapshot, note_presentation_owner_plan, and note_render_final_* form the one atomic final note-render route. note_view_final_render.cppinc is the only Win32 bridge: it publishes a complete immutable frame before paint and selects whole-native fallback when publication cannot be proven. Do not reintroduce a legacy overlay as a third paint path."
                                            ],
                                  "UnityBuildFragments":  {
                                                              "src/main.cpp":  [
                                                                                   "workspace/workspace_controller.cppinc",
                                                                                   "ui/core/main_view_layout.cppinc",
                                                                                   "app/operations.cppinc",
                                                                                   "app/command_dispatch.cppinc",
                                                                                   "ui/core/main_window_proc.cppinc",
                                                                                   "app/bootstrap.cppinc"
                                                                               ],
                                                              "src/pdf_view/pdf_view.cpp":  [
                                                                                                "pdf_view/navigation.cppinc",
                                                                                                "pdf_view/render.cppinc",
                                                                                                "pdf_view/input.cppinc"
                                                                                            ],
                                                              "src/note_view/note_view.cpp":  [
                                                                                                  "note_view/note_view_shared.cppinc",
