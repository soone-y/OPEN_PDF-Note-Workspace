// file: settings/settings_unified.cppinc
// Included by settings.cpp (single TU).

namespace {
static void ShowUnifiedSettingsDialog(HWND owner, int initialCategory, int initialAnnotSection,
                                     PaletteDialogRequest* paletteRequest) {
    static const wchar_t kClass[] = L"UnifiedSettingsShellClass";
    static bool registered = false;
    if (!registered) {
        WNDCLASSW wc{};
        wc.lpfnWndProc = UnifiedSettingsShellProc;
        wc.hInstance = g_hInst;
        wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
        wc.hbrBackground = g_hThemeWindowBrush ? g_hThemeWindowBrush
                                               : reinterpret_cast<HBRUSH>(COLOR_WINDOW + 1);
        wc.lpszClassName = kClass;
        RegisterClassW(&wc);
        registered = true;
    }

    if (owner) { if (HWND root = GetAncestor(owner, GA_ROOT)) owner = root; }
    UnifiedSettingsShellCtx ctx{};
    ctx.owner = owner;
    ctx.currentCategory = std::clamp(initialCategory, 0, settings_navigation::Count - 1);
    ctx.initialAnnotSection = initialAnnotSection;
    ctx.paletteRequest = paletteRequest;

    if (owner) EnableWindow(owner, FALSE);
    const int dpiRef = GetDpiY(owner);
    MONITORINFO monitor{sizeof(monitor)};
    const bool measured = GetMonitorInfoW(MonitorFromWindow(owner, MONITOR_DEFAULTTONEAREST), &monitor) != FALSE;
    const int wPx = std::min<int>(MulDiv(kUnifiedSettingsDlgWidth, dpiRef, 96), measured ? monitor.rcWork.right - monitor.rcWork.left : GetSystemMetrics(SM_CXSCREEN));
    const int hPx = std::min<int>(MulDiv(kUnifiedSettingsDlgHeight, dpiRef, 96), measured ? monitor.rcWork.bottom - monitor.rcWork.top : GetSystemMetrics(SM_CYSCREEN));
    HWND w = CreateWindowExW(WS_EX_DLGMODALFRAME, kClass,
                             GetUiText().menuSettings.c_str(),
                             WS_CAPTION | WS_POPUPWINDOW,
                             CW_USEDEFAULT, CW_USEDEFAULT, wPx, hPx,
                             owner, nullptr, g_hInst, &ctx);
    if (!w) {
        if (owner) EnableWindow(owner, TRUE);
        return;
    }
    RegisterAppExitBlockingDialog(w);
    PlaceOwnedPopupAtAppTopLeft(w, owner);

    ShowWindow(w, SW_SHOW);
    UpdateWindow(w);
    MSG msg;
    while (!ctx.done && GetMessageW(&msg, nullptr, 0, 0)) {
        if (HandleWorkspaceMemoMessage(msg)) continue;
        if (ShouldSkipImeMessageInModalLoop(msg)) continue;
        if (msg.message == WM_KEYDOWN && msg.wParam == VK_ESCAPE && ctx.paletteCtx &&
            ctx.paletteCtx->eyedropperActive) {
            ctx.paletteCtx->eyedropperActive = false;
            if (GetCapture() == ctx.childPalette) ReleaseCapture();
            continue; // First Escape cancels sampling, not the settings draft.
        }
        if (ui::ConsumeNoOpEdgeNavKeyForMultilineEdit(msg, g_hNoteEdit)) continue;
        const HWND previousFocus = GetFocus();
        if (!IsDialogMessageW(w, &msg)) {
            TranslateMessage(&msg);
            DispatchMessageW(&msg);
        }
        if (!ctx.done && previousFocus != GetFocus()) RevealUnifiedSettingsFocus(&ctx);
    }
    if (ctx.deferredCommand == ID_SETTINGS_PRESETS) ShowSettingsPresetDialog(g_hMainWnd);
    if (ctx.deferredCommand == ID_WORKSPACE_RESTORE) ShowWorkspaceRestoreDialog(g_hMainWnd);
}
} // namespace

bool SelectColorInPaletteSettings(HWND owner, COLORREF initial, COLORREF* outColor) {
    if (!outColor) return false;
    // Embedded settings pages are not modal owners: disable their entire shell,
    // so it cannot close and invalidate the caller while color selection runs.
    if (owner) {
        HWND root = GetAncestor(owner, GA_ROOT);
        if (root) owner = root;
    }
    PaletteDialogRequest request{};
    request.initialColor = initial;
    ShowUnifiedSettingsDialog(owner, kSettingsNavPalette, -1, &request);
    if (request.accepted) *outColor = request.selectedColor;
    return request.accepted;
}

void ShowAnnotationPaletteSettingsDialog(HWND owner) {
    PaletteDialogRequest request{};
    request.purpose = PaletteDialogPurpose::EditAnnotationPalette;
    request.initialColor = g_paletteCustomColor;
    ShowUnifiedSettingsDialog(owner, kSettingsNavPalette, -1, &request);
}

void ShowAnnotationSettingsDialog(HWND owner) {
    ShowUnifiedSettingsDialog(owner, kSettingsNavAnnot, kAnnotSectionText);
}

static int AnnotSettingsSectionForTool(ToolMode mode) {
    switch (mode) {
    case ToolMode::TextBox:
        return kAnnotSectionText;
    case ToolMode::MarkerText:
    case ToolMode::MarkerTextUnderline:
    case ToolMode::MarkerTextColor:
    case ToolMode::MarkerFree:
        return kAnnotSectionMarker;
    case ToolMode::Shape:
        return kAnnotSectionShape;
    case ToolMode::Magnifier:
        return kAnnotSectionLensPalette;
    case ToolMode::Freehand:
    case ToolMode::Line:
    case ToolMode::Arrow:
    case ToolMode::Wave:
    case ToolMode::MarkerLine:
    case ToolMode::MarkerArrow:
    case ToolMode::MarkerWave:
        return kAnnotSectionStroke;
    case ToolMode::Select:
    case ToolMode::Pan:
    case ToolMode::Eraser:
    default:
        return kAnnotSectionToolbar;
    }
}

void ShowAnnotationSettingsForTool(HWND owner, ToolMode mode) {
    ShowUnifiedSettingsDialog(owner, kSettingsNavAnnot, AnnotSettingsSectionForTool(mode));
}

static void LogPanelEvent(const wchar_t* panel,
                          const wchar_t* tag,
                          int id,
                          int code,
                          HWND from) {
    SYSTEMTIME st{};
    GetLocalTime(&st);
    wchar_t buf[512]{};
    swprintf(buf, 512,
             L"%04u-%02u-%02u %02u:%02u:%02u.%03u | %ls | %ls | id=%d code=%d from=0x%p\r\n",
             st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond, st.wMilliseconds,
             panel ? panel : L"(panel)", tag ? tag : L"(tag)", id, code, from);
    OutputDebugStringW(buf);
}



void ShowOutputSettingsDialog(HWND owner, bool noteOutput) {
    ShowUnifiedSettingsDialog(owner, noteOutput ? kSettingsNavOutputNote : kSettingsNavOutput);
}

void ShowBottomPaneSettingsDialog(HWND owner) {
    ShowUnifiedSettingsDialog(owner, kSettingsNavBottomPane);
}
