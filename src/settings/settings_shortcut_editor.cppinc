// file: settings/settings_shortcut_editor.cppinc
// Editable direct bindings and a read-only overview of common fixed shortcuts.

#include "core/localization.h"
#include "ui/shortcut_help.h"
#include "settings/shortcut_key_model.h"

namespace {

constexpr int kShortcutEditorList = 5201;
constexpr int kShortcutEditorKey = 5202;
constexpr int kShortcutEditorTarget = 5203;
constexpr int kShortcutEditorAdd = 5204;
constexpr int kShortcutEditorDelete = 5205;
constexpr int kShortcutEditorUpdate = 5206;
constexpr int kShortcutEditorDigits = 5207;
constexpr int kShortcutEditorHint = 5208;
constexpr int kShortcutEditorListLabel = 5209;
constexpr int kShortcutEditorFixedLabel = 5210;
constexpr int kShortcutEditorFixed = 5211;
constexpr int kShortcutEditorKeyLabel = 5212;
constexpr int kShortcutEditorTargetLabel = 5213;
constexpr int kShortcutEditorSaveHint = 5214;
constexpr int kShortcutEditorCtrl = 5215;
constexpr int kShortcutEditorShift = 5216;
constexpr int kShortcutEditorAlt = 5217;
constexpr int kShortcutEditorPreview = 5218;
constexpr int kShortcutEditorStatus = 5219;
constexpr int kShortcutEditorCapture = 5220;

struct AnnotShortcutEditorCtx {
    HWND owner = nullptr;
    bool done = false;
    bool ok = false;
    HWND list = nullptr;
    HWND key = nullptr;
    HWND target = nullptr;
    int currentIndex = -1;
    bool capturing = false;
    bool drainingKeys = false;
    UINT capturedKey = 0;
    std::vector<AnnotToolShortcutBinding> bindings;
};

static std::wstring ShortcutEditorTargetLabel(AnnotToolShortcutTargetKind kind,
                                              AnnotToolFamily family, ToolMode mode) {
    if (kind == AnnotToolShortcutTargetKind::Category) {
        switch (family) {
        case AnnotToolFamily::Select: return localization::Text(L"settings.shortcut.target.category_select");
        case AnnotToolFamily::Pan: return localization::Text(L"settings.shortcut.target.category_pan");
        case AnnotToolFamily::Magnifier: return localization::Text(L"settings.shortcut.target.category_magnifier");
        case AnnotToolFamily::Text: return localization::Text(L"settings.shortcut.target.category_text");
        case AnnotToolFamily::Marker: return localization::Text(L"settings.shortcut.target.category_marker");
        case AnnotToolFamily::Pen: return localization::Text(L"settings.shortcut.target.category_pen");
        case AnnotToolFamily::Shape: return localization::Text(L"settings.shortcut.target.category_shape");
        case AnnotToolFamily::Eraser: return localization::Text(L"settings.shortcut.target.category_eraser");
        default: return localization::Text(L"settings.shortcut.target.category");
        }
    }
    if (family == AnnotToolFamily::Shape) {
        if (AnnotToolUsesGeometry(mode, AnnotToolGeometry::Shape)) {
            return localization::Text(L"settings.shortcut.target.detail_shape");
        }
        const bool emphasis = IsEmphasisAnnotToolMode(mode, g_shapeDrawMode);
        if (IsArrowAnnotToolMode(mode)) return localization::Text(emphasis ? L"settings.shortcut.target.emphasis_arrow" : L"settings.shortcut.target.stroke_arrow");
        if (IsWaveAnnotToolMode(mode)) return localization::Text(emphasis ? L"settings.shortcut.target.emphasis_wave" : L"settings.shortcut.target.stroke_wave");
        return localization::Text(emphasis ? L"settings.shortcut.target.emphasis_line" : L"settings.shortcut.target.stroke_line");
    }
    switch (mode) {
    case ToolMode::MarkerText: return localization::Text(L"settings.shortcut.target.detail_marker");
    case ToolMode::MarkerTextUnderline: return localization::Text(L"settings.shortcut.target.detail_marker_underline");
    case ToolMode::MarkerTextColor: return localization::Text(L"settings.shortcut.target.detail_marker_text_color");
    case ToolMode::MarkerFree: return localization::Text(L"settings.shortcut.target.detail_free_marker");
    case ToolMode::TextBox: return localization::Text(L"settings.shortcut.target.detail_text");
    case ToolMode::Freehand: return localization::Text(L"settings.shortcut.target.detail_pen");
    case ToolMode::Select: return localization::Text(L"settings.shortcut.target.detail_select");
    case ToolMode::Pan: return localization::Text(L"settings.shortcut.target.detail_pan");
    case ToolMode::Magnifier: return localization::Text(L"settings.shortcut.target.detail_magnifier");
    case ToolMode::Eraser: return localization::Text(L"settings.shortcut.target.detail_eraser");
    default: return localization::Text(L"settings.shortcut.target.detail");
    }
}

static bool ShortcutEditorChecked(HWND window, int id) {
    return SendDlgItemMessageW(window, id, BM_GETCHECK, 0, 0) == BST_CHECKED;
}

static void SetShortcutEditorChord(AnnotShortcutEditorCtx* ctx, UINT vk, bool ctrl, bool alt, bool shift) {
    HWND window = GetParent(ctx->key);
    const int count = static_cast<int>(SendMessageW(ctx->key, CB_GETCOUNT, 0, 0));
    SendMessageW(ctx->key, CB_SETCURSEL, -1, 0);
    for (int i = 0; i < count; ++i) {
        if (static_cast<UINT>(SendMessageW(ctx->key, CB_GETITEMDATA, i, 0)) == vk) {
            SendMessageW(ctx->key, CB_SETCURSEL, i, 0);
            break;
        }
    }
    SendDlgItemMessageW(window, kShortcutEditorCtrl, BM_SETCHECK, ctrl ? BST_CHECKED : BST_UNCHECKED, 0);
    SendDlgItemMessageW(window, kShortcutEditorAlt, BM_SETCHECK, alt ? BST_CHECKED : BST_UNCHECKED, 0);
    SendDlgItemMessageW(window, kShortcutEditorShift, BM_SETCHECK, shift ? BST_CHECKED : BST_UNCHECKED, 0);
}

// This draft belongs to this modal dialog. Only the existing atomic Save path
// changes disk/runtime bindings; validation, capture and cancellation never do.
[[nodiscard]] static bool ReadShortcutEditorChord(AnnotShortcutEditorCtx* ctx,
                                                AnnotToolShortcutBinding& parsed, std::wstring& status) {
    HWND window = GetParent(ctx->key);
    const int selected = static_cast<int>(SendMessageW(ctx->key, CB_GETCURSEL, 0, 0));
    const UINT vk = selected < 0 ? 0 : static_cast<UINT>(SendMessageW(ctx->key, CB_GETITEMDATA, selected, 0));
    const auto chord = shortcut_key_model::Format(vk, ShortcutEditorChecked(window, kShortcutEditorCtrl),
        ShortcutEditorChecked(window, kShortcutEditorAlt), ShortcutEditorChecked(window, kShortcutEditorShift));
    const bool parsedOk = ParseAnnotToolShortcutKeyForUser(chord, parsed);
    parsed.key = chord;
    if (!parsedOk) {
        status = localization::Text(L"settings.shortcut.modifier_required");
        return false;
    }
    if (IsReservedAnnotToolShortcut(parsed)) {
        status = localization::Text(IsFixedAnnotToolNavigationShortcut(parsed)
            ? L"settings.shortcut.reserved_navigation" : L"settings.shortcut.reserved");
        return false;
    }
    for (size_t i = 0; i < ctx->bindings.size(); ++i) {
        const auto& other = ctx->bindings[i];
        if (static_cast<int>(i) != ctx->currentIndex && other.vk == parsed.vk &&
            other.ctrl == parsed.ctrl && other.alt == parsed.alt && other.shift == parsed.shift) {
            status = localization::Text(L"settings.shortcut.duplicate") + L"\r\n" +
                ShortcutEditorTargetLabel(other.targetKind, other.family, other.mode);
            return false;
        }
    }
    const auto* common = application_shortcuts::Resolve(parsed.vk, parsed.ctrl, parsed.alt, parsed.shift,
                                                        application_shortcuts::Surface::Main);
    status = common ? localization::Text(L"settings.shortcut.overrides_action") + L" " +
        localization::Text(common->mainLabel) : localization::Text(L"settings.shortcut.available");
    return true;
}

static void RefreshShortcutEditorDraft(AnnotShortcutEditorCtx* ctx) {
    HWND window = GetParent(ctx->key);
    AnnotToolShortcutBinding parsed;
    std::wstring status;
    const bool hasRow = ctx->currentIndex >= 0;
    const bool valid = hasRow && ReadShortcutEditorChord(ctx, parsed, status);
    SetWindowTextW(GetDlgItem(window, kShortcutEditorPreview), parsed.key.c_str());
    SetWindowTextW(GetDlgItem(window, kShortcutEditorStatus),
        ctx->capturing ? localization::Text(L"settings.shortcut.capture_hint").c_str() : status.c_str());
    EnableWindow(GetDlgItem(window, IDOK), !ctx->capturing && (!hasRow || valid));
    EnableWindow(GetDlgItem(window, kShortcutEditorUpdate), !ctx->capturing && valid);
    SetWindowTextW(GetDlgItem(window, kShortcutEditorCapture), localization::Text(ctx->capturing
        ? L"settings.shortcut.capture_stop" : L"settings.shortcut.capture").c_str());
}

static void RefreshShortcutEditorList(AnnotShortcutEditorCtx* ctx, int select = -1) {
    if (!ctx || !ctx->list) return;
    SendMessageW(ctx->list, LB_RESETCONTENT, 0, 0);
    SetWindowTextW(GetDlgItem(GetParent(ctx->list), kShortcutEditorFixed), shortcut_help::CommonOverview(ctx->bindings).c_str());
    for (const auto& binding : ctx->bindings) {
        std::wstring text = binding.key + L"  →  " +
            ShortcutEditorTargetLabel(binding.targetKind, binding.family, binding.mode);
        SendMessageW(ctx->list, LB_ADDSTRING, 0, reinterpret_cast<LPARAM>(text.c_str()));
    }
    if (!ctx->bindings.empty()) {
        int index = select >= 0 ? std::min(select, static_cast<int>(ctx->bindings.size()) - 1) : 0;
        SendMessageW(ctx->list, LB_SETCURSEL, index, 0);
    }
}

static void LoadShortcutEditorRow(AnnotShortcutEditorCtx* ctx, int index) {
    if (!ctx) return;
    const bool valid = index >= 0 && index < static_cast<int>(ctx->bindings.size());
    EnableWindow(ctx->key, valid);
    EnableWindow(ctx->target, valid);
    HWND window = GetParent(ctx->key);
    for (int id : {kShortcutEditorCtrl, kShortcutEditorShift, kShortcutEditorAlt, kShortcutEditorCapture, kShortcutEditorDelete})
        EnableWindow(GetDlgItem(window, id), valid);
    ctx->currentIndex = valid ? index : -1;
    if (!valid) {
        SetShortcutEditorChord(ctx, 0, true, false, false);
        SendMessageW(ctx->target, CB_SETCURSEL, -1, 0);
        RefreshShortcutEditorDraft(ctx);
        return;
    }
    ctx->currentIndex = index;
    const auto& binding = ctx->bindings[static_cast<size_t>(index)];
    SetShortcutEditorChord(ctx, binding.vk, binding.ctrl, binding.alt, binding.shift);
    DWORD_PTR target = (binding.targetKind == AnnotToolShortcutTargetKind::Category)
        ? (0x100000u + static_cast<DWORD_PTR>(binding.family))
        : (0x200000u + static_cast<DWORD_PTR>(binding.mode));
    int count = static_cast<int>(SendMessageW(ctx->target, CB_GETCOUNT, 0, 0));
    for (int i = 0; i < count; ++i) {
        if (static_cast<DWORD_PTR>(SendMessageW(ctx->target, CB_GETITEMDATA, i, 0)) == target) {
            SendMessageW(ctx->target, CB_SETCURSEL, i, 0);
            break;
        }
    }
    RefreshShortcutEditorDraft(ctx);
}

[[nodiscard]] static bool StoreShortcutEditorRow(AnnotShortcutEditorCtx* ctx, int index) {
    if (!ctx || index < 0 || index >= static_cast<int>(ctx->bindings.size())) return false;
    AnnotToolShortcutBinding parsed;
    std::wstring status;
    if (!ReadShortcutEditorChord(ctx, parsed, status)) {
        RefreshShortcutEditorDraft(ctx);
        SetFocus(ctx->key);
        return false;
    }
    int targetIndex = static_cast<int>(SendMessageW(ctx->target, CB_GETCURSEL, 0, 0));
    if (targetIndex < 0) return false;
    DWORD_PTR data = static_cast<DWORD_PTR>(SendMessageW(ctx->target, CB_GETITEMDATA, targetIndex, 0));
    auto binding = ctx->bindings[static_cast<size_t>(index)];
    binding.key = parsed.key;
    binding.vk = parsed.vk;
    binding.ctrl = parsed.ctrl;
    binding.alt = parsed.alt;
    binding.shift = parsed.shift;
    if ((data & 0xF00000u) == 0x100000u) {
        binding.targetKind = AnnotToolShortcutTargetKind::Category;
        binding.family = static_cast<AnnotToolFamily>(data - 0x100000u);
        binding.mode = ToolMode::Select;
    } else if ((data & 0xF00000u) == 0x200000u) {
        binding.targetKind = AnnotToolShortcutTargetKind::Detail;
        binding.mode = static_cast<ToolMode>(data - 0x200000u);
        binding.family = AnnotToolFamilyForMode(binding.mode);
    } else {
        return false;
    }
    ctx->bindings[static_cast<size_t>(index)] = std::move(binding);
    return true;
}

static void LayoutShortcutEditor(HWND window) {
    RECT rc{};
    GetClientRect(window, &rc);
    const int pad = ScaleY(window, 12);
    const int row = std::max(ScaleY(window, 26), FontLineHeightPx(window, g_hUIFont) + ScaleY(window, 8));
    const int width = std::max(1L, rc.right - pad * 2);
    const int left = (width - pad) * 3 / 5;
    const int right = width - left - pad;
    const int listY = pad + row * 3;
    const int listH = std::max(row * 3, static_cast<int>(rc.bottom) - listY - row * 10 - pad * 6);
    auto place = [&](int id, int x, int y, int w, int h) {
        MoveWindow(GetDlgItem(window, id), x, y, w, h, TRUE);
    };
    place(kShortcutEditorHint, pad, pad, width, row * 2);
    place(kShortcutEditorListLabel, pad, pad + row * 2, left, row);
    place(kShortcutEditorFixedLabel, pad * 2 + left, pad + row * 2, right, row);
    place(kShortcutEditorList, pad, listY, left, listH);
    place(kShortcutEditorFixed, pad * 2 + left, listY, right, listH + row * 7 + pad * 3);
    int y = listY + listH + pad;
    const int label = ScaleY(window, 56);
    place(kShortcutEditorKeyLabel, pad, y, label, row);
    const int captureW = ScaleY(window, 150);
    place(kShortcutEditorKey, pad + label, y, left - label - captureW - pad / 2, row * 14);
    place(kShortcutEditorCapture, pad + left - captureW, y, captureW, row);
    y += row + pad / 2;
    const int modifierW = ScaleY(window, 90);
    place(kShortcutEditorCtrl, pad + label, y, modifierW, row);
    place(kShortcutEditorShift, pad + label + modifierW, y, modifierW, row);
    place(kShortcutEditorAlt, pad + label + modifierW * 2, y, modifierW, row);
    y += row + pad / 2;
    place(kShortcutEditorTargetLabel, pad, y, label, row);
    place(kShortcutEditorTarget, pad + label, y, left - label, row * 12);
    y += row + pad / 2;
    place(kShortcutEditorPreview, pad + label, y, left - label, row);
    y += row;
    place(kShortcutEditorStatus, pad, y, left, row * 2);
    y += row * 2 + pad / 2;
    const int small = ScaleY(window, 70);
    place(kShortcutEditorAdd, pad, y, small, row);
    place(kShortcutEditorDelete, pad * 2 + small, y, small, row);
    place(kShortcutEditorUpdate, pad * 3 + small * 2, y, left - pad * 2 - small * 2, row);
    y += row + pad / 2;
    place(kShortcutEditorSaveHint, pad, y, width, row * 2);
    const int buttonW = ScaleY(window, 110);
    y = rc.bottom - pad - row;
    place(kShortcutEditorDigits, pad, y, ScaleY(window, 220), row);
    place(IDOK, rc.right - pad * 2 - buttonW * 2, y, buttonW, row);
    place(IDCANCEL, rc.right - pad - buttonW, y, buttonW, row);
}

static LRESULT CALLBACK AnnotShortcutEditorProc(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam) {
    auto* ctx = reinterpret_cast<AnnotShortcutEditorCtx*>(GetWindowLongPtrW(hWnd, GWLP_USERDATA));
    switch (msg) {
    case WM_CREATE: {
        auto* cs = reinterpret_cast<CREATESTRUCTW*>(lParam);
        ctx = reinterpret_cast<AnnotShortcutEditorCtx*>(cs->lpCreateParams);
        SetWindowLongPtrW(hWnd, GWLP_USERDATA, reinterpret_cast<LONG_PTR>(ctx));
        auto control = [&](DWORD ex, const wchar_t* type, const std::wstring& text, DWORD style, int id) {
            HWND child = CreateWindowExW(ex, type, text.c_str(), WS_CHILD | WS_VISIBLE | style,
                0, 0, 1, 1, hWnd, reinterpret_cast<HMENU>(static_cast<INT_PTR>(id)), g_hInst, nullptr);
            SetUIFont(child);
            return child;
        };
        control(0, L"STATIC", localization::Text(L"settings.shortcut.hint"), 0, kShortcutEditorHint);
        control(0, L"STATIC", localization::Text(L"settings.shortcut.assignments"), 0, kShortcutEditorListLabel);
        ctx->list = control(WS_EX_CLIENTEDGE, L"LISTBOX", L"", WS_TABSTOP | WS_VSCROLL | WS_HSCROLL | LBS_NOTIFY, kShortcutEditorList);
        control(0, L"STATIC", localization::Text(L"settings.shortcut.fixed_title"), 0, kShortcutEditorFixedLabel);
        control(WS_EX_CLIENTEDGE, L"EDIT", shortcut_help::CommonOverview(ctx->bindings),
                WS_TABSTOP | WS_VSCROLL | ES_MULTILINE | ES_READONLY, kShortcutEditorFixed);
        control(0, L"STATIC", localization::Text(L"settings.shortcut.key_label"), 0, kShortcutEditorKeyLabel);
        ctx->key = control(0, L"COMBOBOX", L"", WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST, kShortcutEditorKey);
        for (const auto& key : shortcut_key_model::Keys()) {
            const auto text = localization::Text(key.group) + L"  " + key.token;
            const auto item = SendMessageW(ctx->key, CB_ADDSTRING, 0, reinterpret_cast<LPARAM>(text.c_str()));
            SendMessageW(ctx->key, CB_SETITEMDATA, item, key.vk);
        }
        control(0, L"BUTTON", localization::Text(L"settings.shortcut.capture"), WS_TABSTOP, kShortcutEditorCapture);
        control(0, L"BUTTON", localization::Text(L"settings.shortcut.ctrl"), WS_TABSTOP | BS_AUTOCHECKBOX, kShortcutEditorCtrl);
        control(0, L"BUTTON", localization::Text(L"settings.shortcut.shift"), WS_TABSTOP | BS_AUTOCHECKBOX, kShortcutEditorShift);
        control(0, L"BUTTON", localization::Text(L"settings.shortcut.alt"), WS_TABSTOP | BS_AUTOCHECKBOX, kShortcutEditorAlt);
        control(0, L"STATIC", L"", SS_NOPREFIX, kShortcutEditorPreview);
        control(0, L"STATIC", L"", SS_NOPREFIX, kShortcutEditorStatus);
        control(0, L"STATIC", localization::Text(L"settings.shortcut.target_label"), 0, kShortcutEditorTargetLabel);
        ctx->target = control(0, L"COMBOBOX", L"", WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST, kShortcutEditorTarget);
        // Stable tool identity, not the user-controlled bar order or visibility.
        for (int value = 0; value < kToolModeCount; ++value) {
            const auto mode = static_cast<ToolMode>(value);
            int item = static_cast<int>(SendMessageW(ctx->target, CB_ADDSTRING, 0,
                reinterpret_cast<LPARAM>(ShortcutEditorTargetLabel(AnnotToolShortcutTargetKind::Detail, AnnotToolFamilyForMode(mode), mode).c_str())));
            SendMessageW(ctx->target, CB_SETITEMDATA, item, 0x200000u + static_cast<DWORD_PTR>(mode));
        }
        // Keep old category bindings readable/editable as an explicit alternative.
        for (int value = 0; value < kAnnotToolFamilyCount; ++value) {
            const auto family = static_cast<AnnotToolFamily>(value);
            int item = static_cast<int>(SendMessageW(ctx->target, CB_ADDSTRING, 0,
                reinterpret_cast<LPARAM>(ShortcutEditorTargetLabel(AnnotToolShortcutTargetKind::Category, family, ToolMode::Select).c_str())));
            SendMessageW(ctx->target, CB_SETITEMDATA, item, 0x100000u + static_cast<DWORD_PTR>(family));
        }
        control(0, L"BUTTON", localization::Text(L"settings.shortcut.add"), WS_TABSTOP, kShortcutEditorAdd);
        control(0, L"BUTTON", localization::Text(L"settings.shortcut.delete"), WS_TABSTOP, kShortcutEditorDelete);
        control(0, L"BUTTON", localization::Text(L"settings.shortcut.update"), WS_TABSTOP, kShortcutEditorUpdate);
        control(0, L"BUTTON", localization::Text(L"settings.shortcut.add_digits"), WS_TABSTOP, kShortcutEditorDigits);
        control(0, L"STATIC", localization::Text(L"settings.shortcut.save_hint"), 0, kShortcutEditorSaveHint);
        control(0, L"BUTTON", localization::Text(L"dialog.action.save"), WS_TABSTOP | BS_DEFPUSHBUTTON, IDOK);
        control(0, L"BUTTON", localization::Text(L"common.cancel"), WS_TABSTOP, IDCANCEL);
        RefreshShortcutEditorList(ctx);
        LoadShortcutEditorRow(ctx, 0);
        ApplyThemeToDialog(hWnd);
        LayoutShortcutEditor(hWnd);
        return 0;
    }
    case WM_SIZE:
        if (ctx) LayoutShortcutEditor(hWnd);
        return 0;
    case WM_GETMINMAXINFO: {
        auto* limits = reinterpret_cast<MINMAXINFO*>(lParam);
        const int row = std::max(ScaleY(hWnd, 26), FontLineHeightPx(hWnd, g_hUIFont) + ScaleY(hWnd, 8));
        limits->ptMinTrackSize = {ScaleY(hWnd, 880), std::max(ScaleY(hWnd, 680), row * 16 + ScaleY(hWnd, 140))};
        return 0;
    }
    case WM_COMMAND: {
        int id = LOWORD(wParam);
        int code = HIWORD(wParam);
        if (!ctx) break;
        if (id == kShortcutEditorCapture) {
            ctx->capturing = !ctx->capturing;
            ctx->drainingKeys = false;
            ctx->capturedKey = 0;
            RefreshShortcutEditorDraft(ctx);
            SetFocus(GetDlgItem(hWnd, kShortcutEditorCapture));
            return 0;
        }
        if (((id == kShortcutEditorKey || id == kShortcutEditorTarget) && code == CBN_SELCHANGE) ||
            ((id == kShortcutEditorCtrl || id == kShortcutEditorShift || id == kShortcutEditorAlt) && code == BN_CLICKED)) {
            RefreshShortcutEditorDraft(ctx);
            return 0;
        }
        if (id == kShortcutEditorList && code == LBN_SELCHANGE) {
            int nextIndex = static_cast<int>(SendMessageW(ctx->list, LB_GETCURSEL, 0, 0));
            if (ctx->currentIndex >= 0 && !StoreShortcutEditorRow(ctx, ctx->currentIndex)) {
                SendMessageW(ctx->list, LB_SETCURSEL, ctx->currentIndex, 0);
                return 0;
            }
            RefreshShortcutEditorList(ctx, nextIndex);
            LoadShortcutEditorRow(ctx, nextIndex);
            return 0;
        }
        if (id == kShortcutEditorUpdate) {
            if (ctx->currentIndex >= 0 && StoreShortcutEditorRow(ctx, ctx->currentIndex)) {
                RefreshShortcutEditorList(ctx, ctx->currentIndex);
                RefreshShortcutEditorDraft(ctx);
            }
            return 0;
        }
        if (id == kShortcutEditorDigits) {
            if (ctx->currentIndex >= 0 && !StoreShortcutEditorRow(ctx, ctx->currentIndex)) return 0;
            for (const auto& binding : DefaultAnnotToolShortcuts()) {
                if (!binding.ctrl || binding.alt || binding.shift || binding.vk < '1' || binding.vk > '9') continue;
                const bool taken = std::any_of(ctx->bindings.begin(), ctx->bindings.end(), [&](const auto& other) {
                    return other.vk == binding.vk && other.ctrl && !other.alt && !other.shift;
                });
                if (!taken) ctx->bindings.push_back(binding);
            }
            RefreshShortcutEditorList(ctx, ctx->currentIndex);
            LoadShortcutEditorRow(ctx, std::max(0, ctx->currentIndex));
            return 0;
        }
        if (id == kShortcutEditorAdd) {
            if (ctx->currentIndex >= 0 && !StoreShortcutEditorRow(ctx, ctx->currentIndex)) return 0;
            AnnotToolShortcutBinding binding;
            bool found = false;
            // Prefer a single modifier; retain every existing assignment.
            for (const auto& key : shortcut_key_model::Keys()) {
                if (!((key.vk >= '1' && key.vk <= '9') || (key.vk >= VK_F1 && key.vk <= VK_F24))) continue;
                if (!ParseAnnotToolShortcutKeyForUser(shortcut_key_model::Format(key.vk, true, false, false), binding)) continue;
                if (std::none_of(ctx->bindings.begin(), ctx->bindings.end(), [&](const auto& other) {
                    return other.vk == binding.vk && other.ctrl && !other.alt && !other.shift;
                })) { found = true; break; }
            }
            if (!found) {
                ShowSoftNotice(hWnd, localization::Text(L"settings.shortcut.no_free_key"), SoftNoticeKind::Warning);
                return 0;
            }
            binding.targetKind = AnnotToolShortcutTargetKind::Detail;
            ctx->bindings.push_back(binding);
            RefreshShortcutEditorList(ctx, static_cast<int>(ctx->bindings.size()) - 1);
            LoadShortcutEditorRow(ctx, static_cast<int>(ctx->bindings.size()) - 1);
            return 0;
        }
        if (id == kShortcutEditorDelete) {
            int index = static_cast<int>(SendMessageW(ctx->list, LB_GETCURSEL, 0, 0));
            if (index >= 0 && index < static_cast<int>(ctx->bindings.size())) {
                ctx->bindings.erase(ctx->bindings.begin() + index);
                RefreshShortcutEditorList(ctx, std::max(0, index - 1));
                LoadShortcutEditorRow(ctx, std::max(0, index - 1));
            }
            return 0;
        }
        if (id == IDOK) {
            if (ctx->capturing) return 0;
            int index = static_cast<int>(SendMessageW(ctx->list, LB_GETCURSEL, 0, 0));
            if (index >= 0 && !StoreShortcutEditorRow(ctx, index)) return 0;
            if (!ReplaceAnnotToolShortcutBindings(ctx->bindings)) {
                ShowSoftNotice(hWnd, localization::Text(L"settings.shortcut.save_failed"),
                               SoftNoticeKind::Warning);
                return 0;
            }
            if (g_hMainWnd) RefreshMainMenuBar(g_hMainWnd);
            ctx->ok = true;
            DestroyWindow(hWnd);
            return 0;
        }
        if (id == IDCANCEL) {
            DestroyWindow(hWnd);
            return 0;
        }
        break;
    }
    case WM_CLOSE:
        DestroyWindow(hWnd);
        return 0;
    case WM_ACTIVATE:
        if (ctx && LOWORD(wParam) == WA_INACTIVE) {
            ctx->capturing = false;
            ctx->drainingKeys = false;
            RefreshShortcutEditorDraft(ctx);
        }
        break;
    case WM_DESTROY:
        if (ctx) { ctx->done = true; RestoreOwnerAfterModal(ctx->owner); }
        return 0;
    case WM_CTLCOLORSTATIC:
    case WM_CTLCOLOREDIT:
    case WM_CTLCOLORLISTBOX:
    case WM_CTLCOLORBTN:
        return ThemeCtlColorPanel(reinterpret_cast<HWND>(lParam), reinterpret_cast<HDC>(wParam));
    case WM_DRAWITEM:
        if (DrawThemeButton(reinterpret_cast<LPDRAWITEMSTRUCT>(lParam))) return TRUE;
        break;
    case WM_THEMECHANGED:
        ApplyThemeToDialog(hWnd);
        return 0;
    }
    return DefWindowProcW(hWnd, msg, wParam, lParam);
}

static void EnsureAnnotShortcutEditorClass() {
    static bool registered = false;
    if (registered) return;
    WNDCLASSW wc{};
    wc.lpfnWndProc = AnnotShortcutEditorProc;
    wc.hInstance = g_hInst;
    wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
    wc.hbrBackground = g_hThemeWindowBrush ? g_hThemeWindowBrush : reinterpret_cast<HBRUSH>(COLOR_WINDOW + 1);
    wc.lpszClassName = L"AnnotShortcutEditorDlgClass";
    RegisterClassW(&wc);
    registered = true;
}

// Intercept before dialog navigation or application shortcut routing. Recording
// changes only the selector draft. Drain repeats and releases so Enter/Space/Alt
// cannot subsequently activate a button/menu. No global hooks are installed.
[[nodiscard]] static bool FilterShortcutEditorCapture(HWND window, AnnotShortcutEditorCtx& ctx, const MSG& msg) {
    if (!ctx.capturing && !ctx.drainingKeys) return false;
    if (msg.hwnd != window && !IsChild(window, msg.hwnd)) return false;
    const bool down = msg.message == WM_KEYDOWN || msg.message == WM_SYSKEYDOWN;
    const bool up = msg.message == WM_KEYUP || msg.message == WM_SYSKEYUP;
    const UINT vk = static_cast<UINT>(msg.wParam);
    if (ctx.drainingKeys) {
        if (up && !(GetKeyState(ctx.capturedKey) & 0x8000) &&
            !(GetKeyState(VK_CONTROL) & 0x8000) && !(GetKeyState(VK_SHIFT) & 0x8000) &&
            !(GetKeyState(VK_MENU) & 0x8000)) ctx.drainingKeys = false;
        return down || up || msg.message == WM_CHAR || msg.message == WM_SYSCHAR ||
               msg.message == WM_DEADCHAR || msg.message == WM_SYSDEADCHAR;
    }
    if (down) {
        if (shortcut_key_model::IsModifier(vk)) return true;
        if (msg.lParam & (1LL << 30)) return true;
        if (vk == VK_ESCAPE) {
            ctx.capturing = false;
        } else if ((GetKeyState(VK_LWIN) & 0x8000) || (GetKeyState(VK_RWIN) & 0x8000) ||
                   (GetKeyState(VK_RMENU) & 0x8000) || !shortcut_key_model::Find(vk)) {
            SetWindowTextW(GetDlgItem(window, kShortcutEditorStatus),
                           localization::Text(L"settings.shortcut.capture_unsupported").c_str());
            return true;
        } else {
            SetShortcutEditorChord(&ctx, vk, (GetKeyState(VK_CONTROL) & 0x8000) != 0,
                (GetKeyState(VK_MENU) & 0x8000) != 0, (GetKeyState(VK_SHIFT) & 0x8000) != 0);
            ctx.capturing = false;
        }
        ctx.capturedKey = vk;
        ctx.drainingKeys = true;
        RefreshShortcutEditorDraft(&ctx);
        return true;
    }
    if (msg.message == WM_LBUTTONDOWN || msg.message == WM_RBUTTONDOWN || msg.message == WM_NCLBUTTONDOWN) {
        if (msg.hwnd != GetDlgItem(window, kShortcutEditorCapture)) {
            ctx.capturing = false;
            RefreshShortcutEditorDraft(&ctx);
        }
    }
    return up || msg.message == WM_CHAR || msg.message == WM_SYSCHAR ||
           msg.message == WM_DEADCHAR || msg.message == WM_SYSDEADCHAR;
}

static void ShowAnnotToolShortcutEditor(HWND owner) {
    EnsureAnnotShortcutEditorClass();
    AnnotShortcutEditorCtx ctx;
    ctx.owner = owner;
    ctx.bindings = AnnotToolShortcutBindings();
    const std::wstring title = localization::Text(L"settings.annotation_shortcuts_title");
    if (owner) EnableWindow(owner, FALSE);
    int dpi = GetDpiY(owner);
    const int row = std::max(ScaleY(owner, 26), FontLineHeightPx(owner, g_hUIFont) + ScaleY(owner, 8));
    HWND hWnd = CreateWindowExW(WS_EX_DLGMODALFRAME, L"AnnotShortcutEditorDlgClass", title.c_str(),
                                WS_CAPTION | WS_POPUPWINDOW | WS_THICKFRAME, CW_USEDEFAULT, CW_USEDEFAULT,
                                MulDiv(960, dpi, 96), std::max(MulDiv(740, dpi, 96), row * 16 + ScaleY(owner, 140)), owner, nullptr, g_hInst, &ctx);
    if (!hWnd) { if (owner) EnableWindow(owner, TRUE); return; }
    PlaceOwnedPopupAtAppTopLeft(hWnd, owner);
    ShowWindow(hWnd, SW_SHOW);
    UpdateWindow(hWnd);
    MSG msg{};
    while (!ctx.done) {
        const BOOL result = GetMessageW(&msg, nullptr, 0, 0);
        if (result <= 0) {
            if (result == 0) PostQuitMessage(static_cast<int>(msg.wParam));
            break;
        }
        if (FilterShortcutEditorCapture(hWnd, ctx, msg)) continue;
        if (HandleWorkspaceMemoMessage(msg)) continue;
        if (ShouldSkipImeMessageInModalLoop(msg)) continue;
        if (!IsDialogMessageW(hWnd, &msg)) { TranslateMessage(&msg); DispatchMessageW(&msg); }
    }
    RestoreOwnerAfterModal(owner);
}

} // namespace
