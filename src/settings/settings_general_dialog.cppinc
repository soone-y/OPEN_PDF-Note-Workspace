            addLabel(localization::Text(L"settings.general.841e70de8f55").c_str());
            ctx->cbNoteFontCustomization = addCombo(IDC_NOTE_FONT_CUSTOMIZATION, false, controlW);

            ctx->lblNoteRenderLatin = addLabel(localization::Text(L"settings.general.5754fa41b4ed").c_str());
