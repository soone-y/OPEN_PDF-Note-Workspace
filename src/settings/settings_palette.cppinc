// file: settings/settings_palette.cppinc
// Included by settings.cpp (single TU).

// ---------------------------------------------------------------------
// Settings: User palette
// ---------------------------------------------------------------------
namespace {
constexpr int IDC_PALETTE_SLOT_BASE = 5200;
constexpr int IDC_PALETTE_SLOT_COUNT = 8;
constexpr int IDC_PALETTE_INFO = 5216;
constexpr int IDC_PALETTE_SELECTED_INFO = 5217;
constexpr int IDC_PALETTE_EDITOR_RED = 5220;
constexpr int IDC_PALETTE_EDITOR_GREEN = 5221;
constexpr int IDC_PALETTE_EDITOR_BLUE = 5222;
constexpr int IDC_PALETTE_EDITOR_PREVIEW = 5223;
constexpr int IDC_PALETTE_EDITOR_HEX = 5224;
constexpr int IDC_PALETTE_EDITOR_EYEDROPPER = 5227;
constexpr int IDC_PALETTE_EDITOR_CHOICE_BASE = 5230;
constexpr int IDC_PALETTE_EDITOR_CHOICE_COUNT = 8;

struct PaletteSettingsCtx {
    HWND owner = nullptr;
    bool done = false;
    bool ok = false;
    bool embedded = false;
    bool reopenOnCancel = false;
    // Keep legacy picker slots when saving, but expose only the seven presets
    // and one application-owned custom color.
    COLORREF colors[kToolPaletteCommandSlotCapacity]{};
    int selectedSlot = 0;
    int changedSlot = -1;
    HWND headerTitle = nullptr;
    HWND headerSubtitle = nullptr;
    HWND btnOpen = nullptr;
    HWND btnClose = nullptr;
    HWND selectedInfo = nullptr;
};

static void DrawPaletteSlotButton(const DRAWITEMSTRUCT* dis, COLORREF color, bool isTargetSlot, bool isChangedSlot) {
    if (!dis) return;
    RECT rc = dis->rcItem;
    const bool selected = (dis->itemState & ODS_SELECTED) != 0;
    const bool focused = (dis->itemState & ODS_FOCUS) != 0;

    HBRUSH fill = CreateSolidBrush(color);
    FillRect(dis->hDC, &rc, fill);
    DeleteObject(fill);

    int borderWidth = selected ? 2 : 1;
    COLORREF borderColor = RGB(0, 0, 0);
    if (isChangedSlot) {
        borderWidth = 3;
        borderColor = RGB(220, 70, 40);
    } else if (isTargetSlot) {
        borderWidth = 3;
        borderColor = g_theme.accent;
    }

    HPEN border = CreatePen(PS_SOLID, borderWidth, borderColor);
    HGDIOBJ oldPen = SelectObject(dis->hDC, border);
    HGDIOBJ oldBrush = SelectObject(dis->hDC, GetStockObject(HOLLOW_BRUSH));
    Rectangle(dis->hDC, rc.left, rc.top, rc.right, rc.bottom);
    SelectObject(dis->hDC, oldBrush);
    SelectObject(dis->hDC, oldPen);
    DeleteObject(border);

    if (isChangedSlot || isTargetSlot) {
        RECT rcInner = rc;
        InflateRect(&rcInner, -4, -4);
        if (rcInner.right > rcInner.left && rcInner.bottom > rcInner.top) {
            HPEN innerBorder = CreatePen(PS_SOLID, 1, RGB(255, 255, 255));
            HGDIOBJ oldPen2 = SelectObject(dis->hDC, innerBorder);
            HGDIOBJ oldBrush2 = SelectObject(dis->hDC, GetStockObject(HOLLOW_BRUSH));
            Rectangle(dis->hDC, rcInner.left, rcInner.top, rcInner.right, rcInner.bottom);
            SelectObject(dis->hDC, oldBrush2);
            SelectObject(dis->hDC, oldPen2);
            DeleteObject(innerBorder);
        }
    }

    if (focused) {
        RECT rcFocus = rc;
        InflateRect(&rcFocus, -3, -3);
        DrawFocusRect(dis->hDC, &rcFocus);
    }
}

static bool IsPaletteSlotId(int id) {
    return id >= IDC_PALETTE_SLOT_BASE && id < IDC_PALETTE_SLOT_BASE + IDC_PALETTE_SLOT_COUNT;
}

struct PaletteColorEditorCtx {
    HWND owner = nullptr;
    COLORREF color = RGB(0, 0, 0);
    bool done = false;
    bool accepted = false;
    bool syncingFields = false;
    bool eyedropperActive = false;
    COLORREF eyedropperInitialColor = RGB(0, 0, 0);
    HWND preview = nullptr;
    std::array<COLORREF, IDC_PALETTE_EDITOR_CHOICE_COUNT> choices{};
    size_t choiceCount = 0;
};

static bool TryReadPaletteChannel(HWND hWnd, int id, BYTE* out) {
    if (!out) return false;
    HWND edit = GetDlgItem(hWnd, id);
    const int len = edit ? GetWindowTextLengthW(edit) : 0;
    if (!edit || len <= 0 || len > 3) return false;
    std::wstring text(static_cast<size_t>(len) + 1, L'\0');
    GetWindowTextW(edit, text.data(), len + 1);
    wchar_t* end = nullptr;
    const long value = wcstol(text.c_str(), &end, 10);
    if (end == text.c_str() || *end != L'\0' || value < 0 || value > 255) return false;
    *out = static_cast<BYTE>(value);
    return true;
}

static bool ReadPaletteEditorRgb(HWND hWnd, COLORREF* out) {
    BYTE r{}, g{}, b{};
    if (!TryReadPaletteChannel(hWnd, IDC_PALETTE_EDITOR_RED, &r) ||
        !TryReadPaletteChannel(hWnd, IDC_PALETTE_EDITOR_GREEN, &g) ||
        !TryReadPaletteChannel(hWnd, IDC_PALETTE_EDITOR_BLUE, &b)) {
        return false;
    }
    if (out) *out = RGB(r, g, b);
    return true;
}

static bool TryReadPaletteHex(HWND hWnd, COLORREF* out) {
    if (!out) return false;
    HWND edit = GetDlgItem(hWnd, IDC_PALETTE_EDITOR_HEX);
    const int len = edit ? GetWindowTextLengthW(edit) : 0;
    if (!edit || len < 6 || len > 7) return false;
    std::wstring text(static_cast<size_t>(len) + 1, L'\0');
    GetWindowTextW(edit, text.data(), len + 1);
    text.resize(static_cast<size_t>(len));
    if (!text.empty() && text.front() == L'#') text.erase(text.begin());
    if (text.size() != 6) return false;
    auto hexDigit = [](wchar_t ch) -> int {
        if (ch >= L'0' && ch <= L'9') return ch - L'0';
        if (ch >= L'a' && ch <= L'f') return ch - L'a' + 10;
        if (ch >= L'A' && ch <= L'F') return ch - L'A' + 10;
        return -1;
    };
    int rgb[3]{};
    for (int i = 0; i < 3; ++i) {
        const int high = hexDigit(text[static_cast<size_t>(i) * 2]);
        const int low = hexDigit(text[static_cast<size_t>(i) * 2 + 1]);
        if (high < 0 || low < 0) return false;
        rgb[i] = high * 16 + low;
    }
    *out = RGB(rgb[0], rgb[1], rgb[2]);
    return true;
}

static std::wstring PaletteEditorHex(COLORREF color) {
    wchar_t text[8]{};
    swprintf(text, std::size(text), L"#%02X%02X%02X", GetRValue(color), GetGValue(color), GetBValue(color));
    return text;
}

static void SetPaletteEditorColor(HWND hWnd, PaletteColorEditorCtx* ctx, COLORREF color) {
    if (!ctx) return;
    ctx->syncingFields = true;
    const std::array<std::pair<int, BYTE>, 3> channels{{
        {IDC_PALETTE_EDITOR_RED, GetRValue(color)},
        {IDC_PALETTE_EDITOR_GREEN, GetGValue(color)},
        {IDC_PALETTE_EDITOR_BLUE, GetBValue(color)},
    }};
    for (const auto& [id, value] : channels) {
        const std::wstring text = std::to_wstring(value);
        SetWindowTextW(GetDlgItem(hWnd, id), text.c_str());
    }
    const std::wstring hex = PaletteEditorHex(color);
    SetWindowTextW(GetDlgItem(hWnd, IDC_PALETTE_EDITOR_HEX), hex.c_str());
    ctx->color = color;
    ctx->syncingFields = false;
    if (ctx->preview) InvalidateRect(ctx->preview, nullptr, TRUE);
    InvalidateRect(hWnd, nullptr, FALSE);
}

static bool SamplePaletteColorAtCursor(COLORREF* outColor) {
    if (!outColor) return false;
    POINT pt{};
    if (!GetCursorPos(&pt)) return false;
    HDC screen = GetDC(nullptr);
    if (!screen) return false;
    const COLORREF color = GetPixel(screen, pt.x, pt.y);
    ReleaseDC(nullptr, screen);
    if (color == CLR_INVALID) return false;
    *outColor = color;
    return true;
}

static bool ReadPaletteEditorColor(HWND hWnd, COLORREF* out) {
    COLORREF color{};
    COLORREF hexColor{};
    if (!ReadPaletteEditorRgb(hWnd, &color) || !TryReadPaletteHex(hWnd, &hexColor) || color != hexColor) return false;
    if (out) *out = color;
    return true;
}

static void UpdatePaletteEditorFromRgb(HWND hWnd, PaletteColorEditorCtx* ctx) {
    if (!ctx || ctx->syncingFields) return;
    COLORREF color{};
    if (!ReadPaletteEditorRgb(hWnd, &color)) return;
    SetPaletteEditorColor(hWnd, ctx, color);
}

static void UpdatePaletteEditorFromHex(HWND hWnd, PaletteColorEditorCtx* ctx) {
    if (!ctx || ctx->syncingFields) return;
    COLORREF color{};
    if (!TryReadPaletteHex(hWnd, &color)) return;
    SetPaletteEditorColor(hWnd, ctx, color);
}

static void EnsurePaletteColorEditorClass() {
    static bool registered = false;
    if (registered) return;
    WNDCLASSW wc{};
    wc.lpfnWndProc = [](HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam) -> LRESULT {
        auto* ctx = reinterpret_cast<PaletteColorEditorCtx*>(GetWindowLongPtrW(hWnd, GWLP_USERDATA));
        switch (msg) {
        case WM_CREATE: {
            auto* cs = reinterpret_cast<CREATESTRUCTW*>(lParam);
            ctx = reinterpret_cast<PaletteColorEditorCtx*>(cs->lpCreateParams);
            SetWindowLongPtrW(hWnd, GWLP_USERDATA, reinterpret_cast<LONG_PTR>(ctx));
            if (!ctx) return -1;
            const int pad = ScaleY(hWnd, 14);
            const int rowH = std::max(ScaleY(hWnd, 26), FontLineHeightPx(hWnd, g_hUIFont) + ScaleY(hWnd, 8));
            const int labelW = ScaleY(hWnd, 24);
            const int editW = ScaleY(hWnd, 64);
            const int gap = ScaleY(hWnd, 8);
            const int previewW = ScaleY(hWnd, 116);
            const int previewH = rowH;
            const int buttonW = ScaleY(hWnd, 92);
            const int choiceW = ScaleY(hWnd, 28);
            const int choiceGap = ScaleY(hWnd, 6);
            const int y0 = pad;
            const std::array<std::pair<const wchar_t*, int>, 3> channels{{
                {L"R", IDC_PALETTE_EDITOR_RED}, {L"G", IDC_PALETTE_EDITOR_GREEN}, {L"B", IDC_PALETTE_EDITOR_BLUE}
            }};
            const BYTE values[] = {GetRValue(ctx->color), GetGValue(ctx->color), GetBValue(ctx->color)};
            for (size_t i = 0; i < channels.size(); ++i) {
                const int y = y0 + static_cast<int>(i) * (rowH + gap);
                HWND label = CreateWindowExW(0, L"STATIC", channels[i].first, WS_CHILD | WS_VISIBLE,
                                              pad, y + ScaleY(hWnd, 4), labelW, rowH, hWnd, nullptr, g_hInst, nullptr);
                SetUIFont(label);
                const std::wstring value = std::to_wstring(values[i]);
                HWND edit = CreateWindowExW(WS_EX_CLIENTEDGE, L"EDIT", value.c_str(),
                                             WS_CHILD | WS_VISIBLE | WS_TABSTOP | ES_AUTOHSCROLL | ES_NUMBER,
                                             pad + labelW, y, editW, rowH, hWnd,
                                             reinterpret_cast<HMENU>(static_cast<INT_PTR>(channels[i].second)), g_hInst, nullptr);
                SetUIFont(edit);
            }
            const int previewY = y0 + 3 * (rowH + gap);
            ctx->preview = CreateWindowExW(0, L"STATIC", L"", WS_CHILD | WS_VISIBLE | SS_OWNERDRAW,
                                           pad, previewY, previewW, previewH, hWnd,
                                           reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_EDITOR_PREVIEW)), g_hInst, nullptr);
            const int hexY = previewY + previewH + gap;
            HWND hexLabel = CreateWindowExW(0, L"STATIC", L"HEX", WS_CHILD | WS_VISIBLE,
                                             pad, hexY + ScaleY(hWnd, 4), labelW + ScaleY(hWnd, 14), rowH,
                                             hWnd, nullptr, g_hInst, nullptr);
            SetUIFont(hexLabel);
            const std::wstring initialHex = PaletteEditorHex(ctx->color);
            HWND hexEdit = CreateWindowExW(WS_EX_CLIENTEDGE, L"EDIT", initialHex.c_str(),
                                            WS_CHILD | WS_VISIBLE | WS_TABSTOP | ES_AUTOHSCROLL,
                                            pad + labelW + ScaleY(hWnd, 14), hexY, editW + ScaleY(hWnd, 44), rowH, hWnd,
                                            reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_EDITOR_HEX)), g_hInst, nullptr);
            SetUIFont(hexEdit);
            const int choiceY = hexY + rowH + gap;
            for (size_t i = 0; i < ctx->choiceCount; ++i) {
                const int x = pad + static_cast<int>(i % 4) * (choiceW + choiceGap);
                const int y = choiceY + static_cast<int>(i / 4) * (rowH + gap);
                const std::wstring label = std::to_wstring(i + 1);
                HWND choice = CreateWindowExW(0, L"BUTTON", label.c_str(),
                                              WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_OWNERDRAW,
                                              x, y, choiceW, rowH, hWnd,
                                              reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_EDITOR_CHOICE_BASE + i)),
                                              g_hInst, nullptr);
                SetUIFont(choice);
            }
            const int eyedropperY = choiceY + 2 * (rowH + gap);
            HWND eyedropper = CreateWindowExW(0, L"BUTTON", localization::Text(L"settings.palette.eyedropper").c_str(),
                                              WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_PUSHBUTTON,
                                              pad, eyedropperY, ScaleY(hWnd, 156), rowH, hWnd,
                                              reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_EDITOR_EYEDROPPER)), g_hInst, nullptr);
            SetUIFont(eyedropper);
            const int buttonY = eyedropperY + rowH + ScaleY(hWnd, 14);
            HWND ok = CreateWindowExW(0, L"BUTTON", UiApplyLabel().c_str(),
                                      WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_DEFPUSHBUTTON,
                                      pad, buttonY, buttonW, rowH,
                                      hWnd, reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDOK)), g_hInst, nullptr);
            HWND cancel = CreateWindowExW(0, L"BUTTON", UiCancelLabel().c_str(),
                                          WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_PUSHBUTTON,
                                          pad + buttonW + gap, buttonY, buttonW, rowH,
                                          hWnd, reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDCANCEL)), g_hInst, nullptr);
            SetUIFont(ok);
            SetUIFont(cancel);
            ApplyThemeToDialog(hWnd);
            return 0;
        }
        case WM_DRAWITEM: {
            auto* dis = reinterpret_cast<DRAWITEMSTRUCT*>(lParam);
            if (!ctx || !dis) break;
            if (dis->CtlID >= IDC_PALETTE_EDITOR_CHOICE_BASE &&
                dis->CtlID < IDC_PALETTE_EDITOR_CHOICE_BASE + static_cast<UINT>(ctx->choiceCount)) {
                const size_t idx = static_cast<size_t>(dis->CtlID - IDC_PALETTE_EDITOR_CHOICE_BASE);
                DrawPaletteSlotButton(dis, ctx->choices[idx], ctx->choices[idx] == ctx->color, false);
                return TRUE;
            }
            if (dis->CtlID != IDC_PALETTE_EDITOR_PREVIEW) break;
            HBRUSH fill = CreateSolidBrush(ctx->color);
            FillRect(dis->hDC, &dis->rcItem, fill);
            DeleteObject(fill);
            HBRUSH border = CreateSolidBrush(g_theme.buttonBorder);
            FrameRect(dis->hDC, &dis->rcItem, border);
            DeleteObject(border);
            return TRUE;
        }
        case WM_COMMAND: {
            const int id = LOWORD(wParam);
            const int code = HIWORD(wParam);
            if (id == IDC_PALETTE_EDITOR_EYEDROPPER && code == BN_CLICKED) {
                ctx->eyedropperInitialColor = ctx->color;
                ctx->eyedropperActive = true;
                SetCapture(hWnd);
                return 0;
            }
            if (id >= IDC_PALETTE_EDITOR_CHOICE_BASE &&
                id < IDC_PALETTE_EDITOR_CHOICE_BASE + static_cast<int>(ctx->choiceCount) && code == BN_CLICKED) {
                SetPaletteEditorColor(hWnd, ctx, ctx->choices[static_cast<size_t>(id - IDC_PALETTE_EDITOR_CHOICE_BASE)]);
                return 0;
            }
            if (id == IDOK) {
                COLORREF color{};
                if (!ReadPaletteEditorColor(hWnd, &color)) {
                    const int fields[] = {IDC_PALETTE_EDITOR_RED, IDC_PALETTE_EDITOR_GREEN, IDC_PALETTE_EDITOR_BLUE};
                    bool invalidChannel = false;
                    for (int field : fields) {
                        BYTE unused{};
                        if (!TryReadPaletteChannel(hWnd, field, &unused)) {
                            invalidChannel = true;
                            HWND invalid = GetDlgItem(hWnd, field);
                            if (invalid) {
                                SetFocus(invalid);
                                SendMessageW(invalid, EM_SETSEL, 0, -1);
                            }
                            break;
                        }
                    }
                    if (!invalidChannel) {
                        HWND invalid = GetDlgItem(hWnd, IDC_PALETTE_EDITOR_HEX);
                        if (invalid) {
                            SetFocus(invalid);
                            SendMessageW(invalid, EM_SETSEL, 0, -1);
                        }
                    }
                    return 0;
                }
                ctx->color = color;
                ctx->accepted = true;
                DestroyWindow(hWnd);
                return 0;
            }
            if (id == IDCANCEL) {
                DestroyWindow(hWnd);
                return 0;
            }
            if (code == EN_CHANGE && (id == IDC_PALETTE_EDITOR_RED || id == IDC_PALETTE_EDITOR_GREEN || id == IDC_PALETTE_EDITOR_BLUE)) {
                UpdatePaletteEditorFromRgb(hWnd, ctx);
                return 0;
            }
            if (code == EN_CHANGE && id == IDC_PALETTE_EDITOR_HEX) {
                UpdatePaletteEditorFromHex(hWnd, ctx);
                return 0;
            }
            break;
        }
        case WM_LBUTTONUP:
            if (ctx && ctx->eyedropperActive) {
                COLORREF sampled{};
                if (SamplePaletteColorAtCursor(&sampled)) SetPaletteEditorColor(hWnd, ctx, sampled);
                ctx->eyedropperActive = false;
                if (GetCapture() == hWnd) ReleaseCapture();
                return 0;
            }
            break;
        case WM_CAPTURECHANGED:
            if (ctx && ctx->eyedropperActive) ctx->eyedropperActive = false;
            break;
        case WM_KEYDOWN:
            if (ctx && ctx->eyedropperActive && wParam == VK_ESCAPE) {
                ctx->eyedropperActive = false;
                SetPaletteEditorColor(hWnd, ctx, ctx->eyedropperInitialColor);
                if (GetCapture() == hWnd) ReleaseCapture();
                return 0;
            }
            break;
        case WM_CTLCOLORSTATIC:
        case WM_CTLCOLOREDIT:
        case WM_CTLCOLORBTN:
            return ThemeCtlColorPanel(reinterpret_cast<HWND>(lParam), reinterpret_cast<HDC>(wParam));
        case WM_CLOSE:
            DestroyWindow(hWnd);
            return 0;
        case WM_DESTROY:
            if (ctx) {
                RestoreOwnerAfterModal(ctx->owner);
                ctx->done = true;
            }
            return 0;
        default:
            break;
        }
        return DefWindowProcW(hWnd, msg, wParam, lParam);
    };
    wc.hInstance = g_hInst;
    wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
    wc.hbrBackground = g_hThemeWindowBrush ? g_hThemeWindowBrush : reinterpret_cast<HBRUSH>(COLOR_WINDOW + 1);
    wc.lpszClassName = L"PaletteColorEditorDlgClass";
    RegisterClassW(&wc);
    registered = true;
}

static bool ShowPaletteColorEditorDialogImpl(HWND owner, COLORREF initial, COLORREF* outColor,
                                             const COLORREF* choices = nullptr, size_t choiceCount = 0) {
    if (!outColor) return false;
    EnsurePaletteColorEditorClass();
    PaletteColorEditorCtx ctx{};
    ctx.owner = owner;
    ctx.color = initial;
    if (choices) {
        ctx.choiceCount = std::min(choiceCount, ctx.choices.size());
        std::copy_n(choices, ctx.choiceCount, ctx.choices.begin());
    }
    if (owner) EnableWindow(owner, FALSE);
    const int dpi = GetDpiY(owner);
    HWND hWnd = CreateWindowExW(WS_EX_DLGMODALFRAME, L"PaletteColorEditorDlgClass",
                                GetUiText().menuPaletteSettings.c_str(), WS_CAPTION | WS_POPUPWINDOW,
                                CW_USEDEFAULT, CW_USEDEFAULT, MulDiv(300, dpi, 96), MulDiv(360, dpi, 96),
                                owner, nullptr, g_hInst, &ctx);
    if (!hWnd) {
        RestoreOwnerAfterModal(owner);
        return false;
    }
    PlaceOwnedPopupAtAppTopLeft(hWnd, owner);
    ShowWindow(hWnd, SW_SHOW);
    MSG msg;
    while (!ctx.done && GetMessageW(&msg, nullptr, 0, 0)) {
        if (HandleWorkspaceMemoMessage(msg)) continue;
        if (ShouldSkipImeMessageInModalLoop(msg)) continue;
        if (ctx.eyedropperActive && msg.message == WM_KEYDOWN && msg.wParam == VK_ESCAPE) {
            SendMessageW(hWnd, WM_KEYDOWN, VK_ESCAPE, 0);
            continue;
        }
        if (!IsDialogMessageW(hWnd, &msg)) {
            TranslateMessage(&msg);
            DispatchMessageW(&msg);
        }
    }
    if (ctx.accepted) *outColor = ctx.color;
    return ctx.accepted;
}

static bool OpenPaletteColorEditorForSlot(HWND owner, COLORREF* colors, int slot,
                                          PaletteSettingsCtx* paletteCtx = nullptr) {
    if (!colors) return false;
    if (slot < 0 || slot >= IDC_PALETTE_SLOT_COUNT) slot = 0;
    if (paletteCtx) {
        paletteCtx->selectedSlot = slot;
        paletteCtx->changedSlot = -1;
    }
    COLORREF picked = colors[slot];
    if (!ShowPaletteColorEditorDialogImpl(owner, colors[slot], &picked, colors, IDC_PALETTE_SLOT_COUNT)) {
        if (paletteCtx) {
            paletteCtx->selectedSlot = slot;
            paletteCtx->changedSlot = -1;
        }
        if (owner && IsWindow(owner)) {
            InvalidateRect(owner, nullptr, TRUE);
            UpdateWindow(owner);
        }
        return false;
    }

    colors[slot] = picked;
    if (paletteCtx) {
        paletteCtx->selectedSlot = slot;
        paletteCtx->changedSlot = slot;
    }
    if (owner && IsWindow(owner)) {
        InvalidateRect(owner, nullptr, TRUE);
    }
    return true;
}

MAYBE_UNUSED static std::wstring PaletteHexColorW(COLORREF c) {
    wchar_t buf[16]{};
    swprintf(buf, std::size(buf), L"#%02X%02X%02X", GetRValue(c), GetGValue(c), GetBValue(c));
    return std::wstring(buf);
}

static void UpdatePaletteSelectedInfo(PaletteSettingsCtx* ctx) {
    if (!ctx || !ctx->selectedInfo) return;
    int idx = std::clamp(ctx->selectedSlot, 0, IDC_PALETTE_SLOT_COUNT - 1);
    COLORREF c = ctx->colors[idx];
    std::wstring hex = PaletteHexColorW(c);
    std::wstring roleText;
    if (idx < 7) {
        roleText = localization::Text(L"settings.palette.be911f831213");
    } else if (idx == 7) {
        roleText = localization::Text(L"settings.palette.eaf09477bc2b");
    }
    std::wstring text = localization::Format(L"settings.palette.selected_info",
        {{L"SLOT", std::to_wstring(idx + 1)}, {L"ROLE", roleText}, {L"HEX", hex},
         {L"R", std::to_wstring(GetRValue(c))}, {L"G", std::to_wstring(GetGValue(c))},
         {L"B", std::to_wstring(GetBValue(c))}});
    if (ctx->changedSlot == idx) {
        text += localization::Text(L"settings.palette.8c31962ed379");
    }
    SetWindowTextW(ctx->selectedInfo, text.c_str());
}

static void EnsurePaletteSettingsClass() {
    static bool registered = false;
    if (registered) return;
    WNDCLASSW wc{};
    wc.lpfnWndProc = [](HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam) -> LRESULT {
        auto* ctx = reinterpret_cast<PaletteSettingsCtx*>(GetWindowLongPtrW(hWnd, GWLP_USERDATA));
        switch (msg) {
        case WM_CREATE: {
            auto cs = reinterpret_cast<CREATESTRUCTW*>(lParam);
            ctx = reinterpret_cast<PaletteSettingsCtx*>(cs->lpCreateParams);
            SetWindowLongPtrW(hWnd, GWLP_USERDATA, reinterpret_cast<LONG_PTR>(ctx));
            if (!ctx) return -1;

            LoadUserPaletteColorsForSettings(ctx->colors, std::size(ctx->colors));

            const int pad = ScaleY(hWnd, 12);
            const int gap = ScaleY(hWnd, 6);
            const int slotW = ScaleY(hWnd, 36);
            const int slotH = ScaleY(hWnd, 32);
            const int rowH = std::max(ScaleY(hWnd, 28), FontLineHeightPx(hWnd, g_hUIFont) + ScaleY(hWnd, 10));
            const int columns = 8;
            const int titleH = std::max(rowH, ScaleY(hWnd, 30));
            std::wstring subtitle = localization::Text(L"settings.palette.3fec070b879c");
            int subtitleH = ctx->embedded ? 0
                                          : std::max(FontLineHeightPx(hWnd, g_hUIFont) + ScaleY(hWnd, 4),
                                                     MeasureTextHeight(hWnd, subtitle, ScaleY(hWnd, 360), g_hUIFont));
            if (!ctx->embedded) {
                ctx->headerTitle = CreateWindowExW(0, L"STATIC",
                                                   GetUiText().menuPaletteSettings.c_str(),
                                                   WS_CHILD | WS_VISIBLE,
                                                   pad, pad, ScaleY(hWnd, 360), titleH,
                                                   hWnd, nullptr, g_hInst, nullptr);
                ctx->headerSubtitle = CreateWindowExW(0, L"STATIC", subtitle.c_str(),
                                                      WS_CHILD | WS_VISIBLE,
                                                      pad, pad + titleH, ScaleY(hWnd, 360), subtitleH,
                                                      hWnd, reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_INFO)),
                                                      g_hInst, nullptr);
                SetUIFont(ctx->headerTitle);
                SetUIFont(ctx->headerSubtitle);
            }

            int gridY = ctx->embedded ? pad : (pad + titleH + subtitleH + ScaleY(hWnd, 12));
            for (int i = 0; i < IDC_PALETTE_SLOT_COUNT; ++i) {
                int row = i / columns;
                int col = i % columns;
                int x = pad + col * (slotW + gap);
                int yy = gridY + row * (slotH + gap);
                std::wstring label = std::to_wstring(i + 1);
                HWND btn = CreateWindowExW(0, L"BUTTON", label.c_str(),
                                           WS_CHILD | WS_VISIBLE | BS_OWNERDRAW | WS_TABSTOP,
                                           x, yy, slotW, slotH, hWnd,
                                           reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_SLOT_BASE + i)),
                                           g_hInst, nullptr);
                SetUIFont(btn);
            }

            int rows = (IDC_PALETTE_SLOT_COUNT + columns - 1) / columns;
            int y = gridY + rows * slotH + std::max(0, rows - 1) * gap + ScaleY(hWnd, 10);
            int btnH = rowH;
            int okW = ScaleY(hWnd, 130);
            int cancelW = ScaleY(hWnd, 96);
            int btnGap = ScaleY(hWnd, 10);
            int totalW = columns * slotW + (columns - 1) * gap;
            int xCancel = pad + totalW - cancelW;
            int xOk = ctx->embedded ? (pad + totalW - okW) : (xCancel - btnGap - okW);

            const std::wstring openLabel = ctx->embedded
                ? localization::Text(L"settings.palette.023caed2a143")
                : localization::Text(L"settings.palette.0e945dc66d38");
            ctx->btnOpen = CreateWindowExW(0, L"BUTTON", openLabel.c_str(),
                                           WS_CHILD | WS_VISIBLE | BS_DEFPUSHBUTTON,
                                           xOk, y, okW, btnH, hWnd,
                                           reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDOK)), g_hInst, nullptr);
            SetUIFont(ctx->btnOpen);
            if (!ctx->embedded) {
                ctx->btnClose = CreateWindowExW(0, L"BUTTON",
                                                UiCloseLabel().c_str(),
                                                WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON,
                                                xCancel, y, cancelW, btnH, hWnd,
                                                reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDCANCEL)), g_hInst, nullptr);
                SetUIFont(ctx->btnClose);
            }

            RECT clientRc{};
            GetClientRect(hWnd, &clientRc);
            int infoY = y + btnH + gap;
            int infoW = totalW;
            int infoRemainH = std::max(ScaleY(hWnd, 74),
                                       static_cast<int>(clientRc.bottom - infoY - pad));
            ctx->selectedInfo = CreateWindowExW(0, L"STATIC", L"",
                                                WS_CHILD | WS_VISIBLE | SS_LEFT,
                                                pad, infoY, infoW, infoRemainH,
                                                hWnd,
                                                reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_SELECTED_INFO)),
                                                g_hInst, nullptr);
            SetUIFont(ctx->selectedInfo);
            UpdatePaletteSelectedInfo(ctx);

            ApplyThemeToDialog(hWnd);
            return 0;
        }
        case WM_THEMECHANGED:
            ApplyThemeToDialog(hWnd);
            return 0;
        case WM_ERASEBKGND: {
            HDC hdc = reinterpret_cast<HDC>(wParam);
            RECT rc{};
            GetClientRect(hWnd, &rc);
            HBRUSH bg = g_hThemeWindowBrush ? g_hThemeWindowBrush : reinterpret_cast<HBRUSH>(COLOR_WINDOW + 1);
            FillRect(hdc, &rc, bg);
            return 1;
        }
        case WM_CTLCOLORSTATIC:
        case WM_CTLCOLOREDIT:
        case WM_CTLCOLORLISTBOX:
        case WM_CTLCOLORBTN: {
            HDC hdc = reinterpret_cast<HDC>(wParam);
            HWND ctl = reinterpret_cast<HWND>(lParam);
            return ThemeCtlColorPanel(ctl, hdc);
        }
        case WM_DRAWITEM: {
            auto* dis = reinterpret_cast<DRAWITEMSTRUCT*>(lParam);
            if (!ctx || !dis) break;
            if (!IsPaletteSlotId(static_cast<int>(dis->CtlID))) break;
            int idx = static_cast<int>(dis->CtlID) - IDC_PALETTE_SLOT_BASE;
            if (idx < 0 || idx >= IDC_PALETTE_SLOT_COUNT) break;
            const bool isTargetSlot = (idx == ctx->selectedSlot);
            const bool isChangedSlot = (idx == ctx->changedSlot);
            DrawPaletteSlotButton(dis, ctx->colors[idx], isTargetSlot, isChangedSlot);
            return TRUE;
        }
        case WM_COMMAND: {
            int id = LOWORD(wParam);
            if (!ctx) break;
            if (id == IDOK) {
                if (OpenPaletteColorEditorForSlot(hWnd, ctx->colors, ctx->selectedSlot, ctx)) {
                    InvalidateRect(hWnd, nullptr, TRUE);
                }
                UpdatePaletteSelectedInfo(ctx);
                return 0;
            }
            if (id == IDCANCEL || id == 0) {
                if (ctx->embedded) return 0;
                DestroyWindow(hWnd);
                return 0;
            }
            if (IsPaletteSlotId(id)) {
                int idx = id - IDC_PALETTE_SLOT_BASE;
                ctx->selectedSlot = idx;
                ctx->changedSlot = -1;
                InvalidateRect(hWnd, nullptr, TRUE);
                UpdatePaletteSelectedInfo(ctx);
                return 0;
            }
            break;
        }
        case WM_CLOSE:
            if (ctx && ctx->embedded) return 0;
            DestroyWindow(hWnd);
            return 0;
        case WM_DESTROY:
            if (ctx) RestoreOwnerAfterModal(ctx->owner);
            if (ctx) ctx->done = true;
            return 0;
        default:
            break;
        }
        return DefWindowProcW(hWnd, msg, wParam, lParam);
    };
    wc.hInstance = g_hInst;
    wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
    wc.hbrBackground = g_hThemeWindowBrush ? g_hThemeWindowBrush
                                           : reinterpret_cast<HBRUSH>(COLOR_WINDOW + 1);
    wc.lpszClassName = L"PaletteSettingsDlgClass";
    RegisterClassW(&wc);
    registered = true;
}
} // namespace

bool ShowPaletteColorEditorDialog(HWND owner, COLORREF initial, COLORREF* outColor) {
    return ShowPaletteColorEditorDialogImpl(owner, initial, outColor, g_palette.data(), g_palette.size());
}

void ShowPaletteSettingsDialog(HWND owner) {
    ShowUnifiedSettingsDialog(owner, kSettingsNavPalette);
}
