namespace {
constexpr int IDC_PALETTE_SLOT_BASE = 5200;
constexpr int IDC_PALETTE_SLOT_COUNT = 8;
constexpr int IDC_PALETTE_INFO = 5216;
constexpr int IDC_PALETTE_SELECTED_INFO = 5217;
constexpr int IDC_PALETTE_SELECTED_PREVIEW = 5218;
constexpr int IDC_PALETTE_EDITOR_RED_LABEL = 5219;
constexpr int IDC_PALETTE_EDITOR_RED = 5220;
constexpr int IDC_PALETTE_EDITOR_GREEN = 5221;
constexpr int IDC_PALETTE_EDITOR_BLUE = 5222;
constexpr int IDC_PALETTE_EDITOR_HEX = 5224;
constexpr int IDC_PALETTE_EDITOR_EYEDROPPER = 5227;
constexpr int IDC_PALETTE_EDITOR_GREEN_LABEL = 5240;
constexpr int IDC_PALETTE_EDITOR_BLUE_LABEL = 5241;
constexpr int IDC_PALETTE_EDITOR_HEX_LABEL = 5242;
constexpr int IDC_PALETTE_STOCK_TITLE = 5250;
constexpr int IDC_PALETTE_STOCK_HINT = 5251;
constexpr int IDC_PALETTE_STOCK_LIST = 5252;
constexpr int IDC_PALETTE_STOCK_ADD = 5253;
constexpr int IDC_PALETTE_STOCK_USE = 5254;
constexpr int IDC_PALETTE_STOCK_REMOVE = 5255;
constexpr int IDC_PALETTE_STOCK_RELOAD = 5256;
constexpr int IDC_PALETTE_SETS_TITLE = 5260;
constexpr int IDC_PALETTE_SETS_HINT = 5261;
constexpr int IDC_PALETTE_SETS_LIST = 5262;
constexpr int IDC_PALETTE_SETS_PREVIEW = 5263;
constexpr int IDC_PALETTE_SETS_APPLY = 5264;
constexpr int IDC_PALETTE_SETS_SAVE = 5265;
constexpr int IDC_PALETTE_SETS_CLEAR = 5266;
constexpr int IDC_PALETTE_SETS_RELOAD = 5267;
constexpr int IDC_PALETTE_HUE = 5270;
constexpr int IDC_PALETTE_SV = 5271;
constexpr int IDC_PALETTE_HUE_LABEL = 5272;
constexpr int IDC_PALETTE_SV_LABEL = 5273;
constexpr int IDC_PALETTE_SAVE_STATUS = 5280;
constexpr int IDC_PALETTE_USE_COLOR = 5281;
constexpr int IDC_PALETTE_RETRY = 5282;
constexpr int IDC_PALETTE_RELOAD_ACTIVE = 5283;
// Palette page HWND timer ledger: 1 = valid numeric input debounce (500 ms).
// Killed before each commit, on invalid input, and before page destruction.
constexpr UINT_PTR kPaletteAutoSaveTimer = 1;

struct PaletteSettingsCtx {
    PaletteSettingsCtx() = default;
    PaletteSettingsCtx(const PaletteSettingsCtx&) = delete; // Gradient states borrow this object's HSV.
    PaletteSettingsCtx& operator=(const PaletteSettingsCtx&) = delete;
    HWND owner = nullptr;
    std::uint64_t retryIdentity = 0;
    bool done = false;
    bool ok = false;
    bool embedded = false;
    bool colorPickerPurpose = false;
    bool reopenOnCancel = false;
    // All eight visible slots are editable. Preserve hidden legacy picker slots.
    COLORREF colors[kToolPaletteCommandSlotCapacity]{};
    int selectedSlot = 0;
    int changedSlot = -1;
    HWND headerTitle = nullptr;
    HWND headerSubtitle = nullptr;
    HWND btnOpen = nullptr;
    HWND btnClose = nullptr;
    HWND selectedInfo = nullptr;
    HWND selectedPreview = nullptr;
    std::array<HWND, 4> editorLabels{};
    HWND editRed = nullptr;
    HWND editGreen = nullptr;
    HWND editBlue = nullptr;
    HWND editHex = nullptr;
    HWND btnEyedropper = nullptr;
    bool syncingFields = false;
    bool eyedropperActive = false;
    COLORREF eyedropperInitialColor = RGB(0, 0, 0);
    std::filesystem::path stockRoot;
    palette_stock::Snapshot stock;
    HWND stockTitle = nullptr;
    HWND stockHint = nullptr;
    HWND stockList = nullptr;
    std::array<HWND, 4> stockButtons{};
    palette_presets::Snapshot sets;
    HWND setsTitle = nullptr;
    HWND setsHint = nullptr;
    HWND setsList = nullptr;
    HWND setsPreview = nullptr;
    std::array<HWND, 4> setsButtons{};
    int scrollY = 0;
    bool layingOut = false;
    bool correctingScrollbarWidth = false;
    palette_color::Hsv hsv{};
    ui::color_gradient::State hueState{&hsv, true}, svState{&hsv, false};
    HWND hue = nullptr, sv = nullptr, hueLabel = nullptr, svLabel = nullptr;
    HWND saveStatus = nullptr, useColor = nullptr, retry = nullptr, reloadActive = nullptr;
    palette_active::Snapshot active;
    COLORREF committedColors[kToolPaletteCommandSlotCapacity]{};
    bool runtimePending = false;
    COLORREF gradientInitialColor = RGB(0, 0, 0);
};

static void DrawPaletteSlotButton(const DRAWITEMSTRUCT* dis, COLORREF color, bool isTargetSlot, bool isChangedSlot) {
    if (!dis) return;
    RECT rc = dis->rcItem;
    const bool selected = (dis->itemState & ODS_SELECTED) != 0;
    const bool focused = (dis->itemState & ODS_FOCUS) != 0;

    HBRUSH fill = CreateSolidBrush(color);
    FillRect(dis->hDC, &rc, fill);
    DeleteObject(fill);

    int borderWidth = selected ? 2 : 1;
    COLORREF borderColor = RGB(0, 0, 0);
    if (isChangedSlot) {
        borderWidth = 3;
        borderColor = RGB(220, 70, 40);
    } else if (isTargetSlot) {
        borderWidth = 3;
        borderColor = g_theme.accent;
    }

    HPEN border = CreatePen(PS_SOLID, borderWidth, borderColor);
    HGDIOBJ oldPen = SelectObject(dis->hDC, border);
    HGDIOBJ oldBrush = SelectObject(dis->hDC, GetStockObject(HOLLOW_BRUSH));
    Rectangle(dis->hDC, rc.left, rc.top, rc.right, rc.bottom);
    SelectObject(dis->hDC, oldBrush);
    SelectObject(dis->hDC, oldPen);
    DeleteObject(border);

    if (isChangedSlot || isTargetSlot) {
        RECT rcInner = rc;
        InflateRect(&rcInner, -4, -4);
        if (rcInner.right > rcInner.left && rcInner.bottom > rcInner.top) {
            HPEN innerBorder = CreatePen(PS_SOLID, 1, RGB(255, 255, 255));
            HGDIOBJ oldPen2 = SelectObject(dis->hDC, innerBorder);
            HGDIOBJ oldBrush2 = SelectObject(dis->hDC, GetStockObject(HOLLOW_BRUSH));
            Rectangle(dis->hDC, rcInner.left, rcInner.top, rcInner.right, rcInner.bottom);
            SelectObject(dis->hDC, oldBrush2);
            SelectObject(dis->hDC, oldPen2);
            DeleteObject(innerBorder);
        }
    }

    if (focused) {
        RECT rcFocus = rc;
        InflateRect(&rcFocus, -3, -3);
        DrawFocusRect(dis->hDC, &rcFocus);
    }

    if (dis->CtlID >= IDC_PALETTE_SLOT_BASE &&
        dis->CtlID < IDC_PALETTE_SLOT_BASE + IDC_PALETTE_SLOT_COUNT) {
        // Slot numbers remain visible even when adjacent palette colors are similar.
        const int luminance = (GetRValue(color) * 299 + GetGValue(color) * 587 + GetBValue(color) * 114) / 1000;
        SetBkMode(dis->hDC, TRANSPARENT);
        SetTextColor(dis->hDC, luminance >= 150 ? RGB(20, 20, 20) : RGB(255, 255, 255));
        const std::wstring slotNumber = std::to_wstring(dis->CtlID - IDC_PALETTE_SLOT_BASE + 1);
        DrawTextW(dis->hDC, slotNumber.c_str(), -1, &rc,
                  DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
    }
}

static bool IsPaletteSlotId(int id) {
    return id >= IDC_PALETTE_SLOT_BASE && id < IDC_PALETTE_SLOT_BASE + IDC_PALETTE_SLOT_COUNT;
}

static bool TryReadPaletteChannel(HWND hWnd, int id, BYTE* out) {
    if (!out) return false;
    HWND edit = GetDlgItem(hWnd, id);
    const int len = edit ? GetWindowTextLengthW(edit) : 0;
    if (!edit || len <= 0 || len > 3) return false;
    std::wstring text(static_cast<size_t>(len) + 1, L'\0');
    GetWindowTextW(edit, text.data(), len + 1);
    wchar_t* end = nullptr;
    const long value = wcstol(text.c_str(), &end, 10);
    if (end == text.c_str() || *end != L'\0' || value < 0 || value > 255) return false;
    *out = static_cast<BYTE>(value);
    return true;
}

static bool ReadPaletteEditorRgb(HWND hWnd, COLORREF* out) {
    BYTE r{}, g{}, b{};
    if (!TryReadPaletteChannel(hWnd, IDC_PALETTE_EDITOR_RED, &r) ||
        !TryReadPaletteChannel(hWnd, IDC_PALETTE_EDITOR_GREEN, &g) ||
        !TryReadPaletteChannel(hWnd, IDC_PALETTE_EDITOR_BLUE, &b)) {
        return false;
    }
    if (out) *out = RGB(r, g, b);
    return true;
}

static bool TryReadPaletteHex(HWND hWnd, COLORREF* out) {
    if (!out) return false;
    HWND edit = GetDlgItem(hWnd, IDC_PALETTE_EDITOR_HEX);
    const int len = edit ? GetWindowTextLengthW(edit) : 0;
    if (!edit || len < 6 || len > 7) return false;
    std::wstring text(static_cast<size_t>(len) + 1, L'\0');
    GetWindowTextW(edit, text.data(), len + 1);
    text.resize(static_cast<size_t>(len));
    if (!text.empty() && text.front() == L'#') text.erase(text.begin());
    if (text.size() != 6) return false;
    auto hexDigit = [](wchar_t ch) -> int {
        if (ch >= L'0' && ch <= L'9') return ch - L'0';
        if (ch >= L'a' && ch <= L'f') return ch - L'a' + 10;
        if (ch >= L'A' && ch <= L'F') return ch - L'A' + 10;
        return -1;
    };
    int rgb[3]{};
    for (int i = 0; i < 3; ++i) {
        const int high = hexDigit(text[static_cast<size_t>(i) * 2]);
        const int low = hexDigit(text[static_cast<size_t>(i) * 2 + 1]);
        if (high < 0 || low < 0) return false;
        rgb[i] = high * 16 + low;
    }
    *out = RGB(rgb[0], rgb[1], rgb[2]);
    return true;
}

static std::wstring PaletteEditorHex(COLORREF color) {
    wchar_t text[8]{};
    swprintf(text, std::size(text), L"#%02X%02X%02X", GetRValue(color), GetGValue(color), GetBValue(color));
    return text;
}

static bool SamplePaletteColorAtCursor(COLORREF* outColor) {
    if (!outColor) return false;
    POINT pt{};
    if (!GetCursorPos(&pt)) return false;
    HDC screen = GetDC(nullptr);
    if (!screen) return false;
    const COLORREF color = GetPixel(screen, pt.x, pt.y);
    ReleaseDC(nullptr, screen);
    if (color == CLR_INVALID) return false;
    *outColor = color;
    return true;
}

static bool ReadPaletteEditorColor(HWND hWnd, COLORREF* out) {
    COLORREF color{};
    COLORREF hexColor{};
    if (!ReadPaletteEditorRgb(hWnd, &color) || !TryReadPaletteHex(hWnd, &hexColor) || color != hexColor) return false;
    if (out) *out = color;
    return true;
}

MAYBE_UNUSED static std::wstring PaletteHexColorW(COLORREF c) {
    wchar_t buf[16]{};
    swprintf(buf, std::size(buf), L"#%02X%02X%02X", GetRValue(c), GetGValue(c), GetBValue(c));
    return std::wstring(buf);
}

// Keep repeated drag samples from repainting controls whose displayed value
// has not changed. Do not reset the caret in the user's source edit.
static void SetPaletteControlText(HWND control, const std::wstring& text) {
    if (!control) return;
    const int length = GetWindowTextLengthW(control);
    if (length >= 0 && static_cast<size_t>(length) == text.size()) {
        std::wstring current(static_cast<size_t>(length) + 1, L'\0');
        current.resize(static_cast<size_t>(GetWindowTextW(control, current.data(), length + 1)));
        if (current == text) return;
    }
    SetWindowTextW(control, text.c_str());
}

static void InvalidatePaletteSlot(HWND page, int slot) {
    if (slot < 0 || slot >= IDC_PALETTE_SLOT_COUNT) return;
    if (HWND button = GetDlgItem(page, IDC_PALETTE_SLOT_BASE + slot)) InvalidateRect(button, nullptr, FALSE);
}

static void InvalidatePaletteSlots(HWND page) {
    for (int slot = 0; slot < IDC_PALETTE_SLOT_COUNT; ++slot) InvalidatePaletteSlot(page, slot);
}

static void UpdatePaletteSelectedInfo(PaletteSettingsCtx* ctx) {
    if (!ctx || !ctx->selectedInfo) return;
    int idx = std::clamp(ctx->selectedSlot, 0, IDC_PALETTE_SLOT_COUNT - 1);
    COLORREF c = ctx->colors[idx];
    std::wstring hex = PaletteHexColorW(c);
    std::wstring roleText;
    if (idx < 7) {
        roleText = localization::Text(L"settings.palette.be911f831213");
    } else if (idx == 7) {
        roleText = localization::Text(L"settings.palette.eaf09477bc2b");
    }
    std::wstring text = localization::Format(L"settings.palette.selected_info",
        {{L"SLOT", std::to_wstring(idx + 1)}, {L"ROLE", roleText}, {L"HEX", hex},
         {L"R", std::to_wstring(GetRValue(c))}, {L"G", std::to_wstring(GetGValue(c))},
         {L"B", std::to_wstring(GetBValue(c))}});
    if (ctx->changedSlot == idx) {
        text += localization::Text(L"settings.palette.8c31962ed379");
    }
    SetPaletteControlText(ctx->selectedInfo, text);
    if (ctx->selectedPreview) InvalidateRect(ctx->selectedPreview, nullptr, FALSE); // Owner draw fills the entire preview.
}

static void SyncPaletteSettingsEditor(HWND hWnd, PaletteSettingsCtx* ctx, COLORREF color, HWND source = nullptr) {
    if (!ctx) return;
    ctx->syncingFields = true;
    const std::array<std::pair<HWND, BYTE>, 3> channels{{
        {ctx->editRed, GetRValue(color)}, {ctx->editGreen, GetGValue(color)}, {ctx->editBlue, GetBValue(color)},
    }};
    for (const auto& [edit, value] : channels) {
        // Do not replace the field/group being typed into (caret and partial
        // input belong to the user); only synchronize the other representation.
        if (edit && source != ctx->editRed && source != ctx->editGreen && source != ctx->editBlue)
            SetPaletteControlText(edit, std::to_wstring(value));
    }
    if (ctx->editHex && source != ctx->editHex) SetPaletteControlText(ctx->editHex, PaletteEditorHex(color));
    ctx->syncingFields = false;
    if (source != ctx->hue && source != ctx->sv) ctx->hsv = palette_color::FromRgb(color, ctx->hsv.h);
    if (ctx->hue) InvalidateRect(ctx->hue, nullptr, FALSE);
    if (ctx->sv) InvalidateRect(ctx->sv, nullptr, FALSE);
}

static void SetPaletteSettingsColor(HWND hWnd, PaletteSettingsCtx* ctx, COLORREF color, bool markChanged,
                                    HWND source = nullptr) {
    if (!ctx) return;
    const int idx = std::clamp(ctx->selectedSlot, 0, IDC_PALETTE_SLOT_COUNT - 1);
    const int previousChangedSlot = ctx->changedSlot;
    ctx->colors[idx] = color;
    ctx->changedSlot = markChanged ? idx : -1;
    SyncPaletteSettingsEditor(hWnd, ctx, color, source);
    UpdatePaletteSelectedInfo(ctx);
    // A color edit changes these swatches, not the page background or stock/preset lists.
    InvalidatePaletteSlot(hWnd, idx);
    if (previousChangedSlot != idx) InvalidatePaletteSlot(hWnd, previousChangedSlot);
}

static void UpdatePaletteSettingsFromRgb(HWND hWnd, PaletteSettingsCtx* ctx, HWND source) {
    if (!ctx || ctx->syncingFields) return;
    COLORREF color{};
    if (ReadPaletteEditorRgb(hWnd, &color)) SetPaletteSettingsColor(hWnd, ctx, color, true, source);
}

static void UpdatePaletteSettingsFromHex(HWND hWnd, PaletteSettingsCtx* ctx) {
    if (!ctx || ctx->syncingFields) return;
    COLORREF color{};
    if (TryReadPaletteHex(hWnd, &color)) SetPaletteSettingsColor(hWnd, ctx, color, true, ctx->editHex);
}

static bool ValidatePaletteSettingsEditor(HWND hWnd, PaletteSettingsCtx* ctx) {
    if (!ctx) return false;
    COLORREF color{};
    if (ReadPaletteEditorColor(hWnd, &color)) return true;
    ShowSoftNotice(hWnd, localization::Text(L"settings.palette.invalid_color"), SoftNoticeKind::Warning);
    HWND invalid = ctx->editHex;
    for (int id : {IDC_PALETTE_EDITOR_RED, IDC_PALETTE_EDITOR_GREEN, IDC_PALETTE_EDITOR_BLUE}) {
        BYTE value = 0;
        if (!TryReadPaletteChannel(hWnd, id, &value)) { invalid = GetDlgItem(hWnd, id); break; }
    }
    SetFocus(invalid);
    return false;
}

static void PaletteSaveStatus(PaletteSettingsCtx* ctx, const wchar_t* id) {
    if (ctx && ctx->saveStatus) SetPaletteControlText(ctx->saveStatus, localization::Text(id));
}

static std::uint64_t s_nextPaletteRetryIdentity = 0;

[[nodiscard]] static PaletteSettingsCtx* LivePaletteRetryContext(HWND page, std::uint64_t identity) {
    if (!IsWindow(page)) return nullptr;
    wchar_t className[64]{};
    if (!GetClassNameW(page, className, static_cast<int>(std::size(className))) ||
        wcscmp(className, L"PaletteSettingsDlgClass") != 0) return nullptr;
    auto* ctx = reinterpret_cast<PaletteSettingsCtx*>(GetWindowLongPtrW(page, GWLP_USERDATA));
    return ctx && ctx->retryIdentity == identity ? ctx : nullptr;
}

[[nodiscard]] static std::wstring ActivePaletteRetryKey(const std::filesystem::path& root) {
    return L"palette-active:" + root.wstring();
}

struct ActivePaletteRetry {
    palette_active::Snapshot snapshot;
    std::vector<COLORREF> colors;
    HWND page = nullptr;
    std::uint64_t identity = 0;
    bool fileSaved = false;
};

static void RememberActivePaletteFailure(HWND page, PaletteSettingsCtx* ctx,
                                         const std::vector<COLORREF>& colors, bool fileSaved) {
    std::string bytes;
    if (!ctx || !palette_active::Serialize(colors, bytes)) return; // The live editor still owns the draft.
    auto state = std::make_shared<ActivePaletteRetry>();
    state->snapshot = ctx->active;
    state->colors = colors;
    state->page = page;
    state->identity = ctx->retryIdentity;
    state->fileSaved = fileSaved;
    pending_write_retry::Attempt attempt;
    attempt.key = ActivePaletteRetryKey(ctx->stockRoot);
    attempt.coalesce = true;
    attempt.operation = localization::Text(L"write_retry.palette_active");
    attempt.targetPath = palette_stock::FilePath(ctx->stockRoot, L"user_palette.json").wstring();
    attempt.content = UTF8ToWide(bytes);
    for (COLORREF color : colors) {
        if (!attempt.preview.empty()) attempt.preview += L"  ";
        attempt.preview += PaletteHexColorW(color);
    }
    attempt.error = localization::Text(fileSaved
        ? L"settings.palette.auto.runtime_failed" : L"settings.palette.auto.failed");
    attempt.retry = [state](std::wstring& error) -> pending_write_retry::Result {
        if (state->snapshot.root != std::filesystem::path(g_workspaceRoot)) {
            error = localization::Text(L"write_retry.target_changed");
            return pending_write_retry::Result::Conflict;
        }
        auto* live = LivePaletteRetryContext(state->page, state->identity);
        if (live && !std::equal(state->colors.begin(), state->colors.end(), std::begin(live->colors))) {
            error = localization::Text(L"write_retry.target_changed");
            return pending_write_retry::Result::Conflict;
        }
        palette_active::Snapshot current;
        if (!palette_active::Load(state->snapshot.root, current)) {
            error = localization::Text(L"write_retry.failed");
            return pending_write_retry::Result::Failed;
        }
        if (current.exists != state->snapshot.exists || current.bytes != state->snapshot.bytes) {
            error = localization::Text(L"write_retry.target_changed");
            return pending_write_retry::Result::Conflict;
        }
        if (!state->fileSaved) {
            SaveOperationGuard guard;
            if (!palette_active::Save(state->snapshot, state->colors)) {
                error = localization::Text(L"write_retry.failed");
                return pending_write_retry::Result::Failed;
            }
            state->fileSaved = true;
            if (live) {
                live->active = state->snapshot;
                std::copy(state->colors.begin(), state->colors.end(), std::begin(live->committedColors));
                live->runtimePending = true;
            }
        }
        bool published = false;
        if (live) {
            published = SendMessageW(GetParent(state->page), kUnifiedPaletteSavedMsg, 0, 0) != 0;
            if (published) live->runtimePending = false;
        } else {
            SyncUserPaletteToRuntime();
            published = TryPersistConfig();
            if (published && g_hMainWnd) UpdateToolbarUI(g_hMainWnd);
        }
        if (!published) {
            error = localization::Text(L"settings.palette.auto.runtime_failed");
            return pending_write_retry::Result::Failed;
        }
        if (live) PaletteSaveStatus(live, L"settings.palette.auto.saved");
        return pending_write_retry::Result::Saved;
    };
    pending_write_retry::Remember(g_hMainWnd, std::move(attempt));
}

[[nodiscard]] static bool FlushPaletteAutoSave(HWND hWnd, PaletteSettingsCtx* ctx) try {
    if (!ctx || !hWnd) return false;
    KillTimer(hWnd, kPaletteAutoSaveTimer);
    if (ctx->colorPickerPurpose) return true; // Single-color selection never commits the annotation palette.
    COLORREF color{};
    if (!ReadPaletteEditorColor(hWnd, &color)) {
        PaletteSaveStatus(ctx, L"settings.palette.auto.incomplete");
        return false;
    }
    const bool changed = !std::equal(std::begin(ctx->colors), std::end(ctx->colors), std::begin(ctx->committedColors));
    const bool committedOrPublished = changed || ctx->runtimePending;
    if (changed) {
        SaveOperationGuard guard;
        const std::vector<COLORREF> colors(std::begin(ctx->colors), std::end(ctx->colors));
        if (ctx->stockRoot != std::filesystem::path(g_workspaceRoot) || !palette_active::Save(ctx->active, colors)) {
            PaletteSaveStatus(ctx, L"settings.palette.auto.failed");
            RememberActivePaletteFailure(hWnd, ctx, colors, false);
            return false;
        }
        std::copy(std::begin(ctx->colors), std::end(ctx->colors), std::begin(ctx->committedColors));
        ctx->runtimePending = true;
    }
    if (ctx->runtimePending) {
        if (!SendMessageW(GetParent(hWnd), kUnifiedPaletteSavedMsg, 0, 0)) {
            PaletteSaveStatus(ctx, L"settings.palette.auto.runtime_failed");
            RememberActivePaletteFailure(hWnd, ctx,
                std::vector<COLORREF>(std::begin(ctx->colors), std::end(ctx->colors)), true);
            return false;
        }
        ctx->runtimePending = false;
    }
    PaletteSaveStatus(ctx, !ctx->active.ready ? L"settings.palette.auto.unavailable"
        : ctx->active.exists ? L"settings.palette.auto.saved" : L"settings.palette.auto.defaults");
    if (committedOrPublished) pending_write_retry::Forget(ActivePaletteRetryKey(ctx->stockRoot));
    return true;
} catch (...) {
    try { PaletteSaveStatus(ctx, L"settings.palette.auto.failed"); } catch (...) {}
    return false;
}

static void SchedulePaletteAutoSave(HWND hWnd, PaletteSettingsCtx* ctx) {
    if (!ctx || ctx->syncingFields || ctx->colorPickerPurpose) return;
    KillTimer(hWnd, kPaletteAutoSaveTimer);
    COLORREF color{};
    if (!ReadPaletteEditorColor(hWnd, &color)) {
        PaletteSaveStatus(ctx, L"settings.palette.auto.incomplete");
        return;
    }
    PaletteSaveStatus(ctx, L"settings.palette.auto.pending");
    if (!SetTimer(hWnd, kPaletteAutoSaveTimer, 500, nullptr)) (void)FlushPaletteAutoSave(hWnd, ctx);
}

[[nodiscard]] static bool FinishPaletteEditing(HWND hWnd, PaletteSettingsCtx* ctx, bool allowDiscard = false) try {
    if (!ctx || !hWnd || ctx->colorPickerPurpose) return true;
    if (ctx->eyedropperActive || ctx->hueState.dragging || ctx->svState.dragging) return false;
    if (FlushPaletteAutoSave(hWnd, ctx)) return true;
    if (allowDiscard) {
        SilentDialogOptions options;
        options.title = GetUiText().menuPaletteSettings;
        options.message = localization::Text(L"settings.palette.auto.discard_confirm");
        options.kind = SoftNoticeKind::Warning;
        options.buttons = SilentDialogButtons::YesNo;
        options.yesLabel = localization::Text(L"settings.palette.auto.discard_close");
        options.noLabel = localization::Text(L"settings.palette.auto.keep_editing");
        options.defaultResult = SilentDialogResult::No;
        options.escapeResult = SilentDialogResult::No;
        return ShowSilentDialog(hWnd, options) == SilentDialogResult::Yes;
    }
    ShowSoftNotice(hWnd, localization::Text(L"settings.palette.auto.finish_failed"), SoftNoticeKind::Warning);
    return false;
} catch (...) {
    return false; // Keep the editor if even the confirmation cannot be created.
}

static void UpdatePaletteStockControls(PaletteSettingsCtx* ctx, int selection = -1) {
    if (!ctx || !ctx->stockList) return;
    if (selection < 0) selection = static_cast<int>(SendMessageW(ctx->stockList, LB_GETCURSEL, 0, 0));
    SendMessageW(ctx->stockList, WM_SETREDRAW, FALSE, 0);
    SendMessageW(ctx->stockList, LB_RESETCONTENT, 0, 0);
    for (COLORREF color : ctx->stock.colors) {
        const auto hex = PaletteHexColorW(color);
        const LRESULT index = SendMessageW(ctx->stockList, LB_ADDSTRING, 0, reinterpret_cast<LPARAM>(hex.c_str()));
        if (index >= 0) SendMessageW(ctx->stockList, LB_SETITEMDATA, index, static_cast<LPARAM>(color));
    }
    if (!ctx->stock.colors.empty()) {
        selection = std::clamp(selection, 0, static_cast<int>(ctx->stock.colors.size()) - 1);
        SendMessageW(ctx->stockList, LB_SETCURSEL, selection, 0);
    }
    SendMessageW(ctx->stockList, WM_SETREDRAW, TRUE, 0);
    InvalidateRect(ctx->stockList, nullptr, TRUE);
    const auto title = localization::Format(L"settings.palette.stock.title",
        {{L"COUNT", std::to_wstring(ctx->stock.colors.size())}, {L"MAX", std::to_wstring(palette_stock::kMaxColors)}});
    SetWindowTextW(ctx->stockTitle, title.c_str());
    SetWindowTextW(ctx->stockHint, localization::Text(ctx->stock.ready
        ? L"settings.palette.stock.hint" : L"settings.palette.stock.load_failed").c_str());
    EnableWindow(ctx->stockButtons[0], ctx->stock.ready);
    const bool selected = ctx->stock.ready && !ctx->stock.colors.empty();
    EnableWindow(ctx->stockButtons[1], selected);
    EnableWindow(ctx->stockButtons[2], selected);
}

[[nodiscard]] static bool RememberStockPaletteFailure(HWND page, PaletteSettingsCtx* ctx,
                                                      const std::vector<COLORREF>& colors, int selection) {
    std::string bytes;
    if (!palette_stock::Serialize(colors, bytes)) return false;
    const auto snapshot = ctx->stock;
    const auto root = ctx->stockRoot;
    const auto identity = ctx->retryIdentity;
    pending_write_retry::Attempt attempt;
    attempt.key = L"palette-stock:" + root.wstring();
    attempt.operation = localization::Text(L"write_retry.palette_stock");
    attempt.targetPath = palette_stock::FilePath(root).wstring();
    attempt.content = UTF8ToWide(bytes);
    for (COLORREF color : colors) {
        if (!attempt.preview.empty()) attempt.preview += L"  ";
        attempt.preview += PaletteHexColorW(color);
    }
    attempt.error = localization::Text(L"settings.palette.stock.save_failed");
    attempt.retry = [page, identity, root, snapshot, colors, selection](std::wstring& error) {
        if (root != std::filesystem::path(g_workspaceRoot)) {
            error = localization::Text(L"write_retry.target_changed");
            return pending_write_retry::Result::Conflict;
        }
        auto* live = LivePaletteRetryContext(page, identity);
        if (live && (live->stock.exists != snapshot.exists || live->stock.bytes != snapshot.bytes)) {
            error = localization::Text(L"write_retry.target_changed");
            return pending_write_retry::Result::Conflict;
        }
        palette_stock::Snapshot current;
        if (!palette_stock::Load(root, current)) {
            error = localization::Text(L"write_retry.failed");
            return pending_write_retry::Result::Failed;
        }
        if (current.exists != snapshot.exists || current.bytes != snapshot.bytes) {
            error = localization::Text(L"write_retry.target_changed");
            return pending_write_retry::Result::Conflict;
        }
        auto next = snapshot;
        SaveOperationGuard guard;
        if (!palette_stock::Save(next, colors)) {
            error = localization::Text(L"write_retry.failed");
            return pending_write_retry::Result::Failed;
        }
        if (live) { live->stock = std::move(next); UpdatePaletteStockControls(live, selection); }
        return pending_write_retry::Result::Saved;
    };
    pending_write_retry::Remember(g_hMainWnd, std::move(attempt));
    return true;
}

static void ReloadPaletteStock(HWND hWnd, PaletteSettingsCtx* ctx, bool notify) {
    if (!ctx) return;
    palette_stock::Snapshot next;
    if (palette_stock::Load(ctx->stockRoot, next)) {
        ctx->stock = std::move(next);
    } else {
        ctx->stock.ready = false; // Retain existing memory/file; disable mutation.
        if (notify) ShowSoftNotice(hWnd, localization::Text(L"settings.palette.stock.load_failed"), SoftNoticeKind::Warning);
    }
    UpdatePaletteStockControls(ctx);
    if (notify) SendMessageW(hWnd, WM_SIZE, 0, 0);
}

[[nodiscard]] static const wchar_t* PaletteSetHintId(const PaletteSettingsCtx* ctx) {
    if (!ctx->sets.ready) return L"settings.palette.sets.load_failed";
    return ctx->colorPickerPurpose ? L"settings.palette.sets.hint_picker" : L"settings.palette.sets.hint";
}

static void HandlePaletteStockCommand(HWND hWnd, PaletteSettingsCtx* ctx, int id) {
    if (!ctx) return;
    if (id == IDC_PALETTE_STOCK_RELOAD) { ReloadPaletteStock(hWnd, ctx, true); return; }
    if (!ctx->stock.ready) return;
    const int selected = static_cast<int>(SendMessageW(ctx->stockList, LB_GETCURSEL, 0, 0));
    if (id == IDC_PALETTE_STOCK_USE) {
        if (selected < 0 || static_cast<size_t>(selected) >= ctx->stock.colors.size()) return;
        if (!ValidatePaletteSettingsEditor(hWnd, ctx)) return;
        SetPaletteSettingsColor(hWnd, ctx, ctx->stock.colors[static_cast<size_t>(selected)], true);
        (void)FlushPaletteAutoSave(hWnd, ctx);
        return; // Only the selected slot changes; picker purpose remains a draft.
    }
    auto colors = ctx->stock.colors;
    int nextSelection = selected;
    if (id == IDC_PALETTE_STOCK_ADD) {
        if (!ValidatePaletteSettingsEditor(hWnd, ctx)) return;
        COLORREF color{};
        if (!ReadPaletteEditorColor(hWnd, &color)) return;
        const auto existing = std::find(colors.begin(), colors.end(), color);
        if (existing != colors.end()) {
            UpdatePaletteStockControls(ctx, static_cast<int>(existing - colors.begin()));
            ShowSoftNotice(hWnd, localization::Text(L"settings.palette.stock.duplicate"));
            return;
        }
        if (colors.size() == palette_stock::kMaxColors) {
            ShowSoftNotice(hWnd, localization::Text(L"settings.palette.stock.full"), SoftNoticeKind::Warning);
            return;
        }
        colors.push_back(color);
        nextSelection = static_cast<int>(colors.size()) - 1;
    } else if (id == IDC_PALETTE_STOCK_REMOVE) {
        if (selected < 0 || static_cast<size_t>(selected) >= colors.size()) return;
        colors.erase(colors.begin() + selected);
    } else return;
    SaveOperationGuard guard;
    if (ctx->stockRoot != std::filesystem::path(g_workspaceRoot) || !palette_stock::Save(ctx->stock, colors)) {
        if (!RememberStockPaletteFailure(hWnd, ctx, colors, nextSelection))
            ShowSoftNotice(hWnd, localization::Text(L"settings.palette.stock.save_failed"), SoftNoticeKind::Warning);
        return;
    }
    UpdatePaletteStockControls(ctx, nextSelection);
    ShowSoftNotice(hWnd, localization::Text(id == IDC_PALETTE_STOCK_ADD
        ? L"settings.palette.stock.saved" : L"settings.palette.stock.removed"));
}

[[nodiscard]] static const palette_presets::Colors* SelectedPaletteSet(const PaletteSettingsCtx* ctx) {
    if (!ctx || !ctx->setsList) return nullptr;
    const int selected = static_cast<int>(SendMessageW(ctx->setsList, CB_GETCURSEL, 0, 0));
    if (selected == 0) return &palette_presets::kInitial; // Usable even if the user file is unreadable.
    if (!ctx->sets.ready || selected < 1 || selected > static_cast<int>(palette_presets::kUserCount)) return nullptr;
    const auto& colors = ctx->sets.colors.users[static_cast<size_t>(selected - 1)];
    return colors ? &*colors : nullptr;
}

static void UpdatePaletteSetControls(PaletteSettingsCtx* ctx, bool refill = false) {
    if (!ctx || !ctx->setsList) return;
    int selected = static_cast<int>(SendMessageW(ctx->setsList, CB_GETCURSEL, 0, 0));
    if (refill) {
        SendMessageW(ctx->setsList, CB_RESETCONTENT, 0, 0);
        const auto initial = localization::Text(L"settings.palette.sets.initial");
        SendMessageW(ctx->setsList, CB_ADDSTRING, 0, reinterpret_cast<LPARAM>(initial.c_str()));
        for (size_t i = 0; i < palette_presets::kUserCount; ++i) {
            const auto label = localization::Format(L"settings.palette.sets.user",
                {{L"NUMBER", std::to_wstring(i + 1)}, {L"STATE", localization::Text(!ctx->sets.ready
                    ? L"settings.palette.sets.unavailable" : ctx->sets.colors.users[i]
                    ? L"settings.palette.sets.saved_state" : L"settings.palette.sets.empty")}});
            SendMessageW(ctx->setsList, CB_ADDSTRING, 0, reinterpret_cast<LPARAM>(label.c_str()));
        }
        selected = std::clamp(selected, 0, static_cast<int>(palette_presets::kUserCount));
        SendMessageW(ctx->setsList, CB_SETCURSEL, selected, 0);
    }
    const bool user = ctx->sets.ready && selected >= 1 && selected <= static_cast<int>(palette_presets::kUserCount);
    const auto* colors = SelectedPaletteSet(ctx);
    EnableWindow(ctx->setsButtons[0], colors != nullptr);
    EnableWindow(ctx->setsButtons[1], user);
    EnableWindow(ctx->setsButtons[2], user && colors != nullptr);
    SetWindowTextW(ctx->setsHint, localization::Text(PaletteSetHintId(ctx)).c_str());
    InvalidateRect(ctx->setsPreview, nullptr, TRUE);
}

[[nodiscard]] static bool RememberPaletteSetFailure(HWND page, PaletteSettingsCtx* ctx,
                                                    const palette_presets::Document& doc) {
    std::string bytes;
    if (!palette_presets::Serialize(doc, bytes)) return false;
    const auto snapshot = ctx->sets;
    const auto root = ctx->stockRoot;
    const auto identity = ctx->retryIdentity;
    pending_write_retry::Attempt attempt;
    attempt.key = L"palette-sets:" + root.wstring();
    attempt.operation = localization::Text(L"write_retry.palette_sets");
    attempt.targetPath = palette_presets::FilePath(root).wstring();
    attempt.content = UTF8ToWide(bytes);
    attempt.error = localization::Text(L"settings.palette.sets.save_failed");
    attempt.retry = [page, identity, root, snapshot, doc](std::wstring& error) {
        if (root != std::filesystem::path(g_workspaceRoot)) {
            error = localization::Text(L"write_retry.target_changed");
            return pending_write_retry::Result::Conflict;
        }
        auto* live = LivePaletteRetryContext(page, identity);
        if (live && (live->sets.exists != snapshot.exists || live->sets.bytes != snapshot.bytes)) {
            error = localization::Text(L"write_retry.target_changed");
            return pending_write_retry::Result::Conflict;
        }
        palette_presets::Snapshot current;
        if (!palette_presets::Load(root, current)) {
            error = localization::Text(L"write_retry.failed");
            return pending_write_retry::Result::Failed;
        }
        if (current.exists != snapshot.exists || current.bytes != snapshot.bytes) {
            error = localization::Text(L"write_retry.target_changed");
            return pending_write_retry::Result::Conflict;
        }
        auto next = snapshot;
        SaveOperationGuard guard;
        if (!palette_presets::Save(next, doc)) {
            error = localization::Text(L"write_retry.failed");
            return pending_write_retry::Result::Failed;
        }
        if (live) { live->sets = std::move(next); UpdatePaletteSetControls(live, true); }
        return pending_write_retry::Result::Saved;
    };
    pending_write_retry::Remember(g_hMainWnd, std::move(attempt));
    return true;
}

static void ReloadPaletteSets(HWND hWnd, PaletteSettingsCtx* ctx, bool notify) {
    if (!ctx) return;
    palette_presets::Snapshot next;
    if (palette_presets::Load(ctx->stockRoot, next)) ctx->sets = std::move(next);
    else {
        ctx->sets.ready = false; // A damaged file is never treated as five writable empty slots.
        if (notify) ShowSoftNotice(hWnd, localization::Text(L"settings.palette.sets.load_failed"), SoftNoticeKind::Warning);
    }
    UpdatePaletteSetControls(ctx, true);
    if (notify) SendMessageW(hWnd, WM_SIZE, 0, 0);
}

[[nodiscard]] static bool ConfirmPaletteSetChange(HWND hWnd, const wchar_t* message, const wchar_t* action) {
    SilentDialogOptions options;
    options.title = localization::Text(L"settings.palette.sets.title");
    options.message = localization::Text(message);
    options.kind = SoftNoticeKind::Warning;
    options.buttons = SilentDialogButtons::YesNo;
    options.yesLabel = localization::Text(action);
    options.noLabel = localization::Text(L"settings.palette.sets.keep");
    options.defaultResult = SilentDialogResult::No;
    options.escapeResult = SilentDialogResult::No;
    return ShowSilentDialog(hWnd, options) == SilentDialogResult::Yes;
}

static void HandlePaletteSetCommand(HWND hWnd, PaletteSettingsCtx* ctx, int id) {
    if (!ctx) return;
    if (id == IDC_PALETTE_SETS_RELOAD) { ReloadPaletteSets(hWnd, ctx, true); return; }
    const int selected = static_cast<int>(SendMessageW(ctx->setsList, CB_GETCURSEL, 0, 0));
    if (id == IDC_PALETTE_SETS_APPLY) {
        const auto* colors = SelectedPaletteSet(ctx);
        if (!colors || !ValidatePaletteSettingsEditor(hWnd, ctx)) return;
        if (!std::equal(colors->begin(), colors->end(), ctx->colors) &&
            !ConfirmPaletteSetChange(hWnd, ctx->colorPickerPurpose ? L"settings.palette.sets.apply_confirm"
                : L"settings.palette.sets.apply_confirm_active", L"settings.palette.sets.apply")) return;
        std::copy(colors->begin(), colors->end(), ctx->colors); // Eight slots only; stock and legacy slots stay untouched.
        ctx->changedSlot = -1;
        SyncPaletteSettingsEditor(hWnd, ctx, ctx->colors[ctx->selectedSlot]);
        UpdatePaletteSelectedInfo(ctx);
        InvalidatePaletteSlots(hWnd);
        if (FlushPaletteAutoSave(hWnd, ctx)) ShowSoftNotice(hWnd, localization::Text(L"settings.palette.sets.applied"));
        return;
    }
    // Defense in depth: the immutable initial set has no writable slot in the document.
    if (!ctx->sets.ready || selected < 1 || selected > static_cast<int>(palette_presets::kUserCount)) return;
    auto doc = ctx->sets.colors;
    auto& target = doc.users[static_cast<size_t>(selected - 1)];
    if (id == IDC_PALETTE_SETS_SAVE) {
        if (!ValidatePaletteSettingsEditor(hWnd, ctx)) return;
        if (target && !ConfirmPaletteSetChange(hWnd, L"settings.palette.sets.overwrite_confirm", L"settings.palette.sets.overwrite")) return;
        palette_presets::Colors colors{};
        std::copy_n(ctx->colors, colors.size(), colors.begin());
        target = colors;
    } else if (id == IDC_PALETTE_SETS_CLEAR) {
        if (!target || !ConfirmPaletteSetChange(hWnd, L"settings.palette.sets.clear_confirm", L"settings.palette.sets.clear")) return;
        target.reset();
    } else return;
    SaveOperationGuard guard;
    if (ctx->stockRoot != std::filesystem::path(g_workspaceRoot) || !palette_presets::Save(ctx->sets, doc)) {
        if (!RememberPaletteSetFailure(hWnd, ctx, doc))
            ShowSoftNotice(hWnd, localization::Text(L"settings.palette.sets.save_failed"), SoftNoticeKind::Warning);
        return;
    }
    UpdatePaletteSetControls(ctx, true);
    ShowSoftNotice(hWnd, localization::Text(id == IDC_PALETTE_SETS_SAVE
        ? L"settings.palette.sets.saved" : L"settings.palette.sets.cleared"));
}

static void ScrollPaletteSettingsPage(HWND hWnd, PaletteSettingsCtx* ctx, int position) {
    SCROLLINFO info{sizeof(info), SIF_RANGE | SIF_PAGE};
    if (!ctx || !GetScrollInfo(hWnd, SB_VERT, &info)) return;
    position = std::clamp(position, 0, std::max(0, info.nMax - static_cast<int>(info.nPage) + 1));
    const int delta = ctx->scrollY - position;
    ctx->scrollY = position;
    SetScrollPos(hWnd, SB_VERT, position, TRUE);
    if (delta) ScrollWindowEx(hWnd, 0, delta, nullptr, nullptr, nullptr, nullptr,
                              SW_SCROLLCHILDREN | SW_INVALIDATE | SW_ERASE);
}

static void LayoutPaletteSettingsPage(HWND hWnd, PaletteSettingsCtx* ctx) {
    if (!hWnd || !ctx || !ctx->stockList || ctx->layingOut) return;
    ctx->layingOut = true;
    RECT clientRc{};
    GetClientRect(hWnd, &clientRc);
    const int clientW = std::max(0, static_cast<int>(clientRc.right - clientRc.left));
    const int clientH = std::max(0, static_cast<int>(clientRc.bottom - clientRc.top));
    const int pad = ScaleY(hWnd, 16);
    const int gap = ScaleY(hWnd, 10);
    const int rowH = std::max(ScaleY(hWnd, 30), FontLineHeightPx(hWnd, g_hUIFont) + ScaleY(hWnd, 10));
    const int gridY = ctx->embedded ? pad : (pad + rowH + ScaleY(hWnd, 40));
    const int minSlotW = ScaleY(hWnd, 44);
    const int fullRowMinW = IDC_PALETTE_SLOT_COUNT * minSlotW +
                            (IDC_PALETTE_SLOT_COUNT - 1) * gap;
    // A full row is the normal presentation.  Only narrow windows fold it into
    // two rows, so that the color choices remain usable at high DPI as well.
    const bool fullRow = clientW - pad * 2 >= fullRowMinW;
    const int columns = fullRow ? IDC_PALETTE_SLOT_COUNT : 4;
    const bool sideBySide = fullRow && clientW >= fullRowMinW + ScaleY(hWnd, 250) + pad * 3;
    const int leftW = sideBySide
        ? std::clamp(clientW * 55 / 100, fullRowMinW, clientW - ScaleY(hWnd, 250) - pad * 3)
        : std::max(ScaleY(hWnd, 280), clientW - pad * 2);
    const int slotW = std::max(minSlotW, (leftW - (columns - 1) * gap) / columns);
    const int slotH = std::max(ScaleY(hWnd, 54), rowH + ScaleY(hWnd, 18));
    for (int i = 0; i < IDC_PALETTE_SLOT_COUNT; ++i) {
        const int row = i / columns;
        const int col = i % columns;
        if (HWND slot = GetDlgItem(hWnd, IDC_PALETTE_SLOT_BASE + i)) {
            SetWindowPos(slot, nullptr, pad + col * (slotW + gap), gridY + row * (slotH + gap), slotW, slotH,
                         SWP_NOZORDER | SWP_NOACTIVATE);
        }
    }

    const int rows = (IDC_PALETTE_SLOT_COUNT + columns - 1) / columns;
    const int actionY = gridY + rows * slotH + (rows - 1) * gap + ScaleY(hWnd, 14);
    if (ctx->btnClose) {
        SetWindowPos(ctx->btnClose, nullptr, pad + std::min(leftW, ScaleY(hWnd, 190)) + gap, actionY,
                     ScaleY(hWnd, 96), rowH, SWP_NOZORDER | SWP_NOACTIVATE);
    }

    const int setsY = actionY + (ctx->btnClose ? rowH + gap : 0);
    const int setsHintH = std::max(ScaleY(hWnd, 64), MeasureTextHeight(hWnd,
        localization::Text(PaletteSetHintId(ctx)), leftW, g_hUIFont));
    SetWindowPos(ctx->setsTitle, nullptr, pad, setsY, leftW, rowH, SWP_NOZORDER | SWP_NOACTIVATE);
    SetWindowPos(ctx->setsHint, nullptr, pad, setsY + rowH, leftW, setsHintH, SWP_NOZORDER | SWP_NOACTIVATE);
    const int setsListY = setsY + rowH + setsHintH + gap;
    SetWindowPos(ctx->setsList, nullptr, pad, setsListY, leftW, rowH * 8, SWP_NOZORDER | SWP_NOACTIVATE);
    const int setsPreviewY = setsListY + rowH + gap;
    SetWindowPos(ctx->setsPreview, nullptr, pad, setsPreviewY, leftW, rowH, SWP_NOZORDER | SWP_NOACTIVATE);
    const int buttonW = (leftW - gap) / 2;
    for (size_t i = 0; i < ctx->setsButtons.size(); ++i) {
        SetWindowPos(ctx->setsButtons[i], nullptr, pad + static_cast<int>(i % 2) * (buttonW + gap),
            setsPreviewY + rowH + gap + static_cast<int>(i / 2) * (rowH + gap), buttonW, rowH,
            SWP_NOZORDER | SWP_NOACTIVATE);
    }
    const int stockY = setsPreviewY + rowH * 3 + gap * 3 + ScaleY(hWnd, 12);
    const int hintH = std::max(ScaleY(hWnd, 56), MeasureTextHeight(hWnd,
        localization::Text(ctx->stock.ready ? L"settings.palette.stock.hint" : L"settings.palette.stock.load_failed"), leftW, g_hUIFont));
    const int listY = stockY + rowH + hintH + gap;
    const int listH = std::max(ScaleY(hWnd, 96), std::min(ScaleY(hWnd, 260), clientH - listY - rowH * 2 - gap * 3 - pad));
    SetWindowPos(ctx->stockTitle, nullptr, pad, stockY, leftW, rowH, SWP_NOZORDER | SWP_NOACTIVATE);
    SetWindowPos(ctx->stockHint, nullptr, pad, stockY + rowH, leftW, hintH, SWP_NOZORDER | SWP_NOACTIVATE);
    SetWindowPos(ctx->stockList, nullptr, pad, listY, leftW, listH, SWP_NOZORDER | SWP_NOACTIVATE);
    for (size_t i = 0; i < ctx->stockButtons.size(); ++i) {
        SetWindowPos(ctx->stockButtons[i], nullptr, pad + static_cast<int>(i % 2) * (buttonW + gap),
            listY + listH + gap + static_cast<int>(i / 2) * (rowH + gap), buttonW, rowH,
            SWP_NOZORDER | SWP_NOACTIVATE);
    }
    const int stockBottom = listY + listH + rowH * 2 + gap * 2;
    const int rightX = sideBySide ? pad + leftW + ScaleY(hWnd, 24) : pad;
    const int rightY = sideBySide ? gridY : stockBottom + ScaleY(hWnd, 24);
    const int rightW = sideBySide ? std::max(ScaleY(hWnd, 210), clientW - rightX - pad) : leftW;
    const int hueY = rightY + rowH;
    const int svY = hueY + rowH + gap + rowH;
    const int svH = ScaleY(hWnd, 170);
    SetWindowPos(ctx->hueLabel, nullptr, rightX, rightY, rightW, rowH, SWP_NOZORDER | SWP_NOACTIVATE);
    SetWindowPos(ctx->hue, nullptr, rightX, hueY, rightW, rowH, SWP_NOZORDER | SWP_NOACTIVATE);
    SetWindowPos(ctx->svLabel, nullptr, rightX, hueY + rowH + gap, rightW, rowH, SWP_NOZORDER | SWP_NOACTIVATE);
    SetWindowPos(ctx->sv, nullptr, rightX, svY, rightW, svH, SWP_NOZORDER | SWP_NOACTIVATE);
    const int previewY = svY + svH + gap;
    const int previewH = ScaleY(hWnd, 36);
    if (ctx->selectedPreview) {
        SetWindowPos(ctx->selectedPreview, nullptr, rightX, previewY, rightW, previewH,
                     SWP_NOZORDER | SWP_NOACTIVATE);
    }
    if (ctx->selectedInfo) {
        SetWindowPos(ctx->selectedInfo, nullptr, rightX, previewY + previewH + gap, rightW,
                     ScaleY(hWnd, 52),
                     SWP_NOZORDER | SWP_NOACTIVATE);
    }
    const int editorY = previewY + previewH + gap + ScaleY(hWnd, 58);
    const int channelGap = ScaleY(hWnd, 8);
    const int channelW = std::max(ScaleY(hWnd, 54), (rightW - channelGap * 2) / 3);
    const std::array<HWND, 3> channelEdits{{ctx->editRed, ctx->editGreen, ctx->editBlue}};
    for (int i = 0; i < 3; ++i) {
        const int x = rightX + i * (channelW + channelGap);
        if (ctx->editorLabels[static_cast<size_t>(i)]) {
            SetWindowPos(ctx->editorLabels[static_cast<size_t>(i)], nullptr, x, editorY, channelW, rowH,
                         SWP_NOZORDER | SWP_NOACTIVATE);
        }
        if (channelEdits[static_cast<size_t>(i)]) {
            SetWindowPos(channelEdits[static_cast<size_t>(i)], nullptr, x, editorY + rowH, channelW, rowH,
                         SWP_NOZORDER | SWP_NOACTIVATE);
        }
    }
    const int hexY = editorY + rowH * 2 + gap;
    const auto eyeLabel = localization::Text(L"settings.palette.eyedropper");
    SIZE eyeText{};
    if (HDC dc = GetDC(hWnd)) {
        const auto oldFont = SelectObject(dc, g_hUIFont);
        GetTextExtentPoint32W(dc, eyeLabel.c_str(), static_cast<int>(eyeLabel.size()), &eyeText);
        SelectObject(dc, oldFont);
        ReleaseDC(hWnd, dc);
    }
    const int eyeW = std::max(ScaleY(hWnd, 92), static_cast<int>(eyeText.cx) + gap * 2);
    const bool eyeBelow = rightW < ScaleY(hWnd, 44 + 80) + gap + eyeW;
    const int eyeY = eyeBelow ? hexY + rowH + gap : hexY;
    if (ctx->editorLabels[3]) SetWindowPos(ctx->editorLabels[3], nullptr, rightX, hexY, ScaleY(hWnd, 42), rowH,
                                            SWP_NOZORDER | SWP_NOACTIVATE);
    if (ctx->editHex) SetWindowPos(ctx->editHex, nullptr, rightX + ScaleY(hWnd, 44), hexY,
                                   std::max(ScaleY(hWnd, 64), rightW - ScaleY(hWnd, 44) - (eyeBelow ? 0 : eyeW + gap)), rowH,
                                   SWP_NOZORDER | SWP_NOACTIVATE);
    if (ctx->btnEyedropper) SetWindowPos(ctx->btnEyedropper, nullptr, eyeBelow ? rightX : rightX + rightW - eyeW, eyeY,
                                         eyeBelow ? rightW : eyeW, rowH,
                                         SWP_NOZORDER | SWP_NOACTIVATE);
    const int statusY = eyeY + rowH + gap;
    int statusH = rowH * 3;
    for (const wchar_t* id : {L"settings.palette.auto.saved", L"settings.palette.auto.incomplete",
        L"settings.palette.auto.failed", L"settings.palette.auto.runtime_failed", L"settings.palette.auto.unavailable",
        L"settings.palette.select_hint"}) statusH = std::max(statusH, MeasureTextHeight(hWnd, localization::Text(id), rightW, g_hUIFont));
    SetWindowPos(ctx->saveStatus, nullptr, rightX, statusY, rightW, statusH, SWP_NOZORDER | SWP_NOACTIVATE);
    const int commitY = statusY + statusH + gap;
    if (ctx->colorPickerPurpose) SetWindowPos(ctx->useColor, nullptr, rightX, commitY, rightW, rowH, SWP_NOZORDER | SWP_NOACTIVATE);
    else {
        SetWindowPos(ctx->retry, nullptr, rightX, commitY, (rightW - gap) / 2, rowH, SWP_NOZORDER | SWP_NOACTIVATE);
        SetWindowPos(ctx->reloadActive, nullptr, rightX + (rightW + gap) / 2, commitY, (rightW - gap) / 2, rowH, SWP_NOZORDER | SWP_NOACTIVATE);
    }
    const int contentH = std::max(stockBottom, commitY + rowH) + pad;
    ctx->scrollY = std::clamp(ctx->scrollY, 0, std::max(0, contentH - clientH));
    SCROLLINFO scroll{sizeof(scroll), SIF_RANGE | SIF_PAGE | SIF_POS};
    scroll.nMax = contentH - 1;
    scroll.nPage = static_cast<UINT>(clientH);
    scroll.nPos = ctx->scrollY;
    SetScrollInfo(hWnd, SB_VERT, &scroll, TRUE);
    if (ctx->scrollY) {
        for (HWND child = GetWindow(hWnd, GW_CHILD); child; child = GetWindow(child, GW_HWNDNEXT)) {
            RECT bounds{};
            GetWindowRect(child, &bounds);
            MapWindowPoints(nullptr, hWnd, reinterpret_cast<POINT*>(&bounds), 2);
            SetWindowPos(child, nullptr, bounds.left, bounds.top - ctx->scrollY, 0, 0,
                         SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
        }
    }
    RECT finalClient{};
    GetClientRect(hWnd, &finalClient);
    const bool widthChanged = finalClient.right - finalClient.left != clientW;
    ctx->layingOut = false;
    if (widthChanged && !ctx->correctingScrollbarWidth) {
        // SetScrollInfo may expose the vertical bar and shrink the client after
        // the controls were placed. Recompute against that actual width once.
        ctx->correctingScrollbarWidth = true;
        LayoutPaletteSettingsPage(hWnd, ctx);
        ctx->correctingScrollbarWidth = false;
    }
}

static void EnsurePaletteSettingsClass() {
    static bool registered = false;
    if (registered) return;
    WNDCLASSW wc{};
    wc.lpfnWndProc = [](HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam) -> LRESULT {
        auto* ctx = reinterpret_cast<PaletteSettingsCtx*>(GetWindowLongPtrW(hWnd, GWLP_USERDATA));
        try {
        switch (msg) {
        case WM_CREATE: {
            auto cs = reinterpret_cast<CREATESTRUCTW*>(lParam);
            ctx = reinterpret_cast<PaletteSettingsCtx*>(cs->lpCreateParams);
            SetWindowLongPtrW(hWnd, GWLP_USERDATA, reinterpret_cast<LONG_PTR>(ctx));
            if (!ctx) return -1;
            ctx->retryIdentity = ++s_nextPaletteRetryIdentity;

            LoadUserPaletteColorsForSettings(ctx->colors, std::size(ctx->colors));

            const int pad = ScaleY(hWnd, 12);
            const int gap = ScaleY(hWnd, 6);
            const int slotW = ScaleY(hWnd, 36);
            const int slotH = ScaleY(hWnd, 32);
            const int rowH = std::max(ScaleY(hWnd, 28), FontLineHeightPx(hWnd, g_hUIFont) + ScaleY(hWnd, 10));
            const int columns = 8;
            const int titleH = std::max(rowH, ScaleY(hWnd, 30));
            std::wstring subtitle = localization::Text(L"settings.palette.3fec070b879c");
            int subtitleH = ctx->embedded ? 0
                                          : std::max(FontLineHeightPx(hWnd, g_hUIFont) + ScaleY(hWnd, 4),
                                                     MeasureTextHeight(hWnd, subtitle, ScaleY(hWnd, 360), g_hUIFont));
            if (!ctx->embedded) {
                ctx->headerTitle = CreateWindowExW(0, L"STATIC",
                                                   GetUiText().menuPaletteSettings.c_str(),
                                                   WS_CHILD | WS_VISIBLE,
                                                   pad, pad, ScaleY(hWnd, 360), titleH,
                                                   hWnd, nullptr, g_hInst, nullptr);
                ctx->headerSubtitle = CreateWindowExW(0, L"STATIC", subtitle.c_str(),
                                                      WS_CHILD | WS_VISIBLE,
                                                      pad, pad + titleH, ScaleY(hWnd, 360), subtitleH,
                                                      hWnd, reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_INFO)),
                                                      g_hInst, nullptr);
                SetUIFont(ctx->headerTitle);
                SetUIFont(ctx->headerSubtitle);
            }

            int gridY = ctx->embedded ? pad : (pad + titleH + subtitleH + ScaleY(hWnd, 12));
            for (int i = 0; i < IDC_PALETTE_SLOT_COUNT; ++i) {
                int row = i / columns;
                int col = i % columns;
                int x = pad + col * (slotW + gap);
                int yy = gridY + row * (slotH + gap);
                std::wstring label = std::to_wstring(i + 1);
                HWND btn = CreateWindowExW(0, L"BUTTON", label.c_str(),
                                           WS_CHILD | WS_VISIBLE | BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP,
                                           x, yy, slotW, slotH, hWnd,
                                           reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_SLOT_BASE + i)),
                                           g_hInst, nullptr);
                SetUIFont(btn);
            }

            int rows = (IDC_PALETTE_SLOT_COUNT + columns - 1) / columns;
            int y = gridY + rows * slotH + std::max(0, rows - 1) * gap + ScaleY(hWnd, 10);
            int btnH = rowH;
            int cancelW = ScaleY(hWnd, 96);
            int totalW = columns * slotW + (columns - 1) * gap;
            int xCancel = pad + totalW - cancelW;

            if (!ctx->embedded) {
                ctx->btnClose = CreateWindowExW(0, L"BUTTON",
                                                UiCloseLabel().c_str(),
                                                WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON,
                                                xCancel, y, cancelW, btnH, hWnd,
                                                reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDCANCEL)), g_hInst, nullptr);
                SetUIFont(ctx->btnClose);
            }

            RECT clientRc{};
            GetClientRect(hWnd, &clientRc);
            int infoY = y + btnH + gap;
            int infoW = totalW;
            int infoRemainH = std::max(ScaleY(hWnd, 74),
                                       static_cast<int>(clientRc.bottom - infoY - pad));
            ctx->selectedInfo = CreateWindowExW(0, L"STATIC", L"",
                                                WS_CHILD | WS_VISIBLE | SS_LEFT,
                                                pad, infoY, infoW, infoRemainH,
                                                hWnd,
                                                reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_SELECTED_INFO)),
                                                g_hInst, nullptr);
            ctx->selectedPreview = CreateWindowExW(0, L"STATIC", L"",
                                                   WS_CHILD | WS_VISIBLE | SS_OWNERDRAW,
                                                   pad, infoY, infoW, ScaleY(hWnd, 96),
                                                   hWnd,
                                                   reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_SELECTED_PREVIEW)),
                                                   g_hInst, nullptr);
            const std::array<std::pair<const wchar_t*, int>, 4> editorLabels{{
                {L"R", IDC_PALETTE_EDITOR_RED_LABEL}, {L"G", IDC_PALETTE_EDITOR_GREEN_LABEL},
                {L"B", IDC_PALETTE_EDITOR_BLUE_LABEL}, {L"HEX", IDC_PALETTE_EDITOR_HEX_LABEL},
            }};
            for (size_t i = 0; i < editorLabels.size(); ++i) {
                ctx->editorLabels[i] = CreateWindowExW(0, L"STATIC", editorLabels[i].first,
                                                        WS_CHILD | WS_VISIBLE,
                                                        pad, infoY, ScaleY(hWnd, 40), rowH,
                                                        hWnd, reinterpret_cast<HMENU>(static_cast<INT_PTR>(editorLabels[i].second)),
                                                        g_hInst, nullptr);
                SetUIFont(ctx->editorLabels[i]);
            }
            const std::array<std::pair<int, HWND*>, 3> channels{{
                {IDC_PALETTE_EDITOR_RED, &ctx->editRed}, {IDC_PALETTE_EDITOR_GREEN, &ctx->editGreen},
                {IDC_PALETTE_EDITOR_BLUE, &ctx->editBlue},
            }};
            for (const auto& [id, target] : channels) {
                *target = CreateWindowExW(WS_EX_CLIENTEDGE, L"EDIT", L"",
                                          WS_CHILD | WS_VISIBLE | WS_TABSTOP | ES_AUTOHSCROLL | ES_NUMBER,
                                          pad, infoY, ScaleY(hWnd, 64), rowH, hWnd,
                                          reinterpret_cast<HMENU>(static_cast<INT_PTR>(id)), g_hInst, nullptr);
                SetUIFont(*target);
            }
            ctx->editHex = CreateWindowExW(WS_EX_CLIENTEDGE, L"EDIT", L"",
                                           WS_CHILD | WS_VISIBLE | WS_TABSTOP | ES_AUTOHSCROLL,
                                           pad, infoY, ScaleY(hWnd, 128), rowH, hWnd,
                                           reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_EDITOR_HEX)), g_hInst, nullptr);
            ctx->btnEyedropper = CreateWindowExW(0, L"BUTTON", localization::Text(L"settings.palette.eyedropper").c_str(),
                                                 WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_PUSHBUTTON,
                                                 pad, infoY, ScaleY(hWnd, 156), rowH, hWnd,
                                                 reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_EDITOR_EYEDROPPER)),
                                                 g_hInst, nullptr);
            SetUIFont(ctx->editHex);
            SetUIFont(ctx->btnEyedropper);
            SetUIFont(ctx->selectedInfo);
            ctx->stockRoot = std::filesystem::path(g_workspaceRoot);
            (void)palette_active::Load(ctx->stockRoot, ctx->active);
            if (ctx->active.ready && ctx->active.exists)
                std::copy(ctx->active.colors.begin(), ctx->active.colors.end(), std::begin(ctx->colors));
            std::copy(std::begin(ctx->colors), std::end(ctx->colors), std::begin(ctx->committedColors));
            ctx->hueLabel = CreateWindowExW(0, L"STATIC", localization::Text(L"settings.palette.gradient.hue").c_str(),
                WS_CHILD | WS_VISIBLE, 0, 0, 100, rowH, hWnd, reinterpret_cast<HMENU>(IDC_PALETTE_HUE_LABEL), g_hInst, nullptr);
            ctx->svLabel = CreateWindowExW(0, L"STATIC", localization::Text(L"settings.palette.gradient.sv").c_str(),
                WS_CHILD | WS_VISIBLE, 0, 0, 100, rowH, hWnd, reinterpret_cast<HMENU>(IDC_PALETTE_SV_LABEL), g_hInst, nullptr);
            ctx->hue = ui::color_gradient::Create(hWnd, IDC_PALETTE_HUE, localization::Text(L"settings.palette.gradient.hue").c_str(), ctx->hueState);
            ctx->sv = ui::color_gradient::Create(hWnd, IDC_PALETTE_SV, localization::Text(L"settings.palette.gradient.sv").c_str(), ctx->svState);
            if (!ctx->hue || !ctx->sv) return -1;
            ctx->saveStatus = CreateWindowExW(0, L"STATIC", L"", WS_CHILD | WS_VISIBLE,
                0, 0, 100, rowH * 3, hWnd, reinterpret_cast<HMENU>(IDC_PALETTE_SAVE_STATUS), g_hInst, nullptr);
            ctx->useColor = CreateWindowExW(0, L"BUTTON", localization::Text(L"settings.palette.use_color").c_str(),
                WS_CHILD | WS_TABSTOP | BS_PUSHBUTTON, 0, 0, 100, rowH, hWnd, reinterpret_cast<HMENU>(IDC_PALETTE_USE_COLOR), g_hInst, nullptr);
            ctx->retry = CreateWindowExW(0, L"BUTTON", localization::Text(L"settings.palette.auto.retry").c_str(),
                WS_CHILD | WS_TABSTOP | BS_PUSHBUTTON, 0, 0, 100, rowH, hWnd, reinterpret_cast<HMENU>(IDC_PALETTE_RETRY), g_hInst, nullptr);
            ctx->reloadActive = CreateWindowExW(0, L"BUTTON", localization::Text(L"settings.palette.auto.reload").c_str(),
                WS_CHILD | WS_TABSTOP | BS_PUSHBUTTON, 0, 0, 100, rowH, hWnd, reinterpret_cast<HMENU>(IDC_PALETTE_RELOAD_ACTIVE), g_hInst, nullptr);
            for (HWND control : {ctx->hueLabel, ctx->svLabel, ctx->saveStatus, ctx->useColor, ctx->retry, ctx->reloadActive}) SetUIFont(control);
            ShowWindow(ctx->useColor, ctx->colorPickerPurpose ? SW_SHOW : SW_HIDE);
            ShowWindow(ctx->retry, ctx->colorPickerPurpose ? SW_HIDE : SW_SHOW);
            ShowWindow(ctx->reloadActive, ctx->colorPickerPurpose ? SW_HIDE : SW_SHOW);
            PaletteSaveStatus(ctx, ctx->colorPickerPurpose ? L"settings.palette.select_hint" : !ctx->active.ready
                ? L"settings.palette.auto.unavailable" : ctx->active.exists ? L"settings.palette.auto.saved" : L"settings.palette.auto.defaults");
            ctx->setsTitle = CreateWindowExW(0, L"STATIC", localization::Text(L"settings.palette.sets.title").c_str(),
                WS_CHILD | WS_VISIBLE, 0, 0, 100, rowH, hWnd,
                reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_SETS_TITLE)), g_hInst, nullptr);
            ctx->setsHint = CreateWindowExW(0, L"STATIC", L"", WS_CHILD | WS_VISIBLE | SS_LEFT,
                0, 0, 100, rowH * 2, hWnd, reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_SETS_HINT)), g_hInst, nullptr);
            ctx->setsList = CreateWindowExW(0, L"COMBOBOX", L"", WS_CHILD | WS_VISIBLE | WS_TABSTOP | CBS_DROPDOWNLIST | WS_VSCROLL,
                0, 0, 100, rowH * 8, hWnd, reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_SETS_LIST)), g_hInst, nullptr);
            ctx->setsPreview = CreateWindowExW(0, L"STATIC", L"", WS_CHILD | WS_VISIBLE | SS_OWNERDRAW,
                0, 0, 100, rowH, hWnd, reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_SETS_PREVIEW)), g_hInst, nullptr);
            const std::array<std::pair<int, const wchar_t*>, 4> setActions{{
                {IDC_PALETTE_SETS_APPLY, L"settings.palette.sets.apply"},
                {IDC_PALETTE_SETS_SAVE, L"settings.palette.sets.save"},
                {IDC_PALETTE_SETS_CLEAR, L"settings.palette.sets.clear"},
                {IDC_PALETTE_SETS_RELOAD, L"settings.palette.sets.reload"},
            }};
            for (size_t i = 0; i < setActions.size(); ++i) {
                ctx->setsButtons[i] = CreateWindowExW(0, L"BUTTON", localization::Text(setActions[i].second).c_str(),
                    WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_PUSHBUTTON | BS_NOTIFY, 0, 0, 100, rowH,
                    hWnd, reinterpret_cast<HMENU>(static_cast<INT_PTR>(setActions[i].first)), g_hInst, nullptr);
                SetUIFont(ctx->setsButtons[i]);
            }
            SetSettingsSectionFont(ctx->setsTitle);
            SetUIFont(ctx->setsHint);
            SetUIFont(ctx->setsList);
            ui::GuardComboAgainstAccidentalChange(ctx->setsList, hWnd);
            ReloadPaletteSets(hWnd, ctx, false);
            ctx->stockTitle = CreateWindowExW(0, L"STATIC", L"", WS_CHILD | WS_VISIBLE,
                0, 0, 100, rowH, hWnd, reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_STOCK_TITLE)), g_hInst, nullptr);
            ctx->stockHint = CreateWindowExW(0, L"STATIC", L"", WS_CHILD | WS_VISIBLE | SS_LEFT,
                0, 0, 100, rowH * 2, hWnd, reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_STOCK_HINT)), g_hInst, nullptr);
            ctx->stockList = CreateWindowExW(WS_EX_CLIENTEDGE, L"LISTBOX", L"",
                WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_VSCROLL | LBS_NOTIFY | LBS_HASSTRINGS |
                    LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT,
                0, 0, 100, 100, hWnd, reinterpret_cast<HMENU>(static_cast<INT_PTR>(IDC_PALETTE_STOCK_LIST)), g_hInst, nullptr);
            const std::array<std::pair<int, const wchar_t*>, 4> stockActions{{
                {IDC_PALETTE_STOCK_ADD, L"settings.palette.stock.add"},
                {IDC_PALETTE_STOCK_USE, L"settings.palette.stock.use"},
                {IDC_PALETTE_STOCK_REMOVE, L"settings.palette.stock.remove"},
                {IDC_PALETTE_STOCK_RELOAD, L"settings.palette.stock.reload"},
            }};
            for (size_t i = 0; i < stockActions.size(); ++i) {
                ctx->stockButtons[i] = CreateWindowExW(0, L"BUTTON", localization::Text(stockActions[i].second).c_str(),
                    WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_PUSHBUTTON | BS_NOTIFY, 0, 0, 100, rowH,
                    hWnd, reinterpret_cast<HMENU>(static_cast<INT_PTR>(stockActions[i].first)), g_hInst, nullptr);
                SetUIFont(ctx->stockButtons[i]);
            }
            SetSettingsSectionFont(ctx->stockTitle);
            SetUIFont(ctx->stockHint);
            SetUIFont(ctx->stockList);
            SendMessageW(ctx->stockList, LB_SETITEMHEIGHT, 0, rowH);
            ReloadPaletteStock(hWnd, ctx, false);
            UpdatePaletteSelectedInfo(ctx);
            SyncPaletteSettingsEditor(hWnd, ctx, ctx->colors[ctx->selectedSlot]);

            ApplyThemeToDialog(hWnd);
            LayoutPaletteSettingsPage(hWnd, ctx);
            return 0;
        }
        case WM_THEMECHANGED:
            ApplyThemeToDialog(hWnd);
            return 0;
        case WM_ERASEBKGND: {
            HDC hdc = reinterpret_cast<HDC>(wParam);
            RECT rc{};
            GetClientRect(hWnd, &rc);
            HBRUSH bg = g_hThemeWindowBrush ? g_hThemeWindowBrush : reinterpret_cast<HBRUSH>(COLOR_WINDOW + 1);
            FillRect(hdc, &rc, bg);
            return 1;
        }
        case WM_CTLCOLORSTATIC:
        case WM_CTLCOLOREDIT:
        case WM_CTLCOLORLISTBOX:
        case WM_CTLCOLORBTN: {
            HDC hdc = reinterpret_cast<HDC>(wParam);
            HWND ctl = reinterpret_cast<HWND>(lParam);
            return ThemeCtlColorPanel(ctl, hdc);
        }
        case WM_DRAWITEM: {
            auto* dis = reinterpret_cast<DRAWITEMSTRUCT*>(lParam);
            if (!ctx || !dis) break;
            if (dis->CtlID == IDC_PALETTE_SETS_PREVIEW) {
                const auto* colors = SelectedPaletteSet(ctx);
                HGDIOBJ oldFont = SelectObject(dis->hDC, g_hUIFont);
                HBRUSH bg = CreateSolidBrush(g_theme.panelBg);
                FillRect(dis->hDC, &dis->rcItem, bg);
                DeleteObject(bg);
                if (colors) {
                    const int width = dis->rcItem.right - dis->rcItem.left;
                    for (size_t i = 0; i < colors->size(); ++i) {
                        DRAWITEMSTRUCT swatch = *dis;
                        swatch.CtlID = IDC_PALETTE_SLOT_BASE + static_cast<UINT>(i);
                        swatch.itemState = 0;
                        swatch.rcItem.left = dis->rcItem.left + MulDiv(width, static_cast<int>(i), IDC_PALETTE_SLOT_COUNT);
                        swatch.rcItem.right = dis->rcItem.left + MulDiv(width, static_cast<int>(i + 1), IDC_PALETTE_SLOT_COUNT) - ScaleY(hWnd, 2);
                        DrawPaletteSlotButton(&swatch, (*colors)[i], false, false);
                    }
                } else {
                    SetBkMode(dis->hDC, TRANSPARENT);
                    SetTextColor(dis->hDC, g_theme.panelText);
                    const auto text = localization::Text(ctx->sets.ready
                        ? L"settings.palette.sets.empty" : L"settings.palette.sets.unavailable");
                    RECT bounds = dis->rcItem;
                    DrawTextW(dis->hDC, text.c_str(), -1, &bounds, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
                }
                SelectObject(dis->hDC, oldFont);
                return TRUE;
            }
            if (dis->CtlID == IDC_PALETTE_STOCK_LIST) {
                const bool selected = (dis->itemState & ODS_SELECTED) != 0;
                HBRUSH bg = CreateSolidBrush(selected ? g_theme.selectionBg : g_theme.panelBg);
                FillRect(dis->hDC, &dis->rcItem, bg);
                DeleteObject(bg);
                if (dis->itemID != static_cast<UINT>(-1)) {
                    RECT swatch = dis->rcItem;
                    swatch.left += ScaleY(hWnd, 8);
                    swatch.right = swatch.left + ScaleY(hWnd, 34);
                    swatch.top += ScaleY(hWnd, 5);
                    swatch.bottom -= ScaleY(hWnd, 5);
                    HBRUSH color = CreateSolidBrush(static_cast<COLORREF>(dis->itemData));
                    FillRect(dis->hDC, &swatch, color);
                    DeleteObject(color);
                    HBRUSH border = CreateSolidBrush(g_theme.buttonBorder);
                    FrameRect(dis->hDC, &swatch, border);
                    DeleteObject(border);
                    RECT textRc = dis->rcItem;
                    textRc.left = swatch.right + ScaleY(hWnd, 12);
                    SetBkMode(dis->hDC, TRANSPARENT);
                    SetTextColor(dis->hDC, selected ? g_theme.selectionText : g_theme.panelText);
                    HGDIOBJ oldFont = SelectObject(dis->hDC, g_hUIFont);
                    const auto hex = PaletteHexColorW(static_cast<COLORREF>(dis->itemData));
                    DrawTextW(dis->hDC, hex.c_str(), -1, &textRc, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
                    SelectObject(dis->hDC, oldFont);
                }
                if (dis->itemState & ODS_FOCUS) DrawFocusRect(dis->hDC, &dis->rcItem);
                return TRUE;
            }
            if (dis->CtlID == IDC_PALETTE_SELECTED_PREVIEW) {
                const int idx = std::clamp(ctx->selectedSlot, 0, IDC_PALETTE_SLOT_COUNT - 1);
                HBRUSH fill = CreateSolidBrush(ctx->colors[idx]);
                FillRect(dis->hDC, &dis->rcItem, fill);
                DeleteObject(fill);
                HBRUSH border = CreateSolidBrush(g_theme.buttonBorder);
                FrameRect(dis->hDC, &dis->rcItem, border);
                DeleteObject(border);
                return TRUE;
            }
            if (!IsPaletteSlotId(static_cast<int>(dis->CtlID))) {
                if (DrawThemeButton(dis)) return TRUE;
                break;
            }
            int idx = static_cast<int>(dis->CtlID) - IDC_PALETTE_SLOT_BASE;
            if (idx < 0 || idx >= IDC_PALETTE_SLOT_COUNT) break;
            const bool isTargetSlot = (idx == ctx->selectedSlot);
            const bool isChangedSlot = (idx == ctx->changedSlot);
            DrawPaletteSlotButton(dis, ctx->colors[idx], isTargetSlot, isChangedSlot);
            return TRUE;
        }
        case WM_SIZE:
            LayoutPaletteSettingsPage(hWnd, ctx);
            return 0;
        case WM_MEASUREITEM: {
            auto* measure = reinterpret_cast<MEASUREITEMSTRUCT*>(lParam);
            if (measure && measure->CtlID == IDC_PALETTE_STOCK_LIST) {
                measure->itemHeight = static_cast<UINT>(std::max(ScaleY(hWnd, 30),
                    FontLineHeightPx(hWnd, g_hUIFont) + ScaleY(hWnd, 10)));
                return TRUE;
            }
            break;
        }
        case WM_VSCROLL: {
            if (!ctx) break;
            SCROLLINFO info{sizeof(info), SIF_ALL};
            GetScrollInfo(hWnd, SB_VERT, &info);
            int position = ctx->scrollY;
            switch (LOWORD(wParam)) {
            case SB_LINEUP: position -= ScaleY(hWnd, 30); break;
            case SB_LINEDOWN: position += ScaleY(hWnd, 30); break;
            case SB_PAGEUP: position -= static_cast<int>(info.nPage); break;
            case SB_PAGEDOWN: position += static_cast<int>(info.nPage); break;
            case SB_THUMBTRACK: case SB_THUMBPOSITION: position = info.nTrackPos; break;
            case SB_TOP: position = 0; break;
            case SB_BOTTOM: position = info.nMax; break;
            default: break;
            }
            ScrollPaletteSettingsPage(hWnd, ctx, position);
            return 0;
        }
        case WM_MOUSEWHEEL:
            if (ctx) ScrollPaletteSettingsPage(hWnd, ctx,
                ctx->scrollY - MulDiv(GET_WHEEL_DELTA_WPARAM(wParam), ScaleY(hWnd, 90), WHEEL_DELTA));
            return 0;
        case WM_COMMAND: {
            int id = LOWORD(wParam);
            int code = HIWORD(wParam);
            if (!ctx) break;
            if (id == IDC_PALETTE_HUE || id == IDC_PALETTE_SV) {
                if (code == ui::color_gradient::kBegin) {
                    if (!ValidatePaletteSettingsEditor(hWnd, ctx)) return FALSE;
                    if (!FlushPaletteAutoSave(hWnd, ctx)) return FALSE;
                    ctx->gradientInitialColor = ctx->colors[ctx->selectedSlot];
                    return TRUE;
                }
                if (code == ui::color_gradient::kChanged || code == ui::color_gradient::kCancel) {
                    SetPaletteSettingsColor(hWnd, ctx, code == ui::color_gradient::kCancel
                        ? ctx->gradientInitialColor : palette_color::ToRgb(ctx->hsv), true, reinterpret_cast<HWND>(lParam));
                    return 0;
                }
                if (code == ui::color_gradient::kEnd) { (void)FlushPaletteAutoSave(hWnd, ctx); return 0; }
            }
            if (id == IDC_PALETTE_USE_COLOR && code == BN_CLICKED && ctx->colorPickerPurpose) {
                SendMessageW(GetParent(hWnd), WM_COMMAND, IDOK, 0);
                return 0;
            }
            if (id == IDC_PALETTE_RETRY && code == BN_CLICKED) { (void)FlushPaletteAutoSave(hWnd, ctx); return 0; }
            if (id == IDC_PALETTE_RELOAD_ACTIVE && code == BN_CLICKED) {
                if ((!ReadPaletteEditorColor(hWnd, nullptr) ||
                     !std::equal(std::begin(ctx->colors), std::end(ctx->colors), std::begin(ctx->committedColors))) &&
                    !ConfirmPaletteSetChange(hWnd, L"settings.palette.auto.reload_confirm", L"settings.palette.auto.reload")) return 0;
                palette_active::Snapshot next;
                if (ctx->stockRoot != std::filesystem::path(g_workspaceRoot) || !palette_active::Load(ctx->stockRoot, next)) {
                    PaletteSaveStatus(ctx, L"settings.palette.auto.unavailable"); return 0;
                }
                KillTimer(hWnd, kPaletteAutoSaveTimer);
                ctx->active = std::move(next);
                LoadUserPaletteColorsForSettings(ctx->colors, std::size(ctx->colors));
                if (ctx->active.exists) std::copy(ctx->active.colors.begin(), ctx->active.colors.end(), std::begin(ctx->colors));
                std::copy(std::begin(ctx->colors), std::end(ctx->colors), std::begin(ctx->committedColors));
                ctx->runtimePending = true;
                SyncPaletteSettingsEditor(hWnd, ctx, ctx->colors[ctx->selectedSlot]);
                UpdatePaletteSelectedInfo(ctx);
                InvalidatePaletteSlots(hWnd);
                (void)FlushPaletteAutoSave(hWnd, ctx);
                return 0;
            }
            if (code == EN_SETFOCUS || code == BN_SETFOCUS || code == LBN_SETFOCUS || code == CBN_SETFOCUS) {
                const HWND control = reinterpret_cast<HWND>(lParam);
                if (control && GetParent(control) == hWnd) {
                    RECT bounds{}, client{};
                    GetWindowRect(control, &bounds);
                    MapWindowPoints(nullptr, hWnd, reinterpret_cast<POINT*>(&bounds), 2);
                    GetClientRect(hWnd, &client);
                    if (bounds.top < 0) ScrollPaletteSettingsPage(hWnd, ctx, ctx->scrollY + bounds.top);
                    else if (bounds.bottom > client.bottom) ScrollPaletteSettingsPage(hWnd, ctx,
                        ctx->scrollY + bounds.bottom - client.bottom);
                }
            }
            if (id == IDC_PALETTE_SETS_LIST && code == CBN_SELCHANGE) {
                UpdatePaletteSetControls(ctx);
                return 0; // Selection is preview only; never silently apply.
            }
            if (id >= IDC_PALETTE_SETS_APPLY && id <= IDC_PALETTE_SETS_RELOAD && code == BN_CLICKED) {
                HandlePaletteSetCommand(hWnd, ctx, id);
                return 0;
            }
            if (id == IDC_PALETTE_STOCK_LIST && code == LBN_DBLCLK) {
                HandlePaletteStockCommand(hWnd, ctx, IDC_PALETTE_STOCK_USE);
                return 0;
            }
            if (id >= IDC_PALETTE_STOCK_ADD && id <= IDC_PALETTE_STOCK_RELOAD && code == BN_CLICKED) {
                HandlePaletteStockCommand(hWnd, ctx, id);
                return 0;
            }
            if (id == IDC_PALETTE_EDITOR_EYEDROPPER && code == BN_CLICKED) {
                if (!ValidatePaletteSettingsEditor(hWnd, ctx) || !FlushPaletteAutoSave(hWnd, ctx)) return 0;
                ctx->eyedropperInitialColor = ctx->colors[std::clamp(ctx->selectedSlot, 0, IDC_PALETTE_SLOT_COUNT - 1)];
                ctx->eyedropperActive = true;
                SetCapture(hWnd);
                return 0;
            }
            if (code == EN_CHANGE && (id == IDC_PALETTE_EDITOR_RED || id == IDC_PALETTE_EDITOR_GREEN ||
                                      id == IDC_PALETTE_EDITOR_BLUE)) {
                UpdatePaletteSettingsFromRgb(hWnd, ctx, reinterpret_cast<HWND>(lParam));
                SchedulePaletteAutoSave(hWnd, ctx);
                return 0;
            }
            if (code == EN_CHANGE && id == IDC_PALETTE_EDITOR_HEX) {
                UpdatePaletteSettingsFromHex(hWnd, ctx);
                SchedulePaletteAutoSave(hWnd, ctx);
                return 0;
            }
            if (id == IDCANCEL || id == 0) {
                if (ctx->embedded) return 0;
                DestroyWindow(hWnd);
                return 0;
            }
            if (IsPaletteSlotId(id) && code == BN_CLICKED) {
                if (!ValidatePaletteSettingsEditor(hWnd, ctx)) return 0;
                if (!FlushPaletteAutoSave(hWnd, ctx)) return 0;
                int idx = id - IDC_PALETTE_SLOT_BASE;
                ctx->selectedSlot = idx;
                ctx->changedSlot = -1;
                SyncPaletteSettingsEditor(hWnd, ctx, ctx->colors[idx]);
                InvalidatePaletteSlots(hWnd);
                UpdatePaletteSelectedInfo(ctx);
                return 0;
            }
            break;
        }
        case WM_LBUTTONUP:
            if (ctx && ctx->eyedropperActive) {
                COLORREF sampled{};
                if (SamplePaletteColorAtCursor(&sampled)) SetPaletteSettingsColor(hWnd, ctx, sampled, true);
                ctx->eyedropperActive = false;
                if (GetCapture() == hWnd) ReleaseCapture();
                (void)FlushPaletteAutoSave(hWnd, ctx);
                return 0;
            }
            break;
        case WM_CAPTURECHANGED:
            if (ctx && ctx->eyedropperActive) ctx->eyedropperActive = false;
            break;
        case WM_KEYDOWN:
            if (ctx && ctx->eyedropperActive && wParam == VK_ESCAPE) {
                ctx->eyedropperActive = false;
                SetPaletteSettingsColor(hWnd, ctx, ctx->eyedropperInitialColor, false);
                if (GetCapture() == hWnd) ReleaseCapture();
                return 0;
            }
            break;
        case WM_CLOSE:
            if (ctx && ctx->embedded) return 0;
            DestroyWindow(hWnd);
            return 0;
        case WM_TIMER:
            if (wParam == kPaletteAutoSaveTimer && ctx) { (void)FlushPaletteAutoSave(hWnd, ctx); return 0; }
            break;
        case WM_DESTROY:
            KillTimer(hWnd, kPaletteAutoSaveTimer);
            if (ctx && !ctx->embedded) RestoreOwnerAfterModal(ctx->owner);
            if (ctx) ctx->done = true;
            return 0;
        default:
            break;
        }
        } catch (...) {
            KillTimer(hWnd, kPaletteAutoSaveTimer);
            if (ctx) { ctx->syncingFields = false; ctx->layingOut = false; }
            try { PaletteSaveStatus(ctx, L"settings.palette.auto.failed"); } catch (...) {}
            return msg == WM_CREATE ? -1 : 0;
        }
        return DefWindowProcW(hWnd, msg, wParam, lParam);
    };
    wc.hInstance = g_hInst;
    wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
    wc.hbrBackground = g_hThemeWindowBrush ? g_hThemeWindowBrush
                                           : reinterpret_cast<HBRUSH>(COLOR_WINDOW + 1);
    wc.lpszClassName = L"PaletteSettingsDlgClass";
    RegisterClassW(&wc);
    registered = true;
}
} // namespace

void ShowPaletteSettingsDialog(HWND owner) {
    ShowUnifiedSettingsDialog(owner, kSettingsNavPalette);
}
