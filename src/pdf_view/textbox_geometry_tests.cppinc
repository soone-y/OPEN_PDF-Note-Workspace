// Hit priority is shared by hover, cursor shape, and the actual click path.
static bool VerifyTextBoxReeditHoverHitPriority() {
    auto saved = std::move(g_annots);
    struct RestoreAnnotations {
        std::vector<Annotation>& saved;
        ~RestoreAnnotations() { g_annots = std::move(saved); }
    } restore{saved};
    Annotation box;
    box.type = Annotation::Type::TextBox;
    box.projectedCoordinates = true;
    box.pageIndex = 0;
    box.fontPt = 40.0;
    box.x1 = 10; box.x2 = 110; box.y1 = 100; box.y2 = 50;
    g_annots = {box};
    // Full width stays editable, but the vertical 10% inset creates new boxes.
    if (FindTextReeditAnnotation(0, 10, 75) != 0 || FindTextReeditAnnotation(0, 110, 75) != 0 ||
        FindTextReeditAnnotation(0, 60, 98) != -1 || FindTextReeditAnnotation(0, 60, 52) != -1 ||
        FindTextReeditAnnotation(0, 60, 95) != 0 || FindTextReeditAnnotation(0, 60, 55) != 0 ||
        FindTextReeditAnnotation(1, 60, 75) != -1) return false;
    auto math = box; math.type = Annotation::Type::MathBox;
    g_annots.push_back(math);
    if (FindTextReeditAnnotation(0, 60, 75) != 1 || FindTextReeditAnnotation(0, 60, 98) != 1) return false;
    g_annots.push_back(box);
    if (FindTextReeditAnnotation(0, 60, 75) != 2) return false;

    // Tall boxes must not lose multiple lines at either edge. Small boxes
    // retain the original 10%; font changes must invalidate the metric cache.
    for (const auto* face : {L"Arial", L"Yu Gothic"}) {
        double previousPt = 0.0, previousRow = 0.0;
        for (double pt : {8.0, 14.0, 32.0, 14.0}) {
            box.fontName = face;
            box.fontPt = pt;
            const double row = TextBoxReeditLineHeightPt(box);
            if (!std::isfinite(row) || row <= 0.0) return false;
            if ((pt > previousPt && row <= previousRow) ||
                (pt < previousPt && row >= previousRow)) return false;
            previousPt = pt;
            previousRow = row;
            box.y1 = 1000; box.y2 = 0;
            g_annots = {box};
            if (FindTextReeditAnnotation(0, 60, row * 0.309) != -1 ||
                FindTextReeditAnnotation(0, 60, row * 0.311) != 0 ||
                FindTextReeditAnnotation(0, 60, 1000 - row * 0.309) != -1 ||
                FindTextReeditAnnotation(0, 60, 1000 - row * 0.311) != 0 ||
                FindTextReeditAnnotation(0, 10, 500) != 0 ||
                FindTextReeditAnnotation(0, 110, 500) != 0 ||
                FindTextReeditAnnotation(0, 9, 500) != -1) return false;
            box.y1 = row;
            g_annots = {box};
            if (FindTextReeditAnnotation(0, 60, row * 0.09) != -1 ||
                FindTextReeditAnnotation(0, 60, row * 0.11) != 0 ||
                FindTextReeditAnnotation(0, 60, row * 0.91) != -1 ||
                FindTextReeditAnnotation(0, 60, row * 0.89) != 0) return false;
        }
    }
    return true;
}

// Automation only. Measure/reflow and draw the real textbox into owned DIBs;
// a larger reference canvas exposes ink that a too-small frame would clip.
static bool RunTextBoxGeometryProbe(std::wstring* trace, std::wstring* outError) {
    struct Canvas {
        HDC dc = nullptr;
        HBITMAP bitmap = nullptr;
        HGDIOBJ previous = nullptr;
        DWORD* pixels = nullptr;
        static constexpr int Width() { return 1024; }
        static constexpr int Height() { return 384; }
        Canvas() {
            dc = CreateCompatibleDC(nullptr);
            BITMAPINFO info{};
            info.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
            info.bmiHeader.biWidth = Width(); info.bmiHeader.biHeight = -Height();
            info.bmiHeader.biPlanes = 1; info.bmiHeader.biBitCount = 32;
            info.bmiHeader.biCompression = BI_RGB;
            bitmap = CreateDIBSection(dc, &info, DIB_RGB_COLORS,
                reinterpret_cast<void**>(&pixels), nullptr, 0);
            if (dc && bitmap) previous = SelectObject(dc, bitmap);
        }
        ~Canvas() {
            if (previous) SelectObject(dc, previous);
            if (bitmap) DeleteObject(bitmap);
            if (dc) DeleteDC(dc);
        }
        void Clear() { std::fill_n(pixels, Width() * Height(), 0xFFFFFFFF); }
    } fitted, reference, scratch;
    if (!fitted.pixels || !reference.pixels || !scratch.dc) {
        if (outError) *outError = L"Textbox geometry DIB allocation failed.";
        return false;
    }
    const double originalScale = g_pdf.scale;
    const bool originalWrap = g_textBoxAutoWrap, originalBackground = g_textBoxReadableBackground;
    const auto restore = [&]() {
        g_pdf.scale = originalScale;
        g_textBoxAutoWrap = originalWrap;
        g_textBoxReadableBackground = originalBackground;
        ClearTextBoxRasterCache();
    };
    struct Restore { const decltype(restore)& action; ~Restore() { action(); } } guard{restore};
    g_textBoxAutoWrap = false;
    g_textBoxReadableBackground = false;
    ClearTextBoxRasterCache();
    int cases = 0;
    for (const auto* font : {L"Arial", L"Segoe UI", L"Yu Gothic", L"Meiryo"})
        for (double pt : {10.0, 14.0, 19.25, 10.0626})
            for (double zoom : {0.5, 0.65, 0.8, 1.0})
                for (const auto* text : {L"iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii", L"WWWWWWWWWWWWWWWWWWWW",
                    L"日本語のテキスト注釈です。\n文字列の末尾を確認します。"}) {
                    g_pdf.scale = zoom;
                    Annotation annotation;
                    annotation.type = Annotation::Type::TextBox;
                    annotation.projectedCoordinates = true;
                    annotation.pageIndex = 0;
                    annotation.x1 = 36; annotation.x2 = 100;
                    annotation.y1 = 1000; annotation.y2 = 970;
                    annotation.fontName = font; annotation.fontPt = pt;
                    annotation.color = RGB(0, 0, 0); annotation.text = text;
                    ReflowMovedTextBox(annotation);
                    // 10.0626pt lies just above an 81px rounding boundary at
                    // 576dpi. Rounding to 0.01pt first incorrectly gives 80px.
                    if (pt == 10.0626 && TextBoxFontHeightPx(pt) != 81) {
                        if (outError) *outError = L"Textbox raster rounded the annotation size twice.";
                        return false;
                    }
                    const auto extent = annotation_rotation::ContentExtent(annotation);
                    const double factor = kDpi * zoom / 72.0;
                    RECT bounds{0, 0, static_cast<LONG>(std::lround(extent.width * factor)),
                        static_cast<LONG>(std::lround(extent.height * factor))};
                    auto wider = annotation;
                    wider.x2 += 36; wider.y2 -= 36;
                    RECT referenceBounds{0, 0, static_cast<LONG>(std::lround((extent.width + 36) * factor)),
                        static_cast<LONG>(std::lround((extent.height + 36) * factor))};
                    fitted.Clear(); reference.Clear();
                    DrawTextBoxStable(fitted.dc, scratch.dc, bounds, annotation);
                    DrawTextBoxStable(reference.dc, scratch.dc, referenceBounds, wider);
                    GdiFlush();
                    int ink = 0, overflow = 0;
                    for (int y = 0; y < Canvas::Height(); ++y)
                        for (int x = 0; x < Canvas::Width(); ++x) {
                            const int offset = y * Canvas::Width() + x;
                            if ((fitted.pixels[offset] & 0xFFFFFF) != 0xFFFFFF) ++ink;
                            if ((x >= bounds.right || y >= bounds.bottom) &&
                                (reference.pixels[offset] & 0xFFFFFF) != 0xFFFFFF) ++overflow;
                        }
                    const bool valid = ink > 0 && overflow == 0 &&
                        bounds.right > 0 && referenceBounds.right < Canvas::Width() &&
                        referenceBounds.bottom < Canvas::Height();
                    if (!valid) {
                        if (trace) *trace += L"pdf_textbox:geometry_failure font=" + std::wstring(font) +
                            L" pt=" + std::to_wstring(pt) + L" zoom=" + std::to_wstring(zoom) +
                            L" overflow=" + std::to_wstring(overflow) + L" ink=" + std::to_wstring(ink) + L"\n";
                        if (outError) *outError = L"Textbox measurement and rendered ink disagree.";
                        return false;
                    }
                    ++cases;
                }
    if (trace) *trace += L"pdf_textbox:geometry_ok cases=" + std::to_wstring(cases) + L"\n";
    return cases == 192;
}
