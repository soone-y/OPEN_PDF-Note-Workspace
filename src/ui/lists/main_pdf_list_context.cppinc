// file: main/main_pdf_list_context.cppinc

enum class EmptyClroDeleteResult {
    Deleted,
    NotEligible,
    Failed,
};

static bool IsEmptyClroNoteEligibleForDeletion(const std::filesystem::path& path) {
    if (path.empty()) return false;

    std::wstring extension = path.extension().wstring();
    std::transform(extension.begin(), extension.end(), extension.begin(),
                   [](wchar_t ch) { return static_cast<wchar_t>(towlower(ch)); });
    if (extension != L".clro") return false;

    const DWORD attributes = GetFileAttributesW(path.c_str());
    if (attributes == INVALID_FILE_ATTRIBUTES ||
        (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0 ||
        (attributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0) {
        return false;
    }

    std::error_code ec;
    return std::filesystem::is_regular_file(path, ec) && !ec &&
           std::filesystem::file_size(path, ec) == 0 && !ec &&
           !file_output::HasPendingOrStagedDiffsUnderPath(path);
}

static EmptyClroDeleteResult DeleteEmptyClroNoteFile(const std::filesystem::path& path,
                                                     DWORD* outError) {
    if (outError) *outError = ERROR_SUCCESS;
    if (!IsEmptyClroNoteEligibleForDeletion(path)) {
        return EmptyClroDeleteResult::NotEligible;
    }

    HANDLE file = CreateFileW(path.c_str(), GENERIC_READ | GENERIC_WRITE | DELETE, FILE_SHARE_READ,
                              nullptr, OPEN_EXISTING,
                              FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
    if (file == INVALID_HANDLE_VALUE) {
        if (outError) *outError = GetLastError();
        return EmptyClroDeleteResult::Failed;
    }

    const auto closeFile = [&]() { CloseHandle(file); };
    OVERLAPPED lock{};
    if (!LockFileEx(file, LOCKFILE_EXCLUSIVE_LOCK | LOCKFILE_FAIL_IMMEDIATELY,
                    0, MAXDWORD, MAXDWORD, &lock)) {
        if (outError) *outError = GetLastError();
        closeFile();
        return EmptyClroDeleteResult::Failed;
    }

    FILE_BASIC_INFO basicInfo{};
    FILE_STANDARD_INFO standardInfo{};
    if (!GetFileInformationByHandleEx(file, FileBasicInfo, &basicInfo, sizeof(basicInfo)) ||
        !GetFileInformationByHandleEx(file, FileStandardInfo, &standardInfo, sizeof(standardInfo)) ||
        (basicInfo.FileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0 ||
        (basicInfo.FileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0 ||
        standardInfo.EndOfFile.QuadPart != 0) {
        if (outError) *outError = GetLastError();
        closeFile();
        return EmptyClroDeleteResult::NotEligible;
    }

    FILE_DISPOSITION_INFO disposition{};
    disposition.DeleteFile = TRUE;
    if (!SetFileInformationByHandle(file, FileDispositionInfo, &disposition, sizeof(disposition))) {
        if (outError) *outError = GetLastError();
        closeFile();
        return EmptyClroDeleteResult::Failed;
    }
    closeFile();
    return EmptyClroDeleteResult::Deleted;
}

static std::optional<std::filesystem::path> FileContextSessionPath(
    const std::filesystem::path& filePath) {
    const std::filesystem::path file = CanonicalOrSelf(filePath);
    if (file.empty() || !IsWorkspaceManagedDirectoryTarget(file)) return std::nullopt;

    for (const std::wstring& lectureValue : g_lectures) {
        const std::filesystem::path lecture = CanonicalOrSelf(std::filesystem::path(lectureValue));
        if (lecture.empty() || !IsPathUnderRoot(file, lecture)) continue;

        std::filesystem::path session = file.parent_path();
        const std::wstring container = ToLowerAscii(session.filename().wstring());
        if (container == L"pdf" || container == L"note") session = session.parent_path();
        if (session.empty() ||
            CanonicalOrSelf(session.parent_path()) != lecture ||
            IsDirectFilesSessionPath(session.wstring(), lecture.wstring()) ||
            !IsWorkspaceManagedDirectoryTarget(session)) {
            continue;
        }
        return session;
    }
    return std::nullopt;
}

static bool ActivateFileContextSession(HWND owner, const std::filesystem::path& sessionPath) {
    const std::filesystem::path session = CanonicalOrSelf(sessionPath);
    const std::filesystem::path lecture = CanonicalOrSelf(session.parent_path());
    if (session.empty() || lecture.empty()) return false;

    const int lectureIndex = FindLectureIndexByPath(lecture.wstring());
    if (lectureIndex < 0) return false;
    const bool lectureChanged = SetListboxSelAndNotify(g_hLectureList, lectureIndex);
    if (!lectureChanged &&
        NormalizePathKeyForList(g_currentLecturePath) != NormalizePathKeyForList(lecture.wstring())) {
        NotifyListboxSelChange(g_hLectureList);
    }
    if (NormalizePathKeyForList(g_currentLecturePath) != NormalizePathKeyForList(lecture.wstring())) {
        return false;
    }

    const int sessionIndex = FindSessionIndexByPath(session.wstring());
    if (sessionIndex < 0) return false;
    const bool sessionChanged = SetListboxSelAndNotify(g_hSessionList, sessionIndex);
    if (!sessionChanged &&
        NormalizePathKeyForList(g_currentSessionPath) != NormalizePathKeyForList(session.wstring())) {
        NotifyListboxSelChange(g_hSessionList);
    }
    return NormalizePathKeyForList(g_currentSessionPath) == NormalizePathKeyForList(session.wstring());
}

static bool ShowPdfListContextMenu(HWND list, LPARAM lParam) {
    if (!list || (list != g_hPdfList && list != g_hNoteList)) return false;
    HWND owner = GetParent(list);
    if (!owner) return false;
    const bool isNoteList = (list == g_hNoteList);
    const auto& files = isNoteList ? g_noteFiles : g_pdfFiles;

    const bool keyboardInvocation = GET_X_LPARAM(lParam) == -1 && GET_Y_LPARAM(lParam) == -1;
    const auto target = ui::context_menu::ResolveListBoxContextTarget(
        list, lParam, files.size(), keyboardInvocation,
        ui::context_menu::ListBoxContextOptions{false, -1, true, false, true});
    if (!target) return false;
    const int index = target->index;
    const POINT screenPt = target->screenPoint;

    const auto& file = files[static_cast<size_t>(index)];
    if (file.path.empty()) return false;

    const std::filesystem::path selectedPath(file.path);
    std::filesystem::path hierarchyRoot = g_currentSessionPath.empty()
        ? selectedPath.parent_path()
        : std::filesystem::path(g_currentSessionPath);
    if (hierarchyRoot.empty()) hierarchyRoot = selectedPath.parent_path();
    const std::wstring label = FilenameOrPath(selectedPath);
    const std::wstring hierarchyLabel = FilenameOrPath(hierarchyRoot);
    const bool canShowHierarchy = !hierarchyRoot.empty();
    const bool officeFile = !isNoteList && IsOfficeFileListPath(file.path);
    const bool canRename = isNoteList || (!officeFile && file.isPdf);
    const bool canDeleteEmptyClro = isNoteList && IsEmptyClroNoteEligibleForDeletion(selectedPath);
    const bool isPinnedTemporaryPath = IsPinnedTemporaryFilePath(file.path, isNoteList);
    const bool isTemporaryPath = IsTemporaryFilePathInCurrentList(file.path, isNoteList);
    const bool canCreateSession =
        !g_currentLecturePath.empty() &&
        IsWorkspaceManagedDirectoryTarget(std::filesystem::path(g_currentLecturePath));
    const bool canCreateNote =
        !g_currentSessionPath.empty() &&
        IsWorkspaceManagedDirectoryTarget(std::filesystem::path(g_currentSessionPath)) &&
        !IsDirectFilesSessionPath(g_currentSessionPath, g_currentLecturePath);
    const auto selectedFileSession = FileContextSessionPath(selectedPath);
    const bool canCreateNoteInSelectedFileSession = selectedFileSession.has_value();
    const bool canCloseLecture = !g_currentLecturePath.empty();
    const bool canCloseSession = !g_currentSessionPath.empty();
    const std::wstring openedPath = isNoteList ? g_currentNotePath : CurrentLogicalPdfPath();
    const bool canCloseFile = !openedPath.empty() &&
        NormalizePathKeyForList(file.path) == NormalizePathKeyForList(openedPath);

    ui::context_menu::PopupMenu menu;
    if (!menu) return false;
    constexpr UINT kCmdNewLecture = 1;
    constexpr UINT kCmdNewSession = 2;
    constexpr UINT kCmdNewSelectedNoteClro = 3;
    constexpr UINT kCmdNewSelectedNoteMarkdown = 4;
    constexpr UINT kCmdNewSelectedNoteText = 5;
    constexpr UINT kCmdNewSelectedNoteTex = 6;
    constexpr UINT kCmdNewSelectedNoteCsv = 7;
    constexpr UINT kCmdNewCurrentNoteClro = 8;
    constexpr UINT kCmdNewCurrentNoteMarkdown = 9;
    constexpr UINT kCmdNewCurrentNoteText = 10;
    constexpr UINT kCmdNewCurrentNoteTex = 11;
    constexpr UINT kCmdNewCurrentNoteCsv = 12;
    constexpr UINT kCmdOpenInApp = 13;
    constexpr UINT kCmdOpenReadOnly = 14;
    constexpr UINT kCmdOpenExplorer = 15;
    constexpr UINT kCmdShowPath = 16;
    constexpr UINT kCmdCopyPath = 17;
    constexpr UINT kCmdShowHierarchy = 18;
    constexpr UINT kCmdDeleteEmptyClro = 19;
    constexpr UINT kCmdRename = 20;
    constexpr UINT kCmdConvertImageToPdf = 21;
    constexpr UINT kCmdPinTemporaryPath = 22;
    constexpr UINT kCmdUnpinTemporaryPath = 23;
    constexpr UINT kCmdRemoveTemporaryPath = 24;
    constexpr UINT kCmdCloseLecture = 25;
    constexpr UINT kCmdCloseSession = 26;
    constexpr UINT kCmdCloseFile = 27;
    constexpr UINT kCmdReload = 28;
    AppendMenuW(menu.get(), MF_STRING, kCmdNewLecture,
                IsEnglishUi() ? L"Create lecture..." : L"授業を作成...");
    AppendMenuW(menu.get(),
                canCreateSession ? MF_STRING : (MF_STRING | MF_GRAYED),
                kCmdNewSession,
                IsEnglishUi() ? L"Create session..." : L"回次を作成...");
    HMENU noteMenu = CreatePopupMenu();
    HMENU selectedSessionNoteMenu = CreatePopupMenu();
    HMENU currentSessionNoteMenu = CreatePopupMenu();
    if (noteMenu && selectedSessionNoteMenu && currentSessionNoteMenu) {
        const auto appendExtensions = [](HMENU target, UINT firstCommand) {
            AppendMenuW(target, MF_STRING, firstCommand, L".clro");
            AppendMenuW(target, MF_STRING, firstCommand + 1, L".md");
            AppendMenuW(target, MF_STRING, firstCommand + 2, L".txt");
            AppendMenuW(target, MF_STRING, firstCommand + 3, L".tex");
            AppendMenuW(target, MF_STRING, firstCommand + 4, L".csv");
        };
        appendExtensions(selectedSessionNoteMenu, kCmdNewSelectedNoteClro);
        appendExtensions(currentSessionNoteMenu, kCmdNewCurrentNoteClro);
        AppendMenuW(noteMenu,
                    canCreateNoteInSelectedFileSession ? MF_POPUP : (MF_POPUP | MF_GRAYED),
                    reinterpret_cast<UINT_PTR>(selectedSessionNoteMenu),
                    IsEnglishUi() ? L"In selected file's session" : L"選択ファイルの回次に作成");
        AppendMenuW(noteMenu,
                    canCreateNote ? MF_POPUP : (MF_POPUP | MF_GRAYED),
                    reinterpret_cast<UINT_PTR>(currentSessionNoteMenu),
                    IsEnglishUi() ? L"In current session" : L"現在の回次に作成");
        AppendMenuW(menu.get(), MF_POPUP, reinterpret_cast<UINT_PTR>(noteMenu),
                    IsEnglishUi() ? L"Create note" : L"ノートを作成");
    } else {
        if (selectedSessionNoteMenu) DestroyMenu(selectedSessionNoteMenu);
        if (currentSessionNoteMenu) DestroyMenu(currentSessionNoteMenu);
        if (noteMenu) DestroyMenu(noteMenu);
    }
    AppendMenuW(menu.get(), MF_SEPARATOR, 0, nullptr);
    AppendMenuW(menu.get(), MF_STRING, kCmdReload,
                IsEnglishUi() ? L"Reload" : L"再読み込み");
    AppendMenuW(menu.get(), MF_SEPARATOR, 0, nullptr);
    ui::context_menu::AppendPathContextMenuItems(menu.get(), {
        {kCmdOpenInApp,
         officeFile
             ? (IsEnglishUi() ? L"Convert to PDF" : L"PDFに変換")
             : (IsEnglishUi() ? L"Open in this app" : L"このソフトで開く")},
    });
    ui::context_menu::AppendPathContextMenuItems(menu.get(), {
        {kCmdOpenReadOnly, IsEnglishUi() ? L"Open in read-only viewer" : L"読み取り専用ビューアで開く",
         !isNoteList && file.isPdf},
    });
    const bool imageFile = !isNoteList && IsImageFile(selectedPath);
    if (imageFile) {
        AppendMenuW(menu.get(), MF_STRING, kCmdConvertImageToPdf,
                    IsEnglishUi() ? L"Convert image to PDF..." : L"画像をPDFに変換...");
    }
    AppendMenuW(menu.get(), MF_SEPARATOR, 0, nullptr);
    ui::context_menu::AppendPathContextMenuItems(menu.get(), {
        {kCmdOpenExplorer, IsEnglishUi() ? L"Show in Explorer" : L"エクスプローラーで表示"},
        {kCmdShowHierarchy, IsEnglishUi() ? L"Show directory hierarchy" : L"フォルダ階層を確認", canShowHierarchy},
        {kCmdShowPath, IsEnglishUi() ? L"Show work path" : L"作業パスを表示"},
        {kCmdCopyPath, IsEnglishUi() ? L"Copy path" : L"パスをコピー"},
    });
    AppendMenuW(menu.get(), MF_SEPARATOR, 0, nullptr);
    AppendMenuW(menu.get(),
                MF_STRING,
                isPinnedTemporaryPath ? kCmdUnpinTemporaryPath : kCmdPinTemporaryPath,
                isPinnedTemporaryPath
                    ? (IsEnglishUi() ? L"Remove temporary path" : L"一時パスから外す")
                    : (IsEnglishUi() ? L"Always keep open (temporary path)" : L"常に開ける（一時パスに追加）"));
    AppendMenuW(menu.get(),
                isTemporaryPath ? MF_STRING : (MF_STRING | MF_GRAYED),
                kCmdRemoveTemporaryPath,
                IsEnglishUi() ? L"Remove from temporary list" : L"一時リストから消す");
    AppendMenuW(menu.get(), MF_SEPARATOR, 0, nullptr);
    AppendMenuW(menu.get(), canCloseLecture ? MF_STRING : (MF_STRING | MF_GRAYED),
                kCmdCloseLecture, IsEnglishUi() ? L"Close lecture display" : L"授業の表示を閉じる");
    AppendMenuW(menu.get(), canCloseSession ? MF_STRING : (MF_STRING | MF_GRAYED),
                kCmdCloseSession, IsEnglishUi() ? L"Close session display" : L"回次の表示を閉じる");
    AppendMenuW(menu.get(), canCloseFile ? MF_STRING : (MF_STRING | MF_GRAYED),
                kCmdCloseFile, IsEnglishUi() ? L"Close file display" : L"ファイルの表示を閉じる");
    AppendMenuW(menu.get(), MF_SEPARATOR, 0, nullptr);
    AppendMenuW(menu.get(),
                canRename ? MF_STRING : (MF_STRING | MF_GRAYED),
                kCmdRename,
                IsEnglishUi() ? L"Rename" : L"名前の変更");
    AppendMenuW(menu.get(), MF_SEPARATOR, 0, nullptr);
    AppendMenuW(menu.get(),
                canDeleteEmptyClro ? MF_STRING : (MF_STRING | MF_GRAYED),
                kCmdDeleteEmptyClro,
                IsEnglishUi() ? L"Delete empty .clro file" : L"空の .clro ファイルを削除");
    SetForegroundWindow(owner);
    const UINT cmd = menu.TrackCommand(owner, screenPt,
                                       TPM_RETURNCMD | TPM_RIGHTBUTTON | TPM_NONOTIFY);
    menu.Close();
    if (cmd == kCmdNewLecture) {
        ShowNewLectureDialog(owner);
        RefreshMainMenuBar(owner);
        return true;
    }
    if (cmd == kCmdNewSession && canCreateSession) {
        ShowNewSessionDialog(owner);
        RefreshMainMenuBar(owner);
        return true;
    }
    const wchar_t* noteExtension = nullptr;
    bool createInSelectedFileSession = false;
    switch (cmd) {
    case kCmdNewSelectedNoteClro: noteExtension = L".clro"; createInSelectedFileSession = true; break;
    case kCmdNewSelectedNoteMarkdown: noteExtension = L".md"; createInSelectedFileSession = true; break;
    case kCmdNewSelectedNoteText: noteExtension = L".txt"; createInSelectedFileSession = true; break;
    case kCmdNewSelectedNoteTex: noteExtension = L".tex"; createInSelectedFileSession = true; break;
    case kCmdNewSelectedNoteCsv: noteExtension = L".csv"; createInSelectedFileSession = true; break;
    case kCmdNewCurrentNoteClro: noteExtension = L".clro"; break;
    case kCmdNewCurrentNoteMarkdown: noteExtension = L".md"; break;
    case kCmdNewCurrentNoteText: noteExtension = L".txt"; break;
    case kCmdNewCurrentNoteTex: noteExtension = L".tex"; break;
    case kCmdNewCurrentNoteCsv: noteExtension = L".csv"; break;
    default: break;
    }
    if (noteExtension && (!createInSelectedFileSession || canCreateNoteInSelectedFileSession) &&
        (createInSelectedFileSession || canCreateNote)) {
        if (!SaveNoteIfDirty(owner)) return true;
        if (createInSelectedFileSession &&
            (!selectedFileSession || !ActivateFileContextSession(owner, *selectedFileSession))) {
            return true;
        }
        CreateNewNoteWithExtensionInSession(owner, noteExtension);
        RefreshMainMenuBar(owner);
        return true;
    }
    if (cmd == kCmdOpenInApp) {
        if (officeFile) {
            return ConvertOfficeFileToCurrentSession(owner, selectedPath);
        }
        return isNoteList ? OpenNoteIfDifferent(owner, file.path)
                          : OpenPdfIfDifferent(owner, file.path);
    }
    if (cmd == kCmdOpenReadOnly && !isNoteList && file.isPdf) {
        return LaunchReadOnlyViewerForPdf(owner, file.path);
    }
    if (cmd == kCmdReload) {
        if (!RefreshCurrentSessionFiles()) {
            ShowSoftNotice(owner,
                           IsEnglishUi() ? L"There is no session to reload."
                                         : L"再読み込みできる回次が開かれていません。",
                           SoftNoticeKind::Warning);
            return true;
        }
        SyncLeftPaneSelection();
        RefreshMainWindowUiState(owner);
        ShowSoftNotice(owner, IsEnglishUi() ? L"File list reloaded." : L"ファイル一覧を再読み込みしました。",
                       SoftNoticeKind::Info);
        return true;
    }
    if (cmd == kCmdCloseLecture && canCloseLecture) {
        return CloseLectureDisplayFromContext(owner, g_currentLecturePath);
    }
    if (cmd == kCmdCloseSession && canCloseSession) {
        return CloseSessionDisplayFromContext(owner, g_currentSessionPath);
    }
    if (cmd == kCmdCloseFile && canCloseFile) {
        return CloseFileDisplayFromContext(owner, isNoteList, file.path);
    }
    if (cmd == kCmdConvertImageToPdf && imageFile) {
        std::wstring outputPath;
        if (!file_output::ConvertImageToPdf(owner, file.path, &outputPath)) return false;
        RefreshCurrentSessionFiles();
        return OpenPdfIfDifferent(owner, outputPath);
    }
    if (cmd == kCmdOpenExplorer) {
        return ShowPathInExplorer(owner, file.path);
    }
    if (cmd == kCmdShowPath) {
        ShowSelectedPathDialog(owner, label, file.path);
        return true;
    }
    if (cmd == kCmdCopyPath) {
        return CopyPathToClipboard(owner, file.path);
    }
    if (cmd == kCmdPinTemporaryPath) {
        if (!PinTemporaryFilePath(file.path, isNoteList)) {
            ShowSoftNotice(owner,
                           IsEnglishUi() ? L"This file could not be added as a temporary path."
                                         : L"このファイルを一時パスに追加できませんでした。",
                           SoftNoticeKind::Warning);
        } else {
            RefreshTemporaryFileListDisplay(isNoteList);
            ShowSoftNotice(owner,
                           IsEnglishUi() ? L"Added as a temporary path. It will remain available while changing directories."
                                         : L"一時パスに追加しました。ディレクトリを変えても開いたままにできます。",
                           SoftNoticeKind::Info);
        }
        return true;
    }
    if (cmd == kCmdUnpinTemporaryPath) {
        UnpinTemporaryFilePath(file.path, isNoteList);
        RefreshTemporaryFileListDisplay(isNoteList);
        ShowSoftNotice(owner,
                       IsEnglishUi() ? L"Removed the temporary path."
                                     : L"一時パスから外しました。",
                       SoftNoticeKind::Info);
        return true;
    }
    if (cmd == kCmdRemoveTemporaryPath) {
        if (RemoveTemporaryFilePathFromCurrentList(file.path, isNoteList)) {
            ShowSoftNotice(owner,
                           IsEnglishUi() ? L"Removed from the temporary list."
                                         : L"一時リストから消しました。",
                           SoftNoticeKind::Info);
        }
        return true;
    }
    if (cmd == kCmdShowHierarchy && canShowHierarchy) {
        return ShowDirectoryHierarchyPopup(owner, hierarchyRoot, hierarchyLabel, screenPt);
    }
    if (cmd == kCmdRename && canRename) {
        const bool opened = isNoteList ? OpenNoteIfDifferent(owner, file.path)
                                       : OpenPdfIfDifferent(owner, file.path);
        if (!opened) return false;
        return RenameOrMoveCurrentOperationTarget(owner, /*isPdf=*/!isNoteList,
                                                  /*renameOnly=*/true);
    }
    if (cmd == kCmdDeleteEmptyClro && canDeleteEmptyClro) {
        DWORD deleteError = ERROR_SUCCESS;
        const EmptyClroDeleteResult result = DeleteEmptyClroNoteFile(selectedPath, &deleteError);
        if (result != EmptyClroDeleteResult::Deleted) {
            const std::wstring message = result == EmptyClroDeleteResult::NotEligible
                ? (IsEnglishUi()
                    ? L"The .clro file was not deleted because it is no longer empty or has pending changes."
                    : L".clro ファイルは空でなくなったか、未処理の変更があるため削除しませんでした。")
                : (IsEnglishUi()
                    ? L"Failed to delete the empty .clro file."
                    : L"空の .clro ファイルを削除できませんでした。");
            ShowSoftNotice(owner, message, SoftNoticeKind::Warning);
            return true;
        }

        if (NormalizePathKeyForList(file.path) == NormalizePathKeyForList(g_currentNotePath)) {
            ClearNoteEditorSilently(owner, L"");
        }
        RefreshCurrentSessionFiles();
        ShowSoftNotice(owner,
                       IsEnglishUi() ? L"Deleted the empty .clro file."
                                     : L"空の .clro ファイルを削除しました。",
                       SoftNoticeKind::Info);
        return true;
    }
    return cmd != 0;
}

static void HandlePdfNoteListDrop(HWND hWnd, HDROP drop) {
    struct DropFinishGuard {
        HDROP handle = nullptr;
        ~DropFinishGuard() {
            if (handle) DragFinish(handle);
        }
    } guard{drop};

    if (!drop) return;
    const UINT count = DragQueryFileW(drop, 0xFFFFFFFF, nullptr, 0);
    if (count == 0) return;

    std::vector<std::wstring> paths;
    paths.reserve(count);
    for (UINT i = 0; i < count; ++i) {
        const UINT len = DragQueryFileW(drop, i, nullptr, 0);
        if (len == 0) continue;
        std::wstring path(static_cast<size_t>(len) + 1, L'\0');
        const UINT copied = DragQueryFileW(drop, i, path.data(), static_cast<UINT>(path.size()));
        if (copied == 0) continue;
        path.resize(copied);
        paths.push_back(std::move(path));
    }
    guard.handle = nullptr;
    DragFinish(drop);

    if (paths.empty()) return;
    HWND owner = GetParent(hWnd);
    ImportDroppedFilesToCurrentSession(owner ? owner : hWnd, paths);
}
