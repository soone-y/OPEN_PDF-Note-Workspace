// file: main/main_local_path_browser.cppinc

enum class LocalPathBrowserEntryKind {
    DriveRoot,
    Directory,
    File,
};

struct LocalPathBrowserEntry {
    std::filesystem::path path;
    LocalPathBrowserEntryKind kind = LocalPathBrowserEntryKind::File;
    bool highlighted = false;
};

struct LocalPathBrowserHit {
    RECT rect{};
    std::filesystem::path path;
};

struct LocalPathBrowserState {
    HWND owner = nullptr;
    HWND hwnd = nullptr;
    HWND edit = nullptr;
    HWND pathTooltip = nullptr;
    std::wstring pathTooltipText;
    HWND list = nullptr;
    HWND suggestionList = nullptr;
    HWND suggestionLabel = nullptr;
    HWND allEntriesLabel = nullptr;
    HWND listDivider = nullptr;
    HWND status = nullptr;
    HWND fileNameEdit = nullptr;
    std::wstring title;
    // The caller names the action after selection; this browser only returns
    // validated paths. Empty means selection only, never inferred from title.
    std::wstring confirmLabel;
    std::filesystem::path currentDir;
    std::filesystem::path highlightPath;
    bool requireDirectory = false;
    bool allowMultiple = false;
    bool browseOnly = false;
    bool saveMode = false;
    std::wstring fileName;
    std::wstring defaultExtension;
    bool showDriveRoots = false;
    bool useNativeAfterClose = false;
    bool done = false;
    bool accepted = false;
    std::vector<LocalPathBrowserEntry> entries;
    // Both lists refer to these same entries; suggestions never remove paths
    // from the normal list or change the path returned to the caller.
    std::vector<size_t> suggestedEntries;
    std::vector<LocalPathBrowserHit> pathHits;
    std::vector<std::wstring> results;
};

static bool IsBrowserDirectoryEntry(const LocalPathBrowserEntry& entry) {
    return entry.kind == LocalPathBrowserEntryKind::DriveRoot ||
           entry.kind == LocalPathBrowserEntryKind::Directory;
}

static std::wstring DisplayNameForBrowserEntry(const LocalPathBrowserEntry& entry) {
    std::wstring name = entry.path.filename().wstring();
    if (name.empty()) name = entry.path.wstring();
    const std::wstring highlightSuffix = entry.highlighted
        ? L"  " + localization::Text(L"ui.local_path.current_workspace_marker")
        : L"";
    switch (entry.kind) {
    case LocalPathBrowserEntryKind::DriveRoot:
        return L"[DRV] " + name + highlightSuffix;
    case LocalPathBrowserEntryKind::Directory:
        return L"[DIR] " + name + highlightSuffix;
    case LocalPathBrowserEntryKind::File:
    default:
        return L"      " + name + highlightSuffix;
    }
}

[[nodiscard]] static std::wstring LocalPathBrowserConfirmLabel(const LocalPathBrowserState& state) {
    if (state.saveMode) return localization::Text(L"ui.local_path.choose_destination");
    if (state.browseOnly) return localization::Text(L"common.close");
    return state.confirmLabel.empty() ? localization::Text(L"ui.local_path.e5d546893d24") : state.confirmLabel;
}

static bool CopyPathToClipboard(HWND owner, const std::wstring& path);

// Folder names that are likely to be useful when choosing a class/course
// directory.  Keep this local to the app picker: it is only a display order
// hint and must not affect path handling or workspace semantics.
static int LocalBrowserDirectoryRelevance(const LocalPathBrowserEntry& entry) {
    if (entry.kind != LocalPathBrowserEntryKind::Directory) return 0;
    const std::wstring name = ToLowerAscii(entry.path.filename().wstring());
    static const std::array<const wchar_t*, 43> keywords = {
        L"授業", L"講義", L"実習", L"演習", L"教室", L"クラス", L"科目",
        L"学習", L"学校", L"大学", L"高校", L"中学", L"研修", L"セミナー",
        L"コース", L"講座", L"ゼミ", L"履修", L"時間割", L"教材", L"課題", L"レポート",
        L"classroom", L"lecture", L"lesson", L"course", L"class", L"seminar",
        L"practicum", L"workshop", L"tutorial", L"exercise", L"training",
        L"education", L"school", L"university", L"college", L"subject", L"curriculum",
        L"coursework", L"homework", L"assignment", L"syllabus"
    };
    for (size_t index = 0; index < keywords.size(); ++index) {
        if (name.find(keywords[index]) != std::wstring::npos) {
            return static_cast<int>(keywords.size() - index);
        }
    }
    return 0;
}

static bool ValidateExistingLocalPathForBrowser(HWND owner,
                                                const std::filesystem::path& selected,
                                                const std::wstring& title,
                                                bool requireDirectory) {
    (void)title;
    if (selected.empty()) return false;
    if (IsUncPath(selected)) {
        ShowSoftNotice(owner,
                       localization::Text(L"ui.local_path.fdb3da0b190c").c_str(),
                       SoftNoticeKind::Warning);
        return false;
    }
    std::filesystem::path root = selected.root_path();
    if (!root.empty()) {
        UINT driveType = GetDriveTypeW(root.c_str());
        if (driveType == DRIVE_REMOTE) {
            ShowSoftNotice(owner,
                           localization::Text(L"ui.local_path.b699246d81d5").c_str(),
                           SoftNoticeKind::Warning);
            return false;
        }
    }
    bool isReparse = false;
    if (TryIsReparsePointNoFollow(selected, isReparse) && isReparse) {
        ShowSoftNotice(owner,
                       localization::Text(L"ui.local_path.23b62ae45471").c_str(),
                       SoftNoticeKind::Warning);
        return false;
    }
    std::error_code ec;
    const bool matchesType = requireDirectory
        ? std::filesystem::is_directory(selected, ec)
        : std::filesystem::is_regular_file(selected, ec);
    if (ec || !matchesType) {
        ShowSoftNotice(owner,
                       requireDirectory
                           ? (localization::Text(L"ui.local_path.4ec8dc90632a").c_str())
                           : (localization::Text(L"ui.local_path.3f581bf44b47").c_str()),
                       SoftNoticeKind::Warning);
        return false;
    }
    return true;
}

static void RebuildLocalPathBrowserHits(LocalPathBrowserState* state, HWND pathBar) {
    if (!state || !pathBar) return;
    state->pathHits.clear();
    state->pathTooltipText = state->showDriveRoots ? L"" : state->currentDir.wstring();
    if (state->pathTooltip) {
        TOOLINFOW tool{};
        // V2 is accepted by both legacy and manifest-enabled common controls.
        tool.cbSize = TTTOOLINFOW_V2_SIZE;
        tool.uFlags = TTF_IDISHWND | TTF_SUBCLASS;
        tool.hwnd = state->hwnd;
        tool.uId = reinterpret_cast<UINT_PTR>(pathBar);
        tool.lpszText = state->pathTooltipText.data();
        SendMessageW(state->pathTooltip, TTM_UPDATETIPTEXTW, 0, reinterpret_cast<LPARAM>(&tool));
    }
    EnableWindow(GetDlgItem(state->hwnd, 206), state->showDriveRoots ? FALSE : TRUE);
    if (state->showDriveRoots) {
        SetWindowTextW(pathBar, localization::Text(L"ui.local_path.678c9ce46bbf").c_str());
        return;
    }
    HDC hdc = GetDC(pathBar);
    if (!hdc) return;
    HFONT font = reinterpret_cast<HFONT>(SendMessageW(pathBar, WM_GETFONT, 0, 0));
    HGDIOBJ oldFont = font ? SelectObject(hdc, font) : nullptr;
    int x = 6;
    RECT client{};
    GetClientRect(pathBar, &client);
    auto textWidth = [&](const std::wstring& label) {
        SIZE size{};
        GetTextExtentPoint32W(hdc, label.c_str(), static_cast<int>(label.size()), &size);
        return std::max(8, static_cast<int>(size.cx));
    };
    std::wstring display;
    auto addPart = [&](const std::wstring& label, const std::filesystem::path& target) {
        const int right = x + textWidth(label);
        RECT hit{x, client.top, right, client.bottom};
        if (!target.empty()) state->pathHits.push_back({hit, target});
        display += label;
        x = right;
    };
    std::vector<std::pair<std::wstring, std::filesystem::path>> parts;
    const std::filesystem::path current = state->currentDir;
    std::filesystem::path accum = current.root_path();
    if (!accum.empty()) {
        parts.push_back({accum.wstring(), accum});
    }
    std::filesystem::path relative = current.relative_path();
    for (const auto& part : relative) {
        if (part.empty()) continue;
        if (accum.empty()) {
            accum = part;
        } else {
            accum /= part;
        }
        parts.push_back({part.wstring() + (accum == current ? L"" : L"\\"), accum});
    }
    bool omitted = false;
    auto displayWidth = [&]() {
        int width = omitted ? textWidth(L"…\\") : 0;
        for (const auto& part : parts) width += textWidth(part.first);
        return width;
    };
    // Omit whole ancestor components, never a filename fragment. Hit targets
    // are built from the displayed components and retain their original paths.
    const int available = std::max(0L, client.right - client.left - 12);
    while (displayWidth() > available && parts.size() > 2) {
        parts.erase(parts.begin() + 1);
        omitted = true;
    }
    if (displayWidth() > available) {
        display = localization::Text(L"ui.local_path.path_hover");
    } else {
        for (size_t index = 0; index < parts.size(); ++index) {
            if (index == 1 && omitted) addPart(L"…\\", {});
            addPart(parts[index].first, parts[index].second);
        }
    }
    SetWindowTextW(pathBar, display.c_str());
    if (oldFont) SelectObject(hdc, oldFont);
    ReleaseDC(pathBar, hdc);
}

static void RefreshLocalPathBrowserList(LocalPathBrowserState* state);

static std::vector<LocalPathBrowserEntry> EnumerateLocalBrowserDriveRoots() {
    std::vector<LocalPathBrowserEntry> roots;
    wchar_t buffer[512]{};
    DWORD len = GetLogicalDriveStringsW(static_cast<DWORD>(std::size(buffer)), buffer);
    if (len == 0 || len >= std::size(buffer)) return roots;
    const wchar_t* p = buffer;
    while (*p) {
        std::filesystem::path root(p);
        const UINT type = GetDriveTypeW(root.c_str());
        if (type == DRIVE_FIXED || type == DRIVE_REMOVABLE ||
            type == DRIVE_CDROM || type == DRIVE_RAMDISK) {
            roots.push_back({root, LocalPathBrowserEntryKind::DriveRoot});
        }
        p += wcslen(p) + 1;
    }
    auto byName = [](const LocalPathBrowserEntry& a, const LocalPathBrowserEntry& b) {
        return ToLowerAscii(a.path.wstring()) < ToLowerAscii(b.path.wstring());
    };
    std::sort(roots.begin(), roots.end(), byName);
    return roots;
}

// Selection is owned by the browser UI. Merge both panes by entry identity so
// a folder selected twice is validated/returned once, including multi-select.
[[nodiscard]] static std::vector<size_t> SelectedLocalBrowserEntries(const LocalPathBrowserState* state) {
    std::vector<size_t> selected;
    if (!state) return selected;
    std::vector<bool> seen(state->entries.size(), false);
    for (HWND list : {state->suggestionList, state->list}) {
        if (!list) continue;
        std::vector<int> items;
        if (state->allowMultiple) {
            const int count = static_cast<int>(SendMessageW(list, LB_GETSELCOUNT, 0, 0));
            if (count <= 0) continue;
            items.resize(static_cast<size_t>(count));
            if (SendMessageW(list, LB_GETSELITEMS, count, reinterpret_cast<LPARAM>(items.data())) == LB_ERR) continue;
        } else {
            const int item = static_cast<int>(SendMessageW(list, LB_GETCURSEL, 0, 0));
            if (item < 0) continue;
            items.push_back(item);
        }
        for (int item : items) {
            const LRESULT data = SendMessageW(list, LB_GETITEMDATA, item, 0);
            if (data < 0 || static_cast<size_t>(data) >= seen.size()) continue;
            const size_t index = static_cast<size_t>(data);
            if (!seen[index]) selected.push_back(index);
            seen[index] = true;
        }
    }
    return selected;
}

static void LayoutLocalBrowserLists(LocalPathBrowserState* state) {
    if (!state || !state->list) return;
    const bool hasSuggestions = !state->suggestedEntries.empty();
    for (HWND control : {state->suggestionLabel, state->suggestionList, state->listDivider, state->allEntriesLabel}) {
        ShowWindow(control, hasSuggestions ? SW_SHOW : SW_HIDE);
    }
    const int bottom = state->saveMode ? 294 : 334;
    if (!hasSuggestions) {
        if (GetFocus() == state->suggestionList) SetFocus(state->list);
        MoveWindow(state->list, 12, 64, 660, bottom - 64, TRUE);
        return;
    }
    const int rowHeight = static_cast<int>(SendMessageW(state->suggestionList, LB_GETITEMHEIGHT, 0, 0));
    const int height = std::min(80, std::max(16, rowHeight) *
        static_cast<int>(std::min<size_t>(3, state->suggestedEntries.size())) + 4);
    MoveWindow(state->suggestionList, 12, 84, 660, height, TRUE);
    MoveWindow(state->listDivider, 12, 84 + height + 6, 660, 2, TRUE);
    MoveWindow(state->allEntriesLabel, 12, 84 + height + 12, 660, 18, TRUE);
    const int listTop = 84 + height + 32;
    MoveWindow(state->list, 12, listTop, 660, bottom - listTop, TRUE);
}

static void UpdateLocalPathBrowserStatus(LocalPathBrowserState* state) {
    if (!state || !state->status) return;
    std::wstring msg;
    if (state->showDriveRoots) {
        msg = localization::Text(L"ui.local_path.e65af19ca526").c_str();
    } else if (state->saveMode) {
        msg = localization::Text(L"ui.local_path.save_status");
    } else if (state->browseOnly) {
        msg = localization::Text(L"ui.local_path.0bb4528395a4").c_str();
    } else if (state->allowMultiple) {
        const size_t count = SelectedLocalBrowserEntries(state).size();
        msg = localization::Format(state->requireDirectory
                                       ? L"ui.local_path.multiple_folders"
                                       : L"ui.local_path.multiple_files",
                                   {{L"COUNT", std::to_wstring(count)}});
    } else {
        msg = state->requireDirectory
            ? (localization::Text(L"ui.local_path.91b46e26d314").c_str())
            : (localization::Text(L"ui.local_path.dd55499bda77").c_str());
    }
    SetWindowTextW(state->status, msg.c_str());
}

static LRESULT CALLBACK LocalPathBarSubclassProc(HWND hWnd,
                                                 UINT msg,
                                                 WPARAM wParam,
                                                 LPARAM lParam,
                                                 UINT_PTR subclassId,
                                                 DWORD_PTR refData) {
    (void)wParam;
    (void)subclassId;
    auto* state = reinterpret_cast<LocalPathBrowserState*>(refData);
    if (msg == WM_LBUTTONDOWN && state) {
        POINT pt{GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam)};
        for (const auto& hit : state->pathHits) {
            if (PtInRect(&hit.rect, pt)) {
                state->currentDir = hit.path;
                RefreshLocalPathBrowserList(state);
                return 0;
            }
        }
    } else if ((msg == WM_SIZE || msg == WM_SETFONT) && state) {
        const LRESULT result = DefSubclassProc(hWnd, msg, wParam, lParam);
        RebuildLocalPathBrowserHits(state, hWnd);
        return result;
    } else if (msg == WM_NCDESTROY) {
        RemoveWindowSubclass(hWnd, LocalPathBarSubclassProc, subclassId);
    }
    return DefSubclassProc(hWnd, msg, wParam, lParam);
}

static void RefreshLocalPathBrowserList(LocalPathBrowserState* state) {
    if (!state || !state->list) return;
    SendMessageW(state->list, LB_RESETCONTENT, 0, 0);
    SendMessageW(state->suggestionList, LB_RESETCONTENT, 0, 0);
    state->entries.clear();
    state->suggestedEntries.clear();
    if (state->showDriveRoots) {
        if (state->edit) {
            RebuildLocalPathBrowserHits(state, state->edit);
        }
        state->entries = EnumerateLocalBrowserDriveRoots();
        for (size_t index = 0; index < state->entries.size(); ++index) {
            const std::wstring label = DisplayNameForBrowserEntry(state->entries[index]);
            LRESULT item = SendMessageW(state->list, LB_ADDSTRING, 0, reinterpret_cast<LPARAM>(label.c_str()));
            if (item != LB_ERR && item != LB_ERRSPACE) {
                SendMessageW(state->list, LB_SETITEMDATA, static_cast<WPARAM>(item), static_cast<LPARAM>(index));
            }
        }
        LayoutLocalBrowserLists(state);
        UpdateLocalPathBrowserStatus(state);
        return;
    }
    if (state->currentDir.empty()) {
        LayoutLocalBrowserLists(state);
        return;
    }
    if (state->edit) {
        RebuildLocalPathBrowserHits(state, state->edit);
    }

    std::vector<LocalPathBrowserEntry> dirs;
    std::vector<LocalPathBrowserEntry> files;
    std::error_code iterEc;
    for (std::filesystem::directory_iterator it(state->currentDir, iterEc), end;
         !iterEc && it != end; it.increment(iterEc)) {
        const std::filesystem::path path = it->path();
        bool isReparse = false;
        if (TryIsReparsePointNoFollow(path, isReparse) && isReparse) continue;
        std::error_code typeEc;
        if (it->is_directory(typeEc) && !typeEc) {
            dirs.push_back({path, LocalPathBrowserEntryKind::Directory});
            continue;
        }
        if ((!state->requireDirectory || state->browseOnly) &&
            it->is_regular_file(typeEc) && !typeEc) {
            files.push_back({path, LocalPathBrowserEntryKind::File});
        }
    }
    auto byName = [](const LocalPathBrowserEntry& a, const LocalPathBrowserEntry& b) {
        return ToLowerAscii(a.path.filename().wstring()) < ToLowerAscii(b.path.filename().wstring());
    };
    std::sort(dirs.begin(), dirs.end(), byName);
    std::sort(files.begin(), files.end(), byName);
    const std::wstring highlightKey = state->highlightPath.empty()
        ? L""
        : NormalizePathKey(state->highlightPath.wstring());
    auto markCurrentWorkspace = [&](LocalPathBrowserEntry& entry) {
        entry.highlighted = !highlightKey.empty() &&
            NormalizePathKey(entry.path.wstring()) == highlightKey;
    };
    for (auto& entry : dirs) markCurrentWorkspace(entry);
    for (auto& entry : files) markCurrentWorkspace(entry);
    state->entries.reserve(dirs.size() + files.size());
    state->entries.insert(state->entries.end(), dirs.begin(), dirs.end());
    state->entries.insert(state->entries.end(), files.begin(), files.end());
    for (size_t index = 0; index < state->entries.size(); ++index) {
        const auto& entry = state->entries[index];
        if (entry.highlighted || LocalBrowserDirectoryRelevance(entry) > 0) {
            state->suggestedEntries.push_back(index);
        }
    }
    std::sort(state->suggestedEntries.begin(), state->suggestedEntries.end(), [&](size_t a, size_t b) {
        const auto& left = state->entries[a];
        const auto& right = state->entries[b];
        if (left.highlighted != right.highlighted) return left.highlighted;
        const int leftRank = LocalBrowserDirectoryRelevance(left);
        const int rightRank = LocalBrowserDirectoryRelevance(right);
        return leftRank != rightRank ? leftRank > rightRank : byName(left, right);
    });
    int highlightedSuggestion = LB_ERR;
    for (size_t index : state->suggestedEntries) {
        const std::wstring label = DisplayNameForBrowserEntry(state->entries[index]);
        const LRESULT item = SendMessageW(state->suggestionList, LB_ADDSTRING, 0, reinterpret_cast<LPARAM>(label.c_str()));
        if (item != LB_ERR && item != LB_ERRSPACE) {
            SendMessageW(state->suggestionList, LB_SETITEMDATA, item, static_cast<LPARAM>(index));
            if (state->entries[index].highlighted) highlightedSuggestion = static_cast<int>(item);
        }
    }
    LayoutLocalBrowserLists(state);
    int highlightedItem = LB_ERR;
    for (size_t index = 0; index < state->entries.size(); ++index) {
        const std::wstring label = DisplayNameForBrowserEntry(state->entries[index]);
        LRESULT item = SendMessageW(state->list, LB_ADDSTRING, 0, reinterpret_cast<LPARAM>(label.c_str()));
        if (item != LB_ERR && item != LB_ERRSPACE) {
            SendMessageW(state->list, LB_SETITEMDATA, static_cast<WPARAM>(item), static_cast<LPARAM>(index));
            if (state->entries[index].highlighted) highlightedItem = static_cast<int>(item);
        }
    }
    if (highlightedItem != LB_ERR) {
        HWND list = highlightedSuggestion != LB_ERR ? state->suggestionList : state->list;
        const int item = highlightedSuggestion != LB_ERR ? highlightedSuggestion : highlightedItem;
        SendMessageW(list, state->allowMultiple ? LB_SETSEL : LB_SETCURSEL,
                     state->allowMultiple ? TRUE : static_cast<WPARAM>(item), state->allowMultiple ? item : 0);
        SendMessageW(list, LB_SETCARETINDEX, static_cast<WPARAM>(item), FALSE);
    }
    UpdateLocalPathBrowserStatus(state);
}

static std::filesystem::path BrowserEditPath(LocalPathBrowserState* state) {
    return state ? state->currentDir : std::filesystem::path{};
}

static bool AcceptBrowserPath(LocalPathBrowserState* state, const std::filesystem::path& path) {
    if (!state) return false;
    if (state->browseOnly) {
        state->done = true;
        if (state->hwnd) DestroyWindow(state->hwnd);
        return true;
    }
    if (!ValidateExistingLocalPathForBrowser(state->hwnd ? state->hwnd : state->owner,
                                             path, state->title, state->requireDirectory)) {
        return false;
    }
    state->results.clear();
    state->results.push_back(path.wstring());
    state->accepted = true;
    state->done = true;
    if (state->hwnd) DestroyWindow(state->hwnd);
    return true;
}

static void EnableNativeFileDialogsFromLocalBrowser(LocalPathBrowserState* state) {
    if (!state) return;
    state->useNativeAfterClose = true;
    state->done = true;
    if (state->hwnd) DestroyWindow(state->hwnd);
}

static void ReadLocalBrowserSaveName(LocalPathBrowserState* state) {
    if (!state || !state->fileNameEdit) return;
    const int len = GetWindowTextLengthW(state->fileNameEdit);
    std::wstring text(static_cast<size_t>(std::max(0, len)) + 1, L'\0');
    const int copied = GetWindowTextW(state->fileNameEdit, text.data(), static_cast<int>(text.size()));
    text.resize(static_cast<size_t>(std::max(0, copied)));
    state->fileName = TrimWhitespace(text);
}

static void SelectLocalBrowserSaveFile(LocalPathBrowserState* state,
                                       const LocalPathBrowserEntry& entry) {
    if (!state || !state->saveMode || IsBrowserDirectoryEntry(entry)) return;
    state->fileName = entry.path.filename().wstring();
    SetWindowTextW(state->fileNameEdit, state->fileName.c_str());
}

static LRESULT CALLBACK LocalBrowserSaveNameProc(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam,
                                                UINT_PTR subclassId, DWORD_PTR) {
    if (msg == WM_CHAR && (wParam == VK_RETURN || wParam == VK_ESCAPE || wParam == VK_TAB)) return 0;
    if (msg == WM_NCDESTROY) RemoveWindowSubclass(hWnd, LocalBrowserSaveNameProc, subclassId);
    return DefSubclassProc(hWnd, msg, wParam, lParam);
}

static void LocalPathBrowserOpenSelection(LocalPathBrowserState* state, HWND list) {
    if (!state || !list) return;
    const int sel = static_cast<int>(SendMessageW(list, LB_GETCURSEL, 0, 0));
    if (sel < 0) return;
    const LRESULT data = SendMessageW(list, LB_GETITEMDATA, static_cast<WPARAM>(sel), 0);
    if (data < 0 || static_cast<size_t>(data) >= state->entries.size()) return;
    const auto& entry = state->entries[static_cast<size_t>(data)];
    if (IsBrowserDirectoryEntry(entry)) {
        state->currentDir = entry.path;
        state->showDriveRoots = false;
        RefreshLocalPathBrowserList(state);
        return;
    }
    if (state->saveMode) {
        SelectLocalBrowserSaveFile(state, entry);
        SetFocus(state->fileNameEdit);
        SendMessageW(state->fileNameEdit, EM_SETSEL, 0, -1);
    } else if (!state->requireDirectory && !state->browseOnly) {
        AcceptBrowserPath(state, entry.path);
    }
}

static void LocalPathBrowserAccept(LocalPathBrowserState* state) {
    if (!state) return;
    if (state->saveMode) {
        ReadLocalBrowserSaveName(state);
        const auto& name = state->fileName;
        if (name.empty() || name == L"." || name == L".." ||
            name.find_first_of(L"\\/:*?\"<>|") != std::wstring::npos ||
            name.back() == L'.' || name.back() == L' ' ||
            std::any_of(name.begin(), name.end(), [](wchar_t ch) { return ch < 32; })) {
            ShowSoftNotice(state->hwnd, localization::Text(L"export.output_name_invalid"), SoftNoticeKind::Warning);
            SetFocus(state->fileNameEdit);
            return;
        }
        if (state->showDriveRoots || !state->currentDir.is_absolute() ||
            !ValidateExistingLocalPathForBrowser(state->hwnd, state->currentDir, state->title, true)) return;
        std::filesystem::path fileName(name);
        if (!fileName.has_extension() && !state->defaultExtension.empty()) {
            fileName.replace_extension(L"." + state->defaultExtension);
        }
        state->fileName = fileName.wstring();
        state->results = {(state->currentDir / fileName).wstring()};
        state->accepted = true;
        state->done = true;
        DestroyWindow(state->hwnd);
        return;
    }
    if (state->browseOnly) {
        state->done = true;
        if (state->hwnd) DestroyWindow(state->hwnd);
        return;
    }
    if (state->allowMultiple) {
        std::vector<std::wstring> paths;
        for (size_t index : SelectedLocalBrowserEntries(state)) {
            const auto& entry = state->entries[index];
            if (IsBrowserDirectoryEntry(entry) != state->requireDirectory) continue;
            if (!ValidateExistingLocalPathForBrowser(state->hwnd ? state->hwnd : state->owner,
                                                     entry.path, state->title, state->requireDirectory)) {
                return;
            }
            paths.push_back(entry.path.wstring());
        }
        if (!paths.empty()) {
            state->results = std::move(paths);
            state->accepted = true;
            state->done = true;
            if (state->hwnd) DestroyWindow(state->hwnd);
            return;
        }
    }

    if (state->requireDirectory) {
        std::filesystem::path candidate = BrowserEditPath(state);
        if (candidate.empty()) candidate = state->currentDir;
        AcceptBrowserPath(state, candidate);
        return;
    }

    const std::filesystem::path typed = BrowserEditPath(state);
    std::error_code ec;
    if (!typed.empty() && std::filesystem::is_directory(typed, ec) && !ec) {
        state->currentDir = typed;
        RefreshLocalPathBrowserList(state);
        return;
    }
    if (!typed.empty()) {
        AcceptBrowserPath(state, typed);
        return;
    }
    LocalPathBrowserOpenSelection(state, state->list);
}

static LRESULT CALLBACK LocalPathBrowserProc(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam) {
    LocalPathBrowserState* state =
        reinterpret_cast<LocalPathBrowserState*>(GetWindowLongPtrW(hWnd, GWLP_USERDATA));
    switch (msg) {
    case WM_CREATE: {
        auto cs = reinterpret_cast<CREATESTRUCTW*>(lParam);
        state = reinterpret_cast<LocalPathBrowserState*>(cs->lpCreateParams);
        SetWindowLongPtrW(hWnd, GWLP_USERDATA, reinterpret_cast<LONG_PTR>(state));
        state->hwnd = hWnd;
        CreateWindowExW(0, L"STATIC",
                        state->saveMode ? localization::Text(L"dialog.save_path.folder_label").c_str() :
                        state->browseOnly ? (localization::Text(L"ui.local_path.690165622b57").c_str()) :
                        state->requireDirectory
                            ? (localization::Text(L"ui.local_path.8eb379b072ec").c_str())
                            : (localization::Text(L"ui.local_path.644b3bdfaec0").c_str()),
                        WS_CHILD | WS_VISIBLE,
                        12, 10, 660, 20, hWnd, nullptr, cs->hInstance, nullptr);
        state->edit = CreateWindowExW(WS_EX_CLIENTEDGE, L"STATIC", L"",
                                      WS_CHILD | WS_VISIBLE | WS_TABSTOP | SS_LEFTNOWORDWRAP | SS_NOTIFY,
                                      12, 32, 660, 24, hWnd, reinterpret_cast<HMENU>(101),
                                      cs->hInstance, nullptr);
        if (state->edit) {
            SetWindowSubclass(state->edit, LocalPathBarSubclassProc, 1, reinterpret_cast<DWORD_PTR>(state));
            state->pathTooltip = CreateWindowExW(WS_EX_TOPMOST, TOOLTIPS_CLASSW, nullptr,
                                                 WS_POPUP | TTS_NOPREFIX | TTS_ALWAYSTIP,
                                                 CW_USEDEFAULT, CW_USEDEFAULT, CW_USEDEFAULT, CW_USEDEFAULT,
                                                 hWnd, nullptr, cs->hInstance, nullptr);
            TOOLINFOW tool{};
            tool.cbSize = TTTOOLINFOW_V2_SIZE;
            tool.uFlags = TTF_IDISHWND | TTF_SUBCLASS;
            tool.hwnd = hWnd;
            tool.uId = reinterpret_cast<UINT_PTR>(state->edit);
            tool.lpszText = state->pathTooltipText.data();
            SendMessageW(state->pathTooltip, TTM_ADDTOOLW, 0, reinterpret_cast<LPARAM>(&tool));
            SendMessageW(state->pathTooltip, TTM_SETMAXTIPWIDTH, 0, 660);
            SendMessageW(state->pathTooltip, TTM_SETDELAYTIME, TTDT_AUTOPOP, 30000);
        }
        const DWORD listStyle = WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_VSCROLL |
                                LBS_NOTIFY | LBS_NOINTEGRALHEIGHT |
                                (state->allowMultiple ? LBS_EXTENDEDSEL : 0);
        state->list = CreateWindowExW(WS_EX_CLIENTEDGE, L"LISTBOX", L"",
                                      listStyle,
                                      12, 64, 660, state->saveMode ? 230 : 270, hWnd, reinterpret_cast<HMENU>(102),
                                      cs->hInstance, nullptr);
        state->suggestionLabel = CreateWindowExW(0, L"STATIC", localization::Text(L"ui.local_path.suggestions").c_str(),
                                                WS_CHILD, 12, 64, 660, 18, hWnd, nullptr, cs->hInstance, nullptr);
        state->suggestionList = CreateWindowExW(WS_EX_CLIENTEDGE, L"LISTBOX", L"", listStyle,
                                               12, 84, 660, 60, hWnd, reinterpret_cast<HMENU>(104), cs->hInstance, nullptr);
        state->listDivider = CreateWindowExW(0, L"STATIC", L"", WS_CHILD | SS_ETCHEDHORZ,
                                            12, 150, 660, 2, hWnd, nullptr, cs->hInstance, nullptr);
        state->allEntriesLabel = CreateWindowExW(0, L"STATIC", localization::Text(L"ui.local_path.all_entries").c_str(),
                                                WS_CHILD, 12, 160, 660, 18, hWnd, nullptr, cs->hInstance, nullptr);
        // Match keyboard traversal to the visual order: candidates then all entries.
        SetWindowPos(state->suggestionList, state->edit, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
        SetWindowPos(state->list, state->suggestionList, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
        if (state->saveMode) {
            CreateWindowExW(0, L"STATIC", localization::Text(L"dialog.save_path.file_name_label").c_str(),
                            WS_CHILD | WS_VISIBLE, 12, 302, 100, 24, hWnd, nullptr, cs->hInstance, nullptr);
            state->fileNameEdit = CreateWindowExW(WS_EX_CLIENTEDGE, L"EDIT", state->fileName.c_str(),
                                                WS_CHILD | WS_VISIBLE | WS_TABSTOP | ES_AUTOHSCROLL,
                                                116, 300, 556, 26, hWnd, reinterpret_cast<HMENU>(103),
                                                cs->hInstance, nullptr);
            SetWindowSubclass(state->fileNameEdit, LocalBrowserSaveNameProc, 1, 0);
        }
        state->status = CreateWindowExW(0, L"STATIC", L"",
                                        WS_CHILD | WS_VISIBLE | SS_LEFT,
                                        12, 342, 660, 24, hWnd, nullptr,
                                        cs->hInstance, nullptr);
        CreateWindowExW(0, L"BUTTON", localization::Text(L"ui.local_path.25fa8953067c").c_str(),
                        WS_CHILD | WS_VISIBLE | WS_TABSTOP,
                        12, 374, 82, 28, hWnd, reinterpret_cast<HMENU>(201),
                        cs->hInstance, nullptr);
        CreateWindowExW(0, L"BUTTON", localization::Text(L"ui.local_path.f51e61bfc937").c_str(),
                        WS_CHILD | WS_VISIBLE | WS_TABSTOP,
                        106, 374, 82, 28, hWnd, reinterpret_cast<HMENU>(202),
                        cs->hInstance, nullptr);
        CreateWindowExW(0, L"BUTTON", localization::Text(L"ui.local_path.09cfd6dcf9f4").c_str(),
                        WS_CHILD | WS_VISIBLE | WS_TABSTOP,
                        200, 374, 82, 28, hWnd, reinterpret_cast<HMENU>(203),
                        cs->hInstance, nullptr);
        CreateWindowExW(0, L"BUTTON", localization::Text(L"ui.local_path.copy_path").c_str(),
                        WS_CHILD | WS_VISIBLE | WS_TABSTOP,
                        294, 374, 120, 28, hWnd, reinterpret_cast<HMENU>(206), cs->hInstance, nullptr);
        
        CreateWindowExW(0, L"BUTTON", LocalPathBrowserConfirmLabel(*state).c_str(),
                        WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_DEFPUSHBUTTON,
                        state->browseOnly ? 586 : 430, 374, state->browseOnly ? 86 : 154, 28,
                        hWnd, reinterpret_cast<HMENU>(IDOK),
                        cs->hInstance, nullptr);
        if (!state->browseOnly) {
            CreateWindowExW(0, L"BUTTON", localization::Text(L"ui.local_path.3672b0b92134").c_str(),
                            WS_CHILD | WS_VISIBLE | WS_TABSTOP,
                            586, 374, 86, 28, hWnd, reinterpret_cast<HMENU>(IDCANCEL),
                            cs->hInstance, nullptr);
        }

        if (!state->browseOnly) {
            CreateWindowExW(0, L"BUTTON", localization::Text(L"ui.local_path.2e95025d73ce").c_str(),
                            WS_CHILD | WS_VISIBLE | WS_TABSTOP,
                            12, 414, 180, 28, hWnd, reinterpret_cast<HMENU>(204),
                            cs->hInstance, nullptr);
            
            CreateWindowExW(0, L"BUTTON", localization::Text(L"ui.local_path.227ba859167d").c_str(),
                            WS_CHILD | WS_VISIBLE | BS_AUTOCHECKBOX | WS_TABSTOP,
                            206, 418, 300, 20, hWnd, reinterpret_cast<HMENU>(205),
                            cs->hInstance, nullptr);
        }

        ApplyThemeToDialog(hWnd);
        RefreshLocalPathBrowserList(state);
        SetFocus(state->saveMode ? state->fileNameEdit :
                 state->suggestedEntries.empty() ? state->list : state->suggestionList);
        if (state->saveMode) SendMessageW(state->fileNameEdit, EM_SETSEL, 0, -1);
        return 0;
    }
    case WM_THEMECHANGED:
        ApplyThemeToDialog(hWnd);
        return 0;
    case WM_ERASEBKGND: {
        HDC hdc = reinterpret_cast<HDC>(wParam);
        RECT rc{};
        GetClientRect(hWnd, &rc);
        HBRUSH bg = g_hThemeWindowBrush ? g_hThemeWindowBrush : reinterpret_cast<HBRUSH>(COLOR_WINDOW + 1);
        FillRect(hdc, &rc, bg);
        return 1;
    }
    case WM_CTLCOLORSTATIC:
    case WM_CTLCOLOREDIT:
    case WM_CTLCOLORLISTBOX:
    case WM_CTLCOLORBTN: {
        HDC hdc = reinterpret_cast<HDC>(wParam);
        HWND ctl = reinterpret_cast<HWND>(lParam);
        return ThemeCtlColorPanel(ctl, hdc);
    }
    case WM_COMMAND:
        if (LOWORD(wParam) == IDCANCEL) {
            if (state) state->done = true;
            DestroyWindow(hWnd);
            return 0;
        }
        if (LOWORD(wParam) == IDOK) {
            LocalPathBrowserAccept(state);
            return 0;
        }
        if (LOWORD(wParam) == 201 && state) {
            if (state->showDriveRoots) {
                return 0;
            }
            const std::filesystem::path parent = state->currentDir.parent_path();
            if (!parent.empty() && parent != state->currentDir) {
                state->currentDir = parent;
            } else {
                state->showDriveRoots = true;
            }
            RefreshLocalPathBrowserList(state);
            return 0;
        }
        if (LOWORD(wParam) == 202 && state) {
            state->showDriveRoots = true;
            RefreshLocalPathBrowserList(state);
            return 0;
        }
        if (LOWORD(wParam) == 203 && state) {
            RefreshLocalPathBrowserList(state);
            return 0;
        }
        if (LOWORD(wParam) == 206 && state) {
            if (!state->showDriveRoots) (void)CopyPathToClipboard(hWnd, state->currentDir.wstring());
            return 0;
        }
        if (LOWORD(wParam) == 204 && state) {
            if (state->saveMode) ReadLocalBrowserSaveName(state);
            if (SendMessageW(GetDlgItem(hWnd, 205), BM_GETCHECK, 0, 0) == BST_CHECKED) {
                g_config.useNativeFileDialogs = true;
                if (!g_workspaceRoot.empty()) {
                    SaveWorkspaceConfig(g_workspaceRoot, g_config);
                }
            }
            EnableNativeFileDialogsFromLocalBrowser(state);
            return 0;
        }
        if ((LOWORD(wParam) == 102 || LOWORD(wParam) == 104) && HIWORD(wParam) == LBN_SELCHANGE) {
            HWND list = state ? (LOWORD(wParam) == 104 ? state->suggestionList : state->list) : nullptr;
            if (state && !state->allowMultiple) {
                HWND other = list == state->list ? state->suggestionList : state->list;
                SendMessageW(other, LB_SETCURSEL, static_cast<WPARAM>(-1), 0);
            }
            if (state && state->saveMode) {
                const int selected = static_cast<int>(SendMessageW(list, LB_GETCURSEL, 0, 0));
                const LRESULT data = selected >= 0 ? SendMessageW(list, LB_GETITEMDATA, selected, 0) : LB_ERR;
                if (data >= 0 && static_cast<size_t>(data) < state->entries.size()) {
                    SelectLocalBrowserSaveFile(state, state->entries[static_cast<size_t>(data)]);
                }
            }
            UpdateLocalPathBrowserStatus(state);
            return 0;
        }
        if ((LOWORD(wParam) == 102 || LOWORD(wParam) == 104) && HIWORD(wParam) == LBN_DBLCLK) {
            LocalPathBrowserOpenSelection(state, state ? (LOWORD(wParam) == 104 ? state->suggestionList : state->list) : nullptr);
            return 0;
        }
        break;
    case WM_CLOSE:
        if (state) state->done = true;
        DestroyWindow(hWnd);
        return 0;
    }
    return DefWindowProcW(hWnd, msg, wParam, lParam);
}

static std::vector<std::wstring> PromptNativeExistingLocalPaths(HWND owner,
                                                                const std::filesystem::path& initial,
                                                                const std::wstring& title,
                                                                bool requireDirectory,
                                                                bool allowMultiple,
                                                                const std::filesystem::path& highlightPath,
                                                                const std::wstring& confirmLabel);

static std::vector<std::wstring> PromptLocalPathBrowser(HWND owner,
                                                        const std::filesystem::path& initial,
                                                        const std::wstring& title,
                                                        bool requireDirectory,
                                                        bool allowMultiple,
                                                        bool browseOnly,
                                                        const std::filesystem::path& highlightPath,
                                                        SavePathPromptSelection* saveSelection = nullptr,
                                                        const std::wstring& defaultExtension = {},
                                                        const std::wstring& confirmLabel = {}) {
    LocalPathBrowserState state;
    state.owner = owner;
    state.title = title;
    state.confirmLabel = confirmLabel;
    state.currentDir = ResolveDialogInitialFolder(initial);
    state.highlightPath = highlightPath;
    state.requireDirectory = requireDirectory;
    state.allowMultiple = allowMultiple;
    state.browseOnly = browseOnly;
    state.saveMode = saveSelection != nullptr;
    if (saveSelection) state.fileName = saveSelection->fileName;
    state.defaultExtension = defaultExtension;
    if (state.currentDir.empty()) return {};

    WNDCLASSW wc{};
    wc.lpfnWndProc = LocalPathBrowserProc;
    wc.hInstance = g_hInst;
    wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
    wc.lpszClassName = L"LocalPathBrowserDlg";
    RegisterClassW(&wc);

    if (owner) EnableWindow(owner, FALSE);
    HWND w = CreateWindowExW(WS_EX_DLGMODALFRAME, wc.lpszClassName, title.c_str(),
                             WS_CAPTION | WS_POPUPWINDOW,
                             CW_USEDEFAULT, CW_USEDEFAULT, 704, 490,
                             owner, nullptr, g_hInst, &state);
    if (!w) {
        if (owner) EnableWindow(owner, TRUE);
        return {};
    }
    PlaceOwnedPopupAtAppTopLeft(w, owner);
    ShowWindow(w, SW_SHOW);
    UpdateWindow(w);

    MSG msg;
    while (!state.done) {
        BOOL gm = GetMessageW(&msg, nullptr, 0, 0);
        if (gm == -1) break;
        if (gm == 0) {
            PostQuitMessage(static_cast<int>(msg.wParam));
            break;
        }
        if (ShouldSkipImeMessageInLoop(msg)) continue;
        if (state.saveMode && ui::ConsumeNoOpEdgeNavKeyForMultilineEdit(msg)) continue;
        if (!IsDialogMessageW(w, &msg)) {
            TranslateMessage(&msg);
            DispatchMessageW(&msg);
        }
    }
    if (owner) {
        EnableWindow(owner, TRUE);
        SetActiveWindow(owner);
    }
    if (saveSelection) {
        saveSelection->action = state.useNativeAfterClose ? SavePathPromptResult::OpenSystemDialog :
                               state.accepted ? SavePathPromptResult::DirectInput : SavePathPromptResult::Cancel;
        saveSelection->directory = state.currentDir;
        saveSelection->fileName = state.fileName;
    } else if (state.useNativeAfterClose && !browseOnly) {
        return PromptNativeExistingLocalPaths(owner, state.currentDir, title, requireDirectory, allowMultiple,
                                              state.highlightPath, state.confirmLabel);
    }
    return state.accepted ? state.results : std::vector<std::wstring>{};
}

SavePathPromptSelection PromptSavePath(HWND owner, const std::wstring& title,
                                        const std::filesystem::path& directory,
                                        const std::wstring& defaultName,
                                        const std::wstring& defaultExtension) {
    SavePathPromptSelection selection;
    selection.directory = ResolveDialogInitialFolder(directory);
    selection.fileName = defaultName;
    if (g_config.useNativeFileDialogs) {
        selection.action = SavePathPromptResult::OpenSystemDialog;
        return selection;
    }
    (void)PromptLocalPathBrowser(owner, selection.directory, title, false, false, false, {},
                                &selection, defaultExtension);
    return selection;
}

static std::vector<std::wstring> PromptNativeExistingLocalPaths(HWND owner,
                                                                const std::filesystem::path& initial,
                                                                const std::wstring& title,
                                                                bool requireDirectory,
                                                                bool allowMultiple,
                                                                const std::filesystem::path& highlightPath,
                                                                const std::wstring& confirmLabel) {
    IFileOpenDialog* dialog = nullptr;
    HRESULT hr = CoCreateInstance(CLSID_FileOpenDialog, nullptr, CLSCTX_INPROC_SERVER,
                                  IID_PPV_ARGS(&dialog));
    if (FAILED(hr) || !dialog) {
        ShowSoftNotice(owner,
                       localization::Text(L"ui.local_path.31f727ea8042").c_str(),
                       SoftNoticeKind::Warning);
        return {};
    }

    DWORD options = 0;
    if (SUCCEEDED(dialog->GetOptions(&options))) {
        options |= FOS_FORCEFILESYSTEM | FOS_PATHMUSTEXIST;
        options |= requireDirectory ? FOS_PICKFOLDERS : FOS_FILEMUSTEXIST;
        if (allowMultiple) options |= FOS_ALLOWMULTISELECT;
        dialog->SetOptions(options);
    }
    if (!title.empty()) {
        dialog->SetTitle(title.c_str());
    }
    const std::wstring action = confirmLabel.empty() ? localization::Text(L"ui.local_path.e5d546893d24") : confirmLabel;
    // Older shell implementations may not expose a custom label; selection
    // itself remains valid even when the visual label cannot be changed.
    (void)dialog->SetOkButtonLabel(action.c_str());
    std::filesystem::path initialDir = ResolveDialogInitialFolder(initial);
    if (!initialDir.empty()) {
        IShellItem* folder = nullptr;
        if (SUCCEEDED(SHCreateItemFromParsingName(initialDir.c_str(), nullptr, IID_PPV_ARGS(&folder))) && folder) {
            dialog->SetFolder(folder);
            folder->Release();
        }
    }
    if (!highlightPath.empty() &&
        NormalizePathKey(highlightPath.parent_path().wstring()) == NormalizePathKey(initialDir.wstring())) {
        dialog->SetFileName(highlightPath.filename().c_str());
    }

    hr = dialog->Show(MainDialogOwner(owner));
    if (hr == HRESULT_FROM_WIN32(ERROR_CANCELLED)) {
        dialog->Release();
        return {};
    }
    if (FAILED(hr)) {
        dialog->Release();
        ShowSoftNotice(owner,
                       localization::Text(L"ui.local_path.3904882d6933").c_str(),
                       SoftNoticeKind::Warning);
        return {};
    }

    std::vector<std::wstring> paths;
    if (allowMultiple) {
        IShellItemArray* items = nullptr;
        if (SUCCEEDED(dialog->GetResults(&items)) && items) {
            DWORD count = 0;
            if (SUCCEEDED(items->GetCount(&count))) {
                for (DWORD i = 0; i < count; ++i) {
                    IShellItem* item = nullptr;
                    if (FAILED(items->GetItemAt(i, &item)) || !item) continue;
                    PWSTR raw = nullptr;
                    if (SUCCEEDED(item->GetDisplayName(SIGDN_FILESYSPATH, &raw)) && raw) {
                        paths.emplace_back(raw);
                        CoTaskMemFree(raw);
                    }
                    item->Release();
                }
            }
            items->Release();
        }
    } else {
        IShellItem* item = nullptr;
        if (SUCCEEDED(dialog->GetResult(&item)) && item) {
            PWSTR raw = nullptr;
            if (SUCCEEDED(item->GetDisplayName(SIGDN_FILESYSPATH, &raw)) && raw) {
                paths.emplace_back(raw);
                CoTaskMemFree(raw);
            }
            item->Release();
        }
    }
    dialog->Release();

    std::vector<std::wstring> results;
    for (const auto& pathText : paths) {
        std::filesystem::path selected(pathText);
        if (!ValidateExistingLocalPathForBrowser(owner, selected, title, requireDirectory)) {
            return {};
        }
        results.push_back(selected.wstring());
    }
    return results;
}

std::optional<std::wstring> PromptExistingLocalPath(HWND owner,
                                                            const std::filesystem::path& initial,
                                                            const std::wstring& title,
                                                            bool requireDirectory,
                                                            const std::filesystem::path& highlightPath,
                                                            const std::wstring& confirmLabel) {
    if (g_config.useNativeFileDialogs) {
        auto picked = PromptNativeExistingLocalPaths(owner, initial, title, requireDirectory,
                                                    /*allowMultiple=*/false, highlightPath, confirmLabel);
        if (picked.empty()) return std::nullopt;
        return picked.front();
    }
    std::vector<std::wstring> picked =
        PromptLocalPathBrowser(owner, initial, title, requireDirectory, /*allowMultiple=*/false,
                               /*browseOnly=*/false, highlightPath, nullptr, {}, confirmLabel);
    if (picked.empty()) return std::nullopt;
    std::filesystem::path selected(picked.front());
    if (!ValidateExistingLocalPathForBrowser(owner, selected, title, requireDirectory)) {
        return std::nullopt;
    }
    return selected.wstring();
}

std::optional<std::wstring> PromptExistingLocalPathAppFirst(HWND owner,
                                                                   const std::filesystem::path& initial,
                                                                   const std::wstring& title,
                                                                   bool requireDirectory,
                                                                   const std::wstring& confirmLabel) {
    if (g_config.useNativeFileDialogs) {
        auto picked = PromptNativeExistingLocalPaths(owner, initial, title, requireDirectory,
                                                    /*allowMultiple=*/false, {}, confirmLabel);
        if (picked.empty()) return std::nullopt;
        return picked.front();
    }
    std::vector<std::wstring> picked =
        PromptLocalPathBrowser(owner, initial, title, requireDirectory, /*allowMultiple=*/false,
                               /*browseOnly=*/false, {}, nullptr, {}, confirmLabel);
    if (picked.empty()) return std::nullopt;
    std::filesystem::path selected(picked.front());
    if (!ValidateExistingLocalPathForBrowser(owner, selected, title, requireDirectory)) {
        return std::nullopt;
    }
    return selected.wstring();
}

static std::vector<std::wstring> PromptExistingLocalFilesAppFirst(HWND owner,
                                                                  const std::filesystem::path& initial,
                                                                  const std::wstring& title,
                                                                  bool allowMultiple,
                                                                  const std::wstring& confirmLabel = {}) {
    if (g_config.useNativeFileDialogs) {
        return PromptNativeExistingLocalPaths(owner, initial, title, /*requireDirectory=*/false,
                                             allowMultiple, {}, confirmLabel);
    }
    std::vector<std::wstring> picked =
        PromptLocalPathBrowser(owner, initial, title, /*requireDirectory=*/false, allowMultiple,
                               /*browseOnly=*/false, {}, nullptr, {}, confirmLabel);
    std::vector<std::wstring> results;
    for (const auto& item : picked) {
        std::filesystem::path selected(item);
        if (!ValidateExistingLocalPathForBrowser(owner, selected, title, /*requireDirectory=*/false)) {
            return {};
        }
        results.push_back(selected.wstring());
    }
    return results;
}

std::vector<std::wstring> PromptExistingLocalFolders(HWND owner,
                                                            const std::filesystem::path& initial,
                                                            const std::wstring& title,
                                                            bool allowMultiple,
                                                            const std::wstring& confirmLabel) {
    if (g_config.useNativeFileDialogs) {
        return PromptNativeExistingLocalPaths(owner, initial, title, /*requireDirectory=*/true,
                                             allowMultiple, {}, confirmLabel);
    }
    std::vector<std::wstring> picked =
        PromptLocalPathBrowser(owner, initial, title, /*requireDirectory=*/true, allowMultiple,
                               /*browseOnly=*/false, {}, nullptr, {}, confirmLabel);
    std::vector<std::wstring> results;
    for (const auto& item : picked) {
        std::filesystem::path selected(item);
        if (!ValidateExistingLocalPathForBrowser(owner, selected, title, /*requireDirectory=*/true)) {
            return {};
        }
        results.push_back(selected.wstring());
    }
    return results;
}
