// file: note_view/note_view_input_proc.cppinc
// Included by note_view_input.cppinc; contains NoteEditProc message handling.

// Enter normally produces WM_KEYDOWN followed by WM_CHAR. Handle Markdown
// list continuation at the key stage too, then consume that paired character
// message so input paths that do not reliably deliver WM_CHAR behave the same.
static bool g_noteSuppressNextAutoBulletEnterChar = false;

static const wchar_t* NoteInputLatencyAction(UINT msg, WPARAM wParam) {
    if (msg == WM_CHAR) {
        if (wParam == L'\b') return L"backspace-char";
        if (wParam == L'\r' || wParam == L'\n') return L"newline-char";
        return nullptr;
    }
    if (msg == WM_KEYDOWN) {
        if (wParam == VK_BACK) return L"backspace-key";
        if (wParam == VK_DELETE) return L"delete-key";
        if (wParam == VK_RETURN) return L"enter-key";
        if (wParam == VK_TAB) return L"tab-key";
    }
    return nullptr;
}

static const wchar_t* NoteFocusTraceMessageName(UINT msg) {
    switch (msg) {
    case WM_SETFOCUS: return L"set_focus";
    case WM_KILLFOCUS: return L"kill_focus";
    case WM_KEYDOWN: return L"key_down";
    case WM_CHAR: return L"char";
    case WM_PASTE: return L"paste";
    case WM_CUT: return L"cut";
    case WM_CLEAR: return L"clear";
    case WM_LBUTTONDOWN: return L"left_down";
    case WM_LBUTTONDBLCLK: return L"left_double";
    case WM_RBUTTONDOWN: return L"right_down";
    case WM_MBUTTONDOWN: return L"middle_down";
    default: return nullptr;
    }
}

class NoteInputLatencyTrace {
public:
    NoteInputLatencyTrace(HWND hwnd, UINT msg, WPARAM wParam)
        : m_hwnd(hwnd),
          m_msg(msg),
          m_wParam(wParam),
          m_action(NoteInputLatencyAction(msg, wParam)) {
        m_enabled = (m_action != nullptr) && preview_trace::IsEnabled();
        if (!m_enabled) return;
        m_startTick = preview_trace::TickNow();
        m_beforeRevision = CurrentEditRevision();
        m_saveRunning = IsSaveTransactionRunning();
        m_renderActive = IsNoteRenderActive();
        m_imeComposing = IsNoteImeComposing();
        SendMessageW(hwnd, EM_GETSEL,
                     reinterpret_cast<WPARAM>(&m_selStart),
                     reinterpret_cast<LPARAM>(&m_selEnd));
    }

    ~NoteInputLatencyTrace() {
        if (!m_enabled) return;
        DWORD selStart = 0;
        DWORD selEnd = 0;
        SendMessageW(m_hwnd, EM_GETSEL,
                     reinterpret_cast<WPARAM>(&selStart),
                     reinterpret_cast<LPARAM>(&selEnd));
        preview_trace::Append(
            L"NoteInputLatency",
            L"action=" + std::wstring(m_action) +
            L" msg=" + preview_trace::Message(m_msg) +
            L" wParam=" + std::to_wstring(static_cast<unsigned long long>(m_wParam)) +
            L" elapsed_ms=" + preview_trace::ElapsedMs(m_startTick) +
            L" saveRunning=" + preview_trace::Bool(m_saveRunning) +
            L" renderActive=" + preview_trace::Bool(m_renderActive) +
            L" ime=" + preview_trace::Bool(m_imeComposing) +
            L" revisionChanged=" + preview_trace::Bool(CurrentEditRevision() != m_beforeRevision) +
            L" selBefore=" + std::to_wstring(std::min(m_selStart, m_selEnd)) +
            L":" + std::to_wstring(std::max(m_selStart, m_selEnd)) +
            L" selAfter=" + std::to_wstring(std::min(selStart, selEnd)) +
            L":" + std::to_wstring(std::max(selStart, selEnd)));
    }

    NoteInputLatencyTrace(const NoteInputLatencyTrace&) = delete;
    NoteInputLatencyTrace& operator=(const NoteInputLatencyTrace&) = delete;

private:
    HWND m_hwnd = nullptr;
    UINT m_msg = 0;
    WPARAM m_wParam = 0;
    const wchar_t* m_action = nullptr;
    bool m_enabled = false;
    ULONGLONG m_startTick = 0;
    uint64_t m_beforeRevision = 0;
    bool m_saveRunning = false;
    bool m_renderActive = false;
    bool m_imeComposing = false;
    DWORD m_selStart = 0;
    DWORD m_selEnd = 0;
};

// Precision touchpads can send wheel deltas smaller than WHEEL_DELTA.  Keep
// the unconsumed fraction so rendered notes retain the device's continuous
// motion instead of being quantized to RichEdit's line-scroll steps.
static int s_noteVerticalWheelRemainder = 0;
// Touch input is handled separately from mouse selection.  These are kept at
// procedure scope so capture-loss can reliably cancel an interrupted drag.
static bool s_noteTouchPanning = false;
static UINT32 s_noteTouchPanPointerId = 0;
static POINT s_noteTouchPanAnchor = {0, 0};

struct NotePointerPresentationHit {
    std::optional<size_t> raw_index;
    // RichEdit transport coordinate for EM_SETSEL. It differs from raw_index
    // after CRLF and, during IME preedit, may be valid even where no
    // canonical source offset exists.
    std::optional<size_t> editor_index;
    // A persisted <link=...> target resolved from the immutable final frame.
    // It is deliberately separate from Markdown link targets: only this
    // legacy target is accepted by HandleLinkIdJump.
    std::optional<std::wstring> final_legacy_link_id;
    bool native_raw_surface = true;
};

// The final route accepts only coordinates proven against the current
// immutable TextCore/source-line map.  Legacy render mode retains its
// established raw-string conversion, but it must not leak into final input
// just because a final frame is being republished.
static std::optional<size_t> MapCanonicalNoteOffsetToEditorTransportForInput(
    HWND hWnd, size_t canonicalOffset) noexcept {
    if (FinalRenderRouteEnabled(hWnd)) {
        return TryMapFinalRouteCanonicalOffsetToRichEdit(hWnd, canonicalOffset);
    }
    return RawTextIndexToRichEditIndex(CurrentNoteSyntaxSource().raw, canonicalOffset);
}

static std::optional<size_t> MapEditorTransportToCanonicalNoteOffsetForInput(
    HWND hWnd, size_t richEditIndex) noexcept {
    if (FinalRenderRouteEnabled(hWnd)) {
        return TryMapFinalRouteRichEditIndexToCanonical(hWnd, richEditIndex);
    }
    return RichEditIndexToRawTextIndex(CurrentNoteSyntaxSource().raw, richEditIndex);
}

// A double-click must use the coordinate system of the text the user can
// actually see. A currently NativeRaw row belongs to RichEdit; a Structured
// row belongs to the render layout. In particular, do not use the structured
// hit test to reinterpret a raw <link=...> source row.
static NotePointerPresentationHit ResolveNotePointerPresentationHit(HWND hWnd,
                                                                     int clientX,
                                                                     int clientY) {
    NotePointerPresentationHit hit;
    note::NoteRenderFinalHit finalHit;
    if (TryGetFinalNoteRenderHit(hWnd, clientX, clientY, &finalHit)) {
        size_t editorIndex = 0;
        std::optional<size_t> canonicalIndex;
        if (MapFinalEditorOffsetToRichEdit(
                hWnd, finalHit.source_offset, &editorIndex, &canonicalIndex)) {
            hit.editor_index = editorIndex;
            hit.raw_index = canonicalIndex;
            if (finalHit.is_legacy_link_id && !finalHit.link_target.empty()) {
                hit.final_legacy_link_id = finalHit.link_target;
            }
            // A final RawPaint surface is still custom-painted; unlike the
            // old native raw rows it must keep final coordinates for a second
            // click, selection drag, and link hit testing.
            hit.native_raw_surface = false;
            return hit;
        }
    }

    // A visible final frame owns every pixel and every text coordinate.  Do
    // not fall back to either RichEdit or the retired structured cache when a
    // final hit cannot be resolved: their line heights can differ after a
    // table/math edit.  The caller treats this as a harmless miss.
    if (FinalFrameCanUseCustomPaint(hWnd)) {
        hit.native_raw_surface = false;
        return hit;
    }

    // Without a final frame the native editor owns the entire client.  This
    // is the sole fallback geometry and deliberately has no partial overlay
    // hit-test branch.
    const std::optional<size_t> nativeHit =
        HitTestNativeNoteRawPosition(hWnd, clientX, clientY);
    if (!nativeHit.has_value()) return hit;

    // EM_CHARFROMPOS reports RichEdit character indices. Convert through the
    // current source-line map in final fallback mode; a stale/missing map is
    // not a license to scan the old canonical string and guess a link range.
    const std::optional<size_t> nativeRawIndex =
        MapEditorTransportToCanonicalNoteOffsetForInput(hWnd, *nativeHit);
    hit.editor_index = *nativeHit;
    hit.raw_index = nativeRawIndex;
    return hit;
}

LRESULT CALLBACK NoteEditProc(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam) {
    ScopedNoteViewContextBinding viewContextBinding(hWnd);
    NoteInputLatencyTrace inputLatencyTrace(hWnd, msg, wParam);
    bool forgetViewContextAfterDefault = false;
    bool releaseOpeningFocusHoldAfterDefault = false;

    if (msg == WM_SETREDRAW) {
        auto& context = GetViewContext(hWnd);
        context.nativeRedrawRequested = wParam != FALSE;
        if (context.finalNativeRedrawDepth != 0) return 0;
        return CallWindowProcW(g_oldNoteProc, hWnd, msg, wParam, lParam);
    }
    if (msg == WM_PAINT && GetViewContext(hWnd).finalNativeRedrawDepth != 0) {
        // Native movement may synchronously request a repaint while its
        // replacement frame is private. The scope schedules the real paint
        // after completion; neither a stale frame nor native raw paints now.
        ValidateRect(hWnd, nullptr);
        return 0;
    }

    if (const wchar_t* eventName = NoteFocusTraceMessageName(msg)) {
        // Do not log the character itself: note content may be private.
        preview_trace::Append(
            L"NoteInputRoute",
            L"event=" + std::wstring(eventName) +
            L" keyCode=" + (msg == WM_KEYDOWN ? std::to_wstring(static_cast<unsigned long long>(wParam)) : L"redacted") +
            L" target=" + preview_trace::Window(hWnd) +
            L" focus=" + preview_trace::Window(GetFocus()));
        TraceCurrentNoteFocusState(L"note_input_entry");
    }

    if (BlockNoteEditInputDuringSave(hWnd, msg, wParam, lParam)) {
        preview_trace::Append(L"NoteInputRoute", L"blocked=save_transaction");
        return 0;
    }
    if (!EnsureDeferredNoteTargetForInputMessage(hWnd, msg, wParam)) {
        preview_trace::Append(L"NoteInputRoute", L"blocked=deferred_note_target");
        return 0;
    }
    if (!HasOpenNote()) {
        switch (msg) {
        case WM_LBUTTONDOWN:
        case WM_LBUTTONDBLCLK:
        case WM_RBUTTONDOWN:
        case WM_CONTEXTMENU:
        case WM_MBUTTONDOWN:
        case WM_XBUTTONDOWN:
            MaybeShowNoteOpenNotice(GetParent(hWnd));
            break;
        case WM_CHAR:
        case WM_KEYDOWN:
        case WM_PASTE:
        case WM_CUT:
        case WM_UNDO:
        case EM_REDO:
        case WM_CLEAR:
            if (msg == WM_CHAR || msg == WM_PASTE || msg == WM_CUT ||
                msg == WM_UNDO || msg == EM_REDO || msg == WM_CLEAR || msg == WM_KEYDOWN) {
                // WM_KEYDOWN is consumed before the paired WM_CHAR reaches us
                // while no note is open.  Notify here as well so keyboard
                // entry receives the same silent explanation as a click or
                // paste, with MaybeShowNoteOpenNotice providing throttling.
                if (msg == WM_CHAR || msg == WM_KEYDOWN || msg == WM_PASTE || msg == WM_CUT) {
                    MaybeShowNoteOpenNotice(GetParent(hWnd));
                }
                preview_trace::Append(L"NoteInputRoute", L"blocked=no_open_note");
                return 0;
            }
            break;
        default:
            break;
        }
    }
    if (IsNoteRenderSwitchInProgress()) {
        switch (msg) {
        case WM_ERASEBKGND:
            return 1;
        case WM_PAINT: {
            PAINTSTRUCT ps{};
            HDC hdc = BeginPaint(hWnd, &ps);
            RECT rc{};
            GetClientRect(hWnd, &rc);
            PaintNoteSwitchPlaceholder(hdc, rc);
            EndPaint(hWnd, &ps);
            return 0;
        }
        case WM_SIZE:
        case WM_WINDOWPOSCHANGED:
        case WM_CHAR:
        case WM_KEYDOWN:
        case WM_KEYUP:
        case WM_PASTE:
        case WM_CUT:
        case WM_UNDO:
        case WM_LBUTTONDOWN:
        case WM_LBUTTONUP:
        case WM_LBUTTONDBLCLK:
        case WM_RBUTTONDOWN:
        case WM_MBUTTONDOWN:
        case WM_MOUSEMOVE:
        case WM_IME_STARTCOMPOSITION:
        case WM_IME_ENDCOMPOSITION:
        case WM_IME_COMPOSITION:
            preview_trace::Append(L"NoteInputRoute", L"blocked=render_switch");
            return 0;
        default:
            break;
        }
    }
    // Normal mode never lets native IME input mutate the note. Protect the
    // direct subclass route as well as the application message loop.
    if (g_noteVimModeEnabled && g_noteNormalMode &&
        (msg == WM_IME_STARTCOMPOSITION || msg == WM_IME_COMPOSITION ||
         msg == WM_IME_ENDCOMPOSITION || msg == WM_IME_CHAR)) {
        DisableImeForNoteEdit(hWnd);
        return 0;
    }
    // Both native and handled keys may return without EN_CHANGE or a paired
    // WM_CHAR (Home/End, document boundaries, no-op deletes). Close the input
    // boundary on every return path, reusing only a proven current source.
    // Input owns completion; paint must never repair a withdrawn frame.
    const bool verticalKey = msg == WM_KEYDOWN &&
        (wParam == VK_UP || wParam == VK_DOWN || wParam == VK_PRIOR || wParam == VK_NEXT);
    const bool navigationKey = msg == WM_KEYDOWN &&
        (verticalKey || wParam == VK_LEFT || wParam == VK_RIGHT || wParam == VK_HOME || wParam == VK_END);
    const bool keepNavigationFrame = navigationKey && !g_noteImeComposing && FinalFrameCanUseCustomPaint(hWnd);
    const bool nativeSizeChanged = msg == WM_WINDOWPOSCHANGED && lParam != 0 &&
        (reinterpret_cast<const WINDOWPOS*>(lParam)->flags & SWP_NOSIZE) == 0;
    const bool batchGeometryRedraw = (msg == WM_SIZE || nativeSizeChanged) && FinalFrameCanUseCustomPaint(hWnd);
    const bool batchMutationRedraw = IsPotentialNoteTextMutationMessage(msg, wParam) &&
        FinalFrameCanUseCustomPaint(hWnd);
    const bool batchImeRedraw = (msg == WM_IME_STARTCOMPOSITION ||
        msg == WM_IME_COMPOSITION || msg == WM_IME_ENDCOMPOSITION) && FinalRenderRouteEnabled(hWnd);
    const bool pointerDrag = msg == WM_MOUSEMOVE && (wParam & MK_LBUTTON) != 0 &&
        (g_noteRenderSelecting || g_noteLineSelectionActive || g_noteNormalMouseDragActive);
    const bool batchPointerRedraw = (msg == WM_LBUTTONDOWN || msg == WM_LBUTTONDBLCLK ||
        msg == WM_LBUTTONUP || pointerDrag) && FinalFrameCanUseCustomPaint(hWnd);
    // Declared before completion: the replacement frame and caret must settle
    // before redraw is released, including handled keys and early returns.
    // WM_SIZE is nested inside RichEdit's WM_WINDOWPOSCHANGED default handler.
    // Keep that outer handler private too: it can move native pixels AFTER
    // the nested WM_SIZE already published the final frame. Pure moves borrow
    // no scope and do not relayout the note.
    ScopedFinalNoteNativeRedraw inputRedraw(hWnd,
        keepNavigationFrame || batchGeometryRedraw || batchMutationRedraw || batchImeRedraw || batchPointerRedraw);
    if ((msg == WM_KEYDOWN && !verticalKey) || msg == WM_CHAR || msg == WM_LBUTTONDOWN ||
        msg == WM_LBUTTONDBLCLK || msg == WM_IME_STARTCOMPOSITION || msg == WM_KILLFOCUS) {
        GetViewContext(hWnd).finalVerticalNavigation.reset();
    }
    struct ScopedNoteInputFrameCompletion {
        HWND window;
        bool refreshNavigation;
        std::shared_ptr<const note::NoteRenderFinalWin32AdapterFrame> initialFrame;
        ~ScopedNoteInputFrameCompletion() noexcept {
            if (!window || !IsWindow(window)) return;
            // A ticket left after synchronous native dispatch was not
            // accepted by EN_CHANGE. Never leave a no-op Backspace ticket
            // available for an unrelated later notification or save.
            if (g_expectedNoteTextEdit.active && g_expectedNoteTextEdit.hEdit == window) {
                g_expectedNoteTextEdit = {};
            }
            if (!FinalRenderRouteEnabled(window) ||
                (FinalFrameCanUseCustomPaint(window) && (!refreshNavigation ||
                 GetViewContext(window).finalRenderState.frame() != initialFrame))) return;
            try {
                RefreshFinalNoteRenderFrame(window);
            } catch (const std::exception&) {
                WithdrawFinalNoteRenderFrame(window);
                InvalidateRect(window, nullptr, FALSE);
            }
        }
    } inputFrameCompletion{msg == WM_CHAR || msg == WM_KEYDOWN ? hWnd : nullptr, keepNavigationFrame,
        keepNavigationFrame ? GetViewContext(hWnd).finalRenderState.frame() : nullptr};
    if (msg == WM_KEYDOWN) {
        // A navigation key at a source boundary can leave the offset unchanged
        // while still requesting that an off-screen caret become visible.
        GetViewContext(hWnd).finalRenderLastCaret.reset();
    }
    if (NoteInputMayInvalidateFinalFrame(msg, wParam) && !keepNavigationFrame) {
        // The old frame describes the editor state before this native event.
        // Keep only private structural continuity until the post-event
        // adapter can publish a replacement.
        WithdrawFinalNoteRenderFrame(hWnd);
    }
    if (IsNoteOpeningFocusVisualHoldActive()) {
        if (const wchar_t* eventName = NoteFocusTraceMessageName(msg)) {
            preview_trace::Append(
                L"NoteOpeningVisualHold",
                L"release_event=" + std::wstring(eventName) +
                L" keyCode=" + (msg == WM_KEYDOWN ? std::to_wstring(static_cast<unsigned long long>(wParam)) : L"redacted"));
        }
        switch (msg) {
        case WM_CHAR:
        case WM_KEYDOWN:
        case WM_PASTE:
        case WM_CUT:
        case WM_CLEAR:
            // The opening view is fully structured. Text input and keyboard
            // navigation then let the resolver expose only the active raw row
            // (or an atomic source block), never the whole note surface. A
            // pointer click releases below, after its structured hit test.
            EndNoteOpeningFocusVisualHold(hWnd);
            TraceCurrentNoteFocusState(L"opening_hold_released");
            break;
        default:
            break;
        }
    }
    switch (msg) {
    case WM_ERASEBKGND:
        return 1;
    case WM_SETCURSOR:
        if (LOWORD(lParam) == HTCLIENT &&
            reinterpret_cast<HWND>(wParam) == hWnd) {
            if (NoteLineSelectionHitBoxAtCursor(hWnd)) {
                SetCursor(LoadCursor(nullptr, IDC_ARROW));
                return TRUE;
            }
            if ((GetKeyState(VK_CONTROL) & 0x8000) != 0 || g_ctrlRenderSelecting || g_ctrlRenderSelected) {
                SetCursor(LoadCursor(nullptr, IDC_IBEAM));
                return TRUE;
            }
        }
        break;
    case WM_PAINT: {
        if (UpdateNoteVisualAssistMargins(hWnd, false)) {
            UpdateNoteFormatRect(hWnd);
        }
        ++GetViewContext(hWnd).noteClientPaintCount;
        PAINTSTRUCT ps{};
        HDC hdc = BeginPaint(hWnd, &ps);

        RECT rc{};
        GetClientRect(hWnd, &rc);
        int w = rc.right - rc.left;
        int h = rc.bottom - rc.top;
        HDC memDC = nullptr;
        HBITMAP memBmp = nullptr;
        HGDIOBJ oldBmp = nullptr;

        HDC paintDC = hdc;

        const bool focused = (GetFocus() == hWnd);
        if (focused) {
            SyncNativeCaretToRenderState(hWnd, false);
        }
        // Hide only around the blit, with one matching Show on the same
        // caret. The final painter never adds a second persistent caret.
        const bool caretHiddenForPaint = focused && HideCaret(hWnd) != FALSE;

        if (w > 0 && h > 0) {
            memDC = CreateCompatibleDC(hdc);
            if (memDC) {
                memBmp = CreateCompatibleBitmap(hdc, w, h);
                if (memBmp) {
                    oldBmp = SelectObject(memDC, memBmp);
                    paintDC = memDC;
                } else {
                    DeleteDC(memDC);
                    memDC = nullptr;
                }
            }
        }

        // Paint failure is allowed to have emitted a prefix of the final
        // frame.  Keep the background reset in one local operation so the
        // whole-native outcome below can discard that partial output before
        // asking RichEdit to paint its sole owner surface.
        const auto paintNoteBackground = [&](HDC target) {
            GetViewContext(hWnd).currentLineHighlightPainted = false;
            if (g_hThemeNoteBrush) {
                FillRect(target, &rc, g_hThemeNoteBrush);
                return;
            }
            HBRUSH brush = CreateSolidBrush(g_noteBgColor);
            if (!brush) return;
            FillRect(target, &rc, brush);
            DeleteObject(brush);
        };
        paintNoteBackground(paintDC);

        // There are exactly two paint outcomes. A current final frame paints
        // every glyph (including RawPaint rows) itself. Any failed/missing
        // frame delegates the whole client to RichEdit. The legacy clipped
        // overlay is intentionally not an intermediate third outcome.
        int savedOverlayDc = SaveDC(paintDC);
        if (savedOverlayDc != 0) {
            SetMapMode(paintDC, MM_TEXT);
            SetWindowOrgEx(paintDC, 0, 0, nullptr);
            SetViewportOrgEx(paintDC, 0, 0, nullptr);
            SelectClipRgn(paintDC, nullptr);
            IntersectClipRect(paintDC, rc.left, rc.top, rc.right, rc.bottom);
            SetTextAlign(paintDC, TA_LEFT | TA_TOP | TA_NOUPDATECP);
        }
        const bool finalPainted =
            !(g_draggingLeft || g_draggingRight || g_draggingHoriz ||
              g_draggingLeftTop || g_draggingLeftMid) &&
            TryPaintFinalNoteRenderFrame(hWnd, paintDC);
        if (!finalPainted) {
            ++GetViewContext(hWnd).noteNativeFallbackPaintCount;
            // `frame->Paint` is transactional in ownership, not in GDI
            // pixels: an API failure could happen after it drew a row. Erase
            // every such pixel before native RichEdit becomes the single
            // owner, otherwise high table/math rows can leave fragments.
            paintNoteBackground(paintDC);
            const auto& context = GetViewContext(hWnd);
            if (context.finalNativeTextOrigin.x != 0 || context.finalNativeTextOrigin.y != 0) {
                (void)ApplyFinalNoteNativeFallbackFormatRect(hWnd);
            }
            DrawNoteCurrentLineHighlight(hWnd, paintDC, true);
            PaintNativeNoteClient(hWnd, paintDC);
            DrawNoteEditVisualAssistOverlay(hWnd, paintDC);
        }
        if (savedOverlayDc != 0) {
            RestoreDC(paintDC, savedOverlayDc);
        }

        if (paintDC != hdc) {
            BitBlt(hdc, 0, 0, w, h, paintDC, 0, 0, SRCCOPY);
        }

        if (memDC) {
            SelectObject(memDC, oldBmp);
            DeleteObject(memBmp);
            DeleteDC(memDC);
        }

        if (caretHiddenForPaint) (void)ShowCaret(hWnd);
        if (focused) SyncNativeCaretToRenderState(hWnd, false);

        EndPaint(hWnd, &ps);
        return 0;
    }
    case WM_IME_REQUEST:
        if (wParam == IMR_QUERYCHARPOSITION && FinalRenderRouteEnabled(hWnd) &&
            (GetViewContext(hWnd).imeNativeDispatchInProgress ||
             (GetViewContext(hWnd).finalNativeRedrawDepth != 0 && !FinalFrameCanUseCustomPaint(hWnd)))) {
            // A private dispatch has not published its replacement geometry.
            // Refuse without altering the query; never delegate it to the
            // hidden RichEdit transport and briefly move the candidate list.
            return FALSE;
        }
        if (wParam == IMR_QUERYCHARPOSITION && FinalFrameCanUseCustomPaint(hWnd)) {
            const bool answered = TryFillFinalNoteImeCharacterPosition(
                hWnd, reinterpret_cast<IMECHARPOSITION*>(lParam));
            if (preview_trace::IsEnabled()) {
                preview_trace::Append(L"NoteImeCharacterPosition",
                    L"final=1 answered=" + std::to_wstring(answered));
            }
            return answered ? TRUE : FALSE;
        }
        break;
    case WM_IME_NOTIFY: {
        const DWORD lists = static_cast<DWORD>(lParam) & 0x0f;
        if (wParam == IMN_OPENCANDIDATE || wParam == IMN_CHANGECANDIDATE) {
            GetViewContext(hWnd).imeCandidateListMask |= lists;
        } else if (wParam == IMN_CLOSECANDIDATE) {
            GetViewContext(hWnd).imeCandidateListMask &= ~lists;
        }
        const LRESULT result = CallWindowProcW(g_oldNoteProc, hWnd, msg, wParam, lParam);
        // Nested notifications observe native provisional geometry. The outer
        // IME event owns one final caret/candidate sync after native dispatch.
        if (GetViewContext(hWnd).imeNativeDispatchInProgress) return result;
        // RichEdit's IME default handler can reset the system caret as well
        // as the candidate request. Restore final glyph geometry before any
        // candidate/assistive observer reads it; do not wait for WM_PAINT.
        // This also covers synchronous SETCOMPOSITIONWINDOW/SETCANDIDATEPOS
        // notifications caused by our setters (no candidate-sync recursion).
        SyncNativeCaretToRenderState(hWnd);
        if (wParam == IMN_OPENCANDIDATE || wParam == IMN_CHANGECANDIDATE) {
            // Keep native candidate selection/appearance. Correct placement
            // only after its default notification handler has finished.
            SyncNoteImeCandidateWindowToCaret(hWnd, static_cast<DWORD>(lParam));
        }
        return result;
    }
    case WM_IME_STARTCOMPOSITION: {
        MaybeReleaseNoteChangeSuppression(hWnd);
        EndNoteOpeningFocusVisualHold(hWnd);
        AdvanceNoteImePresentationPhaseForWindow(
            hWnd, note::NoteImePresentationEvent::StartComposition);
        g_noteImeCompositionRequiresWholeViewFallback = false;
        BeginNoteImeCompositionPresentationAnchor(hWnd);
        BeginFinalNoteImePreedit(hWnd);
        if (g_hBottomNote) InvalidateRect(g_hBottomNote, nullptr, FALSE);
        LRESULT res = DispatchNoteImeToNative(hWnd, msg, wParam, lParam);
        // No COMPSTR exists yet. Preserve the canonical selection, including
        // selected text, instead of displaying an empty replacement or a
        // whole-native frame between START and the first composition update.
        // Publish only if native dispatch retained the bound text/selection.
        RefreshFinalNoteRenderFrame(hWnd);
        InvalidateRect(hWnd, nullptr, FALSE);
        SyncNoteImeCandidateWindowToCaret(hWnd);
        return res;
    }
    case WM_IME_ENDCOMPOSITION: {
        MaybeReleaseNoteChangeSuppression(hWnd);
        AdvanceNoteImePresentationPhaseForWindow(
            hWnd, note::NoteImePresentationEvent::EndComposition);
        if (g_hBottomNote) InvalidateRect(g_hBottomNote, nullptr, FALSE);
        LRESULT res = DispatchNoteImeToNative(hWnd, msg, wParam, lParam);
        ClearNoteImeCompositionPresentationAnchor(hWnd);
        EndFinalNoteImePreedit(hWnd);
        FinalizeNoteImeCanonicalText(hWnd);
        // A cancelled composition has no EN_CHANGE; rebuild the normal
        // selection frame here rather than retaining an obsolete preedit.
        RefreshFinalNoteRenderFrame(hWnd);
        InvalidateRect(hWnd, nullptr, FALSE);
        // The default procedure has now accepted (or cancelled) the preedit.
        // Request markup processing only from that canonical post-IME state.
        PostMessageW(GetParent(hWnd), kMsgNoteOverlayUpdate, 1,
                     static_cast<LPARAM>(CurrentEditRevision()));
        CompletePendingBottomNoteRenderToggleAfterIme();
        return res;
    }
    case WM_IME_COMPOSITION: {
        MaybeReleaseNoteChangeSuppression(hWnd);
        std::wstring imeResult;
        note::NoteImePreeditPayload composition;
        const bool hasResult = (lParam & GCS_RESULTSTR) != 0;
        const bool hasContinuation = hasResult && (lParam & GCS_COMPSTR) != 0;
        const bool cancelledComposition = lParam == 0;
        const bool havePreeditSnapshot = (!hasResult || hasContinuation) && !cancelledComposition &&
            GetNoteImeCompositionSnapshot(hWnd, &composition, hasContinuation ? &imeResult : nullptr);
        if (hasContinuation) {
            if (!GetViewContext(hWnd).finalImePreedit.active()) BeginFinalNoteImePreedit(hWnd);
            // Explicit COMPSTR in the same result event is a continuing
            // preedit, not a residual IMM poll. Hold nested native EN_CHANGE
            // until its result-only canonical proposal is proven below.
            AdvanceNoteImePresentationPhaseForWindow(hWnd, note::NoteImePresentationEvent::StartComposition);
        }
        if (cancelledComposition) {
            // No change flags means cancellation, not an attribute-only
            // update. Do not resurrect retained IMM text from this event.
            AdvanceNoteImePresentationPhaseForWindow(
                hWnd, note::NoteImePresentationEvent::CancelComposition);
            EndFinalNoteImePreedit(hWnd);
        }
        if (havePreeditSnapshot && !composition.text.empty()) {
            // Normalize this event before RichEdit can emit EN_CHANGE. A
            // preedit resumed after empty text must not become canonical just
            // because the preceding IMM observation temporarily looked idle.
            AdvanceNoteImePresentationPhaseForWindow(
                hWnd, note::NoteImePresentationEvent::ObservedCompositionText);
        }
        if (hasResult && !hasContinuation) {
            (void)GetNoteImeResultString(hWnd, lParam, &imeResult);
        }
        if (hasResult && !hasContinuation) {
            // The result is canonical input, even when this IME leaves
            // GCS_COMPSTR populated until WM_IME_END. Transition before the
            // default procedure. The scoped native dispatch holds nested
            // EN_CHANGE until the final outcome is accepted below.
            AdvanceNoteImePresentationPhaseForWindow(
                hWnd, note::NoteImePresentationEvent::ResultCommitted);
            EndFinalNoteImePreedit(hWnd);
            if (g_hBottomNote) InvalidateRect(g_hBottomNote, nullptr, FALSE);
        }
        LRESULT res = DispatchNoteImeToNative(hWnd, msg, wParam, lParam);
        if (hasContinuation) {
            // Exactly one native dispatch. Never split RichEdit's message or
            // reconcile its complete provisional text as a canonical result.
            if (!havePreeditSnapshot || !AcceptNoteImeResultWithContinuation(hWnd, imeResult, composition)) {
                SuspendFinalNoteImePreedit(hWnd);
                ClearNoteImeCompositionPresentationAnchor(hWnd);
            }
            if (IsNoteImeComposing()) SyncNoteImeCandidateWindowToCaret(hWnd);
            return res;
        }
        if (hasResult) {
            ClearNoteImeCompositionPresentationAnchor(hWnd);
            FinalizeNoteImeCanonicalText(hWnd);
            MoveNoteCaretIntoCommittedFullWidthParenPair(hWnd, imeResult);
            InvalidateRect(hWnd, nullptr, FALSE);
            // Never parse or decorate the provisional GCS_COMPSTR. The queued
            // request observes the result after RichEdit and EN_CHANGE have
            // published the canonical edit revision.
            PostMessageW(GetParent(hWnd), kMsgNoteOverlayUpdate, 1,
                         static_cast<LPARAM>(CurrentEditRevision()));
            RefreshFinalNoteRenderFrame(hWnd);
            CompletePendingBottomNoteRenderToggleAfterIme();
        } else {
            if (cancelledComposition) {
                ClearNoteImeCompositionPresentationAnchor(hWnd);
                FinalizeNoteImeCanonicalText(hWnd);
            } else if (havePreeditSnapshot) {
                UpdateNoteImeCompositionPresentationAnchor(hWnd, composition.text);
                UpdateFinalNoteImePreedit(hWnd, composition);
            } else {
                // Suspend the payload, not the canonical start anchor. A
                // later complete IMM snapshot can restore the local frame.
                SuspendFinalNoteImePreedit(hWnd);
            }
            RefreshFinalNoteRenderFrame(hWnd);
            InvalidateRect(hWnd, nullptr, FALSE);
            if (cancelledComposition) CompletePendingBottomNoteRenderToggleAfterIme();
        }
        if (IsNoteImeComposing()) {
            SyncNoteImeCandidateWindowToCaret(hWnd);
        }
        return res;
    }
    case WM_GETDLGCODE: {
        LRESULT res = CallWindowProcW(g_oldNoteProc, hWnd, msg, wParam, lParam);
        return res | DLGC_WANTTAB | DLGC_WANTARROWS;
    }
    case WM_CHAR: {
        MaybeReleaseNoteChangeSuppression(hWnd);
        if (g_noteSuppressNextAutoBulletEnterChar && (wParam == L'\r' || wParam == L'\n')) {
            g_noteSuppressNextAutoBulletEnterChar = false;
            return 0;
        }
        if (g_pendingCtrlInsertNavChar != 0) {
            const wchar_t ch = static_cast<wchar_t>(wParam);
            const wchar_t suppressed = g_pendingCtrlInsertNavChar;
            g_pendingCtrlInsertNavChar = 0;
            if (ch == suppressed) {
                return 0;
            }
        }
        if (g_noteVimModeEnabled && g_noteNormalMode) {
            if ((GetKeyState(VK_CONTROL) & 0x8000) != 0 &&
                (wParam == L'\b' || wParam == L'\n' || wParam == 0x0B || wParam == 0x0C)) {
                return 0;
            }
            HWND owner = (g_hMainWnd && IsWindow(g_hMainWnd)) ? g_hMainWnd : GetParent(hWnd);
            wchar_t ch = static_cast<wchar_t>(wParam);
            if (HandleNoteNormalModeChar(owner, ch)) return 0;
            return 0;
        }
        if (wParam == L'\t') {
            return 0;
        }
        if (wParam == L'\n' && !g_noteImeComposing) {
            return 0;
        }
        if (g_noteSearchHitActive) {
            ClearSearchHitHighlight(false);
        }
        if (!g_noteImeComposing && TryHandleNoteAutoPairBracket(hWnd, static_cast<wchar_t>(wParam))) {
            return 0;
        }
        if (wParam == L'\r' && !g_noteImeComposing) {
            if (TryHandleAutoBulletEnter(hWnd)) {
                return 0;
            }
        }
        if (wParam == L'\b' && !g_noteImeComposing) {
            if (TryHandleAutoBulletPrefixDelete(hWnd, VK_BACK)) {
                return 0;
            }
            if (TryHandleLeadingTabStopBackspace(hWnd)) {
                return 0;
            }
        }
        const bool immediateBackspaceRefresh =
            (wParam == L'\b') && RequiresImmediateNoteContentRefreshForDelete(hWnd, VK_BACK);

        if (!g_noteImeComposing) {
            DWORD selStart = 0;
            DWORD selEnd = 0;
            SendMessageW(hWnd, EM_GETSEL,
                         reinterpret_cast<WPARAM>(&selStart),
                         reinterpret_cast<LPARAM>(&selEnd));
            DWORD start = std::min(selStart, selEnd);
            if (wParam == L'\b') {
                if (selStart != selEnd) {
                    RegisterExpectedNoteTextEdit(hWnd, selStart, selEnd, L"", start, start);
                } else if (selStart > 0) {
                    const note::Span span = PreviousNoteEditorTextUnit(hWnd, selStart);
                    if (span.start != span.end) {
                        RegisterExpectedNoteTextEdit(
                            hWnd, static_cast<DWORD>(span.start.value),
                            static_cast<DWORD>(span.end.value), L"",
                            static_cast<DWORD>(span.start.value),
                            static_cast<DWORD>(span.start.value));
                    }
                }
            } else if (wParam == L'\r') {
                RegisterExpectedNoteTextEdit(hWnd, selStart, selEnd, L"\r\n",
                                             start + 1, start + 1);
            } else if (wParam >= 32) {
                std::wstring inserted(1, static_cast<wchar_t>(wParam));
                RegisterExpectedNoteTextEdit(hWnd, selStart, selEnd, inserted,
                                             start + 1, start + 1,
                                             /*allowCoalesce=*/true);
            }
        }

        const uint64_t beforeDefaultEditRevision = CurrentEditRevision();
        const bool structuralEdit = (wParam == L'\r' || wParam == L'\n' || immediateBackspaceRefresh);
        const bool manageRedraw = structuralEdit && !g_noteImeComposing && !IsNoteRenderSwitchInProgress();

        if (manageRedraw) {
            SendMessageW(hWnd, WM_SETREDRAW, FALSE, 0);
        }

        // Execute default processing first to apply text changes
        LRESULT res = CallWindowProcW(g_oldNoteProc, hWnd, msg, wParam, lParam);

        if (manageRedraw) {
            SendMessageW(hWnd, WM_SETREDRAW, TRUE, 0);
            RedrawWindow(hWnd, nullptr, nullptr, RDW_INVALIDATE | RDW_NOERASE);
        }

        // EN_CHANGE records the dirty edit and refreshes render state directly. For structural edits
        // (such as inserting a newline), flush overlay and line cache synchronously so the exited line renders immediately.
        if (structuralEdit && !g_noteImeComposing) {
            SetNoteTyping(false);
            RecomputeMathFromNote();
        } else if (structuralEdit && CurrentEditRevision() == beforeDefaultEditRevision) {
            RequestNoteContentRefreshAfterEdit(hWnd);
        }
        SyncRenderDrivenNoteInputUi(hWnd, msg);
        return res; // Return early, skipping default CallWindowProcW at end of function
    }
    case WM_KEYDOWN: {
        MaybeReleaseNoteChangeSuppression(hWnd);
        g_pendingCtrlInsertNavChar = 0;
        
        bool ctrlDown = (GetKeyState(VK_CONTROL) & 0x8000) != 0;
        bool altDown = (GetKeyState(VK_MENU) & 0x8000) != 0;
        bool shiftDown = (GetKeyState(VK_SHIFT) & 0x8000) != 0;

        const ULONGLONG ignoreUntil = g_ignoreNextLeftKeyUntilTick;
        if (ignoreUntil != 0) {
            if (!g_config.fullWidthParenCancelNextLeft || GetTickCount64() >= ignoreUntil) {
                g_ignoreNextLeftKeyUntilTick = 0;
            } else if (wParam == VK_LEFT && !ctrlDown && !altDown && !shiftDown) {
                g_ignoreNextLeftKeyUntilTick = 0;
                return 0;
            }
        }
        if ((wParam == 'S' || wParam == 's') && (ctrlDown || altDown)) {
            preview_trace::Append(
                L"CtrlSNote",
                L"key hwnd=" + preview_trace::Window(hWnd) +
                L" parent=" + preview_trace::Window(GetParent(hWnd)) +
                L" focus=" + preview_trace::Window(GetFocus()) +
                L" ctrl=" + preview_trace::Bool(ctrlDown) +
                L" alt=" + preview_trace::Bool(altDown) +
                L" shift=" + preview_trace::Bool(shiftDown) +
                L" normalMode=" + preview_trace::Bool(g_noteNormalMode) +
                L" cmdline=" + preview_trace::Bool(g_noteCmdlineActive) +
                L" ime=" + preview_trace::Bool(g_noteImeComposing));
        }
        if (wParam == VK_ESCAPE && !IsNoteImeComposing()) {
            HWND owner = g_hMainWnd ? g_hMainWnd : GetParent(hWnd);
            SendMessageW(owner, WM_KEYDOWN, VK_ESCAPE, lParam);
            return 0;
        }
        if (g_noteVimModeEnabled && g_noteNormalMode) {
            if (g_noteCmdlineActive) return 0;
            HWND owner = (g_hMainWnd && IsWindow(g_hMainWnd)) ? g_hMainWnd : GetParent(hWnd);
            if (ctrlDown && !altDown && !shiftDown) {
                if (HandlePaneDirectionalNavigation(owner, PaneNavContext::NotePane, hWnd, wParam)) {
                    // Pane switching can leave Normal before its translated
                    // Ctrl+h/j/k/l character arrives at this HWND.
                    g_pendingCtrlInsertNavChar = static_cast<wchar_t>(wParam - 'A' + 1);
                    return 0;
                }
            }
            switch (wParam) {
            case VK_LEFT:
                HandleNoteNormalModeChar(owner, L'h');
                return 0;
            case VK_RIGHT:
                HandleNoteNormalModeChar(owner, L'l');
                return 0;
            case VK_UP:
                HandleNoteNormalModeChar(owner, L'k');
                return 0;
            case VK_DOWN:
                HandleNoteNormalModeChar(owner, L'j');
                return 0;
            case VK_HOME:
                HandleNoteNormalModeChar(owner, L'0');
                return 0;
            case VK_END:
                HandleNoteNormalModeChar(owner, L'$');
                return 0;
            case VK_ESCAPE:
            case VK_RETURN:
            case VK_TAB:
            case VK_BACK:
            case VK_DELETE:
            case VK_PRIOR:
            case VK_NEXT:
                return 0;
            default:
                break;
            }
        }
        if (wParam == VK_RETURN && !ctrlDown && !altDown && !shiftDown && !g_noteImeComposing &&
            TryHandleAutoBulletEnter(hWnd)) {
            g_noteSuppressNextAutoBulletEnterChar = true;
            return 0;
        }
        if (g_noteSearchHitActive) {
            if (wParam == VK_LEFT || wParam == VK_RIGHT || wParam == VK_UP || wParam == VK_DOWN ||
                wParam == VK_HOME || wParam == VK_END || wParam == VK_PRIOR || wParam == VK_NEXT ||
                wParam == VK_DELETE) {
                ClearSearchHitHighlight(false);
            }
        }
        bool undoRedoTextChanged = false;
        const uint64_t beforeUndoRedoRevision = CurrentEditRevision();
        if (HandleNoteCtrlUndoRedo(hWnd, wParam, &undoRedoTextChanged)) {
            if (undoRedoTextChanged) {
                MarkNoteUndoRedoTextChangedForSave(hWnd, beforeUndoRedoRevision);
                RequestNoteContentRefreshAfterEdit(hWnd);
            } else {
                UpdateNotePreviewFromEdit(hWnd);
                InvalidateRect(hWnd, nullptr, FALSE);
                if (g_hBottomMath) {
                    InvalidateRect(g_hBottomMath, nullptr, FALSE);
                }
            }
            SyncRenderDrivenNoteInputUi(hWnd, msg);
            return 0;
        }
        if (!g_noteNormalMode && !g_noteImeComposing) {
            if (ctrlDown && !altDown && shiftDown && (wParam == 'I')) {
                g_noteShowInvisibleChars = !g_noteShowInvisibleChars;
                InvalidateRect(hWnd, nullptr, FALSE);
                ShowSoftNotice(GetParent(hWnd),
                               g_noteShowInvisibleChars
                                   ? (localization::Text(L"note.input_proc.71b21a9d8c42"))
                                   : (localization::Text(L"note.input_proc.f9bb827b8766")));
                return 0;
            }
            if (ctrlDown && !altDown && shiftDown && (wParam == 'N')) {
                g_noteShowLineNumbers = !g_noteShowLineNumbers;
                UpdateNoteFormatRect(hWnd);
                InvalidateRect(hWnd, nullptr, FALSE);
                ShowSoftNotice(GetParent(hWnd),
                               g_noteShowLineNumbers
                                   ? (localization::Text(L"note.input_proc.0b87f3cdc2ee"))
                                   : (localization::Text(L"note.input_proc.c4b6cd9fc5d9")));
                return 0;
            }
            if (ctrlDown && !altDown && !shiftDown && (wParam == 'F')) {
                (void)BeginNoteSearchFromInsertMode(hWnd, false);
                return 0;
            }
            if (ctrlDown && !altDown && shiftDown && (wParam == 'F')) {
                (void)BeginNoteSearchFromInsertMode(hWnd, true);
                return 0;
            }
            if (wParam == VK_F3 && !ctrlDown && !altDown) {
                if (g_noteLastSearchPattern.empty()) {
                    (void)BeginNoteSearchFromInsertMode(hWnd, shiftDown);
                } else if (!JumpToNoteSearchResult(GetParent(hWnd), g_noteLastSearchPattern,
                                                   !shiftDown, false, true)) {
                    ShowSoftNotice(GetParent(hWnd),
                                   localization::Text(L"note.input_proc.ded3b61668bf"),
                                   SoftNoticeKind::Warning);
                }
                return 0;
            }
            if (ctrlDown && !altDown && !shiftDown && (wParam == 'H')) {
                if (ReplaceCurrentNoteSearchHit(hWnd)) return 0;
                (void)BeginNoteSearchFromInsertMode(hWnd, false);
                return 0;
            }
            if (altDown && !ctrlDown && !shiftDown && (wParam == VK_UP || wParam == VK_DOWN)) {
                if (MoveSelectedNoteLines(hWnd, (wParam == VK_UP) ? -1 : 1)) return 0;
            }
            if (ctrlDown && !altDown && !shiftDown && (wParam == 'D')) {
                if (DuplicateSelectedNoteLines(hWnd)) return 0;
            }
            if (ctrlDown && !altDown && !shiftDown && (wParam == 'L')) {
                if (SelectCurrentNoteLine(hWnd)) return 0;
            }
            if (ctrlDown && !altDown && !shiftDown && (wParam == 'J')) {
                if (JoinCurrentNoteLineWithNext(hWnd)) return 0;
            }
            if (DeleteNoteWordAroundCaret(hWnd, wParam)) {
                return 0;
            }
            if (MoveNoteCaretToSmartHomeEnd(hWnd, wParam)) {
                return 0;
            }
        }
        if (ctrlDown && !altDown && !g_noteImeComposing) {
            if (TryHandleMarkdownShortcut(hWnd, wParam, shiftDown)) {
                return 0;
            }
        }
        if (!g_noteNormalMode) {
            WPARAM navKey = 0;
            wchar_t suppressedChar = 0;
            if (ResolveCtrlInsertNavKey(hWnd, wParam, &navKey, &suppressedChar)) {
                g_pendingCtrlInsertNavChar = suppressedChar;
                if (g_noteImeComposing) {
                    ForwardImeNavigationKey(hWnd, navKey);
                    return 0;
                }
                InvalidateRect(hWnd, nullptr, FALSE);
                if (MoveNoteCaretInFinalVerticalLayout(hWnd, navKey, lParam, shiftDown)) return 0;
                MoveEditCaretForInsertNav(hWnd, navKey);
                return 0;
            }
        }
        if (wParam == VK_TAB && !g_noteImeComposing) {
            if ((GetKeyState(VK_CONTROL) & 0x8000) || (GetKeyState(VK_MENU) & 0x8000)) {
                break;
            }
            if (shiftDown) {
                if (TryOutdentSelectedMarkdownLines(hWnd)) {
                    return 0;
                }
            } else if (TryIndentSelectedMarkdownLines(hWnd)) {
                return 0;
            } else if (TryHandleCurrentMarkdownListTab(hWnd)) {
                return 0;
            }
            {
                DWORD selStart = 0;
                DWORD selEnd = 0;
                SendMessageW(hWnd, EM_GETSEL,
                             reinterpret_cast<WPARAM>(&selStart),
                             reinterpret_cast<LPARAM>(&selEnd));
                DWORD start = std::min(selStart, selEnd);
                RegisterExpectedNoteTextEdit(hWnd, selStart, selEnd, L"    ",
                                             start + 4, start + 4);
            }
            SendMessageW(hWnd, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(L"    "));
            SendMessageW(hWnd, EM_SCROLLCARET, 0, 0);
            return 0;
        }
        if ((wParam == VK_LEFT || wParam == VK_RIGHT) && !g_noteImeComposing) {
            if (GetKeyState(VK_MENU) & 0x8000) {
                break;
            }
            if (ctrlDown) {
                if (MoveNoteCaretByWord(hWnd, wParam == VK_RIGHT, shiftDown)) {
                    return 0;
                }
            }
            DWORD selStart = 0, selEnd = 0;
            SendMessageW(hWnd, EM_GETSEL,
                         reinterpret_cast<WPARAM>(&selStart),
                         reinterpret_cast<LPARAM>(&selEnd));
            if (selStart == selEnd) {
                if (wParam == VK_LEFT && selStart == 0) {
                    InvalidateRect(hWnd, nullptr, FALSE);
                    SendMessageW(hWnd, EM_SCROLLCARET, 0, 0);
                    return 0;
                }
                if (wParam == VK_RIGHT) {
                    const size_t len = ui::GetEditTextLengthForNavigation(hWnd);
                    if (static_cast<size_t>(selStart) >= len) {
                        InvalidateRect(hWnd, nullptr, FALSE);
                        SendMessageW(hWnd, EM_SCROLLCARET, 0, 0);
                        return 0;
                    }
                }
            }
        }
        if (verticalKey && !ctrlDown && !altDown &&
            MoveNoteCaretInFinalVerticalLayout(hWnd, wParam, lParam, shiftDown)) return 0;
        if (verticalKey) GetViewContext(hWnd).finalVerticalNavigation.reset();
        if ((wParam == VK_UP || wParam == VK_PRIOR) && !g_noteImeComposing) {
            if (ctrlDown && !altDown && wParam == VK_UP) {
                if (MoveNoteCaretByParagraph(hWnd, false, shiftDown)) {
                    return 0;
                }
            }
            if ((GetKeyState(VK_SHIFT) & 0x8000) || (GetKeyState(VK_CONTROL) & 0x8000) ||
                (GetKeyState(VK_MENU) & 0x8000)) {
                break;
            }
            DWORD selStart = 0, selEnd = 0;
            SendMessageW(hWnd, EM_GETSEL,
                         reinterpret_cast<WPARAM>(&selStart),
                         reinterpret_cast<LPARAM>(&selEnd));
            if (selStart == selEnd) {
                int caretLine = static_cast<int>(SendMessageW(hWnd, EM_LINEFROMCHAR, selStart, 0));
                if (caretLine == 0) {
                    if (wParam == VK_UP) {
                        LRESULT lineStart = SendMessageW(hWnd, EM_LINEINDEX, 0, 0);
                        if (lineStart < 0) lineStart = 0;
                        SendMessageW(hWnd, EM_SETSEL, lineStart, lineStart);
                    }
                    InvalidateRect(hWnd, nullptr, FALSE);
                    SendMessageW(hWnd, EM_SCROLLCARET, 0, 0);
                    return 0;
                }
            }
        }
        if (wParam == VK_DOWN && !g_noteImeComposing) {
            if (ctrlDown && !altDown) {
                if (MoveNoteCaretByParagraph(hWnd, true, shiftDown)) {
                    return 0;
                }
            }
            DownKeyLastLineAction action = ParseDownKeyLastLineAction(g_config.downKeyLastLineAction);
            if ((GetKeyState(VK_SHIFT) & 0x8000) || (GetKeyState(VK_CONTROL) & 0x8000) ||
                (GetKeyState(VK_MENU) & 0x8000)) {
                break;
            }
            DWORD selStart = 0, selEnd = 0;
            SendMessageW(hWnd, EM_GETSEL,
                         reinterpret_cast<WPARAM>(&selStart),
                         reinterpret_cast<LPARAM>(&selEnd));
            if (selStart != selEnd) break;
            int lineCount = static_cast<int>(SendMessageW(hWnd, EM_GETLINECOUNT, 0, 0));
            if (lineCount <= 0) lineCount = 1;
            int caretLine = static_cast<int>(SendMessageW(hWnd, EM_LINEFROMCHAR, selStart, 0));
            if (caretLine == lineCount - 1) {
                // suppress key-repeat "ding" when holding down the key on the last line
                if (lParam & 0x40000000) return 0;
                if (action == DownKeyLastLineAction::InsertNewline) {
                    LRESULT lineStart = SendMessageW(hWnd, EM_LINEINDEX, lineCount - 1, 0);
                    if (lineStart < 0) lineStart = 0;
                    LRESULT lineLen = SendMessageW(hWnd, EM_LINELENGTH, static_cast<WPARAM>(lineStart), 0);
                    if (lineLen < 0) lineLen = 0;
                    if (lineLen == 0) {
                        InvalidateRect(hWnd, nullptr, FALSE);
                        SendMessageW(hWnd, EM_SCROLLCARET, 0, 0);
                        return 0;
                    }
                    int textLen = GetWindowTextLengthW(hWnd);
                    if (textLen < 0) textLen = 0;
                    SendMessageW(hWnd, EM_SETSEL, textLen, textLen);
                    RegisterExpectedCurrentNoteSelectionReplacement(
                        hWnd, L"\r\n",
                        static_cast<DWORD>(textLen + 1),
                        static_cast<DWORD>(textLen + 1));
                    const uint64_t beforeReplaceEditRevision = CurrentEditRevision();
                    SendMessageW(hWnd, EM_REPLACESEL, TRUE,
                                 reinterpret_cast<LPARAM>(L"\r\n"));
                    SendMessageW(hWnd, EM_SCROLLCARET, 0, 0);
                    if (CurrentEditRevision() == beforeReplaceEditRevision) {
                        RequestNoteContentRefreshAfterEdit(hWnd);
                    }
                    return 0;
                }
                if (action == DownKeyLastLineAction::MoveLineEnd) {
                    LRESULT lineStart = SendMessageW(hWnd, EM_LINEINDEX, lineCount - 1, 0);
                    if (lineStart < 0) lineStart = 0;
                    LRESULT lineLen = SendMessageW(hWnd, EM_LINELENGTH, static_cast<WPARAM>(lineStart), 0);
                    if (lineLen < 0) lineLen = 0;
                    LRESULT pos = lineStart + lineLen;
                    SendMessageW(hWnd, EM_SETSEL, pos, pos);
                    SendMessageW(hWnd, EM_SCROLLCARET, 0, 0);
                    return 0;
                }
                if (action == DownKeyLastLineAction::None) {
                    InvalidateRect(hWnd, nullptr, FALSE);
                    SendMessageW(hWnd, EM_SCROLLCARET, 0, 0);
                    return 0;
                }
            }
        }
        if (wParam == VK_NEXT && !g_noteImeComposing) {
            if ((GetKeyState(VK_SHIFT) & 0x8000) || (GetKeyState(VK_CONTROL) & 0x8000) ||
                (GetKeyState(VK_MENU) & 0x8000)) {
                break;
            }
            DWORD selStart = 0, selEnd = 0;
            SendMessageW(hWnd, EM_GETSEL,
                         reinterpret_cast<WPARAM>(&selStart),
                         reinterpret_cast<LPARAM>(&selEnd));
            if (selStart != selEnd) break;
            int lineCount = static_cast<int>(SendMessageW(hWnd, EM_GETLINECOUNT, 0, 0));
            if (lineCount <= 0) lineCount = 1;
            int caretLine = static_cast<int>(SendMessageW(hWnd, EM_LINEFROMCHAR, selStart, 0));
            if (caretLine == lineCount - 1) {
                if (lParam & 0x40000000) return 0;
                InvalidateRect(hWnd, nullptr, FALSE);
                SendMessageW(hWnd, EM_SCROLLCARET, 0, 0);
                return 0;
            }
        }
        if ((wParam == VK_LEFT || wParam == VK_RIGHT) && !g_noteImeComposing) {
            LeftRightLineMoveAction action = ParseLeftRightLineMoveAction(g_config.leftRightLineMoveAction);
            if (action == LeftRightLineMoveAction::Stay) {
                if ((GetKeyState(VK_SHIFT) & 0x8000) || (GetKeyState(VK_CONTROL) & 0x8000) ||
                    (GetKeyState(VK_MENU) & 0x8000)) {
                    break;
                }
                DWORD selStart = 0, selEnd = 0;
                SendMessageW(hWnd, EM_GETSEL,
                             reinterpret_cast<WPARAM>(&selStart),
                             reinterpret_cast<LPARAM>(&selEnd));
                if (selStart == selEnd) {
                    int caretLine = static_cast<int>(SendMessageW(hWnd, EM_LINEFROMCHAR, selStart, 0));
                    if (caretLine >= 0) {
                        LRESULT lineStart = SendMessageW(hWnd, EM_LINEINDEX, caretLine, 0);
                        if (lineStart < 0) lineStart = 0;
                        LRESULT lineLen = SendMessageW(hWnd, EM_LINELENGTH, static_cast<WPARAM>(lineStart), 0);
                        if (lineLen < 0) lineLen = 0;
                        LRESULT lineEnd = lineStart + lineLen;
                        if (wParam == VK_LEFT && static_cast<LRESULT>(selStart) == lineStart) {
                            return 0;
                        }
                        if (wParam == VK_RIGHT && static_cast<LRESULT>(selStart) == lineEnd) {
                            return 0;
                        }
                    }
                }
            }
        }
        if ((wParam == VK_DELETE || wParam == VK_BACK) && !g_noteImeComposing) {
            if ((wParam == VK_DELETE || (!ctrlDown && !altDown && !shiftDown)) &&
                TryHandleAutoBulletPrefixDelete(hWnd, wParam)) {
                return 0;
            }
            if (wParam == VK_BACK && TryHandleLeadingTabStopBackspace(hWnd)) return 0;
        }
        if (wParam == VK_DELETE || wParam == VK_BACK) {
            const bool immediateDeleteRefresh =
                RequiresImmediateNoteContentRefreshForDelete(hWnd, wParam);
            if (!g_noteImeComposing) {
                DWORD selStart = 0;
                DWORD selEnd = 0;
                SendMessageW(hWnd, EM_GETSEL,
                             reinterpret_cast<WPARAM>(&selStart),
                             reinterpret_cast<LPARAM>(&selEnd));
                if (selStart != selEnd) {
                    DWORD start = std::min(selStart, selEnd);
                    RegisterExpectedNoteTextEdit(hWnd, selStart, selEnd, L"", start, start);
                } else {
                    // RichEdit can mutate on VK_BACK before the paired
                    // WM_CHAR arrives. Reserve its exact ticket here too;
                    // otherwise that native EN_CHANGE performs a whole-note
                    // recovery instead of a proven local transaction.
                    const note::Span span = wParam == VK_BACK
                        ? PreviousNoteEditorTextUnit(hWnd, selStart)
                        : NextNoteEditorTextUnit(hWnd, selStart);
                    if (span.start != span.end) {
                        RegisterExpectedNoteTextEdit(
                            hWnd, static_cast<DWORD>(span.start.value),
                            static_cast<DWORD>(span.end.value), L"",
                            static_cast<DWORD>(span.start.value),
                            static_cast<DWORD>(span.start.value));
                    }
                }
            }
            const bool manageRedraw = !g_noteImeComposing && !IsNoteRenderSwitchInProgress() && immediateDeleteRefresh;
            if (manageRedraw) {
                SendMessageW(hWnd, WM_SETREDRAW, FALSE, 0);
            }

            // Execute the native deletion once, with its ticket already reserved.
            const uint64_t beforeDefaultEditRevision = CurrentEditRevision();
            LRESULT res = CallWindowProcW(g_oldNoteProc, hWnd, msg, wParam, lParam);

            if (manageRedraw) {
                SendMessageW(hWnd, WM_SETREDRAW, TRUE, 0);
                RedrawWindow(hWnd, nullptr, nullptr, RDW_INVALIDATE | RDW_NOERASE);
            }

            if (immediateDeleteRefresh && CurrentEditRevision() == beforeDefaultEditRevision) {
                RequestNoteContentRefreshAfterEdit(hWnd);
            }
            SyncRenderDrivenNoteInputUi(hWnd, msg);
            return res; // Return early
        }
        if (wParam == VK_LEFT || wParam == VK_RIGHT || wParam == VK_UP || wParam == VK_DOWN ||
            wParam == VK_HOME || wParam == VK_END || wParam == VK_PRIOR || wParam == VK_NEXT) {
            InvalidateRect(hWnd, nullptr, FALSE);
        }
        break;
    }
    case WM_MOUSEHWHEEL:
    case WM_MOUSEWHEEL: {
        // Render overlay can exceed the viewport width (e.g. <s=> / math rendering). Provide an easy horizontal scroll:
        // - Shift + wheel (vertical wheel) => horizontal scroll
        // - Horizontal wheel (tilt) => horizontal scroll
        if (IsNoteRenderActive()) {
            const bool isHWheel = (msg == WM_MOUSEHWHEEL);
            const bool shiftHeld = ((GET_KEYSTATE_WPARAM(wParam) & MK_SHIFT) != 0);
            if (isHWheel || shiftHeld) {
                short delta = GET_WHEEL_DELTA_WPARAM(wParam);
                if (delta != 0) {
                    int step = std::max(8, ScaleY(hWnd, 40));
                    int ticks = delta / WHEEL_DELTA;
                    int dx = ticks * step;
                    if (!isHWheel) {
                        // Match common UX: Shift+Wheel up => scroll left.
                        dx = -dx;
                    }
                    if (ScrollFinalNoteRenderBy(hWnd, dx, 0)) {
                        return 0;
                    }
                    // A final-route publication can be temporarily absent
                    // while its immutable frame is rebuilt.  That state is a
                    // whole RichEdit fallback, not permission to resurrect
                    // the retired canvas scroll owner.  Let RichEdit process
                    // the wheel message with its native rectangle/ranges.
                    if (FinalRenderRouteEnabled(hWnd)) break;
                    SetNoteRenderScrollPosX(hWnd, g_noteRenderScrollX + dx);
                    if (g_noteImeComposing) SyncNoteImeCandidateWindowToCaret(hWnd);
                    return 0;
                }
            }
        }
        if (IsNoteRenderActive() && msg == WM_MOUSEWHEEL &&
            (GET_KEYSTATE_WPARAM(wParam) & (MK_SHIFT | MK_CONTROL)) == 0) {
            const short delta = GET_WHEEL_DELTA_WPARAM(wParam);
            if (delta != 0) {
                UINT wheelLines = 3;
                SystemParametersInfoW(SPI_GETWHEELSCROLLLINES, 0, &wheelLines, 0);
                RECT client{};
                GetClientRect(hWnd, &client);
                const int linePx = std::max(8, ScaleY(hWnd, 16));
                const int clientHeight = std::max(0, static_cast<int>(client.bottom - client.top));
                const int pixelsPerWheel = (wheelLines == WHEEL_PAGESCROLL)
                    ? std::max(linePx, clientHeight - linePx)
                    : std::max(linePx, static_cast<int>(wheelLines) * linePx);
                const int numerator =
                    s_noteVerticalWheelRemainder - static_cast<int>(delta) * pixelsPerWheel;
                const int deltaY = numerator / WHEEL_DELTA;
                s_noteVerticalWheelRemainder = numerator % WHEEL_DELTA;

                if (ScrollFinalNoteRenderBy(hWnd, 0, deltaY)) {
                    return 0;
                }

                POINT nativeScroll{};
                if (QueryNativeEditScrollPos(hWnd, &nativeScroll)) {
                    nativeScroll.x = 0;
                    nativeScroll.y = std::max<LONG>(
                        0, nativeScroll.y + static_cast<LONG>(deltaY));
                    if (SendMessageW(hWnd, EM_SETSCROLLPOS, 0,
                                     reinterpret_cast<LPARAM>(&nativeScroll))) {
                        InvalidateRect(hWnd, nullptr, FALSE);
                        if (g_noteImeComposing) SyncNoteImeCandidateWindowToCaret(hWnd);
                        return 0;
                    }
                }
                // Do not combine a partially accumulated precision delta with
                // RichEdit's fallback line scrolling.
                s_noteVerticalWheelRemainder = 0;
            }
        }
        break;
    }
    case WM_RBUTTONDOWN: {
        MaybeReleaseNoteChangeSuppression(hWnd);
        if (g_noteVimModeEnabled && g_noteNormalMode && g_noteNormalVisualMode) {
            SetFocus(hWnd);
            return 0;
        }
        break;
    }
    case WM_MBUTTONDOWN:
        MaybeReleaseNoteChangeSuppression(hWnd);
        break;
    case WM_PASTE:
    case WM_CUT:
    case WM_UNDO:
    case EM_REDO:
    case WM_CLEAR: {
        if ((msg == WM_PASTE || msg == WM_CUT || msg == WM_CLEAR) &&
            g_noteVimModeEnabled && g_noteNormalMode && !g_noteCmdlineActive) {
            return 0;
        }
        if (msg == WM_UNDO || msg == EM_REDO) {
            MaybeReleaseNoteChangeSuppression(hWnd);
            const bool undo = msg == WM_UNDO;
            // Match the Ctrl+Z path: an edit notification may still be queued
            // when an IME or RichEdit command immediately requests undo.
            RecordCurrentNoteTextEditForUndo(hWnd);
            if (!CanExecuteNoteUndoRedoFromFocus(undo)) {
                ExecuteWorkspaceOperationUndoRedo(GetParent(hWnd), undo);
                return 0;
            }
            const bool manageRedraw = !g_noteImeComposing && !IsNoteRenderSwitchInProgress();
            if (manageRedraw) SendMessageW(hWnd, WM_SETREDRAW, FALSE, 0);
            const uint64_t beforeRevision = CurrentEditRevision();
            const std::wstring beforeText = GetEditText(hWnd);
            const bool executed = ExecuteNoteUndoRedoFromFocus(GetParent(hWnd), undo);
            if (manageRedraw) {
                SendMessageW(hWnd, WM_SETREDRAW, TRUE, 0);
                RedrawWindow(hWnd, nullptr, nullptr, RDW_INVALIDATE | RDW_NOERASE);
            }
            if (executed && GetEditText(hWnd) != beforeText) {
                MarkNoteUndoRedoTextChangedForSave(hWnd, beforeRevision);
                RequestNoteContentRefreshAfterEdit(hWnd);
            }
            return 0;
        }
        if (msg == WM_PASTE || msg == WM_CUT) {
            // Complete IME and reconcile any older edit before using a
            // selection as the precondition for a new clipboard operation.
            if (!SynchronizeActiveNoteEditorToKernel(GetParent(hWnd))) {
                preview_trace::Append(L"NoteClipboard", L"operation=sync_rejected");
                return 0;
            }

            DWORD selStart = 0;
            DWORD selEnd = 0;
            SendMessageW(hWnd, EM_GETSEL,
                         reinterpret_cast<WPARAM>(&selStart),
                         reinterpret_cast<LPARAM>(&selEnd));
            const DWORD start = std::min(selStart, selEnd);

            if (msg == WM_PASTE) {
                const auto clip = GetClipboardUnicodeText(hWnd);
                // Treat an empty CF_UNICODETEXT payload as a no-op. It must
                // not become a destructive replacement of the selection.
                if (!clip.has_value()) {
                    preview_trace::Append(L"NoteClipboard", L"operation=paste clipboard=unavailable");
                    return 0;
                }
                if (clip->empty()) {
                    preview_trace::Append(L"NoteClipboard", L"operation=paste clipboard=empty");
                    return 0;
                }
                const size_t normalizedLen = NormalizeTextForNoteIndexing(*clip).size();
                const DWORD insertedLen = static_cast<DWORD>(
                    std::min<size_t>(normalizedLen,
                                     static_cast<size_t>(std::numeric_limits<DWORD>::max() - start)));
                MaybeReleaseNoteChangeSuppression(hWnd);
                RegisterExpectedNoteTextEdit(hWnd, selStart, selEnd, *clip,
                                             start + insertedLen, start + insertedLen);
                const uint64_t beforeRevision = CurrentEditRevision();
                SendMessageW(hWnd, EM_REPLACESEL, TRUE,
                             reinterpret_cast<LPARAM>(clip->c_str()));
                RecordCurrentNoteTextEditForUndo(hWnd);
                preview_trace::Append(
                    L"NoteClipboard",
                    L"operation=paste applied=" +
                        preview_trace::Bool(CurrentEditRevision() != beforeRevision));
                if (CurrentEditRevision() == beforeRevision) {
                    RequestNoteContentRefreshAfterEdit(hWnd);
                }
                SyncRenderDrivenNoteInputUi(hWnd, msg);
                return 0;
            }

            if (selStart == selEnd) {
                // Preserve the native no-selection behavior; it cannot
                // delete text and needs no history reservation.
                MaybeReleaseNoteChangeSuppression(hWnd);
                return CallWindowProcW(g_oldNoteProc, hWnd, msg, wParam, lParam);
            }

            const std::wstring indexedText = GetEditTextForIndexing(hWnd);
            const size_t selectionStart = std::min<size_t>(start, indexedText.size());
            const size_t selectionEnd = std::min<size_t>(std::max(selStart, selEnd), indexedText.size());
            std::wstring clipboardText;
            clipboardText.reserve(selectionEnd - selectionStart);
            for (size_t i = selectionStart; i < selectionEnd; ++i) {
                if (indexedText[i] == L'\n') {
                    clipboardText.append(L"\r\n");
                } else {
                    clipboardText.push_back(indexedText[i]);
                }
            }
            // Cut is two effects. Do not make the destructive effect
            // reachable unless the clipboard effect has succeeded.
            if (!SetClipboardUnicodeText(hWnd, clipboardText)) return 0;
            MaybeReleaseNoteChangeSuppression(hWnd);
            RegisterExpectedNoteTextEdit(hWnd, selStart, selEnd, L"", start, start);
            const uint64_t beforeRevision = CurrentEditRevision();
            const LRESULT result = CallWindowProcW(g_oldNoteProc, hWnd, WM_CLEAR, 0, 0);
            RecordCurrentNoteTextEditForUndo(hWnd);
            if (CurrentEditRevision() == beforeRevision) {
                RequestNoteContentRefreshAfterEdit(hWnd);
            }
            SyncRenderDrivenNoteInputUi(hWnd, msg);
            return result;
        }
        MaybeReleaseNoteChangeSuppression(hWnd);
        if (msg == WM_CLEAR) {
            DWORD selStart = 0;
            DWORD selEnd = 0;
            SendMessageW(hWnd, EM_GETSEL,
                         reinterpret_cast<WPARAM>(&selStart),
                         reinterpret_cast<LPARAM>(&selEnd));
            if (selStart != selEnd) {
                DWORD start = std::min(selStart, selEnd);
                RegisterExpectedNoteTextEdit(hWnd, selStart, selEnd, L"", start, start);
            }
        }
        // RichEdit emits EN_CHANGE synchronously while processing clipboard edits.
        // Keep redraw enabled: that notification may refresh the render snapshot and
        // line metrics before this call returns. Suspending painting here left the
        // old transparent render overlay on the surface after Ctrl+X/WM_CUT.
        // Execute the action first.
        const uint64_t beforeDefaultEditRevision = CurrentEditRevision();
        LRESULT res = CallWindowProcW(g_oldNoteProc, hWnd, msg, wParam, lParam);

        // Then immediately update the cache to prevent visual glitches due to line count changes
        if (CurrentEditRevision() == beforeDefaultEditRevision) {
            RequestNoteContentRefreshAfterEdit(hWnd);
        }
        SyncRenderDrivenNoteInputUi(hWnd, msg);
        return res;
    }
    case WM_POINTERDOWN:
    case WM_POINTERUPDATE:
    case WM_POINTERUP: {
        UINT32 pointerId = GET_POINTERID_WPARAM(wParam);
        POINTER_INPUT_TYPE pointerType = PT_POINTER;
        if (GetPointerType(pointerId, &pointerType) && pointerType == PT_TOUCH) {
            POINT pt{ GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam) };
            // WM_POINTER coordinates are screen-relative. Convert once so
            // drag distance is independent of the note pane's position.
            ScreenToClient(hWnd, &pt);
            if (msg == WM_POINTERDOWN) {
                // Keep the original contact in control when another finger
                // touches down during a one-finger scroll.
                if (s_noteTouchPanning) return 0;
                SetCapture(hWnd);
                s_noteTouchPanning = true;
                s_noteTouchPanPointerId = pointerId;
                s_noteTouchPanAnchor = pt;
            } else if (msg == WM_POINTERUPDATE) {
                if (s_noteTouchPanning && pointerId == s_noteTouchPanPointerId) {
                    int dy = pt.y - s_noteTouchPanAnchor.y;
                    // Keep the increment close to a rendered text line. This
                    // avoids both the old large dead zone and an exaggerated
                    // scroll distance on high-density touch screens.
                    constexpr int kTouchScrollIncrementPx = 12;
                    if (std::abs(dy) >= kTouchScrollIncrementPx) {
                        int lines = dy / kTouchScrollIncrementPx;
                        SendMessageW(hWnd, EM_LINESCROLL, 0, static_cast<LPARAM>(-lines));
                        s_noteTouchPanAnchor.y += lines * kTouchScrollIncrementPx;
                    }
                }
            } else if (msg == WM_POINTERUP) {
                if (s_noteTouchPanning && pointerId == s_noteTouchPanPointerId) {
                    s_noteTouchPanning = false;
                    s_noteTouchPanPointerId = 0;
                    ReleaseCapture();
                }
            }
            return 0;
        }
        break;
    }
    case WM_LBUTTONDOWN: {
        g_ignoreNextLeftKeyUntilTick = 0;
        MaybeReleaseNoteChangeSuppression(hWnd);
        if (g_noteSearchHitActive) {
            ClearSearchHitHighlight(false);
        }
        if (HandleNoteLineSelectionMouseDown(hWnd, lParam)) {
            EndNoteOpeningFocusVisualHold(hWnd);
            RefreshNoteLineSpacingForPresentationSurface(hWnd);
            return 0;
        }
        if (HandleNoteNormalModeMouseDown(hWnd, lParam)) {
            EndNoteOpeningFocusVisualHold(hWnd);
            RefreshNoteLineSpacingForPresentationSurface(hWnd);
            return 0;
        }
        g_notePointerMovedCaretRaw = false;
        const bool isCtrlDown = (GetKeyState(VK_CONTROL) & 0x8000) != 0;
        if (!isCtrlDown) {
            g_ctrlRenderSelecting = false;
            g_ctrlRenderSelected = false;
        } else if (IsNoteRenderActive()) {
            const NotePointerPresentationHit pointerHit =
                ResolveNotePointerPresentationHit(
                    hWnd, GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam));
            const std::optional<size_t>& hit = pointerHit.raw_index;
            std::optional<size_t> idx;
            std::optional<size_t> editorIdx;
            if (hit) {
                idx = *hit;
                editorIdx = pointerHit.editor_index.has_value()
                    ? pointerHit.editor_index
                    : MapCanonicalNoteOffsetToEditorTransportForInput(hWnd, *idx);
            } else if (!FinalRenderRouteEnabled(hWnd) && IsRichEditControl(hWnd)) {
                POINTL pt{ GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam) };
                LRESULT res = SendMessageW(hWnd, EM_CHARFROMPOS, 0, reinterpret_cast<LPARAM>(&pt));
                if (res >= 0) {
                    editorIdx = static_cast<size_t>(res);
                    idx = MapEditorTransportToCanonicalNoteOffsetForInput(hWnd, *editorIdx);
                }
            }
            // Retain a visible final frame on a miss. Only a whole-native
            // fallback may delegate the same pointer to RichEdit geometry.
            if (!idx.has_value() || !editorIdx.has_value()) {
                if (FinalFrameCanUseCustomPaint(hWnd)) return 0;
                break;
            }
            g_ctrlRenderSelecting = true;
            g_ctrlRenderSelected = false;
            g_noteRenderSelecting = true;
            g_noteRenderSelectAnchor = *idx;
            g_noteRenderMouseDragActive = false;
            SendMessageW(hWnd, EM_SETSEL, static_cast<WPARAM>(*editorIdx),
                         static_cast<LPARAM>(*editorIdx));
            SetFocus(hWnd);
            EndNoteOpeningFocusVisualHold(hWnd);
            SetCapture(hWnd);
            InvalidateRect(hWnd, nullptr, FALSE);
            SyncRenderDrivenNoteInputUi(hWnd, WM_LBUTTONDOWN);
            return 0;
        }
        g_notePendingLinkClickInsert = (g_linkPending.active && !g_linkPending.id.empty());
        g_notePendingLinkClickDown = { GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam) };
        if (!g_notePendingLinkClickInsert || !IsNoteRenderActive()) {
            ClearRenderInsertGrace(hWnd);
        }
        if (IsNoteRenderActive()) {
            DWORD selStart_raw = 0, selEnd_raw = 0;
            SendMessageW(hWnd, EM_GETSEL,
                         reinterpret_cast<WPARAM>(&selStart_raw),
                         reinterpret_cast<LPARAM>(&selEnd_raw));
            const std::optional<size_t> canonicalSelStart =
                MapEditorTransportToCanonicalNoteOffsetForInput(
                    hWnd, static_cast<size_t>(selStart_raw));
            const std::optional<size_t> canonicalSelEnd =
                MapEditorTransportToCanonicalNoteOffsetForInput(
                    hWnd, static_cast<size_t>(selEnd_raw));
            if (!canonicalSelStart.has_value() || !canonicalSelEnd.has_value()) {
                // The frame was withdrawn or IME transport no longer proves
                // a canonical endpoint. Let the native fallback resolve the
                // click rather than mixing it with legacy line ownership.
                releaseOpeningFocusHoldAfterDefault = IsNoteOpeningFocusVisualHoldActive();
                break;
            }
            int caretLine_now = FindLineForRaw(*canonicalSelStart);
            int selStartLine_now = caretLine_now;
            int selEndLine_now = caretLine_now;
            if (*canonicalSelStart != *canonicalSelEnd) {
                const size_t endPos = (*canonicalSelEnd > *canonicalSelStart)
                    ? *canonicalSelEnd - 1 : *canonicalSelEnd;
                selStartLine_now = FindLineForRaw(*canonicalSelStart);
                selEndLine_now = FindLineForRaw(endPos);
                if (selEndLine_now < selStartLine_now) std::swap(selStartLine_now, selEndLine_now);
            }
            const NotePointerPresentationHit pointerHit =
                ResolveNotePointerPresentationHit(
                    hWnd, GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam));
            const std::optional<size_t>& hit = pointerHit.raw_index;
            int hitLine_now = caretLine_now;
            if (hit) {
                hitLine_now = FindLineForRaw(*hit);
            }
            bool rawLine = (*canonicalSelStart != *canonicalSelEnd) ? (hitLine_now >= selStartLine_now && hitLine_now <= selEndLine_now)
                                         : (hitLine_now == caretLine_now);
            if (g_notePendingLinkClickInsert && hitLine_now >= 0 && !rawLine) {
                StartRenderInsertGrace(hWnd, hitLine_now);
            }
            if (hit) {
                size_t idx = *hit;
                const std::optional<size_t> editorIdx = pointerHit.editor_index.has_value()
                    ? pointerHit.editor_index
                    : MapCanonicalNoteOffsetToEditorTransportForInput(hWnd, idx);
                if (!editorIdx.has_value()) {
                    releaseOpeningFocusHoldAfterDefault = IsNoteOpeningFocusVisualHoldActive();
                    break;
                }
                const bool ctrlAltClick =
                    (GetKeyState(VK_CONTROL) & 0x8000) != 0 &&
                    (GetKeyState(VK_MENU) & 0x8000) != 0;
                if (ctrlAltClick && !g_linkPending.active) {
                    const std::optional<std::wstring> linkId =
                        pointerHit.final_legacy_link_id.has_value()
                            ? pointerHit.final_legacy_link_id
                            : LinkIdAtCharIndex(hWnd, idx);
                    if (linkId.has_value()) {
                        if (!HandleLinkIdJump(*linkId, GetParent(hWnd), g_currentNotePath, idx)) {
                            ClearNoteLinkRenderGrace(hWnd);
                        }
                        UpdateNotePreviewFromEdit(hWnd);
                        return 0;
                    }
                }
                if (g_notePendingLinkClickInsert) {
                    g_notePointerMovedCaretRaw = (*canonicalSelStart != *canonicalSelEnd) ||
                        idx != *canonicalSelEnd;
                    ClearNoteLinkRenderGrace(hWnd);
                    g_notePendingCaretIdx = static_cast<size_t>(-1);
                    SendMessageW(hWnd, EM_SETSEL,
                                 static_cast<WPARAM>(*editorIdx),
                                 static_cast<LPARAM>(*editorIdx));
                    SetFocus(hWnd);
                    EndNoteOpeningFocusVisualHold(hWnd);
                    InvalidateRect(hWnd, nullptr, FALSE);
                    SyncRenderDrivenNoteInputUi(hWnd, WM_LBUTTONDOWN);
                    return 0;
                }
                const std::optional<std::wstring> linkId =
                    pointerHit.final_legacy_link_id.has_value()
                        ? pointerHit.final_legacy_link_id
                        : LinkIdAtCharIndex(hWnd, idx);
                const bool keepStructuredLinkForDoubleClick =
                    linkId.has_value() && !pointerHit.native_raw_surface;
                g_notePointerMovedCaretRaw = keepStructuredLinkForDoubleClick
                    ? false
                    : ((*canonicalSelStart != *canonicalSelEnd) || idx != *canonicalSelEnd);
                if (linkId) {
                    if (keepStructuredLinkForDoubleClick) {
                        const DWORD now = GetTickCount();
                        if (*linkId == g_noteLastClickLinkId &&
                            (now - g_noteLastClickTime < GetDoubleClickTime())) {
                            // The first click already owns the double-click window.
                        } else {
                            g_noteLastClickLinkId = *linkId;
                            g_noteLastClickPt = { GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam) };
                            StartNoteLinkRenderGrace(hWnd);
                        }
                    } else {
                        // The source row is already NativeRaw. Do not start a
                        // render grace that would replace it before the second
                        // click; native coordinates remain authoritative.
                        ClearNoteLinkRenderGrace(hWnd);
                    }
                } else {
                    ClearNoteLinkRenderGrace(hWnd);
                    g_notePendingCaretIdx = static_cast<size_t>(-1);
                }
                g_noteRenderSelecting = true;
                g_noteRenderSelectAnchor = idx;
                g_noteRenderMouseDragActive = false;
                if (g_notePendingCaretIdx == static_cast<size_t>(-1)) {
                    SendMessageW(hWnd, EM_SETSEL,
                                 static_cast<WPARAM>(*editorIdx),
                                 static_cast<LPARAM>(*editorIdx));
                }
                SetFocus(hWnd);
                EndNoteOpeningFocusVisualHold(hWnd);
                SetCapture(hWnd);
                InvalidateRect(hWnd, nullptr, FALSE);
                SyncRenderDrivenNoteInputUi(hWnd, WM_LBUTTONDOWN);
                return 0;
            } else {
                if (FinalFrameCanUseCustomPaint(hWnd)) {
                    // A miss in the visible custom frame must not become a
                    // native click against different line heights/columns.
                    // Leave text, selection and surface ownership unchanged.
                    return 0;
                }
                // The native control will resolve this uncommon hit after the
                // subclass returns. Prefer the raw owner for that pending
                // caret move over keeping an unrelated structured row alive.
                g_notePointerMovedCaretRaw = true;
                ClearNoteLinkRenderGrace(hWnd);
                g_notePendingCaretIdx = static_cast<size_t>(-1);
            }
        }
        releaseOpeningFocusHoldAfterDefault = IsNoteOpeningFocusVisualHoldActive();
        break;
    }
    case WM_CONTEXTMENU: {
        if (reinterpret_cast<HWND>(wParam) != hWnd) break;
        SetFocus(hWnd);
        POINT pt{ GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam) };
        ShowNoteContextMenu(hWnd, pt);
        return 0;
    }
    case WM_MOUSEMOVE: {
        POINT pt{ GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam) };
        RecordRecentMouseMove(hWnd, &pt);
        if (HandleNoteLineSelectionMouseMove(hWnd, wParam, lParam)) {
            RefreshNoteLineSpacingForPresentationSurface(hWnd);
            return 0;
        }
        if (HandleNoteNormalModeMouseMove(hWnd, wParam, lParam)) {
            RefreshNoteLineSpacingForPresentationSurface(hWnd);
            return 0;
        }
        if (g_notePendingLinkClickInsert && (wParam & MK_LBUTTON)) {
            int dx = std::abs(pt.x - g_notePendingLinkClickDown.x);
            int dy = std::abs(pt.y - g_notePendingLinkClickDown.y);
            int dragX = std::max<int>(1, GetSystemMetrics(SM_CXDRAG));
            int dragY = std::max<int>(1, GetSystemMetrics(SM_CYDRAG));
            if (dx > dragX || dy > dragY) {
                g_notePendingLinkClickInsert = false;
            }
        }
        if (g_noteRenderSelecting && (wParam & MK_LBUTTON)) {
            if (!g_noteRenderMouseDragActive) {
                int dx = std::abs(pt.x - g_notePendingLinkClickDown.x);
                int dy = std::abs(pt.y - g_notePendingLinkClickDown.y);
                int dragX = std::max<int>(1, GetSystemMetrics(SM_CXDRAG));
                int dragY = std::max<int>(1, GetSystemMetrics(SM_CYDRAG));
                if (dx <= dragX && dy <= dragY) {
                    return 0;
                }
                g_noteRenderMouseDragActive = true;
            }
            g_notePendingCaretIdx = static_cast<size_t>(-1);
            const NotePointerPresentationHit pointerHit =
                ResolveNotePointerPresentationHit(
                    hWnd, GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam));
            if (pointerHit.raw_index.has_value() && pointerHit.editor_index.has_value()) {
                const size_t idx = *pointerHit.raw_index;
                const size_t editorIdx = *pointerHit.editor_index;
                const std::optional<size_t> anchorEditorIdx =
                    MapCanonicalNoteOffsetToEditorTransportForInput(
                        hWnd, g_noteRenderSelectAnchor);
                if (!anchorEditorIdx.has_value()) break;
                SendMessageW(hWnd, EM_SETSEL,
                             static_cast<WPARAM>(*anchorEditorIdx),
                             static_cast<LPARAM>(editorIdx));
                InvalidateRect(hWnd, nullptr, FALSE);
                SyncRenderDrivenNoteInputUi(hWnd, WM_MOUSEMOVE);
                return 0;
            }
        }
        break;
    }
    case WM_LBUTTONUP:
    case WM_KEYUP:
        if (msg == WM_LBUTTONUP && HandleNoteLineSelectionMouseUp(hWnd)) {
            UpdatePreviewNoteFromCaretLine(hWnd);
            if (g_hBottomMath && g_bottomPanePin == BottomPanePin::Math) {
                InvalidateRect(g_hBottomMath, nullptr, FALSE);
            }
            InvalidateRect(hWnd, nullptr, FALSE);
            RefreshNoteLineSpacingForPresentationSurface(hWnd);
            MaybeFlushNoteStageOnCaretOrFocusChange(hWnd, false);
            return 0;
        }
        if (msg == WM_LBUTTONUP && HandleNoteNormalModeMouseUp(hWnd)) {
            RefreshNoteLineSpacingForPresentationSurface(hWnd);
            return 0;
        }
        if (msg == WM_LBUTTONUP && g_notePendingLinkClickInsert) {
            g_notePendingLinkClickInsert = false;
        } else if (msg == WM_LBUTTONUP) {
            g_notePendingLinkClickInsert = false;
        }
        if (msg == WM_LBUTTONUP && g_noteRenderSelecting) {
            if (g_ctrlRenderSelecting) {
                g_ctrlRenderSelecting = false;
                DWORD selS = 0, selE = 0;
                SendMessageW(hWnd, EM_GETSEL, reinterpret_cast<WPARAM>(&selS), reinterpret_cast<LPARAM>(&selE));
                g_ctrlRenderSelected = (selS != selE);
            }
            g_noteRenderSelecting = false;
            g_noteRenderMouseDragActive = false;
            ReleaseCapture();
        }
        UpdatePreviewNoteFromCaretLine(hWnd);
        if (g_hBottomMath && g_bottomPanePin == BottomPanePin::Math) {
            InvalidateRect(g_hBottomMath, nullptr, FALSE);
        }
        RefreshFinalNoteRenderFrame(hWnd);
        InvalidateRect(hWnd, nullptr, FALSE);
        MaybeFlushNoteStageOnCaretOrFocusChange(hWnd, false);
        break;
    case WM_CAPTURECHANGED:
        // Pointer-up is not guaranteed when Windows transfers capture (for
        // example during a system gesture).  Drop the private touch state so
        // the next contact always starts a fresh scroll.
        s_noteTouchPanning = false;
        s_noteTouchPanPointerId = 0;
        g_noteLineSelectionActive = false;
        g_noteLineSelectionAnchorLine = -1;
        g_noteLineSelectionLastLine = -1;
        g_noteRenderSelecting = false;
        g_ctrlRenderSelecting = false;
        g_noteRenderMouseDragActive = false;
        g_noteNormalMouseDragActive = false;
        g_notePendingLinkClickInsert = false;
        break;
    case WM_SETFOCUS:
        if (!(g_noteVimModeEnabled && g_noteNormalMode)) {
            EnableImeForNoteEdit(hWnd);
            g_noteNormalMode = false;
            OnExitNoteNormalMode();
        } else {
            DisableImeForNoteEdit(hWnd);
        }
        g_noteHasFocus = true;
        if (g_hBottomNote) InvalidateRect(g_hBottomNote, nullptr, FALSE);
        if (g_hBottomMath && g_bottomPanePin == BottomPanePin::Math) {
            InvalidateRect(g_hBottomMath, nullptr, FALSE);
        }
        InvalidateRect(hWnd, nullptr, FALSE);
        g_noteStageObservedCaretLine = CurrentNoteCaretLine(hWnd);
        TraceCurrentNoteFocusState(L"wm_setfocus");
        break;
    case WM_KILLFOCUS: {
        // RichEdit must first settle its native input/focus state. Do not
        // reopen canonical synchronization or stage persistence while it
        // still owns a provisional composition replacement.
        const LRESULT result = DispatchNoteImeToNative(hWnd, msg, wParam, lParam);
        g_noteHasFocus = false;
        AdvanceNoteImePresentationPhaseForWindow(
            hWnd, note::NoteImePresentationEvent::FocusLost);
        ClearNoteImeCompositionPresentationAnchor(hWnd);
        EndFinalNoteImePreedit(hWnd);
        FinalizeNoteImeCanonicalText(hWnd);
        ClearRenderInsertGrace(hWnd);
        // Focus loss hands the rows back to Structured presentation. Restore
        // a single final frame before its next paint. If that frame cannot be
        // proven, the fallback line-spacing path below remains available.
        RefreshFinalNoteRenderFrame(hWnd);
        RefreshNoteLineSpacingForPresentationSurface(hWnd);
        FlushPendingMathRecompute(hWnd); // Ensure final edits are reflected if typing was active before focus leaves.
        MaybeFlushNoteStageOnCaretOrFocusChange(hWnd, true);
        if (g_hBottomNote) InvalidateRect(g_hBottomNote, nullptr, FALSE);
        if (g_hBottomMath && g_bottomPanePin == BottomPanePin::Math) {
            InvalidateRect(g_hBottomMath, nullptr, FALSE);
        }
        InvalidateRect(hWnd, nullptr, FALSE);
        TraceCurrentNoteFocusState(L"wm_killfocus");
        SyncRenderDrivenNoteInputUi(hWnd, msg);
        return result;
    }
    case WM_VSCROLL:
        if (HandleFinalNoteRenderScrollCommand(hWnd, false, wParam)) {
            return 0;
        }
        InvalidateRect(hWnd, nullptr, FALSE);
        break;
    case WM_HSCROLL:
        if (HandleFinalNoteRenderScrollCommand(hWnd, true, wParam)) {
            return 0;
        }
        // If the final publication is transiently unavailable, this is the
        // whole-native fallback.  Do not consume its scrollbar command with
        // the retired canvas range; RichEdit's default handler owns it.
        if (IsNoteRenderActive() && !FinalRenderRouteEnabled(hWnd)) {
            SCROLLINFO si{};
            si.cbSize = sizeof(si);
            si.fMask = SIF_ALL;
            GetScrollInfo(hWnd, SB_HORZ, &si);
            int next = g_noteRenderScrollX;
            switch (LOWORD(wParam)) {
            case SB_LINELEFT: next -= std::max(8, ScaleY(hWnd, 24)); break;
            case SB_LINERIGHT: next += std::max(8, ScaleY(hWnd, 24)); break;
            case SB_PAGELEFT: next -= static_cast<int>(si.nPage); break;
            case SB_PAGERIGHT: next += static_cast<int>(si.nPage); break;
            case SB_THUMBPOSITION:
            case SB_THUMBTRACK:
                next = si.nTrackPos;
                break;
            case SB_LEFT:
                next = 0;
                break;
            case SB_RIGHT:
                next = si.nMax;
                break;
            default:
                break;
            }
            SetNoteRenderScrollPosX(hWnd, next);
            if (g_noteImeComposing) SyncNoteImeCandidateWindowToCaret(hWnd);
            return 0;
        }
        InvalidateRect(hWnd, nullptr, FALSE);
        break;
    case WM_TIMER:
        if (wParam == kNoteLinkRenderGraceTimerId) {
            const DWORD remainingMs = NoteLinkRenderGraceRemainingMs();
            if (remainingMs > 0) {
                SetTimer(hWnd, kNoteLinkRenderGraceTimerId, remainingMs, nullptr);
            } else {
                ClearNoteLinkRenderGrace(hWnd);
                // Grace expiry changes the raw/structured owner even though
                // editor text did not change. Publish that state now; paint
                // may only consume the immutable result.
                RefreshFinalNoteRenderFrame(hWnd);
                InvalidateRect(hWnd, nullptr, FALSE);
            }
            return 0;
        }
        break;
    case WM_SIZE:
        if (FinalRenderRouteEnabled(hWnd) && GetViewContext(hWnd).finalRenderScrollSyncInProgress) {
            // SetScrollInfo has already changed the client viewport. This is
            // an acknowledgement of the final renderer's own bar geometry,
            // not a request to reformat the native document. RichEdit's
            // WM_SIZE/EM_SETRECTNP would restore bars from RAW text extents;
            // when raw text overflows but structured text fits, the two
            // owners otherwise oscillate until publication falls back.
            // Complete the normal final-frame boundary (or coalesce it into
            // its outer publication), without native layout/selection work.
            InvalidateRect(hWnd, nullptr, FALSE);
            SyncRenderDrivenNoteInputUi(hWnd, msg);
            return 0;
        }
        UpdateNoteFormatRect(hWnd);
        // The post-default input synchronizer republishes from this updated
        // client geometry. It also permits WM_SIZE while another pane owns
        // focus, so a loading or split-pane resize cannot strand this view in
        // native fallback until unrelated input arrives.
        InvalidateRect(hWnd, nullptr, FALSE);
        if (g_noteImeComposing) SyncNoteImeCandidateWindowToCaret(hWnd);
        break;
    case WM_LBUTTONDBLCLK: {
        if (g_noteVimModeEnabled && g_noteNormalMode && g_noteNormalVisualMode) {
            CopyNoteNormalVisualSelection(hWnd, false);
            return 0;
        }
        g_notePendingLinkClickInsert = false;
        g_notePendingCaretIdx = static_cast<size_t>(-1);

        DWORD selStart_raw = 0;
        SendMessageW(hWnd, EM_GETSEL, reinterpret_cast<WPARAM>(&selStart_raw), 0);
        const NotePointerPresentationHit pointerHit =
            ResolveNotePointerPresentationHit(
                hWnd, GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam));
        const bool rawLike = pointerHit.native_raw_surface;
        const std::optional<size_t> canonicalSelectionStart =
            MapEditorTransportToCanonicalNoteOffsetForInput(
                hWnd, static_cast<size_t>(selStart_raw));
        const size_t hitIdx = ClampNoteRawIndex(
            pointerHit.raw_index.value_or(canonicalSelectionStart.value_or(0)));
        const std::optional<size_t> hitEditorIdx = pointerHit.editor_index.has_value()
            ? pointerHit.editor_index
            : MapCanonicalNoteOffsetToEditorTransportForInput(hWnd, hitIdx);

        if (g_linkPending.active && !g_linkPending.id.empty()) {
            if (!hitEditorIdx.has_value()) break;
            // Position has already been resolved against the visible owner.
            // The link-creation path may now consume its independent grace.
            ClearNoteLinkRenderGrace(hWnd);
            SendMessageW(hWnd, EM_SETSEL,
                         static_cast<WPARAM>(*hitEditorIdx),
                         static_cast<LPARAM>(*hitEditorIdx));
            QueuePendingLinkInsertFromNoteClick(hWnd, rawLike);
            ClearRenderInsertGrace(hWnd);
            UpdateNotePreviewFromEdit(hWnd);
            SyncRenderDrivenNoteInputUi(hWnd, WM_LBUTTONDBLCLK);
            return 0;
        }

        if (pointerHit.raw_index.has_value()) {
            const std::optional<std::wstring> linkId =
                pointerHit.final_legacy_link_id.has_value()
                    ? pointerHit.final_legacy_link_id
                    : LinkIdAtCharIndex(hWnd, hitIdx);
            if (linkId.has_value()) {
                // Do not clear render grace before this call. A structured
                // link must remain structured through the jump; a NativeRaw
                // link has no grace and therefore remains native raw.
                if (HandleLinkIdJump(*linkId, GetParent(hWnd), g_currentNotePath, hitIdx)) {
                    UpdateNotePreviewFromEdit(hWnd);
                    return 0;
                }
            }
        }
        // This was not a resolved link activation. Return to the usual
        // double-click behavior, including the ordinary raw editing surface.
        ClearNoteLinkRenderGrace(hWnd);
        if (HandleNoteNormalModeMouseDown(hWnd, lParam)) {
            return 0;
        }
        UpdateNotePreviewFromEdit(hWnd);
        break;
    }
    case WM_NCDESTROY:
        s_noteVerticalWheelRemainder = 0;
        g_noteVisualAssistMarginByHwnd.erase(hWnd);
        ForgetNoteViewState(hWnd);
        forgetViewContextAfterDefault = true;
        break;
    }
    if (msg == WM_KEYDOWN) {
        MSG edgeNavMsg{};
        edgeNavMsg.hwnd = hWnd;
        edgeNavMsg.message = msg;
        edgeNavMsg.wParam = wParam;
        edgeNavMsg.lParam = lParam;
        if (ui::ConsumeNoOpEdgeNavKeyForMultilineEdit(edgeNavMsg)) {
            SyncRenderDrivenNoteInputUi(hWnd, msg);
            return 0;
        }
    }
    if (keepNavigationFrame) WithdrawFinalNoteRenderFrame(hWnd);
    LRESULT res = CallWindowProcW(g_oldNoteProc, hWnd, msg, wParam, lParam);
    if (forgetViewContextAfterDefault) {
        ForgetLocalNoteViewContext(hWnd);
        return res;
    }
    if (releaseOpeningFocusHoldAfterDefault) {
        EndNoteOpeningFocusVisualHold(hWnd);
    }
    SyncRenderDrivenNoteInputUi(hWnd, msg);
    if (nativeSizeChanged) {
        // Close the native size boundary before releasing redraw. WM_SIZE
        // normally published already; reuse that frame without a second
        // layout/parse. Recover only a genuinely missing publication here,
        // never in WM_PAINT, and align the post-default caret/IME origin.
        if (FinalRenderRouteEnabled(hWnd) && !FinalFrameCanUseCustomPaint(hWnd)) {
            RefreshFinalNoteRenderFrame(hWnd);
        }
        SyncNativeCaretToRenderState(hWnd);
        SyncNoteImeCandidateWindowToCaret(hWnd);
    }
    return res;
}
