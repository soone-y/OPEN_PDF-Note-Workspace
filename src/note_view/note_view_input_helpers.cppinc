// file: note_view/note_view_input_helpers.cppinc
// Included by note_view_input.cppinc; contains input helpers, visual assist, and save guards.

#include "core/localization.h"

// Note edit input, focus, IME-aware navigation, and token actions.
// Included by note_view.cpp to keep a single translation unit while narrowing edit scope.

static int g_noteStageObservedCaretLine = -1;

static bool IsPotentialNoteTextMutationMessage(UINT msg, WPARAM wParam) {
    switch (msg) {
    case WM_CHAR:
    case WM_PASTE:
    case WM_CUT:
    case WM_CLEAR:
    case WM_UNDO:
    case EM_REDO:
        return true;
    case WM_KEYDOWN:
        return wParam == VK_BACK || wParam == VK_DELETE ||
               wParam == VK_RETURN || wParam == VK_TAB;
    default:
        return false;
    }
}

static bool EnsureDeferredNoteTargetForInputMessage(HWND hWnd, UINT msg, WPARAM wParam) {
    if (!g_currentNotePath.empty() || g_currentSessionPath.empty()) return true;
    if (!IsPotentialNoteTextMutationMessage(msg, wParam)) return true;
    HWND owner = GetParent(hWnd);
    if (!owner) owner = g_hMainWnd;
    return file_output::EnsureCurrentNotePathForStage(owner);
}

static int CurrentNoteCaretLine(HWND hWnd) {
    if (!hWnd) return -1;
    DWORD selStart = 0;
    DWORD selEnd = 0;
    SendMessageW(hWnd, EM_GETSEL,
                 reinterpret_cast<WPARAM>(&selStart),
                 reinterpret_cast<LPARAM>(&selEnd));
    if (selStart > selEnd) std::swap(selStart, selEnd);
    return static_cast<int>(SendMessageW(hWnd, EM_LINEFROMCHAR, static_cast<WPARAM>(selStart), 0));
}

static void MaybeFlushNoteStageOnCaretOrFocusChange(HWND hWnd, bool forceFlush) {
    if (!hWnd) return;
    const int currentLine = CurrentNoteCaretLine(hWnd);
    if (forceFlush) {
        g_noteStageObservedCaretLine = -1;
        if (!g_noteDirty || IsNoteImeComposing()) return;
        HWND owner = GetParent(hWnd);
        if (!owner) owner = g_hMainWnd;
        (void)file_output::SaveNoteIfDirty(owner);
        return;
    }
    if (currentLine < 0) return;
    if (g_noteStageObservedCaretLine < 0) {
        g_noteStageObservedCaretLine = currentLine;
        return;
    }
    if (currentLine == g_noteStageObservedCaretLine) return;
    g_noteStageObservedCaretLine = currentLine;
    // Pure caret line changes without pending text edits only require an overlay repaint
    // (switching former caret line to Rendered mode using existing line cache), avoiding heavy full-document parses.
    // If a text edit was performed prior to leaving the line, commit any pending derived-
    // state at this stable boundary rather than waiting for a later idle refresh.
    if (!IsNoteImeComposing() &&
        (IsNoteTyping() || g_noteDirty || HasDeferredNoteFullReparse() ||
         RequiresImmediateNoteDerivedFrameCommit())) {
        FlushPendingMathRecompute(hWnd);
    }
}

static bool HandleNoteCtrlUndoRedo(HWND hWnd, WPARAM wParam, bool* outTextChanged) {
    if (outTextChanged) *outTextChanged = false;
    if (!hWnd) return false;
    const bool ctrlDown = (GetKeyState(VK_CONTROL) & 0x8000) != 0;
    const bool altDown = (GetKeyState(VK_MENU) & 0x8000) != 0;
    if (!ctrlDown || altDown) return false;

    const bool shiftDown = (GetKeyState(VK_SHIFT) & 0x8000) != 0;
    bool wantUndo = false;
    if (wParam == 'Z') {
        wantUndo = !shiftDown;
    } else if (wParam == 'Y') {
        wantUndo = false;
    } else {
        return false;
    }

    // Consume a recognized undo/redo chord even when this note is read-only or
    // has no history. Otherwise RichEdit's default processing could mutate a
    // background/read-only note outside the shared eligibility check.
    // EN_CHANGE can be deferred by RichEdit. Capture that last user edit
    // before judging history availability so Ctrl+Z never silently loses it.
    RecordCurrentNoteTextEditForUndo(hWnd);
    if (!CanExecuteNoteUndoRedoFromFocus(wantUndo)) {
        ExecuteWorkspaceOperationUndoRedo(GetParent(hWnd), wantUndo);
        return true;
    }

    const std::wstring beforeText = GetEditText(hWnd);
    const bool executed = ExecuteNoteUndoRedoFromFocus(GetParent(hWnd), wantUndo);
    if (outTextChanged) *outTextChanged = executed && GetEditText(hWnd) != beforeText;
    return true;
}

static std::wstring GetEditTextRangeForIndexing(HWND hWnd, size_t start, size_t end) {
    if (!hWnd || end <= start) return L"";
    if (IsRichEditControl(hWnd)) {
        const LONG cpMin = static_cast<LONG>(std::clamp<size_t>(start, 0, static_cast<size_t>(LONG_MAX)));
        const LONG cpMax = static_cast<LONG>(std::clamp<size_t>(end, start, static_cast<size_t>(LONG_MAX)));
        if (cpMax <= cpMin) return L"";
        std::wstring text(static_cast<size_t>(cpMax - cpMin) + 1, L'\0');
        TEXTRANGEW range{};
        range.chrg.cpMin = cpMin;
        range.chrg.cpMax = cpMax;
        range.lpstrText = text.data();
        LRESULT copied = SendMessageW(hWnd, EM_GETTEXTRANGE, 0, reinterpret_cast<LPARAM>(&range));
        if (copied < 0) copied = 0;
        text.resize(static_cast<size_t>(copied));
        // RichEdit positions use one code unit per hard break. Normalize the
        // returned transport text to the same LF representation as TextEdit
        // and NoteTextCore before any local mutation validation compares it.
        return NormalizeTextForNoteIndexing(std::move(text));
    }

    std::wstring text = GetEditTextForIndexing(hWnd);
    const size_t textLen = text.size();
    start = std::min(start, textLen);
    end = std::min(end, textLen);
    if (end <= start) return L"";
    return text.substr(start, end - start);
}

static size_t SaturatingNoteEditorTextOffsetAdd(size_t left, size_t right) {
    const size_t max = std::numeric_limits<size_t>::max();
    return right > max - left ? max : left + right;
}

static bool NoteEditorHasIndexedTextAt(HWND hWnd, size_t offset) {
    const size_t end = SaturatingNoteEditorTextOffsetAdd(offset, 1);
    return end > offset && !GetEditTextRangeForIndexing(hWnd, offset, end).empty();
}

// Resolve a user-visible deletion unit from a small editor neighbourhood.
// BuildTextUnits is deliberately applied only to the local slice.  The slice
// grows when (and only when) its left/right edge cuts the candidate unit, so
// surrogate pairs, combining marks, variation selectors and arbitrarily long
// ZWJ sequences retain exactly the same semantics as the former whole-note
// call.  A pathological single huge grapheme may require a matching range;
// that is inherent in determining its boundary, rather than a normal-note
// O(N) copy.
static note::Span PreviousNoteEditorTextUnit(HWND hWnd, size_t caret) {
    if (!hWnd || caret == 0) return {{caret}, {caret}};

    constexpr size_t kInitialWindow = 64;
    size_t before = std::min(caret, kInitialWindow);
    size_t after = kInitialWindow;
    for (;;) {
        const size_t start = caret - before;
        const size_t end = SaturatingNoteEditorTextOffsetAdd(caret, after);
        const std::wstring text = GetEditTextRangeForIndexing(hWnd, start, end);
        const size_t localCaret = caret - start;
        if (text.size() < localCaret) return {{caret}, {caret}};

        const std::vector<note::TextUnit> units = note::BuildTextUnits(text);
        size_t index = 0;
        while (index < units.size() && units[index].span.end.value <= localCaret) ++index;
        const note::Span candidate = index == 0
            ? note::Span{{localCaret}, {localCaret}}
            : units[index - 1].span;

        const bool cutsLeft = start != 0 &&
            (index == 0 || candidate.start.value == 0);
        const bool cutsRight = index < units.size() &&
            units[index].span.start.value < localCaret &&
            units[index].span.end.value == text.size() &&
            NoteEditorHasIndexedTextAt(hWnd, end);
        if (!cutsLeft && !cutsRight) {
            return {{SaturatingNoteEditorTextOffsetAdd(start, candidate.start.value)},
                    {SaturatingNoteEditorTextOffsetAdd(start, candidate.end.value)}};
        }

        const size_t nextBefore = cutsLeft
            ? std::min(caret, SaturatingNoteEditorTextOffsetAdd(before, before))
            : before;
        const size_t nextAfter = cutsRight
            ? SaturatingNoteEditorTextOffsetAdd(after, after)
            : after;
        if (nextBefore == before && nextAfter == after) return {{caret}, {caret}};
        before = nextBefore;
        after = nextAfter;
    }
}

static note::Span NextNoteEditorTextUnit(HWND hWnd, size_t caret) {
    if (!hWnd) return {{caret}, {caret}};

    constexpr size_t kInitialWindow = 64;
    size_t before = std::min(caret, kInitialWindow);
    size_t after = kInitialWindow;
    for (;;) {
        const size_t start = caret - before;
        const size_t end = SaturatingNoteEditorTextOffsetAdd(caret, after);
        const std::wstring text = GetEditTextRangeForIndexing(hWnd, start, end);
        const size_t localCaret = caret - start;
        if (text.size() <= localCaret) return {{caret}, {caret}};

        const std::vector<note::TextUnit> units = note::BuildTextUnits(text);
        size_t index = 0;
        while (index < units.size() && units[index].span.end.value <= localCaret) ++index;
        if (index == units.size()) return {{caret}, {caret}};
        const note::Span candidate = units[index].span;

        const bool cutsLeft = start != 0 && candidate.start.value == 0;
        const bool cutsRight = candidate.end.value == text.size() &&
            NoteEditorHasIndexedTextAt(hWnd, end);
        if (!cutsLeft && !cutsRight) {
            return {{SaturatingNoteEditorTextOffsetAdd(start, candidate.start.value)},
                    {SaturatingNoteEditorTextOffsetAdd(start, candidate.end.value)}};
        }

        const size_t nextBefore = cutsLeft
            ? std::min(caret, SaturatingNoteEditorTextOffsetAdd(before, before))
            : before;
        const size_t nextAfter = cutsRight
            ? SaturatingNoteEditorTextOffsetAdd(after, after)
            : after;
        if (nextBefore == before && nextAfter == after) return {{caret}, {caret}};
        before = nextBefore;
        after = nextAfter;
    }
}

static bool RangeContainsIndexingLineBreak(HWND hWnd, size_t start, size_t end) {
    const std::wstring text = GetEditTextRangeForIndexing(hWnd, start, end);
    return text.find(L'\r') != std::wstring::npos || text.find(L'\n') != std::wstring::npos;
}

static bool RequiresImmediateNoteContentRefreshForDelete(HWND hWnd, WPARAM vkey) {
    if (!hWnd) return false;
    if (vkey != VK_BACK && vkey != VK_DELETE) return false;

    DWORD selStart = 0;
    DWORD selEnd = 0;
    SendMessageW(hWnd, EM_GETSEL,
                 reinterpret_cast<WPARAM>(&selStart),
                 reinterpret_cast<LPARAM>(&selEnd));
    if (selStart > selEnd) std::swap(selStart, selEnd);

    const int textLenRaw = GetWindowTextLengthW(hWnd);
    const size_t textLen = static_cast<size_t>((textLenRaw > 0) ? textLenRaw : 0);
    size_t delStart = std::min<size_t>(selStart, textLen);
    size_t delEnd = std::min<size_t>(selEnd, textLen);
    if (delStart == delEnd) {
        if (vkey == VK_BACK) {
            if (delStart == 0) return false;
            return RangeContainsIndexingLineBreak(hWnd, delStart - 1, delStart);
        } else {
            if (delStart >= textLen) return false;
            return RangeContainsIndexingLineBreak(hWnd, delStart, delStart + 1);
        }
    }
    if (delEnd <= delStart) return false;
    if ((delEnd - delStart) <= 256) {
        return RangeContainsIndexingLineBreak(hWnd, delStart, delEnd);
    }

    const LRESULT startLine = SendMessageW(hWnd, EM_LINEFROMCHAR, static_cast<WPARAM>(delStart), 0);
    const LRESULT endLine = SendMessageW(hWnd, EM_LINEFROMCHAR, static_cast<WPARAM>(delEnd), 0);
    return startLine >= 0 && endLine >= 0 && startLine != endLine;
}

static bool TryGetNativeNoteCaretRect(HWND hWnd, RECT* outRect) {
    if (!hWnd || !outRect) return false;

    GUITHREADINFO info{};
    info.cbSize = sizeof(info);
    if (GetGUIThreadInfo(GetCurrentThreadId(), &info) && info.hwndCaret == hWnd &&
        info.rcCaret.right > info.rcCaret.left && info.rcCaret.bottom > info.rcCaret.top) {
        *outRect = info.rcCaret;
        return true;
    }

    POINT pt{};
    if (!GetCaretPos(&pt)) {
        DWORD selStart = 0;
        DWORD selEnd = 0;
        SendMessageW(hWnd, EM_GETSEL,
                     reinterpret_cast<WPARAM>(&selStart),
                     reinterpret_cast<LPARAM>(&selEnd));
        POINT charPos{};
        if (!GetCharPos(hWnd, static_cast<size_t>(std::max(selStart, selEnd)), &charPos)) {
            return false;
        }
        pt = charPos;
    }

    HDC hdc = GetDC(hWnd);
    int caretHeight = ScaleY(hWnd, 18);
    if (hdc) {
        HFONT font = GetActiveNoteFont();
        HFONT oldFont = font ? static_cast<HFONT>(SelectObject(hdc, font)) : nullptr;
        TEXTMETRICW tm{};
        if (GetTextMetricsW(hdc, &tm) && tm.tmHeight > 0) {
            caretHeight = tm.tmHeight;
        }
        if (oldFont) SelectObject(hdc, oldFont);
        ReleaseDC(hWnd, hdc);
    }

    const auto pixel = [](int64_t value) noexcept {
        return static_cast<LONG>(std::clamp<int64_t>(
            value, std::numeric_limits<LONG>::min(), std::numeric_limits<LONG>::max()));
    };
    *outRect = {pt.x, pt.y,
        pixel(static_cast<int64_t>(pt.x) + std::max(1, ScaleY(hWnd, 1))),
        pixel(static_cast<int64_t>(pt.y) + std::max(2, caretHeight))};
    return outRect->right > outRect->left && outRect->bottom > outRect->top;
}
[[nodiscard]] static bool TryGetNoteImeCaretRect(HWND hWnd, RECT* outRect, RECT* outInputBand) {
    if (!hWnd || !outRect || !outInputBand) return false;
    // The final frame either provides the exact common caret geometry or is
    // withdrawn.  A failure must not revive a legacy line-cache measurement;
    // that would put the IME candidate window on a different visual row.
    if (FinalFrameCanUseCustomPaint(hWnd)) {
        if (TryGetFinalNoteRenderCaretRect(hWnd, outRect, outInputBand)) return true;
        WithdrawFinalNoteRenderFrame(hWnd);
        InvalidateRect(hWnd, nullptr, FALSE);
    }
    if (FinalRenderRouteEnabled(hWnd) && GetViewContext(hWnd).finalNativeRedrawDepth != 0) {
        return false; // Replacement pending, not a public whole-native view.
    }
    if (!TryGetNativeNoteCaretRect(hWnd, outRect)) return false;
    *outInputBand = *outRect;
    return true;
}

// WM_IME_REQUEST is a separate geometry reader from IMM window setters.
// The UI thread owns the published frame. Read it only: no IMM polling,
// parsing, frame publication, selection change or provisional text commit.
// Failure leaves the caller's buffer untouched; never answer final paint
// with RichEdit's hidden transport layout. Whole-native paint stays native.
[[nodiscard]] static bool TryFillFinalNoteImeCharacterPosition(
    HWND hWnd, IMECHARPOSITION* query) {
    if (!query || query->dwSize != sizeof(IMECHARPOSITION) ||
        !FinalFrameCanUseCustomPaint(hWnd)) return false;
    const auto frame = GetViewContext(hWnd).finalRenderState.frame();
    const auto* preedit = frame->presentation()->ime_preedit();
    std::optional<note::Utf16CodeUnitOffset> editorOffset;
    if (preedit) {
        // dwCharPos is UTF-16 relative to the composition start, NOT relative
        // to the current caret or the canonical replacement's old end.
        const note::Span span = preedit->editor_replacement_span();
        if (span.end < span.start || query->dwCharPos > span.end.value - span.start.value) return false;
        editorOffset = note::Utf16CodeUnitOffset{span.start.value + query->dwCharPos};
    } else if (query->dwCharPos != 0 ||
               (g_noteImeComposing && !GetViewContext(hWnd).finalImePreedit.awaiting_first_payload())) {
        return false;
    }
    // Without preedit, offset zero describes the prediction insertion point.
    // During preedit, an end boundary is valid (including an empty string).
    RECT caret{};
    if (!TryGetFinalNoteRenderCaretRect(hWnd, &caret, nullptr, editorOffset)) return false;
    RECT client{};
    if (!GetClientRect(hWnd, &client) || client.right <= client.left || client.bottom <= client.top) return false;
    POINT point{caret.left, caret.top};
    POINT top{client.left, client.top};
    POINT bottom{client.right, client.bottom};
    if (!ClientToScreen(hWnd, &point) || !ClientToScreen(hWnd, &top) ||
        !ClientToScreen(hWnd, &bottom)) return false;
    IMECHARPOSITION result = *query;
    result.pt = point;
    result.cLineHeight = static_cast<UINT>(caret.bottom - caret.top);
    result.rcDocument = {top.x, top.y, bottom.x, bottom.y};
    *query = result;
    return true;
}

void SyncNoteImeCandidateWindowToCaret(HWND hWnd, DWORD candidateMask) {
    if (!hWnd || !IsWindow(hWnd)) return;
    if (GetFocus() != hWnd) return;
    auto& context = GetViewContext(hWnd);
    if (context.imeCandidateWindowSyncInProgress || context.imeNativeDispatchInProgress) return;
    context.imeCandidateWindowSyncInProgress = true;
    struct ScopedCandidateSyncReset {
        bool& active;
        ~ScopedCandidateSyncReset() { active = false; }
    } reset{context.imeCandidateWindowSyncInProgress};

    RECT caretRc{};
    RECT inputBand{};
    if (!TryGetNoteImeCaretRect(hWnd, &caretRc, &inputBand)) return;
    RECT client{};
    if (!GetClientRect(hWnd, &client)) return;
    note::NoteImeClientRect band{inputBand.left, inputBand.top, inputBand.right, inputBand.bottom};
    if (FinalFrameCanUseCustomPaint(hWnd)) {
        // Already measured preedit fragments include every wrapped clause.
        // Protect their visible vertical envelope without scanning the note
        // or asking IMM to recompute provisional text.
        const auto frame = context.finalRenderState.frame();
        for (const auto& decoration : frame->ime_decorations()) {
            const auto& rect = decoration.rect;
            const uint64_t origin = context.finalRenderScrollY;
            const auto clientY = [origin](uint64_t y) noexcept {
                return y >= origin
                    ? static_cast<int>(std::min<uint64_t>(y - origin, std::numeric_limits<int>::max()))
                    : -static_cast<int>(std::min<uint64_t>(origin - y, std::numeric_limits<int>::max()));
            };
            band.top = std::min(band.top, clientY(rect.top_px));
            band.bottom = std::max(band.bottom, clientY(rect.bottom_px));
        }
    }
    const auto placement = note::ResolveNoteImeCandidatePlacement(
        {caretRc.left, caretRc.top, caretRc.right, caretRc.bottom}, band,
        {client.left, client.top, client.right, client.bottom}, std::max(1, ScaleY(hWnd, 6)));
    if (!placement) return;

    HIMC himc = ImmGetContext(hWnd);
    if (!himc) return;
    struct ScopedImeContextRelease {
        HWND window;
        HIMC context;
        ~ScopedImeContextRelease() { ImmReleaseContext(window, context); }
    } release{hWnd, himc};

    COMPOSITIONFORM comp{};
    comp.dwStyle = CFS_POINT;
    comp.ptCurrentPos.x = caretRc.left;
    comp.ptCurrentPos.y = caretRc.top;
    // Query IMM's actual state rather than trusting a cached request: native
    // RichEdit may reset it between publications. Avoid unchanged setters,
    // which synchronously notify the control and can make a visible list jump.
    COMPOSITIONFORM currentComp{};
    const bool compositionCurrent = ImmGetCompositionWindow(himc, &currentComp) != FALSE &&
        currentComp.dwStyle == comp.dwStyle &&
        currentComp.ptCurrentPos.x == comp.ptCurrentPos.x &&
        currentComp.ptCurrentPos.y == comp.ptCurrentPos.y;
    const bool compositionPlaced = compositionCurrent || ImmSetCompositionWindow(himc, &comp) != FALSE;

    CANDIDATEFORM cand{};
    cand.dwStyle = CFS_EXCLUDE;
    cand.ptCurrentPos = {placement->anchor_x, placement->anchor_y};
    const auto& exclude = placement->exclusion;
    cand.rcArea = {exclude.left, exclude.top, exclude.right, exclude.bottom};
    // Desktop IMM accepts candidate list indices 0..3. Notification flags
    // describe the affected lists; prediction without preedit still uses 0.
    bool candidatesPlaced = true;
    if (candidateMask == 0) candidateMask = context.imeCandidateListMask;
    candidateMask &= 0x0f;
    if (candidateMask == 0) candidateMask = 1;
    for (DWORD index = 0; index < 4; ++index) {
        if ((candidateMask & (DWORD{1} << index)) == 0) continue;
        cand.dwIndex = index;
        CANDIDATEFORM current{};
        const bool candidateCurrent = ImmGetCandidateWindow(himc, index, &current) != FALSE &&
            current.dwStyle == cand.dwStyle && EqualRect(&current.rcArea, &cand.rcArea) &&
            current.ptCurrentPos.x == cand.ptCurrentPos.x && current.ptCurrentPos.y == cand.ptCurrentPos.y;
        const bool placed = candidateCurrent || ImmSetCandidateWindow(himc, &cand) != FALSE;
        candidatesPlaced = placed && candidatesPlaced;
    }
    if ((!compositionPlaced || !candidatesPlaced) && preview_trace::IsEnabled()) {
        preview_trace::Append(L"NoteImePlacement", L"IMM rejected window positioning; native IME retained");
    }
}

// RichEdit's UIA text ranges use its own text layout, not the system caret.
// Translate the transport viewport around the published insertion point;
// never write text/selection/character or paragraph formatting, or derive
// a second visible layout. Only the native formatting viewport moves.
// At most two origin corrections are allowed (RichEdit rounds scroll and
// insets). Accessibility alignment must never withdraw a valid paint frame.
[[nodiscard]] static bool SyncNativeNoteTextAnchor(HWND hWnd, const RECT& target) {
    if (!IsRichEditControl(hWnd)) return true;
    auto& context = GetViewContext(hWnd);
    if (context.finalNativeTextOriginSyncInProgress || context.finalNativeFallbackFormatSyncInProgress) return true;
    context.finalNativeTextOriginSyncInProgress = true;
    struct ScopedAnchorReset { bool& active; ~ScopedAnchorReset() { active = false; } }
        reset{context.finalNativeTextOriginSyncInProgress};
    const auto frame = context.finalRenderState.frame();
    if (!frame) return false;
    size_t transport = 0;
    std::optional<size_t> canonical;
    if (!MapFinalEditorOffsetToRichEdit(hWnd, frame->editor_caret(), &transport, &canonical) ||
        transport > static_cast<size_t>(std::numeric_limits<LONG>::max())) return false;
    const auto nativePoint = [&]() {
        POINTL point{std::numeric_limits<LONG>::min(), std::numeric_limits<LONG>::min()};
        CallWindowProcW(g_oldNoteProc, hWnd, EM_POSFROMCHAR,
            reinterpret_cast<WPARAM>(&point), static_cast<LPARAM>(transport));
        return point;
    };
    POINTL point = nativePoint();
    if (point.x == std::numeric_limits<LONG>::min() || point.y == std::numeric_limits<LONG>::min()) return false;
    if (point.x == target.left && point.y == target.top) return true;
    // EM_SETSCROLLPOS can move already-painted pixels even without a native
    // WM_PAINT. Only the final painter may replace those pixels.
    ScopedFinalNoteNativeRedraw nativeRedraw(hWnd);
    // Restore bars before releasing redraw, including failure exits.
    struct ScopedNativeScrollRestoration {
        HWND window;
        bool needed = false;
        ~ScopedNativeScrollRestoration() {
            if (needed) SyncFinalNoteScrollBars(window);
        }
    } restoreScroll{hWnd};
    POINT scroll{};
    if (!CallWindowProcW(g_oldNoteProc, hWnd, EM_GETSCROLLPOS, 0, reinterpret_cast<LPARAM>(&scroll))) return false;
    const auto adjustedScroll = [](LONG origin, LONG native, LONG desired) {
        return static_cast<LONG>(std::clamp<int64_t>(static_cast<int64_t>(origin) + native - desired,
            0, std::numeric_limits<LONG>::max()));
    };
    POINT next{adjustedScroll(scroll.x, point.x, target.left),
               adjustedScroll(scroll.y, point.y, target.top)};
    if (next.x != scroll.x || next.y != scroll.y) {
        restoreScroll.needed = true;
        CallWindowProcW(g_oldNoteProc, hWnd, EM_SETSCROLLPOS, 0, reinterpret_cast<LPARAM>(&next));
    }
    RECT client{};
    if (!GetClientRect(hWnd, &client)) return false;
    if (target.right <= client.left || target.left >= client.right ||
        target.bottom <= client.top || target.top >= client.bottom) {
        // There is no visible insertion range to align. Keep the transport's
        // approximate scroll and the real off-screen system caret; never
        // collapse its format viewport to follow an off-screen pixel.
        SyncFinalNoteScrollBars(hWnd);
        restoreScroll.needed = false;
        return true;
    }
    for (int pass = 0; pass < 2; ++pass) {
        point = nativePoint();
        if (point.x == target.left && point.y == target.top) break;
        RECT rectangle{};
        if (!GetClientRect(hWnd, &rectangle)) return false;
        rectangle.left = std::min(rectangle.right, rectangle.left + static_cast<LONG>(kFinalNoteHorizontalPaddingPx));
        const int64_t x = static_cast<int64_t>(context.finalNativeTextOrigin.x) + target.left - point.x;
        const int64_t y = static_cast<int64_t>(context.finalNativeTextOrigin.y) + target.top - point.y;
        if (x < std::numeric_limits<LONG>::min() || x > std::numeric_limits<LONG>::max() - rectangle.right ||
            y < std::numeric_limits<LONG>::min() || y > std::numeric_limits<LONG>::max() - rectangle.bottom) return false;
        context.finalNativeTextOrigin = {static_cast<LONG>(x), static_cast<LONG>(y)};
        OffsetRect(&rectangle, static_cast<int>(x), static_cast<int>(y));
        restoreScroll.needed = true;
        CallWindowProcW(g_oldNoteProc, hWnd, EM_SETRECTNP, 0, reinterpret_cast<LPARAM>(&rectangle));
    }
    SyncFinalNoteScrollBars(hWnd);
    restoreScroll.needed = false;
    point = nativePoint();
    return context.finalRenderState.frame() == frame && point.x == target.left && point.y == target.top;
}

void SyncNativeCaretToRenderState(HWND hWnd, bool synchronizeTextAnchor) {
    if (!hWnd || GetFocus() != hWnd) return;
    if (!FinalFrameCanUseCustomPaint(hWnd)) return;

    const auto requireNativeFallback = [&]() {
        // Never keep final glyph geometry while the system caret could only
        // retain an older coordinate. No canonical text or history changes.
        WithdrawFinalNoteRenderFrame(hWnd);
        InvalidateRect(hWnd, nullptr, FALSE);
    };
    RECT rc{};
    if (!TryGetFinalNoteRenderCaretRect(hWnd, &rc)) {
        requireNativeFallback();
        return;
    }
    if (synchronizeTextAnchor) {
        const bool aligned = SyncNativeNoteTextAnchor(hWnd, rc);
        if (!aligned && preview_trace::IsEnabled()) {
            preview_trace::Append(L"NoteNativeTextAnchor", L"alignment_unavailable; final caret retained");
        }
        // Native viewport setters can synchronously publish new client
        // geometry. The system caret must use that current publication.
        if (!TryGetFinalNoteRenderCaretRect(hWnd, &rc)) return;
    }

    // Windows remains the sole caret painter: blink rate, focus lifetime and
    // accessibility observations stay native. Only its geometry comes from
    // the published final frame. Do not cache dimensions across focus loss:
    // RichEdit may have destroyed/recreated the thread's caret in between.
    DWORD caretWidth = 1;
    (void)SystemParametersInfoW(SPI_GETCARETWIDTH, 0, &caretWidth, 0);
    const int width = static_cast<int>(std::clamp<DWORD>(
        caretWidth, 1, static_cast<DWORD>(std::numeric_limits<int>::max())));
    const int height = rc.bottom - rc.top;
    GUITHREADINFO info{};
    info.cbSize = sizeof(info);
    const bool haveCaret = GetGUIThreadInfo(GetCurrentThreadId(), &info) && info.hwndCaret == hWnd;
    if (!haveCaret || info.rcCaret.right - info.rcCaret.left != width ||
        info.rcCaret.bottom - info.rcCaret.top != height) {
        if (!CreateCaret(hWnd, nullptr, width, height)) {
            requireNativeFallback();
            return;
        }
        const bool positioned = SetCaretPos(rc.left, rc.top) != FALSE;
        // CreateCaret starts hidden. Show exactly once for this new caret;
        // ordinary geometry synchronization must not alter its hide count.
        const bool shown = ShowCaret(hWnd) != FALSE;
        if (!positioned || !shown) requireNativeFallback();
    } else if (info.rcCaret.left != rc.left || info.rcCaret.top != rc.top) {
        if (!SetCaretPos(rc.left, rc.top)) requireNativeFallback();
    }
}

static bool ShouldSyncNoteImeAfterDefaultMessage(UINT msg) {
    switch (msg) {
    case WM_CHAR:
    case WM_KEYDOWN:
    case WM_KEYUP:
    case WM_MOUSEWHEEL:
    case WM_MOUSEHWHEEL:
    case WM_VSCROLL:
    case WM_HSCROLL:
    case WM_LBUTTONDOWN:
    case WM_LBUTTONUP:
    case WM_LBUTTONDBLCLK:
    case WM_SIZE:
        return true;
    default:
        return false;
    }
}

static bool ShouldSyncNativeNoteCaretAfterDefaultMessage(UINT msg) {
    switch (msg) {
    case WM_IME_STARTCOMPOSITION:
    case WM_IME_COMPOSITION:
    case WM_IME_ENDCOMPOSITION:
    case WM_CHAR:
    case WM_KEYDOWN:
    case WM_KEYUP:
    case WM_PASTE:
    case WM_CUT:
    case WM_UNDO:
    case EM_REDO:
    case WM_CLEAR:
    case WM_MOUSEWHEEL:
    case WM_MOUSEHWHEEL:
    case WM_VSCROLL:
    case WM_HSCROLL:
    case WM_LBUTTONDOWN:
    case WM_LBUTTONUP:
    case WM_LBUTTONDBLCLK:
    case WM_MOUSEMOVE:
    case WM_SIZE:
    case WM_SETFOCUS:
        return true;
    default:
        return false;
    }
}

static bool ShouldRefreshNoteLineSpacingForPresentationSurface(UINT msg) {
    switch (msg) {
    case WM_CHAR:
    case WM_KEYDOWN:
    case WM_PASTE:
    case WM_CUT:
    case WM_UNDO:
    case EM_REDO:
    case WM_CLEAR:
    case WM_LBUTTONDOWN:
    case WM_LBUTTONUP:
    case WM_LBUTTONDBLCLK:
    case WM_MOUSEMOVE:
    case WM_SETFOCUS:
        return true;
    default:
        return false;
    }
}

static void SyncRenderDrivenNoteInputUi(HWND hWnd, UINT msg) {
    if (!hWnd) return;
    const bool focused = GetFocus() == hWnd;
    const bool refreshFinalFrame = ShouldRefreshFinalNoteRenderAfterInput(msg, 0);
    // WM_SIZE reaches this function after RichEdit's default window procedure.
    // Its final geometry must be published even while focus is in another
    // pane; all other input-driven UI work still belongs to the focused edit.
    if (!focused && !(msg == WM_SIZE && refreshFinalFrame)) return;
    if (refreshFinalFrame) {
        // This runs after the native default procedure has moved its
        // selection/caret. It only reuses an exact structural publication or
        // falls back as a whole; WM_PAINT never performs this work.
        RefreshFinalNoteRenderFrame(hWnd);
    }
    if (!focused) return;
    if (ShouldRefreshNoteLineSpacingForPresentationSurface(msg)) {
        RefreshNoteLineSpacingForPresentationSurface(hWnd);
    }
    if (ShouldSyncNativeNoteCaretAfterDefaultMessage(msg)) {
        SyncNativeCaretToRenderState(hWnd);
    }
    // Prediction lists can exist without a live GCS_COMPSTR session.
    if (ShouldSyncNoteImeAfterDefaultMessage(msg)) {
        SyncNoteImeCandidateWindowToCaret(hWnd);
    }
}

static void RequestNoteContentRefreshAfterEdit(HWND hWnd) {
    if (!hWnd) return;
    SyncRenderDrivenNoteInputUi(hWnd, WM_CHAR);
    HWND parent = GetParent(hWnd);
    if (!parent) return;
    if (IsNoteImeComposing()) return;
    PostMessageW(parent, kMsgNoteOverlayUpdate, 0, static_cast<LPARAM>(CurrentEditRevision()));
}

static void MarkNoteUndoRedoTextChangedForSave(HWND hWnd, uint64_t beforeRevision) {
    if (!hWnd) return;
    HWND owner = GetParent(hWnd);
    if (!owner) owner = g_hMainWnd;
    if (g_currentNotePath.empty() && !g_currentSessionPath.empty()) {
        file_output::EnsureCurrentNotePathForStage(owner);
    }
    g_noteDirty = true;
    g_noteNeedsIntegrate = true;
    if (CurrentEditRevision() == beforeRevision) {
        NotifyEditRevisionChanged();
    }
    SetNoteTyping(true);
    file_output::NotifyNoteStageEdit(owner);
}

static bool g_noteLineSelectionActive = false;
static int g_noteLineSelectionAnchorLine = -1;
static int g_noteLineSelectionLastLine = -1;

struct NoteEditLineRange {
    size_t start = 0;
    size_t end = 0;
    size_t endWithBreak = 0;
};

static bool IsNoteLineBreakChar(wchar_t ch) {
    return ch == L'\r' || ch == L'\n';
}

static int GetNoteLineSelectionGutterWidth(HWND hWnd) {
    return std::max(ScaleY(hWnd, 18), ScaleY(hWnd, 14));
}

static int GetNoteLineSelectionHitBoxWidth(HWND hWnd) {
    return std::max(ScaleY(hWnd, 8), GetNoteLineSelectionGutterWidth(hWnd) / 2);
}

static NoteEditLineRange NoteEditLineRangeAt(const std::wstring& text, size_t pos) {
    NoteEditLineRange r{};
    pos = std::min(pos, text.size());
    r.start = FindNoteLineStart(text, pos);
    r.end = FindNoteLineEnd(text, pos);
    r.endWithBreak = r.end;
    if (r.endWithBreak < text.size() && IsNoteLineBreakChar(text[r.endWithBreak])) {
        ++r.endWithBreak;
    }
    return r;
}

struct NoteLineSelectionHit {
    int line = -1;
    size_t start = 0;
    size_t endWithBreak = 0;
};

static bool ResolveNoteLineSelectionRangeByLine(HWND hWnd, int line, size_t* outStart, size_t* outEndWithBreak) {
    if (!hWnd || line < 0 || !outStart || !outEndWithBreak) return false;
    const bool renderActive = IsNoteRenderActive();
    if (renderActive) {
        const note::NoteTextCore* core = CurrentNoteTextCore();
        if (CanReadStableRenderDerivedState() &&
            IsCurrentNoteTextCoreSynchronizedWithEditor(hWnd) && core && core->valid() &&
            core->logical_line_count() > 0 &&
            core->logical_line_count() <= static_cast<size_t>(std::numeric_limits<int>::max())) {
            const int lineCount = static_cast<int>(core->logical_line_count());
            line = std::clamp(line, 0, lineCount - 1);
            size_t lineStart = 0;
            size_t lineEnd = 0;
            size_t nextStart = 0;
            if (!QueryEditorLogicalLineRange(hWnd, line, lineCount,
                                             &lineStart, &lineEnd, &nextStart)) {
                return false;
            }
            *outStart = lineStart;
            *outEndWithBreak = (nextStart > lineStart) ? nextStart : lineEnd;
            return true;
        }

        // This path is only for an unbound/stale editor, where a current
        // TextCore range cannot be used as a geometry proof.  It preserves
        // the existing native-text fallback rather than guessing a range.
        std::wstring ownedIndexingText;
        const std::vector<size_t> starts = GetNoteLogicalLineStarts(hWnd, &ownedIndexingText);
        if (starts.empty()) {
            *outStart = 0;
            *outEndWithBreak = 0;
            return line == 0;
        }
        line = std::clamp(line, 0, static_cast<int>(starts.size()) - 1);
        size_t lineStart = 0;
        size_t lineEnd = 0;
        size_t nextStart = 0;
        if (!GetLogicalLineRangeFromStarts(ownedIndexingText, starts, line,
                                           &lineStart, &lineEnd, &nextStart)) {
            return false;
        }
        *outStart = lineStart;
        *outEndWithBreak = (nextStart > lineStart) ? nextStart : lineEnd;
        return true;
    }

    int lineCount = std::max(1, static_cast<int>(SendMessageW(hWnd, EM_GETLINECOUNT, 0, 0)));
    line = std::clamp(line, 0, lineCount - 1);
    LRESULT lineStartRes = SendMessageW(hWnd, EM_LINEINDEX, static_cast<WPARAM>(line), 0);
    if (lineStartRes < 0) return false;
    const size_t lineStart = static_cast<size_t>(lineStartRes);
    LRESULT lineLenRes = SendMessageW(hWnd, EM_LINELENGTH, static_cast<WPARAM>(lineStartRes), 0);
    if (lineLenRes < 0) lineLenRes = 0;
    size_t lineEnd = lineStart + static_cast<size_t>(lineLenRes);
    if (line + 1 < lineCount) {
        LRESULT nextStartRes = SendMessageW(hWnd, EM_LINEINDEX, static_cast<WPARAM>(line + 1), 0);
        if (nextStartRes >= 0 && static_cast<size_t>(nextStartRes) > lineStart) {
            lineEnd = static_cast<size_t>(nextStartRes);
        }
    }
    *outStart = lineStart;
    *outEndWithBreak = lineEnd;
    return true;
}

static bool ResolveNoteLineSelectionHit(HWND hWnd,
                                        int clientX,
                                        int clientY,
                                        bool requireHitBox,
                                        NoteLineSelectionHit* outHit) {
    if (!hWnd || !outHit) return false;
    outHit->line = -1;
    if (UpdateNoteVisualAssistMargins(hWnd, false)) {
        UpdateNoteFormatRect(hWnd);
    }

    const NoteLayoutFrame layoutFrame = BuildNoteLayoutFrame(hWnd);
    RECT rc = layoutFrame.client;
    if (clientY < rc.top || clientY >= rc.bottom) return false;

    HDC hdc = GetDC(hWnd);
    if (!hdc) return false;
    HFONT font = GetActiveNoteFont();
    HFONT oldFont = font ? static_cast<HFONT>(SelectObject(hdc, font)) : nullptr;
    TEXTMETRICW tm{};
    int lineHeight = ScaleY(hWnd, 18);
    int spaceW = ScaleY(hWnd, 8);
    if (GetTextMetricsW(hdc, &tm)) {
        if (tm.tmHeight > 0) lineHeight = tm.tmHeight;
        if (tm.tmAveCharWidth > 0) spaceW = tm.tmAveCharWidth;
    }
    if (oldFont) SelectObject(hdc, oldFont);
    ReleaseDC(hWnd, hdc);
    lineHeight = std::max(1, lineHeight);
    spaceW = std::max(1, spaceW);

    std::wstring ownedIndexingText;
    std::wstring_view indexingText;
    std::vector<size_t> ownedLogicalStarts;
    const std::vector<size_t>* logicalStartsPtr = nullptr;
    const bool renderActive = layoutFrame.renderActive;
    bool useCurrentEditorRanges = false;
    int currentEditorLineCount = 0;
    if (renderActive) {
        const note::NoteTextCore* core = CurrentNoteTextCore();
        if (CanReadStableRenderDerivedState() &&
            IsCurrentNoteTextCoreSynchronizedWithEditor(hWnd) && core && core->valid() &&
            core->logical_line_count() > 0 &&
            core->logical_line_count() <= static_cast<size_t>(std::numeric_limits<int>::max())) {
            useCurrentEditorRanges = true;
            currentEditorLineCount = static_cast<int>(core->logical_line_count());
        } else {
            ownedLogicalStarts = GetNoteLogicalLineStarts(hWnd, &ownedIndexingText);
            indexingText = ownedIndexingText;
            logicalStartsPtr = &ownedLogicalStarts;
        }
    }
    const std::vector<size_t> emptyLogicalStarts;
    const std::vector<size_t>& logicalStarts = logicalStartsPtr ? *logicalStartsPtr : emptyLogicalStarts;
    int lineCount = renderActive
        ? (useCurrentEditorRanges ? currentEditorLineCount
                                  : std::max<int>(1, static_cast<int>(logicalStarts.size())))
        : std::max(1, static_cast<int>(SendMessageW(hWnd, EM_GETLINECOUNT, 0, 0)));
    int maxLine = lineCount - 1;

    auto queryLineBand = [&](int line,
                             int* outTop,
                             int* outBottom,
                             size_t* outStart,
                             size_t* outEndWithBreak,
                             POINT* outPos) -> bool {
        line = std::clamp(line, 0, maxLine);
        size_t lineStart = 0;
        size_t lineEnd = 0;
        size_t nextStart = 0;
        POINT linePos{};
        int top = 0;
        int bottom = 0;
        if (renderActive) {
            if (useCurrentEditorRanges) {
                if (!QueryEditorLogicalLineBand(hWnd, line, lineCount, lineHeight,
                                                &top, &bottom, &lineStart, &lineEnd, &nextStart, &linePos)) {
                    return false;
                }
            } else {
                if (!QueryLogicalLineBandFromStarts(hWnd, indexingText, logicalStarts, line, lineHeight,
                                                    &top, &bottom, &lineStart, &lineEnd, &nextStart, &linePos)) {
                    return false;
                }
            }
            if (line == maxLine) bottom = std::max(bottom, static_cast<int>(rc.bottom));
            linePos.x = NoteLayoutFrameLineBaseXForRenderState(layoutFrame, linePos.x);
        } else {
            LRESULT lineStartRes = SendMessageW(hWnd, EM_LINEINDEX, static_cast<WPARAM>(line), 0);
            if (lineStartRes < 0) return false;
            lineStart = static_cast<size_t>(lineStartRes);
            LRESULT lineLenRes = SendMessageW(hWnd, EM_LINELENGTH, static_cast<WPARAM>(lineStartRes), 0);
            if (lineLenRes < 0) lineLenRes = 0;
            lineEnd = lineStart + static_cast<size_t>(lineLenRes);
            if (!GetCharPos(hWnd, lineStart, &linePos)) return false;
            top = linePos.y;
            bottom = top + lineHeight;
            if (line < maxLine) {
                LRESULT nextStartRes = SendMessageW(hWnd, EM_LINEINDEX, static_cast<WPARAM>(line + 1), 0);
                if (nextStartRes >= 0) {
                    nextStart = static_cast<size_t>(nextStartRes);
                    POINT nextPos{};
                    if (GetCharPos(hWnd, nextStart, &nextPos) && nextPos.y > top) {
                        bottom = nextPos.y;
                    }
                }
            } else {
                bottom = std::max(bottom, static_cast<int>(rc.bottom));
            }
        }
        if (outTop) *outTop = top;
        if (outBottom) *outBottom = std::max(top + 1, bottom);
        if (outStart) *outStart = lineStart;
        if (outEndWithBreak) *outEndWithBreak = (nextStart > lineStart) ? nextStart : lineEnd;
        if (outPos) *outPos = linePos;
        return true;
    };

    auto lineForRawIndex = [&](size_t raw) -> int {
        if (renderActive) {
            if (useCurrentEditorRanges) {
                const LRESULT editorLine = SendMessageW(
                    hWnd, EM_LINEFROMCHAR, static_cast<WPARAM>(raw), 0);
                return editorLine >= 0
                    ? std::clamp(static_cast<int>(editorLine), 0, maxLine)
                    : -1;
            }
            return FindLogicalLineForRaw(logicalStarts, raw);
        }
        const LRESULT editorLine = SendMessageW(
            hWnd, EM_LINEFROMCHAR, static_cast<WPARAM>(raw), 0);
        return editorLine >= 0 ? static_cast<int>(editorLine) : -1;
    };

    int candidate = -1;
    if (IsRichEditControl(hWnd)) {
        POINTL pt{clientX, clientY};
        LRESULT res = SendMessageW(hWnd, EM_CHARFROMPOS, 0, reinterpret_cast<LPARAM>(&pt));
        if (res >= 0) {
            candidate = lineForRawIndex(static_cast<size_t>(res));
        }
    } else {
        LRESULT res = SendMessageW(hWnd, EM_CHARFROMPOS, 0, MAKELPARAM(clientX, clientY));
        if (res != -1) {
            candidate = lineForRawIndex(static_cast<size_t>(LOWORD(res)));
        }
    }
    if (candidate < 0) candidate = std::max(0, clientY / lineHeight);
    candidate = std::clamp(candidate, 0, maxLine);

    for (int guard = 0; guard <= maxLine + 1; ++guard) {
        int top = 0;
        int bottom = 0;
        if (!queryLineBand(candidate, &top, &bottom, nullptr, nullptr, nullptr)) break;
        if (clientY < top && candidate > 0) {
            --candidate;
            continue;
        }
        if (clientY >= bottom && candidate < maxLine) {
            ++candidate;
            continue;
        }
        break;
    }

    size_t lineStart = 0;
    size_t lineEndWithBreak = 0;
    POINT linePos{};
    if (!queryLineBand(candidate, nullptr, nullptr, &lineStart, &lineEndWithBreak, &linePos)) {
        return false;
    }

    if (requireHitBox) {
        const int clientLeft = static_cast<int>(rc.left);
        const int gutterW = g_noteShowLineNumbers
            ? std::max(GetNoteLineSelectionGutterWidth(hWnd), GetNoteLineNumberGutterWidth(hWnd))
            : GetNoteLineSelectionGutterWidth(hWnd);
        const int textX = static_cast<int>(linePos.x);
        const int reservedRight = clientLeft + gutterW;
        const int right = g_noteShowLineNumbers
            ? std::min(reservedRight - ScaleY(hWnd, 2), textX - ScaleY(hWnd, 2))
            : std::min(clientLeft + GetNoteLineSelectionHitBoxWidth(hWnd), textX - ScaleY(hWnd, 2));
        const int left = clientLeft;
        if (right <= left) return false;
        if (clientX < left || clientX >= right) return false;
    }

    outHit->line = candidate;
    outHit->start = lineStart;
    outHit->endWithBreak = lineEndWithBreak;
    return true;
}

static bool SelectNoteLines(HWND hWnd, int firstLine, int lastLine) {
    if (!hWnd || firstLine < 0 || lastLine < 0) return false;
    if (lastLine < firstLine) std::swap(firstLine, lastLine);

    size_t start = 0;
    size_t ignoredEnd = 0;
    size_t ignoredStart = 0;
    size_t end = 0;
    if (!ResolveNoteLineSelectionRangeByLine(hWnd, firstLine, &start, &ignoredEnd) ||
        !ResolveNoteLineSelectionRangeByLine(hWnd, lastLine, &ignoredStart, &end)) {
        return false;
    }
    SendMessageW(hWnd, EM_SETSEL, static_cast<WPARAM>(start), static_cast<LPARAM>(end));
    SendMessageW(hWnd, EM_SCROLLCARET, 0, 0);
    SetFocus(hWnd);
    InvalidateRect(hWnd, nullptr, FALSE);
    return true;
}

static bool HandleNoteLineSelectionMouseDown(HWND hWnd, LPARAM lParam) {
    NoteLineSelectionHit hit{};
    if (!ResolveNoteLineSelectionHit(hWnd, GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam), true, &hit)) {
        return false;
    }
    g_noteLineSelectionActive = true;
    g_noteLineSelectionAnchorLine = hit.line;
    g_noteLineSelectionLastLine = hit.line;
    g_noteRenderSelecting = false;
    g_notePendingLinkClickInsert = false;
    g_notePendingCaretIdx = static_cast<size_t>(-1);
    ClearNoteLinkRenderGrace(hWnd);
    SelectNoteLines(hWnd, hit.line, hit.line);
    SetCapture(hWnd);
    return true;
}

static bool HandleNoteLineSelectionMouseMove(HWND hWnd, WPARAM wParam, LPARAM lParam) {
    if (!g_noteLineSelectionActive) return false;
    if ((wParam & MK_LBUTTON) == 0) return true;
    NoteLineSelectionHit hit{};
    if (!ResolveNoteLineSelectionHit(hWnd, GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam), false, &hit)) {
        return true;
    }
    if (hit.line != g_noteLineSelectionLastLine) {
        g_noteLineSelectionLastLine = hit.line;
        SelectNoteLines(hWnd, g_noteLineSelectionAnchorLine, hit.line);
    }
    return true;
}

static bool HandleNoteLineSelectionMouseUp(HWND hWnd) {
    if (!g_noteLineSelectionActive) return false;
    g_noteLineSelectionActive = false;
    g_noteLineSelectionAnchorLine = -1;
    g_noteLineSelectionLastLine = -1;
    if (GetCapture() == hWnd) ReleaseCapture();
    return true;
}

static bool NoteLineSelectionHitBoxAtCursor(HWND hWnd) {
    if (!hWnd) return false;
    POINT pt{};
    if (!GetCursorPos(&pt)) return false;
    if (!ScreenToClient(hWnd, &pt)) return false;
    NoteLineSelectionHit hit{};
    return ResolveNoteLineSelectionHit(hWnd, pt.x, pt.y, true, &hit);
}

static bool GetNoteEditSelectedLineBlock(HWND hWnd,
                                         const std::wstring& text,
                                         size_t* outStart,
                                         size_t* outEndWithBreak,
                                         size_t* outSelOffsetStart,
                                         size_t* outSelOffsetEnd) {
    if (!hWnd || !outStart || !outEndWithBreak || !outSelOffsetStart || !outSelOffsetEnd) return false;
    DWORD rawSelStart = 0, rawSelEnd = 0;
    SendMessageW(hWnd, EM_GETSEL,
                 reinterpret_cast<WPARAM>(&rawSelStart),
                 reinterpret_cast<LPARAM>(&rawSelEnd));
    size_t selStart = std::min<size_t>(std::min(rawSelStart, rawSelEnd), text.size());
    size_t selEnd = std::min<size_t>(std::max(rawSelStart, rawSelEnd), text.size());
    size_t endProbe = selEnd;
    if (selEnd > selStart && endProbe > 0 && IsNoteLineBreakChar(text[endProbe - 1])) {
        --endProbe;
    }
    NoteEditLineRange first = NoteEditLineRangeAt(text, selStart);
    NoteEditLineRange last = NoteEditLineRangeAt(text, endProbe);
    *outStart = first.start;
    *outEndWithBreak = std::max(first.endWithBreak, last.endWithBreak);
    *outSelOffsetStart = selStart - first.start;
    *outSelOffsetEnd = selEnd - first.start;
    return *outStart <= *outEndWithBreak && *outEndWithBreak <= text.size();
}

static bool IsNoteWhitespaceChar(wchar_t ch) {
    return ch == L' ' || ch == L'\t' || ch == L'\r' || ch == L'\n' ||
           ch == 0x3000;
}

static bool MoveNoteCaretInFinalVerticalLayout(HWND hWnd, WPARAM key, LPARAM keyFlags,
                                              bool shiftDown) {
    if (!hWnd || g_noteImeComposing || g_noteNormalMode || !FinalFrameCanUseCustomPaint(hWnd)) return false;
    note::NoteRenderFinalVerticalMove move;
    switch (key) {
    case VK_UP: move = note::NoteRenderFinalVerticalMove::Up; break;
    case VK_DOWN: move = note::NoteRenderFinalVerticalMove::Down; break;
    case VK_PRIOR: move = note::NoteRenderFinalVerticalMove::PageUp; break;
    case VK_NEXT: move = note::NoteRenderFinalVerticalMove::PageDown; break;
    default: return false;
    }
    const note::NoteTextCore* core = CurrentNoteTextCore();
    auto& context = GetViewContext(hWnd);
    const auto frame = context.finalRenderState.frame();
    note::Span selection;
    note::Utf16CodeUnitOffset active;
    if (!core || !frame || !frame->presentation() ||
        !ReadFinalCanonicalSelection(hWnd, *core, &selection, &active)) return false;
    const note::NoteDerivedSnapshotIdentity source{CurrentNoteTextCoreOwner(), CurrentNoteTextCoreRevision()};
    const auto previous = context.finalVerticalNavigation;
    const bool continuing = previous && previous->source == source &&
        previous->selection.start == selection.start && previous->selection.end == selection.end;
    size_t anchor = continuing ? previous->anchor : selection.start.value;
    if (!continuing && frame->editor_selection().start == selection.start &&
        frame->editor_selection().end == selection.end) {
        active = frame->editor_caret();
        anchor = active == selection.start ? selection.end.value : selection.start.value;
    }
    note::NoteRenderFinalCaretGeometry caret;
    if (note::ResolveNoteRenderFinalPresentationCaret(*frame->presentation(), active, &caret) !=
        note::NoteRenderFinalPresentationInteractionResult::Resolved) return false;
    const auto layoutKey = frame->presentation()->structural_publication()->layout()->layout_key();
    const int preferredX = continuing && previous->layoutKey == layoutKey ? previous->preferredX : caret.x_px;
    const auto sourceLine = note::NoteSourceLineMap::FindByOffset(core->source_line_map(), active);
    if (!sourceLine) return false;
    // Preserve the configured last-line Down action using canonical lines,
    // independent of native wrapping. Repeats never append extra newlines.
    if (key == VK_DOWN && !shiftDown && selection.start == selection.end &&
        sourceLine->line_index.value + 1 == core->logical_line_count()) {
        const auto action = ParseDownKeyLastLineAction(g_config.downKeyLastLineAction);
        if (keyFlags & 0x40000000) return true;
        if (action == DownKeyLastLineAction::None) return true;
        if (action == DownKeyLastLineAction::InsertNewline) {
            if (sourceLine->line.content_length == 0) return true;
            const auto transportEnd = FinalRawTextIndexToRichEditIndex(hWnd, *core, core->text_length());
            if (!transportEnd || *transportEnd >= std::numeric_limits<DWORD>::max()) return false;
            if (!SetNoteEditorSelectionFromCanonical(hWnd, core->text_length(), core->text_length())) return false;
            context.finalVerticalNavigation.reset();
            WithdrawFinalNoteRenderFrame(hWnd);
            RegisterExpectedCurrentNoteSelectionReplacement(hWnd, L"\r\n",
                static_cast<DWORD>(*transportEnd + 1), static_cast<DWORD>(*transportEnd + 1));
            const auto beforeRevision = CurrentEditRevision();
            SendMessageW(hWnd, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(L"\r\n"));
            if (CurrentEditRevision() == beforeRevision) RequestNoteContentRefreshAfterEdit(hWnd);
            return true;
        }
        if (!SetNoteEditorSelectionFromCanonical(hWnd, core->text_length(), core->text_length())) return false;
        context.finalVerticalNavigation.reset();
        WithdrawFinalNoteRenderFrame(hWnd);
        return true;
    }
    RECT client{};
    if (!GetClientRect(hWnd, &client)) return false;
    note::Utf16CodeUnitOffset destination;
    if (note::MoveNoteRenderFinalPresentationVertical(*frame->presentation(), active, preferredX,
            move, static_cast<uint64_t>(std::max<LONG>(1, client.bottom - client.top)), &destination) !=
        note::NoteRenderFinalPresentationInteractionResult::Resolved) return false;
    if (!shiftDown) anchor = destination.value;
    if (!SetNoteEditorSelectionFromCanonical(hWnd, anchor, destination.value)) return false;
    context.finalVerticalNavigation = LocalNoteViewContext::FinalVerticalNavigation{
        source, {{std::min(anchor, destination.value)}, {std::max(anchor, destination.value)}},
        anchor, destination.value, preferredX, layoutKey};
    WithdrawFinalNoteRenderFrame(hWnd);
    return true;
}

static bool MoveNoteCaretToSmartHomeEnd(HWND hWnd, WPARAM vkey) {
    if (!hWnd || (vkey != VK_HOME && vkey != VK_END)) return false;
    if ((GetKeyState(VK_SHIFT) & 0x8000) || (GetKeyState(VK_CONTROL) & 0x8000) ||
        (GetKeyState(VK_MENU) & 0x8000) || g_noteImeComposing) {
        return false;
    }
    DWORD selStart = 0, selEnd = 0;
    SendMessageW(hWnd, EM_GETSEL,
                 reinterpret_cast<WPARAM>(&selStart),
                 reinterpret_cast<LPARAM>(&selEnd));
    if (selStart != selEnd) return false;

    if (FinalRenderRouteEnabled(hWnd)) {
        // Source coordinates belong to the canonical line map, not to
        // RichEdit's wrapped rows / CRLF transport. Read only this source
        // line; Home/End must not materialize an arbitrarily long note.
        const note::NoteTextCore* core = CurrentNoteTextCore();
        const auto caret = TryMapFinalRouteRichEditIndexToCanonical(hWnd, selStart);
        if (!core || !core->valid() || !caret.has_value() ||
            !IsCurrentNoteTextCoreSynchronizedWithEditor(hWnd)) return false;
        const auto line = note::NoteSourceLineMap::FindByOffset(
            core->source_line_map(), { *caret });
        if (!line.has_value()) return false;
        size_t target = line->content_end.value;
        if (vkey == VK_HOME) {
            const std::wstring content = core->CopyRawRange(line->start, line->line.content_length);
            size_t leading = 0;
            while (leading < content.size() && (content[leading] == L' ' || content[leading] == L'\t')) {
                ++leading;
            }
            const size_t firstText = line->start.value + leading;
            target = *caret == firstText ? line->start.value : firstText;
        }
        if (!SetNoteEditorSelectionFromCanonical(hWnd, target, target)) return false;
        SendMessageW(hWnd, EM_SCROLLCARET, 0, 0);
        InvalidateRect(hWnd, nullptr, FALSE);
        return true;
    }

    const std::wstring text = GetEditTextForIndexing(hWnd);
    size_t caret = std::min<size_t>(selStart, text.size());
    NoteEditLineRange line = NoteEditLineRangeAt(text, caret);
    size_t target = line.start;
    if (vkey == VK_HOME) {
        size_t firstText = line.start;
        while (firstText < line.end && (text[firstText] == L' ' || text[firstText] == L'\t')) {
            ++firstText;
        }
        target = (caret == firstText) ? line.start : firstText;
    } else {
        target = line.end;
    }
    SendMessageW(hWnd, EM_SETSEL, static_cast<WPARAM>(target), static_cast<LPARAM>(target));
    SendMessageW(hWnd, EM_SCROLLCARET, 0, 0);
    InvalidateRect(hWnd, nullptr, FALSE);
    return true;
}

static bool DeleteNoteWordAroundCaret(HWND hWnd, WPARAM vkey) {
    if (!hWnd || (vkey != VK_BACK && vkey != VK_DELETE)) return false;
    if (!(GetKeyState(VK_CONTROL) & 0x8000) || (GetKeyState(VK_MENU) & 0x8000) ||
        (GetKeyState(VK_SHIFT) & 0x8000) || g_noteImeComposing) {
        return false;
    }

    DWORD rawSelStart = 0, rawSelEnd = 0;
    SendMessageW(hWnd, EM_GETSEL,
                 reinterpret_cast<WPARAM>(&rawSelStart),
                 reinterpret_cast<LPARAM>(&rawSelEnd));
    const std::wstring text = GetEditTextForIndexing(hWnd);
    size_t selStart = std::min<size_t>(std::min(rawSelStart, rawSelEnd), text.size());
    size_t selEnd = std::min<size_t>(std::max(rawSelStart, rawSelEnd), text.size());
    size_t delStart = selStart;
    size_t delEnd = selEnd;

    if (delStart == delEnd) {
        if (vkey == VK_BACK) {
            if (delStart == 0) return true;
            const note::Span span = note::PreviousTextUnitRun(text, {delStart});
            delStart = span.start.value;
            delEnd = span.end.value;
        } else {
            if (delEnd >= text.size()) return true;
            const note::Span span = note::NextTextUnitRun(text, {delEnd});
            delStart = span.start.value;
            delEnd = span.end.value;
        }
    }

    if (delEnd <= delStart) return true;
    SendMessageW(hWnd, EM_SETSEL, static_cast<WPARAM>(delStart), static_cast<LPARAM>(delEnd));
    RegisterExpectedCurrentNoteSelectionReplacement(hWnd, L"",
                                                    static_cast<DWORD>(delStart),
                                                    static_cast<DWORD>(delStart));
    SendMessageW(hWnd, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(L""));
    FinalizeImmediateNoteEdit(hWnd);
    return true;
}

static bool MoveNoteCaretByWord(HWND hWnd, bool forward, bool extendSelection) {
    if (!hWnd) return false;
    DWORD rawSelStart = 0, rawSelEnd = 0;
    SendMessageW(hWnd, EM_GETSEL,
                 reinterpret_cast<WPARAM>(&rawSelStart),
                 reinterpret_cast<LPARAM>(&rawSelEnd));
    const std::wstring text = GetEditTextForIndexing(hWnd);
    size_t caret = rawSelEnd;
    
    const note::Span span = forward
        ? note::NextTextUnitRun(text, {caret})
        : note::PreviousTextUnitRun(text, {caret});
    caret = forward ? span.end.value : span.start.value;
    
    DWORD newAnchor = extendSelection ? rawSelStart : static_cast<DWORD>(caret);
    SendMessageW(hWnd, EM_SETSEL, static_cast<WPARAM>(newAnchor), static_cast<LPARAM>(caret));
    SendMessageW(hWnd, EM_SCROLLCARET, 0, 0);
    InvalidateRect(hWnd, nullptr, FALSE);
    return true;
}

static bool MoveNoteCaretByParagraph(HWND hWnd, bool forward, bool extendSelection) {
    if (!hWnd) return false;
    DWORD rawSelStart = 0, rawSelEnd = 0;
    SendMessageW(hWnd, EM_GETSEL,
                 reinterpret_cast<WPARAM>(&rawSelStart),
                 reinterpret_cast<LPARAM>(&rawSelEnd));
    const std::wstring text = GetEditTextForIndexing(hWnd);
    size_t caret = rawSelEnd;

    if (!forward) {
        if (caret == 0) return true;
        if (caret > 0 && IsNoteLineBreakChar(text[caret - 1])) {
            --caret;
            if (caret > 0 && text[caret] == L'\n' && text[caret-1] == L'\r') --caret;
        }
        while (caret > 0) {
            if (IsNoteLineBreakChar(text[caret - 1])) {
                break;
            }
            --caret;
        }
    } else {
        if (caret >= text.size()) return true;
        while (caret < text.size()) {
            bool isBreak = IsNoteLineBreakChar(text[caret]);
            ++caret;
            if (isBreak) {
                if (caret < text.size() && text[caret-1] == L'\r' && text[caret] == L'\n') {
                    ++caret;
                }
                break;
            }
        }
    }

    DWORD newAnchor = extendSelection ? rawSelStart : static_cast<DWORD>(caret);
    SendMessageW(hWnd, EM_SETSEL, static_cast<WPARAM>(newAnchor), static_cast<LPARAM>(caret));
    SendMessageW(hWnd, EM_SCROLLCARET, 0, 0);
    InvalidateRect(hWnd, nullptr, FALSE);
    return true;
}

static bool MoveSelectedNoteLines(HWND hWnd, int direction) {
    if (!hWnd || (direction != -1 && direction != 1)) return false;
    const std::wstring text = GetEditTextForIndexing(hWnd);
    if (text.empty()) return true;

    size_t blockStart = 0, blockEnd = 0, selOffStart = 0, selOffEnd = 0;
    if (!GetNoteEditSelectedLineBlock(hWnd, text, &blockStart, &blockEnd, &selOffStart, &selOffEnd)) {
        return false;
    }
    if (blockStart >= blockEnd) return true;

    if (direction < 0) {
        if (blockStart == 0) return true;
        NoteEditLineRange prev = NoteEditLineRangeAt(text, blockStart - 1);
        size_t replaceStart = prev.start;
        std::wstring prevBlock = text.substr(prev.start, blockStart - prev.start);
        std::wstring moving = text.substr(blockStart, blockEnd - blockStart);
        std::wstring replacement;
        if (!moving.empty() && !prevBlock.empty() &&
            !IsNoteLineBreakChar(moving.back()) && IsNoteLineBreakChar(prevBlock.back())) {
            replacement = moving + std::wstring(1, prevBlock.back()) +
                          prevBlock.substr(0, prevBlock.size() - 1);
        } else {
            replacement = moving + prevBlock;
        }
        size_t newSelStart = selOffStart;
        size_t newSelEnd = selOffEnd;
        return ReplaceNoteLineBlock(hWnd, replaceStart, blockEnd, replacement, newSelStart, newSelEnd);
    }

    if (blockEnd >= text.size()) return true;
    NoteEditLineRange next = NoteEditLineRangeAt(text, blockEnd);
    if (next.endWithBreak <= blockEnd) return true;
    std::wstring moving = text.substr(blockStart, blockEnd - blockStart);
    std::wstring nextBlock = text.substr(blockEnd, next.endWithBreak - blockEnd);
    std::wstring replacement;
    size_t movedOffset = nextBlock.size();
    if (!moving.empty() && !nextBlock.empty() &&
        IsNoteLineBreakChar(moving.back()) && !IsNoteLineBreakChar(nextBlock.back())) {
        replacement = nextBlock + std::wstring(1, moving.back()) +
                      moving.substr(0, moving.size() - 1);
        ++movedOffset;
    } else {
        replacement = nextBlock + moving;
    }
    size_t newSelStart = movedOffset + selOffStart;
    size_t newSelEnd = movedOffset + selOffEnd;
    return ReplaceNoteLineBlock(hWnd, blockStart, next.endWithBreak, replacement, newSelStart, newSelEnd);
}

static bool DuplicateSelectedNoteLines(HWND hWnd) {
    if (!hWnd) return false;
    const std::wstring text = GetEditTextForIndexing(hWnd);
    size_t blockStart = 0, blockEnd = 0, selOffStart = 0, selOffEnd = 0;
    if (!GetNoteEditSelectedLineBlock(hWnd, text, &blockStart, &blockEnd, &selOffStart, &selOffEnd)) {
        return false;
    }
    if (blockStart > blockEnd || blockEnd > text.size()) return false;
    std::wstring block = text.substr(blockStart, blockEnd - blockStart);
    if (block.empty()) block = L"\r";
    std::wstring replacement;
    size_t duplicateStart = block.size();
    if (blockEnd == text.size() && !block.empty() && !IsNoteLineBreakChar(block.back())) {
        replacement = block + L"\r" + block;
        duplicateStart = block.size() + 1;
    } else {
        replacement = block + block;
    }
    return ReplaceNoteLineBlock(hWnd, blockStart, blockEnd, replacement,
                                duplicateStart + selOffStart,
                                duplicateStart + selOffEnd);
}

static bool SelectCurrentNoteLine(HWND hWnd) {
    if (!hWnd) return false;
    DWORD selStart = 0, selEnd = 0;
    SendMessageW(hWnd, EM_GETSEL,
                 reinterpret_cast<WPARAM>(&selStart),
                 reinterpret_cast<LPARAM>(&selEnd));
    const std::wstring text = GetEditTextForIndexing(hWnd);
    size_t caret = std::min<size_t>(std::min(selStart, selEnd), text.size());
    NoteEditLineRange line = NoteEditLineRangeAt(text, caret);
    SendMessageW(hWnd, EM_SETSEL, static_cast<WPARAM>(line.start), static_cast<LPARAM>(line.end));
    SendMessageW(hWnd, EM_SCROLLCARET, 0, 0);
    InvalidateRect(hWnd, nullptr, FALSE);
    return true;
}

static bool JoinCurrentNoteLineWithNext(HWND hWnd) {
    if (!hWnd) return false;
    DWORD selStart = 0, selEnd = 0;
    SendMessageW(hWnd, EM_GETSEL,
                 reinterpret_cast<WPARAM>(&selStart),
                 reinterpret_cast<LPARAM>(&selEnd));
    const std::wstring text = GetEditTextForIndexing(hWnd);
    size_t caret = std::min<size_t>(std::min(selStart, selEnd), text.size());
    NoteEditLineRange line = NoteEditLineRangeAt(text, caret);
    if (line.end >= text.size()) return true;
    size_t nextStart = line.end;
    while (nextStart < text.size() && IsNoteLineBreakChar(text[nextStart])) ++nextStart;
    size_t nextText = nextStart;
    while (nextText < text.size() && (text[nextText] == L' ' || text[nextText] == L'\t')) ++nextText;
    bool leftHasText = false;
    for (size_t i = line.start; i < line.end; ++i) {
        if (!IsNoteWhitespaceChar(text[i])) { leftHasText = true; break; }
    }
    bool rightHasText = (nextText < text.size() && !IsNoteLineBreakChar(text[nextText]));
    std::wstring replacement = (leftHasText && rightHasText) ? L" " : L"";
    SendMessageW(hWnd, EM_SETSEL, static_cast<WPARAM>(line.end), static_cast<LPARAM>(nextText));
    RegisterExpectedCurrentNoteSelectionReplacement(
        hWnd, replacement,
        static_cast<DWORD>(line.end + replacement.size()),
        static_cast<DWORD>(line.end + replacement.size()));
    SendMessageW(hWnd, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(replacement.c_str()));
    FinalizeImmediateNoteEdit(hWnd);
    return true;
}

static bool CurrentNoteSelectionOrWord(HWND hWnd, std::wstring* out) {
    if (!hWnd || !out) return false;
    out->clear();
    DWORD rawSelStart = 0, rawSelEnd = 0;
    SendMessageW(hWnd, EM_GETSEL,
                 reinterpret_cast<WPARAM>(&rawSelStart),
                 reinterpret_cast<LPARAM>(&rawSelEnd));
    const std::wstring text = GetEditTextForIndexing(hWnd);
    size_t selStart = std::min<size_t>(std::min(rawSelStart, rawSelEnd), text.size());
    size_t selEnd = std::min<size_t>(std::max(rawSelStart, rawSelEnd), text.size());
    if (selEnd > selStart) {
        *out = text.substr(selStart, selEnd - selStart);
        return !out->empty();
    }
    const note::Span span = selStart < text.size()
        ? note::NextTextUnitRun(text, {selStart})
        : note::PreviousTextUnitRun(text, {selStart});
    if (span.end <= span.start) return false;
    *out = text.substr(span.start.value, span.end.value - span.start.value);
    return !out->empty();
}

static bool BeginNoteSearchFromInsertMode(HWND hWnd, bool backward) {
    if (!hWnd || !IsWindow(hWnd) || !g_hBottomNote || !IsWindow(g_hBottomNote)) {
        ShowSoftNotice(GetParent(hWnd),
                       localization::Text(L"note.search_bar_unavailable"),
                       SoftNoticeKind::Warning);
        return false;
    }
    EnsureNoteCmdlineEdit(g_hBottomNote);
    if (!g_hNoteCmdlineEdit || !IsWindow(g_hNoteCmdlineEdit)) {
        ShowSoftNotice(GetParent(hWnd),
                       localization::Text(L"note.search_bar_unavailable"),
                       SoftNoticeKind::Warning);
        return false;
    }

    std::wstring seed;
    CurrentNoteSelectionOrWord(hWnd, &seed);
    ClearSearchHitHighlight(false);
    g_noteCmdlineActive = true;
    g_noteCmdlinePrompt = backward ? L'?' : L'/';
    g_noteCmdlineBuffer = seed;
    g_noteCmdlineFlash.clear();
    g_noteCmdlineFlashUntilTick = 0;
    SetWindowTextW(g_hNoteCmdlineEdit, seed.c_str());
    SendMessageW(g_hNoteCmdlineEdit, EM_SETSEL, 0, -1);
    SetFocus(g_hNoteCmdlineEdit);
    InvalidateRect(g_hBottomNote, nullptr, FALSE);
    return true;
}

static bool ReplaceCurrentNoteSearchHit(HWND hWnd) {
    if (!hWnd || !g_noteSearchHitActive || g_noteSearchHitEnd <= g_noteSearchHitStart) return false;
    std::wstring replacement;
    if (!PromptSimpleText(GetParent(hWnd),
                          localization::Text(L"note.replace_current_search_hit").c_str(),
                          L"", replacement)) {
        return true;
    }
    SendMessageW(hWnd, EM_SETSEL,
                 static_cast<WPARAM>(g_noteSearchHitStart),
                 static_cast<LPARAM>(g_noteSearchHitEnd));
    const DWORD after = static_cast<DWORD>(g_noteSearchHitStart + NormalizeTextForNoteIndexing(replacement).size());
    RegisterExpectedCurrentNoteSelectionReplacement(hWnd, replacement, after, after);
    SendMessageW(hWnd, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(replacement.c_str()));
    ClearSearchHitHighlight(false);
    FinalizeImmediateNoteEdit(hWnd);
    return true;
}

static LRESULT DispatchNoteImeToNative(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam) {
    auto& context = GetViewContext(hWnd);
    const bool previous = context.imeNativeDispatchInProgress;
    context.imeNativeDispatchInProgress = true;
    struct ScopedNativeImeDispatch {
        HWND window;
        bool previous;
        ~ScopedNativeImeDispatch() {
            // Native dispatch may destroy a window. Do not retain a context
            // reference or recreate it when unwinding an ended view.
            const auto found = g_viewContexts.find(window);
            if (found != g_viewContexts.end()) found->second.imeNativeDispatchInProgress = previous;
        }
    } scope{hWnd, previous};
    return CallWindowProcW(g_oldNoteProc, hWnd, msg, wParam, lParam);
}

static bool GetNoteImeResultString(HWND hWnd, LPARAM lParam, std::wstring* outResult) noexcept {
    if (!hWnd || !outResult || !(lParam & GCS_RESULTSTR)) return false;
    HIMC himc = ImmGetContext(hWnd);
    if (!himc) return false;
    const LONG kImeMaxBytes = 1 << 20;
    struct ScopedResultContextRelease {
        HWND window;
        HIMC context;
        ~ScopedResultContextRelease() { ImmReleaseContext(window, context); }
    } release{hWnd, himc};
    const LONG size = ImmGetCompositionStringW(himc, GCS_RESULTSTR, nullptr, 0);
    if (size < 0 || size >= kImeMaxBytes || size % static_cast<LONG>(sizeof(wchar_t)) != 0) return false;
    try {
        std::wstring candidate(static_cast<size_t>(size) / sizeof(wchar_t), L'\0');
        if (size > 0 && ImmGetCompositionStringW(himc, GCS_RESULTSTR, candidate.data(), size) != size) return false;
        outResult->swap(candidate);
        return true;
    } catch (const std::exception&) {
        return false;
    }
}

static bool GetNoteImeCompositionSnapshot(HWND hWnd,
                                          note::NoteImePreeditPayload* out,
                                          std::wstring* outResult = nullptr) noexcept {
    if (!hWnd || !out) return false;
    HIMC himc = ImmGetContext(hWnd);
    if (!himc) return false;
    struct ScopedImeContextRelease {
        HWND window;
        HIMC context;
        ~ScopedImeContextRelease() { ImmReleaseContext(window, context); }
    } release{hWnd, himc};

    // WM_IME_COMPOSITION flags describe fields that changed, not fields that
    // exist. Candidate selection can report only COMPATTR or CURSORPOS while
    // retaining COMPSTR. Read text and cursor from one borrowed IMM context;
    // never treat a missing change flag as the loss of the session anchor.
    const LONG kImeMaxBytes = 1 << 20;
    const LONG size = ImmGetCompositionStringW(himc, GCS_COMPSTR, nullptr, 0);
    if (size < 0 || size >= kImeMaxBytes ||
        size % static_cast<LONG>(sizeof(wchar_t)) != 0) return false;
    try {
        note::NoteImePreeditPayload candidate;
        std::wstring resultCandidate;
        if (outResult) {
            const LONG resultBytes = ImmGetCompositionStringW(himc, GCS_RESULTSTR, nullptr, 0);
            if (resultBytes < 0 || resultBytes >= kImeMaxBytes ||
                resultBytes % static_cast<LONG>(sizeof(wchar_t)) != 0) return false;
            resultCandidate.assign(static_cast<size_t>(resultBytes) / sizeof(wchar_t), L'\0');
            if (resultBytes > 0 && ImmGetCompositionStringW(himc, GCS_RESULTSTR,
                    resultCandidate.data(), resultBytes) != resultBytes) return false;
        }
        candidate.text.assign(static_cast<size_t>(size) / sizeof(wchar_t), L'\0');
        if (size > 0) {
            const LONG copied = ImmGetCompositionStringW(himc, GCS_COMPSTR, candidate.text.data(), size);
            if (copied != size) return false;
        }
        // Empty preedit has exactly one possible cursor boundary. Some IMEs
        // report IMM_ERROR_NODATA for CURSORPOS while resetting their text.
        const LONG cursor = size == 0 ? 0 :
            ImmGetCompositionStringW(himc, GCS_CURSORPOS, nullptr, 0);
        if (cursor < 0 || static_cast<size_t>(cursor) > candidate.text.size()) return false;
        candidate.caret = {static_cast<size_t>(cursor)};
        // Optional metadata is captured from the same context, independent of
        // the change flags. Never attach a partial array to the new text.
        static_assert(ATTR_INPUT == static_cast<int>(note::NoteImeCharacterAttribute::Input));
        static_assert(ATTR_FIXEDCONVERTED == static_cast<int>(note::NoteImeCharacterAttribute::FixedConverted));
        const LONG attributeBytes = ImmGetCompositionStringW(himc, GCS_COMPATTR, nullptr, 0);
        if (attributeBytes != IMM_ERROR_NODATA && attributeBytes != 0) {
            if (attributeBytes < 0 || static_cast<size_t>(attributeBytes) != candidate.text.size()) return false;
            std::vector<BYTE> attributes(static_cast<size_t>(attributeBytes));
            if (ImmGetCompositionStringW(himc, GCS_COMPATTR, attributes.data(), attributeBytes) != attributeBytes) return false;
            candidate.attributes.reserve(attributes.size());
            for (const BYTE attribute : attributes) {
                const BYTE status = attribute & 0x0f;
                if (status > ATTR_FIXEDCONVERTED) return false;
                candidate.attributes.push_back(static_cast<note::NoteImeCharacterAttribute>(status));
            }
        }
        const LONG clauseBytes = ImmGetCompositionStringW(himc, GCS_COMPCLAUSE, nullptr, 0);
        if (clauseBytes != IMM_ERROR_NODATA && clauseBytes != 0) {
            if (clauseBytes < 0 || clauseBytes % sizeof(DWORD) != 0 ||
                static_cast<size_t>(clauseBytes) / sizeof(DWORD) > candidate.text.size() + 1) return false;
            std::vector<DWORD> clauses(static_cast<size_t>(clauseBytes) / sizeof(DWORD));
            if (ImmGetCompositionStringW(himc, GCS_COMPCLAUSE, clauses.data(), clauseBytes) != clauseBytes) return false;
            candidate.clauses.reserve(clauses.size());
            for (const DWORD offset : clauses) candidate.clauses.push_back({static_cast<size_t>(offset)});
        }
        *out = std::move(candidate);
        if (outResult) outResult->swap(resultCandidate);
        return true;
    } catch (const std::exception&) {
        return false;
    }
}

static bool MoveNoteCaretIntoCommittedFullWidthParenPair(HWND hWnd, const std::wstring& committed) {
    if (!hWnd || committed != L"（）") return false;
    if (!g_config.fullWidthParenCaretInside) return false;
    DWORD rawSelStart = 0;
    DWORD rawSelEnd = 0;
    SendMessageW(hWnd, EM_GETSEL,
                 reinterpret_cast<WPARAM>(&rawSelStart),
                 reinterpret_cast<LPARAM>(&rawSelEnd));
    if (rawSelStart != rawSelEnd || rawSelStart < 2) return false;
    const std::wstring text = GetEditTextForIndexing(hWnd);
    const size_t caret = std::min<size_t>(rawSelStart, text.size());
    if (caret < 2 || text[caret - 2] != L'（' || text[caret - 1] != L'）') return false;
    const DWORD innerCaret = rawSelStart - 1;
    SendMessageW(hWnd, EM_SETSEL, innerCaret, innerCaret);
    SendMessageW(hWnd, EM_SCROLLCARET, 0, 0);
    if (g_config.fullWidthParenCancelNextLeft) {
        // IME confirmation can be followed by a synthetic left-arrow navigation.
        // The caret is already inside the pair, so consume that one navigation.
        g_ignoreNextLeftKeyUntilTick = GetTickCount64() + 2000;
    }
    FinalizeImmediateNoteEdit(hWnd);
    return true;
}

static bool GetNoteCurrentLineBand(HWND hWnd, RECT* outBand) {
    if (!hWnd || !outBand || IsNoteOpeningFocusVisualHoldActive() || GetFocus() != hWnd) return false;
    DWORD selStart = 0, selEnd = 0;
    SendMessageW(hWnd, EM_GETSEL,
                 reinterpret_cast<WPARAM>(&selStart),
                 reinterpret_cast<LPARAM>(&selEnd));
    if (selStart != selEnd) return false;
    int line = static_cast<int>(SendMessageW(hWnd, EM_LINEFROMCHAR, selStart, 0));
    if (line < 0) return false;
    LRESULT lineStart = SendMessageW(hWnd, EM_LINEINDEX, static_cast<WPARAM>(line), 0);
    if (lineStart < 0) return false;
    POINT pos{};
    if (!GetCharPos(hWnd, static_cast<size_t>(lineStart), &pos)) return false;

    HDC metricDc = GetDC(hWnd);
    int lineH = ScaleY(hWnd, 18);
    if (metricDc) {
        HFONT font = GetActiveNoteFont();
        HFONT old = font ? static_cast<HFONT>(SelectObject(metricDc, font)) : nullptr;
        TEXTMETRICW tm{};
        if (GetTextMetricsW(metricDc, &tm) && tm.tmHeight > 0) lineH = tm.tmHeight;
        if (old) SelectObject(metricDc, old);
        ReleaseDC(hWnd, metricDc);
    }
    RECT rc{};
    GetClientRect(hWnd, &rc);
    *outBand = RECT{rc.left, pos.y, rc.right, pos.y + std::max(1, lineH)};
    return outBand->bottom > outBand->top && outBand->right > outBand->left;
}

static void DrawNoteCurrentLineHighlight(HWND hWnd, HDC hdc, bool fillBand) {
    if (!hWnd || !hdc) return;
    RECT band{};
    if (!GetNoteCurrentLineBand(hWnd, &band)) return;
    COLORREF col = BlendColor(g_noteBgColor, g_theme.accent, (Luma(g_noteBgColor) >= 128) ? 0.08 : 0.16);
    if (fillBand) {
        HBRUSH br = CreateSolidBrush(col);
        if (br) {
            GetViewContext(hWnd).currentLineHighlightPainted = FillRect(hdc, &band, br) != 0;
            DeleteObject(br);
        }
    }
}

static void DrawNoteEditVisualAssistOverlay(HWND hWnd, HDC hdc) {
    if (!hWnd || !hdc) return;
    if (!g_noteShowInvisibleChars && !g_noteShowLineNumbers) return;
    RECT rc{};
    GetClientRect(hWnd, &rc);
    HDC metricDc = hdc;
    HFONT font = GetActiveNoteFont();
    HFONT oldFont = font ? static_cast<HFONT>(SelectObject(metricDc, font)) : nullptr;
    TEXTMETRICW tm{};
    GetTextMetricsW(metricDc, &tm);
    int lineH = std::max<int>(1, static_cast<int>(tm.tmHeight));
    COLORREF oldText = SetTextColor(hdc, BlendColor(g_noteFgColor, g_noteBgColor, 0.62));
    int oldBk = SetBkMode(hdc, TRANSPARENT);

    int firstLine = static_cast<int>(SendMessageW(hWnd, EM_GETFIRSTVISIBLELINE, 0, 0));
    int lineCount = std::max(1, static_cast<int>(SendMessageW(hWnd, EM_GETLINECOUNT, 0, 0)));
    int visible = std::max<int>(1, static_cast<int>((rc.bottom - rc.top) / lineH + 3));
    int lastLine = std::min(lineCount - 1, firstLine + visible);
    for (int line = std::max(0, firstLine); line <= lastLine; ++line) {
        LRESULT lineStartRes = SendMessageW(hWnd, EM_LINEINDEX, static_cast<WPARAM>(line), 0);
        if (lineStartRes < 0) continue;
        size_t lineStart = static_cast<size_t>(lineStartRes);
        POINT linePos{};
        if (!GetCharPos(hWnd, lineStart, &linePos)) continue;
        if (g_noteShowLineNumbers) {
            std::wstring num = std::to_wstring(line + 1);
            int gutter = std::max(ScaleY(hWnd, 18), GetNoteLineNumberGutterWidth(hWnd));
            RECT numRc{rc.left, linePos.y,
                       std::min<LONG>(rc.right, rc.left + gutter - ScaleY(hWnd, 6)),
                       linePos.y + lineH};
            DrawTextW(hdc, num.c_str(), static_cast<int>(num.size()), &numRc,
                      DT_RIGHT | DT_TOP | DT_SINGLELINE | DT_NOPREFIX | DT_NOCLIP);
        }
        if (!g_noteShowInvisibleChars) continue;
        LRESULT lineEndRes = (line + 1 < lineCount)
            ? SendMessageW(hWnd, EM_LINEINDEX, static_cast<WPARAM>(line + 1), 0)
            : GetWindowTextLengthW(hWnd);
        if (lineEndRes < 0 || static_cast<size_t>(lineEndRes) <= lineStart) continue;
        const size_t lineEnd = static_cast<size_t>(lineEndRes);
        // The assist overlay paints only visible display lines. Read precisely
        // that range rather than the full note on every WM_PAINT; this keeps
        // tabs visible without making a long document's paint cost O(N).
        const std::wstring lineText = GetEditTextRangeForIndexing(hWnd, lineStart, lineEnd);
        for (size_t offset = 0; offset < lineText.size(); ++offset) {
            const wchar_t ch = lineText[offset];
            if (ch != L' ' && ch != L'\t' && ch != 0x3000) continue;
            POINT p{};
            if (!GetCharPos(hWnd, lineStart + offset, &p)) continue;
            const wchar_t* mark = (ch == L'\t') ? L"\u2192" : L"\u00b7";
            TextOutW(hdc, p.x, p.y, mark, 1);
        }
        if (!lineText.empty() && IsNoteLineBreakChar(lineText.back())) {
            POINT p{};
            const size_t breakIndex = lineStart + lineText.size() - 1;
            if (GetCharPos(hWnd, breakIndex, &p)) {
                TextOutW(hdc, p.x, p.y, L"\u00b6", 1);
            }
        }
    }

    SetBkMode(hdc, oldBk);
    SetTextColor(hdc, oldText);
    if (oldFont) SelectObject(metricDc, oldFont);
}

// ---------------------------------------------------------------------
// NoteEdit サブクラスプロシージャ
// ---------------------------------------------------------------------
static bool BlockNoteEditInputDuringSave(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam) {
    (void)wParam;
    (void)lParam;
    if (!IsSaveTransactionRunning()) return false;
    switch (msg) {
    case WM_MOUSEWHEEL:
    case WM_MOUSEHWHEEL:
    case WM_VSCROLL:
    case WM_HSCROLL:
    case WM_PAINT:
    case WM_NCPAINT:
    case WM_ERASEBKGND:
        return false;
    case WM_SETCURSOR:
        if (LOWORD(lParam) == HTCLIENT && reinterpret_cast<HWND>(wParam) == hWnd) {
            SetCursor(LoadCursor(nullptr, IDC_ARROW));
            return true;
        }
        return false;
    case WM_LBUTTONDOWN:
    case WM_LBUTTONDBLCLK:
    case WM_LBUTTONUP:
    case WM_RBUTTONDOWN:
    case WM_RBUTTONUP:
    case WM_CONTEXTMENU:
    case WM_MBUTTONDOWN:
    case WM_MBUTTONUP:
    case WM_MOUSEMOVE:
    case WM_KEYDOWN:
    case WM_KEYUP:
    case WM_SYSKEYDOWN:
    case WM_SYSKEYUP:
    case WM_CHAR:
    case WM_PASTE:
    case WM_CUT:
    case WM_UNDO:
    case EM_REDO:
    case WM_CLEAR:
    case WM_IME_STARTCOMPOSITION:
    case WM_IME_COMPOSITION:
    case WM_IME_ENDCOMPOSITION:
        return true;
    default:
        return false;
    }
}
