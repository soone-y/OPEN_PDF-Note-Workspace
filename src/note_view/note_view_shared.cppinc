static std::wstring StripMathDelims(const std::wstring& raw) {
    if (raw.size() >= 4 && raw[0] == L'\\' && raw[1] == L'[' &&
        raw[raw.size() - 2] == L'\\' && raw[raw.size() - 1] == L']') {
        return raw.substr(2, raw.size() - 4);
    }
    if (raw.size() >= 4 && raw[0] == L'\\' && raw[1] == L'(' &&
        raw[raw.size() - 2] == L'\\' && raw[raw.size() - 1] == L')') {
        return raw.substr(2, raw.size() - 4);
    }
    if (raw.size() >= 2 && raw.front() == L'$' && raw.back() == L'$') {
        if (raw.size() >= 4 && raw[1] == L'$' && raw[raw.size() - 2] == L'$') {
            return raw.substr(2, raw.size() - 4);
        }
        return raw.substr(1, raw.size() - 2);
    }
    if (raw.size() >= 9 && StartsWithAsciiNoCase(raw, L"<math>")) {
        if (EndsWithAsciiNoCase(raw, L"</>")) {
            return raw.substr(6, raw.size() - 9);
        }
        if (EndsWithAsciiNoCase(raw, L"</math>")) {
            return raw.substr(6, raw.size() - 13);
        }
    }
    return raw;
}

static bool HandleLinkIdJump(const std::wstring& linkId,
                             HWND hWnd,
                             const std::wstring& sourceNotePath = L"",
                             std::optional<size_t> sourcePos = std::nullopt) {
    if (linkId.empty()) return false;

    for (const auto& ann : g_annots) {
        if (ann.type != Annotation::Type::LinkMarker) continue;
        if (ann.linkId != linkId) continue;
        if (g_hPdfView) {
            JumpToPdfPoint(g_hPdfView, ann.pageIndex, ann.x1, ann.y1);
            SetFocus(g_hPdfView);
            return true;
        }
    }
    std::wstring targetPdf;
    Annotation hit{};
    if (FindPdfLinkHit(linkId, targetPdf, hit)) {
        HWND owner = g_hPdfView ? GetParent(g_hPdfView) : nullptr;
        if (!owner) owner = g_hMainWnd;
        EndIntegratedPdfPreviewMode(owner, true);
        if (OpenPdfWithAnnotations(owner, targetPdf)) {
            Annotation latest{};
            if (FindLinkAnnotation(g_annots, linkId, &latest)) {
                hit = latest;
            }
            if (g_hPdfView) {
                JumpToPdfPoint(g_hPdfView, hit.pageIndex, hit.x1, hit.y1);
                SetFocus(g_hPdfView);
                return true;
            }
        }
    }

    // 3. Try note jump
    if (JumpToNoteLinkId(linkId, L"", false, sourceNotePath, sourcePos)) return true;

    if (hWnd) {
        ShowSoftNotice(hWnd, localization::Text(L"note.link_target_not_found"));
    }
    return false;
}

enum class LinkVerifyState { Unknown, Known };

struct LinkVerifyEntry {
    LinkVerifyState state = LinkVerifyState::Unknown;
    bool exists = false;
    ULONGLONG checkedAt = 0;
};

static std::unordered_map<std::wstring, LinkVerifyEntry> g_linkVerifyCache;
// A cache refresh invalidates the measurement, not the last usable canvas extent.
// Keep displaying the committed extent until a fresh measurement succeeds.

static bool CurrentPdfHasLinkMarker(const std::wstring& linkId) {
    if (linkId.empty()) return false;
    for (const auto& ann : g_annots) {
        if (ann.type != Annotation::Type::LinkMarker) continue;
        if (ann.linkId != linkId) continue;
        return true;
    }
    return false;
}

static bool ComputeLinkTargetExistsNow(const std::wstring& linkId) {
    if (linkId.empty()) return false;
    // 1) currently loaded PDF markers.
    if (CurrentPdfHasLinkMarker(linkId)) return true;
    // 2) other PDFs (annotation files; may hit disk)
    std::wstring pdfPath;
    Annotation out{};
    if (FindPdfLinkHit(linkId, pdfPath, out)) return true;
    // 3) other notes (scan files; may hit disk)
    if (FindNoteTargetForLinkId(linkId, g_currentNotePath)) return true;
    return false;
}

static bool PdfLinkTargetExistsCachedOrQueue(HWND hWnd, const std::wstring& linkId) {
    (void)hWnd;
    if (linkId.empty()) return false;
    const ULONGLONG now = GetTickCount64();
    auto it = g_linkVerifyCache.find(linkId);
    if (it != g_linkVerifyCache.end()) {
        LinkVerifyEntry& e = it->second;
        if (e.state == LinkVerifyState::Known) {
            if (now - e.checkedAt <= kLinkVerifyTtlMs) {
                return e.exists;
            }
            e.state = LinkVerifyState::Unknown;
        }
    }

    bool exists = false;
    try {
        exists = ComputeLinkTargetExistsNow(linkId);
    } catch (const std::exception& ex) {
        AppendCrashLogWide(L"LinkVerify", UTF8ToWide(ex.what()));
    } catch (...) {
        AppendCrashLogWide(L"LinkVerify", L"unknown exception");
    }
    LinkVerifyEntry& entry = g_linkVerifyCache[linkId];
    entry.exists = exists;
    entry.checkedAt = now;
    entry.state = LinkVerifyState::Known;
    return exists;
}

static bool LinkTargetExistsForCurrentNoteSource(HWND hWnd,
                                                 const std::wstring& linkId,
                                                 std::optional<size_t> sourcePos) {
    if (linkId.empty()) return false;
    if (PdfLinkTargetExistsCachedOrQueue(hWnd, linkId)) return true;
    if (CurrentNoteHasLinkTargetExcluding(linkId, sourcePos)) return true;
    return false;
}

static bool IsRichEditControl(HWND hWnd) {
    if (!hWnd) return false;
    wchar_t cls[32]{};
    if (!GetClassNameW(hWnd, cls, static_cast<int>(sizeof(cls) / sizeof(cls[0])))) return false;
    // Accept both "RICHEDIT50W" (MSFTEDIT) and "RichEdit20W" (Riched20) regardless of casing.
    return _wcsnicmp(cls, L"RICHEDIT", 8) == 0;
}

// Keep the localized string alive through the AppendMenuW call below. Returning
// a pointer into Text()'s temporary result would leave a dangling pointer.
static std::wstring NoteMenuLabelCut() { return localization::Text(L"note.menu.cut"); }
static std::wstring NoteMenuLabelCopy() { return localization::Text(L"note.menu.copy"); }
static std::wstring NoteMenuLabelCopyWithTags() { return localization::Text(L"note.menu.copy_with_tags"); }
static std::wstring NoteMenuLabelPaste() { return localization::Text(L"note.menu.paste"); }
static std::wstring NoteMenuLabelSelectAll() { return localization::Text(L"note.menu.select_all"); }
static std::wstring NoteMenuLabelSelectNone() { return localization::Text(L"note.menu.select_none"); }

static void ShowNoteCopySuccessNotice(HWND owner) {
    ShowSoftNotice(owner ? owner : g_hMainWnd,
                   localization::Text(L"note.copy_success"),
                   SoftNoticeKind::Info);
}

static bool CopyNoteNormalVisualSelection(HWND owner, bool includeTags) {
    if (!g_hNoteEdit || !IsNoteNormalVisualActive()) return false;
    auto range = NoteNormalSelectionRange();
    if (range.second <= range.first) return false;
    std::wstring text;
    if (includeTags) {
        text = GetEditText(g_hNoteEdit);
        if (range.first >= text.size()) return false;
        range.second = std::min(range.second, text.size());
        text = text.substr(range.first, range.second - range.first);
    } else {
        text = ExtractRenderedTextRange(range.first, range.second);
    }
    if (!SetClipboardUnicodeText(owner ? owner : g_hMainWnd, text)) return false;
    ShowNoteCopySuccessNotice(owner);
    return true;
}

static void ShowNoteContextMenu(HWND hWnd, POINT screenPt) {
    if (!hWnd) return;
    if (screenPt.x == -1 && screenPt.y == -1) {
        GetCursorPos(&screenPt);
    }

    DWORD selStart = 0;
    DWORD selEnd = 0;
    SendMessageW(hWnd, EM_GETSEL, reinterpret_cast<WPARAM>(&selStart), reinterpret_cast<LPARAM>(&selEnd));
    const bool hasSelection = (selStart != selEnd);
    const bool canPaste = IsClipboardFormatAvailable(CF_UNICODETEXT) != 0;
    const bool hasText = GetWindowTextLengthW(hWnd) > 0;

    enum : UINT {
        ID_CTX_CUT = 1,
        ID_CTX_COPY,
        ID_CTX_COPY_WITH_TAGS,
        ID_CTX_PASTE,
        ID_CTX_SELECT_ALL,
        ID_CTX_SELECT_NONE
    };

    HMENU menu = CreatePopupMenu();
    if (!menu) return;
    const bool normalVisual = (g_noteVimModeEnabled && g_noteNormalMode && IsNoteNormalVisualActive());
    if (normalVisual) {
        AppendMenuW(menu, MF_STRING | (hasSelection ? 0 : MF_GRAYED), ID_CTX_COPY, NoteMenuLabelCopy().c_str());
        AppendMenuW(menu, MF_STRING | (hasSelection ? 0 : MF_GRAYED), ID_CTX_COPY_WITH_TAGS, NoteMenuLabelCopyWithTags().c_str());
    } else {
    AppendMenuW(menu, MF_STRING | (hasSelection ? 0 : MF_GRAYED), ID_CTX_CUT, NoteMenuLabelCut().c_str());
    AppendMenuW(menu, MF_STRING | (hasSelection ? 0 : MF_GRAYED), ID_CTX_COPY, NoteMenuLabelCopy().c_str());
    AppendMenuW(menu, MF_STRING | (canPaste ? 0 : MF_GRAYED), ID_CTX_PASTE, NoteMenuLabelPaste().c_str());
    AppendMenuW(menu, MF_SEPARATOR, 0, nullptr);
    AppendMenuW(menu, MF_STRING | (hasText ? 0 : MF_GRAYED), ID_CTX_SELECT_ALL, NoteMenuLabelSelectAll().c_str());
    AppendMenuW(menu, MF_STRING | (hasSelection ? 0 : MF_GRAYED), ID_CTX_SELECT_NONE, NoteMenuLabelSelectNone().c_str());
    }

    UINT cmd = TrackPopupMenu(menu, TPM_RETURNCMD | TPM_RIGHTBUTTON, screenPt.x, screenPt.y, 0, hWnd, nullptr);
    DestroyMenu(menu);
    if (!cmd) {
        if (normalVisual) {
            ClearNoteNormalVisualMode();
        }
        return;
    }

    switch (cmd) {
    case ID_CTX_CUT:
        SendMessageW(hWnd, WM_CUT, 0, 0);
        break;
    case ID_CTX_COPY:
        if (normalVisual) {
            CopyNoteNormalVisualSelection(hWnd, false);
        } else {
            SendMessageW(hWnd, WM_COPY, 0, 0);
        }
        break;
    case ID_CTX_COPY_WITH_TAGS:
        CopyNoteNormalVisualSelection(hWnd, true);
        break;
    case ID_CTX_PASTE:
        SendMessageW(hWnd, WM_PASTE, 0, 0);
        break;
    case ID_CTX_SELECT_ALL:
        SendMessageW(hWnd, EM_SETSEL, 0, -1);
        break;
    case ID_CTX_SELECT_NONE: {
        DWORD caret = selEnd;
        SendMessageW(hWnd, EM_SETSEL, caret, caret);
        break;
    }
    default:
        break;
    }
}

static bool GetCharPos(HWND hWnd, size_t index, POINT* out) {
    if (!out || !hWnd) return false;
    if (IsRichEditControl(hWnd)) {
        POINTL pt{};
        LRESULT res = SendMessageW(hWnd, EM_POSFROMCHAR,
                                   reinterpret_cast<WPARAM>(&pt),
                                   static_cast<LPARAM>(index));
        if (res == -1) return false;
        out->x = static_cast<int>(pt.x);
        out->y = static_cast<int>(pt.y);
        return true;
    }
    LRESULT pos = SendMessageW(hWnd, EM_POSFROMCHAR, static_cast<WPARAM>(index), 0);
    if (pos == -1) return false;
    out->x = GET_X_LPARAM(pos);
    out->y = GET_Y_LPARAM(pos);
    return true;
}


bool ResolveCtrlInsertNavKey(HWND hWnd, WPARAM wParam,
                             WPARAM* outNavKey, wchar_t* outSuppressedChar) {
    if (!hWnd || !outNavKey) return false;
    if ((GetKeyState(VK_CONTROL) & 0x8000) == 0) return false;
    if ((GetKeyState(VK_MENU) & 0x8000) != 0) return false;

    UINT vk = static_cast<UINT>(wParam);
    if (vk == VK_PROCESSKEY) {
        UINT imeVk = static_cast<UINT>(ImmGetVirtualKey(hWnd));
        if (imeVk != 0) {
            vk = imeVk;
        }
    }

    switch (vk) {
    case 'H':
        *outNavKey = VK_LEFT;
        if (outSuppressedChar) *outSuppressedChar = L'\b';
        return true;
    case 'J':
        *outNavKey = VK_DOWN;
        if (outSuppressedChar) *outSuppressedChar = L'\n';
        return true;
    case 'K':
        *outNavKey = VK_UP;
        if (outSuppressedChar) *outSuppressedChar = 0x0B;
        return true;
    case 'L':
        *outNavKey = VK_RIGHT;
        if (outSuppressedChar) *outSuppressedChar = 0x0C;
        return true;
    default:
        return false;
    }
}

bool ForwardImeNavigationKey(HWND hWnd, WPARAM navKey) {
    if (!hWnd) return false;
    HWND imeWnd = ImmGetDefaultIMEWnd(hWnd);
    if (!imeWnd || !IsWindow(imeWnd)) return false;
    SendMessageW(imeWnd, WM_IME_KEYDOWN, navKey, 0);
    SendMessageW(imeWnd, WM_IME_KEYUP, navKey, 0);
    return true;
}

bool IsImeComposingOnEditWindow(HWND hWnd) {
    if (!hWnd || !IsWindow(hWnd)) return false;
    HIMC himc = ImmGetContext(hWnd);
    if (!himc) return false;
    const LONG compBytes = ImmGetCompositionStringW(himc, GCS_COMPSTR, nullptr, 0);
    ImmReleaseContext(hWnd, himc);
    return compBytes > 0;
}

static void SetEditCaretPosNoSelect(HWND hWnd, size_t caret) {
    if (!hWnd) return;
    int len = GetWindowTextLengthW(hWnd);
    if (len < 0) len = 0;
    const size_t safeCaret = std::min<size_t>(caret, static_cast<size_t>(len));
    SendMessageW(hWnd, EM_SETSEL,
                 static_cast<WPARAM>(safeCaret),
                 static_cast<LPARAM>(safeCaret));
    SendMessageW(hWnd, EM_SCROLLCARET, 0, 0);
}

bool MoveEditCaretForInsertNav(HWND hWnd, WPARAM navKey) {
    if (!hWnd) return false;

    DWORD selStart = 0;
    DWORD selEnd = 0;
    SendMessageW(hWnd, EM_GETSEL,
                 reinterpret_cast<WPARAM>(&selStart),
                 reinterpret_cast<LPARAM>(&selEnd));

    if (navKey == VK_LEFT) {
        size_t caret = (selStart == selEnd)
                           ? static_cast<size_t>(selStart)
                           : static_cast<size_t>(std::min(selStart, selEnd));
        if (caret > 0) {
            --caret;
        }
        SetEditCaretPosNoSelect(hWnd, caret);
        return true;
    }

    if (navKey == VK_RIGHT) {
        int len = GetWindowTextLengthW(hWnd);
        if (len < 0) len = 0;
        size_t caret = (selStart == selEnd)
                           ? static_cast<size_t>(selStart)
                           : static_cast<size_t>(std::max(selStart, selEnd));
        if (caret < static_cast<size_t>(len)) {
            ++caret;
        }
        SetEditCaretPosNoSelect(hWnd, caret);
        return true;
    }

    size_t caret = static_cast<size_t>((navKey == VK_DOWN)
                                           ? std::max(selStart, selEnd)
                                           : std::min(selStart, selEnd));
    int lineCount = static_cast<int>(SendMessageW(hWnd, EM_GETLINECOUNT, 0, 0));
    if (lineCount <= 0) lineCount = 1;

    int currentLine = static_cast<int>(SendMessageW(hWnd, EM_LINEFROMCHAR,
                                                    static_cast<WPARAM>(caret), 0));
    if (currentLine < 0) currentLine = 0;
    const int delta = (navKey == VK_DOWN) ? 1 : -1;
    const int targetLine = std::clamp(currentLine + delta, 0, lineCount - 1);
    if (targetLine == currentLine) {
        SetEditCaretPosNoSelect(hWnd, caret);
        return true;
    }

    POINT caretPos{};
    if (!GetCharPos(hWnd, caret, &caretPos)) {
        SetEditCaretPosNoSelect(hWnd, caret);
        return true;
    }

    LRESULT targetLineStartRes = SendMessageW(hWnd, EM_LINEINDEX,
                                              static_cast<WPARAM>(targetLine), 0);
    if (targetLineStartRes < 0) {
        SetEditCaretPosNoSelect(hWnd, caret);
        return true;
    }

    POINT targetLinePos{};
    if (!GetCharPos(hWnd, static_cast<size_t>(targetLineStartRes), &targetLinePos)) {
        SetEditCaretPosNoSelect(hWnd, static_cast<size_t>(targetLineStartRes));
        return true;
    }

    size_t nextCaret = static_cast<size_t>(targetLineStartRes);
    if (IsRichEditControl(hWnd)) {
        POINTL probe{
            static_cast<LONG>(caretPos.x),
            static_cast<LONG>(targetLinePos.y + 1)
        };
        LRESULT res = SendMessageW(hWnd, EM_CHARFROMPOS, 0, reinterpret_cast<LPARAM>(&probe));
        if (res >= 0) {
            nextCaret = static_cast<size_t>(res);
        }
    } else {
        DWORD res = static_cast<DWORD>(SendMessageW(hWnd, EM_CHARFROMPOS, 0,
                                                    MAKELPARAM(caretPos.x, targetLinePos.y + 1)));
        nextCaret = static_cast<size_t>(LOWORD(res));
    }

    SetEditCaretPosNoSelect(hWnd, nextCaret);
    return true;
}

static bool IsNoteRenderActive() {
    return CurrentNoteSupportsRenderOverlay() && g_noteRenderEnabled && !g_noteRawOnly;
}

static bool IsNoteMathRenderActive() {
    return note::NoteMathRenderEnabledForRoute(
        IsNoteRenderActive(), g_noteRenderMath, CurrentNoteUsesTeXMathOnlyRender());
}

static bool IsNoteWrapToggleAvailable() {
    return !IsNoteRenderActive();
}



static void PaintNoteSwitchPlaceholder(HDC hdc, const RECT& rc) {
    if (g_hThemeNoteBrush) {
        FillRect(hdc, &rc, g_hThemeNoteBrush);
        return;
    }
    HBRUSH br = CreateSolidBrush(g_noteBgColor);
    FillRect(hdc, &rc, br);
    DeleteObject(br);
}

bool BeginNoteRenderSwitch() {
    ++g_noteRenderSwitchDepth;
    if (g_noteRenderSwitchDepth != 1) return true;
    g_noteRenderSwitchBlocked = true;
    if (g_hNoteEdit) {
        // A mode transition invalidates the final frame's layout/owner contract.
        // Remove it before the native control is exposed, so no input or paint
        // path can use geometry from the pre-transition configuration.
        WithdrawFinalNoteRenderFrame(g_hNoteEdit);
        // Replace the current frame immediately so stale rendered text is not left visible
        // while the transition updates the configuration on the UI thread.
        RedrawWindow(g_hNoteEdit, nullptr, nullptr,
                     RDW_INVALIDATE | RDW_ERASE | RDW_UPDATENOW | RDW_NOCHILDREN);
        SendMessageW(g_hNoteEdit, WM_SETREDRAW, FALSE, 0);
    }
    if (g_hBottomNote) {
        SendMessageW(g_hBottomNote, WM_SETREDRAW, FALSE, 0);
    }
    if (g_hBottomMath) {
        SendMessageW(g_hBottomMath, WM_SETREDRAW, FALSE, 0);
    }
    return true;
}

void EndNoteRenderSwitch() {
    if (g_noteRenderSwitchDepth <= 0) return;
    --g_noteRenderSwitchDepth;
    if (g_noteRenderSwitchDepth != 0) return;
    const ULONGLONG startTick = preview_trace::TickNow();
    preview_trace::Append(
        L"EndNoteRenderSwitch",
        L"begin noteEdit=" + preview_trace::Window(g_hNoteEdit) +
        L" bottomNote=" + preview_trace::Window(g_hBottomNote) +
        L" bottomMath=" + preview_trace::Window(g_hBottomMath));
    g_noteRenderSwitchBlocked = false;

    // Complete the state transition while child redraw remains suppressed.
    // RecomputeMathFromNote publishes either one complete final frame or no
    // final frame at all.  It deliberately does not rebuild the retired
    // LineCache before attempting that publication.  Thus the first exposed
    // paint after a mode/file/settings transition is owned by exactly one of
    // final custom paint and whole-client native fallback.
    if (g_hNoteEdit) {
        RecomputeMathFromNote();
    }
    preview_trace::Append(
        L"EndNoteRenderSwitch",
        L"after_final_publication elapsed_ms=" + preview_trace::ElapsedMs(startTick));

    auto enableRedraw = [](HWND hWnd) {
        if (!hWnd) return;
        SendMessageW(hWnd, WM_SETREDRAW, TRUE, 0);
        InvalidateRect(hWnd, nullptr, FALSE);
    };
    enableRedraw(g_hNoteEdit);
    enableRedraw(g_hBottomNote);
    enableRedraw(g_hBottomMath);
    preview_trace::Append(
        L"EndNoteRenderSwitch",
        L"after_enable_redraw elapsed_ms=" + preview_trace::ElapsedMs(startTick));

    // Coalesce repaint into a single synchronous pass to avoid visible intermediate frames.
    HWND root = nullptr;
    if (g_hNoteEdit) root = GetAncestor(g_hNoteEdit, GA_ROOT);
    if (!root && g_hBottomNote) root = GetAncestor(g_hBottomNote, GA_ROOT);
    if (!root && g_hBottomMath) root = GetAncestor(g_hBottomMath, GA_ROOT);
    preview_trace::Append(
        L"EndNoteRenderSwitch",
        L"after_resolve_root root=" + preview_trace::Window(root) +
        L" elapsed_ms=" + preview_trace::ElapsedMs(startTick));
    if (root) {
        RedrawWindow(root, nullptr, nullptr,
                     RDW_INVALIDATE | RDW_ALLCHILDREN | RDW_UPDATENOW);
        preview_trace::Append(
            L"EndNoteRenderSwitch",
            L"after_root_redraw elapsed_ms=" + preview_trace::ElapsedMs(startTick));
    }
    preview_trace::Append(
        L"EndNoteRenderSwitch",
        L"end elapsed_ms=" + preview_trace::ElapsedMs(startTick));
}

bool IsNoteRenderSwitchInProgress() {
    return g_noteRenderSwitchBlocked;
}

bool CommitNoteImeCompositionNow() {
    if (!g_hNoteEdit) return false;
    HIMC imc = ImmGetContext(g_hNoteEdit);
    if (!imc) return false;
    // Complete composition explicitly; click-to-toggle may otherwise commit implicitly mid-transition.
    BOOL ok = ImmNotifyIME(imc, NI_COMPOSITIONSTR, CPS_COMPLETE, 0);
    ImmReleaseContext(g_hNoteEdit, imc);
    if (ok) {
        // A successful request is not proof that RichEdit has accepted the
        // result. Actual RESULT/END messages own that acknowledgement; do not
        // open canonical saves while a continuing preedit still exists.
        return true;
    }
    return false;
}

static HFONT GetActiveNoteFont() {
    if (IsNoteRenderActive() && g_hNoteRenderFont) {
        return g_hNoteRenderFont;
    }
    return g_hNoteFont ? g_hNoteFont : g_hUIFont;
}

static void ResetBottomAssistFontCache() {
    if (g_hBottomAssistFont) {
        DeleteObject(g_hBottomAssistFont);
        g_hBottomAssistFont = nullptr;
    }
    g_bottomAssistFontFace.clear();
    g_bottomAssistFontPx = 0;
    g_bottomAssistFontDpi = 0;
}

static HFONT GetBottomAssistFont(HWND hWnd) {
    const std::wstring face = g_noteFontName.empty() ? GetDefaultFontFaceName() : g_noteFontName;
    int dpi = hWnd ? GetDpiY(hWnd) : 96;
    if (dpi <= 0) dpi = 96;
    double pt = (g_noteFontPt > 0.0) ? g_noteFontPt : 10.0;
    const int px = std::clamp(static_cast<int>(std::lround(pt * dpi / 72.0)), 8, 14);
    if (!g_hBottomAssistFont ||
        g_bottomAssistFontFace != face ||
        g_bottomAssistFontPx != px ||
        g_bottomAssistFontDpi != dpi) {
        ResetBottomAssistFontCache();
        LOGFONTW lf{};
        lf.lfWeight = FW_NORMAL;
        lf.lfHeight = -px;
        wcscpy_s(lf.lfFaceName, face.c_str());
        g_hBottomAssistFont = CreateFontIndirectW(&lf);
        g_bottomAssistFontFace = face;
        g_bottomAssistFontPx = px;
        g_bottomAssistFontDpi = dpi;
    }
    return g_hBottomAssistFont ? g_hBottomAssistFont : (g_hUIFont ? g_hUIFont : g_hNoteFont);
}

static std::wstring CurrentNoteFileNameForParse() {
    if (g_currentNotePath.empty()) return L"";
    return std::filesystem::path(g_currentNotePath).filename().wstring();
}

static std::wstring NoteExtensionLowerForPath(const std::wstring& notePath) {
    if (notePath.empty()) return L"";
    return ToLowerAscii(std::filesystem::path(notePath).extension().wstring());
}


static NoteContentRoute NoteContentRouteForPath(const std::wstring& notePath) {
    const std::wstring ext = NoteExtensionLowerForPath(notePath);
    if (ext == L".txt" || ext == L".csv") return NoteContentRoute::PlainText;
    // TeX is source text, not a Markdown dialect.  Keep its commands and
    // document structure visible verbatim; Markdown remains .md/.clro.
    if (ext == L".tex") return NoteContentRoute::TeX;
    return NoteContentRoute::MarkdownMd4c;
}

static std::wstring CurrentNoteExtensionLower() {
    return NoteExtensionLowerForPath(g_currentNotePath);
}

static NoteContentRoute CurrentNoteContentRoute() {
    return NoteContentRouteForPath(g_currentNotePath);
}

static bool NoteContentRouteSupportsLinkTargets(NoteContentRoute route) {
    return route == NoteContentRoute::MarkdownMd4c;
}

static note::NoteContentKind CurrentNoteContentKind() {
    switch (CurrentNoteContentRoute()) {
    case NoteContentRoute::PlainText:
        return note::NoteContentKind::PlainText;
    case NoteContentRoute::TeX:
        return note::NoteContentKind::TeXSource;
    case NoteContentRoute::MarkdownMd4c:
        return note::NoteContentKind::Markdown;
    }
    return note::NoteContentKind::PlainText;
}

static bool CurrentNoteSupportsRenderOverlay() {
    return CurrentNoteContentRoute() != NoteContentRoute::PlainText;
}

static bool CurrentNoteUsesTeXMathOnlyRender() {
    return CurrentNoteContentRoute() == NoteContentRoute::TeX;
}

static void ResetParsedNoteDocumentState() {
    note::LocalNoteKernel* kernel = CurrentNoteKernel();
    if (kernel) kernel->ClearDerived();
}

static uint64_t NextNoteTextCoreRevision() {
    if (g_noteDocumentRevisionSeed != std::numeric_limits<uint64_t>::max()) {
        ++g_noteDocumentRevisionSeed;
    }
    return g_noteDocumentRevisionSeed;
}

static note::NoteMetadata CurrentNoteTextMetadata() {
    note::NoteMetadata meta;
    meta.file_name = CurrentNoteFileNameForParse();
    meta.title = note::DeriveTitleFromFileName(meta.file_name);
    return meta;
}

static void ResetCurrentNoteTextCore(note::NoteId noteId,
                                     std::wstring raw,
                                     uint64_t persistenceRevision,
                                     uint64_t knownContentRevision = 0) {
    if (!noteId.valid()) return;
    // A new canonical document may be installed before its RichEdit transport
    // receives the matching text. Do not let the old transport binding prove
    // a relationship across that gap.
    InvalidateCurrentNoteTextCoreEditorBinding(CurrentNoteViewContextWindow());
    const uint64_t contentRevision = knownContentRevision != 0
        ? knownContentRevision
        : NextNoteTextCoreRevision();
    g_noteDocumentRevisionSeed = std::max(g_noteDocumentRevisionSeed, contentRevision);
    note::RuntimeNoteWorkspaceService().ResetKernel(
        noteId,
        CurrentNoteTextMetadata(),
        std::move(raw),
        contentRevision,
        persistenceRevision,
        CurrentNoteContentKind());
}

static note::NoteId CurrentNoteTextCoreOwner() {
    const note::ViewIdentity view = CurrentNoteViewIdentity();
    if (view.note_id.valid()) return view.note_id;
    return note::ResolveRuntimeNoteIdentityPath(g_currentNotePath).note_id;
}

static void SynchronizeCurrentNoteTextCore(std::wstring_view editorText) {
    const note::NoteId owner = CurrentNoteTextCoreOwner();
    if (!owner.valid()) return;
    note::NoteTextCore* core = CurrentNoteTextCore();
    if (core && core->note_id() == owner && core->MatchesRaw(editorText)) {
        MarkCurrentNoteTextCoreAsEditorSynchronized(
            CurrentNoteViewContextWindow(), editorText);
        return;
    }
    const uint64_t persistenceRevision =
        core && core->note_id() == owner
        ? core->persistence_revision()
        : 0;
    ResetCurrentNoteTextCore(owner, std::wstring(editorText), persistenceRevision);
    MarkCurrentNoteTextCoreAsEditorSynchronized(
        CurrentNoteViewContextWindow(), editorText);
}

static bool CanReadStableParsedNoteDocument() {
    const note::LocalNoteKernel* kernel = CurrentNoteKernel();
    return kernel && kernel->CanReadSyntax();
}

static bool CanReadStableSemanticIndex() {
    const note::LocalNoteKernel* kernel = CurrentNoteKernel();
    return kernel && kernel->CanReadSemantic();
}

static std::optional<note::NoteKernelRefreshResult> RecomputeParsedNoteDocument(const std::wstring& text) {
    SynchronizeCurrentNoteTextCore(text);
    note::LocalNoteKernel* kernel = CurrentNoteKernel();
    if (!kernel) {
        return std::nullopt;
    }

    const note::NoteKernelRefreshResult refresh = kernel->RefreshDerived();
    g_noteDocumentRevisionSeed = std::max(
        g_noteDocumentRevisionSeed, kernel->text_core().content_revision());
    return refresh;
}

static std::wstring NoteContentRouteLabel(bool englishUi) {
    const std::wstring ext = CurrentNoteExtensionLower();
    const std::wstring extSuffix = ext.empty() ? L"" : (L" (" + ext + L")");
    switch (CurrentNoteContentRoute()) {
    case NoteContentRoute::PlainText:
        return englishUi ? (L"Plain text" + extSuffix) : (L"プレーンテキスト" + extSuffix);
    case NoteContentRoute::TeX:
        return englishUi ? (L"TeX source" + extSuffix) : (L"TeX 原文" + extSuffix);
    case NoteContentRoute::MarkdownMd4c:
        return englishUi ? (L"Markdown" + extSuffix) : (L"Markdown系" + extSuffix);
    }
    return englishUi ? L"Unknown" : L"不明";
}

static std::wstring NoteBlockKindLabel(note::BlockKind kind, bool englishUi) {
    switch (kind) {
    case note::BlockKind::Paragraph: return englishUi ? L"Paragraph" : L"段落";
    case note::BlockKind::Heading: return englishUi ? L"Heading" : L"見出し";
    case note::BlockKind::List: return englishUi ? L"List" : L"リスト";
    case note::BlockKind::ListItem: return englishUi ? L"List item" : L"リスト項目";
    case note::BlockKind::Quote: return englishUi ? L"Quote" : L"引用";
    case note::BlockKind::CodeBlock: return englishUi ? L"Code block" : L"コードブロック";
    case note::BlockKind::HorizontalRule: return englishUi ? L"Horizontal rule" : L"区切り線";
    case note::BlockKind::Table: return englishUi ? L"Table" : L"表";
    case note::BlockKind::TableHead: return englishUi ? L"Table head" : L"表ヘッダー";
    case note::BlockKind::TableBody: return englishUi ? L"Table body" : L"表本文";
    case note::BlockKind::TableRow: return englishUi ? L"Table row" : L"表行";
    case note::BlockKind::TableHeaderCell: return englishUi ? L"Table header cell" : L"表見出しセル";
    case note::BlockKind::TableCell: return englishUi ? L"Table cell" : L"表セル";
    case note::BlockKind::Blank: return englishUi ? L"Blank" : L"空行";
    }
    return englishUi ? L"Unknown" : L"不明";
}

static std::wstring NoteInlineKindLabel(note::InlineKind kind, bool englishUi) {
    switch (kind) {
    case note::InlineKind::Text: return englishUi ? L"Text" : L"テキスト";
    case note::InlineKind::Code: return englishUi ? L"Code" : L"コード";
    case note::InlineKind::Emphasis: return englishUi ? L"Emphasis" : L"強調";
    case note::InlineKind::Strong: return englishUi ? L"Strong" : L"太字";
    case note::InlineKind::Strike: return englishUi ? L"Strike" : L"取り消し";
    case note::InlineKind::Link: return englishUi ? L"Link" : L"リンク";
    case note::InlineKind::Image: return englishUi ? L"Image" : L"画像";
    }
    return englishUi ? L"Unknown" : L"不明";
}

static const note::BlockNode* FindActiveNoteDocumentBlock(size_t rawPos) {
    if (!CanReadStableParsedNoteDocument()) return nullptr;
    const note::BlockNode* best = nullptr;
    size_t bestSpanLen = static_cast<size_t>(-1);
    for (const auto& block : CurrentNoteDocument().blocks) {
        if (rawPos < block.span.start.value || rawPos > block.span.end.value) continue;
        size_t spanLen = (block.span.end.value >= block.span.start.value) ? (block.span.end.value - block.span.start.value) : 0;
        if (!best || spanLen <= bestSpanLen) {
            best = &block;
            bestSpanLen = spanLen;
        }
    }
    return best;
}

static const note::InlineNode* FindActiveNoteDocumentInline(size_t rawPos) {
    if (!CanReadStableParsedNoteDocument()) return nullptr;
    const note::InlineNode* best = nullptr;
    size_t bestSpanLen = static_cast<size_t>(-1);
    for (const auto& inlineNode : CurrentNoteDocument().inlines) {
        if (rawPos < inlineNode.span.start.value || rawPos > inlineNode.span.end.value) continue;
        size_t spanLen = (inlineNode.span.end.value >= inlineNode.span.start.value) ? (inlineNode.span.end.value - inlineNode.span.start.value) : 0;
        if (!best || spanLen <= bestSpanLen) {
            best = &inlineNode;
            bestSpanLen = spanLen;
        }
    }
    return best;
}

static const note::MathSpan* FindSelectedNoteDocumentMathSpan(size_t rawStart,
                                                              size_t rawEnd,
                                                              bool hasSelection) {
    if (!CanReadStableParsedNoteDocument()) return nullptr;
    const note::MathSpan* best = nullptr;
    size_t bestSpanLen = static_cast<size_t>(-1);
    for (const auto& mathSpan : CurrentNoteDocument().math_spans) {
        const bool contains = hasSelection
            ? (rawStart >= mathSpan.span.start.value && rawEnd <= mathSpan.span.end.value && rawEnd > rawStart)
            : (rawStart >= mathSpan.span.start.value && rawStart < mathSpan.span.end.value);
        if (!contains) continue;
        size_t spanLen = (mathSpan.span.end.value >= mathSpan.span.start.value)
            ? (mathSpan.span.end.value - mathSpan.span.start.value)
            : 0;
        if (!best || spanLen <= bestSpanLen) {
            best = &mathSpan;
            bestSpanLen = spanLen;
        }
    }
    return best;
}

static const note::Diagnostic* FindFirstNoteDocumentDiagnosticForSpan(note::Span span) {
    if (!CanReadStableParsedNoteDocument()) return nullptr;
    for (const auto& diag : CurrentNoteDocument().diagnostics) {
        if (span.start < diag.span.end && span.end > diag.span.start) {
            return &diag;
        }
    }
    return nullptr;
}

static std::wstring BuildAssistSnippet(std::wstring_view text, size_t limit) {
    std::wstring out;
    out.reserve(std::min(limit, text.size()) + 8);
    bool truncated = false;
    for (wchar_t ch : text) {
        if (ch == L'\r' || ch == L'\n' || ch == L'\t') {
            if (out.empty() || out.back() != L' ') {
                out.push_back(L' ');
            }
        } else {
            out.push_back(ch);
        }
        if (out.size() >= limit) {
            truncated = true;
            break;
        }
    }
    while (!out.empty() && out.back() == L' ') {
        out.pop_back();
    }
    if (truncated) {
        out += L"...";
    }
    return out;
}

static size_t RichEditIndexToRawTextIndex(const std::wstring& text, size_t editPos) {
    editPos = std::min(editPos, text.size());
    if (!IsRichEditControl(CurrentNoteViewContextWindow())) {
        return editPos;
    }

    size_t rawPos = 0;
    size_t visiblePos = 0;
    while (rawPos < text.size() && visiblePos < editPos) {
        if (text[rawPos] == L'\r' && rawPos + 1 < text.size() && text[rawPos + 1] == L'\n') {
            rawPos += 2;
        } else {
            ++rawPos;
        }
        ++visiblePos;
    }
    return rawPos;
}

static int GetNoteFontCustomizationMode() {
    return std::clamp(g_config.noteFontCustomization, 0, 2);
}

static bool IsBottomAssistRenderFontVisible() {
    return CurrentNoteSupportsRenderOverlay() && GetNoteFontCustomizationMode() >= 1;
}

static bool IsBottomAssistRenderJpFontVisible() {
    return CurrentNoteSupportsRenderOverlay() && GetNoteFontCustomizationMode() == 2;
}

static bool IsBottomAssistUnifiedFontMode() {
    return CurrentNoteSupportsRenderOverlay() && GetNoteFontCustomizationMode() == 1;
}

static bool IsBottomAssistRawFontVisible() {
    return !IsBottomAssistUnifiedFontMode();
}

struct BottomAssistLineLayout {
    int pdfZoomIdx = -1;
    int pdfPageOverlayIdx = -1;
    int pdfZoomOverlayIdx = -1;
    int annotVisibilityIdx = -1;
    int noteDisplayIdx = -1;
    int renderIdx = -1;
    int wrapIdx = -1;
    int vimIdx = -1;
    int vimCaretLineRawTextIdx = -1;
    int vimClickInsertIdx = -1;
    int rawFontIdx = -1;
    int renderFontIdx = -1;
    int renderJpFontIdx = -1;
    int fontSizeIdx = -1;
    int bgIdx = -1;
    int inlineMathVerticalAlignmentIdx = -1;
};

struct NoteInputStatusLabels {
    std::wstring operationTarget;
    std::wstring focusTarget;
    std::wstring inputMode;
};

[[nodiscard]] static NoteInputStatusLabels ResolveNoteInputStatusLabels() {
    const HWND focused = GetFocus();
    const auto isFocusIn = [focused](HWND root) {
        return root && focused && (root == focused || IsChild(root, focused));
    };
    const wchar_t* focusId = L"note.assist.target.none";
    if (isFocusIn(g_hNoteCmdlineEdit)) focusId = L"note.assist.target.note_search";
    else if (isFocusIn(g_hNoteEdit)) focusId = L"note.assist.target.note";
    else if (isFocusIn(g_hPdfView)) focusId = L"note.assist.target.pdf";
    else if (isFocusIn(g_hLectureList)) focusId = L"note.assist.target.lecture_list";
    else if (isFocusIn(g_hSessionList)) focusId = L"note.assist.target.session_list";
    else if (isFocusIn(g_hPdfList)) focusId = L"note.assist.target.pdf_list";
    else if (isFocusIn(g_hNoteList)) focusId = L"note.assist.target.note_list";
    else if (isFocusIn(g_hBottomMath)) focusId = L"note.assist.target.math_pane";
    else if (isFocusIn(g_hBottomNote)) focusId = L"note.assist.target.bottom_pane";
    else if (focused == g_hMainWnd && focused) focusId = L"note.assist.target.main";
    else if (focused) focusId = L"note.assist.target.other";
    const bool normal = g_noteVimModeEnabled && g_noteNormalMode;
    // Keep logical command ownership separate from the actual HWND. This
    // also makes legacy main-owner messages visible instead of hiding them.
    const wchar_t* operationId = normal && focused && focused == g_hMainWnd
        ? L"note.assist.target.note" : focusId;
    const wchar_t* modeId = !g_noteVimModeEnabled ? L"note.assist.input.standard"
        : !normal ? L"note.assist.input.insert"
        : IsNoteNormalVisualActive() ? L"note.assist.input.visual"
        : L"note.assist.input.normal";
    if (isFocusIn(g_hNoteCmdlineEdit)) modeId = L"note.assist.input.search";
    return {localization::Text(operationId), localization::Text(focusId), localization::Text(modeId)};
}

std::wstring CaptureNoteInputStatusText() {
    const auto status = ResolveNoteInputStatusLabels();
    return localization::Text(L"note.assist.focus") + L": " + status.operationTarget + L"\n" +
        localization::Text(L"note.assist.focus_window") + L": " + status.focusTarget + L"\n" +
        localization::Text(L"note.assist.input_mode") + L": " + status.inputMode;
}

static std::wstring BuildBottomAssistText(BottomAssistLineLayout* outLayout) {
    const NoteContentRoute route = CurrentNoteContentRoute();
    const bool enabled = IsNoteRenderActive();
    const bool englishUi = IsEnglishUi();
    const bool vimEnabled = g_noteVimModeEnabled;
    const auto available = note::ResolveNoteInteractionControlAvailability(enabled, vimEnabled);
    const bool showWrapToggle = IsNoteWrapToggleAvailable();
    const bool showRawFont = IsBottomAssistRawFontVisible();
    const bool showRenderFont = IsBottomAssistRenderFontVisible();
    const bool showRenderJpFont = IsBottomAssistRenderJpFontVisible();
    const bool wrapEnabled = g_noteWrapEnabled;
    const bool renderSupportedRoute = CurrentNoteSupportsRenderOverlay();
    const std::wstring rawFace = g_noteFontName.empty() ? GetDefaultFontFaceName() : g_noteFontName;
    const std::wstring renderFace = g_noteRenderFontName.empty() ? rawFace : g_noteRenderFontName;
    const std::wstring renderJpFace = g_noteRenderJpFontName.empty() ? renderFace : g_noteRenderJpFontName;
    const std::wstring rawName = ResolveFontDisplayName(rawFace);
    const std::wstring renderName = ResolveFontDisplayName(renderFace);
    const std::wstring renderJpName = ResolveFontDisplayName(renderJpFace);
    const std::wstring sizeLabel = std::to_wstring(static_cast<int>(std::lround(g_noteFontPt))) + L"pt";
    const std::wstring wrapLabel = wrapEnabled ? L"ON" : L"OFF";
    const std::wstring gridLabel = g_noteGridEnabled ? L"ON" : L"OFF";
    const std::wstring gridPitchLabel =
        std::to_wstring(std::clamp(g_noteGridPitch, 4, 256)) + L"px";
    auto ratioLabel = [](int topPercent) -> std::wstring {
        int top = std::clamp(topPercent, 5, 95);
        return std::to_wstring(top) + L":" + std::to_wstring(100 - top);
    };
    const std::wstring mathMarginLabel = ratioLabel(g_config.noteMathMarginTopPercent);
    const std::wstring supSubLabel = (g_config.noteMathSupSubGapSupPercent <= 0)
        ? (englishUi ? L"Auto" : L"自動")
        : ratioLabel(g_config.noteMathSupSubGapSupPercent);
    const int inlineMathVerticalAlignment =
        std::clamp(g_config.noteInlineMathVerticalAlignment, 0, 2);
    const wchar_t* inlineMathVerticalAlignmentLabelId =
        inlineMathVerticalAlignment == 0 ? L"settings.note_inline_math.top"
        : inlineMathVerticalAlignment == 1 ? L"settings.note_inline_math.center"
                                            : L"settings.note_inline_math.bottom";
    std::wstring noteBgLabelEn;
    std::wstring noteBgLabelJa;
    std::wstring bgSource = ToLowerAscii(g_config.noteBgSource);
    if (bgSource == L"theme" || bgSource == L"theme_current") {
        std::wstring nameEn = g_theme.name.empty() ? L"(default)" : g_theme.name;
        std::wstring nameJa = g_theme.nameJp.empty() ? nameEn : g_theme.nameJp;
        noteBgLabelEn = L"Theme (current): " + nameEn + L" " + ColorToHexW(g_noteBgColor);
        noteBgLabelJa = L"テーマ準拠: " + nameJa + L" " + ColorToHexW(g_noteBgColor);
    } else if (bgSource == L"theme_named") {
        const ThemeColors* picked = nullptr;
        for (const auto& t : g_themeCatalog) {
            if (t.name == g_config.noteBgThemeName) {
                picked = &t;
                break;
            }
        }
        std::wstring nameEn = picked ? picked->name : g_config.noteBgThemeName;
        if (nameEn.empty()) nameEn = L"(unknown)";
        std::wstring nameJa = (picked && !picked->nameJp.empty()) ? picked->nameJp : nameEn;
        noteBgLabelEn = L"Theme: " + nameEn + L" " + ColorToHexW(g_noteBgColor);
        noteBgLabelJa = L"テーマ: " + nameJa + L" " + ColorToHexW(g_noteBgColor);
    } else {
        noteBgLabelEn = L"Custom " + ColorToHexW(g_noteBgColor);
        noteBgLabelJa = L"カスタム " + ColorToHexW(g_noteBgColor);
        struct BgPreset {
            COLORREF color;
            const wchar_t* labelEn;
            const wchar_t* labelJa;
        };
        const BgPreset bgPresets[] = {
            { RGB(255, 255, 255), L"White", L"白" },
            { RGB(255, 250, 235), L"Cream", L"クリーム" },
            { RGB(245, 245, 245), L"Light gray", L"薄グレー" },
            { RGB(255, 255, 230), L"Soft yellow", L"薄イエロー" },
        };
        for (const auto& p : bgPresets) {
            if (p.color == g_noteBgColor) {
                noteBgLabelEn = p.labelEn;
                noteBgLabelJa = p.labelJa;
                break;
            }
        }
    }
    const auto inputStatus = ResolveNoteInputStatusLabels();
    const bool imeComposing = IsNoteImeComposing();
    std::wstring imeLabelJa = imeComposing ? L"変換中" : L"待機";
    std::wstring imeLabelEn = imeComposing ? L"Composing" : L"Idle";
    DWORD selStartRaw = 0;
    DWORD selEndRaw = 0;
    if (g_hNoteEdit) {
        SendMessageW(g_hNoteEdit, EM_GETSEL,
                     reinterpret_cast<WPARAM>(&selStartRaw),
                     reinterpret_cast<LPARAM>(&selEndRaw));
    }
    unsigned long long selChars = 0;
    if (selEndRaw > selStartRaw) {
        selChars = static_cast<unsigned long long>(selEndRaw - selStartRaw);
    }
    const bool parsedDocumentReady = CanReadStableParsedNoteDocument();
    const bool semanticIndexReady = CanReadStableSemanticIndex();
    const size_t headingCount = semanticIndexReady ? CurrentNoteSemanticIndex().headings.size() : 0;
    size_t warningCount = 0;
    size_t errorCount = 0;
    if (parsedDocumentReady) {
        for (const auto& diag : CurrentNoteDocument().diagnostics) {
            if (diag.severity == note::DiagnosticSeverity::Error) {
                ++errorCount;
            } else {
                ++warningCount;
            }
        }
    }
    const note::Diagnostic* firstDiagnostic =
        parsedDocumentReady && !CurrentNoteDocument().diagnostics.empty() ? &CurrentNoteDocument().diagnostics.front() : nullptr;
    size_t caretRawPos = 0;
    size_t selectionRawStart = 0;
    size_t selectionRawEnd = 0;
    if (parsedDocumentReady) {
        caretRawPos = RichEditIndexToRawTextIndex(CurrentNoteSyntaxSource().raw, static_cast<size_t>(selStartRaw));
        if (caretRawPos > CurrentNoteSyntaxSource().raw.size()) {
            caretRawPos = CurrentNoteSyntaxSource().raw.size();
        }
        selectionRawStart = RichEditIndexToRawTextIndex(CurrentNoteSyntaxSource().raw, static_cast<size_t>(selStartRaw));
        selectionRawEnd = RichEditIndexToRawTextIndex(CurrentNoteSyntaxSource().raw, static_cast<size_t>(selEndRaw));
        if (selectionRawStart > selectionRawEnd) {
            std::swap(selectionRawStart, selectionRawEnd);
        }
        if (selectionRawEnd > CurrentNoteSyntaxSource().raw.size()) {
            selectionRawEnd = CurrentNoteSyntaxSource().raw.size();
        }
    }
    const note::BlockNode* activeBlock = FindActiveNoteDocumentBlock(caretRawPos);
    const note::InlineNode* activeInline = FindActiveNoteDocumentInline(caretRawPos);
    const bool hasSelection = selectionRawEnd > selectionRawStart;
    const note::MathSpan* selectedMath =
        FindSelectedNoteDocumentMathSpan(hasSelection ? selectionRawStart : caretRawPos,
                                         hasSelection ? selectionRawEnd : caretRawPos,
                                         hasSelection);
    const note::Diagnostic* selectedMathDiagnostic =
        selectedMath ? FindFirstNoteDocumentDiagnosticForSpan(selectedMath->span) : nullptr;
    const bool pdfOpen = g_pdf.kind != DocKind::None && !CurrentLogicalPdfPath().empty();
    std::wstring pdfName = pdfOpen
        ? std::filesystem::path(CurrentLogicalPdfPath()).filename().wstring()
        : L"";
    if (pdfName.empty()) pdfName = englishUi ? L"(none)" : L"（なし）";
    const int currentPdfPage = pdfOpen && g_pdf.pageCount > 0
        ? std::clamp(PageAtCurrentView() + 1, 1, g_pdf.pageCount)
        : 0;
    const int pdfZoomPercent = static_cast<int>(std::lround(std::max(0.0, g_pdf.scale) * 100.0));
    const std::wstring noteName = g_currentNotePath.empty()
        ? (englishUi ? L"(none)" : L"（なし）")
        : std::filesystem::path(g_currentNotePath).filename().wstring();
    const std::wstring noteDisplayLabel = localization::Text(CurrentNoteDisplayLabelId());
    const std::wstring pdfInputEn = g_pdf.editingText ? L"Text editing" : L"Viewing";
    const std::wstring pdfInputJa = g_pdf.editingText ? L"テキスト編集中" : L"閲覧中";
    BottomAssistLineLayout layout;
    std::wstring text;
    int rowIndex = 0;
    // Text and command indices are produced together. Conditional settings
    // cannot shift a click onto a different row or a read-only value.
    const auto appendRow = [&](std::wstring row, int* index = nullptr) {
        if (index) *index = rowIndex;
        ++rowIndex;
        for (auto& ch : row) if (ch == L'\r' || ch == L'\n') ch = L' ';
        if (!text.empty()) text += L'\n';
        text += row;
    };
    const auto appendValue = [&](const wchar_t* labelId, const std::wstring& value, int* index = nullptr) {
        appendRow(localization::Text(labelId) + L": " + value, index);
    };
    const auto onOff = [](bool value) -> std::wstring { return value ? L"ON" : L"OFF"; };
    appendRow(localization::Text(L"note.assist.editable_hint"));
    appendValue(L"note.assist.pdf", pdfName);
    appendValue(L"note.assist.pdf_state", pdfOpen ? (englishUi ? pdfInputEn : pdfInputJa)
        : localization::Text(L"note.assist.no_pdf"));
    if (pdfOpen && g_pdf.pageCount > 0) {
        appendValue(L"note.assist.page", std::to_wstring(currentPdfPage) + L" / " + std::to_wstring(g_pdf.pageCount));
        appendValue(L"note.assist.zoom", std::to_wstring(pdfZoomPercent) + L"%", &layout.pdfZoomIdx);
    }
    appendValue(L"note.assist.page_overlay", onOff(g_config.showPdfPageOverlay), &layout.pdfPageOverlayIdx);
    appendValue(L"note.assist.zoom_overlay", onOff(g_config.showPdfZoomOverlay), &layout.pdfZoomOverlayIdx);
    appendValue(L"note.assist.annotations", onOff(g_showAnnots), &layout.annotVisibilityIdx);
    appendRow(L"");
    appendValue(L"note.assist.note", noteName);
    appendValue(L"note.assist.text_length", std::to_wstring(GetWindowTextLengthW(g_hNoteEdit)));
    appendValue(L"note.assist.format", NoteContentRouteLabel(englishUi));
    const auto modeLabel = localization::Text(!enabled ? L"note.assist.mode.raw"
        : CurrentNoteUsesTeXMathOnlyRender() ? L"note.assist.mode.math_only"
        : IsNoteMathRenderActive() ? L"note.assist.mode.math" : L"note.assist.mode.structured");
    appendValue(L"note.assist.render_setting", renderSupportedRoute ? modeLabel
        : localization::Text(L"note.assist.unavailable"), &layout.renderIdx);
    appendValue(L"note.assist.current_display", noteDisplayLabel, &layout.noteDisplayIdx);
    if (showWrapToggle) appendValue(L"note.assist.wrap", wrapLabel, &layout.wrapIdx);
    appendRow(L"");
    if (showRawFont) appendValue(L"note.assist.raw_font", rawName, &layout.rawFontIdx);
    if (showRenderFont) appendValue(GetNoteFontCustomizationMode() == 1
        ? L"note.assist.unified_font" : L"note.assist.render_font", renderName, &layout.renderFontIdx);
    if (showRenderJpFont) appendValue(L"note.assist.render_jp_font", renderJpName, &layout.renderJpFontIdx);
    appendValue(L"note.assist.font_size", sizeLabel, &layout.fontSizeIdx);
    appendValue(L"note.assist.background", englishUi ? noteBgLabelEn : noteBgLabelJa, &layout.bgIdx);
    appendValue(L"note.assist.grid", gridLabel);
    appendValue(L"note.assist.grid_pitch", gridPitchLabel);
    appendValue(L"note.assist.math_margin", mathMarginLabel);
    appendValue(L"note.assist.sup_sub", supSubLabel);
    appendValue(L"settings.general.inline_math_vertical_alignment",
                localization::Text(inlineMathVerticalAlignmentLabelId),
                &layout.inlineMathVerticalAlignmentIdx);
    appendRow(L"");
    appendValue(L"note.assist.focus", inputStatus.operationTarget);
    appendValue(L"note.assist.focus_window", inputStatus.focusTarget);
    appendValue(L"settings.general.4c0160f87cbd", onOff(vimEnabled), &layout.vimIdx);
    if (available.normal_caret_raw) appendValue(L"note.assist.normal_display",
        localization::Text(g_noteVimCaretLineRawTextVisible ? L"note.assist.mode.raw" : L"note.assist.mode.structured"),
        &layout.vimCaretLineRawTextIdx);
    if (available.click_enters_insert) appendValue(L"note.assist.click_action",
        localization::Text(g_noteVimClickEntersInsertMode ? L"note.assist.click_insert" : L"note.assist.click_normal"),
        &layout.vimClickInsertIdx);
    appendValue(L"note.assist.input_mode", inputStatus.inputMode);
    appendValue(L"note.assist.ime", englishUi ? imeLabelEn : imeLabelJa);
    appendValue(L"note.assist.selection", std::to_wstring(selChars));
    appendValue(L"note.assist.left_pane", onOff(!g_leftPaneCollapsed));
    appendRow(L"");
    appendRow(localization::Text(L"note.assist.details"));
    if (outLayout) *outLayout = layout;
    if (englishUi) {
        if (parsedDocumentReady) {
            text += L"\nNote AST: blocks=" + std::to_wstring(CurrentNoteDocument().blocks.size()) +
                    L", inlines=" + std::to_wstring(CurrentNoteDocument().inlines.size()) +
                    L", headings=" + std::to_wstring(headingCount) +
                    L", styles=" + std::to_wstring(CurrentNoteDocument().style_spans.size()) +
                    L", math=" + std::to_wstring(CurrentNoteDocument().math_spans.size()) +
                    L"\nNote diagnostics: errors=" + std::to_wstring(errorCount) +
                    L", warnings=" + std::to_wstring(warningCount);
            if (selectedMath) {
                const note::LineColumn loc = note::ResolveLineColumn(CurrentNoteSyntaxSource(), selectedMath->span.start.value);
                const std::wstring rawMath = BuildAssistSnippet(
                    CurrentNoteSyntaxSource().raw.substr(selectedMath->span.start.value,
                                               selectedMath->span.end.value - selectedMath->span.start.value));
                const std::wstring normalizedMath = BuildAssistSnippet(selectedMath->normalized_tex);
                text += L"\nSelected math: " +
                        std::wstring(selectedMath->kind == note::MathKind::Block ? L"Block" : L"Inline") +
                        L" / " + note::MathDelimiterLabel(selectedMath->delimiter) +
                        L" @" + std::to_wstring(loc.line) + L":" + std::to_wstring(loc.column) +
                        L"\nSelected math raw: " + rawMath;
                if (!normalizedMath.empty()) {
                    text += L"\nSelected math normalized: " + normalizedMath;
                }
                if (selectedMathDiagnostic) {
                    text += L"\nSelected math diagnostic: " + selectedMathDiagnostic->code +
                            L" - " + selectedMathDiagnostic->message;
                }
            }
            if (activeBlock) {
                text += L"\nNote caret block: " + NoteBlockKindLabel(activeBlock->kind, true);
                if (activeBlock->kind == note::BlockKind::Heading && activeBlock->level > 0) {
                    text += L" L" + std::to_wstring(activeBlock->level);
                }
                text += L" @" + std::to_wstring(activeBlock->loc.line) +
                        L":" + std::to_wstring(activeBlock->loc.column);
            }
            if (activeInline) {
                text += L"\nNote caret inline: " + NoteInlineKindLabel(activeInline->kind, true);
            }
            if (firstDiagnostic) {
                text += L"\nNote first diagnostic: " + firstDiagnostic->code +
                        L" - " + firstDiagnostic->message;
            }
        } else if (route == NoteContentRoute::PlainText) {
            text += L"\nNote parser: disabled for plain-text route";
        } else {
            text += L"\nNote parser: (not parsed yet)";
        }
        return text;
    }
    if (parsedDocumentReady) {
        text += L"\nノート構造: block=" + std::to_wstring(CurrentNoteDocument().blocks.size()) +
                L", inline=" + std::to_wstring(CurrentNoteDocument().inlines.size()) +
                L", 見出し=" + std::to_wstring(headingCount) +
                L", style=" + std::to_wstring(CurrentNoteDocument().style_spans.size()) +
                L", math=" + std::to_wstring(CurrentNoteDocument().math_spans.size()) +
                L"\nノート診断: error=" + std::to_wstring(errorCount) +
                L", warning=" + std::to_wstring(warningCount);
        if (selectedMath) {
            const note::LineColumn loc = note::ResolveLineColumn(CurrentNoteSyntaxSource(), selectedMath->span.start.value);
            const std::wstring rawMath = BuildAssistSnippet(
                CurrentNoteSyntaxSource().raw.substr(selectedMath->span.start.value,
                                           selectedMath->span.end.value - selectedMath->span.start.value));
            const std::wstring normalizedMath = BuildAssistSnippet(selectedMath->normalized_tex);
            text += L"\n選択中数式: " +
                    std::wstring(selectedMath->kind == note::MathKind::Block ? L"ブロック" : L"インライン") +
                    L" / " + note::MathDelimiterLabel(selectedMath->delimiter) +
                    L" @" + std::to_wstring(loc.line) + L":" + std::to_wstring(loc.column);
            text += L"\n選択中数式の原文: " + rawMath;
            if (!normalizedMath.empty()) {
                text += L"\n選択中正規化: " + normalizedMath;
            }
            if (selectedMathDiagnostic) {
                text += L"\n選択中診断: " + selectedMathDiagnostic->code +
                        L" - " + selectedMathDiagnostic->message;
            }
        }
        if (activeBlock) {
            text += L"\nキャレットblock: " + NoteBlockKindLabel(activeBlock->kind, false);
            if (activeBlock->kind == note::BlockKind::Heading && activeBlock->level > 0) {
                text += L" L" + std::to_wstring(activeBlock->level);
            }
            text += L" @" + std::to_wstring(activeBlock->loc.line) +
                    L":" + std::to_wstring(activeBlock->loc.column);
        }
        if (activeInline) {
            text += L"\nキャレットinline: " + NoteInlineKindLabel(activeInline->kind, false);
        }
        if (firstDiagnostic) {
            text += L"\n最初の診断: " + firstDiagnostic->code +
                    L" - " + firstDiagnostic->message;
        }
    } else if (route == NoteContentRoute::PlainText) {
        text += L"\nノート解析器: プレーンテキスト経路では無効";
    } else {
        text += L"\nノート解析器: 未解析";
    }
    return text;
}

static void ToggleNoteRenderSetting() {
    if (!CurrentNoteSupportsRenderOverlay()) {
        HWND owner = g_hMainWnd ? g_hMainWnd : (g_hNoteEdit ? GetParent(g_hNoteEdit) : nullptr);
        ShowSoftNotice(owner,
                       localization::Text(L"note.render_overlay_unavailable"),
                       SoftNoticeKind::Info);
        return;
    }

    struct Guard {
        Guard() { BeginNoteRenderSwitch(); }
        ~Guard() { EndNoteRenderSwitch(); }
    } guard;

    if (IsNoteImeComposing()) {
        CommitNoteImeCompositionNow();
    }
    if (g_hNoteEdit) {
        CaptureNoteViewState(g_hNoteEdit, L"");
    }

    // Cycle modes: OFF -> ON -> ON+MATH -> OFF.
    const bool enabled = g_noteRenderEnabled && !g_noteRawOnly;
    const bool math = enabled && g_noteRenderMath;
    if (!enabled) {
        g_noteRenderEnabled = true;
        g_noteRawOnly = false;
        g_noteRenderMath = false;
    } else if (!math) {
        g_noteRenderEnabled = true;
        g_noteRawOnly = false;
        g_noteRenderMath = true;
    } else {
        g_noteRenderEnabled = false;
        g_noteRawOnly = true;
        g_noteRenderMath = false;
    }
    g_config.noteRenderEnabled = g_noteRenderEnabled;
    g_config.noteRawOnly = g_noteRawOnly;
    g_config.noteRenderMath = g_noteRenderMath;
    PersistConfig();
    HWND owner = g_hMainWnd ? g_hMainWnd : (g_hNoteEdit ? GetParent(g_hNoteEdit) : nullptr);
    SyncNoteWrapMenuState(owner);
    if (g_hNoteEdit) {
        HFONT active = GetActiveNoteFont();
        SendMessageW(g_hNoteEdit, WM_SETFONT, reinterpret_cast<WPARAM>(active), FALSE);
        ConfigureNoteEditTabStops(g_hNoteEdit);
        UpdateNoteViewMode();
        RestoreNoteViewState(g_hNoteEdit, L"", true);
        InvalidateRect(g_hNoteEdit, nullptr, FALSE);
    }
    if (g_hBottomNote) {
        InvalidateRect(g_hBottomNote, nullptr, FALSE);
    }
}

static void CompletePendingBottomNoteRenderToggleAfterIme() {
    if (!g_bottomNoteRenderTogglePendingAfterIme) return;
    if (IsNoteImeComposing()) return;
    g_bottomNoteRenderTogglePendingAfterIme = false;
    ToggleNoteRenderSetting();
}

static void TogglePdfPageOverlaySetting() {
    g_config.showPdfPageOverlay = !g_config.showPdfPageOverlay;
    PersistConfig();
    if (g_hPdfView) {
        InvalidateRect(g_hPdfView, nullptr, FALSE);
    }
    if (g_hBottomNote) {
        InvalidateRect(g_hBottomNote, nullptr, FALSE);
    }
}

static void TogglePdfZoomOverlaySetting() {
    g_config.showPdfZoomOverlay = !g_config.showPdfZoomOverlay;
    PersistConfig();
    if (g_hPdfView) {
        InvalidateRect(g_hPdfView, nullptr, FALSE);
    }
    if (g_hBottomNote) {
        InvalidateRect(g_hBottomNote, nullptr, FALSE);
    }
}

static void ToggleNoteVimControlSetting() {
    g_noteVimModeEnabled = !g_noteVimModeEnabled;
    if (g_noteVimModeEnabled) {
        // This command is invoked from the status pane.  Enter normal mode
        // through the same boundary as Esc, so focus leaves that pane and the
        // next key is handled as a note command rather than a pane shortcut.
        HWND owner = g_hMainWnd ? g_hMainWnd : (g_hNoteEdit ? GetParent(g_hNoteEdit) : nullptr);
        if (owner) {
            EnterNoteNormalMode(owner);
        }
    } else {
        g_noteNormalMode = false;
        OnExitNoteNormalMode();
    }
    g_config.noteVimModeEnabled = g_noteVimModeEnabled;
    PersistConfig();
    if (g_hNoteEdit) {
        RefreshFinalNoteRenderFrame(g_hNoteEdit, std::nullopt);
        if (GetFocus() == g_hNoteEdit) SyncNativeCaretToRenderState(g_hNoteEdit);
    }
    if (g_hBottomNote) {
        InvalidateRect(g_hBottomNote, nullptr, FALSE);
    }
    if (g_hNoteEdit) {
        InvalidateRect(g_hNoteEdit, nullptr, FALSE);
    }
}

static void ToggleNoteVimCaretLineRawTextSetting() {
    if (!note::ResolveNoteInteractionControlAvailability(
            IsNoteRenderActive(), g_noteVimModeEnabled).normal_caret_raw) return;
    g_noteVimCaretLineRawTextVisible = !g_noteVimCaretLineRawTextVisible;
    g_config.noteVimCaretLineRawTextVisible = g_noteVimCaretLineRawTextVisible;
    PersistConfig();
    if (g_hNoteEdit) {
        RefreshFinalNoteRenderFrame(g_hNoteEdit, std::nullopt);
        if (GetFocus() == g_hNoteEdit) SyncNativeCaretToRenderState(g_hNoteEdit);
    }
    if (g_hBottomNote) {
        InvalidateRect(g_hBottomNote, nullptr, FALSE);
    }
    if (g_hNoteEdit) {
        InvalidateRect(g_hNoteEdit, nullptr, FALSE);
    }
}

static void ToggleNoteVimClickInsertSetting() {
    if (!g_noteVimModeEnabled) return;
    g_noteVimClickEntersInsertMode = !g_noteVimClickEntersInsertMode;
    g_config.noteVimClickEntersInsertMode = g_noteVimClickEntersInsertMode;
    PersistConfig();
    if (g_hBottomNote) {
        InvalidateRect(g_hBottomNote, nullptr, FALSE);
    }
}

static void SyncNoteWrapMenuState(HWND owner) {
    if (!owner) return;
    HMENU menu = GetMenu(owner);
    if (!menu) return;
    UINT enableFlags = MF_BYCOMMAND | (IsNoteWrapToggleAvailable() ? MF_ENABLED : MF_GRAYED);
    EnableMenuItem(menu, ID_VIEW_NOTE_WRAP, enableFlags);
    CheckMenuItem(menu, ID_VIEW_NOTE_WRAP,
                  MF_BYCOMMAND | (g_noteWrapEnabled ? MF_CHECKED : MF_UNCHECKED));
    DrawMenuBar(owner);
}

void ToggleNoteWrapSetting() {
    if (!IsNoteWrapToggleAvailable()) {
        HWND owner = g_hMainWnd ? g_hMainWnd : (g_hNoteEdit ? GetParent(g_hNoteEdit) : nullptr);
        SyncNoteWrapMenuState(owner);
        return;
    }
    g_noteWrapEnabled = !g_noteWrapEnabled;
    g_config.noteWrapEnabled = g_noteWrapEnabled;
    PersistConfig();
    HWND owner = g_hMainWnd ? g_hMainWnd : (g_hNoteEdit ? GetParent(g_hNoteEdit) : nullptr);
    SyncNoteWrapMenuState(owner);
    if (g_hNoteEdit) {
        UpdateNoteViewMode();
        UpdateNoteLineSpacing();
        RestoreNoteViewState(g_hNoteEdit, L"", true);
        InvalidateRect(g_hNoteEdit, nullptr, FALSE);
    }
    if (g_hBottomNote) {
        InvalidateRect(g_hBottomNote, nullptr, FALSE);
    }
}

static void ShowNoteAssistFontMenu(HWND hWnd, NoteAssistFontTarget target) {
    HMENU menu = CreatePopupMenu();
    if (!menu) return;
    std::wstring currentFace;
    const bool unifiedFontTarget =
        (target == NoteAssistFontTarget::RenderLatin && GetNoteFontCustomizationMode() == 1);
    if (target == NoteAssistFontTarget::Raw) {
        currentFace = g_noteFontName;
    } else if (target == NoteAssistFontTarget::RenderJapanese) {
        currentFace = g_noteRenderJpFontName.empty() ? g_noteRenderFontName : g_noteRenderJpFontName;
    } else if (unifiedFontTarget) {
        currentFace = g_noteRenderFontName.empty() ? g_noteFontName : g_noteRenderFontName;
    } else {
        currentFace = g_noteRenderFontName;
    }
    if (currentFace.empty()) currentFace = GetDefaultFontFaceName();
    const std::wstring currentDisplay = ResolveFontDisplayName(currentFace);
    constexpr UINT kMenuBase = 48000;
    constexpr UINT kMenuCount = static_cast<UINT>(sizeof(kDefaultFontList) / sizeof(kDefaultFontList[0]));
    for (UINT i = 0; i < kMenuCount; ++i) {
        UINT flags = MF_STRING;
        if (currentDisplay == kDefaultFontList[i].displayName) {
            flags |= MF_CHECKED;
        }
        AppendMenuW(menu, flags, kMenuBase + i, kDefaultFontList[i].displayName);
    }
    POINT pt{};
    GetCursorPos(&pt);
    UINT cmd = TrackPopupMenu(menu, TPM_RETURNCMD | TPM_RIGHTBUTTON, pt.x, pt.y, 0, hWnd, nullptr);
    if (cmd >= kMenuBase && cmd < kMenuBase + kMenuCount) {
        const UINT idx = cmd - kMenuBase;
        const std::wstring face = kDefaultFontList[idx].faceName;
        if (unifiedFontTarget) {
            g_noteFontName = face;
            g_noteRenderFontName = face;
            g_noteRenderFontPt = g_noteFontPt;
            g_noteRenderJpFontName = face;
            g_config.noteFontName = g_noteFontName;
            g_config.noteRenderFontName = g_noteRenderFontName;
            g_config.noteRenderFontPt = g_noteRenderFontPt;
            g_config.noteRenderJpFontName = g_noteRenderJpFontName;
        } else if (target == NoteAssistFontTarget::RenderLatin) {
            g_noteRenderFontName = face;
            g_noteRenderFontPt = g_noteFontPt;
            g_config.noteRenderFontName = g_noteRenderFontName;
            g_config.noteRenderFontPt = g_noteRenderFontPt;
        } else if (target == NoteAssistFontTarget::RenderJapanese) {
            g_noteRenderJpFontName = face;
            g_config.noteRenderJpFontName = g_noteRenderJpFontName;
        } else {
            g_noteFontName = face;
            g_config.noteFontName = g_noteFontName;
        }
        if (g_noteRenderJpFontName.empty()) {
            g_noteRenderJpFontName = g_noteRenderFontName.empty() ? g_noteFontName : g_noteRenderFontName;
            g_config.noteRenderJpFontName = g_noteRenderJpFontName;
        }
        ApplyNoteFont();
        PersistConfig();
        if (g_hBottomNote) InvalidateRect(g_hBottomNote, nullptr, FALSE);
    }
    DestroyMenu(menu);
}

static void ShowNoteAssistFontSizeMenu(HWND hWnd) {
    HMENU menu = CreatePopupMenu();
    if (!menu) return;
    constexpr int sizes[] = {8, 9, 10, 11, 12, 14, 16, 18, 20};
    constexpr UINT kMenuBase = 49000;
    for (UINT i = 0; i < static_cast<UINT>(sizeof(sizes) / sizeof(sizes[0])); ++i) {
        const int pt = sizes[i];
        std::wstring label = std::to_wstring(pt) + L"pt";
        UINT flags = MF_STRING;
        if (static_cast<int>(std::lround(g_noteFontPt)) == pt) {
            flags |= MF_CHECKED;
        }
        AppendMenuW(menu, flags, kMenuBase + i, label.c_str());
    }
    POINT pt{};
    GetCursorPos(&pt);
    UINT cmd = TrackPopupMenu(menu, TPM_RETURNCMD | TPM_RIGHTBUTTON, pt.x, pt.y, 0, hWnd, nullptr);
    if (cmd >= kMenuBase && cmd < kMenuBase + (sizeof(sizes) / sizeof(sizes[0]))) {
        const UINT idx = cmd - kMenuBase;
        g_noteFontPt = static_cast<double>(sizes[idx]);
        g_noteRenderFontPt = g_noteFontPt;
        g_config.noteFontPt = g_noteFontPt;
        g_config.noteRenderFontPt = g_noteRenderFontPt;
        ApplyNoteFont();
        PersistConfig();
        if (g_hBottomNote) InvalidateRect(g_hBottomNote, nullptr, FALSE);
    }
    DestroyMenu(menu);
}

static void ShowNoteAssistNoteBackgroundMenu(HWND hWnd) {
    HMENU menu = CreatePopupMenu();
    if (!menu) return;

    std::wstring bgSource = ToLowerAscii(g_config.noteBgSource);
    bool themeCurrent = (bgSource == L"theme" || bgSource == L"theme_current");
    bool themeNamed = (bgSource == L"theme_named");
    bool explicitColor = !themeCurrent && !themeNamed;

    constexpr UINT kMenuThemeCurrent = 51000;
    constexpr UINT kMenuThemeBase = 51100;
    constexpr UINT kMenuPresetBase = 51200;
    constexpr UINT kMenuCustom = 51300;

    UINT flagsThemeCurrent = MF_STRING;
    if (themeCurrent) flagsThemeCurrent |= MF_CHECKED;
    if (g_themeCatalog.empty()) flagsThemeCurrent |= MF_GRAYED;
    const std::wstring themeCurrentLabel = localization::Text(L"note.background.theme_current");
    AppendMenuW(menu, flagsThemeCurrent, kMenuThemeCurrent, themeCurrentLabel.c_str());

    if (!g_themeCatalog.empty()) {
        for (UINT i = 0; i < static_cast<UINT>(g_themeCatalog.size()); ++i) {
            const auto& t = g_themeCatalog[i];
            std::wstring name = localization::IsEnglishBuild() || t.nameJp.empty() ? t.name : t.nameJp;
            if (name.empty()) name = localization::Text(L"note.background.unnamed_theme");
            std::wstring label = name + L" " + ColorToHexW(t.noteBg);
            UINT flags = MF_STRING;
            if (themeNamed && t.name == g_config.noteBgThemeName) flags |= MF_CHECKED;
            AppendMenuW(menu, flags, kMenuThemeBase + i, label.c_str());
        }
    }

    AppendMenuW(menu, MF_SEPARATOR, 0, nullptr);

    struct Preset { COLORREF color; const wchar_t* textId; };
    const Preset presets[] = {
        { RGB(255, 255, 255), L"note.background.white" },
        { RGB(255, 250, 235), L"note.background.cream" },
        { RGB(245, 245, 245), L"note.background.light_gray" },
        { RGB(255, 255, 230), L"note.background.soft_yellow" },
    };
    constexpr UINT kPresetCount = static_cast<UINT>(sizeof(presets) / sizeof(presets[0]));
    for (UINT i = 0; i < kPresetCount; ++i) {
        const auto& p = presets[i];
        UINT flags = MF_STRING;
        if (explicitColor && p.color == g_noteBgColor) flags |= MF_CHECKED;
        const std::wstring label = localization::Text(p.textId);
        AppendMenuW(menu, flags, kMenuPresetBase + i, label.c_str());
    }
    AppendMenuW(menu, MF_SEPARATOR, 0, nullptr);
    const std::wstring customLabel = localization::Text(L"note.background.custom");
    AppendMenuW(menu, MF_STRING, kMenuCustom, customLabel.c_str());

    POINT pt{};
    GetCursorPos(&pt);
    UINT cmd = TrackPopupMenu(menu, TPM_RETURNCMD | TPM_RIGHTBUTTON, pt.x, pt.y, 0, hWnd, nullptr);

    bool anyPicked = false;
    COLORREF pickedColor = g_noteBgColor;
    std::wstring pickedSource = g_config.noteBgSource;
    std::wstring pickedThemeName = g_config.noteBgThemeName;
    bool explicitPicked = false;

    if (cmd == kMenuThemeCurrent && !g_themeCatalog.empty()) {
        anyPicked = true;
        pickedSource = L"theme_current";
        pickedThemeName.clear();
        pickedColor = g_theme.noteBg;
    } else if (cmd >= kMenuThemeBase && cmd < kMenuThemeBase + static_cast<UINT>(g_themeCatalog.size())) {
        anyPicked = true;
        const UINT idx = cmd - kMenuThemeBase;
        const auto& t = g_themeCatalog[idx];
        pickedSource = L"theme_named";
        pickedThemeName = t.name;
        pickedColor = t.noteBg;
    } else if (cmd >= kMenuPresetBase && cmd < kMenuPresetBase + kPresetCount) {
        anyPicked = true;
        explicitPicked = true;
        const UINT idx = cmd - kMenuPresetBase;
        pickedSource = L"explicit";
        pickedThemeName.clear();
        pickedColor = presets[idx].color;
    } else if (cmd == kMenuCustom) {
        COLORREF c = g_noteBgColor;
        if (PickColorDialog(hWnd, c, &c)) {
            anyPicked = true;
            explicitPicked = true;
            pickedSource = L"explicit";
            pickedThemeName.clear();
            pickedColor = c;
        }
    }

    if (anyPicked) {
        bool changed =
            (ToLowerAscii(g_config.noteBgSource) != ToLowerAscii(pickedSource)) ||
            (g_config.noteBgThemeName != pickedThemeName) ||
            (pickedColor != g_noteBgColor);

        g_config.noteBgSource = pickedSource;
        g_config.noteBgThemeName = pickedThemeName;
        if (explicitPicked) {
            g_config.noteBgColor = pickedColor;
        }
        g_noteBgColor = pickedColor;

        if (changed) {
            PersistConfig();

            if (g_hThemeNoteBrush) {
                DeleteObject(g_hThemeNoteBrush);
                g_hThemeNoteBrush = nullptr;
            }
            g_hThemeNoteBrush = CreateSolidBrush(g_noteBgColor);

            ApplyThemeToUI(g_hMainWnd ? g_hMainWnd : nullptr);
            if (g_hBottomNote) InvalidateRect(g_hBottomNote, nullptr, FALSE);
        } else {
            if (g_hBottomNote) InvalidateRect(g_hBottomNote, nullptr, FALSE);
        }
    }

    DestroyMenu(menu);
}

static int GetNoteRenderRightPadPx(HWND hWnd, int clientW) {
    if (clientW < 0) clientW = 0;
    return std::max(ScaleY(hWnd, 80), clientW / 10);
}

static int NoteRenderLineStartInsetPx(HWND hWnd) {
    return 0;
}

struct NoteVisualAssistMarginState {
    bool captured = false;
    UINT baseMargins = 0;
    int appliedLeft = -1;
    int appliedRight = -1;
};
static std::unordered_map<HWND, NoteVisualAssistMarginState> g_noteVisualAssistMarginByHwnd;

static int GetNoteLineNumberGutterWidth(HWND hWnd) {
    if (!hWnd || !IsWindow(hWnd)) return 0;
    int lineCount = std::max(1, static_cast<int>(SendMessageW(hWnd, EM_GETLINECOUNT, 0, 0)));
    int digits = 1;
    for (int n = lineCount; n >= 10; n /= 10) ++digits;
    digits = std::max(4, digits);

    int textW = ScaleY(hWnd, 32);
    HDC hdc = GetDC(hWnd);
    if (hdc) {
        HFONT font = GetActiveNoteFont();
        HFONT old = font ? static_cast<HFONT>(SelectObject(hdc, font)) : nullptr;
        std::wstring sample(static_cast<size_t>(digits), L'8');
        SIZE sz{};
        if (GetTextExtentPoint32W(hdc, sample.c_str(), static_cast<int>(sample.size()), &sz) && sz.cx > 0) {
            textW = sz.cx;
        }
        if (old) SelectObject(hdc, old);
        ReleaseDC(hWnd, hdc);
    }
    return textW + ScaleY(hWnd, 14);
}

struct NoteMarginFrame {
    int baseLeft = 0;
    int baseRight = 0;
    int desiredLeft = 0;
    int desiredRight = 0;
    int lineNumberGutterPx = 0;
};

static NoteMarginFrame ResolveNoteMarginFrame(HWND hWnd) {
    NoteMarginFrame frame;
    if (!hWnd || !IsWindow(hWnd)) return frame;

    NoteVisualAssistMarginState& state = g_noteVisualAssistMarginByHwnd[hWnd];
    if (!state.captured) {
        state.baseMargins = static_cast<UINT>(SendMessageW(hWnd, EM_GETMARGINS, 0, 0));
        state.captured = true;
    }

    frame.baseLeft = static_cast<int>(LOWORD(state.baseMargins));
    frame.baseRight = static_cast<int>(HIWORD(state.baseMargins));
    frame.lineNumberGutterPx = g_noteShowLineNumbers ? GetNoteLineNumberGutterWidth(hWnd) : 0;
    frame.desiredLeft = frame.baseLeft + NoteRenderLineStartInsetPx(hWnd);
    frame.desiredRight = std::max(frame.baseRight, ScaleY(hWnd, 12));
    if (g_noteShowLineNumbers) {
        frame.desiredLeft = std::max(frame.desiredLeft, frame.lineNumberGutterPx);
    }
    return frame;
}

static bool UpdateNoteVisualAssistMargins(HWND hWnd, bool invalidate) {
    if (!hWnd || !IsWindow(hWnd)) return false;
    NoteVisualAssistMarginState& state = g_noteVisualAssistMarginByHwnd[hWnd];
    const NoteMarginFrame margins = ResolveNoteMarginFrame(hWnd);
    const int desiredLeft = margins.desiredLeft;
    const int desiredRight = margins.desiredRight;
    if (desiredLeft == state.appliedLeft && desiredRight == state.appliedRight) {
        return false;
    }

    SendMessageW(hWnd, EM_SETMARGINS, EC_LEFTMARGIN | EC_RIGHTMARGIN,
                 MAKELPARAM(desiredLeft, desiredRight));
    state.appliedLeft = desiredLeft;
    state.appliedRight = desiredRight;
    if (invalidate) {
        InvalidateRect(hWnd, nullptr, FALSE);
    }
    return true;
}

struct NoteLayoutFrame {
    RECT client{};
    RECT formatRect{};
    int clientWidthPx = 0;
    int clientHeightPx = 0;
    int contentLeftPx = 0;
    int rawLeftPx = 0;
    int overlayLeftPx = 0;
    int lineNumberGutterPx = 0;
    int scrollX = 0;
    int canvasWidthPx = 0;
    int maxScrollX = 0;
    int dpi = 96;
    note::NoteDerivedSnapshotIdentity sourceIdentity{};
    bool renderActive = false;
    bool rawWrapActive = false;
};

static int GetNoteRenderCanvasWidthPx(HWND hWnd, int clientW) {
    clientW = std::max(0, clientW);
    return std::max(clientW, g_noteRenderedContentRightPx + GetNoteRenderRightPadPx(hWnd, clientW));
}

static int GetNoteRenderMaxScrollX(HWND hWnd, int clientW) {
    int canvasWidth = GetNoteRenderCanvasWidthPx(hWnd, clientW);
    return std::max(0, canvasWidth - std::max(0, clientW));
}

static NoteLayoutFrame BuildNoteLayoutFrame(HWND hWnd) {
    NoteLayoutFrame frame;
    if (!hWnd) return frame;

    frame.renderActive = IsNoteRenderActive();
    frame.rawWrapActive = (!frame.renderActive && g_noteWrapEnabled);
    frame.dpi = GetDpiY(hWnd);
    frame.sourceIdentity = note::NoteDerivedSnapshotIdentity{
        CurrentNoteTextCoreOwner(), CurrentNoteTextCoreRevision()};
    GetClientRect(hWnd, &frame.client);
    frame.clientWidthPx = std::max<int>(0, static_cast<int>(frame.client.right - frame.client.left));
    frame.clientHeightPx = std::max<int>(0, static_cast<int>(frame.client.bottom - frame.client.top));
    frame.canvasWidthPx = frame.clientWidthPx;

    const NoteMarginFrame margins = ResolveNoteMarginFrame(hWnd);
    frame.contentLeftPx = margins.desiredLeft;
    frame.rawLeftPx = margins.desiredLeft;
    frame.overlayLeftPx = margins.desiredLeft;
    frame.lineNumberGutterPx = margins.lineNumberGutterPx;

    frame.formatRect = frame.client;
    const int bottomPadPx = std::max(ScaleY(hWnd, 60), frame.clientHeightPx / 2);

    if (!frame.renderActive) {
        if (HDC hdc = GetDC(hWnd)) {
            HFONT oldFont = static_cast<HFONT>(SelectObject(hdc, GetActiveNoteFont()));
            TEXTMETRICW tm{};
            GetTextMetricsW(hdc, &tm);
            int baseLineHeight = tm.tmHeight;
            if (baseLineHeight <= 0) baseLineHeight = 1;
            int innerPad = std::max(1, baseLineHeight / 12);
            int renderYOffset = 1;
            frame.formatRect.top += innerPad + renderYOffset;
            SelectObject(hdc, oldFont);
            ReleaseDC(hWnd, hdc);
        }
    }

    if (frame.renderActive) {
        constexpr LONG kMaxFmtWidth = 32000;
        frame.canvasWidthPx = std::min<int>(kMaxFmtWidth,
                                            GetNoteRenderCanvasWidthPx(hWnd, frame.clientWidthPx));
        frame.maxScrollX = std::max(0, frame.canvasWidthPx - frame.clientWidthPx);
        frame.scrollX = std::clamp(g_noteRenderScrollX, 0, frame.maxScrollX);
        frame.formatRect.left = -frame.scrollX;
        frame.formatRect.right = frame.formatRect.left + frame.canvasWidthPx;
        frame.rawLeftPx = margins.desiredLeft - frame.scrollX;
        frame.overlayLeftPx = margins.desiredLeft - frame.scrollX;
    } else if (!frame.rawWrapActive) {
        constexpr LONG kMaxFmtWidth = 32000;
        frame.formatRect.right = std::max<LONG>(frame.formatRect.right, kMaxFmtWidth);
        frame.scrollX = 0;
    } else {
        frame.scrollX = 0;
    }
    frame.formatRect.bottom = frame.client.bottom + bottomPadPx;
    if (frame.renderActive && g_noteRenderedContentBottomPx > 0) {
        frame.formatRect.bottom = std::max<LONG>(
            frame.formatRect.bottom,
            static_cast<LONG>(g_noteRenderedContentBottomPx + bottomPadPx));
    }
    return frame;
}

static int NoteLayoutFrameLineBaseXForRenderState(const NoteLayoutFrame& frame, int nativeLineX) {
    if (frame.renderActive) {
        return frame.overlayLeftPx;
    }
    return nativeLineX;
}

static int NoteLayoutFrameClientXFromNativeLineX(const NoteLayoutFrame& frame,
                                                 int nativeLineX,
                                                 int nativeX) {
    return NoteLayoutFrameLineBaseXForRenderState(frame, nativeLineX) + (nativeX - nativeLineX);
}

static int NoteLayoutFrameAnchorScrollX(const NoteLayoutFrame& frame, HWND hWnd) {
    if (frame.renderActive) {
        return frame.scrollX;
    }
    POINT scroll{};
    if (QueryEditScrollPos(hWnd, &scroll)) {
        return scroll.x;
    }
    return 0;
}

static int StableNoteRenderLineBaseX(HWND hWnd) {
    return BuildNoteLayoutFrame(hWnd).overlayLeftPx;
}

static int NoteLineBaseXForRenderState(HWND hWnd, int nativeLineX) {
    if (IsNoteRenderActive()) {
        return StableNoteRenderLineBaseX(hWnd);
    }
    return nativeLineX;
}

static bool SetNoteRenderScrollPosX(HWND hWnd, int pos) {
    if (!hWnd) return false;
    RECT rc{};
    GetClientRect(hWnd, &rc);
    int clientW = std::max<int>(0, static_cast<int>(rc.right - rc.left));
    int next = std::clamp(pos, 0, GetNoteRenderMaxScrollX(hWnd, clientW));
    if (next == g_noteRenderScrollX) return false;
    g_noteRenderScrollX = next;
    UpdateNoteFormatRect(hWnd);
    InvalidateRect(hWnd, nullptr, FALSE);
    return true;
}

static void UpdateNoteFormatRect(HWND hWnd) {
    if (!hWnd) return;

    // The final renderer owns visible glyph geometry and both scroll ranges.
    // RichEdit remains an input/fallback transport only, so it receives one
    // neutral, unwrapped client rectangle without deriving a second canvas
    // extent or calling SetScrollInfo from the retired layout path.
    if (ApplyFinalNoteNativeFallbackFormatRect(hWnd)) return;

    const bool nextRenderActive = IsNoteRenderActive();
    const bool nextRawWrapActive = (!nextRenderActive && g_noteWrapEnabled);
    if (IsRichEditControl(hWnd)) {
        // RichEdit keeps its own wrap state. Explicitly switch it so existing soft wraps
        // are recomputed immediately when the user toggles raw-mode auto wrap.
        SendMessageW(hWnd, EM_SETTARGETDEVICE, 0, nextRawWrapActive ? 0 : 1);
    }

    // RichEdit may adjust its internal format rectangle when margins change.
    // Commit margins first, then derive and apply one coherent layout frame.
    UpdateNoteVisualAssistMargins(hWnd, false);
    const NoteLayoutFrame layoutFrame = BuildNoteLayoutFrame(hWnd);
    const bool renderActive = layoutFrame.renderActive;
    const bool rawWrapActive = layoutFrame.rawWrapActive;
    POINT nativeScroll{};
    bool hasNativeScroll = QueryNativeEditScrollPos(hWnd, &nativeScroll);
    if (!hasNativeScroll) {
        nativeScroll.x = GetScrollPos(hWnd, SB_HORZ);
        nativeScroll.y = GetScrollPos(hWnd, SB_VERT);
        hasNativeScroll = true;
    }
    if (renderActive) {
        // RichEdit's native horizontal extent tracks raw text, not the rendered overlay. In render mode,
        // keep a separate x offset and move the formatting rectangle itself.
        g_noteRenderScrollX = layoutFrame.scrollX;
    } else if (!rawWrapActive) {
        g_noteRenderScrollX = 0;
    } else {
        g_noteRenderScrollX = 0;
    }
    if (renderActive || rawWrapActive) {
        nativeScroll.x = 0;
    }
    if (renderActive) {
        SCROLLINFO sx{};
        sx.cbSize = sizeof(sx);
        sx.fMask = SIF_RANGE | SIF_PAGE | SIF_POS;
        sx.nMin = 0;
        sx.nMax = std::max(0, layoutFrame.canvasWidthPx - 1);
        sx.nPage = static_cast<UINT>(std::max(0, layoutFrame.clientWidthPx));
        sx.nPos = g_noteRenderScrollX;
        SetScrollInfo(hWnd, SB_HORZ, &sx, TRUE);
        ShowScrollBar(hWnd, SB_HORZ, (layoutFrame.maxScrollX > 0) ? TRUE : FALSE);
    } else {
        ShowScrollBar(hWnd, SB_HORZ, rawWrapActive ? FALSE : TRUE);
    }
    RECT fmt = layoutFrame.formatRect;
    SendMessageW(hWnd, EM_SETRECTNP, 0, reinterpret_cast<LPARAM>(&fmt));
    if (IsRichEditControl(hWnd)) {
        SendMessageW(hWnd, EM_REQUESTRESIZE, 0, 0);
    }
    if (hasNativeScroll) {
        POINT restore = nativeScroll;
        if (renderActive || rawWrapActive) {
            restore.x = 0;
        }
        if (!SendMessageW(hWnd, EM_SETSCROLLPOS, 0, reinterpret_cast<LPARAM>(&restore))) {
            SetScrollPos(hWnd, SB_VERT, restore.y, TRUE);
            if (renderActive || rawWrapActive) {
                SetScrollPos(hWnd, SB_HORZ, 0, TRUE);
            }
            SendMessageW(hWnd, WM_VSCROLL, MAKEWPARAM(SB_THUMBPOSITION, restore.y), 0);
        }
    }
}

static std::wstring ToLowerAscii(const std::wstring& s) {
    std::wstring out = s;
    for (auto& ch : out) {
        if (ch >= L'A' && ch <= L'Z') ch = static_cast<wchar_t>(ch - L'A' + L'a');
    }
    return out;
}

static wchar_t ToLowerAsciiChar(wchar_t ch) {
    if (ch >= L'A' && ch <= L'Z') return static_cast<wchar_t>(ch - L'A' + L'a');
    return ch;
}

static bool StartsWithAsciiNoCase(const std::wstring& s, const wchar_t* prefix) {
    size_t len = wcslen(prefix);
    if (s.size() < len) return false;
    for (size_t i = 0; i < len; ++i) {
        if (ToLowerAsciiChar(s[i]) != ToLowerAsciiChar(prefix[i])) return false;
    }
    return true;
}

static bool EndsWithAsciiNoCase(const std::wstring& s, const wchar_t* suffix) {
    size_t len = wcslen(suffix);
    if (s.size() < len) return false;
    size_t start = s.size() - len;
    for (size_t i = 0; i < len; ++i) {
        if (ToLowerAsciiChar(s[start + i]) != ToLowerAsciiChar(suffix[i])) return false;
    }
    return true;
}

static bool StartsWithAsciiNoCaseAt(const std::wstring& s, size_t pos, const wchar_t* prefix) {
    size_t len = wcslen(prefix);
    if (pos + len > s.size()) return false;
    for (size_t i = 0; i < len; ++i) {
        if (ToLowerAsciiChar(s[pos + i]) != ToLowerAsciiChar(prefix[i])) return false;
    }
    return true;
}

static bool ParseHexColor(const std::wstring& value, COLORREF& out) {
    std::wstring v = value;
    if (v.rfind(L"0x", 0) == 0 || v.rfind(L"0X", 0) == 0) v = v.substr(2);
    if (!v.empty() && v[0] == L'#') v = v.substr(1);
    if (v.size() != 6) return false;
    auto hex = [](wchar_t ch) -> int {
        if (ch >= L'0' && ch <= L'9') return ch - L'0';
        if (ch >= L'a' && ch <= L'f') return 10 + (ch - L'a');
        if (ch >= L'A' && ch <= L'F') return 10 + (ch - L'A');
        return -1;
    };
    int r1 = hex(v[0]), r2 = hex(v[1]);
    int g1 = hex(v[2]), g2 = hex(v[3]);
    int b1 = hex(v[4]), b2 = hex(v[5]);
    if (r1 < 0 || r2 < 0 || g1 < 0 || g2 < 0 || b1 < 0 || b2 < 0) return false;
    int r = r1 * 16 + r2;
    int g = g1 * 16 + g2;
    int b = b1 * 16 + b2;
    out = RGB(r, g, b);
    return true;
}

enum class ColorMode { None, Explicit, HiContrast };
enum class HorizontalAnchor { None, Left, Center, Right };

struct ColorSpec {
    ColorMode mode = ColorMode::None;
    COLORREF color = RGB(0, 0, 0);
};

struct TagStyle {
    bool bold = false;
    bool italic = false;
    bool underline = false;
    bool strike = false;
    bool hasTextColor = false;
    ColorSpec textColor;
    bool hasBackColor = false;
    ColorSpec backColor;
    bool hasIndent = false;
    int indent = 0;
    HorizontalAnchor anchor = HorizontalAnchor::None;
    int anchorOffsetChars = 0;
    int headingLevel = 0;
    bool hasLink = false;
    std::wstring linkId;
    bool linkAccent = false;
    bool linkUnderline = false;
    bool hasFontSize = false;
    int fontSizePx = 0;
    bool hasFontFace = false;
    std::wstring fontFace;
    bool hasLineHeight = false;
    int lineHeightPermille = 0;
};

struct StyleState {
    bool bold = false;
    bool italic = false;
    bool underline = false;
    bool strike = false;
    ColorSpec text;
    ColorSpec back;
    int indent = 0;
    HorizontalAnchor anchor = HorizontalAnchor::None;
    int anchorOffsetChars = 0;
    int headingLevel = 0;
    std::wstring linkId; // when non-empty, this run is clickable and resolves to a PDF LinkMarker by id
    bool linkAccent = false;
    bool linkUnderline = false;
    bool hasFontSize = false;
    int fontSizePx = 0;
    bool hasFontFace = false;
    std::wstring fontFace;
    bool hasLineHeight = false;
    int lineHeightPermille = 0;
};

struct TagFrame {
    TagStyle style{};
    size_t startLine = 0;
    size_t startSegment = 0;
    bool isMathBlock = false;
    bool isCodeFenceBlock = false;
    wchar_t codeFenceMarker = 0;
    std::wstring codeFenceLanguage;
    std::vector<std::wstring> closeAliases;
};

struct SegmentMeasureCache {
    bool valid = false;
    int baseFontHeight = 0;
    bool renderActive = false;
    int mathSupSubGapSupPercent = 0;
    int spaceWidth = 0;
    int baseAveCharWidth = 0;
    int baseMaxCharWidth = 0;
    int baseOverhang = 0;
    std::wstring baseFace;
    std::wstring jpFace;
    int width = 0;
    bool measureAsMath = false;
    bool prefixValid = false;
    std::vector<int> prefixWidths;
};

struct Segment {
    std::wstring text;
    std::wstring mathText;
    StyleState style;
    size_t rawStart = 0;
    size_t rawLen = 0;
    bool isMath = false;
    bool isMarkupMath = false;
    bool mathDisplay = false;
    bool isMarkdownLink = false;
    bool isInlineCode = false;
    int tableColumn = -1;
    note::TableCellAlign tableCellAlign = note::TableCellAlign::Default;
    mutable SegmentMeasureCache measureCache;
};

enum class TableRenderLineRole {
    None,
    Header,
    Body,
    Divider,
};

struct TableRenderLineInfo {
    TableRenderLineRole role = TableRenderLineRole::None;
    // The table owner is the first source line of the table.  Its stable ID
    // survives unrelated insertions above the table, unlike a raw offset.
    uint64_t ownerLineId = 0;
    size_t columnCount = 0;

    [[nodiscard]] bool active() const noexcept {
        return role != TableRenderLineRole::None && ownerLineId != 0 && columnCount > 0;
    }
};

struct LineCache {
    std::wstring rawLine;
    std::vector<Segment> segments;
    int headingLevel = 0;
    int headingPrefixLevel = 0;
    bool hasFontSize = false;
    int fontSizePx = 0;
    bool hasLineHeight = false;
    int lineHeightPermille = 1000;
    bool isCodeBlockLine = false;
    bool isHorizontalRuleLine = false;
    TableRenderLineInfo table;
    bool isCodeFenceLine = false;
    bool isCodeFenceOpening = false;
    bool isCodeFenceClosing = false;
    wchar_t codeFenceMarker = 0;
    std::wstring codeFenceLanguage;
    bool isCustomContainerLine = false;
    bool isCustomContainerFenceLine = false;
    bool isCustomContainerOpening = false;
    bool isCustomContainerClosing = false;
    int customContainerFenceCount = 0;
    std::wstring customContainerKind;
    std::vector<TagFrame> endStack;
};

struct NoteRenderLineInfo {
    size_t start = 0;
    size_t end = 0;
};

struct RenderLinePayload {
    std::wstring rawLine;
    LineCache cache;
};

// The line sequence is the authoritative ordering and source-coordinate
// index for one published render snapshot. Payloads are keyed by stable line
// IDs, so a splice only creates/removes rows in its local range; rows after
// it retain their cache object and derive their shifted coordinates lazily
// from the sequence aggregate.
class RenderLineStore {
public:
    struct SnapshotEntry {
        size_t index = 0;
        NoteRenderLineInfo info{};
        const std::wstring* raw_line = nullptr;
        LineCache* cache = nullptr;
    };

    [[nodiscard]] size_t size() const noexcept { return sequence_.line_count(); }
    [[nodiscard]] bool empty() const noexcept { return size() == 0; }
    [[nodiscard]] size_t text_length() const noexcept { return sequence_.text_length(); }

    void Clear() noexcept {
        sequence_ = note::NoteLineSequence{};
        payloads_.clear();
    }

    [[nodiscard]] bool Reset(const std::vector<std::wstring>& lines,
                             const std::vector<NoteRenderLineInfo>& infos,
                             size_t textLength) {
        std::vector<note::NoteLineSequenceLineSpec> specs;
        if (!BuildSpecs(lines, infos, textLength, &specs)) return false;

        note::NoteLineSequence nextSequence;
        if (nextSequence.Reset(specs) != note::NoteLineSequenceMutationResult::Applied) {
            return false;
        }
        std::unordered_map<uint64_t, RenderLinePayload> nextPayloads;
        nextPayloads.reserve(lines.size());
        for (size_t index = 0; index < lines.size(); ++index) {
            const auto location = nextSequence.LineAt(note::LineIndex{index});
            if (!location.has_value() || !location->line.id.valid()) return false;
            if (!nextPayloads.emplace(location->line.id.value,
                                      RenderLinePayload{lines[index], {}}).second) {
                return false;
            }
        }
        sequence_ = std::move(nextSequence);
        payloads_ = std::move(nextPayloads);
        return true;
    }

    [[nodiscard]] bool Replace(size_t first,
                               size_t lastExclusive,
                               const std::vector<std::wstring>& lines,
                               const std::vector<NoteRenderLineInfo>& infos,
                               const std::wstring& text) {
        std::vector<note::NoteLineSequenceLineSpec> specs;
        if (infos.empty()) return false;
        size_t replacementNextStart = infos.back().end;
        if (replacementNextStart < text.size() && text[replacementNextStart] == L'\r') {
            ++replacementNextStart;
            if (replacementNextStart < text.size() && text[replacementNextStart] == L'\n') {
                ++replacementNextStart;
            }
        } else if (replacementNextStart < text.size() && text[replacementNextStart] == L'\n') {
            ++replacementNextStart;
        }
        if (!BuildSpecs(lines, infos, replacementNextStart, &specs)) return false;
        if (first > lastExclusive || lastExclusive > size()) return false;

        note::NoteLineSequenceReplaceResult result = sequence_.Replace(
            note::LineIndex{first}, note::LineIndex{lastExclusive}, specs);
        if (!result.applied() || result.inserted_line_ids.size() != lines.size() ||
            sequence_.text_length() != text.size()) {
            // The source text is canonical. A failed derived-store mutation
            // must never be used as a partially updated render snapshot.
            Clear();
            return false;
        }
        try {
            payloads_.reserve(payloads_.size() + result.inserted_line_ids.size());
            for (note::NoteLineId id : result.removed_line_ids) {
                payloads_.erase(id.value);
            }
            for (size_t index = 0; index < lines.size(); ++index) {
                if (!payloads_.emplace(result.inserted_line_ids[index].value,
                                       RenderLinePayload{lines[index], {}}).second) {
                    Clear();
                    return false;
                }
            }
        } catch (...) {
            Clear();
            return false;
        }
        return true;
    }

    [[nodiscard]] const LineCache& operator[](size_t index) const noexcept {
        const RenderLinePayload* payload = PayloadAt(index);
        assert(payload != nullptr);
        return payload->cache;
    }

    [[nodiscard]] LineCache& operator[](size_t index) noexcept {
        RenderLinePayload* payload = PayloadAt(index);
        assert(payload != nullptr);
        return payload->cache;
    }

    [[nodiscard]] const std::wstring& RawLineAt(size_t index) const noexcept {
        const RenderLinePayload* payload = PayloadAt(index);
        assert(payload != nullptr);
        return payload->rawLine;
    }

    [[nodiscard]] std::optional<NoteRenderLineInfo> LineInfoAt(size_t index) const noexcept {
        const auto location = sequence_.LineAt(note::LineIndex{index});
        if (!location.has_value()) return std::nullopt;
        return NoteRenderLineInfo{location->start.value, location->content_end.value};
    }

    [[nodiscard]] std::optional<size_t> FindLineByOffset(size_t offset) const noexcept {
        const auto location = sequence_.FindByOffset(note::Utf16CodeUnitOffset{offset});
        if (!location.has_value()) return std::nullopt;
        return location->line_index.value;
    }

    [[nodiscard]] uint64_t LineIdForOffset(size_t offset) const noexcept {
        const auto location = sequence_.FindByOffset(note::Utf16CodeUnitOffset{offset});
        return location.has_value() ? location->line.id.value : 0;
    }

    // A full pass must not turn O(n) parsing/layout into O(n log n) by
    // resolving every row index through the treap.  The returned pointer view
    // stays valid until this UI-thread-owned store is mutated.
    [[nodiscard]] std::optional<std::vector<SnapshotEntry>> SnapshotEntries() {
        const std::vector<note::NoteLineSequenceLocation> locations =
            sequence_.SnapshotLocations();
        if (locations.size() != payloads_.size()) return std::nullopt;

        std::vector<SnapshotEntry> entries;
        entries.reserve(locations.size());
        for (const note::NoteLineSequenceLocation& location : locations) {
            const auto found = payloads_.find(location.line.id.value);
            if (found == payloads_.end()) return std::nullopt;
            entries.push_back(SnapshotEntry{
                location.line_index.value,
                NoteRenderLineInfo{location.start.value, location.content_end.value},
                &found->second.rawLine,
                &found->second.cache,
            });
        }
        return entries;
    }

private:
    [[nodiscard]] static bool BuildSpecs(const std::vector<std::wstring>& lines,
                                         const std::vector<NoteRenderLineInfo>& infos,
                                         size_t finalNextStart,
                                         std::vector<note::NoteLineSequenceLineSpec>* out) {
        if (!out || lines.empty() || lines.size() != infos.size()) return false;
        out->clear();
        out->reserve(lines.size());
        for (size_t index = 0; index < lines.size(); ++index) {
            const NoteRenderLineInfo info = infos[index];
            if (info.end < info.start || info.end - info.start != lines[index].size() ||
                info.end > finalNextStart) {
                return false;
            }
            const size_t nextStart = (index + 1 < infos.size())
                ? infos[index + 1].start
                : finalNextStart;
            if (nextStart < info.end || nextStart > finalNextStart) return false;
            out->push_back(note::NoteLineSequenceLineSpec{
                lines[index].size(), nextStart - info.end});
        }
        return true;
    }

    [[nodiscard]] const RenderLinePayload* PayloadAt(size_t index) const noexcept {
        const auto location = sequence_.LineAt(note::LineIndex{index});
        if (!location.has_value()) return nullptr;
        const auto found = payloads_.find(location->line.id.value);
        return found == payloads_.end() ? nullptr : &found->second;
    }

    [[nodiscard]] RenderLinePayload* PayloadAt(size_t index) noexcept {
        const auto location = sequence_.LineAt(note::LineIndex{index});
        if (!location.has_value()) return nullptr;
        const auto found = payloads_.find(location->line.id.value);
        return found == payloads_.end() ? nullptr : &found->second;
    }

    note::NoteLineSequence sequence_;
    std::unordered_map<uint64_t, RenderLinePayload> payloads_;
};

static bool SegmentHasVisibleText(const Segment& seg) {
    for (wchar_t ch : seg.text) {
        if (!iswspace(ch)) return true;
    }
    return false;
}

static bool IsDisplayMathSegment(const Segment& seg) {
    return seg.isMath && seg.mathDisplay;
}

static bool LineHasDisplayMathSegment(const LineCache& cache) {
    for (const auto& seg : cache.segments) {
        if (IsDisplayMathSegment(seg)) return true;
    }
    return false;
}

static bool LineIsStandaloneDisplayMath(const LineCache& cache) {
    bool sawDisplayMath = false;
    for (const auto& seg : cache.segments) {
        if (!SegmentHasVisibleText(seg)) continue;
        if (IsDisplayMathSegment(seg)) {
            sawDisplayMath = true;
            continue;
        }
        return false;
    }
    return sawDisplayMath;
}

static int ResolveAdditionalRenderIndentChars(const LineCache& cache) {
    int indent = (cache.headingLevel > 0) ? 1 : 0;
    if (cache.isCodeBlockLine) indent += 4;
    if (cache.isCustomContainerLine) indent += 3;
    if (LineIsStandaloneDisplayMath(cache)) indent += 1;
    return indent;
}

static int ResolveSpecialLineVisualPadPx(const LineCache& cache, int baseLineHeight) {
    baseLineHeight = std::max(1, baseLineHeight);
    int pad = 0;
    if (cache.isCodeBlockLine) {
        pad = std::max(pad, std::max(2, baseLineHeight / 8));
    }
    if (cache.isCustomContainerLine) {
        pad = std::max(pad, std::max(2, baseLineHeight / 10));
    }
    if (LineHasDisplayMathSegment(cache)) {
        pad = std::max(pad, std::max(2, baseLineHeight / 10));
    }
    return pad;
}

static void ApplyDefaultMathSegmentLayout(Segment* seg) {
    if (!seg || !seg->isMath || !seg->mathDisplay) return;
    seg->style.anchor = HorizontalAnchor::None;
    seg->style.anchorOffsetChars = 0;
}

static size_t SegmentRawLen(const Segment& seg) {
    return (seg.rawLen > 0) ? seg.rawLen : seg.text.size();
}

static void CycleInlineMathVerticalAlignmentSetting() {
    // The status assist has no popup affordance. Keep its interaction compact
    // and deterministic: each click advances through the same three values
    // offered by General settings.
    g_config.noteInlineMathVerticalAlignment =
        (std::clamp(g_config.noteInlineMathVerticalAlignment, 0, 2) + 1) % 3;
    PersistConfig();
    RefreshNoteRenderForPreferenceChange();
    if (g_hBottomNote) InvalidateRect(g_hBottomNote, nullptr, FALSE);
}

void RefreshNoteRenderForPreferenceChange() {
    if (g_hNoteEdit) {
        RefreshFinalNoteRenderFrame(g_hNoteEdit, std::nullopt);
        if (GetFocus() == g_hNoteEdit) SyncNativeCaretToRenderState(g_hNoteEdit);
        InvalidateRect(g_hNoteEdit, nullptr, FALSE);
    }
}

// The rounded background is part of inline code's occupied geometry, not an
// overlay on adjacent prose. Account for both internal side pads in every
// flow calculation so following punctuation cannot be painted inside it.
static int InlineCodeChipHorizontalPaddingPx(const LineCache& cache,
                                             const Segment& seg,
                                             int baseFontHeight) {
    if (!seg.isInlineCode || cache.isCodeBlockLine || seg.text.empty()) return 0;
    return std::max(3, std::max(1, baseFontHeight) / 4);
}

static int SegmentFlowAdvanceWidth(const LineCache& cache,
                                   const Segment& seg,
                                   int baseFontHeight,
                                   int contentWidth) {
    const int width = std::max(0, contentWidth);
    const int pad = InlineCodeChipHorizontalPaddingPx(cache, seg, baseFontHeight);
    if (pad <= 0 || width > std::numeric_limits<int>::max() - pad * 2) {
        return pad <= 0 ? width : std::numeric_limits<int>::max();
    }
    return width + pad * 2;
}

static bool IsLiteralEscapeLeadAt(const std::wstring& text, size_t pos) {
    return pos + 2 < text.size() && text[pos] == L'!' && text[pos + 1] == L'/';
}

static std::wstring DecodeLiteralEscapes(const std::wstring& raw) {
    if (raw.empty()) return raw;
    std::wstring out;
    out.reserve(raw.size());
    for (size_t i = 0; i < raw.size(); ++i) {
        if (IsLiteralEscapeLeadAt(raw, i)) {
            out.push_back(raw[i + 2]);
            i += 2;
            continue;
        }
        out.push_back(raw[i]);
    }
    return out;
}

static size_t VisibleCharsBeforeRawOffset(const std::wstring& raw,
                                          size_t rawOffset,
                                          bool decodeMarkdownBackslashEscapes = false) {
    rawOffset = std::min(rawOffset, raw.size());
    if (raw.size() >= 4 && raw.front() == L'[') {
        size_t closeBracket = raw.find(L']');
        if (closeBracket != std::wstring::npos &&
            closeBracket + 1 < raw.size() &&
            raw[closeBracket + 1] == L'(' &&
            raw.back() == L')') {
            if (rawOffset <= 1) return 0;
            if (rawOffset <= closeBracket) return rawOffset - 1;
            return closeBracket - 1;
        }
    }
    size_t visible = 0;
    for (size_t i = 0; i < rawOffset;) {
        if (IsLiteralEscapeLeadAt(raw, i)) {
            if (i + 3 <= rawOffset) {
                ++visible;
                i += 3;
            } else {
                break;
            }
            continue;
        }
        if (decodeMarkdownBackslashEscapes && note::IsMarkdownBackslashEscapeAt(raw, i)) {
            if (i + 2 <= rawOffset) {
                ++visible;
                i += 2;
            } else {
                break;
            }
            continue;
        }
        ++visible;
        ++i;
    }
    return visible;
}

static size_t RawOffsetForVisibleCharCount(const std::wstring& raw,
                                           size_t visibleCount,
                                           bool decodeMarkdownBackslashEscapes = false) {
    if (visibleCount == 0) return 0;
    if (raw.size() >= 4 && raw.front() == L'[') {
        size_t closeBracket = raw.find(L']');
        if (closeBracket != std::wstring::npos &&
            closeBracket + 1 < raw.size() &&
            raw[closeBracket + 1] == L'(' &&
            raw.back() == L')') {
            size_t labelLen = closeBracket - 1;
            return 1 + std::min(visibleCount, labelLen);
        }
    }
    size_t visible = 0;
    for (size_t i = 0; i < raw.size();) {
        if (IsLiteralEscapeLeadAt(raw, i)) {
            ++visible;
            i += 3;
            if (visible >= visibleCount) return i;
            continue;
        }
        if (decodeMarkdownBackslashEscapes && note::IsMarkdownBackslashEscapeAt(raw, i)) {
            ++visible;
            i += 2;
            if (visible >= visibleCount) return i;
            continue;
        }
        ++visible;
        ++i;
        if (visible >= visibleCount) return i;
    }
    return raw.size();
}

static bool SegmentDecodesMarkdownBackslashEscapes(const LineCache& cache, const Segment& seg) {
    return !cache.isCodeBlockLine && !seg.isInlineCode && !seg.isMath;
}

static bool VisibleIndexToRawOffsetInLine(const LineCache& cache, size_t visibleIndex, size_t* outRawOffset) {
    if (!outRawOffset) return false;
    size_t visibleCursor = 0;
    for (const auto& seg : cache.segments) {
        if (seg.text.empty()) continue;
        const size_t segVisLen = seg.text.size();
        if (visibleIndex <= visibleCursor + segVisLen) {
            const size_t withinVisible = visibleIndex - visibleCursor;
            const std::wstring rawSeg = cache.rawLine.substr(seg.rawStart, SegmentRawLen(seg));
            const size_t withinRaw = RawOffsetForVisibleCharCount(
                rawSeg, withinVisible, SegmentDecodesMarkdownBackslashEscapes(cache, seg));
            *outRawOffset = seg.rawStart + withinRaw;
            return true;
        }
        visibleCursor += segVisLen;
    }
    if (visibleIndex == visibleCursor) {
        *outRawOffset = cache.rawLine.size();
        return true;
    }
    return false;
}

static NoteListMarkerInfo DetectNoteListMarkerInfo(const LineCache& cache) {
    NoteListMarkerInfo info{};
    if (cache.segments.empty()) return info;

    bool haveFirst = false;
    wchar_t first = 0;
    wchar_t second = 0;
    size_t firstIndex = 0;
    size_t visibleIndex = 0;

    for (const auto& seg : cache.segments) {
        for (wchar_t ch : seg.text) {
            if (!haveFirst) {
                if (IsNoteBulletIndentChar(ch)) {
                    ++visibleIndex;
                    continue;
                }
                haveFirst = true;
                first = ch;
                firstIndex = visibleIndex;
                ++visibleIndex;
                continue;
            }
            second = ch;
            goto done_scan;
        }
    }
done_scan:

    if (!haveFirst) return info;
    if (!IsMarkdownBulletMarker(first) || second != L' ') return info;

    size_t rawStart = 0;
    size_t rawEnd = 0;
    if (!VisibleIndexToRawOffsetInLine(cache, firstIndex, &rawStart)) return info;
    if (!VisibleIndexToRawOffsetInLine(cache, firstIndex + 2, &rawEnd)) return info;
    if (rawEnd <= rawStart) return info;

    info.rawStart = rawStart;
    info.rawEnd = rawEnd;
    info.marker = first;
    info.valid = true;
    return info;
}

static bool ShouldRenderMathSegment(const Segment& seg) {
    if (!seg.isMath) return false;
    if (!IsNoteRenderActive()) return false;
    if (IsNoteMathRenderActive()) return true;
    return seg.isMarkupMath;
}

static std::wstring GetSegmentMathBody(const Segment& seg) {
    std::wstring body = !seg.mathText.empty() ? seg.mathText : StripMathDelims(seg.text);
    body = StripLineJoins(body);
    body = NormalizeMarkupMathText(body);
    return body;
}

struct FontKey {
    bool bold = false;
    bool italic = false;
    bool japanese = false;
    int extraPx = 0;
    std::wstring fontFace;
};

struct FontEntry {
    FontKey key{};
    HFONT font = nullptr;
    TEXTMETRICW metrics{};
};

struct MarkupFontProvider {
    HFONT baseFont = nullptr;
    TEXTMETRICW baseMetrics{};
    int baseAscent = 0;
    int spaceWidth = 0;
    LOGFONTW baseLf{};
    LOGFONTW jpLf{};
    bool hasBaseLf = false;
    bool hasJpLf = false;
    std::vector<FontEntry> cache;

    void Initialize(HDC hdc, HFONT preferred);
    HFONT Acquire(HDC hdc,
                  bool bold,
                  bool italic,
                  int extraPx,
                  TEXTMETRICW* out,
                  bool japanese = false,
                  const std::wstring* fontFaceOverride = nullptr);
    ~MarkupFontProvider();
};

static bool IsJapaneseRenderChar(wchar_t ch);
static int MeasureStyledSegmentTextWidth(HDC hdc,
                                         MarkupFontProvider& fonts,
                                         const std::wstring& text,
                                         bool bold,
                                         bool italic,
                                         int extraPx,
                                         const std::wstring* fontFaceOverride = nullptr,
                                         std::vector<int>* prefix = nullptr);
static void DrawStyledSegmentText(HDC hdc,
                                  MarkupFontProvider& fonts,
                                  int x,
                                  int y,
                                  const std::wstring& text,
                                  bool bold,
                                  bool italic,
                                  int extraPx,
                                  const std::wstring* fontFaceOverride = nullptr);
static int FirstGlyphLeftBearingAlignmentPx(HDC hdc,
                                            MarkupFontProvider& fonts,
                                            const std::wstring& text,
                                            bool bold,
                                            bool italic,
                                            int extraPx,
                                            const std::wstring* fontFaceOverride = nullptr);

static bool QueryEditScrollPos(HWND hWnd, POINT* out);
static int ResolveHeadingLevel(const LineCache& cache, const Segment& seg);
static int ComputeSegmentFontExtraPx(int headingLevel, const StyleState& style, int baseFontHeight);
static const std::wstring* EffectiveSegmentFontFaceOverride(const LineCache& cache, const Segment& seg);
static int EffectiveSegmentHeadingLevel(const LineCache& cache, const Segment& seg);
static int ResolveLineHeightPermille(const LineCache& cache);
static int ResolveLineMaxFontSizePx(const LineCache& cache);
static bool SegmentUsesAnchoredLayout(const Segment& seg);
static bool SameAnchoredLayout(const Segment& a, const Segment& b);
static int ComputeAnchoredRunStartX(HWND hWnd,
                                    int clientW,
                                    int scrollX,
                                    HorizontalAnchor anchor,
                                    int offsetPx,
                                    int runWidth);
static int MeasureRenderedSegmentWidth(HDC hdc,
                                       MarkupFontProvider& fonts,
                                       const LineCache& cache,
                                       const Segment& seg,
                                       int baseFontHeight,
                                       std::vector<int>* outPrefixWidths = nullptr,
                                       bool* outMeasureAsMath = nullptr);
static int InlineCodeChipHorizontalPaddingPx(const LineCache& cache,
                                             const Segment& seg,
                                             int baseFontHeight);
static int SegmentFlowAdvanceWidth(const LineCache& cache,
                                   const Segment& seg,
                                   int baseFontHeight,
                                   int contentWidth);
static int MeasureAnchoredRunWidth(HDC hdc,
                                   MarkupFontProvider& fonts,
                                   const LineCache& cache,
                                   size_t startIndex,
                                   int baseFontHeight);
static bool EnsureTableRenderLayouts(HWND hWnd,
                                     HDC hdc,
                                     MarkupFontProvider& fonts,
                                     int dpi,
                                     TableRenderLayoutReadPolicy policy =
                                         TableRenderLayoutReadPolicy::RequireCurrentDerivedState);
static const TableRenderLayoutEntry* FindTableRenderLayout(uint64_t ownerLineId);
static bool BuildTableRenderRowGeometry(HDC hdc,
                                        MarkupFontProvider& fonts,
                                 const LineCache& cache,
                                 int baseFontHeight,
                                 TableRenderRowGeometry* out);
static bool ResolveTableSegmentX(const TableRenderRowGeometry& geometry,
                                 const LineCache& cache,
                                 size_t segmentIndex,
                                 int tableLeftX,
                                 int* outX);
static int ComputeRenderMarginTopWithPercent(int linePaintHeight, int baseLineHeight, int linePermille, int topPercent);

struct ResolvedColors {
    COLORREF text = RGB(0, 0, 0);
    COLORREF back = RGB(255, 255, 255);
    bool hasBack = false;
};

struct ActiveNoteRenderSnapshot {
    note::NoteDerivedSnapshotIdentity sourceIdentity{};
    RenderLineStore lines;

    bool Matches(note::NoteId ownerNoteId, uint64_t sourceRevision) const {
        return sourceIdentity == note::NoteDerivedSnapshotIdentity{
            ownerNoteId, sourceRevision};
    }

    void CommitIdentity(note::NoteId ownerNoteId, uint64_t sourceRevision) {
        sourceIdentity = note::NoteDerivedSnapshotIdentity{
            ownerNoteId, sourceRevision};
    }

    void Reset() {
        sourceIdentity = {};
        lines.Clear();
    }
};

struct NoteRenderDirtyLineRange {
    bool valid = false;
    size_t first = 0;
    size_t last = 0;
    bool lineCountChanged = false;
    bool full = false;
};

struct NoteRenderStaleLineRange {
    bool valid = false;
    size_t first = 0;
    size_t last = 0;
};

struct MathDisplayCache {
    bool ready = false;
    std::wstring rawText;
    MathDisplay display;
};

struct TableRenderLayoutEntry {
    uint64_t ownerLineId = 0;
    note::NoteTableLayout layout;
    // A Markdown delimiter has no visible cell segment and therefore cannot
    // supply its own indentation. Every grid row instead uses the first
    // content row's resolved offset, published with the measured layout.
    int leftIndentPx = 0;
};

// Per-row data derived from the same glyph widths as the table layout.  It
// makes each table segment lookup O(1), even if a cell has many style runs.
struct TableRenderRowGeometry {
    const TableRenderLayoutEntry* table = nullptr;
    std::vector<int> prior_content_widths_px;
    std::vector<int> content_widths_px;
};

struct TableRenderLayoutCache {
    note::NoteDerivedSnapshotIdentity sourceIdentity{};
    HFONT baseFont = nullptr;
    int baseFontHeight = 0;
    int spaceWidth = 0;
    int dpi = 96;
    // Published together with entries.  WM_PAINT must be able to decide
    // whether structured tables are usable without walking every table.
    bool layoutsValid = false;
    std::vector<TableRenderLayoutEntry> entries;
    std::unordered_map<uint64_t, size_t> entryIndices;

    void Reset() {
        sourceIdentity = {};
        baseFont = nullptr;
        baseFontHeight = 0;
        spaceWidth = 0;
        dpi = 96;
        layoutsValid = false;
        entries.clear();
        entryIndices.clear();
    }

    [[nodiscard]] bool Matches(note::NoteDerivedSnapshotIdentity identity,
                               HFONT font,
                               int fontHeight,
                               int measuredSpaceWidth,
                               int measuredDpi) const noexcept {
        return sourceIdentity == identity && baseFont == font &&
            baseFontHeight == fontHeight && spaceWidth == measuredSpaceWidth &&
            dpi == measuredDpi;
    }
};

// The RichEdit control is an input transport, while NoteTextCore is the
// canonical document. A binding is published only after an event-boundary
// exact comparison has shown that they contain the same canonical text. Paint
// may then reuse the immutable TextCore index without re-copying the control.
struct NoteEditorTextCoreBinding {
    uint64_t editorMutationRevision = 0;
    uint64_t synchronizedMutationRevision = 0;
    note::NoteDerivedSnapshotIdentity sourceIdentity{};

    void Invalidate() noexcept {
        if (editorMutationRevision != std::numeric_limits<uint64_t>::max()) {
            ++editorMutationRevision;
        }
        synchronizedMutationRevision = 0;
        sourceIdentity = {};
    }

    void MarkSynchronized(note::NoteDerivedSnapshotIdentity identity) noexcept {
        sourceIdentity = identity;
        synchronizedMutationRevision = editorMutationRevision;
    }

    [[nodiscard]] bool Matches(note::NoteDerivedSnapshotIdentity identity) const noexcept {
        return sourceIdentity.valid() &&
            sourceIdentity.note_id == identity.note_id &&
            sourceIdentity.source_revision == identity.source_revision &&
            synchronizedMutationRevision == editorMutationRevision;
    }
};

// An IME preedit is intentionally not a canonical document revision.  This
// small adapter records the already-published source row before the preedit
// begins, so paint can keep that committed background without treating the
// transient composition text as parsed markup.  It never owns text: only
// indices and measured positions are retained.
struct NoteImeCompositionPresentationAnchor {
    note::NoteDerivedSnapshotIdentity sourceIdentity{};
    int logicalLine = -1;
    size_t selectionStart = 0;
    size_t selectionEnd = 0;
    size_t lineStart = 0;
    size_t nextLineStart = 0;
    size_t compositionLength = 0;
    int baselineWindowTextLength = -1;
    POINT baselineLineStart{};
    POINT baselineNextLineStart{};
    bool hasNextLine = false;
    bool compositionLengthKnown = false;
    bool valid = false;

    void Reset() noexcept { *this = {}; }
};

// The final compositor keeps a composition in canonical source coordinates,
// not RichEdit's CRLF-expanded transport coordinates.  It is captured before
// IMM changes the native control and is the only proof that allows one
// temporary raw row to coexist with unchanged final surfaces.
using NoteFinalImePreeditState = note::NoteRenderFinalImePreeditSession;

struct LocalNoteViewContext {
    ActiveNoteRenderSnapshot renderSnapshot;
    TableRenderLayoutCache tableRenderLayoutCache;
    NoteEditorTextCoreBinding editorTextCoreBinding;
    note::NoteRenderFinalWin32AdapterState finalRenderState;
    uint64_t finalRenderScrollY = 0;
    // Revealing the caret is an input/source transition, not a side effect
    // of republishing identical geometry after hover, scrolling or resize.
    note::NoteDerivedSnapshotIdentity finalRenderLastCaretSource{};
    std::optional<note::NoteRenderFinalCaretGeometry> finalRenderLastCaret;
    // RichEdit exposes ordered selection endpoints, not a reliable active
    // end. Retain direction only for a source/selection-proven key sequence.
    struct FinalVerticalNavigation {
        note::NoteDerivedSnapshotIdentity source{};
        note::Span selection{};
        size_t anchor = 0;
        size_t active = 0;
        int preferredX = 0;
        note::NoteRenderLayoutKey layoutKey{};
    };
    std::optional<FinalVerticalNavigation> finalVerticalNavigation;
    // SetScrollInfo may synchronously cause RichEdit to recalculate its
    // format rectangle and send WM_SIZE back through the note subclass.  The
    // final renderer is allowed to refresh from that notification, but it
    // must not begin another native scrollbar synchronization before the
    // originating one has returned.
    bool finalRenderScrollSyncInProgress = false;
    // Publication can synchronously call Win32 APIs (measurement, selection,
    // scrollbars) which in turn may dispatch another note message. A nested
    // request is coalesced into a bounded follow-up pass after the outer
    // publication returns; recursive measurement/publishing would otherwise
    // pin the UI thread.
    bool finalRenderPublicationInProgress = false;
    bool finalRenderPublicationPending = false;
    // Provenance of the current structural publication, not an event counter.
    // Diagnostic only; never used to choose paint, input or persistence.
    bool finalStructuralPublicationWasLocalPatch = false;
    // Paint observation only; never participates in ownership or layout.
    bool currentLineHighlightPainted = false;
    // Applying RichEdit's transport-only fallback rectangle can synchronously
    // request another resize. It must never turn that nested notification
    // into a second format transaction or a legacy scrollbar update.
    bool finalNativeFallbackFormatSyncInProgress = false;
    // Actual native viewport translation, retained through transient frame
    // withdrawal/Clear(). Reset only when a neutral rectangle is applied;
    // Clear() must also preserve an in-flight native dispatch guard.
    POINT finalNativeTextOrigin{};
    bool finalNativeTextOriginSyncInProgress = false;
    // Native transport must not scroll/blit the visible final surface during
    // a private input/anchor transaction. Clear() preserves live scopes and
    // the caller's independent WM_SETREDRAW request.
    unsigned finalNativeRedrawDepth = 0;
    bool nativeRedrawRequested = true;
    // Scalar diagnostics only; never used to choose rendering or persistence.
    uint64_t finalNativeRedrawTransactions = 0;
    uint64_t noteClientPaintCount = 0;
    uint64_t noteNativeFallbackPaintCount = 0;
    NoteFinalImePreeditState finalImePreedit;
    size_t renderIndexedTextLength = 0;
    size_t lastParsedMarkupLength = 0;
    size_t lastParsedMarkupWindowTextLength = 0;
    int lastParsedMarkupBaseFontHeightPx = 0;
    std::unordered_map<std::wstring, std::shared_ptr<mathrender::Node>> mathNodeCache;
    std::unordered_map<std::wstring, mathrender::Layout> mathLayoutCache;
    note::NoteLayoutMetricsSnapshot measuredLayoutSnapshot;
    note::NoteLayoutMetricsSnapshot appliedLayoutSnapshot;

    int renderedContentRightPx = 0;
    bool renderedHorizontalExtentDirty = false;
    int renderedContentBottomPx = 0;
    int renderScrollX = 0;

    NoteRenderDirtyLineRange renderDirtyLines;
    NoteRenderStaleLineRange renderStaleLines;
    bool derivedFrameCommitRequiredBeforePaint = false;
    bool lineSpacingInvalidatedNote = false;
    std::vector<int> appliedNativeRawMetricLines;

    bool typing = false;
    wchar_t pendingCtrlInsertNavChar = 0;
    bool imeComposing = false;
    note::NoteImePresentationPhase imePresentationPhase =
        note::NoteImePresentationPhase::Idle;
    // Borrowed only by synchronous native IME dispatch. Keep intermediate
    // EN_CHANGE outcomes out of canonical history and saves until it returns.
    // Clear() does not release a live dispatch scope.
    bool imeNativeDispatchInProgress = false;
    // IMM positioning can synchronously notify this HWND. Only the outer
    // positioning scope owns its borrowed context; Clear() must not reset it.
    bool imeCandidateWindowSyncInProgress = false;
    DWORD imeCandidateListMask = 1;
    bool imeCompositionRequiresWholeViewFallback = false;
    NoteImeCompositionPresentationAnchor imeCompositionPresentationAnchor;
    int renderSwitchDepth = 0;
    bool renderSwitchBlocked = false;
    bool bottomNoteRenderTogglePendingAfterIme = false;
    std::vector<MathDisplayCache> mathDisplayCache;

    void Clear() {
        renderSnapshot.Reset();
        tableRenderLayoutCache.Reset();
        editorTextCoreBinding = {};
        finalRenderState.Clear();
        finalStructuralPublicationWasLocalPatch = false;
        currentLineHighlightPainted = false;
        finalRenderScrollY = 0;
        finalRenderLastCaretSource = {};
        finalRenderLastCaret.reset();
        finalVerticalNavigation.reset();
        finalImePreedit.Reset();
        imeCandidateListMask = 1;
        renderIndexedTextLength = 0;
        lastParsedMarkupLength = 0;
        lastParsedMarkupWindowTextLength = 0;
        lastParsedMarkupBaseFontHeightPx = 0;
        mathNodeCache.clear();
        mathLayoutCache.clear();
        measuredLayoutSnapshot.Reset();
        appliedLayoutSnapshot.Reset();
        renderedContentRightPx = 0;
        renderedHorizontalExtentDirty = false;
        renderedContentBottomPx = 0;
        renderScrollX = 0;
        renderDirtyLines = {};
        renderStaleLines = {};
        derivedFrameCommitRequiredBeforePaint = false;
        lineSpacingInvalidatedNote = false;
        appliedNativeRawMetricLines.clear();
        typing = false;
        pendingCtrlInsertNavChar = 0;
        imeComposing = false;
        imePresentationPhase = note::NoteImePresentationPhase::Idle;
        imeCompositionRequiresWholeViewFallback = false;
        imeCompositionPresentationAnchor.Reset();
        renderSwitchDepth = 0;
        renderSwitchBlocked = false;
        bottomNoteRenderTogglePendingAfterIme = false;
        mathDisplayCache.clear();
    }
};



static std::unordered_map<HWND, LocalNoteViewContext> g_viewContexts;
static LocalNoteViewContext g_unboundViewContext;

class ScopedNoteViewContextBinding {
public:
    explicit ScopedNoteViewContextBinding(HWND hwnd)
        : previous_(g_boundNoteViewContextHwnd) {
        if (hwnd) g_boundNoteViewContextHwnd = hwnd;
    }

    ~ScopedNoteViewContextBinding() {
        g_boundNoteViewContextHwnd = previous_;
    }

    ScopedNoteViewContextBinding(const ScopedNoteViewContextBinding&) = delete;
    ScopedNoteViewContextBinding& operator=(const ScopedNoteViewContextBinding&) = delete;

private:
    HWND previous_ = nullptr;
};

static HWND CurrentNoteViewContextWindow() {
    return g_boundNoteViewContextHwnd ? g_boundNoteViewContextHwnd : g_hNoteEdit;
}

static HWND ResolveNoteViewContextHwnd(HWND hwnd = nullptr) {
    if (hwnd) return hwnd;
    return CurrentNoteViewContextWindow();
}

static LocalNoteViewContext& GetViewContext(HWND hwnd) {
    hwnd = ResolveNoteViewContextHwnd(hwnd);
    if (!hwnd) return g_unboundViewContext;
    return g_viewContexts[hwnd];
}

// HWND-local Win32 boundary: retain pixels during private native movement,
// then request one asynchronous final paint. Nesting never reenables redraw
// owned by an outer caller, and destruction cannot leave the editor frozen.
class ScopedFinalNoteNativeRedraw {
public:
    explicit ScopedFinalNoteNativeRedraw(HWND window, bool enabled = true) : window_(window) {
        if (!enabled || !window || !g_oldNoteProc) return;
        auto& context = GetViewContext(window);
        if (context.finalNativeRedrawDepth == 0 &&
            (!context.nativeRedrawRequested ||
             (GetWindowLongPtrW(window, GWL_STYLE) & WS_VISIBLE) == 0)) return;
        active_ = true;
        if (context.finalNativeRedrawDepth++ == 0) {
            ++context.finalNativeRedrawTransactions;
            CallWindowProcW(g_oldNoteProc, window, WM_SETREDRAW, FALSE, 0);
        }
    }
    ~ScopedFinalNoteNativeRedraw() {
        if (!active_ || !IsWindow(window_)) return;
        auto& context = GetViewContext(window_);
        if (context.finalNativeRedrawDepth == 0) return;
        if (--context.finalNativeRedrawDepth != 0 || !context.nativeRedrawRequested) return;
        CallWindowProcW(g_oldNoteProc, window_, WM_SETREDRAW, TRUE, 0);
        // Do not UpdateWindow/erase, toggle visibility, or publish a frame
        // here. Input completion has already settled the current owner.
        RedrawWindow(window_, nullptr, nullptr, RDW_INVALIDATE | RDW_FRAME | RDW_NOERASE | RDW_NOCHILDREN);
    }
    ScopedFinalNoteNativeRedraw(const ScopedFinalNoteNativeRedraw&) = delete;
    ScopedFinalNoteNativeRedraw& operator=(const ScopedFinalNoteNativeRedraw&) = delete;
private:
    HWND window_ = nullptr;
    bool active_ = false;
};

static const wchar_t* CurrentNoteDisplayLabelId() {
    // Describe the published display, not merely the requested render setting.
    // Surface ranges are coalesced ownership intervals, not individual glyphs.
    if (!IsNoteRenderActive()) return L"note.assist.display.raw";
    if (g_noteShowInvisibleChars || g_noteShowLineNumbers) {
        return L"note.assist.display.editor_marks";
    }
    if (!FinalFrameCanUseCustomPaint(g_hNoteEdit)) return L"note.assist.display.fallback";
    const auto& frame = GetViewContext(g_hNoteEdit).finalRenderState.frame();
    bool raw = false, structured = false;
    for (const auto& range : frame->presentation()->surface_ranges()) {
        raw = raw || range.surface == note::NoteRenderFinalSurfaceKind::RawPaint;
        structured = structured || range.surface == note::NoteRenderFinalSurfaceKind::StructuredPaint;
        if (raw && structured) return L"note.assist.display.hybrid";
    }
    return raw ? L"note.assist.display.editing" : L"note.assist.display.structured";
}

// The Win32 messages are authoritative for the transition out of a preedit.
// GCS_COMPSTR is used only to recover a missed START/END notification; after
// GCS_RESULTSTR it may temporarily retain the committed text and must not
// revive the provisional presentation state.
static void AdvanceNoteImePresentationPhaseForWindow(
    HWND hWnd, note::NoteImePresentationEvent event) {
    LocalNoteViewContext& context = GetViewContext(hWnd);
    context.imePresentationPhase = note::AdvanceNoteImePresentationPhase(
        context.imePresentationPhase, event);
    context.imeComposing = note::NoteImePresentationPhaseHasLivePreedit(
        context.imePresentationPhase);
    if (!context.imeComposing) {
        context.imeCompositionRequiresWholeViewFallback = false;
    }
}

static bool IsNoteImeResultCommittedAwaitingEnd(HWND hWnd) {
    return GetViewContext(hWnd).imePresentationPhase ==
        note::NoteImePresentationPhase::ResultCommittedAwaitingEnd;
}

bool IsNoteImeCanonicalChangeDeferred(HWND hEdit) {
    if (!hEdit) return false;
    const auto& context = GetViewContext(hEdit);
    return context.imeNativeDispatchInProgress ||
        note::NoteImePresentationPhaseHasLivePreedit(context.imePresentationPhase);
}

static void InvalidateCurrentNoteTextCoreEditorBinding(HWND hWnd) {
    if (!hWnd) return;
    GetViewContext(hWnd).editorTextCoreBinding.Invalidate();
}

void NoteEditorTextMutationObserved(HWND hEdit) {
    InvalidateCurrentNoteTextCoreEditorBinding(hEdit);
    // The native control may now contain a different revision while its
    // EN_CHANGE route is still preparing the canonical transaction.  Do not
    // leave a prior custom frame visible for that interval.
    WithdrawFinalNoteRenderFrame(hEdit);
}

static void MarkCurrentNoteTextCoreAsEditorSynchronized(HWND hWnd,
                                                         std::wstring_view observedText) {
    if (!hWnd || hWnd != CurrentNoteViewContextWindow()) return;
    const note::NoteTextCore* core = CurrentNoteTextCore();
    if (!core || !core->valid() || !core->MatchesRaw(observedText)) return;
    GetViewContext(hWnd).editorTextCoreBinding.MarkSynchronized(
        note::NoteDerivedSnapshotIdentity{core->note_id(), core->content_revision()});
}

// A ticket is allowed to publish this binding without another full RichEdit
// read only after its pre-edit canonical root, deleted range, post-edit
// selection, transport length, and inserted range were all checked by the
// input adapter. The caller also supplies the root returned after the Kernel
// accepted that same edit. Any un-ticketed or failed input remains on the
// full-text recovery boundary above.
static bool MarkCurrentNoteTextCoreAsEditorSynchronizedForAcceptedTicket(
    HWND hWnd,
    const note::NoteTextPieceSequence::Snapshot& acceptedSnapshot) {
    if (!hWnd || hWnd != CurrentNoteViewContextWindow() || !acceptedSnapshot.valid()) {
        return false;
    }
    const note::NoteTextCore* core = CurrentNoteTextCore();
    if (!core || !core->valid() || !core->MatchesSnapshot(acceptedSnapshot)) return false;
    GetViewContext(hWnd).editorTextCoreBinding.MarkSynchronized(
        note::NoteDerivedSnapshotIdentity{core->note_id(), core->content_revision()});
    return true;
}

static void ForgetLocalNoteViewContext(HWND hwnd) {
    if (!hwnd) return;
    g_viewContexts.erase(hwnd);
}

inline ActiveNoteRenderSnapshot& Access_noteRenderSnapshot() { return GetViewContext(nullptr).renderSnapshot; }
inline RenderLineStore& Access_lineCache() { return GetViewContext(nullptr).renderSnapshot.lines; }
