static bool BeginOwnedDialogPresenceAutomation(HWND owner, const wchar_t* expectedClass, std::wstring* outError);
static bool EndOwnedDialogPresenceAutomation(HWND owner, const wchar_t* scenario, std::wstring* outError,
                                              bool requireDialog = true);

// Disposable UI fixture only: borrow the existing native transport boundary
// to deliver reentrant IME notifications/queries and selection paints while
// their outer dispatch is still private. No production callback is added.
struct NoteImeNativeDispatchProbe {
    WNDPROC native = nullptr;
    HWND edit = nullptr;
    unsigned events = 0;
    unsigned nativeQueries = 0;
    bool valid = true;
    unsigned failureMask = 0;
    bool captureNativeCandidate = false;
    bool haveNativeCandidate = false;
    CANDIDATEFORM nativeCandidate{};
    bool pointerSelectionActive = false;
    unsigned pointerSelections = 0;
    bool pointerValid = true;
};
static NoteImeNativeDispatchProbe* g_uiAutomationImeNativeProbe = nullptr;

static LRESULT CALLBACK ProbeNoteImeNativeDispatch(HWND window, UINT message, WPARAM wParam, LPARAM lParam) {
    auto* probe = g_uiAutomationImeNativeProbe;
    if (!probe || !probe->native) return DefWindowProcW(window, message, wParam, lParam);
    if (window == probe->edit && message == WM_IME_REQUEST && wParam == IMR_QUERYCHARPOSITION) {
        ++probe->nativeQueries;
    }
    const LRESULT result = CallWindowProcW(probe->native, window, message, wParam, lParam);
    if (window == probe->edit && message == WM_IME_NOTIFY && probe->captureNativeCandidate) {
        HIMC imc = ImmGetContext(window);
        if (imc) {
            probe->haveNativeCandidate = ImmGetCandidateWindow(imc, 0, &probe->nativeCandidate) != FALSE;
            ImmReleaseContext(window, imc);
        }
    }
    if (window == probe->edit && message == EM_SETSEL && probe->pointerSelectionActive) {
        ++probe->pointerSelections;
        const auto before = ObserveNoteRenderRuntime();
        SendMessageW(window, WM_PAINT, 0, 0);
        const auto after = ObserveNoteRenderRuntime();
        probe->pointerValid = probe->pointerValid && before.nativeRedrawDepth > 0 &&
            after.clientPaintCount == before.clientPaintCount;
        return result;
    }
    if (window != probe->edit || (message != WM_IME_STARTCOMPOSITION &&
        message != WM_IME_COMPOSITION && message != WM_IME_ENDCOMPOSITION)) return result;
    ++probe->events;
    const auto before = ObserveNoteRenderRuntime();
    HIMC imc = ImmGetContext(window);
    if (!imc) { probe->valid = false; return result; }
    CANDIDATEFORM sentinel{};
    sentinel.dwStyle = CFS_EXCLUDE;
    sentinel.ptCurrentPos = {17, 23};
    sentinel.rcArea = {17, 23, 31, 39};
    const bool placed = ImmSetCandidateWindow(imc, &sentinel) != FALSE;
    // The native notification may legitimately reposition its own candidate
    // window. Only an additional application correction is forbidden while
    // final geometry is private, so compare against the native result.
    probe->haveNativeCandidate = false;
    probe->captureNativeCandidate = true;
    SendMessageW(window, WM_IME_NOTIFY, IMN_OPENCANDIDATE, 1);
    probe->captureNativeCandidate = false;
    SyncNoteImeCandidateWindowToCaret(window);
    CANDIDATEFORM actual{};
    const bool read = ImmGetCandidateWindow(imc, 0, &actual) != FALSE;
    ImmReleaseContext(window, imc);
    IMECHARPOSITION query{};
    query.dwSize = sizeof(query);
    query.pt = {101, 103};
    const auto untouched = query;
    const bool refused = SendMessageW(window, WM_IME_REQUEST, IMR_QUERYCHARPOSITION,
        reinterpret_cast<LPARAM>(&query)) == FALSE && std::memcmp(&query, &untouched, sizeof(query)) == 0;
    SendMessageW(window, WM_PAINT, 0, 0);
    const auto after = ObserveNoteRenderRuntime();
    const bool sameCandidate = read && probe->haveNativeCandidate &&
        actual.dwStyle == probe->nativeCandidate.dwStyle &&
        EqualRect(&actual.rcArea, &probe->nativeCandidate.rcArea) &&
        actual.ptCurrentPos.x == probe->nativeCandidate.ptCurrentPos.x &&
        actual.ptCurrentPos.y == probe->nativeCandidate.ptCurrentPos.y;
    // Independent failure bits distinguish an unavailable IMM fixture from
    // a production query, pixel-publication, or candidate-correction failure.
    probe->failureMask |= (!placed ? 1u : 0u) | (!read ? 2u : 0u) |
        (!probe->haveNativeCandidate ? 4u : 0u) | (!sameCandidate ? 8u : 0u) |
        (!refused ? 16u : 0u) | (probe->nativeQueries != 0 ? 32u : 0u) |
        (before.nativeRedrawDepth == 0 ? 64u : 0u) |
        (after.clientPaintCount != before.clientPaintCount ? 128u : 0u);
    probe->valid = probe->valid && probe->failureMask == 0;
    return result;
}

// Read-only UIA client observation on an MTA worker, never on the editor's
// UI thread. The automation child owns the worker; its existing watchdog
// bounds an OS/provider hang. No client/provider is installed for normal use.
struct NoteUiaCaretObservation {
    HWND edit = nullptr;
    HRESULT status = E_FAIL;
    BOOL active = FALSE;
    bool hasRectangle = false;
    double rectangle[4]{};
};

static DWORD WINAPI ReadNoteUiaCaretForAutomation(void* parameter) {
    std::unique_ptr<std::shared_ptr<NoteUiaCaretObservation>> holder(
        static_cast<std::shared_ptr<NoteUiaCaretObservation>*>(parameter));
    const auto observation = *holder;
    const HRESULT initialized = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
    if (FAILED(initialized)) { observation->status = initialized; return 0; }
    struct ScopedComExit { ~ScopedComExit() { CoUninitialize(); } } comExit;
    struct ScopedComRelease {
        IUnknown* object;
        ~ScopedComRelease() { if (object) object->Release(); }
    };
    IUIAutomation* client = nullptr;
    observation->status = CoCreateInstance(__uuidof(CUIAutomation), nullptr, CLSCTX_INPROC_SERVER,
        __uuidof(IUIAutomation), reinterpret_cast<void**>(&client));
    ScopedComRelease releaseClient{client};
    if (FAILED(observation->status) || !client) return 0;
    IUIAutomationElement* element = nullptr;
    observation->status = client->ElementFromHandle(observation->edit, &element);
    ScopedComRelease releaseElement{element};
    if (FAILED(observation->status) || !element) return 0;
    IUIAutomationTextPattern2* pattern = nullptr;
    observation->status = element->GetCurrentPatternAs(UIA_TextPattern2Id,
        __uuidof(IUIAutomationTextPattern2), reinterpret_cast<void**>(&pattern));
    ScopedComRelease releasePattern{pattern};
    if (FAILED(observation->status) || !pattern) return 0;
    IUIAutomationTextRange* range = nullptr;
    observation->status = pattern->GetCaretRange(&observation->active, &range);
    ScopedComRelease releaseRange{range};
    if (FAILED(observation->status) || !range) return 0;
    HMODULE module = LoadLibraryExW(L"oleaut32.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
    if (!module) { observation->status = HRESULT_FROM_WIN32(GetLastError()); return 0; }
    struct ScopedDllExit { HMODULE module; ~ScopedDllExit() { FreeLibrary(module); } } dllExit{module};
    using DestroyArray = HRESULT (WINAPI*)(SAFEARRAY*);
    using AccessArray = HRESULT (WINAPI*)(SAFEARRAY*, void**);
    using UnaccessArray = HRESULT (WINAPI*)(SAFEARRAY*);
    const auto destroyArray = reinterpret_cast<DestroyArray>(GetProcAddress(module, "SafeArrayDestroy"));
    const auto accessArray = reinterpret_cast<AccessArray>(GetProcAddress(module, "SafeArrayAccessData"));
    const auto unaccessArray = reinterpret_cast<UnaccessArray>(GetProcAddress(module, "SafeArrayUnaccessData"));
    if (!destroyArray || !accessArray || !unaccessArray) return 0;
    SAFEARRAY* rectangles = nullptr;
    observation->status = range->GetBoundingRectangles(&rectangles);
    struct ScopedArrayExit {
        SAFEARRAY* array;
        DestroyArray destroy;
        ~ScopedArrayExit() { if (array) (void)destroy(array); }
    } arrayExit{rectangles, destroyArray};
    if (FAILED(observation->status) || !rectangles) return 0;
    if (rectangles->cDims != 1 || rectangles->cbElements != sizeof(double) ||
        rectangles->rgsabound[0].cElements < 4) return 0;
    double* values = nullptr;
    observation->status = accessArray(rectangles, reinterpret_cast<void**>(&values));
    if (FAILED(observation->status)) return 0;
    if (values) {
        std::copy_n(values, 4, observation->rectangle);
        observation->hasRectangle = true;
    }
    observation->status = unaccessArray(rectangles);
    return 0;
}

[[nodiscard]] static bool ObserveNoteUiaCaretForAutomation(HWND edit) {
    const auto before = CaptureNoteUiSnapshot();
    RECT client{};
    if (!before.finalFrameActive || !GetClientRect(edit, &client)) return false;
    if (before.finalCaretClientRect.left < client.left || before.finalCaretClientRect.right > client.right ||
        before.finalCaretClientRect.top < client.top || before.finalCaretClientRect.bottom > client.bottom) {
        AppendUiAutomationTrace(L"math_render:native_text_anchor_skipped_not_fully_visible");
        return true;
    }
    CHARRANGE selection{};
    SendMessageW(edit, EM_EXGETSEL, 0, reinterpret_cast<LPARAM>(&selection));
    if (selection.cpMin != selection.cpMax) return false;
    POINTL point{LONG_MIN, LONG_MIN};
    SendMessageW(edit, EM_POSFROMCHAR, reinterpret_cast<WPARAM>(&point), selection.cpMin);
    const bool nativeMatches = point.x == before.finalCaretClientRect.left &&
        point.y == before.finalCaretClientRect.top && before.systemCaretMatchesFinal;
    AppendUiAutomationTrace(L"math_render:native_text_anchor_matches=" + std::to_wstring(nativeMatches) +
        L" actual=" + std::to_wstring(point.x) + L":" + std::to_wstring(point.y) +
        L" expected=" + std::to_wstring(before.finalCaretClientRect.left) + L":" +
        std::to_wstring(before.finalCaretClientRect.top));
    // Native geometry is required in the ordinary regression run. UIA's
    // provider query can deadlock inside WM_GETOBJECT even from a separate
    // client, so keep it as an explicit, watchdog-bounded diagnostic only.
    wchar_t enableUia[2]{};
    if (GetEnvironmentVariableW(L"PDF_NOTE_SMALL_UIA_CARET_PROBE", enableUia, 2) != 1 || enableUia[0] != L'1') {
        AppendUiAutomationTrace(L"math_render:uia_caret_deferred_explicit_diagnostic");
        return nativeMatches;
    }
    const auto observation = std::make_shared<NoteUiaCaretObservation>();
    observation->edit = edit;
    auto* holder = new std::shared_ptr<NoteUiaCaretObservation>(observation);
    HANDLE worker = CreateThread(nullptr, 0, ReadNoteUiaCaretForAutomation, holder, 0, nullptr);
    if (!worker) { delete holder; return false; }
    struct ScopedWorkerExit { HANDLE worker; ~ScopedWorkerExit() { CloseHandle(worker); } } workerExit{worker};
    const ULONGLONG deadline = GetTickCount64() + 10000;
    for (;;) {
        const ULONGLONG now = GetTickCount64();
        if (now >= deadline) { AppendUiAutomationTrace(L"math_render:uia_caret_timeout"); return false; }
        const DWORD waited = MsgWaitForMultipleObjectsEx(1, &worker,
            static_cast<DWORD>(deadline - now), QS_ALLINPUT, MWMO_INPUTAVAILABLE);
        if (waited == WAIT_OBJECT_0) break;
        if (waited != WAIT_OBJECT_0 + 1) return false;
        MSG message{};
        for (int pumped = 0; pumped < 64 && PeekMessageW(&message, nullptr, 0, 0, PM_REMOVE); ++pumped) {
            if (message.message == WM_QUIT) { PostQuitMessage(static_cast<int>(message.wParam)); return false; }
            TranslateMessage(&message);
            DispatchMessageW(&message);
        }
    }
    POINT expected{before.finalCaretClientRect.left, before.finalCaretClientRect.top};
    if (!ClientToScreen(edit, &expected)) return false;
    AppendUiAutomationTrace(L"math_render:uia_caret hr=" + std::to_wstring(observation->status) +
        L" active=" + std::to_wstring(observation->active) + L" rectangle=" +
        std::to_wstring(observation->hasRectangle) + L" actual=" +
        std::to_wstring(observation->rectangle[0]) + L":" + std::to_wstring(observation->rectangle[1]) +
        L":" + std::to_wstring(observation->rectangle[3]) + L" expected=" +
        std::to_wstring(expected.x) + L":" + std::to_wstring(expected.y) + L":" +
        std::to_wstring(before.finalCaretClientRect.bottom - before.finalCaretClientRect.top));
    const auto after = CaptureNoteUiSnapshot();
    return nativeMatches && SUCCEEDED(observation->status) && observation->active && observation->hasRectangle &&
        observation->rectangle[0] == expected.x && observation->rectangle[1] == expected.y &&
        observation->rectangle[3] == before.finalCaretClientRect.bottom - before.finalCaretClientRect.top &&
        note::SameSnapshotIdentity(before.sourceIdentity, after.sourceIdentity) &&
        before.canonicalText == after.canonicalText && after.finalFrameActive && after.systemCaretMatchesFinal;
}

// Read the system's MSAA caret as an assistive client would. This is an
// automation-only observation; no provider, WinEvent hook or IME UI is owned
// by the application. Load only the Windows system DLL and release its COM
// object before unloading it. No link/build contract change is needed.
[[nodiscard]] static bool VerifyAccessibleSystemCaretForAutomation(HWND edit) {
    GUITHREADINFO info{};
    info.cbSize = sizeof(info);
    if (!GetGUIThreadInfo(GetCurrentThreadId(), &info) || info.hwndCaret != edit) return false;
    HMODULE module = LoadLibraryExW(L"oleacc.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
    if (!module) return false;
    struct ScopedModuleRelease {
        HMODULE module;
        ~ScopedModuleRelease() { FreeLibrary(module); }
    } releaseModule{module};
    using GetAccessible = HRESULT (WINAPI*)(HWND, DWORD, REFIID, void**);
    const auto getAccessible = reinterpret_cast<GetAccessible>(
        GetProcAddress(module, "AccessibleObjectFromWindow"));
    if (!getAccessible) return false;
    IAccessible* accessible = nullptr;
    // The hidden automation child need not own the foreground queue. Ask for
    // this window's caret, not the global foreground caret of another app.
    const HRESULT obtained = getAccessible(edit, static_cast<DWORD>(OBJID_CARET),
        __uuidof(IAccessible), reinterpret_cast<void**>(&accessible));
    if (FAILED(obtained) || !accessible) {
        AppendUiAutomationTrace(L"math_render:accessible_caret_unavailable hr=" + std::to_wstring(obtained));
        return false;
    }
    struct ScopedAccessibleRelease {
        IAccessible* accessible;
        ~ScopedAccessibleRelease() { accessible->Release(); }
    } releaseAccessible{accessible};
    VARIANT self{};
    self.vt = VT_I4;
    self.lVal = CHILDID_SELF;
    LONG x = 0, y = 0, width = 0, height = 0;
    const HRESULT located = accessible->accLocation(&x, &y, &width, &height, self);
    POINT origin{};
    if (FAILED(located) || !ClientToScreen(edit, &origin)) {
        AppendUiAutomationTrace(L"math_render:accessible_caret_location_failed hr=" + std::to_wstring(located));
        return false;
    }
    // Windows may expose an empty accessible caret for this hidden,
    // background automation child. It is not a measured geometry mismatch.
    // Skip only that observation; the native/final equality remains required
    // by the caller. A visible foreground caret returning empty still fails.
    if (width == 0 && height == 0 &&
        (!IsWindowVisible(edit) || GetForegroundWindow() != GetAncestor(edit, GA_ROOT))) {
        AppendUiAutomationTrace(L"math_render:accessible_caret_skipped_hidden_background_empty");
        return true;
    }
    const bool matches = static_cast<int64_t>(x) == static_cast<int64_t>(origin.x) + info.rcCaret.left &&
        static_cast<int64_t>(y) == static_cast<int64_t>(origin.y) + info.rcCaret.top &&
        width == info.rcCaret.right - info.rcCaret.left && height == info.rcCaret.bottom - info.rcCaret.top;
    AppendUiAutomationTrace(L"math_render:accessible_caret_matches=" + std::to_wstring(matches) +
        L" actual=" + std::to_wstring(x) + L":" + std::to_wstring(y) + L":" + std::to_wstring(height) +
        L" expected=" + std::to_wstring(static_cast<int64_t>(origin.x) + info.rcCaret.left) + L":" +
        std::to_wstring(static_cast<int64_t>(origin.y) + info.rcCaret.top) + L":" +
        std::to_wstring(info.rcCaret.bottom - info.rcCaret.top));
    return matches;
}

static bool SetFaultInjectionPointForAutomation(const wchar_t* point) {
    if (!SetEnvironmentVariableW(L"PDF_NOTE_SMALL_ENABLE_FAULT_INJECTION", L"1")) return false;
    return SetEnvironmentVariableW(L"PDF_NOTE_SMALL_THROW_POINT", point ? point : L"");
}

static void ClearFaultInjectionPointForAutomation() {
    SetEnvironmentVariableW(L"PDF_NOTE_SMALL_ENABLE_FAULT_INJECTION", nullptr);
    SetEnvironmentVariableW(L"PDF_NOTE_SMALL_THROW_POINT", nullptr);
}

static int FindAlternativeFileIndex(HWND list, int currentIndex) {
    const int count = ListboxItemCount(list);
    for (int i = 0; i < count; ++i) {
        if (i == currentIndex) continue;
        if (list == g_hPdfList) {
            if (i < static_cast<int>(g_pdfFiles.size()) &&
                NormalizePathKey(g_pdfFiles[static_cast<size_t>(i)].path) != NormalizePathKey(CurrentLogicalPdfPath())) {
                return i;
            }
            continue;
        }
        if (list == g_hNoteList) {
            if (i < static_cast<int>(g_noteFiles.size()) &&
                NormalizePathKey(g_noteFiles[static_cast<size_t>(i)].path) != NormalizePathKey(g_currentNotePath)) {
                return i;
            }
            continue;
        }
        return i;
    }
    return -1;
}

static std::wstring GetNoteAutomationIndexingText() {
    if (!g_hNoteEdit) return L"";
    const int len = GetWindowTextLengthW(g_hNoteEdit);
    if (len <= 0) return L"";
    std::wstring text(static_cast<size_t>(len) + 1, L'\0');
    const int copied = GetWindowTextW(g_hNoteEdit, text.data(), len + 1);
    if (copied < 0) return L"";
    text.resize(static_cast<size_t>(copied));

    std::wstring normalized;
    normalized.reserve(text.size());
    for (size_t i = 0; i < text.size(); ++i) {
        normalized.push_back(text[i]);
        if (text[i] == L'\r' && i + 1 < text.size() && text[i + 1] == L'\n') {
            ++i;
        }
    }
    return normalized;
}

static bool OpenUiAutomationClipboard(HWND owner) {
    // Clipboard ownership is serialized across the desktop.  A fixed handful
    // of 1 ms retries is not enough when a clipboard manager or the shell is
    // completing a delayed-render transaction, so use a short bounded window.
    // This path is available only to the local automation fixture; normal note
    // editing never waits here.
    constexpr ULONGLONG kRetryWindowMs = 500;
    constexpr DWORD kRetryIntervalMs = 5;
    const ULONGLONG deadline = GetTickCount64() + kRetryWindowMs;
    do {
        if (OpenClipboard(owner)) return true;
        Sleep(kRetryIntervalMs);
    } while (GetTickCount64() < deadline);
    return false;
}

static bool SetUiAutomationClipboardText(HWND owner, const std::wstring& text) {
    if (text.size() >= std::numeric_limits<size_t>::max() / sizeof(wchar_t)) return false;
    const size_t bytes = (text.size() + 1) * sizeof(wchar_t);
    HGLOBAL memory = GlobalAlloc(GMEM_MOVEABLE, bytes);
    if (!memory) return false;
    void* destination = GlobalLock(memory);
    if (!destination) {
        GlobalFree(memory);
        return false;
    }
    std::copy_n(text.c_str(), text.size() + 1, static_cast<wchar_t*>(destination));
    GlobalUnlock(memory);
    if (!OpenUiAutomationClipboard(owner)) {
        GlobalFree(memory);
        return false;
    }
    if (!EmptyClipboard()) {
        CloseClipboard();
        GlobalFree(memory);
        return false;
    }
    if (!SetClipboardData(CF_UNICODETEXT, memory)) {
        CloseClipboard();
        GlobalFree(memory);
        return false;
    }
    CloseClipboard();
    return true;
}

static std::optional<std::wstring> GetUiAutomationClipboardText(HWND owner) {
    if (!IsClipboardFormatAvailable(CF_UNICODETEXT) || !OpenUiAutomationClipboard(owner)) return std::nullopt;
    HANDLE memory = GetClipboardData(CF_UNICODETEXT);
    if (!memory) {
        CloseClipboard();
        return std::nullopt;
    }
    const wchar_t* source = static_cast<const wchar_t*>(GlobalLock(memory));
    if (!source) {
        CloseClipboard();
        return std::nullopt;
    }
    std::wstring text(source);
    GlobalUnlock(memory);
    CloseClipboard();
    return text;
}

static int FindNoteTextSnippetStart(const std::wstring& needle) {
    if (!g_hNoteEdit || needle.empty()) return -1;
    const std::wstring text = GetNoteAutomationIndexingText();
    if (text.empty()) return -1;
    const size_t pos = text.find(needle);
    if (pos == std::wstring::npos) return -1;
    return static_cast<int>(pos);
}

static bool SelectNoteTextSnippet(const std::wstring& needle) {
    const int start = FindNoteTextSnippetStart(needle);
    if (start < 0 || !g_hNoteEdit) return false;
    const int end = start + static_cast<int>(needle.size());
    SendMessageW(g_hNoteEdit, EM_SETSEL, static_cast<WPARAM>(start), static_cast<LPARAM>(end));
    SendMessageW(g_hNoteEdit, EM_SCROLLCARET, 0, 0);
    return true;
}

static bool SendUiAutomationNoteUndoChangedText() {
    if (!g_hNoteEdit) return false;
    SetFocus(g_hNoteEdit);
    if (GetFocus() != g_hNoteEdit) return false;
    const std::wstring beforeText = GetNoteAutomationIndexingText();
    const bool canUndo = CanExecuteNoteUndoRedoFromFocus(true);
    const bool saveRunning = IsSaveTransactionRunning();
    SendMessageW(g_hNoteEdit, WM_UNDO, 0, 0);
    const bool changed = GetNoteAutomationIndexingText() != beforeText;
    AppendUiAutomationTrace(L"note_undo:can=" + std::to_wstring(canUndo) +
                            L" save_running=" + std::to_wstring(saveRunning) +
                            L" changed=" + std::to_wstring(changed));
    return changed;
}

static bool SendUiAutomationNoteRedoChangedText() {
    if (!g_hNoteEdit) return false;
    SetFocus(g_hNoteEdit);
    if (GetFocus() != g_hNoteEdit) return false;
    const std::wstring beforeText = GetNoteAutomationIndexingText();
    SendMessageW(g_hNoteEdit, EM_REDO, 0, 0);
    return GetNoteAutomationIndexingText() != beforeText;
}

static bool SendUiAutomationNoteMenuUndoRedoChangedText(HWND owner, bool undo) {
    if (!owner || !g_hNoteEdit) return false;
    SetFocus(g_hNoteEdit);
    if (GetFocus() != g_hNoteEdit) return false;
    const std::wstring beforeText = GetNoteAutomationIndexingText();
    const UINT command = undo ? ID_EDIT_UNDO : ID_EDIT_REDO;
    SendMessageW(owner, WM_COMMAND, MAKEWPARAM(command, 0), 0);
    return GetNoteAutomationIndexingText() != beforeText;
}

static bool SendUiAutomationNoteTextInput(const std::wstring& text) {
    if (!g_hNoteEdit || text.empty()) return false;
    SetFocus(g_hNoteEdit);
    if (GetFocus() != g_hNoteEdit) return false;
    for (const wchar_t ch : text) {
        SendMessageW(g_hNoteEdit, WM_CHAR, static_cast<WPARAM>(ch), 0);
    }
    return true;
}

static bool SendUiAutomationNoteBackspace(size_t count) {
    if (!g_hNoteEdit || count == 0) return false;
    SetFocus(g_hNoteEdit);
    if (GetFocus() != g_hNoteEdit) return false;
    for (size_t i = 0; i < count; ++i) {
        // RichEdit receives Backspace as a key message; unlike text input it
        // does not rely on a synthetic WM_CHAR for the deletion itself.
        SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_BACK, 1);
    }
    return true;
}

static std::wstring DescribeNoteUiSnapshot(const NoteUiSnapshot& snapshot) {
    auto boolText = [](bool value) -> const wchar_t* {
        return value ? L"true" : L"false";
    };
    return L"note=" + std::to_wstring(snapshot.sourceIdentity.note_id.value) +
           L", view=" + std::to_wstring(snapshot.viewIdentity.view_id.value) +
           L", revision=" + std::to_wstring(snapshot.sourceIdentity.content_revision) +
           L", tx_suppress=" + std::wstring(boolText(snapshot.changeSuppressed)) +
           L", tx_active=" + std::wstring(boolText(snapshot.programMutationActive)) +
           L", tx_wait_input=" + std::wstring(boolText(snapshot.waitingForUserInput)) +
           L", tx_depth=" + std::to_wstring(snapshot.transactionDepth) +
           L", tx_sequence=" + std::to_wstring(snapshot.transactionSequence) +
           L", tx_owner=" + std::to_wstring(snapshot.transactionOwnerNoteId.value) +
           L", final_caret=" + std::wstring(boolText(snapshot.finalCaretGeometryReady)) +
           L", system_caret_matches=" + std::wstring(boolText(snapshot.systemCaretMatchesFinal)) +
           L", route=" + std::wstring(boolText(snapshot.markdownRoute)) +
           L", render=" + std::wstring(boolText(snapshot.renderOverlayActive)) +
           L", ready=" + std::wstring(boolText(snapshot.documentReady)) +
           L", math=" + std::to_wstring(snapshot.mathSpanCount) +
           L", rendered=" + std::to_wstring(snapshot.renderedMathSegmentCount) +
           L", display=" + std::to_wstring(snapshot.renderedDisplayMathSegmentCount) +
           L", selected=" + std::wstring(boolText(snapshot.selectedMathFound)) +
           L", block=" + std::wstring(boolText(snapshot.selectedMathIsBlock)) +
           L", delim=" + snapshot.selectedMathDelimiter +
           L", norm=" + snapshot.selectedMathNormalizedText;
}

static bool RestoreUiAutomationNoteSelection(HWND owner,
                                             const std::wstring& notePath,
                                             int noteIndex,
                                             std::wstring* outError) {
    if (notePath.empty()) return true;
    LoadNoteFile(owner, notePath);
    SyncBottomPaneAfterNoteLoad(owner);
    SyncLeftPaneSelection();
    if (noteIndex >= 0 && g_hNoteList) {
        SendMessageW(g_hNoteList, LB_SETCURSEL, noteIndex, 0);
    }
    if (NormalizePathKey(g_currentNotePath) != NormalizePathKey(notePath)) {
        if (outError) *outError = L"Failed to restore the previous note after math UI testing.";
        return false;
    }
    return true;
}

static bool EnsureUiAutomationTargetSession(HWND owner, std::wstring* outError,
                                            bool openNote = true) {
    AppendUiAutomationTrace(L"ensure_target:begin");
    if (!owner) {
        if (outError) *outError = L"Main window is not ready.";
        return false;
    }
    if (!g_hLectureList || !g_hSessionList || !g_hPdfList || !g_hNoteList) {
        if (outError) *outError = L"Required list controls are not available.";
        return false;
    }

    EnsureListboxSelection(g_hLectureList);
    EnsureListboxSelection(g_hSessionList);
    EnsureListboxSelection(g_hPdfList);
    EnsureListboxSelection(g_hNoteList);

    std::wstring automationRoot;
    if (TryGetUiAutomationWorkspaceRoot(&automationRoot)) {
        const std::filesystem::path workspaceRoot(automationRoot);
        const std::filesystem::path lecturePath = workspaceRoot / L"lecture1";
        const std::filesystem::path sessionPath = lecturePath / L"session1";
        const std::filesystem::path pdf1Path = sessionPath / L"sample.pdf";
        const std::filesystem::path pdf2Path = sessionPath / L"sample2.pdf";
        const std::filesystem::path note1Path = sessionPath / L"note1.txt";
        const std::filesystem::path note2Path = sessionPath / L"note2.txt";
        std::error_code fixtureEc;
        const bool fixtureReady =
            std::filesystem::exists(lecturePath, fixtureEc) &&
            std::filesystem::exists(sessionPath, fixtureEc) &&
            std::filesystem::exists(pdf1Path, fixtureEc) &&
            std::filesystem::exists(pdf2Path, fixtureEc) &&
            std::filesystem::exists(note1Path, fixtureEc) &&
            std::filesystem::exists(note2Path, fixtureEc);
        if (fixtureReady) {
            AppendUiAutomationTrace(L"ensure_target:fixture_begin");
            LoadLectures();
            g_currentLecturePath = lecturePath.wstring();
            LoadSessions(g_currentLecturePath);

            SessionEntry target;
            bool foundSession = false;
            for (const auto& session : g_sessions) {
                if (NormalizePathKey(session.path) == NormalizePathKey(sessionPath.wstring())) {
                    target = session;
                    foundSession = true;
                    break;
                }
            }
            if (!foundSession) {
                target.displayName = sessionPath.filename().wstring();
                target.path = sessionPath.wstring();
            }

            std::wstring preferredPdf = pdf1Path.wstring();
            std::wstring preferredNote = note1Path.wstring();
            LoadFiles(target, preferredPdf, preferredNote);
            AppendUiAutomationTrace(L"ensure_target:fixture_files_loaded");
            EndIntegratedPdfPreviewMode(owner, true);
            if (!OpenPdfWithAnnotations(owner, preferredPdf)) {
                if (outError) *outError = L"Failed to open fixture PDF for UI automation.";
                return false;
            }
            AppendUiAutomationTrace(L"ensure_target:fixture_pdf_opened");
            if (!openNote) {
                SyncLeftPaneSelection();
                if (CurrentPdfIndex() >= 0) {
                    SendMessageW(g_hPdfList, LB_SETCURSEL, CurrentPdfIndex(), 0);
                }
                if (static_cast<int>(g_pdfFiles.size()) >= 2 && CurrentPdfIndex() >= 0 &&
                    !CurrentLogicalPdfPath().empty()) {
                    AppendUiAutomationTrace(L"ensure_target:fixture_pdf_only_success");
                    return true;
                }
                AppendUiAutomationTrace(L"ensure_target:fixture_pdf_only_incomplete");
                return false;
            }
            LoadNoteFile(owner, preferredNote);
            SyncBottomPaneAfterNoteLoad(owner);
            AppendUiAutomationTrace(L"ensure_target:fixture_note_opened");
            SyncLeftPaneSelection();
            if (CurrentPdfIndex() >= 0) {
                SendMessageW(g_hPdfList, LB_SETCURSEL, CurrentPdfIndex(), 0);
            }
            if (CurrentNoteIndex() >= 0) {
                SendMessageW(g_hNoteList, LB_SETCURSEL, CurrentNoteIndex(), 0);
            }
            if (static_cast<int>(g_pdfFiles.size()) >= 2 &&
                static_cast<int>(g_noteFiles.size()) >= 2 &&
                CurrentPdfIndex() >= 0 &&
                CurrentNoteIndex() >= 0 &&
                !CurrentLogicalPdfPath().empty() &&
                !g_currentNotePath.empty()) {
                AppendUiAutomationTrace(L"ensure_target:fixture_success");
                return true;
            }
            AppendUiAutomationTrace(L"ensure_target:fixture_incomplete");
        }
    }

    const int lectureCount = ListboxItemCount(g_hLectureList);
    for (int lectureIdx = 0; lectureIdx < lectureCount; ++lectureIdx) {
        if (lectureIdx >= static_cast<int>(g_lectures.size())) continue;
        AppendUiAutomationTrace(L"ensure_target:lecture_" + std::to_wstring(lectureIdx));
        g_currentLecturePath = g_lectures[static_cast<size_t>(lectureIdx)];
        SendMessageW(g_hLectureList, LB_SETCURSEL, lectureIdx, 0);
        LoadSessions(g_currentLecturePath);
        const int sessionCount = static_cast<int>(g_sessions.size());
        for (int sessionIdx = 0; sessionIdx < sessionCount; ++sessionIdx) {
            AppendUiAutomationTrace(L"ensure_target:session_" + std::to_wstring(sessionIdx));
            const auto& target = g_sessions[static_cast<size_t>(sessionIdx)];
            SendMessageW(g_hSessionList, LB_SETCURSEL, sessionIdx, 0);
            g_currentSessionPath = target.path;
            std::wstring preferredPdf;
            std::wstring preferredNote;
            LoadFiles(target, preferredPdf, preferredNote);
            const std::wstring autoOpenPdfPath = FirstOpenablePdfListPath();
            if (!autoOpenPdfPath.empty()) {
                AppendUiAutomationTrace(L"ensure_target:open_pdf_begin");
                EndIntegratedPdfPreviewMode(owner, true);
                OpenPdfWithAnnotations(owner, autoOpenPdfPath);
                AppendUiAutomationTrace(L"ensure_target:open_pdf_end");
            }
            if (openNote && !g_noteFiles.empty()) {
                AppendUiAutomationTrace(L"ensure_target:open_note_begin");
                LoadNoteFile(owner, g_noteFiles.front().path);
                SyncBottomPaneAfterNoteLoad(owner);
                AppendUiAutomationTrace(L"ensure_target:open_note_end");
            }
            SyncLeftPaneSelection();
            AppendUiAutomationTrace(L"ensure_target:sync_done");
            if (static_cast<int>(g_pdfFiles.size()) >= 2 &&
                (!openNote || static_cast<int>(g_noteFiles.size()) >= 2) &&
                CurrentPdfIndex() >= 0 && (!openNote || CurrentNoteIndex() >= 0) &&
                !CurrentLogicalPdfPath().empty() && (!openNote || !g_currentNotePath.empty())) {
                AppendUiAutomationTrace(L"ensure_target:success");
                return true;
            }
        }
    }

    AppendUiAutomationTrace(L"ensure_target:not_found");
    if (outError) {
        *outError = L"No session with at least two PDFs and two notes was found for UI automation.";
    }
    return false;
}

static bool VerifyUiRollbackState(const std::wstring& expectedLecturePath,
                                  const std::wstring& expectedSessionPath,
                                  const std::wstring& expectedPdfPath,
                                  const std::wstring& expectedNotePath,
                                  int expectedPdfIndex,
                                  int expectedNoteIndex,
                                  std::wstring* outError) {
    if (NormalizePathKey(g_currentLecturePath) != NormalizePathKey(expectedLecturePath)) {
        if (outError) *outError = L"Lecture path was not restored.";
        return false;
    }
    if (NormalizePathKey(g_currentSessionPath) != NormalizePathKey(expectedSessionPath)) {
        if (outError) *outError = L"Session path was not restored.";
        return false;
    }
    if (NormalizePathKey(CurrentLogicalPdfPath()) != NormalizePathKey(expectedPdfPath)) {
        if (outError) *outError = L"PDF path was not restored.";
        return false;
    }
    if (NormalizePathKey(g_currentNotePath) != NormalizePathKey(expectedNotePath)) {
        if (outError) *outError = L"Note path was not restored.";
        return false;
    }
    if (CurrentPdfIndex() != expectedPdfIndex) {
        if (outError) *outError = L"PDF list selection was not restored.";
        return false;
    }
    if (CurrentNoteIndex() != expectedNoteIndex) {
        if (outError) *outError = L"Note list selection was not restored.";
        return false;
    }
    return true;
}

static size_t CountUiAutomationStagesForTarget(file_output::StagedDiffKind kind,
                                               const std::wstring& targetPath) {
    if (targetPath.empty()) return 0;
    const std::wstring targetKey = NormalizePathKey(std::filesystem::path(targetPath));
    size_t count = 0;
    for (const auto& entry : file_output::ListStagedDiffEntries()) {
        if (entry.kind != kind) continue;
        if (NormalizePathKey(std::filesystem::path(entry.targetPath)) != targetKey) continue;
        ++count;
    }
    return count;
}

static bool ReadUiAutomationFileBytes(const std::filesystem::path& path, std::string* out) {
    if (!out) return false;
    out->clear();
    std::ifstream stream(path, std::ios::binary);
    if (!stream) return false;
    *out = std::string(std::istreambuf_iterator<char>(stream), std::istreambuf_iterator<char>());
    return static_cast<bool>(stream) || stream.eof();
}

static bool HasPngFileSignature(const std::string& bytes) {
    static constexpr char kSignature[] = {
        static_cast<char>(0x89), 'P', 'N', 'G', '\r', '\n', static_cast<char>(0x1a), '\n'};
    return bytes.size() >= sizeof(kSignature) &&
           std::equal(std::begin(kSignature), std::end(kSignature), bytes.begin());
}

static bool RunUiAutomationPdfKeyboardScrollScenario(HWND owner, std::wstring* outError) {
    using pdf_keyboard_scroll::Motion;
    // Fixed time inputs check speed independently of the machine's timer cadence.
    Motion straight, diagonal, partitioned;
    straight.SetKey('S', true);
    diagonal.SetKey('S', true);
    diagonal.SetKey('D', true);
    partitioned.SetKey('S', true);
    const auto one = straight.Advance(0.032);
    const auto two = diagonal.Advance(0.032);
    const auto part1 = partitioned.Advance(0.016);
    const auto part2 = partitioned.Advance(0.016);
    bool valid = one.y > 0.0 && one.y < 600.0 * 0.032 && one.x == 0.0 &&
        std::abs(std::hypot(two.x, two.y) - one.y) < 0.00001 &&
        std::abs(part1.y + part2.y - one.y) < 0.00001;
    straight.SetKey('S', false);
    const auto released = straight.Advance(0.016);
    valid = valid && !straight.HasKeys() && released.x == 0.0 && released.y == 0.0;
    diagonal.SetKey('A', true);
    diagonal.SetKey('W', true);
    const auto opposite = diagonal.Advance(0.016);
    valid = valid && opposite.x == 0.0 && opposite.y == 0.0;
    partitioned.Reset();
    partitioned.SetKey('D', true);
    const auto delayed = partitioned.Advance(10.0);
    valid = valid && delayed.x > 0.0 && delayed.x <= 600.0 * 0.05 && delayed.y == 0.0;
    if (!valid || !g_hPdfView || g_pdf.pages.empty() || g_pdf.editingText) {
        if (outError) *outError = L"PDF keyboard motion timing/direction contract failed.";
        return false;
    }

    const auto savedFlow = g_config.pdfFlowMode;
    const bool savedSingle = g_config.pdfSinglePageMode;
    const double savedScale = g_pdf.scale, savedX = g_pdf.scrollX, savedY = g_pdf.scrollY;
    const HWND savedFocus = GetFocus();
    std::array<BYTE, 256> savedKeys{};
    if (!GetKeyboardState(savedKeys.data())) return false;
    struct RestoreView {
        std::wstring flow;
        bool single;
        double scale, x, y;
        HWND focus;
        std::array<BYTE, 256> keys;
        ~RestoreView() {
            for (unsigned key : {'W', 'A', 'S', 'D'}) SendMessageW(g_hPdfView, WM_KEYUP, key, 0);
            g_pdf.editingText = false;
            SetKeyboardState(keys.data());
            g_config.pdfSinglePageMode = single;
            SetPdfFlowMode(g_hPdfView, flow);
            SetPdfScale(g_hPdfView, scale, POINT{});
            g_pdf.scrollX = x;
            g_pdf.scrollY = y;
            if (focus && IsWindow(focus)) SetFocus(focus);
        }
    } restore{savedFlow, savedSingle, savedScale, savedX, savedY, savedFocus, savedKeys};
    auto keys = savedKeys;
    keys[VK_CONTROL] = keys[VK_LCONTROL] = keys[VK_RCONTROL] = 0;
    keys[VK_MENU] = keys[VK_LMENU] = keys[VK_RMENU] = 0;
    if (!SetKeyboardState(keys.data())) return false;
    g_config.pdfSinglePageMode = false;
    SetPdfFlowMode(g_hPdfView, L"v_ttb");
    SetPdfScale(g_hPdfView, 4.0, POINT{});
    SetFocus(g_hPdfView);
    JumpToPdfPoint(g_hPdfView, 0, g_pdf.pages[0].widthPt * 0.5, g_pdf.pages[0].heightPt * 0.5);
    const double centerX = g_pdf.scrollX, centerY = g_pdf.scrollY;
    const auto tick = [&]() {
        Sleep(20);
        SendMessageW(g_hPdfView, WM_TIMER, kPdfKeyboardScrollTimerId, 0);
    };
    for (unsigned key : {'W', 'A', 'S', 'D'}) {
        g_pdf.scrollX = centerX;
        g_pdf.scrollY = centerY;
        SendMessageW(g_hPdfView, WM_KEYDOWN, key, 1);
        SendMessageW(g_hPdfView, WM_KEYDOWN, key, 0x40000001); // repeat must not add a fixed step
        valid = valid && g_pdf.scrollX == centerX && g_pdf.scrollY == centerY;
        tick();
        const double dx = g_pdf.scrollX - centerX, dy = g_pdf.scrollY - centerY;
        const bool correctDirection = key == 'W' ? dy < 0.0 && dx == 0.0 :
            key == 'S' ? dy > 0.0 && dx == 0.0 : key == 'A' ? dx < 0.0 && dy == 0.0 : dx > 0.0 && dy == 0.0;
        valid = valid && correctDirection && std::hypot(dx, dy) < kScrollStepPx;
        SendMessageW(g_hPdfView, WM_KEYUP, key, 0xC0000001);
        tick();
        valid = valid && g_pdf.scrollX == centerX + dx && g_pdf.scrollY == centerY + dy;
    }
    g_pdf.scrollX = centerX;
    g_pdf.scrollY = centerY;
    SendMessageW(g_hPdfView, WM_KEYDOWN, VK_DOWN, 1);
    valid = valid && std::abs(g_pdf.scrollY - centerY - kScrollStepPx) < 0.001;
    SendMessageW(g_hPdfView, WM_KEYDOWN, 'S', 1);
    SetFocus(owner);
    const double focusX = g_pdf.scrollX, focusY = g_pdf.scrollY;
    tick();
    SetFocus(g_hPdfView);
    SendMessageW(g_hPdfView, WM_KEYDOWN, 'S', 0x40000001);
    tick();
    valid = valid && g_pdf.scrollX == focusX && g_pdf.scrollY == focusY;
    SendMessageW(g_hPdfView, WM_KEYUP, 'S', 0);

    // Existing editing and modifier routes must never arm the motion timer.
    SendMessageW(g_hPdfView, WM_KEYDOWN, 'S', 1);
    g_pdf.editingText = true;
    SendMessageW(g_hPdfView, WM_KEYDOWN, 'D', 1);
    tick();
    SendMessageW(g_hPdfView, WM_KEYUP, 'D', 0);
    g_pdf.editingText = false;
    keys[VK_CONTROL] = 0x80;
    if (!SetKeyboardState(keys.data())) return false;
    SendMessageW(g_hPdfView, WM_KEYDOWN, 'D', 1);
    tick();
    valid = valid && g_pdf.scrollX == focusX && g_pdf.scrollY == focusY;
    keys[VK_CONTROL] = 0;
    keys[VK_MENU] = 0x80;
    if (!SetKeyboardState(keys.data())) return false;
    SendMessageW(g_hPdfView, WM_SYSKEYDOWN, 'D', 1);
    tick();
    valid = valid && g_pdf.scrollX == focusX && g_pdf.scrollY == focusY;
    keys[VK_MENU] = 0;
    if (!SetKeyboardState(keys.data())) return false;
    // At a single-page edge, one frame must not turn a page; sustained input may.
    g_config.pdfSinglePageMode = true;
    ApplyPdfDisplayMode(g_hPdfView);
    JumpToPage(g_hPdfView, 0);
    SendMessageW(g_hPdfView, WM_VSCROLL, SB_BOTTOM, 0);
    SendMessageW(g_hPdfView, WM_KEYDOWN, 'S', 1);
    tick();
    valid = valid && g_pdf.singlePageIndex == 0;
    for (int frame = 0; frame < 20 && g_pdf.singlePageIndex == 0; ++frame) tick();
    valid = valid && (g_pdf.pageCount == 1 || g_pdf.singlePageIndex == 1);
    SendMessageW(g_hPdfView, WM_KEYUP, 'S', 0);
    AppendUiAutomationTrace(L"pdf_keyboard_scroll:directions_repeat_release_focus_edit_ctrl valid=" + std::to_wstring(valid));
    if (!valid && outError) *outError = L"PDF WASD movement/release/focus/edit/modifier or arrow regression failed.";
    return valid;
}

static bool RunUiAutomationPdfiumRawOpenScenario(std::wstring* outError) {
    std::wstring automationRoot;
    if (!TryGetUiAutomationWorkspaceRoot(&automationRoot)) {
        if (outError) *outError = L"PDFium raw-open automation requires an automation workspace.";
        return false;
    }
    const std::filesystem::path pdfPath = std::filesystem::path(automationRoot) /
        L"lecture1" / L"session1" / L"sample.pdf";
    std::error_code ec;
    if (!std::filesystem::is_regular_file(pdfPath, ec) || ec) {
        if (outError) *outError = L"PDFium raw-open automation fixture PDF is missing.";
        return false;
    }
    const std::string utf8Path = WideToUTF8(pdfPath.wstring());
    std::lock_guard<std::recursive_mutex> pdfiumLock(g_pdfiumMutex);
    FPDF_DOCUMENT document = FPDF_LoadDocument(utf8Path.c_str(), nullptr);
    if (!document) {
        if (outError) *outError = L"PDFium raw-open automation could not load the fixture PDF.";
        return false;
    }
    const int pageCount = FPDF_GetPageCount(document);
    FPDF_CloseDocument(document);
    if (pageCount <= 0) {
        if (outError) *outError = L"PDFium raw-open automation fixture PDF had no pages.";
        return false;
    }
    return true;
}

static bool ReadPngDimensions(const std::string& bytes, int* outWidth, int* outHeight) {
    if (!outWidth || !outHeight || !HasPngFileSignature(bytes) || bytes.size() < 24 ||
        bytes.compare(12, 4, "IHDR") != 0) {
        return false;
    }
    const auto readBigEndianU32 = [&bytes](size_t offset) -> uint32_t {
        return (static_cast<uint32_t>(static_cast<unsigned char>(bytes[offset])) << 24) |
               (static_cast<uint32_t>(static_cast<unsigned char>(bytes[offset + 1])) << 16) |
               (static_cast<uint32_t>(static_cast<unsigned char>(bytes[offset + 2])) << 8) |
               static_cast<uint32_t>(static_cast<unsigned char>(bytes[offset + 3]));
    };
    const uint32_t width = readBigEndianU32(16);
    const uint32_t height = readBigEndianU32(20);
    if (width == 0 || height == 0 || width > static_cast<uint32_t>(INT_MAX) ||
        height > static_cast<uint32_t>(INT_MAX)) {
        return false;
    }
    *outWidth = static_cast<int>(width);
    *outHeight = static_cast<int>(height);
    return true;
}

static bool InspectPngRasterWithWic(const std::filesystem::path& path, int expectedWidth,
                                    int expectedHeight, bool* outHasVisibleContent) {
    if (!outHasVisibleContent || expectedWidth <= 0 || expectedHeight <= 0) return false;
    *outHasVisibleContent = false;
    IWICImagingFactory* factory = nullptr;
    IWICBitmapDecoder* decoder = nullptr;
    IWICBitmapFrameDecode* frame = nullptr;
    IWICFormatConverter* converter = nullptr;
    const auto cleanup = [&]() {
        if (converter) converter->Release();
        if (frame) frame->Release();
        if (decoder) decoder->Release();
        if (factory) factory->Release();
    };
    HRESULT hr = CoCreateInstance(CLSID_WICImagingFactory, nullptr, CLSCTX_INPROC_SERVER,
                                  IID_PPV_ARGS(&factory));
    if (FAILED(hr) || !factory) return false;
    hr = factory->CreateDecoderFromFilename(path.c_str(), nullptr, GENERIC_READ,
                                            WICDecodeMetadataCacheOnLoad, &decoder);
    if (FAILED(hr) || !decoder || FAILED(decoder->GetFrame(0, &frame)) || !frame) {
        cleanup();
        return false;
    }
    UINT width = 0;
    UINT height = 0;
    double dpiX = 0.0;
    double dpiY = 0.0;
    if (FAILED(frame->GetSize(&width, &height)) ||
        width != static_cast<UINT>(expectedWidth) || height != static_cast<UINT>(expectedHeight) ||
        FAILED(frame->GetResolution(&dpiX, &dpiY)) || dpiX <= 1.0 || dpiY <= 1.0 ||
        std::abs(dpiX - dpiY) > 0.5) {
        cleanup();
        return false;
    }
    hr = factory->CreateFormatConverter(&converter);
    if (FAILED(hr) || !converter ||
        FAILED(converter->Initialize(frame, GUID_WICPixelFormat32bppBGRA,
                                     WICBitmapDitherTypeNone, nullptr, 0.0,
                                     WICBitmapPaletteTypeCustom))) {
        cleanup();
        return false;
    }
    const size_t stride = static_cast<size_t>(width) * 4;
    const size_t byteCount = stride * static_cast<size_t>(height);
    if (stride / 4 != width || byteCount / stride != height || byteCount > 64u * 1024u * 1024u) {
        cleanup();
        return false;
    }
    std::vector<uint8_t> pixels(byteCount);
    if (FAILED(converter->CopyPixels(nullptr, static_cast<UINT>(stride),
                                     static_cast<UINT>(byteCount), pixels.data()))) {
        cleanup();
        return false;
    }
    size_t visiblePixelCount = 0;
    for (size_t offset = 0; offset < pixels.size(); offset += 4) {
        const uint8_t b = pixels[offset];
        const uint8_t g = pixels[offset + 1];
        const uint8_t r = pixels[offset + 2];
        if (r < 245 || g < 245 || b < 245) ++visiblePixelCount;
    }
    *outHasVisibleContent = visiblePixelCount >= 64;
    cleanup();
    return true;
}

static bool RunUiAutomationPdfAnnotationExportScenario(HWND owner,
                                                       const std::filesystem::path& outputDir,
                                                       std::wstring* outError) {
    // This runs only in a disposable automation workspace. Borrow the logical
    // annotation list without changing dirty/history/stage state, then restore it.
    struct Restore {
        std::vector<Annotation> saved;
        Restore() { saved.swap(g_annots); }
        ~Restore() { saved.swap(g_annots); }
    } restore;
    const auto fail = [&](const wchar_t* why) { if (outError) *outError = why; return false; };
    const Annotation::Type types[] = {Annotation::Type::MarkerText, Annotation::Type::Freehand,
        Annotation::Type::TextBox, Annotation::Type::Shape, Annotation::Type::Arrow,
        Annotation::Type::Wave, Annotation::Type::MathBox, Annotation::Type::LinkMarker};
    for (size_t i = 0; i < std::size(types); ++i) {
        Annotation a;
        a.type = types[i]; a.id = L"export-fixture-" + std::to_wstring(i); a.pageIndex = 0;
        a.x1 = 30; a.y1 = 160; a.x2 = 170; a.y2 = 115;
        a.width = 3; a.alpha = 0.5; a.color = RGB(20,100,230);
        a.text = a.type == Annotation::Type::MathBox ? L"x^2+1" : L"PDF export text";
        a.fontName = L"Arial"; a.fontPt = 14;
        a.linkId = L"fixture-note-link";
        a.path = {{30,140},{80,150},{120,130}};
        a.quads = {30,160,170,160,170,140,30,140};
        g_annots.push_back(std::move(a));
    }
    for (const double scale : {1.0, 2.0}) {
        const auto path = outputDir / (scale == 1 ? L"annotations.pdf" : L"annotations_scaled.pdf");
        if (!file_output::ExportPdfPages(owner, {{0,true}}, path.wstring(), true, scale, true)) {
            const auto fixtures=g_annots;
            for(size_t i=0;i<fixtures.size();++i) {
                g_annots={fixtures[i]};
                const auto trial=outputDir/(L"annotation_trial_"+std::to_wstring(i)+L".pdf");
                if(!file_output::ExportPdfPages(owner,{{0,true}},trial.wstring(),true,scale,true)) {
                    if(outError) *outError=L"Standard annotation export failed for fixture "+std::to_wstring(i);
                    return false;
                }
            }
            return fail(L"Standard annotation export failed through the application API.");
        }
        std::string bytes;
        if (!ReadUiAutomationFileBytes(path, &bytes)) return fail(L"Cannot read annotation output.");
        std::lock_guard<std::recursive_mutex> lock(g_pdfiumMutex);
        auto doc = FPDF_LoadMemDocument64(bytes.data(),bytes.size(),nullptr);
        if (!doc) return fail(L"Cannot reopen annotation output.");
        auto page = FPDF_LoadPage(doc,0);
        bool ok = page && FPDF_GetPageCount(doc)==1;
        size_t found = 0;
        for (int i=0; page && i<FPDFPage_GetAnnotCount(page); ++i) {
            auto annot=FPDFPage_GetAnnot(page,i);
            wchar_t name[64]{};
            if (annot && FPDFAnnot_GetStringValue(annot,"NM",reinterpret_cast<FPDF_WCHAR*>(name),sizeof(name))>2 &&
                std::wstring(name).find(L"export-fixture-")==0) {
                ++found;
                const int subtype=FPDFAnnot_GetSubtype(annot);
                const std::wstring id(name);
                if (id==L"export-fixture-0") {
                    FS_QUADPOINTSF q{};
                    ok=ok && subtype==FPDF_ANNOT_HIGHLIGHT && FPDFAnnot_GetAttachmentPoints(annot,0,&q) &&
                        std::abs(q.x1-30*scale)<0.01 && std::abs(q.y1-160*scale)<0.01 &&
                        std::abs(q.x3-30*scale)<0.01;
                } else if(id==L"export-fixture-1" || id==L"export-fixture-4" || id==L"export-fixture-5") {
                    ok=ok && subtype==FPDF_ANNOT_INK && FPDFAnnot_GetInkListCount(annot)>0;
                    if(id==L"export-fixture-1") {
                        FS_POINTF points[3]{};
                        ok=ok && FPDFAnnot_GetInkListPath(annot,0,points,3)==3 &&
                            std::abs(points[0].x-30*scale)<0.01 && std::abs(points[0].y-140*scale)<0.01;
                    }
                } else if(id==L"export-fixture-2") {
                    ok=ok && (subtype==FPDF_ANNOT_FREETEXT || subtype==FPDF_ANNOT_STAMP);
                } else if(id==L"export-fixture-3") ok=ok && subtype==FPDF_ANNOT_SQUARE;
                else ok=ok && subtype==FPDF_ANNOT_STAMP;
            }
            if(annot) FPDFPage_CloseAnnot(annot);
        }
        if(page) FPDF_ClosePage(page);
        FPDF_CloseDocument(doc);
        if(!ok || found!=std::size(types)) return fail(L"Reopened output lost annotation type, geometry or entries.");
    }
    // Text recoloring is rejected before writing, including when the chosen
    // output already exists. Verify that the previous output remains byte-exact.
    const auto path=outputDir/L"annotations.pdf";
    std::string before,after;
    if(!ReadUiAutomationFileBytes(path,&before)) return false;
    g_annots.front().type=Annotation::Type::TextColor;
    if(file_output::ExportPdfPages(owner,{{0,true}},path.wstring(),true,1.0,true) ||
       !ReadUiAutomationFileBytes(path,&after) || before!=after)
        return fail(L"Text-color rejection changed an existing output.");
    return true;
}

static bool RunUiAutomationNativePdfExportScenario(HWND owner,
                                                   const std::filesystem::path& outputDir,
                                                   bool skipPngExport,
                                                   std::wstring* outError) {
    // Disposable, blank input with one native annotation. Borrow only the
    // logical PDF inputs used by export; do not open/switch/save a workspace.
    std::lock_guard<std::recursive_mutex> lock(g_pdfiumMutex);
    auto doc=pdf_annotation_export::CreateDocument();
    if(!doc) return false;
    struct BorrowPdf {
        FPDF_DOCUMENT savedDoc=g_pdf.doc;
        FPDF_DOCUMENT borrowed;
        std::wstring savedPath;
        std::vector<PageCache> savedPages;
        std::vector<Annotation> savedAnnots;
        BorrowPdf(FPDF_DOCUMENT value,std::wstring path):borrowed(value) {
            savedPath.swap(g_pdf.path); savedPages.swap(g_pdf.pages); savedAnnots.swap(g_annots);
            g_pdf.doc=value; g_pdf.path.swap(path);
        }
        ~BorrowPdf() {
            g_pdf.doc=savedDoc; savedPath.swap(g_pdf.path);
            savedPages.swap(g_pdf.pages); savedAnnots.swap(g_annots);
            FPDF_CloseDocument(borrowed);
        }
    } borrow(doc,(outputDir/L"native-input.pdf").wstring());
    const auto fail=[&](const wchar_t* reason) { if(outError) *outError=reason; return false; };
    auto page=FPDFPage_New(doc,0,200,200),scratch=FPDFPage_New(doc,1,200,200);
    auto rectangle=scratch ? FPDFPageObj_CreateNewRect(30,100,90,40) : nullptr;
    bool prepared=page && scratch && rectangle && FPDFPageObj_SetFillColor(rectangle,0,100,240,255) &&
                  FPDFPath_SetDrawMode(rectangle,FPDF_FILLMODE_ALTERNATE,FALSE);
    if(rectangle && prepared) FPDFPage_InsertObject(scratch,rectangle);
    else if(rectangle) FPDFPageObj_Destroy(rectangle);
    Annotation a; a.type=Annotation::Type::Shape; a.id=L"native-png"; a.pageIndex=0; a.color=RGB(0,100,240);
    a.alpha=1; a.x1=30; a.y1=100; a.x2=120; a.y2=140;
    prepared=prepared && pdf_annotation_export::Add(doc,page,scratch,a,true) && pdf_annotation_export::Finalize(page);
    if(scratch) FPDF_ClosePage(scratch);
    if(page) FPDF_ClosePage(page);
    if(FPDF_GetPageCount(doc)>1) FPDFPage_Delete(doc,1);
    if(!prepared) return fail(L"Cannot prepare native PDF annotation fixture.");

    const auto pdf=outputDir/L"native-preserved.pdf";
    if(!file_output::ExportPdfPages(owner,{{0,true}},pdf.wstring(),true,1,true))
        return fail(L"Native annotated input must remain exportable at 1x.");
    std::string before,after;
    if(!ReadUiAutomationFileBytes(pdf,&before)) return false;
    for(const double scale:{2.0,0.5}) {
        // Exercise the real quiet error dialog, and close only that owned
        // dialog using the existing presence-test timer. Do not suppress UI.
        if(!BeginOwnedDialogPresenceAutomation(owner,L"SilentDialogClass",outError)) return false;
        const bool exported=file_output::ExportPdfPages(owner,{{0,true}},pdf.wstring(),true,scale,true);
        // The existing UI deduplicates identical messages within its short
        // repeat window. Require the first dialog; safely close any second one.
        if(!EndOwnedDialogPresenceAutomation(owner,L"rejecting native annotation scaling",outError,
                                             scale==2.0)) return false;
        if(exported ||
           !ReadUiAutomationFileBytes(pdf,&after) || before!=after)
            return fail(L"Native annotation scale rejection changed an existing output.");
    }
    if(skipPngExport) return true; // explicitly omitted, not evidence of PNG acceptance
    // No separate annotations yet: this raster must contain the native blue
    // rectangle, which disappears if FPDF_ANNOT is omitted from PNG rendering.
    const auto png=outputDir/L"native-only.png";
    bool visible=false;
    if(!file_output::ExportPdfPagePng(owner,0,png.wstring(),file_output::PdfPngStyle::PdfLike,false,400,400) ||
       !InspectPngRasterWithWic(png,400,400,&visible) || !visible)
        return fail(L"PNG export omitted native PDF annotations.");
    std::string nativePixels,combinedPixels;
    if(!ReadUiAutomationFileBytes(png,&nativePixels)) return false;
    a.id=L"app-png"; a.x1=140; a.x2=180; a.color=RGB(0,170,123);
    g_annots.push_back(a);
    const auto combined=outputDir/L"native-and-app.png";
    if(!file_output::ExportPdfPagePng(owner,0,combined.wstring(),file_output::PdfPngStyle::PdfLike,true,400,400) ||
       !ReadUiAutomationFileBytes(combined,&combinedPixels) || nativePixels==combinedPixels)
        return fail(L"PNG export omitted the separate app annotation layer.");
    return true;
}

static bool RunUiAutomationOutputExportScenario(HWND owner, std::wstring* outError) {
    if (!owner || g_workspaceRoot.empty() || CurrentLogicalPdfPath().empty() ||
        g_currentNotePath.empty() || g_pdf.pages.empty()) {
        if (outError) *outError = L"Output export automation requires an open PDF and note in a workspace.";
        return false;
    }

    const std::filesystem::path sourcePdf(CurrentLogicalPdfPath());
    const std::filesystem::path sourceNote(g_currentNotePath);
    std::string originalPdf;
    std::string originalNote;
    if (!ReadUiAutomationFileBytes(sourcePdf, &originalPdf) ||
        !ReadUiAutomationFileBytes(sourceNote, &originalNote)) {
        if (outError) *outError = L"Failed to capture source files before output export automation.";
        return false;
    }

    const std::filesystem::path outputDir = std::filesystem::path(g_workspaceRoot) /
        L"__pdf_note_workspace__" / L"__tmp__" / L"ui_automation_output";
    std::error_code ec;
    std::filesystem::create_directories(outputDir, ec);
    if (ec) {
        if (outError) *outError = L"Failed to create the automation output directory.";
        return false;
    }
    const std::filesystem::path pdfOut = outputDir / L"export.pdf";
    const std::filesystem::path pngOut = outputDir / L"page.png";
    const std::filesystem::path textOut = outputDir / L"note.txt";
    const std::filesystem::path markdownOut = outputDir / L"note.md";
    const std::filesystem::path htmlOut = outputDir / L"note.html";
    std::wstring skipPngExportValue;
    const bool skipPngExport = ReadMainEnvVar(
        L"PDF_NOTE_SMALL_UI_AUTOMATION_SKIP_PNG_EXPORT", &skipPngExportValue) &&
        (skipPngExportValue == L"1" || skipPngExportValue == L"true");

    if (!RunUiAutomationPdfAnnotationExportScenario(owner, outputDir, outError)) return false;
    if (!RunUiAutomationNativePdfExportScenario(owner, outputDir, skipPngExport, outError)) return false;

    const std::vector<file_output::PdfPageSpec> firstPage{{0, false}};
    if (!file_output::ExportPdfPages(owner, firstPage, pdfOut.wstring(),
                                     g_config.exportStandardTextAnnots, 1.0,
                                     /*matchPdfPaneTextLayout=*/true)) {
        if (outError) *outError = L"PDF export failed during output export automation.";
        return false;
    }
    constexpr int kExportPngWidth = 1200;
    constexpr int kExportPngHeight = 900;
    if (!skipPngExport) {
        if (!file_output::ExportPdfPagePng(owner, 0, pngOut.wstring(),
                                            file_output::PdfPngStyle::PdfLike,
                                            /*includeAnnotations=*/false,
                                            kExportPngWidth, kExportPngHeight)) {
            if (outError) *outError = L"PNG export failed during output export automation.";
            return false;
        }
    }
    file_output::TextExportOptions textOptions{};
    file_output::NoteMarkupExportOptions markupOptions{};
    markupOptions.format = file_output::NoteMarkupExportOptions::Format::Markdown;
    if (!file_output::ExportNotePlainText(sourceNote.wstring(), textOut.wstring(), textOptions) ||
        !file_output::ExportNoteMarkup(sourceNote.wstring(), markdownOut.wstring(), markupOptions) ||
        !file_output::ExportNoteHtml(sourceNote.wstring(), htmlOut.wstring())) {
        if (outError) *outError = L"Note export failed during output export automation.";
        return false;
    }

    std::string exportedPdf;
    std::string exportedPng;
    std::string exportedText;
    std::string exportedMarkdown;
    std::string exportedHtml;
    int exportedPngWidth = 0;
    int exportedPngHeight = 0;
    bool exportedPngHasVisibleContent = false;
    if (!ReadUiAutomationFileBytes(pdfOut, &exportedPdf) || exportedPdf.size() < 5 ||
        exportedPdf.compare(0, 5, "%PDF-") != 0 ||
        (!skipPngExport &&
         (!ReadUiAutomationFileBytes(pngOut, &exportedPng) || !HasPngFileSignature(exportedPng) ||
          !ReadPngDimensions(exportedPng, &exportedPngWidth, &exportedPngHeight) ||
          exportedPngWidth != kExportPngWidth || exportedPngHeight != kExportPngHeight ||
          !InspectPngRasterWithWic(pngOut, kExportPngWidth, kExportPngHeight,
                                   &exportedPngHasVisibleContent) ||
          !exportedPngHasVisibleContent)) ||
        !ReadUiAutomationFileBytes(textOut, &exportedText) || exportedText.empty() ||
        !ReadUiAutomationFileBytes(markdownOut, &exportedMarkdown) || exportedMarkdown.empty() ||
        !ReadUiAutomationFileBytes(htmlOut, &exportedHtml) || exportedHtml.empty()) {
        if (outError) *outError = L"An exported artifact was missing, empty, or had an invalid file signature.";
        return false;
    }

    // Export APIs must reject their source as an output path without mutating it.
    if (file_output::ExportPdfPages(owner, firstPage, sourcePdf.wstring(),
                                    g_config.exportStandardTextAnnots, 1.0,
                                    /*matchPdfPaneTextLayout=*/true) ||
        file_output::ExportNotePlainText(sourceNote.wstring(), sourceNote.wstring(), textOptions)) {
        if (outError) *outError = L"An export API accepted its source file as an output path.";
        return false;
    }
    std::string finalPdf;
    std::string finalNote;
    if (!ReadUiAutomationFileBytes(sourcePdf, &finalPdf) || finalPdf != originalPdf ||
        !ReadUiAutomationFileBytes(sourceNote, &finalNote) || finalNote != originalNote) {
        if (outError) *outError = L"An output export changed a source file.";
        return false;
    }
    return true;
}

static bool RunUiAutomationNoteSaveScenario(HWND owner, std::wstring* outError) {
    if (!owner || g_currentNotePath.empty() || !g_hNoteEdit) {
        if (outError) *outError = L"Note save automation requires an open note editor.";
        return false;
    }
    if (!file_output::DiscardAllStagedDiffs(owner)) {
        if (outError) *outError = L"Failed to clear staged diffs before note save automation.";
        return false;
    }

    const std::wstring notePath = g_currentNotePath;
    const std::wstring undoToken = L"ui-automation-note-undo-token";
    const std::wstring directSaveToken = L"ui-automation-note-direct-save-token";

    InsertSnippetIntoNoteAt(GetNoteAutomationIndexingText().size(), undoToken);
    if (FindNoteTextSnippetStart(undoToken) < 0) {
        if (outError) *outError = L"Failed to insert the note undo token.";
        return false;
    }
    if (!SendUiAutomationNoteUndoChangedText()) {
        if (outError) *outError = L"Note undo did not change the note text.";
        return false;
    }
    if (FindNoteTextSnippetStart(undoToken) >= 0) {
        if (outError) *outError = L"Note undo token remained after undo.";
        return false;
    }
    if (!SaveNoteIfDirty(owner)) {
        if (outError) *outError = L"SaveNoteIfDirty failed after undoing back to the original note.";
        return false;
    }
    if (CountUiAutomationStagesForTarget(file_output::StagedDiffKind::Note, notePath) != 0) {
        if (outError) *outError = L"Undoing a note edit back to the original content still created a staged diff.";
        return false;
    }
    if (g_noteDirty || g_noteNeedsIntegrate) {
        if (outError) *outError = L"Note flags remained dirty after undo reconciliation save.";
        return false;
    }
    if (SendMessageW(g_hNoteEdit, EM_GETMODIFY, 0, 0) != 0) {
        if (outError) *outError = L"Note editor modified flag remained set after undo reconciliation save.";
        return false;
    }

    const std::wstring redoStageToken = L"ui-automation-note-redo-stage-token";
    InsertSnippetIntoNoteAt(GetNoteAutomationIndexingText().size(), redoStageToken);
    if (FindNoteTextSnippetStart(redoStageToken) < 0) {
        if (outError) *outError = L"Failed to insert the note redo-stage token.";
        return false;
    }
    if (!SendUiAutomationNoteUndoChangedText()) {
        if (outError) *outError = L"Note undo did not remove the redo-stage token.";
        return false;
    }
    if (FindNoteTextSnippetStart(redoStageToken) >= 0) {
        if (outError) *outError = L"Redo-stage token remained after undo.";
        return false;
    }
    if (!SendUiAutomationNoteRedoChangedText()) {
        if (outError) *outError = L"Note redo did not restore the redo-stage token.";
        return false;
    }
    if (FindNoteTextSnippetStart(redoStageToken) < 0) {
        if (outError) *outError = L"Redo-stage token was missing after redo.";
        return false;
    }
    if (!g_noteDirty) {
        if (outError) *outError = L"Note redo did not mark the note dirty.";
        return false;
    }
    if (!SaveNoteIfDirty(owner)) {
        if (outError) *outError = L"SaveNoteIfDirty failed after note redo.";
        return false;
    }
    if (CountUiAutomationStagesForTarget(file_output::StagedDiffKind::Note, notePath) == 0) {
        if (outError) *outError = L"Note redo did not create a staged diff.";
        return false;
    }
    if (!SelectNoteTextSnippet(redoStageToken)) {
        if (outError) *outError = L"Could not reselect the redo-stage token for cleanup.";
        return false;
    }
    SendMessageW(g_hNoteEdit, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(L""));
    if (!SaveNoteIfDirty(owner)) {
        if (outError) *outError = L"Cleanup redo-stage save failed during UI automation.";
        return false;
    }
    if (FindNoteTextSnippetStart(redoStageToken) >= 0) {
        if (outError) *outError = L"Cleanup redo-stage token remained in the note.";
        return false;
    }
    if (CountUiAutomationStagesForTarget(file_output::StagedDiffKind::Note, notePath) != 0) {
        if (outError) *outError = L"Cleanup redo-stage save left staged note diffs behind.";
        return false;
    }

    InsertSnippetIntoNoteAt(GetNoteAutomationIndexingText().size(), directSaveToken);
    if (FindNoteTextSnippetStart(directSaveToken) < 0) {
        if (outError) *outError = L"Failed to insert the direct-save token.";
        return false;
    }
    if (!file_output::SaveNoteFile(owner)) {
        if (outError) *outError = L"Direct note save failed during UI automation.";
        return false;
    }
    if (SendMessageW(g_hNoteEdit, EM_GETMODIFY, 0, 0) != 0) {
        if (outError) *outError = L"Direct note save did not clear the editor modified flag.";
        return false;
    }
    if (g_noteDirty || g_noteNeedsIntegrate) {
        if (outError) *outError = L"Direct note save left note dirty/integrate flags set.";
        return false;
    }
    if (CountUiAutomationStagesForTarget(file_output::StagedDiffKind::Note, notePath) != 0) {
        if (outError) *outError = L"Direct note save left staged note diffs behind.";
        return false;
    }
    // A successful original-file save establishes a new history boundary.
    // Neither Ctrl+Z nor Ctrl+Y may alter the just-saved note.
    if (CanExecuteNoteUndoRedoFromFocus(true) ||
        CanExecuteNoteUndoRedoFromFocus(false) ||
        SendUiAutomationNoteUndoChangedText() ||
        SendUiAutomationNoteRedoChangedText()) {
        if (outError) *outError = L"Direct note save did not clear note undo/redo history.";
        return false;
    }
    if (FindNoteTextSnippetStart(directSaveToken) < 0) {
        if (outError) *outError = L"Direct note save changed the saved token while checking history.";
        return false;
    }
    if (!SelectNoteTextSnippet(directSaveToken)) {
        if (outError) *outError = L"Could not select the direct-save token for cleanup.";
        return false;
    }
    SendMessageW(g_hNoteEdit, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(L""));
    if (!file_output::SaveNoteFile(owner)) {
        if (outError) *outError = L"Saving direct note cleanup failed.";
        return false;
    }
    if (FindNoteTextSnippetStart(directSaveToken) >= 0) {
        if (outError) *outError = L"Direct note cleanup token remained after saving.";
        return false;
    }
    return true;
}

static bool RunUiAutomationNoteIntegratedSaveHistoryScenario(HWND owner, std::wstring* outError) {
    if (!owner || g_currentNotePath.empty() || !g_hNoteEdit) {
        if (outError) *outError = L"Integrated-save history automation requires an open note editor.";
        return false;
    }

    const std::wstring notePath = g_currentNotePath;
    const std::wstring token = L"ui-automation-integrated-save-history-token";
    SendMessageW(g_hNoteEdit, EM_SETSEL,
                 static_cast<WPARAM>(GetNoteAutomationIndexingText().size()),
                 static_cast<LPARAM>(GetNoteAutomationIndexingText().size()));
    if (!SendUiAutomationNoteTextInput(token) || FindNoteTextSnippetStart(token) < 0) {
        if (outError) *outError = L"Could not create the integrated-save history token.";
        return false;
    }
    if (!file_output::RunSaveAndIntegrateTransaction(owner) ||
        CountUiAutomationStagesForTarget(file_output::StagedDiffKind::Note, notePath) != 0) {
        if (outError) *outError = L"Integrated note save did not complete cleanly.";
        return false;
    }
    if (CanExecuteNoteUndoRedoFromFocus(true) ||
        CanExecuteNoteUndoRedoFromFocus(false) ||
        SendUiAutomationNoteUndoChangedText() ||
        SendUiAutomationNoteRedoChangedText() ||
        FindNoteTextSnippetStart(token) < 0) {
        if (outError) *outError = L"Integrated note save did not establish an undo/redo history boundary.";
        return false;
    }
    if (!SelectNoteTextSnippet(token)) {
        if (outError) *outError = L"Could not select the integrated-save token for cleanup.";
        return false;
    }
    SendMessageW(g_hNoteEdit, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(L""));
    if (!file_output::SaveNoteFile(owner) || FindNoteTextSnippetStart(token) >= 0) {
        if (outError) *outError = L"Integrated-save history cleanup failed.";
        return false;
    }
    return true;
}

static bool RunUiAutomationNoteInputUndoRedoScenario(HWND owner, std::wstring* outError) {
    if (!owner || g_currentNotePath.empty() || !g_hNoteEdit) {
        if (outError) *outError = L"Note input undo/redo automation requires an open note editor.";
        return false;
    }

    const std::wstring originalText = GetNoteAutomationIndexingText();
    const std::wstring typedToken = L"ui-automation-typed-input-token";
    // One character makes this a selection replacement (rather than a second
    // contiguous typing run), while keeping the expected history boundary exact.
    const std::wstring replacementToken = L"@";
    SendMessageW(g_hNoteEdit, EM_SETSEL,
                 static_cast<WPARAM>(originalText.size()),
                 static_cast<LPARAM>(originalText.size()));
    if (!SendUiAutomationNoteTextInput(typedToken) ||
        FindNoteTextSnippetStart(typedToken) < 0) {
        if (outError) *outError = L"WM_CHAR note input did not insert the typed token.";
        return false;
    }

    if (!SendUiAutomationNoteMenuUndoRedoChangedText(owner, true) ||
        FindNoteTextSnippetStart(typedToken) >= 0) {
        if (outError) *outError = L"Menu undo did not reverse WM_CHAR note input.";
        return false;
    }
    if (!SendUiAutomationNoteRedoChangedText() ||
        FindNoteTextSnippetStart(typedToken) < 0) {
        if (outError) *outError = L"EM_REDO did not restore WM_CHAR note input.";
        return false;
    }

    if (!SelectNoteTextSnippet(typedToken) ||
        !SendUiAutomationNoteTextInput(replacementToken) ||
        FindNoteTextSnippetStart(typedToken) >= 0 ||
        FindNoteTextSnippetStart(replacementToken) < 0) {
        if (outError) *outError = L"Typing over a selection did not replace the selected note text.";
        return false;
    }
    if (!SendUiAutomationNoteUndoChangedText() ||
        FindNoteTextSnippetStart(typedToken) < 0 ||
        FindNoteTextSnippetStart(replacementToken) >= 0) {
        if (outError) *outError = L"WM_UNDO did not restore the selected note text.";
        return false;
    }
    if (!SendUiAutomationNoteMenuUndoRedoChangedText(owner, false) ||
        FindNoteTextSnippetStart(replacementToken) < 0) {
        if (outError) *outError = L"Menu redo did not restore the replacement note text.";
        return false;
    }

    if (!SelectNoteTextSnippet(replacementToken)) {
        if (outError) *outError = L"Could not select the replacement text for WM_CLEAR.";
        return false;
    }
    SendMessageW(g_hNoteEdit, WM_CLEAR, 0, 0);
    if (FindNoteTextSnippetStart(replacementToken) >= 0) {
        if (outError) *outError = L"WM_CLEAR did not remove the selected note text.";
        return false;
    }
    if (!SendUiAutomationNoteUndoChangedText() ||
        FindNoteTextSnippetStart(replacementToken) < 0) {
        if (outError) *outError = L"WM_UNDO did not restore text removed by WM_CLEAR.";
        return false;
    }
    if (!SendUiAutomationNoteRedoChangedText() ||
        FindNoteTextSnippetStart(replacementToken) >= 0) {
        if (outError) *outError = L"EM_REDO did not reapply WM_CLEAR.";
        return false;
    }

    // Clipboard commands are separate from plain replacement: the Cut
    // deletion is permitted only after the clipboard write succeeds, and both
    // the source edit and its inverse must travel through the same history.
    const std::wstring clipboardToken = L"ui-automation-clipboard-token";
    const size_t appendAt = GetNoteAutomationIndexingText().size();
    if (!SetUiAutomationClipboardText(owner, clipboardToken)) {
        if (outError) *outError = L"Could not prepare the clipboard Paste fixture.";
        return false;
    }
    SendMessageW(g_hNoteEdit, EM_SETSEL, static_cast<WPARAM>(appendAt), static_cast<LPARAM>(appendAt));
    SendMessageW(g_hNoteEdit, WM_PASTE, 0, 0);
    if (FindNoteTextSnippetStart(clipboardToken) < 0) {
        if (outError) *outError = L"WM_PASTE did not insert the clipboard fixture.";
        return false;
    }
    if (!SendUiAutomationNoteUndoChangedText() ||
        FindNoteTextSnippetStart(clipboardToken) >= 0 ||
        !SendUiAutomationNoteRedoChangedText() ||
        FindNoteTextSnippetStart(clipboardToken) < 0) {
        if (outError) *outError = L"Undo/redo did not round-trip WM_PASTE.";
        return false;
    }
    if (!SelectNoteTextSnippet(clipboardToken)) {
        if (outError) *outError = L"Could not select the clipboard fixture for WM_CUT.";
        return false;
    }
    SendMessageW(g_hNoteEdit, WM_CUT, 0, 0);
    const auto cutClipboard = GetUiAutomationClipboardText(owner);
    if (FindNoteTextSnippetStart(clipboardToken) >= 0 ||
        !cutClipboard.has_value() || *cutClipboard != clipboardToken) {
        if (outError) *outError = L"WM_CUT did not atomically copy then remove the selected text.";
        return false;
    }
    if (!SendUiAutomationNoteUndoChangedText() ||
        !SelectNoteTextSnippet(clipboardToken) ||
        !SetUiAutomationClipboardText(owner, L"")) {
        if (outError) *outError = L"Could not restore the Cut selection and prepare an empty Paste payload.";
        return false;
    }
    const std::wstring beforeEmptyPaste = GetNoteAutomationIndexingText();
    SendMessageW(g_hNoteEdit, WM_PASTE, 0, 0);
    if (GetNoteAutomationIndexingText() != beforeEmptyPaste) {
        if (outError) *outError = L"An empty clipboard payload destructively changed the selection.";
        return false;
    }
    if (!SendUiAutomationNoteRedoChangedText() ||
        FindNoteTextSnippetStart(clipboardToken) >= 0) {
        if (outError) *outError = L"Redo did not reapply WM_CUT after the empty Paste no-op.";
        return false;
    }

    // Selection-replacing Paste must be a single Replace command. Undo/Redo
    // retain a later, unrelated selection instead of jumping back to the
    // selection that happened to create this command.
    const std::wstring selectedPasteSource = L"ui-automation-selected-paste-source";
    const std::wstring selectedPasteReplacement = L"ui-automation-selected-paste-replacement";
    const size_t selectedPasteInsertAt = GetNoteAutomationIndexingText().size();
    if (!SetUiAutomationClipboardText(owner, selectedPasteSource)) {
        if (outError) *outError = L"Could not prepare the selection-Paste source fixture.";
        return false;
    }
    SendMessageW(g_hNoteEdit, EM_SETSEL,
                 static_cast<WPARAM>(selectedPasteInsertAt),
                 static_cast<LPARAM>(selectedPasteInsertAt));
    SendMessageW(g_hNoteEdit, WM_PASTE, 0, 0);
    if (!SelectNoteTextSnippet(selectedPasteSource)) {
        if (outError) *outError = L"Could not select the Paste replacement source.";
        return false;
    }
    if (!SetUiAutomationClipboardText(owner, selectedPasteReplacement)) {
        if (outError) *outError = L"Could not prepare the selection-Paste replacement fixture.";
        return false;
    }
    SendMessageW(g_hNoteEdit, WM_PASTE, 0, 0);
    const bool sourceStillPresent = FindNoteTextSnippetStart(selectedPasteSource) >= 0;
    const bool replacementPresent = FindNoteTextSnippetStart(selectedPasteReplacement) >= 0;
    if (sourceStillPresent || !replacementPresent) {
        if (outError) {
            const std::optional<std::wstring> clipboardAfterPaste =
                GetUiAutomationClipboardText(owner);
            const bool replacementStillOnClipboard = clipboardAfterPaste.has_value() &&
                *clipboardAfterPaste == selectedPasteReplacement;
            *outError = L"WM_PASTE did not replace the selected source text: sourcePresent=" +
                std::to_wstring(sourceStillPresent ? 1 : 0) +
                L" replacementPresent=" + std::to_wstring(replacementPresent ? 1 : 0) +
                L" replacementOnClipboard=" +
                std::to_wstring(replacementStillOnClipboard ? 1 : 0) +
                L" revision=" + std::to_wstring(CurrentEditRevision()) +
                L" ime=" + std::to_wstring(IsNoteImeComposing() ? 1 : 0) +
                L" normalMode=" + std::to_wstring(g_noteNormalMode ? 1 : 0);
        }
        return false;
    }
    const DWORD stableSelectionStart = static_cast<DWORD>(
        selectedPasteInsertAt == 0 ? 0 : selectedPasteInsertAt - 1);
    const DWORD stableSelectionEnd = static_cast<DWORD>(selectedPasteInsertAt);
    SendMessageW(g_hNoteEdit, EM_SETSEL, static_cast<WPARAM>(stableSelectionStart),
                 static_cast<LPARAM>(stableSelectionEnd));
    if (!SendUiAutomationNoteUndoChangedText() ||
        FindNoteTextSnippetStart(selectedPasteSource) < 0 ||
        FindNoteTextSnippetStart(selectedPasteReplacement) >= 0) {
        if (outError) *outError = L"Undo did not restore the selection-replacing Paste text.";
        return false;
    }
    DWORD selectionAfterUndoStart = 0;
    DWORD selectionAfterUndoEnd = 0;
    SendMessageW(g_hNoteEdit, EM_GETSEL,
                 reinterpret_cast<WPARAM>(&selectionAfterUndoStart),
                 reinterpret_cast<LPARAM>(&selectionAfterUndoEnd));
    if (selectionAfterUndoStart != stableSelectionStart ||
        selectionAfterUndoEnd != stableSelectionEnd) {
        if (outError) *outError = L"Undo jumped an unrelated Note selection to historic edit state.";
        return false;
    }
    if (!SendUiAutomationNoteRedoChangedText() ||
        FindNoteTextSnippetStart(selectedPasteSource) >= 0 ||
        FindNoteTextSnippetStart(selectedPasteReplacement) < 0) {
        if (outError) *outError = L"Redo did not restore the selection-replacing Paste text.";
        return false;
    }
    DWORD selectionAfterRedoStart = 0;
    DWORD selectionAfterRedoEnd = 0;
    SendMessageW(g_hNoteEdit, EM_GETSEL,
                 reinterpret_cast<WPARAM>(&selectionAfterRedoStart),
                 reinterpret_cast<LPARAM>(&selectionAfterRedoEnd));
    if (selectionAfterRedoStart != stableSelectionStart ||
        selectionAfterRedoEnd != stableSelectionEnd) {
        if (outError) *outError = L"Redo jumped an unrelated Note selection to historic edit state.";
        return false;
    }

    // A selection that intersects the replacement has no stable text identity.
    // It must collapse at the end of each resulting replacement, rather than
    // being restored from the earlier Paste snapshot.
    const DWORD pastedTextStart = static_cast<DWORD>(selectedPasteInsertAt);
    const DWORD pastedTextEnd = static_cast<DWORD>(
        selectedPasteInsertAt + selectedPasteReplacement.size());
    const DWORD restoredTextEnd = static_cast<DWORD>(
        selectedPasteInsertAt + selectedPasteSource.size());
    SendMessageW(g_hNoteEdit, EM_SETSEL, static_cast<WPARAM>(pastedTextStart),
                 static_cast<LPARAM>(pastedTextEnd));
    if (!SendUiAutomationNoteUndoChangedText() ||
        FindNoteTextSnippetStart(selectedPasteSource) < 0 ||
        FindNoteTextSnippetStart(selectedPasteReplacement) >= 0) {
        if (outError) *outError = L"Undo did not restore the intersecting Note Paste text.";
        return false;
    }
    SendMessageW(g_hNoteEdit, EM_GETSEL,
                 reinterpret_cast<WPARAM>(&selectionAfterUndoStart),
                 reinterpret_cast<LPARAM>(&selectionAfterUndoEnd));
    if (selectionAfterUndoStart != restoredTextEnd || selectionAfterUndoEnd != restoredTextEnd) {
        if (outError) *outError = L"Undo did not collapse an intersecting Note selection deterministically.";
        return false;
    }
    if (!SendUiAutomationNoteRedoChangedText() ||
        FindNoteTextSnippetStart(selectedPasteSource) >= 0 ||
        FindNoteTextSnippetStart(selectedPasteReplacement) < 0) {
        if (outError) *outError = L"Redo did not restore the intersecting Note Paste text.";
        return false;
    }
    SendMessageW(g_hNoteEdit, EM_GETSEL,
                 reinterpret_cast<WPARAM>(&selectionAfterRedoStart),
                 reinterpret_cast<LPARAM>(&selectionAfterRedoEnd));
    if (selectionAfterRedoStart != pastedTextEnd || selectionAfterRedoEnd != pastedTextEnd) {
        if (outError) *outError = L"Redo did not collapse an intersecting Note selection deterministically.";
        return false;
    }

    // Typing coalesces only compatible adjacent text units, so punctuation in
    // the token can legitimately create more than one history entry. Unwind
    // until the exact pre-test snapshot is restored, without touching storage.
    size_t cleanupUndoCount = 0;
    const size_t maxCleanupUndoCount = typedToken.size() + 8;
    while (GetNoteAutomationIndexingText() != originalText &&
           cleanupUndoCount < maxCleanupUndoCount) {
        if (!SendUiAutomationNoteUndoChangedText()) break;
        ++cleanupUndoCount;
    }
    if (GetNoteAutomationIndexingText() != originalText) {
        if (outError) *outError = L"Undo cleanup did not restore the original note text.";
        return false;
    }

    // Exercise an ordinary editing sequence: repeated Backspace, repeated
    // undo/redo, then a fresh input that must invalidate the redo branch.
    const std::wstring backspaceToken = L"abcde";
    SendMessageW(g_hNoteEdit, EM_SETSEL,
                 static_cast<WPARAM>(originalText.size()),
                 static_cast<LPARAM>(originalText.size()));
    if (!SendUiAutomationNoteTextInput(backspaceToken) ||
        GetNoteAutomationIndexingText() != originalText + backspaceToken) {
        if (outError) *outError = L"Could not prepare repeated Backspace input.";
        return false;
    }
    if (!SendUiAutomationNoteBackspace(3) ||
        GetNoteAutomationIndexingText() != originalText + L"ab") {
        if (outError) *outError = L"Repeated Backspace did not remove the expected characters.";
        return false;
    }
    for (size_t restored = 1; restored <= 3; ++restored) {
        if (!SendUiAutomationNoteUndoChangedText() ||
            GetNoteAutomationIndexingText() !=
                originalText + backspaceToken.substr(0, 2 + restored)) {
            if (outError) *outError = L"Repeated undo did not restore one Backspace step at a time.";
            return false;
        }
    }
    for (size_t reapplied = 1; reapplied <= 3; ++reapplied) {
        if (!SendUiAutomationNoteRedoChangedText() ||
            GetNoteAutomationIndexingText() !=
                originalText + backspaceToken.substr(0, backspaceToken.size() - reapplied)) {
            if (outError) *outError = L"Repeated redo did not reapply one Backspace step at a time.";
            return false;
        }
    }
    if (!SendUiAutomationNoteMenuUndoRedoChangedText(owner, true) ||
        GetNoteAutomationIndexingText() != originalText + L"abc") {
        if (outError) *outError = L"Menu undo did not restore one Backspace step.";
        return false;
    }
    SendMessageW(g_hNoteEdit, EM_SETSEL,
                 static_cast<WPARAM>(originalText.size() + 3),
                 static_cast<LPARAM>(originalText.size() + 3));
    if (!SendUiAutomationNoteTextInput(L"x") ||
        GetNoteAutomationIndexingText() != originalText + L"abcx") {
        if (outError) *outError = L"New input after undo was not applied.";
        return false;
    }
    if (SendUiAutomationNoteRedoChangedText() ||
        GetNoteAutomationIndexingText() != originalText + L"abcx") {
        if (outError) *outError = L"Redo remained available after new input following undo.";
        return false;
    }

    cleanupUndoCount = 0;
    const size_t maxBackspaceCleanupUndoCount = backspaceToken.size() + 3;
    while (GetNoteAutomationIndexingText() != originalText &&
           cleanupUndoCount < maxBackspaceCleanupUndoCount) {
        if (!SendUiAutomationNoteUndoChangedText()) break;
        ++cleanupUndoCount;
    }
    if (GetNoteAutomationIndexingText() != originalText) {
        if (outError) *outError = L"Backspace undo/redo cleanup did not restore the original note text.";
        return false;
    }

    // Combine input, Backspace, undo, redo, and a new branch. Every state is
    // checked because this sequence catches stack-order and redo-invalidation
    // mistakes that a simple undo/redo round trip cannot expose.
    const std::wstring mixedToken = L"abc";
    SendMessageW(g_hNoteEdit, EM_SETSEL,
                 static_cast<WPARAM>(originalText.size()),
                 static_cast<LPARAM>(originalText.size()));
    if (!SendUiAutomationNoteTextInput(mixedToken) ||
        !SendUiAutomationNoteBackspace(2) ||
        GetNoteAutomationIndexingText() != originalText + L"a") {
        if (outError) *outError = L"Mixed input and Backspace sequence did not reach its expected state.";
        return false;
    }
    if (!SendUiAutomationNoteTextInput(L"x") ||
        GetNoteAutomationIndexingText() != originalText + L"ax") {
        if (outError) *outError = L"Mixed sequence did not append input after Backspace.";
        return false;
    }
    if (!SendUiAutomationNoteUndoChangedText() ||
        GetNoteAutomationIndexingText() != originalText + L"a") {
        if (outError) *outError = L"Mixed sequence undo did not remove the latest input.";
        return false;
    }
    if (!SendUiAutomationNoteMenuUndoRedoChangedText(owner, true) ||
        GetNoteAutomationIndexingText() != originalText + L"ab") {
        if (outError) *outError = L"Mixed sequence menu undo did not restore one Backspace step.";
        return false;
    }
    if (!SendUiAutomationNoteRedoChangedText() ||
        GetNoteAutomationIndexingText() != originalText + L"a") {
        if (outError) *outError = L"Mixed sequence redo did not reapply the Backspace step.";
        return false;
    }
    SendMessageW(g_hNoteEdit, EM_SETSEL,
                 static_cast<WPARAM>(originalText.size() + 1),
                 static_cast<LPARAM>(originalText.size() + 1));
    if (!SendUiAutomationNoteTextInput(L"y") ||
        GetNoteAutomationIndexingText() != originalText + L"ay") {
        if (outError) *outError = L"Mixed sequence branch input was not applied.";
        return false;
    }
    if (SendUiAutomationNoteRedoChangedText() ||
        GetNoteAutomationIndexingText() != originalText + L"ay") {
        if (outError) *outError = L"Mixed sequence retained redo after branching input.";
        return false;
    }

    cleanupUndoCount = 0;
    const size_t maxMixedCleanupUndoCount = mixedToken.size() + 3;
    while (GetNoteAutomationIndexingText() != originalText &&
           cleanupUndoCount < maxMixedCleanupUndoCount) {
        if (!SendUiAutomationNoteUndoChangedText()) break;
        ++cleanupUndoCount;
    }
    if (GetNoteAutomationIndexingText() != originalText) {
        if (outError) *outError = L"Mixed input undo/redo cleanup did not restore the original note text.";
        return false;
    }
    return true;
}

static bool RunUiAutomationNoteSwitchUndoScenario(HWND owner, std::wstring* outError) {
    if (!owner || g_currentNotePath.empty() || !g_hNoteEdit) {
        if (outError) *outError = L"Note switch automation requires an open note editor.";
        return false;
    }

    const std::wstring notePath = g_currentNotePath;
    const int noteIndex = CurrentNoteIndex();
    const int altNoteIndex = FindAlternativeFileIndex(g_hNoteList, noteIndex);
    if (altNoteIndex < 0) {
        if (outError) *outError = L"Could not find an alternate note for switch/undo automation.";
        return false;
    }
    if (!file_output::DiscardAllStagedDiffs(owner)) {
        if (outError) *outError = L"Failed to clear staged diffs before note switch/undo automation.";
        return false;
    }

    const std::wstring token = L"ui-automation-note-switch-undo-token";
    InsertSnippetIntoNoteAt(GetNoteAutomationIndexingText().size(), token);
    if (FindNoteTextSnippetStart(token) < 0) {
        if (outError) *outError = L"Failed to insert the note switch/undo token.";
        return false;
    }

    SetListboxSelAndNotify(g_hNoteList, altNoteIndex);
    if (NormalizePathKey(std::filesystem::path(g_currentNotePath)) ==
        NormalizePathKey(std::filesystem::path(notePath))) {
        if (outError) *outError = L"Switching to the alternate note did not change the current note.";
        return false;
    }
    if (CountUiAutomationStagesForTarget(file_output::StagedDiffKind::Note, notePath) == 0) {
        if (outError) *outError = L"Switching away from a dirty note did not stage its snapshot.";
        return false;
    }

    SetListboxSelAndNotify(g_hNoteList, noteIndex);
    if (NormalizePathKey(std::filesystem::path(g_currentNotePath)) !=
        NormalizePathKey(std::filesystem::path(notePath))) {
        if (outError) *outError = L"Switching back did not restore the original note.";
        return false;
    }
    if (FindNoteTextSnippetStart(token) < 0) {
        if (outError) *outError = L"Switching back lost the staged note edit text.";
        return false;
    }
    if (!SendUiAutomationNoteUndoChangedText()) {
        if (outError) *outError = L"Note undo did not change the note text after switching files.";
        return false;
    }
    if (FindNoteTextSnippetStart(token) >= 0) {
        if (outError) *outError = L"Undo after switching files did not remove the note edit token.";
        return false;
    }
    if (!SaveNoteIfDirty(owner)) {
        if (outError) *outError = L"Saving the reverted note after switching files failed.";
        return false;
    }
    if (CountUiAutomationStagesForTarget(file_output::StagedDiffKind::Note, notePath) != 0) {
        if (outError) *outError = L"Reverting a switched note back to the original content left a staged diff behind.";
        return false;
    }
    if (g_noteDirty || g_noteNeedsIntegrate) {
        if (outError) *outError = L"Reverted switched note remained dirty or marked for integration.";
        return false;
    }
    if (SendMessageW(g_hNoteEdit, EM_GETMODIFY, 0, 0) != 0) {
        if (outError) *outError = L"Reverted switched note left the editor modified flag set.";
        return false;
    }
    return true;
}

static bool CleanupUiAutomationNoteToken(HWND owner,
                                         const std::wstring& notePath,
                                         const std::wstring& token,
                                         std::wstring* outError) {
    if (FindNoteTextSnippetStart(token) >= 0) {
        if (!SelectNoteTextSnippet(token)) {
            if (outError) *outError = L"Could not select the note automation token for cleanup.";
            return false;
        }
        SendMessageW(g_hNoteEdit, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(L""));
    }
    if (!SaveNoteIfDirty(owner)) {
        if (outError) *outError = L"Cleanup note save failed during automation.";
        return false;
    }
    if (FindNoteTextSnippetStart(token) >= 0) {
        if (outError) *outError = L"Cleanup note token remained after save.";
        return false;
    }
    if (CountUiAutomationStagesForTarget(file_output::StagedDiffKind::Note, notePath) != 0) {
        if (outError) *outError = L"Cleanup note save left staged note diffs behind.";
        return false;
    }
    return true;
}

static bool RunUiAutomationStagedNoteRestoreViewScenario(HWND owner, std::wstring* outError) {
    if (!owner || g_currentNotePath.empty() || !g_hNoteEdit) {
        if (outError) *outError = L"Staged note restore-view automation requires an open note editor.";
        return false;
    }

    const std::wstring notePath = g_currentNotePath;
    const int noteIndex = CurrentNoteIndex();
    const int altNoteIndex = FindAlternativeFileIndex(g_hNoteList, noteIndex);
    if (altNoteIndex < 0) {
        if (outError) *outError = L"Could not find an alternate note for staged restore-view automation.";
        return false;
    }
    if (!file_output::DiscardAllStagedDiffs(owner)) {
        if (outError) *outError = L"Failed to clear staged diffs before staged restore-view automation.";
        return false;
    }

    const std::wstring token = L"ui-automation-staged-note-restore-view-token";
    InsertSnippetIntoNoteAt(GetNoteAutomationIndexingText().size(), token);
    const int tokenStart = FindNoteTextSnippetStart(token);
    if (tokenStart < 0) {
        if (outError) *outError = L"Failed to insert the staged restore-view token.";
        return false;
    }

    const DWORD expectedSelStart = static_cast<DWORD>(tokenStart + 14);
    const DWORD expectedSelEnd = static_cast<DWORD>(tokenStart + 25);
    SendMessageW(g_hNoteEdit, EM_SETSEL,
                 static_cast<WPARAM>(expectedSelStart),
                 static_cast<LPARAM>(expectedSelEnd));
    SendMessageW(g_hNoteEdit, EM_SCROLLCARET, 0, 0);
    const int expectedFirstVisibleLine = static_cast<int>(
        SendMessageW(g_hNoteEdit, EM_GETFIRSTVISIBLELINE, 0, 0));

    SetListboxSelAndNotify(g_hNoteList, altNoteIndex);
    if (NormalizePathKey(std::filesystem::path(g_currentNotePath)) ==
        NormalizePathKey(std::filesystem::path(notePath))) {
        if (outError) *outError = L"Switching away did not change the current note for staged restore-view automation.";
        return false;
    }

    std::optional<file_output::StagedDiffEntry> stagedEntry;
    const std::wstring noteKey = NormalizePathKey(std::filesystem::path(notePath));
    for (const auto& entry : file_output::ListStagedDiffEntries()) {
        if (entry.kind != file_output::StagedDiffKind::Note) continue;
        if (NormalizePathKey(std::filesystem::path(entry.targetPath)) != noteKey) continue;
        if (!stagedEntry.has_value() || entry.isLatest) {
            stagedEntry = entry;
        }
    }
    if (!stagedEntry.has_value()) {
        if (outError) *outError = L"Switching away did not create a staged note diff for restore-view automation.";
        return false;
    }
    if (stagedEntry->targetPath.empty() || stagedEntry->stagePath.empty()) {
        if (outError) *outError = L"Staged restore-view diff did not expose both target and stage paths.";
        return false;
    }
    if (!stagedEntry->noteRestoreView.has_value()) {
        if (outError) *outError = L"Staged note diff did not record restore-view metadata.";
        return false;
    }
    const auto restore = *stagedEntry->noteRestoreView;
    if (restore.contentRevision == 0) {
        if (outError) *outError = L"Staged note restore metadata did not record content revision.";
        return false;
    }
    if (restore.selectionStart != expectedSelStart || restore.selectionEnd != expectedSelEnd) {
        if (outError) *outError = L"Staged note restore metadata did not record the editor selection.";
        return false;
    }
    if (restore.firstVisibleLine != expectedFirstVisibleLine) {
        if (outError) *outError = L"Staged note restore metadata did not record the first visible line.";
        return false;
    }

    SetListboxSelAndNotify(g_hNoteList, noteIndex);
    if (NormalizePathKey(std::filesystem::path(g_currentNotePath)) != noteKey) {
        if (outError) *outError = L"Switching back did not restore the original note for staged restore-view automation.";
        return false;
    }
    if (FindNoteTextSnippetStart(token) < 0) {
        if (outError) *outError = L"Switching back lost the staged restore-view note text.";
        return false;
    }

    DWORD actualSelStart = 0;
    DWORD actualSelEnd = 0;
    SendMessageW(g_hNoteEdit, EM_GETSEL,
                 reinterpret_cast<WPARAM>(&actualSelStart),
                 reinterpret_cast<LPARAM>(&actualSelEnd));
    if (actualSelStart != expectedSelStart || actualSelEnd != expectedSelEnd) {
        if (outError) *outError = L"Staged note restore did not restore the editor selection.";
        return false;
    }
    const int actualFirstVisibleLine = static_cast<int>(
        SendMessageW(g_hNoteEdit, EM_GETFIRSTVISIBLELINE, 0, 0));
    if (actualFirstVisibleLine != expectedFirstVisibleLine) {
        if (outError) *outError = L"Staged note restore did not restore the first visible line.";
        return false;
    }

    return CleanupUiAutomationNoteToken(owner, notePath, token, outError);
}
static bool RunUiAutomationNoteBoundaryCommitScenario(HWND owner, std::wstring* outError) {
    if (!owner || g_currentNotePath.empty() || !g_hNoteEdit) {
        if (outError) *outError = L"Note boundary commit automation requires an open note editor.";
        return false;
    }
    if (!file_output::DiscardAllStagedDiffs(owner)) {
        if (outError) *outError = L"Failed to clear staged diffs before note boundary commit automation.";
        return false;
    }

    const std::wstring notePath = g_currentNotePath;
    const std::wstring escToken = L"ui-automation-note-esc-commit-token";
    InsertSnippetIntoNoteAt(GetNoteAutomationIndexingText().size(), escToken);
    if (FindNoteTextSnippetStart(escToken) < 0) {
        if (outError) *outError = L"Failed to insert the note Esc commit token.";
        return false;
    }
    EnterNoteNormalMode(owner);
    if (FindNoteTextSnippetStart(escToken) < 0) {
        if (outError) *outError = L"Esc boundary lost the note edit token.";
        return false;
    }
    if (CountUiAutomationStagesForTarget(file_output::StagedDiffKind::Note, notePath) == 0) {
        if (outError) *outError = L"Esc boundary did not stage the note edit.";
        return false;
    }
    if (!CleanupUiAutomationNoteToken(owner, notePath, escToken, outError)) return false;

    const std::wstring toolToken = L"ui-automation-note-tool-switch-commit-token";
    InsertSnippetIntoNoteAt(GetNoteAutomationIndexingText().size(), toolToken);
    if (FindNoteTextSnippetStart(toolToken) < 0) {
        if (outError) *outError = L"Failed to insert the note tool-switch commit token.";
        return false;
    }

    ToolMode targetMode = ToolMode::Pan;
    if (g_toolMode == targetMode || !ToolModeEnabledForCurrentPdfView(targetMode)) {
        targetMode = ToolMode::Select;
    }
    if (g_toolMode == targetMode || !ToolModeEnabledForCurrentPdfView(targetMode)) {
        targetMode = ToolMode::Magnifier;
    }
    if (g_toolMode == targetMode || !ToolModeEnabledForCurrentPdfView(targetMode)) {
        if (outError) *outError = L"Could not find an alternate enabled annotation tool for note boundary automation.";
        return false;
    }
    if (!SelectAnnotToolMode(owner, targetMode, false, false)) {
        if (outError) *outError = L"Annotation tool switch failed during note boundary automation.";
        return false;
    }
    if (FindNoteTextSnippetStart(toolToken) < 0) {
        if (outError) *outError = L"Tool switch boundary lost the note edit token.";
        return false;
    }
    if (CountUiAutomationStagesForTarget(file_output::StagedDiffKind::Note, notePath) == 0) {
        if (outError) *outError = L"Tool switch boundary did not stage the note edit.";
        return false;
    }
    if (!CleanupUiAutomationNoteToken(owner, notePath, toolToken, outError)) return false;

    const std::wstring pdfClickToken = L"ui-automation-note-pdf-click-commit-token";
    InsertSnippetIntoNoteAt(GetNoteAutomationIndexingText().size(), pdfClickToken);
    if (FindNoteTextSnippetStart(pdfClickToken) < 0) {
        if (outError) *outError = L"Failed to insert the note PDF-click commit token.";
        return false;
    }
    if (!g_hPdfView || !IsWindow(g_hPdfView)) {
        if (outError) *outError = L"PDF view was not available for note PDF-click boundary automation.";
        return false;
    }
    const LPARAM clickPoint = MAKELPARAM(4, 4);
    SendMessageW(g_hPdfView, WM_LBUTTONDOWN, 0, clickPoint);
    SendMessageW(g_hPdfView, WM_LBUTTONUP, 0, clickPoint);
    if (FindNoteTextSnippetStart(pdfClickToken) < 0) {
        if (outError) *outError = L"PDF click boundary lost the note edit token.";
        return false;
    }
    if (CountUiAutomationStagesForTarget(file_output::StagedDiffKind::Note, notePath) == 0) {
        if (outError) *outError = L"PDF click boundary did not stage the note edit.";
        return false;
    }
    return CleanupUiAutomationNoteToken(owner, notePath, pdfClickToken, outError);
}

static bool RunUiAutomationDeferredNoteInitialInputScenario(HWND owner, std::wstring* outError) {
    if (!owner || g_currentSessionPath.empty() || !g_hNoteEdit || g_currentNotePath.empty()) {
        if (outError) *outError = L"Deferred note initial-input automation requires an open session and note editor.";
        return false;
    }
    if (!SaveNoteIfDirty(owner)) {
        if (outError) *outError = L"Failed to save the current note before deferred-note automation.";
        return false;
    }
    if (!file_output::DiscardAllStagedDiffs(owner)) {
        if (outError) *outError = L"Failed to clear staged diffs before deferred-note automation.";
        return false;
    }

    const std::wstring previousNotePath = g_currentNotePath;
    const bool previousRenderEnabled = g_noteRenderEnabled;
    const bool previousRawOnly = g_noteRawOnly;
    const bool previousNoteNormalMode = g_noteNormalMode;

    auto restorePreviousNote = [&]() {
        file_output::DiscardAllStagedDiffs(owner);
        g_noteRenderEnabled = previousRenderEnabled;
        g_noteRawOnly = previousRawOnly;
        g_noteNormalMode = previousNoteNormalMode;
        if (!previousNotePath.empty()) {
            LoadNoteFile(owner, previousNotePath);
            SyncBottomPaneAfterNoteLoad(owner);
        } else {
            ClearNoteEditorSilently(owner, L"");
            g_previewNote.clear();
            RefreshBottomPaneView();
        }
        RefreshMainWindowUiState(owner);
    };

    struct DeferredNoteCase {
        bool renderEnabled;
        bool rawOnly;
        const wchar_t* label;
        const wchar_t* token;
    };
    const DeferredNoteCase cases[] = {
        {true, false, L"render-on", L"ui-automation-deferred-note-render-on"},
        {false, true, L"render-off", L"ui-automation-deferred-note-render-off"},
    };

    for (const auto& tc : cases) {
        if (!file_output::DiscardAllStagedDiffs(owner)) {
            restorePreviousNote();
            if (outError) *outError = L"Failed to clear staged diffs before deferred-note case.";
            return false;
        }
        ClearNoteEditorSilently(owner, L"");
        g_previewNote.clear();
        g_noteRenderEnabled = tc.renderEnabled;
        g_noteRawOnly = tc.rawOnly;
        g_noteNormalMode = false;
        RefreshBottomPaneView();
        RefreshMainWindowUiState(owner);

        const std::wstring token = tc.token;
        for (wchar_t ch : token) {
            SendMessageW(g_hNoteEdit, WM_CHAR, static_cast<WPARAM>(ch), 1);
        }
        if (g_currentNotePath.empty()) {
            restorePreviousNote();
            if (outError) *outError = std::wstring(L"Deferred note initial input did not establish a note path: ") + tc.label;
            return false;
        }
        const std::wstring deferredNotePath = g_currentNotePath;
        if (FindNoteTextSnippetStart(token) < 0) {
            restorePreviousNote();
            if (outError) *outError = std::wstring(L"Deferred note initial input was rejected by the editor: ") + tc.label;
            return false;
        }
        if (!g_noteDirty) {
            restorePreviousNote();
            if (outError) *outError = std::wstring(L"Deferred note initial input did not mark the note dirty: ") + tc.label;
            return false;
        }
        if (!SaveNoteIfDirty(owner)) {
            restorePreviousNote();
            if (outError) *outError = std::wstring(L"Deferred note initial input did not save to stage: ") + tc.label;
            return false;
        }
        if (CountUiAutomationStagesForTarget(file_output::StagedDiffKind::Note, deferredNotePath) == 0) {
            restorePreviousNote();
            if (outError) *outError = std::wstring(L"Deferred note initial input did not create a note stage: ") + tc.label;
            return false;
        }
        const std::filesystem::path stagePath = file_output::FindLatestStagedNotePathFor(deferredNotePath);
        std::string stagedBytes;
        std::wstring stageErr;
        if (stagePath.empty() ||
            !file_output::LoadResolvedStagedNoteBytes(deferredNotePath, stagePath, &stagedBytes, &stageErr)) {
            restorePreviousNote();
            if (outError) *outError = std::wstring(L"Deferred note initial input stage could not be read: ") + tc.label;
            return false;
        }
        const std::string tokenUtf8 = WideToUTF8(token);
        if (stagedBytes.find(tokenUtf8) == std::string::npos) {
            restorePreviousNote();
            if (outError) *outError = std::wstring(L"Deferred note initial input did not reach staged bytes: ") + tc.label;
            return false;
        }
    }

    restorePreviousNote();
    return true;
}

static bool RunUiAutomationExistingNoteRenderModeSaveScenario(HWND owner, std::wstring* outError) {
    if (!owner || g_currentNotePath.empty() || !g_hNoteEdit) {
        if (outError) *outError = L"Existing note render-mode save automation requires an open note editor.";
        return false;
    }
    if (!SaveNoteIfDirty(owner)) {
        if (outError) *outError = L"Failed to save the current note before render-mode save automation.";
        return false;
    }
    if (!file_output::DiscardAllStagedDiffs(owner)) {
        if (outError) *outError = L"Failed to clear staged diffs before render-mode save automation.";
        return false;
    }

    const std::wstring notePath = g_currentNotePath;
    const bool previousRenderEnabled = g_noteRenderEnabled;
    const bool previousRawOnly = g_noteRawOnly;
    const bool previousNoteNormalMode = g_noteNormalMode;

    auto restoreMode = [&]() {
        g_noteRenderEnabled = previousRenderEnabled;
        g_noteRawOnly = previousRawOnly;
        g_noteNormalMode = previousNoteNormalMode;
        RefreshBottomPaneView();
        RefreshMainWindowUiState(owner);
    };

    struct RenderModeCase {
        bool renderEnabled;
        bool rawOnly;
        const wchar_t* label;
        const wchar_t* token;
    };
    const RenderModeCase cases[] = {
        {true, false, L"render-on", L"ui-automation-existing-note-render-on-save"},
        {false, true, L"render-off", L"ui-automation-existing-note-render-off-save"},
    };

    for (const auto& tc : cases) {
        if (!file_output::DiscardAllStagedDiffs(owner)) {
            restoreMode();
            if (outError) *outError = L"Failed to clear staged diffs before render-mode case.";
            return false;
        }
        g_noteRenderEnabled = tc.renderEnabled;
        g_noteRawOnly = tc.rawOnly;
        g_noteNormalMode = false;
        RefreshBottomPaneView();
        RefreshMainWindowUiState(owner);

        const std::wstring token = tc.token;
        InsertSnippetIntoNoteAt(GetNoteAutomationIndexingText().size(), token);
        if (FindNoteTextSnippetStart(token) < 0) {
            restoreMode();
            if (outError) *outError = std::wstring(L"Existing note render-mode edit was rejected: ") + tc.label;
            return false;
        }
        if (!g_noteDirty) {
            restoreMode();
            if (outError) *outError = std::wstring(L"Existing note render-mode edit did not mark the note dirty: ") + tc.label;
            return false;
        }
        if (!SaveNoteIfDirty(owner)) {
            restoreMode();
            if (outError) *outError = std::wstring(L"Existing note render-mode edit did not save to stage: ") + tc.label;
            return false;
        }
        if (CountUiAutomationStagesForTarget(file_output::StagedDiffKind::Note, notePath) == 0) {
            restoreMode();
            if (outError) *outError = std::wstring(L"Existing note render-mode edit did not create a note stage: ") + tc.label;
            return false;
        }
        const std::filesystem::path stagePath = file_output::FindLatestStagedNotePathFor(notePath);
        std::string stagedBytes;
        std::wstring stageErr;
        if (stagePath.empty() ||
            !file_output::LoadResolvedStagedNoteBytes(notePath, stagePath, &stagedBytes, &stageErr)) {
            restoreMode();
            if (outError) *outError = std::wstring(L"Existing note render-mode stage could not be read: ") + tc.label;
            return false;
        }
        const std::string tokenUtf8 = WideToUTF8(token);
        if (stagedBytes.find(tokenUtf8) == std::string::npos) {
            restoreMode();
            if (outError) *outError = std::wstring(L"Existing note render-mode edit did not reach staged bytes: ") + tc.label;
            return false;
        }
        if (!CleanupUiAutomationNoteToken(owner, notePath, token, outError)) {
            restoreMode();
            return false;
        }
    }

    restoreMode();
    return true;
}
static bool RunUiAutomationPdfActiveEditSaveScenario(HWND owner, std::wstring* outError) {
    if (!owner || g_pdf.kind != DocKind::Pdf || CurrentLogicalPdfPath().empty() ||
        !g_hPdfView || g_pdf.pages.empty()) {
        if (outError) *outError = L"PDF save automation requires an open PDF document.";
        return false;
    }
    if (!file_output::DiscardAllStagedDiffs(owner)) {
        if (outError) *outError = L"Failed to clear staged diffs before PDF save automation.";
        return false;
    }

    const std::wstring pdfPath = CurrentLogicalPdfPath();
    const std::wstring token = L"ui automation pdf active edit";
    const auto& page = g_pdf.pages.front();
    const double left = std::clamp(24.0, 0.0, std::max(24.0, page.widthPt - 48.0));
    const double right = std::min(page.widthPt, left + 140.0);
    const double top = std::max(32.0, std::min(page.heightPt, 96.0));
    const double bottom = std::max(0.0, top - 28.0);

    g_pdf.editingText = true;
    g_pdf.editPage = 0;
    g_pdf.editX1 = left;
    g_pdf.editX2 = right;
    g_pdf.editY1 = top;
    g_pdf.editY2 = bottom;
    g_pdf.editText = token;
    g_pdf.editCaret = g_pdf.editText.size();
    g_pdf.editSelStart = g_pdf.editCaret;
    g_pdf.editSelEnd = g_pdf.editCaret;
    g_pdf.editSelectingText = false;
    g_pdf.editSelAnchor = g_pdf.editCaret;
    g_pdf.editLayoutDirty = true;
    g_pdf.editInnerLayoutW = 0;
    g_pdf.editLayout.lines.clear();
    g_pdf.editFontName = g_textFontName;
    g_pdf.editFontPt = (g_textFontPt > 0.0) ? g_textFontPt : 12.0;
    g_pdf.imeComp.clear();
    g_pdf.imeComposing = false;
    g_annotsDirty = false;
    g_annotsNeedsIntegrate = false;

    if (!SaveAnnotationsIfDirty(owner)) {
        if (outError) *outError = L"Saving annotations while a textbox edit was active failed.";
        return false;
    }

    const std::filesystem::path stagePath = file_output::FindLatestStagedClropPathForPdf(pdfPath);
    if (stagePath.empty()) {
        if (outError) *outError = L"Saving an active PDF textbox edit did not create a staged clrop diff.";
        return false;
    }

    std::vector<Annotation> loaded;
    bool mismatch = false;
    std::wstring err;
    if (!clrop_bridge::LoadAnnotations(stagePath.wstring(), pdfPath, loaded, mismatch, nullptr, err,
                                       clrop_bridge::LoadAnnotationsValidation::None)) {
        if (outError) *outError = L"Failed to load the staged clrop created from an active textbox edit.";
        return false;
    }

    bool foundTextBox = false;
    for (const auto& ann : loaded) {
        if (ann.type == Annotation::Type::TextBox && ann.text == token) {
            foundTextBox = true;
            break;
        }
    }
    if (!foundTextBox) {
        if (outError) *outError = L"Active textbox edit text was missing from the staged clrop diff.";
        return false;
    }

    g_pdf.editingText = false;
    g_pdf.editPage = -1;
    g_pdf.editText.clear();
    g_pdf.editCaret = 0;
    g_pdf.editSelStart = 0;
    g_pdf.editSelEnd = 0;
    g_pdf.editSelectingText = false;
    g_pdf.editSelAnchor = 0;
    g_pdf.editLayoutDirty = true;
    g_pdf.editInnerLayoutW = 0;
    g_pdf.editLayout.lines.clear();
    g_pdf.imeComp.clear();
    g_pdf.imeComposing = false;
    g_annotsDirty = false;
    g_annotsNeedsIntegrate = false;
    file_output::DiscardAllStagedDiffs(owner);
    RefreshMainWindowUiState(owner);
    if (g_hPdfView) {
        InvalidateRect(g_hPdfView, nullptr, FALSE);
    }
    return true;
}

static bool RunUiAutomationPdfTextboxUndoRedoScenario(HWND owner, std::wstring* outError) {
    if (!owner || g_pdf.kind != DocKind::Pdf || !g_hPdfView || g_pdf.pages.empty()) {
        if (outError) *outError = L"PDF textbox undo/redo automation requires an open PDF document.";
        return false;
    }

    // Start from the same history boundary as a newly opened TextBox. The
    // discard path clears any process-local text edit entry without creating
    // an annotation or touching staged data.
    g_pdf.editingText = true;
    g_pdf.editPage = -1;
    EndInlineTextEditing(g_hPdfView, false);

    const auto& page = g_pdf.pages.front();
    const std::wstring before = L"ui automation pdf textbox history";
    const std::wstring after = before + L"X";
    const std::wstring selectedPasteSource = L"history";
    const std::wstring selectedPasteReplacement = L"paste";
    const size_t selectedPasteStart = before.find(selectedPasteSource);
    const size_t selectedPasteEnd = selectedPasteStart + selectedPasteSource.size();
    const std::wstring afterPaste = before.substr(0, selectedPasteStart) +
                                   selectedPasteReplacement + before.substr(selectedPasteEnd) + L"X";
    const double left = std::clamp(24.0, 0.0, std::max(24.0, page.widthPt - 48.0));
    const double right = std::min(page.widthPt, left + 180.0);
    const double top = std::max(32.0, std::min(page.heightPt, 96.0));
    const double bottom = std::max(0.0, top - 28.0);

    g_pdf.editingText = true;
    g_pdf.editPage = 0;
    g_pdf.editX1 = left;
    g_pdf.editX2 = right;
    g_pdf.editY1 = top;
    g_pdf.editY2 = bottom;
    g_pdf.editText = before;
    g_pdf.editCaret = before.size();
    g_pdf.editSelStart = g_pdf.editCaret;
    g_pdf.editSelEnd = g_pdf.editCaret;
    g_pdf.editSelectingText = false;
    g_pdf.editSelAnchor = g_pdf.editCaret;
    g_pdf.editLayoutDirty = true;
    g_pdf.editInnerLayoutW = 0;
    g_pdf.editLayout.lines.clear();
    g_pdf.editFontName = g_textFontName;
    g_pdf.editFontPt = (g_textFontPt > 0.0) ? g_textFontPt : 12.0;
    g_pdf.imeComp.clear();
    g_pdf.imeComposing = false;

    auto fail = [&](const wchar_t* message) {
        EndInlineTextEditing(g_hPdfView, false);
        if (outError) *outError = message;
        return false;
    };

    SetFocus(g_hPdfView);
    if (GetFocus() != g_hPdfView) {
        return fail(L"Could not focus the PDF textbox for undo/redo automation.");
    }
    SendMessageW(g_hPdfView, WM_CHAR, L'X', 0);
    if (g_pdf.editText != after || !CanExecutePdfUndoRedoFromFocus(true)) {
        return fail(L"PDF textbox typing did not produce an undoable local edit.");
    }
    if (!ExecutePdfUndoRedoFromFocus(owner, true) ||
        g_pdf.editText != before || g_pdf.editCaret != before.size() ||
        g_pdf.editSelStart != before.size() || g_pdf.editSelEnd != before.size()) {
        return fail(L"PDF textbox undo did not restore the expected snapshot.");
    }
    if (!CanExecutePdfUndoRedoFromFocus(false) ||
        !ExecutePdfUndoRedoFromFocus(owner, false) ||
        g_pdf.editText != after || g_pdf.editCaret != after.size() ||
        g_pdf.editSelStart != after.size() || g_pdf.editSelEnd != after.size()) {
        return fail(L"PDF textbox redo did not restore the expected snapshot.");
    }

    // Paste over an existing selection must be one TextEditCommand. The
    // clipboard path below is the same one used by Ctrl+V and the context
    // menu, rather than a direct edit of g_pdf.editText. A later selection
    // outside the replacement must stay where the user moved it.
    g_pdf.editCaret = selectedPasteEnd;
    g_pdf.editSelStart = selectedPasteStart;
    g_pdf.editSelEnd = selectedPasteEnd;
    if (!SetUiAutomationClipboardText(owner, selectedPasteReplacement) ||
        !PasteClipboardIntoActivePdfTextBox(g_hPdfView) ||
        g_pdf.editText != afterPaste ||
        g_pdf.editCaret != selectedPasteStart + selectedPasteReplacement.size() ||
        g_pdf.editSelStart != g_pdf.editCaret || g_pdf.editSelEnd != g_pdf.editCaret) {
        return fail(L"PDF textbox Paste did not replace the selected source text.");
    }
    // The trailing X is outside the replaced range. Its offset changes with
    // the replacement, but the selection must keep pointing at that same X.
    const size_t stableSelectionBeforeUndoStart =
        selectedPasteStart + selectedPasteReplacement.size();
    const size_t stableSelectionBeforeUndoEnd = stableSelectionBeforeUndoStart + 1;
    const size_t stableSelectionAfterUndoStart = selectedPasteEnd;
    const size_t stableSelectionAfterUndoEnd = stableSelectionAfterUndoStart + 1;
    g_pdf.editCaret = stableSelectionBeforeUndoEnd;
    g_pdf.editSelStart = stableSelectionBeforeUndoStart;
    g_pdf.editSelEnd = stableSelectionBeforeUndoEnd;
    if (!ExecutePdfUndoRedoFromFocus(owner, true) ||
        g_pdf.editText != after || g_pdf.editCaret != stableSelectionAfterUndoEnd ||
        g_pdf.editSelStart != stableSelectionAfterUndoStart ||
        g_pdf.editSelEnd != stableSelectionAfterUndoEnd) {
        return fail(L"PDF textbox undo jumped an unrelated selection to historic edit state.");
    }
    if (!ExecutePdfUndoRedoFromFocus(owner, false) ||
        g_pdf.editText != afterPaste ||
        g_pdf.editCaret != stableSelectionBeforeUndoEnd ||
        g_pdf.editSelStart != stableSelectionBeforeUndoStart ||
        g_pdf.editSelEnd != stableSelectionBeforeUndoEnd) {
        return fail(L"PDF textbox redo jumped an unrelated selection to historic edit state.");
    }

    // Selection navigation is not a document mutation. It must not prevent
    // Undo from applying the same text command. A selection that intersects
    // the changed text collapses at the end of the resulting replacement.
    g_pdf.editCaret = 0;
    g_pdf.editSelStart = 0;
    g_pdf.editSelEnd = afterPaste.size();
    if (!ExecutePdfUndoRedoFromFocus(owner, true) ||
        g_pdf.editText != after || g_pdf.editCaret != selectedPasteEnd ||
        g_pdf.editSelStart != selectedPasteEnd || g_pdf.editSelEnd != selectedPasteEnd) {
        return fail(L"PDF textbox undo was blocked by a later selection change.");
    }
    if (!ExecutePdfUndoRedoFromFocus(owner, false) ||
        g_pdf.editText != afterPaste ||
        g_pdf.editCaret != selectedPasteStart + selectedPasteReplacement.size() ||
        g_pdf.editSelStart != g_pdf.editCaret || g_pdf.editSelEnd != g_pdf.editCaret) {
        return fail(L"PDF textbox redo did not survive selection-navigation undo.");
    }

    // Simulate a state change which did not pass through this TextBox command
    // path. Undo must reject it without consuming the entry; restoring the
    // expected state must make that same entry undoable again.
    g_pdf.editText.push_back(L'!');
    const std::wstring mismatchedText = g_pdf.editText;
    if (ExecutePdfUndoRedoFromFocus(owner, true) || g_pdf.editText != mismatchedText) {
        return fail(L"PDF textbox undo consumed or partially restored a mismatched snapshot.");
    }
    g_pdf.editText = afterPaste;
    g_pdf.editCaret = selectedPasteStart + selectedPasteReplacement.size();
    g_pdf.editSelStart = g_pdf.editCaret;
    g_pdf.editSelEnd = g_pdf.editCaret;
    if (!ExecutePdfUndoRedoFromFocus(owner, true) || g_pdf.editText != after ||
         g_pdf.editCaret != selectedPasteEnd ||
         g_pdf.editSelStart != selectedPasteEnd || g_pdf.editSelEnd != selectedPasteEnd) {
        return fail(L"PDF textbox undo entry was consumed after a snapshot mismatch.");
    }

    EndInlineTextEditing(g_hPdfView, false);
    return true;
}

static bool RunUiAutomationPdfTextboxEscCommitScenario(HWND owner, std::wstring* outError) {
    if (!owner || g_pdf.kind != DocKind::Pdf || CurrentLogicalPdfPath().empty() ||
        !g_hPdfView || g_pdf.pages.empty()) {
        if (outError) *outError = L"PDF textbox Esc automation requires an open PDF document.";
        return false;
    }
    if (!file_output::DiscardAllStagedDiffs(owner)) {
        if (outError) *outError = L"Failed to clear staged diffs before PDF textbox Esc automation.";
        return false;
    }

    const std::wstring pdfPath = CurrentLogicalPdfPath();
    const std::wstring token = L"ui automation pdf textbox esc commit";
    const auto& page = g_pdf.pages.front();
    const double left = std::clamp(30.0, 0.0, std::max(30.0, page.widthPt - 60.0));
    const double right = std::min(page.widthPt, left + 180.0);
    const double top = std::max(40.0, std::min(page.heightPt, 120.0));
    const double bottom = std::max(0.0, top - 30.0);

    g_pdf.editingText = true;
    g_pdf.editPage = 0;
    g_pdf.editX1 = left;
    g_pdf.editX2 = right;
    g_pdf.editY1 = top;
    g_pdf.editY2 = bottom;
    g_pdf.editText = token;
    g_pdf.editCaret = g_pdf.editText.size();
    g_pdf.editSelStart = g_pdf.editCaret;
    g_pdf.editSelEnd = g_pdf.editCaret;
    g_pdf.editSelectingText = false;
    g_pdf.editSelAnchor = g_pdf.editCaret;
    g_pdf.editLayoutDirty = true;
    g_pdf.editInnerLayoutW = 0;
    g_pdf.editLayout.lines.clear();
    g_pdf.editFontName = g_textFontName;
    g_pdf.editFontPt = (g_textFontPt > 0.0) ? g_textFontPt : 12.0;
    g_pdf.imeComp.clear();
    g_pdf.imeComposing = false;
    g_annotsDirty = false;
    g_annotsNeedsIntegrate = false;

    SendMessageW(g_hPdfView, WM_KEYDOWN, VK_ESCAPE, 0);
    if (g_pdf.editingText) {
        if (outError) *outError = L"Esc did not end PDF textbox editing.";
        return false;
    }

    bool foundInMemory = false;
    for (const auto& ann : g_annots) {
        if (ann.type == Annotation::Type::TextBox && ann.text == token) {
            foundInMemory = true;
            break;
        }
    }
    if (!foundInMemory) {
        if (outError) *outError = L"Esc ended PDF textbox editing without committing the text.";
        return false;
    }
    if (!g_annotsDirty || !g_annotsNeedsIntegrate) {
        if (outError) *outError = L"Esc-committed PDF textbox did not mark annotations dirty.";
        return false;
    }

    if (!SaveAnnotationsIfDirty(owner)) {
        if (outError) *outError = L"Saving an Esc-committed PDF textbox failed.";
        return false;
    }
    const std::filesystem::path stagePath = file_output::FindLatestStagedClropPathForPdf(pdfPath);
    if (stagePath.empty()) {
        if (outError) *outError = L"Esc-committed PDF textbox did not create a staged clrop diff.";
        return false;
    }

    std::vector<Annotation> loaded;
    bool mismatch = false;
    std::wstring err;
    if (!clrop_bridge::LoadAnnotations(stagePath.wstring(), pdfPath, loaded, mismatch, nullptr, err,
                                       clrop_bridge::LoadAnnotationsValidation::None)) {
        if (outError) *outError = L"Failed to load the staged clrop created from an Esc-committed textbox.";
        return false;
    }
    bool foundStaged = false;
    for (const auto& ann : loaded) {
        if (ann.type == Annotation::Type::TextBox && ann.text == token) {
            foundStaged = true;
            break;
        }
    }
    if (!foundStaged) {
        if (outError) *outError = L"Esc-committed PDF textbox text was missing from the staged clrop diff.";
        return false;
    }

    if (!file_output::DiscardAllStagedDiffs(owner)) {
        if (outError) *outError = L"Failed to clear staged diffs before PDF textbox focus-boundary automation.";
        return false;
    }
    const std::wstring focusToken = L"ui automation pdf textbox focus commit";
    g_pdf.editingText = true;
    g_pdf.editPage = 0;
    g_pdf.editX1 = left;
    g_pdf.editX2 = right;
    g_pdf.editY1 = top;
    g_pdf.editY2 = bottom;
    g_pdf.editText = focusToken;
    g_pdf.editCaret = g_pdf.editText.size();
    g_pdf.editSelStart = g_pdf.editCaret;
    g_pdf.editSelEnd = g_pdf.editCaret;
    g_pdf.editSelectingText = false;
    g_pdf.editSelAnchor = g_pdf.editCaret;
    g_pdf.editLayoutDirty = true;
    g_pdf.editInnerLayoutW = 0;
    g_pdf.editLayout.lines.clear();
    g_pdf.editFontName = g_textFontName;
    g_pdf.editFontPt = (g_textFontPt > 0.0) ? g_textFontPt : 12.0;
    g_pdf.imeComp.clear();
    g_pdf.imeComposing = false;
    g_annotsDirty = false;
    g_annotsNeedsIntegrate = false;

    SendMessageW(g_hPdfView, WM_KILLFOCUS, reinterpret_cast<WPARAM>(owner), 0);
    if (g_pdf.editingText) {
        if (outError) *outError = L"Focus loss did not end PDF textbox editing.";
        return false;
    }
    bool foundFocusInMemory = false;
    for (const auto& ann : g_annots) {
        if (ann.type == Annotation::Type::TextBox && ann.text == focusToken) {
            foundFocusInMemory = true;
            break;
        }
    }
    if (!foundFocusInMemory) {
        if (outError) *outError = L"Focus loss ended PDF textbox editing without committing the text.";
        return false;
    }
    if (!g_annotsDirty || !g_annotsNeedsIntegrate) {
        if (outError) *outError = L"Focus-committed PDF textbox did not mark annotations dirty.";
        return false;
    }
    if (!SaveAnnotationsIfDirty(owner)) {
        if (outError) *outError = L"Saving a focus-committed PDF textbox failed.";
        return false;
    }
    const std::filesystem::path focusStagePath = file_output::FindLatestStagedClropPathForPdf(pdfPath);
    if (focusStagePath.empty()) {
        if (outError) *outError = L"Focus-committed PDF textbox did not create a staged clrop diff.";
        return false;
    }
    std::vector<Annotation> focusLoaded;
    mismatch = false;
    err.clear();
    if (!clrop_bridge::LoadAnnotations(focusStagePath.wstring(), pdfPath, focusLoaded, mismatch, nullptr, err,
                                       clrop_bridge::LoadAnnotationsValidation::None)) {
        if (outError) *outError = L"Failed to load the staged clrop created from a focus-committed textbox.";
        return false;
    }
    bool foundFocusStaged = false;
    for (const auto& ann : focusLoaded) {
        if (ann.type == Annotation::Type::TextBox && ann.text == focusToken) {
            foundFocusStaged = true;
            break;
        }
    }
    if (!foundFocusStaged) {
        if (outError) *outError = L"Focus-committed PDF textbox text was missing from the staged clrop diff.";
        return false;
    }

    g_annotsDirty = false;
    g_annotsNeedsIntegrate = false;
    file_output::DiscardAllStagedDiffs(owner);
    RefreshMainWindowUiState(owner);
    if (g_hPdfView) {
        InvalidateRect(g_hPdfView, nullptr, FALSE);
    }
    return true;
}

static bool RunUiAutomationAnnotListLatestVisibleScenario(HWND owner, std::wstring* outError) {
    if (!g_hAnnotList || g_pdf.kind != DocKind::Pdf || g_pdf.pages.empty()) {
        if (outError) *outError = L"Annotation list latest-visible automation requires an open PDF and annot list.";
        return false;
    }

    const auto originalAnnots = g_annots;
    const int originalSel = static_cast<int>(SendMessageW(g_hAnnotList, LB_GETCURSEL, 0, 0));
    auto restore = [&]() {
        g_annots = originalAnnots;
        RefreshAnnotPanel();
        if (originalSel >= 0 && originalSel < static_cast<int>(g_annots.size())) {
            SendMessageW(g_hAnnotList, LB_SETCURSEL, static_cast<WPARAM>(originalSel), 0);
        }
        UpdateAnnotPanelSummary();
    };

    g_annots.clear();
    const auto& page = g_pdf.pages.front();
    for (int i = 0; i < 12; ++i) {
        Annotation ann;
        ann.type = Annotation::Type::TextBox;
        ann.pageIndex = 0;
        ann.x1 = 24.0;
        ann.x2 = std::min(page.widthPt, 120.0);
        ann.y1 = std::max(30.0, page.heightPt - 24.0 - i * 2.0);
        ann.y2 = std::max(0.0, ann.y1 - 18.0);
        ann.text = L"ui automation annot list " + std::to_wstring(i);
        ann.fontName = g_textFontName;
        ann.fontPt = (g_textFontPt > 0.0) ? g_textFontPt : 12.0;
        ann.color = g_activeColor;
        g_annots.push_back(ann);
    }

    RequestAnnotPanelRevealLatest();
    RefreshAnnotPanel();

    const int count = static_cast<int>(SendMessageW(g_hAnnotList, LB_GETCOUNT, 0, 0));
    const int sel = static_cast<int>(SendMessageW(g_hAnnotList, LB_GETCURSEL, 0, 0));
    const int top = static_cast<int>(SendMessageW(g_hAnnotList, LB_GETTOPINDEX, 0, 0));
    if (count != static_cast<int>(g_annots.size()) || count <= 0) {
        restore();
        if (outError) *outError = L"Annotation list latest-visible automation did not populate the list.";
        return false;
    }
    if (sel != count - 1) {
        restore();
        if (outError) *outError = L"Annotation list did not select the latest annotation after reveal request.";
        return false;
    }
    if (top < 0 || top > sel) {
        restore();
        if (outError) *outError = L"Annotation list top index is inconsistent after latest reveal.";
        return false;
    }

    restore();
    return true;
}

static bool RunUiAutomationFreehandAndAnnotationHistoryScenario(HWND owner, std::wstring* outError) {
    if (!owner || !g_hPdfView || !g_hAnnotList || g_pdf.kind != DocKind::Pdf || g_pdf.pages.empty()) {
        if (outError) *outError = L"Freehand/history automation requires an open PDF document.";
        return false;
    }

    const auto originalAnnots = g_annots;
    const bool originalAnnotsDirty = g_annotsDirty;
    const bool originalAnnotsNeedsIntegrate = g_annotsNeedsIntegrate;
    const std::wstring originalCorrection = g_config.freehandCorrection;
    const ToolMode originalToolMode = g_toolMode;
    const int originalSel = static_cast<int>(SendMessageW(g_hAnnotList, LB_GETCURSEL, 0, 0));
    auto restore = [&]() {
        g_annots = originalAnnots;
        g_annotsDirty = originalAnnotsDirty;
        g_annotsNeedsIntegrate = originalAnnotsNeedsIntegrate;
        g_config.freehandCorrection = originalCorrection;
        g_toolMode = originalToolMode;
        ClearPdfAnnotationHistory();
        RefreshAnnotPanel();
        if (originalSel >= 0 && originalSel < static_cast<int>(g_annots.size())) {
            SendMessageW(g_hAnnotList, LB_SETCURSEL, static_cast<WPARAM>(originalSel), 0);
        }
        UpdateAnnotPanelSummary();
        RefreshMainWindowUiState(owner);
        if (g_hPdfView) InvalidateRect(g_hPdfView, nullptr, FALSE);
    };
    auto fail = [&](const wchar_t* message) {
        restore();
        if (outError) *outError = message;
        return false;
    };

    ClearPdfAnnotationHistory();
    g_config.freehandCorrection = L"auto";
    Annotation raw;
    raw.type = Annotation::Type::Freehand;
    raw.pageIndex = 0;
    raw.width = 2.0;
    raw.color = RGB(255, 140, 0);
    raw.path = {{ 36.0, 120.0 }, { 58.0, 120.6 }, { 80.0, 119.4 },
                { 102.0, 120.3 }, { 124.0, 120.0 }};
    raw.x1 = raw.path.front().x;
    raw.y1 = raw.path.front().y;
    raw.x2 = raw.path.back().x;
    raw.y2 = raw.path.back().y;

    Annotation corrected;
    if (!TryCorrectFreehandAnnotation(raw, &corrected) || corrected.type != Annotation::Type::Line) {
        return fail(L"Freehand correction automation did not recognize a stable line stroke.");
    }
    Annotation tooShort = raw;
    tooShort.path = {{ 36.0, 120.0 }, { 38.0, 120.0 }};
    if (TryCorrectFreehandAnnotation(tooShort, &corrected)) {
        return fail(L"Freehand correction automation accepted a stroke below the minimum length.");
    }

    g_annots.clear();
    InsertAnnotAt(corrected, 0);
    if (g_annots.size() != 1 || g_annots.front().id.empty()) {
        return fail(L"Annotation history automation could not prepare a corrected annotation.");
    }
    if (!DeleteAnnotationAtIndex(owner, 0) || !g_annots.empty()) {
        return fail(L"Annotation history automation did not record deletion.");
    }

    SetFocus(g_hPdfView);
    if (!ExecutePdfUndoRedoFromFocus(owner, true) || g_annots.size() != 1 ||
        g_annots.front().type != Annotation::Type::Line) {
        return fail(L"Annotation history automation could not undo deletion.");
    }
    if (!ExecutePdfUndoRedoFromFocus(owner, false) || !g_annots.empty()) {
        return fail(L"Annotation history automation could not redo deletion.");
    }
    if (!ExecutePdfUndoRedoFromFocus(owner, true) || g_annots.size() != 1) {
        return fail(L"Annotation history automation could not restore the annotation before add testing.");
    }
    if (!DuplicateAnnotationAtIndex(owner, 0) || g_annots.size() != 2) {
        return fail(L"Annotation history automation did not record addition.");
    }
    if (!ExecutePdfUndoRedoFromFocus(owner, true) || g_annots.size() != 1) {
        return fail(L"Annotation history automation could not undo addition.");
    }
    if (!ExecutePdfUndoRedoFromFocus(owner, false) || g_annots.size() != 2) {
        return fail(L"Annotation history automation could not redo addition.");
    }

    restore();
    return true;
}

static bool RunUiAutomationPdfTextboxTripleClickCopyFocusScenario(HWND owner, std::wstring* outError) {
    if (!owner || g_pdf.kind != DocKind::Pdf || !g_hPdfView || g_pdf.pages.empty()) {
        if (outError) *outError = L"PDF textbox triple-click automation requires an open PDF document.";
        return false;
    }

    const auto originalAnnots = g_annots;
    const bool originalAnnotsDirty = g_annotsDirty;
    const bool originalAnnotsNeedsIntegrate = g_annotsNeedsIntegrate;
    auto restore = [&]() {
        g_annots = originalAnnots;
        g_annotsDirty = originalAnnotsDirty;
        g_annotsNeedsIntegrate = originalAnnotsNeedsIntegrate;
        g_pdf.editingText = false;
        g_pdf.editPage = -1;
        g_pdf.editText.clear();
        g_pdf.editCaret = 0;
        g_pdf.editSelStart = 0;
        g_pdf.editSelEnd = 0;
        g_pdf.editSelectingText = false;
        g_pdf.editSelectMoved = false;
        g_pdf.pendingTextBoxHit = false;
        g_pdf.pendingTextBoxIndex = -1;
        g_pdf.imeComp.clear();
        g_pdf.imeComposing = false;
        g_pdf.textBoxRapidClickTick = 0;
        g_pdf.textBoxRapidClickCount = 0;
        g_pdf.textBoxRapidClickPage = -1;
        if (g_hPdfView) InvalidateRect(g_hPdfView, nullptr, FALSE);
    };

    const auto& page = g_pdf.pages.front();
    const double left = std::clamp(36.0, 0.0, std::max(36.0, page.widthPt - 72.0));
    const double right = std::min(page.widthPt, left + 150.0);
    const double top = std::max(40.0, std::min(page.heightPt, 140.0));
    const double bottom = std::max(0.0, top - 30.0);

    Annotation existing;
    existing.type = Annotation::Type::TextBox;
    existing.pageIndex = 0;
    existing.x1 = left;
    existing.x2 = right;
    existing.y1 = top;
    existing.y2 = bottom;
    existing.text = L"ui automation triple click existing copy";
    existing.fontName = g_textFontName;
    existing.fontPt = (g_textFontPt > 0.0) ? g_textFontPt : 12.0;
    existing.color = g_activeColor;
    g_annots.push_back(existing);
    const int existingIndex = static_cast<int>(g_annots.size()) - 1;

    g_pdf.pendingTextBoxHit = true;
    g_pdf.pendingTextBoxIndex = existingIndex;
    g_pdf.textBoxRapidClickTick = GetTickCount64();
    g_pdf.textBoxRapidClickCount = 2;
    g_pdf.textBoxRapidClickPage = 0;
    g_pdf.textBoxRapidClickX1 = std::min(left, right);
    g_pdf.textBoxRapidClickX2 = std::max(left, right);
    g_pdf.textBoxRapidClickY1 = std::min(top, bottom);
    g_pdf.textBoxRapidClickY2 = std::max(top, bottom);
    if (g_hNoteEdit) SetFocus(g_hNoteEdit);
    SendMessageW(g_hPdfView, WM_LBUTTONUP, 0, MAKELPARAM(12, 12));

    if (g_pdf.pendingTextBoxHit || g_pdf.pendingTextBoxIndex >= 0 || g_pdf.editingText) {
        restore();
        if (outError) *outError = L"Triple-click copy left an existing PDF textbox in pending/edit state.";
        return false;
    }
    if (GetFocus() != g_hPdfView) {
        restore();
        if (outError) *outError = L"Triple-click copy did not return focus to the PDF view.";
        return false;
    }
    if (g_annots.size() != originalAnnots.size() + 1 ||
        g_annots.back().type != Annotation::Type::TextBox ||
        g_annots.back().text != existing.text) {
        restore();
        if (outError) *outError = L"Triple-click copy changed the existing PDF textbox annotation.";
        return false;
    }

    const std::wstring activeToken = L"ui automation triple click active edit copy";
    g_pdf.editingText = true;
    g_pdf.editPage = 0;
    g_pdf.editX1 = left;
    g_pdf.editX2 = right;
    g_pdf.editY1 = top;
    g_pdf.editY2 = bottom;
    g_pdf.editText = activeToken;
    g_pdf.editCaret = g_pdf.editText.size();
    g_pdf.editSelStart = g_pdf.editCaret;
    g_pdf.editSelEnd = g_pdf.editCaret;
    g_pdf.editSelectingText = true;
    g_pdf.editSelectMoved = false;
    g_pdf.editSelAnchor = g_pdf.editCaret;
    g_pdf.editLayoutDirty = true;
    g_pdf.editInnerLayoutW = 0;
    g_pdf.editLayout.lines.clear();
    g_pdf.editFontName = g_textFontName;
    g_pdf.editFontPt = (g_textFontPt > 0.0) ? g_textFontPt : 12.0;
    g_pdf.imeComp.clear();
    g_pdf.imeComposing = false;
    g_pdf.textBoxRapidClickTick = GetTickCount64();
    g_pdf.textBoxRapidClickCount = 2;
    g_pdf.textBoxRapidClickPage = 0;
    g_pdf.textBoxRapidClickX1 = std::min(left, right);
    g_pdf.textBoxRapidClickX2 = std::max(left, right);
    g_pdf.textBoxRapidClickY1 = std::min(top, bottom);
    g_pdf.textBoxRapidClickY2 = std::max(top, bottom);
    if (g_hNoteEdit) SetFocus(g_hNoteEdit);
    SendMessageW(g_hPdfView, WM_LBUTTONUP, 0, MAKELPARAM(12, 12));

    if (g_pdf.editingText || g_pdf.editSelectingText) {
        restore();
        if (outError) *outError = L"Triple-click copy did not end active PDF textbox editing.";
        return false;
    }
    if (GetFocus() != g_hPdfView) {
        restore();
        if (outError) *outError = L"Triple-click copy after active edit did not focus the PDF view.";
        return false;
    }
    bool foundCommitted = false;
    for (const auto& ann : g_annots) {
        if (ann.type == Annotation::Type::TextBox && ann.text == activeToken) {
            foundCommitted = true;
            break;
        }
    }
    if (!foundCommitted) {
        restore();
        if (outError) *outError = L"Triple-click copy ended active edit without committing the textbox text.";
        return false;
    }

    restore();
    return true;
}
static bool RunUiAutomationPendingLinkCancelStageScenario(HWND owner, std::wstring* outError) {
    if (!owner || g_pdf.kind != DocKind::Pdf || CurrentLogicalPdfPath().empty() || !g_hPdfView) {
        if (outError) *outError = L"Pending-link cancel automation requires an open PDF document.";
        return false;
    }
    if (!file_output::DiscardAllStagedDiffs(owner)) {
        if (outError) *outError = L"Failed to clear staged diffs before pending-link cancel automation.";
        return false;
    }

    const std::wstring pdfPath = CurrentLogicalPdfPath();
    const std::vector<Annotation> originalAnnots = g_annots;
    const bool originalAnnotsDirty = g_annotsDirty;
    const bool originalAnnotsNeedsIntegrate = g_annotsNeedsIntegrate;
    const LinkPending originalLinkPending = g_linkPending;

    const std::wstring linkId = L"ui-automation-pending-link-cancel-stage";
    Annotation marker;
    marker.type = Annotation::Type::LinkMarker;
    marker.pageIndex = 0;
    marker.x1 = 16.0;
    marker.y1 = 16.0;
    marker.x2 = 16.0;
    marker.y2 = 16.0;
    marker.width = 6.0;
    marker.color = RGB(40, 40, 40);
    marker.linkId = linkId;
    g_annots.push_back(marker);

    g_linkPending = {};
    g_linkPending.active = true;
    g_linkPending.id = linkId;
    g_linkPending.havePdf = true;
    g_linkPending.pdfPoints = 1;
    g_linkPending.pdfPage = 0;
    g_linkPending.pdfAnnotIndex = static_cast<int>(g_annots.size()) - 1;
    RememberPendingLinkPdfPath(pdfPath);
    UpdateLinkModeButtonState(true);

    CancelPendingLinkMode(owner);
    if (g_linkPending.active) {
        g_annots = originalAnnots;
        g_annotsDirty = originalAnnotsDirty;
        g_annotsNeedsIntegrate = originalAnnotsNeedsIntegrate;
        g_linkPending = originalLinkPending;
        UpdateLinkModeButtonState(originalLinkPending.active);
        if (outError) *outError = L"Pending link mode stayed active after cancellation.";
        return false;
    }
    for (const auto& ann : g_annots) {
        if (ann.type == Annotation::Type::LinkMarker && ann.linkId == linkId) {
            g_annots = originalAnnots;
            g_annotsDirty = originalAnnotsDirty;
            g_annotsNeedsIntegrate = originalAnnotsNeedsIntegrate;
            g_linkPending = originalLinkPending;
            UpdateLinkModeButtonState(originalLinkPending.active);
            if (outError) *outError = L"Pending PDF link marker remained in memory after cancellation.";
            return false;
        }
    }
    if (!g_annotsDirty || !g_annotsNeedsIntegrate) {
        g_annots = originalAnnots;
        g_annotsDirty = originalAnnotsDirty;
        g_annotsNeedsIntegrate = originalAnnotsNeedsIntegrate;
        g_linkPending = originalLinkPending;
        UpdateLinkModeButtonState(originalLinkPending.active);
        if (outError) *outError = L"Pending link cancellation did not mark annotations dirty for staging.";
        return false;
    }
    if (!SaveAnnotationsIfDirty(owner)) {
        g_annots = originalAnnots;
        g_annotsDirty = originalAnnotsDirty;
        g_annotsNeedsIntegrate = originalAnnotsNeedsIntegrate;
        g_linkPending = originalLinkPending;
        UpdateLinkModeButtonState(originalLinkPending.active);
        if (outError) *outError = L"Pending link cancellation could not be saved to stage.";
        return false;
    }

    const std::filesystem::path stagePath = file_output::FindLatestStagedClropPathForPdf(pdfPath);
    if (stagePath.empty()) {
        g_annots = originalAnnots;
        g_annotsDirty = originalAnnotsDirty;
        g_annotsNeedsIntegrate = originalAnnotsNeedsIntegrate;
        g_linkPending = originalLinkPending;
        UpdateLinkModeButtonState(originalLinkPending.active);
        if (outError) *outError = L"Pending link cancellation did not create a staged clrop diff.";
        return false;
    }

    std::vector<Annotation> stagedAnnots;
    bool mismatch = false;
    std::wstring err;
    if (!clrop_bridge::LoadAnnotations(stagePath.wstring(), pdfPath, stagedAnnots, mismatch, nullptr, err,
                                       clrop_bridge::LoadAnnotationsValidation::None)) {
        g_annots = originalAnnots;
        g_annotsDirty = originalAnnotsDirty;
        g_annotsNeedsIntegrate = originalAnnotsNeedsIntegrate;
        g_linkPending = originalLinkPending;
        UpdateLinkModeButtonState(originalLinkPending.active);
        if (outError) *outError = L"Failed to load staged clrop after pending link cancellation.";
        return false;
    }
    for (const auto& ann : stagedAnnots) {
        if (ann.type == Annotation::Type::LinkMarker && ann.linkId == linkId) {
            g_annots = originalAnnots;
            g_annotsDirty = originalAnnotsDirty;
            g_annotsNeedsIntegrate = originalAnnotsNeedsIntegrate;
            g_linkPending = originalLinkPending;
            UpdateLinkModeButtonState(originalLinkPending.active);
            if (outError) *outError = L"Canceled pending link marker remained in staged clrop.";
            return false;
        }
    }

    g_annots = originalAnnots;
    g_annotsDirty = originalAnnotsDirty;
    g_annotsNeedsIntegrate = originalAnnotsNeedsIntegrate;
    g_linkPending = originalLinkPending;
    UpdateLinkModeButtonState(originalLinkPending.active);
    file_output::DiscardAllStagedDiffs(owner);
    RefreshAnnotPanel();
    if (g_hPdfView) InvalidateRect(g_hPdfView, nullptr, FALSE);
    RefreshMainWindowUiState(owner);
    return true;
}

static bool RunUiAutomationExitBoundaryCommitScenario(HWND owner, std::wstring* outError) {
    if (!owner || g_currentNotePath.empty() || !g_hNoteEdit ||
        g_pdf.kind != DocKind::Pdf || CurrentLogicalPdfPath().empty() ||
        !g_hPdfView || g_pdf.pages.empty()) {
        if (outError) *outError = L"Exit boundary automation requires an open note and PDF.";
        return false;
    }
    if (!file_output::DiscardAllStagedDiffs(owner)) {
        if (outError) *outError = L"Failed to clear staged diffs before exit boundary automation.";
        return false;
    }

    const std::wstring notePath = g_currentNotePath;
    const std::wstring noteToken = L"ui-automation-exit-note-commit-token";
    InsertSnippetIntoNoteAt(GetNoteAutomationIndexingText().size(), noteToken);
    if (FindNoteTextSnippetStart(noteToken) < 0) {
        if (outError) *outError = L"Failed to insert the exit-boundary note token.";
        return false;
    }

    const std::vector<Annotation> originalAnnots = g_annots;
    const bool originalAnnotsDirty = g_annotsDirty;
    const bool originalAnnotsNeedsIntegrate = g_annotsNeedsIntegrate;

    const std::wstring pdfToken = L"ui automation exit pdf textbox commit";
    const auto& page = g_pdf.pages.front();
    const double left = std::clamp(36.0, 0.0, std::max(36.0, page.widthPt - 72.0));
    const double right = std::min(page.widthPt, left + 190.0);
    const double top = std::max(48.0, std::min(page.heightPt, 136.0));
    const double bottom = std::max(0.0, top - 32.0);

    g_pdf.editingText = true;
    g_pdf.editPage = 0;
    g_pdf.editX1 = left;
    g_pdf.editX2 = right;
    g_pdf.editY1 = top;
    g_pdf.editY2 = bottom;
    g_pdf.editText = pdfToken;
    g_pdf.editCaret = g_pdf.editText.size();
    g_pdf.editSelStart = g_pdf.editCaret;
    g_pdf.editSelEnd = g_pdf.editCaret;
    g_pdf.editSelectingText = false;
    g_pdf.editSelAnchor = g_pdf.editCaret;
    g_pdf.editLayoutDirty = true;
    g_pdf.editInnerLayoutW = 0;
    g_pdf.editLayout.lines.clear();
    g_pdf.editFontName = g_textFontName;
    g_pdf.editFontPt = (g_textFontPt > 0.0) ? g_textFontPt : 12.0;
    g_pdf.imeComp.clear();
    g_pdf.imeComposing = false;
    g_annotsDirty = false;
    g_annotsNeedsIntegrate = false;

    if (!CommitActiveEditsForAppExit(owner)) {
        if (outError) *outError = L"Exit boundary failed to commit active edits.";
        return false;
    }
    if (FindNoteTextSnippetStart(noteToken) < 0) {
        if (outError) *outError = L"Exit boundary lost the note edit token.";
        return false;
    }
    if (CountUiAutomationStagesForTarget(file_output::StagedDiffKind::Note, notePath) == 0) {
        if (outError) *outError = L"Exit boundary did not stage the note edit.";
        return false;
    }
    if (g_pdf.editingText) {
        if (outError) *outError = L"Exit boundary did not end PDF text editing.";
        return false;
    }

    bool foundPdfTextbox = false;
    for (const auto& ann : g_annots) {
        if (ann.type == Annotation::Type::TextBox && ann.text == pdfToken) {
            foundPdfTextbox = true;
            break;
        }
    }
    if (!foundPdfTextbox) {
        if (outError) *outError = L"Exit boundary did not commit the PDF text box.";
        return false;
    }
    if (!g_annotsDirty || !g_annotsNeedsIntegrate) {
        if (outError) *outError = L"Exit-boundary PDF text box did not mark annotations dirty.";
        return false;
    }

    g_annots = originalAnnots;
    g_annotsDirty = originalAnnotsDirty;
    g_annotsNeedsIntegrate = originalAnnotsNeedsIntegrate;
    if (g_hPdfView) InvalidateRect(g_hPdfView, nullptr, FALSE);

    return CleanupUiAutomationNoteToken(owner, notePath, noteToken, outError);
}
static bool RunUiAutomationNoteRollbackScenario(HWND owner, std::wstring* outError) {
    const std::wstring lecturePath = g_currentLecturePath;
    const std::wstring sessionPath = g_currentSessionPath;
    const std::wstring pdfPath = CurrentLogicalPdfPath();
    const std::wstring notePath = g_currentNotePath;
    const int pdfIndex = CurrentPdfIndex();
    const int noteIndex = CurrentNoteIndex();
    const int altNoteIndex = FindAlternativeFileIndex(g_hNoteList, noteIndex);
    if (altNoteIndex < 0) {
        if (outError) *outError = L"Could not find an alternate note for rollback testing.";
        return false;
    }
    if (!SetFaultInjectionPointForAutomation(L"OnNoteSelChange:start")) {
        if (outError) *outError = L"Failed to enable fault injection for note rollback scenario.";
        return false;
    }
    SetListboxSelAndNotify(g_hNoteList, altNoteIndex);
    ClearFaultInjectionPointForAutomation();
    return VerifyUiRollbackState(lecturePath, sessionPath, pdfPath, notePath, pdfIndex, noteIndex, outError);
}

static bool RunUiAutomationPdfRollbackScenario(HWND owner, std::wstring* outError) {
    const std::wstring lecturePath = g_currentLecturePath;
    const std::wstring sessionPath = g_currentSessionPath;
    const std::wstring pdfPath = CurrentLogicalPdfPath();
    const std::wstring notePath = g_currentNotePath;
    const int pdfIndex = CurrentPdfIndex();
    const int noteIndex = CurrentNoteIndex();
    const int altPdfIndex = FindAlternativeFileIndex(g_hPdfList, pdfIndex);
    if (altPdfIndex < 0) {
        if (outError) *outError = L"Could not find an alternate PDF for rollback testing.";
        return false;
    }
    if (!SetFaultInjectionPointForAutomation(L"OnPdfSelChange:start")) {
        if (outError) *outError = L"Failed to enable fault injection for PDF rollback scenario.";
        return false;
    }
    SetListboxSelAndNotify(g_hPdfList, altPdfIndex);
    ClearFaultInjectionPointForAutomation();
    return VerifyUiRollbackState(lecturePath, sessionPath, pdfPath, notePath, pdfIndex, noteIndex, outError);
}

bool RunUiAutomationStartupLastOpenScenario(HWND owner, std::wstring* outError) {
    if (!owner) {
        if (outError) *outError = L"Main window is not ready for startup restore testing.";
        return false;
    }
    const std::wstring lecturePath = g_currentLecturePath;
    const std::wstring sessionPath = g_currentSessionPath;
    const int altPdfIndex = FindAlternativeFileIndex(g_hPdfList, CurrentPdfIndex());
    const int altNoteIndex = FindAlternativeFileIndex(g_hNoteList, CurrentNoteIndex());
    if (altPdfIndex < 0 || altNoteIndex < 0) {
        if (outError) *outError = L"Could not find alternate files for startup restore testing.";
        return false;
    }

    SetListboxSelAndNotify(g_hPdfList, altPdfIndex);
    SetListboxSelAndNotify(g_hNoteList, altNoteIndex);

    const std::wstring expectedPdfPath = CurrentLogicalPdfPath();
    const std::wstring expectedNotePath = g_currentNotePath;
    const int expectedPdfIndex = CurrentPdfIndex();
    const int expectedNoteIndex = CurrentNoteIndex();
    if (expectedPdfPath.empty() || expectedNotePath.empty()) {
        if (outError) *outError = L"Failed to open alternate files for startup restore testing.";
        return false;
    }

    OnWorkspaceLoaded(owner);
    const std::wstring previousAutoOpenMode = g_config.sessionAutoOpenMode;

    g_config.sessionAutoOpenMode = L"off";
    const bool selectedOnlyRestored = RestoreStartupLastOpenSelection(owner);
    if (!selectedOnlyRestored) {
        g_config.sessionAutoOpenMode = previousAutoOpenMode;
        if (outError) *outError = L"Startup restore did not restore the last session in selection-only mode.";
        return false;
    }
    const int selectedOnlyPdfIndex = static_cast<int>(SendMessageW(g_hPdfList, LB_GETCURSEL, 0, 0));
    const int selectedOnlyNoteIndex = static_cast<int>(SendMessageW(g_hNoteList, LB_GETCURSEL, 0, 0));
    if (selectedOnlyPdfIndex != expectedPdfIndex || selectedOnlyNoteIndex != expectedNoteIndex) {
        g_config.sessionAutoOpenMode = previousAutoOpenMode;
        if (outError) *outError = L"Startup restore did not select the last-open PDF/Note when auto-open was off.";
        return false;
    }

    g_config.sessionAutoOpenMode = L"view";
    const bool restored = RestoreStartupLastOpenSelection(owner);
    g_config.sessionAutoOpenMode = previousAutoOpenMode;
    if (!restored) {
        if (outError) *outError = L"Startup restore did not reopen the last session.";
        return false;
    }

    return VerifyUiRollbackState(lecturePath, sessionPath,
                                 expectedPdfPath, expectedNotePath,
                                 expectedPdfIndex, expectedNoteIndex,
                                 outError);
}


bool PrepareUiAutomationStagedExitScenario(HWND owner, std::wstring* outError) {
    if (!owner || g_currentNotePath.empty() || !g_hNoteEdit) {
        if (outError) *outError = L"Staged-exit automation requires an open note editor.";
        return false;
    }
    if (!file_output::DiscardAllStagedDiffs(owner)) {
        if (outError) *outError = L"Failed to clear staged diffs before staged-exit automation.";
        return false;
    }

    const std::wstring notePath = g_currentNotePath;
    const std::wstring token = L"ui-automation-staged-exit-token";
    InsertSnippetIntoNoteAt(GetNoteAutomationIndexingText().size(), token);
    if (FindNoteTextSnippetStart(token) < 0) {
        if (outError) *outError = L"Failed to insert the staged-exit note token.";
        return false;
    }
    if (!SaveNoteIfDirty(owner)) {
        if (outError) *outError = L"Failed to stage the note for exit automation.";
        return false;
    }
    if (CountUiAutomationStagesForTarget(file_output::StagedDiffKind::Note, notePath) == 0) {
        if (outError) *outError = L"Staged-exit automation did not leave a note stage.";
        return false;
    }
    return true;
}

static BOOL CALLBACK FindUiAutomationSoftNoticeProc(HWND window, LPARAM result) {
    wchar_t className[64]{};
    if (GetClassNameW(window, className, static_cast<int>(std::size(className))) &&
        wcscmp(className, L"PdfWorkspaceSoftNotice") == 0) {
        *reinterpret_cast<HWND*>(result) = window;
        return FALSE;
    }
    return TRUE;
}

static HWND FindUiAutomationSoftNoticeWindow() {
    HWND result = nullptr;
    // Never inspect the normal application instance's notice during testing.
    EnumThreadWindows(GetCurrentThreadId(), FindUiAutomationSoftNoticeProc,
                      reinterpret_cast<LPARAM>(&result));
    return result;
}

// Exercises the same commands and keyboard-routing function as the left
// input palette. Edits stay in the runner's disposable note and are undone.
[[nodiscard]] static bool RunUiAutomationInputAssistScenario(HWND owner, std::wstring* outError) {
    const std::wstring original = GetNoteAutomationIndexingText();
    const std::wstring previousBody = GetShortcutBodyInput();
    const std::vector<HWND> checks = {g_hChkShortcutHeading1, g_hChkShortcutBack,
        g_hChkShortcutChar, g_hChkShortcutBold, g_hChkShortcutItalic,
        g_hChkShortcutStrike, g_hChkShortcutUnderline};
    std::vector<LRESULT> savedChecks;
    for (HWND control : checks) {
        savedChecks.push_back(SendMessageW(control, BM_GETCHECK, 0, 0));
        SendMessageW(control, BM_SETCHECK, BST_UNCHECKED, 0);
    }
    const std::vector<HWND> fields = {g_hShortcutIndentEdit, g_hShortcutMarginEdit, g_hShortcutFontSizeEdit};
    std::vector<std::wstring> savedFields;
    for (HWND control : fields) {
        const int length = GetWindowTextLengthW(control);
        std::wstring value(static_cast<size_t>(length) + 1, L'\0');
        value.resize(static_cast<size_t>(GetWindowTextW(control, value.data(), length + 1)));
        savedFields.push_back(std::move(value));
        SetWindowTextW(control, L"");
    }
    const auto restorePalette = [&]() {
        for (size_t i = 0; i < checks.size(); ++i) SendMessageW(checks[i], BM_SETCHECK, savedChecks[i], 0);
        for (size_t i = 0; i < fields.size(); ++i) SetWindowTextW(fields[i], savedFields[i].c_str());
        SetWindowTextW(g_hShortcutTagEdit, previousBody.c_str());
    };
    const auto fail = [&](const wchar_t* message) {
        restorePalette();
        if (outError) *outError = message;
        return false;
    };
    const std::wstring body = L"input assist 日本語\x3000text";
    SetWindowTextW(g_hShortcutTagEdit, body.c_str());
    if (GetShortcutBodyInput() != body) return fail(L"Input assist removed spaces from the typed body.");
    SendMessageW(g_hChkShortcutBold, BM_SETCHECK, BST_CHECKED, 0);
    const DWORD originalEnd = static_cast<DWORD>(original.size());
    SendMessageW(g_hNoteEdit, EM_SETSEL, originalEnd, originalEnd);
    SetFocus(g_hShortcutTagEdit);
    MSG enter{};
    enter.hwnd = g_hShortcutTagEdit;
    enter.message = WM_KEYDOWN;
    enter.wParam = VK_RETURN;
    SendMessageW(g_hShortcutTagEdit, WM_IME_STARTCOMPOSITION, 0, 0);
    const bool imeKeptEnter = !HandleNoteAssistShortcutInLoop(owner, enter);
    SendMessageW(owner, WM_COMMAND, MAKEWPARAM(ID_NOTE_SHORTCUT_INPUT, 0), 0);
    const bool imeKeptBody = GetShortcutBodyInput() == body && GetNoteAutomationIndexingText() == original;
    SendMessageW(g_hShortcutTagEdit, WM_IME_ENDCOMPOSITION, 0, 0);
    if (!imeKeptEnter || !imeKeptBody) return fail(L"Input assist consumed an active empty-payload IME composition.");
    if (!HandleNoteAssistShortcutInLoop(owner, enter)) return fail(L"Input assist Enter route was not handled.");
    const std::wstring inserted = original + L"**" + body + L"**";
    if (GetNoteAutomationIndexingText() != inserted || !GetShortcutBodyInput().empty() ||
        GetFocus() != g_hNoteEdit) return fail(L"Input assist did not apply Markdown or return focus without adding a newline.");
    if (!SendUiAutomationNoteMenuUndoRedoChangedText(owner, true) || GetNoteAutomationIndexingText() != original ||
        !SendUiAutomationNoteMenuUndoRedoChangedText(owner, false) || GetNoteAutomationIndexingText() != inserted)
        return fail(L"Input assist typed insertion did not survive menu undo/redo.");

    // With no typed override, only the selected native range is formatted.
    SendMessageW(g_hChkShortcutBold, BM_SETCHECK, BST_UNCHECKED, 0);
    SendMessageW(g_hChkShortcutItalic, BM_SETCHECK, BST_CHECKED, 0);
    SendMessageW(g_hNoteEdit, EM_SETSEL, originalEnd + 2, originalEnd + 2 + body.size());
    SendMessageW(owner, WM_COMMAND, MAKEWPARAM(ID_NOTE_SHORTCUT_INPUT, 0), 0);
    if (GetNoteAutomationIndexingText() != original + L"***" + body + L"***" ||
        !SendUiAutomationNoteMenuUndoRedoChangedText(owner, true) || GetNoteAutomationIndexingText() != inserted ||
        !SendUiAutomationNoteMenuUndoRedoChangedText(owner, true) || GetNoteAutomationIndexingText() != original)
        return fail(L"Input assist selection formatting or undo changed surrounding note text.");

    // No body and no selection must preserve the document rather than inserting
    // a placeholder. Plain/TeX formatting must preserve the typed body too.
    SendMessageW(g_hNoteEdit, EM_SETSEL, originalEnd, originalEnd);
    SendMessageW(owner, WM_COMMAND, MAKEWPARAM(ID_NOTE_SHORTCUT_INPUT, 0), 0);
    HWND emptyInputNotice = FindUiAutomationSoftNoticeWindow();
    if (GetNoteAutomationIndexingText() != original || !emptyInputNotice || !IsWindowVisible(emptyInputNotice))
        return fail(L"Empty input assist did not preserve the note or show its guidance.");
    // A new invalid attempt must still explain what to do, even within the
    // repeat-suppression interval of the notice just dismissed by the command.
    SendMessageW(owner, WM_COMMAND, MAKEWPARAM(ID_NOTE_SHORTCUT_INPUT, 0), 0);
    if (!IsWindowVisible(emptyInputNotice)) return fail(L"Repeated empty Apply lost its guidance.");
    DismissSoftNotice(nullptr, localization::Text(L"note.input_assist.need_body"));
    if (!IsWindowVisible(emptyInputNotice)) return fail(L"Another owner dismissed input assist guidance.");
    // Simulate a queued expiry belonging to the previous notice. The timer
    // ledger in SoftNoticeProc reserves 0x5E10 for this expiry only.
    SendMessageW(emptyInputNotice, WM_TIMER, 0x5E10, 0);
    if (!IsWindowVisible(emptyInputNotice)) return fail(L"A stale timer hid fresh input assist guidance.");
    const ULONGLONG expiryTimeout = GetTickCount64() + 5000;
    while (IsWindowVisible(emptyInputNotice) && GetTickCount64() < expiryTimeout) {
        MSG timer{};
        while (PeekMessageW(&timer, emptyInputNotice, WM_TIMER, WM_TIMER, PM_REMOVE)) {
            DispatchMessageW(&timer);
        }
        Sleep(10);
    }
    if (IsWindowVisible(emptyInputNotice)) return fail(L"Input assist guidance did not expire automatically.");
    // The automatic expiry may retain suppression; an explicit Apply clears
    // only the matching guidance and makes this fresh attempt visible.
    SendMessageW(owner, WM_COMMAND, MAKEWPARAM(ID_NOTE_SHORTCUT_INPUT, 0), 0);
    if (!IsWindowVisible(emptyInputNotice)) return fail(L"Apply after expiry lost its guidance.");
    SetWindowTextW(g_hShortcutTagEdit, body.c_str());
    if (IsWindowVisible(emptyInputNotice))
        return fail(L"Input assist guidance remained visible after body input.");
    const std::wstring unrelatedNotice = L"Input assist test: unrelated warning";
    ShowSoftNotice(owner, unrelatedNotice, SoftNoticeKind::Warning);
    SetWindowTextW(g_hShortcutTagEdit, body.c_str());
    const bool unrelatedPreserved = IsWindowVisible(emptyInputNotice) != FALSE;
    DismissSoftNotice(owner, unrelatedNotice);
    if (!unrelatedPreserved) return fail(L"Input assist body input dismissed an unrelated warning.");
    const std::wstring savedPath = g_currentNotePath;
    g_currentNotePath = L"input_assist.txt";
    SendMessageW(owner, WM_COMMAND, MAKEWPARAM(ID_NOTE_SHORTCUT_INPUT, 0), 0);
    const bool plainPreserved = GetNoteAutomationIndexingText() == original && GetShortcutBodyInput() == body;
    g_currentNotePath = savedPath;
    if (!plainPreserved) return fail(L"Plain-text input assist generated uninterpreted formatting or discarded the body.");
    SendMessageW(g_hChkShortcutItalic, BM_SETCHECK, BST_UNCHECKED, 0);
    const std::wstring savedSession = g_currentSessionPath;
    g_currentNotePath.clear();
    g_currentSessionPath.clear();
    SendMessageW(owner, WM_COMMAND, MAKEWPARAM(ID_NOTE_SHORTCUT_INPUT, 0), 0);
    const bool noNotePreserved = GetNoteAutomationIndexingText() == original && GetShortcutBodyInput() == body;
    g_currentNotePath = savedPath;
    g_currentSessionPath = savedSession;
    if (!noNotePreserved) return fail(L"Input assist discarded the typed body without an open note.");
    const LRESULT savedLimit = SendMessageW(g_hNoteEdit, EM_GETLIMITTEXT, 0, 0);
    SendMessageW(g_hNoteEdit, EM_EXLIMITTEXT, 0, originalEnd);
    SendMessageW(g_hNoteEdit, EM_SETSEL, 1, 3);
    SendMessageW(owner, WM_COMMAND, MAKEWPARAM(ID_NOTE_SHORTCUT_INPUT, 0), 0);
    DWORD failedStart = 0, failedEnd = 0;
    SendMessageW(g_hNoteEdit, EM_GETSEL,
        reinterpret_cast<WPARAM>(&failedStart), reinterpret_cast<LPARAM>(&failedEnd));
    const bool limitPreserved = GetNoteAutomationIndexingText() == original && GetShortcutBodyInput() == body &&
        failedStart == 1 && failedEnd == 3;
    bool blockLimitPreserved = true;
    for (const int command : {ID_NOTE_ASSIST_BULLET, ID_NOTE_ASSIST_QUOTE}) {
        SendMessageW(owner, WM_COMMAND, MAKEWPARAM(command, 0), 0);
        SendMessageW(g_hNoteEdit, EM_GETSEL,
            reinterpret_cast<WPARAM>(&failedStart), reinterpret_cast<LPARAM>(&failedEnd));
        blockLimitPreserved = blockLimitPreserved && GetNoteAutomationIndexingText() == original &&
            GetShortcutBodyInput() == body && failedStart == 1 && failedEnd == 3;
    }
    SendMessageW(g_hNoteEdit, EM_EXLIMITTEXT, 0, savedLimit);
    if (!limitPreserved) return fail(L"Input assist text-limit failure lost input, selection or note text.");
    if (!blockLimitPreserved) return fail(L"Bullet/quote text-limit failure lost input, selection or note text.");

    SendMessageW(g_hNoteEdit, EM_SETSEL, originalEnd, originalEnd);
    SendMessageW(owner, WM_COMMAND, MAKEWPARAM(ID_NOTE_ASSIST_BULLET, 0), 0);
    const std::wstring blockBoundary = !original.empty() && original.back() != L'\r' && original.back() != L'\n'
        ? L"\r" : L"";
    if (GetNoteAutomationIndexingText() != original + blockBoundary + L"- " + body ||
        !GetShortcutBodyInput().empty() || !SendUiAutomationNoteMenuUndoRedoChangedText(owner, true) ||
        GetNoteAutomationIndexingText() != original) return fail(L"Input assist bullet did not use the body field or preserve undo.");
    SendMessageW(g_hNoteEdit, EM_SETSEL, 0, 0);
    SendMessageW(owner, WM_COMMAND, MAKEWPARAM(ID_NOTE_ASSIST_QUOTE, 0), 0);
    DWORD markerStart = 0, markerEnd = 0;
    SendMessageW(g_hNoteEdit, EM_GETSEL,
        reinterpret_cast<WPARAM>(&markerStart), reinterpret_cast<LPARAM>(&markerEnd));
    if (GetNoteAutomationIndexingText() != L"> \r" + original || markerStart != 2 || markerEnd != 2 ||
        !SendUiAutomationNoteMenuUndoRedoChangedText(owner, true) || GetNoteAutomationIndexingText() != original)
        return fail(L"Empty quote assist did not leave the caret after the marker or preserve undo.");

    // Editing/undo defers semantic publication. Finish the same refresh used
    // by normal UI updates, then verify the restored note is still renderable.
    RecomputeMathFromNote();
    const auto restoredNote = CaptureNoteUiSnapshot();
    if (!restoredNote.markdownRoute || !restoredNote.documentReady || !restoredNote.finalFrameActive)
        return fail(L"Input assist undo could not publish the restored Markdown note.");
    restorePalette();
    AppendUiAutomationTrace(L"input_assist:spaces_markdown_enter_selection_undo_ok");
    return true;
}

static bool RunUiAutomationMathRenderScenario(HWND owner, std::wstring* outError,
                                             bool renderedClickOnly) {
    AppendUiAutomationTrace(L"math_render:begin");
    if (!owner) {
        if (outError) *outError = L"Main window is not ready for math render testing.";
        return false;
    }
    const std::wstring previousNotePath = g_currentNotePath;
    const int previousNoteIndex = CurrentNoteIndex();
    const bool previousRenderEnabled = g_noteRenderEnabled;
    const bool previousRawOnly = g_noteRawOnly;
    const std::filesystem::path mathNotePath =
        std::filesystem::path(g_currentSessionPath) / L"note_math.md";
    std::error_code mathNoteEc;
    const bool mathNoteExists = std::filesystem::exists(mathNotePath, mathNoteEc);
    if (mathNoteEc || !mathNoteExists) {
        if (outError) *outError = L"Math UI automation fixture note was not found.";
        return false;
    }

    auto restorePrevious = [&]() {
        g_noteRenderEnabled = previousRenderEnabled;
        g_noteRawOnly = previousRawOnly;
        std::wstring ignored;
        RestoreUiAutomationNoteSelection(owner, previousNotePath, previousNoteIndex, &ignored);
        RefreshBottomPaneView();
        RefreshMainWindowUiState(owner);
    };

    g_noteRenderEnabled = true;
    g_noteRawOnly = false;
    AppendUiAutomationTrace(L"math_render:before_load_fixture");
    LoadNoteFile(owner, mathNotePath.wstring());
    AppendUiAutomationTrace(L"math_render:after_load_fixture");
    SyncBottomPaneAfterNoteLoad(owner);
    SyncLeftPaneSelection();

    if (NormalizePathKey(g_currentNotePath) != NormalizePathKey(mathNotePath.wstring())) {
        restorePrevious();
        if (outError) *outError = L"Failed to open the math fixture note.";
        return false;
    }

    RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
    const NoteUiSnapshot initial = CaptureNoteUiSnapshot();
    // Passive input at the lower boundary must preserve viewport, selection,
    // final ownership and source identity. Observe both message completion
    // and paint: later layout must not conceal a transient native fallback.
    const auto verifyBottomScrollBoundary = [&](int windowCommand, bool assist) -> bool {
        SendMessageW(g_hNoteEdit, WM_VSCROLL, SB_BOTTOM, 0);
        RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
        const auto before = CaptureNoteUiSnapshot();
        const auto beforeRuntime = ObserveNoteRenderRuntime();
        SCROLLINFO baseline{};
        baseline.cbSize = sizeof(baseline);
        baseline.fMask = SIF_RANGE | SIF_PAGE | SIF_POS;
        DWORD selectionStart = 0, selectionEnd = 0;
        SendMessageW(g_hNoteEdit, EM_GETSEL, reinterpret_cast<WPARAM>(&selectionStart),
                     reinterpret_cast<LPARAM>(&selectionEnd));
        bool valid = before.finalFrameActive && GetScrollInfo(g_hNoteEdit, SB_VERT, &baseline) &&
            baseline.nPos == std::max(0, baseline.nMax - static_cast<int>(baseline.nPage) + 1);
        const std::pair<UINT, WPARAM> inputs[] = {
            {WM_MOUSEWHEEL, MAKEWPARAM(0, static_cast<WORD>(-WHEEL_DELTA))},
            {WM_MOUSEWHEEL, MAKEWPARAM(0, static_cast<WORD>(-WHEEL_DELTA / 8))},
            {WM_VSCROLL, SB_LINEDOWN}, {WM_VSCROLL, SB_PAGEDOWN}, {WM_VSCROLL, SB_BOTTOM}
        };
        const auto unchanged = [&]() {
            SCROLLINFO current = baseline;
            DWORD start = 0, end = 0;
            SendMessageW(g_hNoteEdit, EM_GETSEL, reinterpret_cast<WPARAM>(&start), reinterpret_cast<LPARAM>(&end));
            const auto runtime = ObserveNoteRenderRuntime();
            return GetScrollInfo(g_hNoteEdit, SB_VERT, &current) &&
                current.nMin == baseline.nMin && current.nMax == baseline.nMax &&
                current.nPage == baseline.nPage && current.nPos == baseline.nPos &&
                start == selectionStart && end == selectionEnd && runtime.finalFrameActive &&
                runtime.canonicalRevision == beforeRuntime.canonicalRevision &&
                runtime.modelMaterializations == beforeRuntime.modelMaterializations &&
                runtime.nativeFallbackPaintCount == beforeRuntime.nativeFallbackPaintCount;
        };
        for (int pass = 0; pass < 8 && valid; ++pass) {
            for (const auto& input : inputs) {
                SendMessageW(g_hNoteEdit, input.first, input.second, 0);
                valid = unchanged();
                if (!valid) break;
            }
            if (!valid) break;
            SendMessageW(g_hNoteEdit, WM_MOUSEMOVE, 0, MAKELPARAM(16 + pass, 16));
            valid = unchanged();
            RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
            valid = unchanged() && valid;
        }
        const auto after = CaptureNoteUiSnapshot();
        valid = valid && after.finalFrameActive && after.canonicalText == before.canonicalText &&
            after.finalRawLineCount == before.finalRawLineCount &&
            after.finalStructuredLineCount == before.finalStructuredLineCount &&
            EqualRect(&after.finalCaretClientRect, &before.finalCaretClientRect) &&
            (GetFocus() != g_hNoteEdit || after.systemCaretMatchesFinal);
        AppendUiAutomationTrace(L"math_render:bottom_boundary command=" + std::to_wstring(windowCommand) +
            L" assist=" + std::to_wstring(assist) + L" focused=" + std::to_wstring(GetFocus() == g_hNoteEdit) +
            L" lines=" + std::to_wstring(before.finalRawLineCount + before.finalStructuredLineCount) +
            L" valid=" + std::to_wstring(valid) + L" pos=" + std::to_wstring(baseline.nPos));
        return valid;
    };
    // Exercise the root layout, not just the edit's WM_SIZE. Maximization
    // also refreshes the bottom pane and paints all children synchronously.
    // No later input/paint may be needed to recover a missing publication.
    const auto verifyRootMaximizeRoundTrip = [&](bool verifyInput = false) -> bool {
        WINDOWPLACEMENT placement{};
        placement.length = sizeof(placement);
        if (!GetWindowPlacement(owner, &placement))
            return false;
        const HWND previousFocus = GetFocus();
        const auto previousMode = g_bottomNoteMode;
        const auto previousPin = g_bottomPanePin;
        bool valid = true;
        for (const auto mode : {BottomNoteMode::Legacy, BottomNoteMode::Assist}) {
            g_bottomNoteMode = mode;
            g_bottomPanePin = BottomPanePin::Note;
            ui::ApplyLayout(owner, ui::LayoutPass::Commit);
            RefreshBottomPaneView();
            for (HWND focus : {g_hNoteList, g_hNoteEdit}) {
                SetFocus(focus);
                for (int command : {SW_MAXIMIZE, SW_RESTORE}) {
                    const auto before = CaptureNoteUiSnapshot();
                    const auto beforeRuntime = ObserveNoteRenderRuntime();
                    ShowWindow(owner, command);
                    // Observe the persistent state too, after queued UI work and
                    // the whole layout tree's paint, not only SendMessage return.
                    MSG pending{};
                    for (int count = 0; count < 64 && PeekMessageW(&pending, nullptr, 0, 0, PM_REMOVE); ++count) {
                        if (pending.message == WM_QUIT) {
                            PostQuitMessage(static_cast<int>(pending.wParam));
                            valid = false;
                            break;
                        }
                        TranslateMessage(&pending);
                        DispatchMessageW(&pending);
                    }
                    RedrawWindow(owner, nullptr, nullptr, RDW_INVALIDATE | RDW_ALLCHILDREN | RDW_UPDATENOW);
                    const auto after = CaptureNoteUiSnapshot();
                    const auto afterRuntime = ObserveNoteRenderRuntime();
                    const bool stepValid =
                        after.finalFrameActive && after.finalStructuredLineCount > 0 &&
                        after.finalRawLineCount == before.finalRawLineCount &&
                        after.canonicalText == before.canonicalText &&
                        afterRuntime.canonicalRevision == beforeRuntime.canonicalRevision &&
                        afterRuntime.modelMaterializations == beforeRuntime.modelMaterializations &&
                        afterRuntime.nativeFallbackPaintCount == beforeRuntime.nativeFallbackPaintCount &&
                        afterRuntime.nativeRedrawDepth == 0 && afterRuntime.nativeRedrawRequested &&
                        (focus != g_hNoteEdit || after.systemCaretMatchesFinal);
                    AppendUiAutomationTrace(L"math_render:root_resize command=" + std::to_wstring(command) +
                                            L" assist=" + std::to_wstring(mode == BottomNoteMode::Assist) +
                                            L" focused=" + std::to_wstring(focus == g_hNoteEdit) + L" valid=" +
                                            std::to_wstring(stepValid) + L" final=" +
                                            std::to_wstring(after.finalFrameActive) + L" native_paints=" +
                                            std::to_wstring(afterRuntime.nativeFallbackPaintCount -
                                                            beforeRuntime.nativeFallbackPaintCount));
                    valid = stepValid && valid;
                    if (verifyInput && focus == g_hNoteEdit && command == SW_MAXIMIZE) {
                        const auto original = GetNoteAutomationIndexingText();
                        SendMessageW(g_hNoteEdit, WM_CHAR, L'q', 1);
                        const auto inserted = CaptureNoteUiSnapshot();
                        const bool insertionRestored =
                            SendUiAutomationNoteUndoChangedText() && GetNoteAutomationIndexingText() == original;
                        SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_BACK, 1);
                        SendMessageW(g_hNoteEdit, WM_CHAR, 8, 1);
                        SendMessageW(g_hNoteEdit, WM_KEYUP, VK_BACK, 0xC0000001);
                        const auto deleted = CaptureNoteUiSnapshot();
                        const bool deletionRestored =
                            SendUiAutomationNoteUndoChangedText() && GetNoteAutomationIndexingText() == original;
                        const bool inputValid = inserted.finalFrameActive && deleted.finalFrameActive &&
                                                inserted.canonicalText.size() == after.canonicalText.size() + 1 &&
                                                deleted.canonicalText.size() + 1 == after.canonicalText.size() &&
                                                insertionRestored && deletionRestored &&
                                                CaptureNoteUiSnapshot().finalFrameActive;
                        AppendUiAutomationTrace(L"math_render:maximized_input assist=" +
                                                std::to_wstring(mode == BottomNoteMode::Assist) + L" valid=" +
                                                std::to_wstring(inputValid));
                        valid = inputValid && valid;
                    }
                    valid = verifyBottomScrollBoundary(command, mode == BottomNoteMode::Assist) && valid;
                }
            }
        }
        g_bottomNoteMode = previousMode;
        g_bottomPanePin = previousPin;
        ui::ApplyLayout(owner, ui::LayoutPass::Commit);
        RefreshBottomPaneView();
        const bool restored = SetWindowPlacement(owner, &placement) != FALSE;
        if (previousFocus && IsWindow(previousFocus))
            SetFocus(previousFocus);
        return valid && restored;
    };
    AppendUiAutomationTrace(L"math_render:after_initial_snapshot");
    if (!initial.markdownRoute) {
        restorePrevious();
        if (outError) *outError = L"Math fixture note did not use the Markdown route.";
        return false;
    }
    if (!initial.documentReady) {
        restorePrevious();
        if (outError) *outError = L"Markdown note document was not ready for math fixture note.";
        return false;
    }
    if (!initial.finalFrameActive || initial.finalStructuredLineCount == 0 ||
        initial.finalRawLineCount != 0) {
        restorePrevious();
        if (outError) {
            *outError = L"A freshly opened rendered note did not publish one fully structured final frame. " +
                        DescribeNoteUiSnapshot(initial);
        }
        return false;
    }
    if (!verifyRootMaximizeRoundTrip()) {
        restorePrevious();
        if (outError) *outError = L"Root maximization/restore stranded a short note in native raw fallback.";
        return false;
    }
    // The real bundled sample crosses a raw/composed horizontal-scrollbar
    // threshold. Exercise opening first, then keyboard ownership and editing,
    // before returning to the math fixture with its opening view unchanged.
    const auto resizeSamplePath = std::filesystem::path(g_currentSessionPath) / L"note_resize_sample.clro";
    LoadNoteFile(owner, resizeSamplePath.wstring());
    SyncBottomPaneAfterNoteLoad(owner);
    const bool sampleOpened = NormalizePathKey(g_currentNotePath) == NormalizePathKey(resizeSamplePath.wstring()) &&
        CaptureNoteUiSnapshot().finalFrameActive;
    bool sampleValid = sampleOpened && verifyRootMaximizeRoundTrip();
    if (sampleValid) {
        SetFocus(g_hNoteEdit);
        SendMessageW(g_hNoteEdit, EM_SETSEL, 2, 2);
        SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_RIGHT, 1);
        SendMessageW(g_hNoteEdit, WM_KEYUP, VK_RIGHT, 0xC0000001);
        sampleValid = verifyRootMaximizeRoundTrip(true);
    }
    AppendUiAutomationTrace(L"math_render:bundled_resize_sample valid=" + std::to_wstring(sampleValid));
    if (!sampleValid) {
        restorePrevious();
        if (outError) *outError = L"The bundled sample lost final rendering or input after root maximization.";
        return false;
    }
    LoadNoteFile(owner, mathNotePath.wstring());
    SyncBottomPaneAfterNoteLoad(owner);
    SyncLeftPaneSelection();
    if (initial.mathSpanCount < 6) {
        restorePrevious();
        if (outError) {
            *outError = L"Expected six math spans, including named tags, in the math fixture note. " +
                        DescribeNoteUiSnapshot(initial);
        }
        return false;
    }
    if (initial.renderedMathSegmentCount < 6) {
        restorePrevious();
        if (outError) {
            *outError = L"Expected rendered math segments for all math delimiters. " +
                        DescribeNoteUiSnapshot(initial);
        }
        return false;
    }
    if (initial.renderedDisplayMathSegmentCount < 3) {
        restorePrevious();
        if (outError) {
            *outError = L"Expected rendered display-math segments for block delimiters. " +
                        DescribeNoteUiSnapshot(initial);
        }
        return false;
    }
    const std::wstring markdownStrongRendered = L"Bold marker regression";
    const std::wstring markdownStrongRawLeak = L"**Bold marker regression";
    if (initial.renderedText.find(markdownStrongRendered) == std::wstring::npos ||
        initial.renderedText.find(markdownStrongRawLeak) != std::wstring::npos) {
        restorePrevious();
        if (outError) {
            *outError = L"Markdown strong markers leaked into rendered note text. " +
                        DescribeNoteUiSnapshot(initial);
        }
        return false;
    }

    // Resolve test points from the published structured caret, then move the
    // transport caret elsewhere before clicking. Native EM_CHARFROMPOS is
    // deliberately not an oracle for these pixels (notably after math/table rows).
    const auto verifyRenderedClickInsertion = [&]() -> bool {
        const std::wstring original = GetNoteAutomationIndexingText();
        struct ClickProbe {
            std::wstring target;
            size_t geometryDelta = 0;
            size_t insertionDelta = 0;
            int blankOffset = 0;
        };
        std::vector<ClickProbe> probes;
        for (const std::wstring& target : {std::wstring(L"Math UI Fixture"),
                                          std::wstring(L"Bold marker regression"),
                                          std::wstring(L"value")}) {
            for (const size_t delta : {size_t{0}, size_t{2}}) {
                probes.push_back({target, delta, delta, 0});
            }
        }
        const std::wstring closingTarget = L"Closing tag 日本語";
        probes.push_back({closingTarget, closingTarget.size(), closingTarget.size(), 0});
        probes.push_back({closingTarget, closingTarget.size(),
                          closingTarget.size() + std::wstring_view(L"</i></b>").size(), 12});
        for (const auto& probe : probes) {
            const std::wstring& target = probe.target;
            const int start = FindNoteTextSnippetStart(target);
            if (start < 0) return false;
            const size_t expected = static_cast<size_t>(start) + probe.insertionDelta;
            const size_t geometryOffset = static_cast<size_t>(start) + probe.geometryDelta;
            // An unfocused note is structured even after an earlier edit.
            // The real click below must resolve before taking focus/raw ownership.
            SetFocus(owner);
            PreserveRenderedNoteOpeningView();
            SendMessageW(g_hNoteEdit, EM_SETSEL, geometryOffset, geometryOffset);
            RECT client{};
            GetClientRect(g_hNoteEdit, &client);
            // EM_SETSEL alone is a transport-only test operation. Complete
            // the existing unfocused layout event before observing its frame.
            SendMessageW(g_hNoteEdit, WM_SIZE, SIZE_RESTORED,
                         MAKELPARAM(client.right - client.left, client.bottom - client.top));
            RefreshBottomPaneView();
            RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
            NoteUiSnapshot structured = CaptureNoteUiSnapshot();
            if (!structured.finalFrameActive || structured.finalRawLineCount != 0 ||
                !structured.finalCaretGeometryReady) {
                AppendUiAutomationTrace(L"render_click:invalid_structured target=" + target +
                    L" " + DescribeNoteUiSnapshot(structured));
                return false;
            }
            // Block wrappers can put a formerly visible fixture target
            // below the viewport. Scroll the published geometry into view;
            // transport EM_SETSEL does not scroll an unfocused final frame.
            if (structured.finalCaretClientRect.top < client.top ||
                structured.finalCaretClientRect.bottom > client.bottom) {
                SendMessageW(g_hNoteEdit, WM_VSCROLL,
                    structured.finalCaretClientRect.top < client.top ? SB_TOP : SB_BOTTOM, 0);
                RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
                structured = CaptureNoteUiSnapshot();
                if (!structured.finalFrameActive || !structured.finalCaretGeometryReady) return false;
            }
            const RECT caret = structured.finalCaretClientRect;
            const int x = caret.left + probe.blankOffset;
            const int y = caret.top + (caret.bottom - caret.top) / 2;
            if (x < client.left || x >= client.right || y < client.top || y >= client.bottom) {
                AppendUiAutomationTrace(L"render_click:outside_viewport target=" + target +
                    L" point=" + std::to_wstring(x) + L":" + std::to_wstring(y));
                return false;
            }
            SendMessageW(g_hNoteEdit, EM_SETSEL, 0, 0);
            SendMessageW(g_hNoteEdit, WM_SIZE, SIZE_RESTORED,
                         MAKELPARAM(client.right - client.left, client.bottom - client.top));
            RefreshBottomPaneView();
            const LPARAM point = MAKELPARAM(x, y);
            SendMessageW(g_hNoteEdit, WM_LBUTTONDOWN, MK_LBUTTON, point);
            SendMessageW(g_hNoteEdit, WM_LBUTTONUP, 0, point);
            DWORD actualStart = 0, actualEnd = 0;
            SendMessageW(g_hNoteEdit, EM_GETSEL,
                         reinterpret_cast<WPARAM>(&actualStart),
                         reinterpret_cast<LPARAM>(&actualEnd));
            const NoteUiSnapshot clicked = CaptureNoteUiSnapshot();
            if (actualStart != expected || actualEnd != expected ||
                !clicked.finalFrameActive || clicked.finalRawLineCount == 0 ||
                clicked.finalStructuredLineCount == 0) {
                AppendUiAutomationTrace(L"render_click:expected=" + std::to_wstring(expected) +
                    L" actual=" + std::to_wstring(actualStart) + L":" + std::to_wstring(actualEnd) +
                    L" point=" + std::to_wstring(x) + L":" + std::to_wstring(y));
                return false;
            }
            const bool typed = SendUiAutomationNoteTextInput(L"Q");
            std::wstring expectedText = original;
            expectedText.insert(expected, L"Q");
            const bool insertedAtClick = typed && GetNoteAutomationIndexingText() == expectedText;
            const bool restored = typed && SendUiAutomationNoteUndoChangedText() &&
                GetNoteAutomationIndexingText() == original;
            if (!insertedAtClick || !restored) {
                AppendUiAutomationTrace(L"render_click:input_mismatch target=" + target +
                    L" inserted=" + std::to_wstring(insertedAtClick) +
                    L" restored=" + std::to_wstring(restored));
                return false;
            }
        }
        SetFocus(owner);
        PreserveRenderedNoteOpeningView();
        SendMessageW(g_hNoteEdit, EM_SETSEL, original.size(), original.size());
        RECT client{};
        GetClientRect(g_hNoteEdit, &client);
        SendMessageW(g_hNoteEdit, WM_SIZE, SIZE_RESTORED,
                     MAKELPARAM(client.right - client.left, client.bottom - client.top));
        RefreshBottomPaneView();
        const auto end = CaptureNoteUiSnapshot();
        if (!end.finalFrameActive || !end.finalCaretGeometryReady) return false;
        if (end.finalCaretClientRect.bottom < client.bottom) {
            const LPARAM blank = MAKELPARAM(client.right / 2, client.bottom - 1);
            SendMessageW(g_hNoteEdit, WM_LBUTTONDOWN, MK_LBUTTON, blank);
            SendMessageW(g_hNoteEdit, WM_LBUTTONUP, 0, blank);
            DWORD first = 0, last = 0;
            SendMessageW(g_hNoteEdit, EM_GETSEL,
                         reinterpret_cast<WPARAM>(&first), reinterpret_cast<LPARAM>(&last));
            if (first != original.size() || last != original.size()) return false;
            const bool typed = SendUiAutomationNoteTextInput(L"Q");
            const bool exact = typed && GetNoteAutomationIndexingText() == original + L"Q";
            const bool restored = typed && SendUiAutomationNoteUndoChangedText() &&
                GetNoteAutomationIndexingText() == original;
            if (!exact || !restored) return false;
            AppendUiAutomationTrace(L"render_click:blank_eof_ok");
        }
        return true;
    };
    // An explicitly selected click-only run does not claim the completion
    // marker of the full math/IME/keyboard regression suite.
    if (renderedClickOnly) {
        AppendUiAutomationTrace(L"math_render:rendered_click_only");
        const bool valid = initial.markdownRoute && initial.documentReady &&
            initial.finalFrameActive && verifyRenderedClickInsertion();
        restorePrevious();
        if (!valid) {
            if (outError) *outError = L"Rendered click-only insertion/undo probe failed.";
            return false;
        }
        AppendUiAutomationTrace(L"math_render:rendered_click_insertion_ok");
        return true;
    }
    // Exercise the actual post-default RichEdit mutation paths that used to
    // leave the entire note native raw after typing or Backspace.  Each
    // assertion observes only the immutable public final frame: a successful
    // hybrid edit has a local raw owner and still retains structured owners
    // for unrelated rows.  A withdrawn frame/whole-native fallback is not a
    // substitute for that successful normal-path state.
    const auto verifyLocalHybridMutation = [&](const wchar_t* operation) -> bool {
        RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
        const NoteUiSnapshot snapshot = CaptureNoteUiSnapshot();
        if (snapshot.finalFrameActive && snapshot.finalRawLineCount > 0 &&
            snapshot.finalStructuredLineCount > 0 && snapshot.systemCaretMatchesFinal) {
            return true;
        }
        if (outError) {
            *outError = std::wstring(L"Final note rendering lost local hybrid ownership after ") +
                        operation + L". " + DescribeNoteUiSnapshot(snapshot);
        }
        return false;
    };
    // Unlike the blank-space click probe, these mutations always run at the
    // last row (both its start and end), including below the viewport. Only
    // the disposable automation note is edited; undo restores each probe.
    const auto verifyEofHybridMutations = [&]() -> bool {
        const std::wstring original = GetNoteAutomationIndexingText();
        // Automation's RichEdit indexing text keeps CR while TextCore uses
        // LF. Their single-unit offsets agree, not their newline characters.
        std::wstring canonicalOriginal = original;
        std::replace(canonicalOriginal.begin(), canonicalOriginal.end(), L'\r', L'\n');
        const size_t lastBreak = original.find_last_of(L"\r\n");
        const size_t lastLineStart = lastBreak == std::wstring::npos ? 0 : lastBreak + 1;
        NoteImeNativeDispatchProbe dispatchProbe;
        dispatchProbe.native = g_oldNoteProc;
        dispatchProbe.edit = g_hNoteEdit;
        if (!dispatchProbe.native || g_uiAutomationImeNativeProbe) return false;
        struct ScopedImeTransportProbe {
            NoteImeNativeDispatchProbe& probe;
            explicit ScopedImeTransportProbe(NoteImeNativeDispatchProbe& state) : probe(state) {
                g_uiAutomationImeNativeProbe = &probe;
                g_oldNoteProc = ProbeNoteImeNativeDispatch;
            }
            ~ScopedImeTransportProbe() {
                g_oldNoteProc = probe.native;
                g_uiAutomationImeNativeProbe = nullptr;
            }
        } transportProbe{dispatchProbe};
        const size_t emptyBreak = original.rfind(L"\r\r");
        if (emptyBreak == std::wstring::npos) return false;
        const size_t emptyOffset = emptyBreak + 1;
        SetFocus(owner);
        SendMessageW(g_hNoteEdit, EM_SETSEL, emptyOffset, emptyOffset);
        PreserveRenderedNoteOpeningView();
        RECT client{};
        GetClientRect(g_hNoteEdit, &client);
        const auto refreshGeometry = [&]() {
            SendMessageW(g_hNoteEdit, WM_SIZE, SIZE_RESTORED,
                MAKELPARAM(client.right - client.left, client.bottom - client.top));
            SendMessageW(g_hNoteEdit, WM_VSCROLL, SB_BOTTOM, 0);
        };
        refreshGeometry();
        const auto target = CaptureNoteUiSnapshot();
        const RECT caret = target.finalCaretClientRect;
        if (!target.finalFrameActive || !target.finalCaretGeometryReady ||
            caret.top < client.top || caret.bottom > client.bottom) return false;
        // Move the old caret away without changing structured row geometry.
        SendMessageW(g_hNoteEdit, EM_SETSEL, original.size(), original.size());
        refreshGeometry();
        RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
        const auto beforeClick = ObserveNoteRenderRuntime();
        SCROLLINFO oldScroll{};
        oldScroll.cbSize = sizeof(oldScroll);
        oldScroll.fMask = SIF_RANGE | SIF_PAGE | SIF_POS;
        const bool hadScroll = GetScrollInfo(g_hNoteEdit, SB_VERT, &oldScroll) != FALSE;
        const LPARAM point = MAKELPARAM(caret.left, caret.top + (caret.bottom - caret.top) / 2);
        dispatchProbe.pointerSelectionActive = true;
        SendMessageW(g_hNoteEdit, WM_LBUTTONDOWN, MK_LBUTTON, point);
        SendMessageW(g_hNoteEdit, WM_LBUTTONUP, 0, point);
        dispatchProbe.pointerSelectionActive = false;
        const bool clickHybrid = verifyLocalHybridMutation(L"empty row click");
        DWORD clickedFirst = 0, clickedLast = 0;
        SendMessageW(g_hNoteEdit, EM_GETSEL,
            reinterpret_cast<WPARAM>(&clickedFirst), reinterpret_cast<LPARAM>(&clickedLast));
        const auto afterClick = ObserveNoteRenderRuntime();
        const auto clicked = CaptureNoteUiSnapshot();
        SCROLLINFO newScroll = oldScroll;
        const bool clickValid = dispatchProbe.pointerValid && dispatchProbe.pointerSelections > 0 &&
            clickHybrid && clickedFirst == emptyOffset && clickedLast == emptyOffset &&
            clicked.finalCaretClientRect.top == caret.top && clicked.finalCaretClientRect.bottom == caret.bottom &&
            hadScroll && GetScrollInfo(g_hNoteEdit, SB_VERT, &newScroll) &&
            oldScroll.nMin == newScroll.nMin && oldScroll.nMax == newScroll.nMax &&
            oldScroll.nPage == newScroll.nPage && oldScroll.nPos == newScroll.nPos &&
            afterClick.nativeRedrawDepth == 0 && afterClick.nativeRedrawRequested &&
            afterClick.nativeFallbackPaintCount == beforeClick.nativeFallbackPaintCount &&
            afterClick.canonicalRevision == beforeClick.canonicalRevision &&
            GetNoteAutomationIndexingText() == original;
        AppendUiAutomationTrace(L"math_render:blank_click length=" + std::to_wstring(original.size()) +
            L" valid=" + std::to_wstring(clickValid) + L" atomic=" + std::to_wstring(dispatchProbe.pointerValid) +
            L" selected=" + std::to_wstring(clickedFirst) + L" expected=" + std::to_wstring(emptyOffset));
        if (!clickValid) return false;
        // START is observable before COMPSTR arrives. Painting each phase
        // detects a raw gap that assertions only after IME result miss.
        for (const size_t startOffset : {lastLineStart, original.size()}) {
            SetFocus(g_hNoteEdit);
            SendMessageW(g_hNoteEdit, EM_SETSEL, startOffset, startOffset);
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_F24, 1);
            SendMessageW(g_hNoteEdit, WM_VSCROLL, SB_BOTTOM, 0);
            // Snapshot diagnostics materialize canonical text; warm them
            // before measuring whether the event itself rebuilds the model.
            const auto beforeSnapshot = CaptureNoteUiSnapshot();
            const auto before = ObserveNoteRenderRuntime();
            SendMessageW(g_hNoteEdit, WM_IME_STARTCOMPOSITION, 0, 0);
            const bool hybrid = verifyLocalHybridMutation(L"last-row IME start before COMPSTR");
            const auto started = ObserveNoteRenderRuntime();
            DWORD first = 0, last = 0;
            SendMessageW(g_hNoteEdit, EM_GETSEL,
                reinterpret_cast<WPARAM>(&first), reinterpret_cast<LPARAM>(&last));
            const auto snapshot = CaptureNoteUiSnapshot();
            IMECHARPOSITION position{};
            position.dwSize = sizeof(position);
            POINT expectedPosition{snapshot.finalCaretClientRect.left, snapshot.finalCaretClientRect.top};
            const bool positionCurrent = ClientToScreen(g_hNoteEdit, &expectedPosition) &&
                SendMessageW(g_hNoteEdit, WM_IME_REQUEST, IMR_QUERYCHARPOSITION,
                    reinterpret_cast<LPARAM>(&position)) == TRUE &&
                position.pt.x == expectedPosition.x && position.pt.y == expectedPosition.y &&
                position.cLineHeight == static_cast<UINT>(snapshot.finalCaretClientRect.bottom -
                                                         snapshot.finalCaretClientRect.top);
            HIMC imc = ImmGetContext(g_hNoteEdit);
            CANDIDATEFORM candidate{};
            const bool candidateRead = imc && ImmGetCandidateWindow(imc, 0, &candidate) != FALSE;
            if (imc) ImmReleaseContext(g_hNoteEdit, imc);
            HDC dc = GetDC(g_hNoteEdit);
            const int dpi = dc ? GetDeviceCaps(dc, LOGPIXELSY) : 96;
            if (dc) ReleaseDC(g_hNoteEdit, dc);
            const int gap = std::max(1, MulDiv(6, dpi > 0 ? dpi : 96, 96));
            const bool candidateCurrent = candidateRead && candidate.dwStyle == CFS_EXCLUDE &&
                candidate.rcArea.top == std::max(client.top, snapshot.finalCaretLineClientRect.top) - gap &&
                candidate.rcArea.bottom == std::min(client.bottom, snapshot.finalCaretLineClientRect.bottom) + gap &&
                candidate.ptCurrentPos.x == std::clamp(snapshot.finalCaretClientRect.left, client.left, client.right - 1) &&
                candidate.ptCurrentPos.y == std::clamp(snapshot.finalCaretClientRect.top, client.top, client.bottom - 1);
            const bool sourcePreserved = beforeSnapshot.finalFrameActive &&
                beforeSnapshot.canonicalText == canonicalOriginal && snapshot.canonicalText == canonicalOriginal &&
                first == startOffset && last == startOffset &&
                snapshot.renderedText.find(original.substr(lastLineStart)) != std::wstring::npos;
            // A passive geometry refresh between START and COMPSTR must keep
            // the same proven committed frame, not treat missing text as a
            // failed IMM read. It also exercises nested native anchor sync.
            RECT client{};
            GetClientRect(g_hNoteEdit, &client);
            SendMessageW(g_hNoteEdit, WM_SIZE, SIZE_RESTORED,
                MAKELPARAM(client.right - client.left, client.bottom - client.top));
            const bool pendingHybrid = verifyLocalHybridMutation(L"IME start geometry refresh");
            SendMessageW(g_hNoteEdit, WM_IME_COMPOSITION, 0, 0);
            const bool cancelledHybrid = verifyLocalHybridMutation(L"last-row IME cancellation");
            SendMessageW(g_hNoteEdit, WM_IME_ENDCOMPOSITION, 0, 0);
            const bool endedHybrid = verifyLocalHybridMutation(L"last-row cancelled IME end");
            const auto after = ObserveNoteRenderRuntime();
            const bool valid = dispatchProbe.valid && hybrid && sourcePreserved && positionCurrent && candidateCurrent &&
                pendingHybrid && cancelledHybrid && endedHybrid &&
                started.nativeRedrawTransactions == before.nativeRedrawTransactions + 1 &&
                after.nativeRedrawTransactions == before.nativeRedrawTransactions + 4 &&
                after.nativeRedrawDepth == 0 && after.nativeRedrawRequested &&
                after.nativeFallbackPaintCount == before.nativeFallbackPaintCount &&
                after.canonicalRevision == before.canonicalRevision &&
                after.modelMaterializations == before.modelMaterializations &&
                GetNoteAutomationIndexingText() == original;
            AppendUiAutomationTrace(L"math_render:last_row_ime_cancel offset=" +
                std::to_wstring(startOffset) + L" length=" + std::to_wstring(original.size()) +
                L" valid=" + std::to_wstring(valid) + L" native_paints=" +
                std::to_wstring(after.nativeFallbackPaintCount - before.nativeFallbackPaintCount) +
                L" hybrid=" + std::to_wstring(hybrid) + L" source=" + std::to_wstring(sourcePreserved) +
                L" pending=" + std::to_wstring(pendingHybrid) +
                L" cancelled=" + std::to_wstring(cancelledHybrid) + L" ended=" + std::to_wstring(endedHybrid) +
                L" scopes=" + std::to_wstring(after.nativeRedrawTransactions - before.nativeRedrawTransactions) +
                L" started_scopes=" + std::to_wstring(started.nativeRedrawTransactions - before.nativeRedrawTransactions) +
                L" models=" + std::to_wstring(after.modelMaterializations - before.modelMaterializations) +
                L" private_ime=" + std::to_wstring(dispatchProbe.valid) +
                L" private_failures=" + std::to_wstring(dispatchProbe.failureMask) +
                L" native_queries=" + std::to_wstring(dispatchProbe.nativeQueries) +
                L" public_query=" + std::to_wstring(positionCurrent) + L" candidate=" + std::to_wstring(candidateCurrent));
            if (!valid) return false;
        }
        for (const auto [input, atLineStart] : {
                 std::pair{L'Q', false}, std::pair{L'Q', true},
                 std::pair{L'\r', false}, std::pair{L'\b', false}}) {
            const size_t offset = atLineStart ? lastLineStart : original.size();
            SetFocus(g_hNoteEdit);
            SendMessageW(g_hNoteEdit, EM_SETSEL, offset, offset);
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_F24, 1);
            SendMessageW(g_hNoteEdit, WM_VSCROLL, SB_BOTTOM, 0);
            const auto before = ObserveNoteRenderRuntime();
            if (input == L'\r') {
                SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_RETURN, 1);
            }
            const bool sent = input == L'\b'
                ? SendUiAutomationNoteBackspace(1)
                : SendUiAutomationNoteTextInput(std::wstring(1, input));
            const bool hybrid = verifyLocalHybridMutation(L"EOF mutation");
            const auto after = ObserveNoteRenderRuntime();
            const auto snapshot = CaptureNoteUiSnapshot();
            std::wstring expected = original;
            if (input == L'\b') expected.pop_back();
            else expected.insert(offset, 1, input);
            const bool exact = GetNoteAutomationIndexingText() == expected;
            AppendUiAutomationTrace(L"math_render:eof_mutation input=" +
                std::to_wstring(static_cast<unsigned>(input)) + L" length=" +
                std::to_wstring(original.size()) + L" line_start=" + std::to_wstring(atLineStart) +
                L" exact=" + std::to_wstring(exact) +
                L" " + DescribeNoteUiSnapshot(snapshot) + L" native_paints=" +
                std::to_wstring(after.nativeFallbackPaintCount - before.nativeFallbackPaintCount) +
                L" frame=" + std::to_wstring(snapshot.finalFrameActive) + L" raw=" +
                std::to_wstring(snapshot.finalRawLineCount) + L" structured=" +
                std::to_wstring(snapshot.finalStructuredLineCount) + L" actual_length=" +
                std::to_wstring(GetNoteAutomationIndexingText().size()));
            if (input == L'\r') SendMessageW(g_hNoteEdit, WM_KEYUP, VK_RETURN, 0xC0000001);
            const bool restored = sent && exact && SendUiAutomationNoteUndoChangedText() &&
                GetNoteAutomationIndexingText() == original;
            if (!sent || !exact || !hybrid || !restored ||
                after.nativeFallbackPaintCount != before.nativeFallbackPaintCount) return false;
        }
        const size_t insertion = lastLineStart;
        SendMessageW(g_hNoteEdit, EM_SETSEL, insertion, insertion);
        SendMessageW(g_hNoteEdit, WM_VSCROLL, SB_BOTTOM, 0);
        const auto beforeStart = ObserveNoteRenderRuntime();
        SendMessageW(g_hNoteEdit, WM_IME_STARTCOMPOSITION, 0, 0);
        const bool startHybrid = verifyLocalHybridMutation(L"last-row IME start");
        const auto afterStart = ObserveNoteRenderRuntime();
        const bool startAtomic = afterStart.nativeFallbackPaintCount == beforeStart.nativeFallbackPaintCount &&
            afterStart.nativeRedrawDepth == 0 && afterStart.nativeRedrawRequested &&
            afterStart.nativeRedrawTransactions == beforeStart.nativeRedrawTransactions + 1;
        AppendUiAutomationTrace(L"math_render:eof_ime_start hybrid=" + std::to_wstring(startHybrid) +
            L" atomic=" + std::to_wstring(startAtomic) + L" native_paints=" +
            std::to_wstring(afterStart.nativeFallbackPaintCount - beforeStart.nativeFallbackPaintCount));
        SendMessageW(g_hNoteEdit, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(L"仮"));
        RecordCurrentNoteTextEditForUndo(g_hNoteEdit);
        ResetNoteEditHistorySnapshot(g_hNoteEdit);
        SendMessageW(g_hNoteEdit, EM_SETSEL, insertion, insertion + 1);
        SendMessageW(g_hNoteEdit, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(L"確未"));
        note::NoteImePreeditPayload remaining;
        remaining.text = L"未";
        remaining.caret = {1};
        const bool accepted = AcceptNoteImeResultWithContinuation(g_hNoteEdit, L"確", remaining);
        const bool partialHybrid = verifyLocalHybridMutation(L"EOF IME partial result");
        AppendUiAutomationTrace(L"math_render:eof_ime accepted=" + std::to_wstring(accepted) +
            L" hybrid=" + std::to_wstring(partialHybrid) + L" length=" + std::to_wstring(original.size()));
        SendMessageW(g_hNoteEdit, EM_SETSEL, insertion + 1, insertion + 2);
        SendMessageW(g_hNoteEdit, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(L""));
        SendMessageW(g_hNoteEdit, WM_IME_ENDCOMPOSITION, 0, 0);
        std::wstring expected = original;
        expected.insert(insertion, L"確");
        const bool exact = GetNoteAutomationIndexingText() == expected;
        const bool endedHybrid = verifyLocalHybridMutation(L"EOF IME end");
        const bool restored = exact && SendUiAutomationNoteUndoChangedText() &&
            GetNoteAutomationIndexingText() == original;
        AppendUiAutomationTrace(L"math_render:eof_ime_end exact=" + std::to_wstring(exact) +
            L" hybrid=" + std::to_wstring(endedHybrid) + L" restored=" + std::to_wstring(restored));
        return startHybrid && startAtomic && accepted && partialHybrid && endedHybrid && restored;
    };
    const auto verifyPopulatedLastRowMutations = [&]() -> bool {
        const std::wstring original = GetNoteAutomationIndexingText();
        // Distinguish line start from EOF even when the base fixture ends in
        // an empty row. Keep an unrelated structured prefix and undo the fixture.
        InsertSnippetIntoNoteAt(original.size(), L"\nLast input row");
        const bool valid = verifyEofHybridMutations();
        const bool restored = SendUiAutomationNoteUndoChangedText() &&
            GetNoteAutomationIndexingText() == original;
        return valid && restored;
    };
    // The system caret must follow final geometry after each focus lifetime,
    // not a cached RichEdit row or a persistent caret painted into the canvas.
    SetFocus(g_hNoteEdit);
    RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
    const NoteUiSnapshot focusedOpening = CaptureNoteUiSnapshot();
    SetFocus(owner);
    RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
    GUITHREADINFO unfocusedInfo{};
    unfocusedInfo.cbSize = sizeof(unfocusedInfo);
    const bool nativeCaretReleased = GetGUIThreadInfo(GetCurrentThreadId(), &unfocusedInfo) &&
        unfocusedInfo.hwndCaret != g_hNoteEdit;
    SetFocus(g_hNoteEdit);
    RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
    const NoteUiSnapshot refocusedOpening = CaptureNoteUiSnapshot();
    if (!focusedOpening.systemCaretMatchesFinal || !nativeCaretReleased ||
        !refocusedOpening.systemCaretMatchesFinal || !refocusedOpening.finalFrameActive ||
        focusedOpening.currentLineHighlightPainted || refocusedOpening.currentLineHighlightPainted) {
        restorePrevious();
        if (outError) *outError = L"The opening caret lost final geometry or painted an editing-row highlight across focus/refocus.";
        return false;
    }
    // Probe the actual IMM request, not the candidate window's OS-owned UI.
    // Prediction notifications must work with no live composition session.
    const auto verifyImeCandidateRequests = [&]() -> bool {
        const NoteUiSnapshot before = CaptureNoteUiSnapshot();
        RECT caret = before.finalCaretClientRect;
        RECT inputBand = before.finalCaretLineClientRect;
        if (!before.finalFrameActive) {
            GUITHREADINFO info{};
            info.cbSize = sizeof(info);
            if (!GetGUIThreadInfo(GetCurrentThreadId(), &info) || info.hwndCaret != g_hNoteEdit) return false;
            caret = info.rcCaret;
            inputBand = caret;
        }
        HIMC imc = ImmGetContext(g_hNoteEdit);
        if (!imc) {
            AppendUiAutomationTrace(L"math_render:ime_candidate_request_skipped_no_context");
            return true;
        }
        CANDIDATEFORM original{};
        const bool haveOriginal = ImmGetCandidateWindow(imc, 0, &original) != FALSE;
        ImmReleaseContext(g_hNoteEdit, imc);
        bool valid = !IsNoteImeComposing();
        for (WPARAM event : {WPARAM{IMN_OPENCANDIDATE}, WPARAM{IMN_CHANGECANDIDATE}}) {
            // Simulate a native reset to the old one-pixel exclusion before
            // the notification; the subclass must replace it post-default.
            imc = ImmGetContext(g_hNoteEdit);
            if (!imc) { valid = false; break; }
            CANDIDATEFORM stale{};
            stale.dwStyle = CFS_EXCLUDE;
            stale.rcArea = caret;
            stale.ptCurrentPos = {stale.rcArea.left, stale.rcArea.bottom};
            const bool injected = ImmSetCandidateWindow(imc, &stale) != FALSE;
            ImmReleaseContext(g_hNoteEdit, imc);
            // Simulate a native IME handler leaving the system caret at a
            // transport coordinate. Repair must happen in the notification,
            // without painting or reparsing to make the assertion pass.
            if (before.finalFrameActive && !SetCaretPos(caret.left, caret.top + 12)) {
                valid = false;
                break;
            }
            SendMessageW(g_hNoteEdit, WM_IME_NOTIFY, event, 1);
            const auto notificationState = CaptureNoteUiSnapshot();
            const bool accessibleMatches = VerifyAccessibleSystemCaretForAutomation(g_hNoteEdit);
            AppendUiAutomationTrace(L"math_render:ime_notification_caret_matches=" +
                std::to_wstring(notificationState.systemCaretMatchesFinal) +
                L" frame=" + std::to_wstring(notificationState.finalFrameActive));
            valid = valid && (!before.finalFrameActive || notificationState.systemCaretMatchesFinal) && accessibleMatches;
            imc = ImmGetContext(g_hNoteEdit);
            if (!imc) { valid = false; break; }
            CANDIDATEFORM actual{};
            const bool read = ImmGetCandidateWindow(imc, 0, &actual) != FALSE;
            ImmReleaseContext(g_hNoteEdit, imc);
            RECT client{};
            GetClientRect(g_hNoteEdit, &client);
            HDC dc = GetDC(g_hNoteEdit);
            const int dpi = dc ? GetDeviceCaps(dc, LOGPIXELSY) : 96;
            if (dc) ReleaseDC(g_hNoteEdit, dc);
            const int gap = std::max(1, MulDiv(6, dpi > 0 ? dpi : 96, 96));
            valid = valid && injected && read && actual.dwStyle == CFS_EXCLUDE &&
                actual.rcArea.left == client.left && actual.rcArea.right == client.right &&
                actual.rcArea.top == std::max(client.top, inputBand.top) - gap &&
                actual.rcArea.bottom == std::min(client.bottom, inputBand.bottom) + gap &&
                actual.ptCurrentPos.x == std::clamp(caret.left, client.left, client.right - 1) &&
                actual.ptCurrentPos.y == std::clamp(caret.top, client.top, client.bottom - 1);
        }
        const NoteUiSnapshot after = CaptureNoteUiSnapshot();
        valid = valid && !IsNoteImeComposing() && after.finalFrameActive == before.finalFrameActive &&
            after.canonicalText == before.canonicalText &&
            after.sourceIdentity.content_revision == before.sourceIdentity.content_revision;
        if (haveOriginal) {
            imc = ImmGetContext(g_hNoteEdit);
            if (imc) {
                const bool restored = ImmSetCandidateWindow(imc, &original) != FALSE;
                ImmReleaseContext(g_hNoteEdit, imc);
                valid = valid && restored;
            } else valid = false;
        }
        AppendUiAutomationTrace(L"math_render:ime_candidate_requests_valid=" + std::to_wstring(valid ? 1 : 0));
        return valid;
    };
    const auto verifyImeCharacterQuery = [&]() -> bool {
        const auto before = CaptureNoteUiSnapshot();
        const auto runtimeBefore = ObserveNoteRenderRuntime();
        if (!before.finalFrameActive || !before.finalCaretGeometryReady) return false;
        IMECHARPOSITION query{};
        query.dwSize = sizeof(query);
        const bool answered = SendMessageW(g_hNoteEdit, WM_IME_REQUEST,
            IMR_QUERYCHARPOSITION, reinterpret_cast<LPARAM>(&query)) != 0;
        POINT expected{before.finalCaretClientRect.left, before.finalCaretClientRect.top};
        RECT document{};
        GetClientRect(g_hNoteEdit, &document);
        POINT documentTop{document.left, document.top};
        POINT documentBottom{document.right, document.bottom};
        const bool mapped = ClientToScreen(g_hNoteEdit, &expected) &&
            ClientToScreen(g_hNoteEdit, &documentTop) && ClientToScreen(g_hNoteEdit, &documentBottom);
        document = {documentTop.x, documentTop.y, documentBottom.x, documentBottom.y};
        IMECHARPOSITION invalid = query;
        invalid.dwCharPos = 1; // No live preedit: only offset zero is meaningful.
        const IMECHARPOSITION originalInvalid = invalid;
        const bool rejectsOffset = SendMessageW(g_hNoteEdit, WM_IME_REQUEST,
            IMR_QUERYCHARPOSITION, reinterpret_cast<LPARAM>(&invalid)) == 0 &&
            std::memcmp(&invalid, &originalInvalid, sizeof(invalid)) == 0;
        invalid = query;
        --invalid.dwSize;
        const IMECHARPOSITION originalSize = invalid;
        const bool rejectsSize = SendMessageW(g_hNoteEdit, WM_IME_REQUEST,
            IMR_QUERYCHARPOSITION, reinterpret_cast<LPARAM>(&invalid)) == 0 &&
            std::memcmp(&invalid, &originalSize, sizeof(invalid)) == 0;
        const bool rejectsNull = SendMessageW(g_hNoteEdit, WM_IME_REQUEST, IMR_QUERYCHARPOSITION, 0) == 0;
        const auto runtimeAfter = ObserveNoteRenderRuntime();
        const bool valid = answered && mapped && rejectsOffset && rejectsSize && rejectsNull &&
            query.pt.x == expected.x && query.pt.y == expected.y &&
            query.cLineHeight == static_cast<UINT>(before.finalCaretClientRect.bottom - before.finalCaretClientRect.top) &&
            EqualRect(&query.rcDocument, &document) &&
            runtimeBefore.canonicalRevision == runtimeAfter.canonicalRevision &&
            runtimeBefore.modelMaterializations == runtimeAfter.modelMaterializations;
        AppendUiAutomationTrace(L"math_render:ime_character_query valid=" + std::to_wstring(valid) +
            L" answered=" + std::to_wstring(answered) + L" expected_y=" + std::to_wstring(expected.y) +
            L" actual_y=" + std::to_wstring(query.pt.y));
        return valid;
    };
    if (!verifyImeCandidateRequests() || !verifyImeCharacterQuery()) {
        restorePrevious();
        if (outError) *outError = L"IME window request or character query did not use final input geometry without changing canonical text.";
        return false;
    }
    // The same read-only opening policy applies to whole-native raw mode.
    // Observe the actual FillRect path, not just a predicted policy flag.
    g_noteRawOnly = true;
    PreserveRenderedNoteOpeningView();
    RefreshBottomPaneView();
    RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
    const bool rawOpeningHighlighted = CaptureNoteUiSnapshot().currentLineHighlightPainted;
    const bool rawImeCandidatePlaced = verifyImeCandidateRequests();
    g_noteRawOnly = false;
    RefreshBottomPaneView();
    if (rawOpeningHighlighted || !rawImeCandidatePlaced) {
        restorePrevious();
        if (outError) *outError = L"The raw opening view highlighted an inactive row or lost native IME candidate placement.";
        return false;
    }
    // Real partial-raw ownership keeps the heading's taller allocation, not
    // its glyph size. Its exclusion must extend past that preserved padding.
    SetFocus(g_hNoteEdit);
    SendMessageW(g_hNoteEdit, EM_SETSEL, 2, 2);
    SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_F24, 0);
    SendMessageW(g_hNoteEdit, WM_KEYUP, VK_F24, 0);
    RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
    const auto headingInput = CaptureNoteUiSnapshot();
    const bool headingBandValid = headingInput.finalFrameActive && headingInput.finalRawLineCount > 0 &&
        headingInput.finalCaretLineClientRect.bottom > headingInput.finalCaretClientRect.bottom &&
        verifyImeCandidateRequests() && verifyImeCharacterQuery();
    AppendUiAutomationTrace(L"math_render:ime_heading_band_valid=" + std::to_wstring(headingBandValid) +
        L" caret_bottom=" + std::to_wstring(headingInput.finalCaretClientRect.bottom) +
        L" row_bottom=" + std::to_wstring(headingInput.finalCaretLineClientRect.bottom));
    SetFocus(owner);
    SendMessageW(g_hNoteEdit, EM_SETSEL, 0, 0);
    PreserveRenderedNoteOpeningView();
    SetFocus(g_hNoteEdit);
    RefreshBottomPaneView();
    if (!headingBandValid) {
        restorePrevious();
        if (outError) *outError = L"IME candidates overlap a heading's preserved raw row allocation.";
        return false;
    }
    // Use the real assist hit-test/command path, not direct flag assignment.
    // Every cycle must keep the same note/view identity and remain clickable.
    const auto verifyAssistRenderCycles = [&](bool narrowPane = false) -> bool {
        const auto savedMode = g_bottomNoteMode;
        const auto savedPin = g_bottomPanePin;
        const bool savedEnabled = g_noteRenderEnabled;
        const bool savedRaw = g_noteRawOnly;
        const bool savedMath = g_noteRenderMath;
        const bool configEnabled = g_config.noteRenderEnabled;
        const bool configRaw = g_config.noteRawOnly;
        const bool configMath = g_config.noteRenderMath;
        const int configInlineMathVerticalAlignment = g_config.noteInlineMathVerticalAlignment;
        const bool savedVim = g_noteVimModeEnabled;
        const bool savedNormal = g_noteNormalMode;
        const DWORD savedNormalCaret = g_noteNormalCaret;
        const HWND savedFocus = GetFocus();
        const bool savedCaretRaw = g_noteVimCaretLineRawTextVisible;
        const bool savedClickInsert = g_noteVimClickEntersInsertMode;
        const bool configVim = g_config.noteVimModeEnabled;
        const bool configCaretRaw = g_config.noteVimCaretLineRawTextVisible;
        const bool configClickInsert = g_config.noteVimClickEntersInsertMode;
        g_bottomNoteMode = BottomNoteMode::Assist;
        g_bottomPanePin = BottomPanePin::Note;
        ui::ApplyLayout(owner, ui::LayoutPass::Commit);
        RefreshBottomPaneView();
        RefreshMainWindowUiState(owner);
        const auto originalLayout = ui::GetLayoutState();
        RECT originalPane{};
        RECT originalNote{};
        const auto childRect = [&](HWND child, RECT* out) {
            if (!GetWindowRect(child, out)) return false;
            MapWindowPoints(HWND_DESKTOP, owner, reinterpret_cast<POINT*>(out), 2);
            return true;
        };
        const bool originalRectsValid = childRect(g_hBottomNote, &originalPane) &&
            childRect(g_hNoteEdit, &originalNote);
        const NoteUiSnapshot before = CaptureNoteUiSnapshot();
        const std::wstring beforeText = GetNoteAutomationIndexingText();
        DWORD beforeStart = 0, beforeEnd = 0;
        SendMessageW(g_hNoteEdit, EM_GETSEL,
            reinterpret_cast<WPARAM>(&beforeStart), reinterpret_cast<LPARAM>(&beforeEnd));
        // Only the disposable workspace is changed. Exercise main-window
        // down/move/live-timer/up dispatch, not child SetWindowPos or layout
        // assignment. Every exit releases capture; the return drag restores
        // both neighbouring rectangles and the persisted column width.
        const auto verifyColumnGeometry = [&](int expectedRight) {
            RECT pane{}, note{}, client{};
            const auto bands = ui::GetSplitBands(owner);
            return originalRectsValid && childRect(g_hBottomNote, &pane) &&
                childRect(g_hNoteEdit, &note) && GetClientRect(owner, &client) &&
                ui::GetLayoutState().rightWidth == expectedRight &&
                pane.left == bands.vRight.right && pane.right == client.right &&
                pane.right - pane.left == expectedRight &&
                pane.top == originalPane.top && pane.bottom == originalPane.bottom &&
                note.left == originalNote.left && note.right == bands.vRight.left &&
                note.top == originalNote.top && note.bottom == originalNote.bottom;
        };
        const auto dragRightColumn = [&](int expectedRight) {
            const auto layout = ui::GetLayoutState();
            if (GetCapture() || expectedRight < kMinPane) return false;
            const auto bands = ui::GetSplitBands(owner);
            const POINT start{(bands.vRight.left + bands.vRight.right) / 2,
                              (bands.vRight.top + bands.vRight.bottom) / 2};
            if (ui::HitTest(bands, start) != ui::SplitHit::VRight) return false;
            SendMessageW(owner, WM_LBUTTONDOWN, MK_LBUTTON, MAKELPARAM(start.x, start.y));
            bool moved = g_draggingRight && GetCapture() == owner;
            const int delta = layout.rightWidth - expectedRight;
            for (int step = 1; moved && step <= 3; ++step) {
                const int dx = delta * step / 4;
                SendMessageW(owner, WM_MOUSEMOVE, MK_LBUTTON, MAKELPARAM(start.x + dx, start.y));
                SendMessageW(owner, WM_TIMER, ui::kSplitDragTimerId, 0);
                moved = g_draggingRight && GetCapture() == owner &&
                    verifyColumnGeometry(layout.rightWidth - dx);
            }
            // Leave the last move pending: button-up must commit it even
            // without another timer tick, as in a quick real mouse drag.
            SendMessageW(owner, WM_MOUSEMOVE, MK_LBUTTON, MAKELPARAM(start.x + delta, start.y));
            SendMessageW(owner, WM_LBUTTONUP, 0, MAKELPARAM(start.x + delta, start.y));
            moved = moved && !g_draggingRight && GetCapture() != owner &&
                verifyColumnGeometry(expectedRight) && g_config.rightWidth == expectedRight;
            if (g_draggingRight || GetCapture() == owner) SendMessageW(owner, WM_CANCELMODE, 0, 0);
            const auto after = CaptureNoteUiSnapshot();
            DWORD startSelection = 0, endSelection = 0;
            SendMessageW(g_hNoteEdit, EM_GETSEL,
                reinterpret_cast<WPARAM>(&startSelection), reinterpret_cast<LPARAM>(&endSelection));
            moved = moved && after.viewIdentity.view_id == before.viewIdentity.view_id &&
                after.sourceIdentity.note_id == before.sourceIdentity.note_id &&
                after.sourceIdentity.content_revision == before.sourceIdentity.content_revision &&
                after.finalFrameActive == (g_noteRenderEnabled && !g_noteRawOnly) &&
                startSelection == beforeStart && endSelection == beforeEnd &&
                GetNoteAutomationIndexingText() == beforeText;
            AppendUiAutomationTrace(L"math_render:assist_splitter_drag from=" +
                std::to_wstring(layout.rightWidth) + L" to=" + std::to_wstring(expectedRight) +
                L" valid=" + std::to_wstring(moved));
            return moved;
        };
        bool valid = originalRectsValid;
        if (narrowPane) valid = valid && originalLayout.rightWidth > 170 && dragRightColumn(170);
        for (int pass = 0; pass < 6 && valid; ++pass) {
            // Repeat the same cycles in a narrow pane: wrapped labels must
            // not shift the hit-test onto a neighbour or a read-only row.
            if (narrowPane && !verifyColumnGeometry(170)) { valid = false; break; }
            SendMessageW(g_hBottomNote, WM_VSCROLL, SB_TOP, 0);
            RedrawWindow(g_hBottomNote, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
            RECT control{};
            bool found = GetNoteStatusAssistRenderControlRect(&control);
            for (int step = 0; !found && step < 64; ++step) {
                SendMessageW(g_hBottomNote, WM_VSCROLL, SB_LINEDOWN, 0);
                RedrawWindow(g_hBottomNote, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
                found = GetNoteStatusAssistRenderControlRect(&control);
            }
            if (!found) {
                RECT client{};
                GetClientRect(g_hBottomNote, &client);
                AppendUiAutomationTrace(L"math_render:assist_control_not_visible size=" +
                    std::to_wstring(client.right) + L":" + std::to_wstring(client.bottom) +
                    L" style=" + std::to_wstring(GetWindowLongPtrW(g_hBottomNote, GWL_STYLE)));
                valid = false;
                break;
            }
            const bool enabled = g_noteRenderEnabled && !g_noteRawOnly;
            const bool math = enabled && g_noteRenderMath;
            const LPARAM point = MAKELPARAM((control.left + control.right) / 2,
                                           (control.top + control.bottom) / 2);
            SendMessageW(g_hBottomNote, WM_LBUTTONDOWN, MK_LBUTTON, point);
            SendMessageW(g_hBottomNote, WM_LBUTTONUP, 0, point);
            RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
            const NoteUiSnapshot after = CaptureNoteUiSnapshot();
            DWORD afterStart = 0, afterEnd = 0;
            SendMessageW(g_hNoteEdit, EM_GETSEL,
                reinterpret_cast<WPARAM>(&afterStart), reinterpret_cast<LPARAM>(&afterEnd));
            valid = g_noteRenderEnabled == !math && g_noteRawOnly == math &&
                g_noteRenderMath == (enabled && !math) &&
                after.viewIdentity.view_id == before.viewIdentity.view_id &&
                after.viewIdentity.note_id == before.viewIdentity.note_id &&
                after.sourceIdentity.note_id == before.sourceIdentity.note_id &&
                after.sourceIdentity.content_revision == before.sourceIdentity.content_revision &&
                after.finalFrameActive == !math && beforeStart == afterStart && beforeEnd == afterEnd &&
                GetNoteAutomationIndexingText() == beforeText && !IsNoteRenderSwitchInProgress() &&
                (!narrowPane || verifyColumnGeometry(170));
            if (!valid) {
                AppendUiAutomationTrace(L"math_render:assist_cycle_failed pass=" + std::to_wstring(pass) +
                    L" before=" + DescribeNoteUiSnapshot(before) + L" after=" + DescribeNoteUiSnapshot(after) +
                    L" selection=" + std::to_wstring(beforeStart) + L":" + std::to_wstring(beforeEnd) +
                    L"->" + std::to_wstring(afterStart) + L":" + std::to_wstring(afterEnd));
            }
        }
        if (narrowPane) {
            const bool draggedBack = dragRightColumn(originalLayout.rightWidth);
            RECT restoredPane{}, restoredNote{};
            const auto restoredLayout = ui::GetLayoutState();
            const bool restoredWidth = draggedBack && childRect(g_hBottomNote, &restoredPane) &&
                childRect(g_hNoteEdit, &restoredNote) && EqualRect(&restoredPane, &originalPane) &&
                EqualRect(&restoredNote, &originalNote) &&
                restoredLayout.leftWidth == originalLayout.leftWidth &&
                restoredLayout.topHeight == originalLayout.topHeight &&
                restoredLayout.leftSplit1 == originalLayout.leftSplit1 &&
                restoredLayout.leftSplit2 == originalLayout.leftSplit2;
            valid = restoredWidth && valid;
            if (!restoredWidth) {
                // Failure cleanup only, never evidence for a passed drag.
                SendMessageW(owner, WM_CANCELMODE, 0, 0);
                ui::SetLayoutState(originalLayout);
                ui::ApplyLayout(owner, ui::LayoutPass::Commit);
                PersistConfig();
            }
            AppendUiAutomationTrace(L"math_render:assist_width_restored valid=" + std::to_wstring(restoredWidth));
            AppendUiAutomationTrace(valid ? L"math_render:assist_wrapped_cycles_ok"
                                          : L"math_render:assist_wrapped_cycles_failed");
        }
        // Exercise the actual status controls, including conditional rows.
        // Preference changes must publish immediately, without a later key.
        const auto clickAssistControl = [&](NoteStatusAssistControl target) {
            SendMessageW(g_hBottomNote, WM_VSCROLL, SB_TOP, 0);
            // Publish the new scroll extent after conditional rows change.
            // Use overlapping small steps, so a clipped header/command bar
            // cannot make a control fall between two page-sized probes.
            RedrawWindow(g_hBottomNote, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
            for (int step = 0; step < 64; ++step) {
                RECT control{};
                if (GetNoteStatusAssistControlRect(target, &control)) {
                    const auto point = MAKELPARAM((control.left + control.right) / 2,
                                                 (control.top + control.bottom) / 2);
                    SendMessageW(g_hBottomNote, WM_LBUTTONDOWN, MK_LBUTTON, point);
                    SendMessageW(g_hBottomNote, WM_LBUTTONUP, 0, point);
                    RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
                    AppendUiAutomationTrace(L"math_render:assist_click control=" +
                        std::to_wstring(static_cast<int>(target)) + L" vim=" +
                        std::to_wstring(g_noteVimModeEnabled) + L" normal=" +
                        std::to_wstring(g_noteNormalMode) + L" rawPreference=" +
                        std::to_wstring(g_noteVimCaretLineRawTextVisible) + L" snapshot=" +
                        DescribeNoteUiSnapshot(CaptureNoteUiSnapshot()));
                    return true;
                }
                SendMessageW(g_hBottomNote, WM_VSCROLL, SB_LINEDOWN, 0);
                RedrawWindow(g_hBottomNote, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
            }
            AppendUiAutomationTrace(L"math_render:assist_control_unavailable control=" +
                std::to_wstring(static_cast<int>(target)));
            return false;
        };
        if (valid) {
            g_noteVimModeEnabled = false;
            g_noteNormalMode = false;
            g_noteVimCaretLineRawTextVisible = false;
            g_noteVimClickEntersInsertMode = false;
            SetFocus(g_hNoteEdit);
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_F24, 0); // end opening visual hold, no text edit
            SendMessageW(g_hNoteEdit, WM_KEYUP, VK_F24, 0);
            RECT hidden{};
            const int inlineMathVerticalAlignmentBefore =
                std::clamp(g_config.noteInlineMathVerticalAlignment, 0, 2);
            valid = !GetNoteStatusAssistControlRect(NoteStatusAssistControl::NormalCaretRaw, &hidden) &&
                !GetNoteStatusAssistControlRect(NoteStatusAssistControl::ClickInsert, &hidden) &&
                clickAssistControl(NoteStatusAssistControl::InlineMathVerticalAlignment) &&
                g_config.noteInlineMathVerticalAlignment == (inlineMathVerticalAlignmentBefore + 1) % 3 &&
                clickAssistControl(NoteStatusAssistControl::Vim) && g_noteVimModeEnabled && g_noteNormalMode;
            const auto normal = CaptureNoteUiSnapshot();
            valid = valid && normal.finalFrameActive && normal.finalRawLineCount == 0 &&
                clickAssistControl(NoteStatusAssistControl::NormalCaretRaw) &&
                g_noteVimCaretLineRawTextVisible && g_config.noteVimCaretLineRawTextVisible;
            const auto raw = CaptureNoteUiSnapshot();
            valid = valid && raw.finalFrameActive && raw.finalRawLineCount > 0 &&
                raw.sourceIdentity.content_revision == normal.sourceIdentity.content_revision &&
                clickAssistControl(NoteStatusAssistControl::NormalCaretRaw) &&
                !g_noteVimCaretLineRawTextVisible && CaptureNoteUiSnapshot().finalRawLineCount == 0 &&
                clickAssistControl(NoteStatusAssistControl::ClickInsert) && g_noteVimClickEntersInsertMode &&
                g_config.noteVimClickEntersInsertMode &&
                clickAssistControl(NoteStatusAssistControl::CurrentDisplay) &&
                g_noteRenderEnabled == savedEnabled && g_noteRawOnly == savedRaw &&
                g_noteRenderMath == savedMath && GetNoteAutomationIndexingText() == beforeText &&
                clickAssistControl(NoteStatusAssistControl::Vim) && !g_noteVimModeEnabled &&
                !g_noteNormalMode && g_noteVimClickEntersInsertMode &&
                !GetNoteStatusAssistControlRect(NoteStatusAssistControl::ClickInsert, &hidden);
            if (valid) {
                // An IME start can precede its first composition string. A
                // settings click must not cancel even this provisional phase.
                SetFocus(g_hNoteEdit);
                SendMessageW(g_hNoteEdit, WM_IME_STARTCOMPOSITION, 0, 0);
                valid = clickAssistControl(NoteStatusAssistControl::Vim) &&
                    !g_noteVimModeEnabled && !g_noteNormalMode;
                SendMessageW(g_hNoteEdit, WM_IME_ENDCOMPOSITION, 0, 0);
                valid = valid && GetNoteAutomationIndexingText() == beforeText &&
                    CaptureNoteUiSnapshot().sourceIdentity.content_revision == before.sourceIdentity.content_revision;
            }
            AppendUiAutomationTrace(valid ? L"math_render:assist_interaction_settings_ok"
                                          : L"math_render:assist_interaction_settings_failed");
        }
        g_noteVimModeEnabled = savedVim;
        g_noteNormalMode = savedNormal;
        g_noteNormalCaret = savedNormalCaret;
        g_noteVimCaretLineRawTextVisible = savedCaretRaw;
        g_noteVimClickEntersInsertMode = savedClickInsert;
        g_config.noteVimModeEnabled = configVim;
        g_config.noteVimCaretLineRawTextVisible = configCaretRaw;
        g_config.noteVimClickEntersInsertMode = configClickInsert;
        SendMessageW(g_hNoteEdit, EM_SETSEL, beforeStart, beforeEnd);
        g_noteRenderEnabled = savedEnabled;
        g_noteRawOnly = savedRaw;
        g_noteRenderMath = savedMath;
        g_config.noteRenderEnabled = configEnabled;
        g_config.noteRawOnly = configRaw;
        g_config.noteRenderMath = configMath;
        g_config.noteInlineMathVerticalAlignment = configInlineMathVerticalAlignment;
        PersistConfig(); // Only the disposable automation workspace is in scope.
        g_bottomNoteMode = savedMode;
        g_bottomPanePin = savedPin;
        ui::ApplyLayout(owner, ui::LayoutPass::Commit);
        RefreshBottomPaneView();
        RefreshMainWindowUiState(owner);
        if (savedFocus && IsWindow(savedFocus)) SetFocus(savedFocus);
        return valid;
    };
    if (!verifyAssistRenderCycles() || !verifyAssistRenderCycles(true)) {
        restorePrevious();
        if (outError) *outError = L"Status assist render-mode cycles changed note identity, selection, or stopped accepting clicks.";
        return false;
    }
    const std::wstring pristineMathText = GetNoteAutomationIndexingText();
    // Handled navigation must finish publication at key-down, not rely on a
    // future character/key-up or a paint-side repair. Include unchanged edge
    // offsets and Smart Home/End's early-return path.
    SetFocus(g_hNoteEdit);
    const auto beforeNavigation = ObserveNoteRenderRuntime();
    for (const WPARAM key : {VK_LEFT, VK_RIGHT, VK_UP, VK_DOWN, VK_PRIOR, VK_NEXT, VK_HOME, VK_END}) {
        SendMessageW(g_hNoteEdit, EM_SETSEL, 0, 0);
        SendMessageW(g_hNoteEdit, WM_KEYDOWN, key, 1);
        const auto beforePaint = CaptureNoteUiSnapshot();
        if (!beforePaint.finalFrameActive || !beforePaint.systemCaretMatchesFinal ||
            !VerifyAccessibleSystemCaretForAutomation(g_hNoteEdit) || !verifyImeCharacterQuery()) {
            AppendUiAutomationTrace(L"math_render:navigation_before_paint_failed key=" + std::to_wstring(key));
            restorePrevious();
            if (outError) *outError = L"Navigation retained stale system/accessibility caret geometry until paint.";
            return false;
        }
        RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
        const auto after = CaptureNoteUiSnapshot();
        const auto runtime = ObserveNoteRenderRuntime();
        if (!after.finalFrameActive || after.finalStructuredLineCount == 0 ||
            after.finalRawLineCount == 0 || !after.systemCaretMatchesFinal ||
            runtime.canonicalRevision != beforeNavigation.canonicalRevision ||
            runtime.modelMaterializations != beforeNavigation.modelMaterializations) {
            AppendUiAutomationTrace(L"math_render:navigation_completion_failed key=" +
                std::to_wstring(key) + L" snapshot=" + DescribeNoteUiSnapshot(after));
            restorePrevious();
            if (outError) *outError = L"Handled navigation did not finish its final frame at key-down.";
            return false;
        }
        SendMessageW(g_hNoteEdit, WM_KEYUP, key, 0xC0000001);
    }
    if (GetNoteAutomationIndexingText() != pristineMathText) {
        restorePrevious();
        if (outError) *outError = L"Navigation changed the note text.";
        return false;
    }
    AppendUiAutomationTrace(L"math_render:navigation_completion_ok");
    const std::wstring localEditAnchor = L"Inline paren \\(a + b\\)";
    const int localEditAnchorStart = FindNoteTextSnippetStart(localEditAnchor);
    if (localEditAnchorStart < 0) {
        restorePrevious();
        if (outError) *outError = L"Could not find the local-edit render fixture anchor.";
        return false;
    }
    const int localEditAnchorEnd = localEditAnchorStart + static_cast<int>(localEditAnchor.size());
    const size_t localSourceLineBreak = pristineMathText.find_first_of(L"\r\n", localEditAnchorStart);
    const size_t localSourceLineEnd = localSourceLineBreak == std::wstring::npos
        ? pristineMathText.size() : localSourceLineBreak;
    for (const auto key : {VK_HOME, VK_END}) {
        SendMessageW(g_hNoteEdit, EM_SETSEL, localEditAnchorStart + 3, localEditAnchorStart + 3);
        SendMessageW(g_hNoteEdit, WM_KEYDOWN, key, 1);
        DWORD start = 0, end = 0;
        SendMessageW(g_hNoteEdit, EM_GETSEL,
            reinterpret_cast<WPARAM>(&start), reinterpret_cast<LPARAM>(&end));
        const DWORD expected = static_cast<DWORD>(key == VK_HOME
            ? static_cast<size_t>(localEditAnchorStart) : localSourceLineEnd);
        const auto after = ObserveNoteRenderRuntime();
        if (start != expected || end != expected || !after.finalFrameActive ||
            after.canonicalRevision != beforeNavigation.canonicalRevision ||
            after.modelMaterializations != beforeNavigation.modelMaterializations) {
            restorePrevious();
            if (outError) *outError = L"Smart Home/End lost its source-line target or materialized the note.";
            return false;
        }
        SendMessageW(g_hNoteEdit, WM_KEYUP, key, 0xC0000001);
    }
    AppendUiAutomationTrace(L"math_render:smart_home_end_source_line_ok");
    const bool verticalSelectionValid = [&]() {
        BYTE savedKeyboard[256]{};
        if (!GetKeyboardState(savedKeyboard)) return false;
        struct ScopedKeyboardRestore {
            const BYTE* saved;
            ~ScopedKeyboardRestore() { SetKeyboardState(const_cast<BYTE*>(saved)); }
        } restoreKeyboard{savedKeyboard};
        BYTE keyboard[256]{};
        std::copy(std::begin(savedKeyboard), std::end(savedKeyboard), std::begin(keyboard));
        keyboard[VK_CONTROL] = keyboard[VK_MENU] = keyboard[VK_SHIFT] = 0;
        if (!SetKeyboardState(keyboard)) return false;
        const DWORD origin = static_cast<DWORD>(localEditAnchorStart + 6);
        SendMessageW(g_hNoteEdit, EM_SETSEL, origin, origin);
        // Publish the externally positioned source caret without changing text.
        SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_LEFT, 1);
        SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_RIGHT, 1);
        DWORD initialStart = 0, initialEnd = 0;
        SendMessageW(g_hNoteEdit, EM_GETSEL, reinterpret_cast<WPARAM>(&initialStart), reinterpret_cast<LPARAM>(&initialEnd));
        if (initialStart != origin || initialEnd != origin) return false;
        const int previousLine = FindNoteTextSnippetStart(L"Inline dollar $x$");
        if (previousLine < 0) return false;
        keyboard[VK_SHIFT] = 0x80;
        if (!SetKeyboardState(keyboard)) return false;
        for (const WPARAM key : {VK_UP, VK_DOWN}) {
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, key, 1);
            DWORD start = 0, end = 0;
            SendMessageW(g_hNoteEdit, EM_GETSEL, reinterpret_cast<WPARAM>(&start), reinterpret_cast<LPARAM>(&end));
            RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
            const auto snapshot = CaptureNoteUiSnapshot();
            AppendUiAutomationTrace(L"math_render:vertical_step key=" + std::to_wstring(key) +
                L" start=" + std::to_wstring(start) + L" end=" + std::to_wstring(end) +
                L" origin=" + std::to_wstring(origin) + L" previous=" + std::to_wstring(previousLine + 6));
            // Structured and raw rows can have different style metrics. The
            // target must be on the adjacent source row; reversing uses the
            // retained display X and must return to the exact origin.
            if ((key == VK_UP ? (start < static_cast<DWORD>(previousLine) ||
                    start >= static_cast<DWORD>(localEditAnchorStart)) : start != origin) ||
                end != origin || !snapshot.finalFrameActive || !snapshot.systemCaretMatchesFinal) return false;
        }
        keyboard[VK_SHIFT] = 0;
        if (!SetKeyboardState(keyboard)) return false;
        SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_PRIOR, 1);
        DWORD pageStart = 0, pageEnd = 0;
        SendMessageW(g_hNoteEdit, EM_GETSEL, reinterpret_cast<WPARAM>(&pageStart), reinterpret_cast<LPARAM>(&pageEnd));
        SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_NEXT, 1);
        DWORD nextStart = 0, nextEnd = 0;
        SendMessageW(g_hNoteEdit, EM_GETSEL, reinterpret_cast<WPARAM>(&nextStart), reinterpret_cast<LPARAM>(&nextEnd));
        const auto runtime = ObserveNoteRenderRuntime();
        AppendUiAutomationTrace(L"math_render:vertical_pages before=" + std::to_wstring(pageStart) +
            L" after=" + std::to_wstring(nextStart) + L" models=" + std::to_wstring(runtime.modelMaterializations) +
            L" baseline_models=" + std::to_wstring(beforeNavigation.modelMaterializations));
        return pageStart == pageEnd && nextStart == nextEnd && nextStart > pageStart &&
            runtime.finalFrameActive && runtime.canonicalRevision == beforeNavigation.canonicalRevision &&
            runtime.modelMaterializations == beforeNavigation.modelMaterializations;
    }();
    if (!verticalSelectionValid || GetNoteAutomationIndexingText() != pristineMathText) {
        AppendUiAutomationTrace(L"math_render:vertical_selection_failed snapshot=" + DescribeNoteUiSnapshot(CaptureNoteUiSnapshot()));
        restorePrevious();
        if (outError) *outError = L"Final-coordinate vertical/page movement lost selection direction, caret, or source identity.";
        return false;
    }
    AppendUiAutomationTrace(L"math_render:vertical_selection_ok");
    const std::wstring beforeEofLong = GetNoteAutomationIndexingText();
    std::wstring eofLongPrefix;
    for (int block = 0; block < 128; ++block) {
        eofLongPrefix += L"## EOF heading " + std::to_wstring(block) + L"\n\n"
            L"Paragraph with **bold** and `code`.\n\n"
            L"$$\\frac{1}{2}$$\n\n"
            L"| Item | Example |\n| --- | --- |\n| row | `value` |\n\n\n";
    }
    InsertSnippetIntoNoteAt(0, eofLongPrefix);
    const bool longEofValid = verifyEofHybridMutations() && verifyPopulatedLastRowMutations();
    const bool eofPrefixRestored = SendUiAutomationNoteUndoChangedText() &&
        GetNoteAutomationIndexingText() == beforeEofLong;
    if (!longEofValid || !eofPrefixRestored) {
        restorePrevious();
        if (outError && outError->empty()) *outError = L"Long-note EOF mutation or fixture restoration failed.";
        return false;
    }
    if (!verifyEofHybridMutations() || !verifyPopulatedLastRowMutations()) {
        restorePrevious();
        if (outError && outError->empty()) *outError = L"EOF input, Enter or Backspace lost final rendering.";
        return false;
    }
    SendMessageW(g_hNoteEdit, EM_SETSEL, localEditAnchorEnd, localEditAnchorEnd);
    SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_F24, 1);
    const bool vimVerticalValid = [&]() {
        const bool savedVim = g_noteVimModeEnabled;
        const bool savedNormal = g_noteNormalMode;
        const bool savedRawPreference = g_noteVimCaretLineRawTextVisible;
        bool valid = true;
        const DWORD origin = static_cast<DWORD>(localEditAnchorStart + 6);
        const int previousLine = FindNoteTextSnippetStart(L"Inline dollar $x$");
        const auto sendPdfCtrlJ = [&]() -> bool {
            std::array<BYTE, 256> savedKeys{};
            if (!GetKeyboardState(savedKeys.data())) return false;
            auto pressedKeys = savedKeys;
            pressedKeys[VK_CONTROL] = 0x80;
            pressedKeys[VK_LCONTROL] = 0x80;
            pressedKeys[VK_SHIFT] = pressedKeys[VK_LSHIFT] = pressedKeys[VK_RSHIFT] = 0;
            pressedKeys[VK_MENU] = pressedKeys[VK_LMENU] = pressedKeys[VK_RMENU] = 0;
            if (!SetKeyboardState(pressedKeys.data())) return false;
            SendMessageW(g_hPdfView, WM_KEYDOWN, 'J', 1);
            // TranslateMessage may still target the originating PDF HWND.
            SendMessageW(g_hPdfView, WM_CHAR, L'\n', 1);
            return SetKeyboardState(savedKeys.data()) != FALSE;
        };
        for (const bool rawPreference : {false, true}) {
            g_noteVimModeEnabled = true;
            g_noteNormalMode = false;
            g_noteVimCaretLineRawTextVisible = rawPreference;
            SetFocus(g_hNoteEdit);
            SendMessageW(g_hNoteEdit, EM_SETSEL, origin, origin);
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_F24, 1);
            const auto entrySelection = GetNoteEditorSelectionAsCanonical(g_hNoteEdit);
            // Exercise Esc while Vim controls are enabled.
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_ESCAPE, 1);
            valid = valid && g_noteVimModeEnabled && g_noteNormalMode && GetFocus() == g_hNoteEdit;
            const auto expectedStatus = [](const wchar_t* target, const wchar_t* mode) {
                const std::wstring targetText = localization::Text(target);
                return localization::Text(L"note.assist.focus") + L": " + targetText + L"\n" +
                    localization::Text(L"note.assist.focus_window") + L": " + targetText + L"\n" +
                    localization::Text(L"note.assist.input_mode") + L": " + localization::Text(mode);
            };
            valid = valid && CaptureNoteInputStatusText() ==
                expectedStatus(L"note.assist.target.note", L"note.assist.input.normal");
            MSG normalIme{};
            normalIme.hwnd = g_hNoteEdit;
            normalIme.message = WM_IME_STARTCOMPOSITION;
            valid = ShouldSkipImeMessageInLoop(normalIme) && valid;
            HIMC normalContext = ImmGetContext(g_hNoteEdit);
            valid = valid && !normalContext;
            if (normalContext) ImmReleaseContext(g_hNoteEdit, normalContext);
            SendMessageW(g_hNoteEdit, WM_IME_STARTCOMPOSITION, 0, 0);
            SendMessageW(g_hNoteEdit, WM_IME_CHAR, 0x3042, 0);
            SendMessageW(g_hNoteEdit, WM_IME_ENDCOMPOSITION, 0, 0);
            const auto beforeVimNavigation = ObserveNoteRenderRuntime();
            AppendUiAutomationTrace(L"math_render:vim_enter raw=" + std::to_wstring(rawPreference) +
                L" origin=" + std::to_wstring(origin) +
                L" canonical_before=" + std::to_wstring(entrySelection ? entrySelection->second : SIZE_MAX) +
                L" canonical_after=" + std::to_wstring(g_noteNormalCaret) +
                L" snapshot=" + DescribeNoteUiSnapshot(CaptureNoteUiSnapshot()));
            // Normal keeps input on the note: arrows and hjkl share direction.
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_UP, 1);
            DWORD start = 0, end = 0;
            SendMessageW(g_hNoteEdit, EM_GETSEL, reinterpret_cast<WPARAM>(&start), reinterpret_cast<LPARAM>(&end));
            valid = valid && g_noteNormalMode && start == end && previousLine >= 0 &&
                start >= static_cast<DWORD>(previousLine) && start < static_cast<DWORD>(localEditAnchorStart);
            AppendUiAutomationTrace(L"math_render:vim_up start=" + std::to_wstring(start) + L" end=" + std::to_wstring(end));
            SendMessageW(g_hNoteEdit, WM_CHAR, L'j', 1);
            SendMessageW(g_hNoteEdit, EM_GETSEL, reinterpret_cast<WPARAM>(&start), reinterpret_cast<LPARAM>(&end));
            const auto snapshot = CaptureNoteUiSnapshot();
            const auto runtime = ObserveNoteRenderRuntime();
            // With Normal raw preference, the destination is structured
            // until movement hands ownership to raw. Unlike Shift selection
            // it need not share the origin's source-column metrics.
            const bool returnedToRow = rawPreference
                ? start >= static_cast<DWORD>(localEditAnchorStart) && start <= static_cast<DWORD>(localSourceLineEnd)
                : start == origin;
            valid = valid && returnedToRow && start == end && snapshot.finalFrameActive &&
                (rawPreference ? snapshot.finalRawLineCount > 0 : snapshot.finalRawLineCount == 0) &&
                runtime.canonicalRevision == beforeVimNavigation.canonicalRevision &&
                runtime.modelMaterializations == beforeVimNavigation.modelMaterializations;
            AppendUiAutomationTrace(L"math_render:vim_down start=" + std::to_wstring(start) +
                L" end=" + std::to_wstring(end) + L" raw_lines=" + std::to_wstring(snapshot.finalRawLineCount) +
                L" frame=" + std::to_wstring(snapshot.finalFrameActive) + L" valid=" + std::to_wstring(valid));
            const DWORD horizontalOrigin = g_noteNormalCaret;
            SendMessageW(g_hNoteEdit, WM_CHAR, L'h', 1);
            valid = valid && g_noteNormalCaret < horizontalOrigin && GetFocus() == g_hNoteEdit;
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_RIGHT, 1);
            valid = valid && g_noteNormalCaret == horizontalOrigin;
            SendMessageW(g_hNoteEdit, WM_CHAR, L'l', 1);
            valid = valid && g_noteNormalCaret > horizontalOrigin;
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_LEFT, 1);
            valid = valid && g_noteNormalCaret == horizontalOrigin;
            SendMessageW(g_hNoteEdit, WM_CHAR, L'k', 1);
            valid = valid && g_noteNormalCaret < horizontalOrigin;
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_DOWN, 1);
            const DWORD normalPosition = g_noteNormalCaret;
            valid = valid && normalPosition >= static_cast<DWORD>(localEditAnchorStart) &&
                normalPosition <= static_cast<DWORD>(localSourceLineEnd);

            SendMessageW(g_hNoteEdit, WM_CHAR, L'v', 1);
            SendMessageW(g_hNoteEdit, WM_CHAR, L'2', 1);
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_ESCAPE, 1);
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_ESCAPE, 1);
            valid = valid && g_noteNormalMode && GetFocus() == g_hNoteEdit &&
                !ClearNoteNormalVisualMode() && !ClearNoteNormalPendingState() &&
                g_noteNormalCaret == normalPosition;

            // File-start h must stay in the note and consume its count.
            g_noteNormalCaret = 0;
            OnEnterNoteNormalMode();
            SendMessageW(g_hNoteEdit, WM_CHAR, L'2', 1);
            SendMessageW(g_hNoteEdit, WM_CHAR, L'h', 1);
            valid = valid && g_noteNormalMode && g_noteNormalCaret == 0 &&
                !ClearNoteNormalPendingState() && GetFocus() == g_hNoteEdit;
            g_noteNormalCaret = normalPosition;
            OnEnterNoteNormalMode();
            valid = valid && ObserveNoteRenderRuntime().canonicalRevision == beforeVimNavigation.canonicalRevision;
            AppendUiAutomationTrace(L"math_render:vim_keyboard_contract raw=" +
                std::to_wstring(rawPreference) + L" valid=" + std::to_wstring(valid));
            SendMessageW(g_hNoteEdit, WM_CHAR, L'/', 1);
            HWND searchEdit = GetFocus();
            EnforceImePolicyForWindow(searchEdit);
            HIMC searchContext = ImmGetContext(searchEdit);
            valid = valid && IsNoteCmdlineActive() && searchEdit != g_hNoteEdit && searchContext &&
                CaptureNoteInputStatusText() ==
                    expectedStatus(L"note.assist.target.note_search", L"note.assist.input.search");
            if (searchContext) ImmReleaseContext(searchEdit, searchContext);
            SendMessageW(searchEdit, WM_KEYDOWN, VK_ESCAPE, 1);
            valid = valid && !IsNoteCmdlineActive() && GetFocus() == g_hNoteEdit && g_noteNormalMode;
            SendMessageW(g_hNoteEdit, WM_CHAR, L'i', 1);
            MSG enterInsert{};
            const bool queuedInsert = PeekMessageW(&enterInsert, owner,
                kMsgNoteEnterInsertMode, kMsgNoteEnterInsertMode, PM_REMOVE) != FALSE;
            if (queuedInsert) DispatchMessageW(&enterInsert);
            valid = valid && queuedInsert;
            SendMessageW(g_hNoteEdit, EM_GETSEL, reinterpret_cast<WPARAM>(&start), reinterpret_cast<LPARAM>(&end));
            valid = valid && !g_noteNormalMode && GetFocus() == g_hNoteEdit &&
                start == normalPosition && end == normalPosition;
            HIMC insertContext = ImmGetContext(g_hNoteEdit);
            const auto insertSnapshot = CaptureNoteUiSnapshot();
            valid = valid && insertContext && insertSnapshot.finalFrameActive &&
                insertSnapshot.finalRawLineCount > 0 && CaptureNoteInputStatusText() ==
                expectedStatus(L"note.assist.target.note", L"note.assist.input.insert");
            if (insertContext) ImmReleaseContext(g_hNoteEdit, insertContext);
            SetFocus(g_hPdfView);
            valid = valid && CaptureNoteInputStatusText().find(
                localization::Text(L"note.assist.focus_window") + L": " +
                localization::Text(L"note.assist.target.pdf")) != std::wstring::npos;
            const uint64_t paneMoveRevision = ObserveNoteRenderRuntime().canonicalRevision;
            valid = sendPdfCtrlJ() && valid;
            valid = valid && g_noteNormalMode && GetFocus() == g_hNoteEdit &&
                g_noteNormalCaret == normalPosition &&
                ObserveNoteRenderRuntime().canonicalRevision == paneMoveRevision &&
                CaptureNoteInputStatusText() ==
                    expectedStatus(L"note.assist.target.note", L"note.assist.input.normal");
            HIMC returnedContext = ImmGetContext(g_hNoteEdit);
            valid = valid && !returnedContext;
            if (returnedContext) ImmReleaseContext(g_hNoteEdit, returnedContext);
            AppendUiAutomationTrace(L"math_render:pdf_ctrl_j_normal raw=" +
                std::to_wstring(rawPreference) + L" valid=" + std::to_wstring(valid));
            FocusNoteEditAtNormalCaret();
            AppendUiAutomationTrace(L"math_render:vim_focus_ime_status raw=" +
                std::to_wstring(rawPreference) + L" valid=" + std::to_wstring(valid));
        }
        g_noteVimModeEnabled = false;
        g_noteNormalMode = false;
        OnExitNoteNormalMode();
        SetFocus(g_hPdfView);
        const uint64_t standardPaneMoveRevision = ObserveNoteRenderRuntime().canonicalRevision;
        valid = sendPdfCtrlJ() && valid;
        HIMC standardContext = ImmGetContext(g_hNoteEdit);
        valid = valid && !g_noteNormalMode && GetFocus() == g_hNoteEdit && standardContext &&
            ObserveNoteRenderRuntime().canonicalRevision == standardPaneMoveRevision &&
            CaptureNoteInputStatusText().find(localization::Text(L"note.assist.input.standard")) !=
                std::wstring::npos;
        if (standardContext) ImmReleaseContext(g_hNoteEdit, standardContext);
        AppendUiAutomationTrace(L"math_render:pdf_ctrl_j_standard valid=" + std::to_wstring(valid));
        g_noteVimModeEnabled = savedVim;
        g_noteNormalMode = savedNormal;
        g_noteVimCaretLineRawTextVisible = savedRawPreference;
        OnExitNoteNormalMode();
        SetFocus(g_hNoteEdit);
        SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_F24, 1);
        return valid;
    }();
    if (!vimVerticalValid) {
        // Keep this failure authoritative, but do not prevent unrelated EOF,
        // deletion, IME and long-note regressions from producing evidence.
        AppendUiAutomationTrace(L"math_render:vim_vertical_failed_deferred");
    } else {
        AppendUiAutomationTrace(L"math_render:vim_vertical_ok");
    }
    const std::wstring backspaceProbe = L"final-backspace-probe";
    SetFocus(g_hNoteEdit);
    SendMessageW(g_hNoteEdit, EM_SETSEL, static_cast<WPARAM>(localEditAnchorEnd),
                 static_cast<LPARAM>(localEditAnchorEnd));
    if (!SendUiAutomationNoteTextInput(backspaceProbe) ||
        FindNoteTextSnippetStart(backspaceProbe) < 0 ||
        !verifyLocalHybridMutation(L"ordinary typing") ||
        !CaptureNoteUiSnapshot().currentLineHighlightPainted) {
        restorePrevious();
        if (outError && outError->empty()) {
            *outError = L"Could not insert the Backspace render probe.";
        }
        return false;
    }
    for (size_t remaining = backspaceProbe.size(); remaining > 0; --remaining) {
        if (!SendUiAutomationNoteBackspace(1) || !verifyLocalHybridMutation(L"one Backspace")) {
            restorePrevious();
            if (outError && outError->empty()) {
                *outError = L"Backspace did not preserve a local final-frame owner.";
            }
            return false;
        }
        // A physical Backspace also produces a translated character and a
        // key-up. RichEdit has already deleted on key-down, so those no-op
        // messages must retain the current hybrid frame and revision.
        const auto afterKey = ObserveNoteRenderRuntime();
        SendMessageW(g_hNoteEdit, WM_CHAR, L'\b', 1);
        if (!verifyLocalHybridMutation(L"paired Backspace character") ||
            ObserveNoteRenderRuntime().canonicalRevision != afterKey.canonicalRevision ||
            ObserveNoteRenderRuntime().modelMaterializations != afterKey.modelMaterializations) {
            restorePrevious();
            if (outError && outError->empty()) *outError = L"Paired Backspace character changed canonical text twice.";
            return false;
        }
        SendMessageW(g_hNoteEdit, WM_KEYUP, VK_BACK, 0xC0000001);
        if (!verifyLocalHybridMutation(L"Backspace key-up")) {
            restorePrevious();
            return false;
        }
        if (remaining == backspaceProbe.size()) {
            const uint64_t stableRevision = CurrentEditRevision();
            SendMessageW(owner, WM_COMMAND,
                         MAKEWPARAM(GetDlgCtrlID(g_hNoteEdit), EN_CHANGE),
                         reinterpret_cast<LPARAM>(g_hNoteEdit));
            if (CurrentEditRevision() != stableRevision ||
                !verifyLocalHybridMutation(L"delayed no-op Backspace notification")) {
                restorePrevious();
                if (outError && outError->empty()) *outError = L"A delayed no-op notification accepted an unused Backspace ticket.";
                return false;
            }
            // Tab's translated character is deliberately ignored: indentation
            // belongs to key-down. Its early return must also close the frame.
            SendMessageW(g_hNoteEdit, WM_CHAR, L'\t', 1);
            if (CurrentEditRevision() != stableRevision ||
                !verifyLocalHybridMutation(L"ignored Tab character")) {
                restorePrevious();
                return false;
            }
        }
    }
    if (GetNoteAutomationIndexingText() != pristineMathText) {
        restorePrevious();
        if (outError) *outError = L"Backspace render probe did not restore the original note text.";
        return false;
    }

    if (!SelectNoteTextSnippet(L"a + b")) {
        restorePrevious();
        if (outError) *outError = L"Could not select the final-frame selection-replacement fixture.";
        return false;
    }
    // One input character makes this one Replace history operation.  Multi-
    // character typing deliberately consists of a replace followed by normal
    // typing operations, which the general undo/redo scenario covers.
    const std::wstring selectionReplacement = L"@";
    if (!SendUiAutomationNoteTextInput(selectionReplacement) ||
        FindNoteTextSnippetStart(selectionReplacement) < 0 ||
        !verifyLocalHybridMutation(L"typing over a selection")) {
        restorePrevious();
        if (outError && outError->empty()) {
            *outError = L"Typing over a selection did not reach the final rendering path.";
        }
        return false;
    }
    const bool selectionUndoChanged = SendUiAutomationNoteUndoChangedText();
    const bool selectionSourceRestored = FindNoteTextSnippetStart(L"a + b") >= 0;
    const bool selectionReplacementRemoved = FindNoteTextSnippetStart(selectionReplacement) < 0;
    const bool selectionUndoHybrid =
        verifyLocalHybridMutation(L"selection-replacement undo");
    if (!selectionUndoChanged || !selectionSourceRestored || !selectionReplacementRemoved ||
        !selectionUndoHybrid) {
        restorePrevious();
        if (outError && outError->empty()) {
            *outError = L"Undo did not restore the selected source through the final rendering path: "
                        L"changed=" + std::to_wstring(selectionUndoChanged ? 1 : 0) +
                        L" source=" + std::to_wstring(selectionSourceRestored ? 1 : 0) +
                        L" replacement_removed=" +
                        std::to_wstring(selectionReplacementRemoved ? 1 : 0) +
                        L" hybrid=" + std::to_wstring(selectionUndoHybrid ? 1 : 0);
        }
        return false;
    }
    if (!SendUiAutomationNoteRedoChangedText() ||
        FindNoteTextSnippetStart(selectionReplacement) < 0 ||
        !verifyLocalHybridMutation(L"selection-replacement redo")) {
        restorePrevious();
        if (outError && outError->empty()) {
            *outError = L"Redo did not restore the selected replacement through the final rendering path.";
        }
        return false;
    }
    if (!SendUiAutomationNoteUndoChangedText() || GetNoteAutomationIndexingText() != pristineMathText ||
        !verifyLocalHybridMutation(L"selection-replacement restoration")) {
        restorePrevious();
        if (outError && outError->empty()) {
            *outError = L"Final undo did not restore the pristine selection-replacement fixture.";
        }
        return false;
    }

    // A hard break changes following-row geometry. It must synchronously
    // republish a complete/hybrid final frame, never leave a stale overlay or
    // whole note raw. Undo the user edit rather than reloading this same
    // dirty file: a normal file-open must preserve unsaved current content
    // and is therefore not a valid way to discard the probe.
    SetFocus(g_hNoteEdit);
    SendMessageW(g_hNoteEdit, EM_SETSEL, static_cast<WPARAM>(localEditAnchorEnd),
                 static_cast<LPARAM>(localEditAnchorEnd));
    // RichEdit handles Enter at the key stage. Include the translated
    // character too, as a real key press does; Markdown list continuation
    // consumes that character after performing its replacement at keydown.
    SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_RETURN, 1);
    SendMessageW(g_hNoteEdit, WM_CHAR, static_cast<WPARAM>(L'\r'), 0);
    SendMessageW(g_hNoteEdit, WM_KEYUP, VK_RETURN, 1);
    const bool hardBreakChangedText = GetNoteAutomationIndexingText() != pristineMathText;
    const bool hardBreakHybrid = verifyLocalHybridMutation(L"a hard-break edit");
    const bool hardBreakUndoChanged = hardBreakChangedText && hardBreakHybrid &&
        SendUiAutomationNoteUndoChangedText();
    const bool hardBreakUndoRestored = hardBreakUndoChanged &&
        GetNoteAutomationIndexingText() == pristineMathText;
    const bool hardBreakUndoHybrid = hardBreakUndoRestored &&
        verifyLocalHybridMutation(L"hard-break undo");
    if (!hardBreakChangedText || !hardBreakHybrid || !hardBreakUndoChanged ||
        !hardBreakUndoRestored || !hardBreakUndoHybrid) {
        restorePrevious();
        if (outError && outError->empty()) {
            *outError = L"A hard-break render edit did not round-trip through final publication: "
                        L"changed=" + std::to_wstring(hardBreakChangedText ? 1 : 0) +
                        L" hybrid=" + std::to_wstring(hardBreakHybrid ? 1 : 0) +
                        L" undo_changed=" + std::to_wstring(hardBreakUndoChanged ? 1 : 0) +
                        L" restored=" + std::to_wstring(hardBreakUndoRestored ? 1 : 0) +
                        L" undo_hybrid=" + std::to_wstring(hardBreakUndoHybrid ? 1 : 0);
        }
        return false;
    }

    // A scrollbar range change can synchronously dispatch WM_SIZE from the
    // RichEdit transport. Exercise an actual narrow/tall transition rather
    // than merely sending a synthetic size message: final/native ownership
    // must republish once without reviving a legacy overlay or blocking the
    // UI thread in a SetScrollInfo -> WM_SIZE loop.
    auto verifyFinalResizeRoundTrip = [&]() -> bool {
        if (!g_hNoteEdit || !IsWindow(g_hNoteEdit)) return false;
        RECT originalScreen{};
        if (!GetWindowRect(g_hNoteEdit, &originalScreen)) return false;
        HWND noteParent = GetParent(g_hNoteEdit);
        if (!noteParent) return false;
        RECT original = originalScreen;
        MapWindowPoints(HWND_DESKTOP, noteParent,
                        reinterpret_cast<LPPOINT>(&original), 2);
        const int originalWidth = std::max(1, static_cast<int>(original.right - original.left));
        const int originalHeight = std::max(1, static_cast<int>(original.bottom - original.top));
        const NoteUiSnapshot beforeResize = CaptureNoteUiSnapshot();
        const auto restoreBounds = [&]() {
            SetWindowPos(g_hNoteEdit, nullptr, original.left, original.top,
                         originalWidth, originalHeight,
                         SWP_NOACTIVATE | SWP_NOZORDER);
        };
        // A single transition catches a direct recursion, but repeated
        // narrow/restore pairs catch a guard that was only accidentally
        // cleared after the first nested notification.  Keep every geometry
        // deliberately small enough to alter both RichEdit's format rect and
        // the final scrollbar page size.
        constexpr int kResizeRoundTrips = 4;
        for (int pass = 0; pass < kResizeRoundTrips; ++pass) {
            const int divisor = (pass % 2 == 0) ? 2 : 3;
            const int narrowWidth = std::max(1, originalWidth / divisor);
            const int narrowHeight = std::max(
                1, std::min(originalHeight, 64 + pass * 16));
            if (!SetWindowPos(g_hNoteEdit, nullptr, original.left, original.top,
                              narrowWidth, narrowHeight,
                              SWP_NOACTIVATE | SWP_NOZORDER)) {
                restoreBounds();
                return false;
            }
            RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
            const NoteUiSnapshot narrowed = CaptureNoteUiSnapshot();
            SCROLLINFO narrowedVertical{};
            narrowedVertical.cbSize = sizeof(narrowedVertical);
            narrowedVertical.fMask = SIF_RANGE | SIF_PAGE | SIF_POS;
            const bool narrowedScrollValid =
                GetScrollInfo(g_hNoteEdit, SB_VERT, &narrowedVertical) != 0 &&
                narrowedVertical.nMax >= narrowedVertical.nMin;
            // Observe event completion BEFORE painting or another input can
            // repair it. A wheel keeps its source caret but moves client Y;
            // a scrollbar has the same contract, even if the caret leaves
            // the viewport. There is no live preedit in this prediction test.
            const auto verifyScrollCompletion = [&](UINT message, WPARAM command) {
                const auto before = CaptureNoteUiSnapshot();
                const auto beforeRuntime = ObserveNoteRenderRuntime();
                SendMessageW(g_hNoteEdit, message, command, 0);
                const auto after = CaptureNoteUiSnapshot();
                const auto afterRuntime = ObserveNoteRenderRuntime();
                GUITHREADINFO info{};
                info.cbSize = sizeof(info);
                const bool haveCaret = GetGUIThreadInfo(GetCurrentThreadId(), &info) != FALSE;
                bool valid = after.finalFrameActive && after.systemCaretMatchesFinal &&
                    VerifyAccessibleSystemCaretForAutomation(g_hNoteEdit) &&
                    after.canonicalText == before.canonicalText &&
                    afterRuntime.canonicalRevision == beforeRuntime.canonicalRevision &&
                    afterRuntime.modelMaterializations == beforeRuntime.modelMaterializations;
                RECT client{};
                GetClientRect(g_hNoteEdit, &client);
                const auto& caret = after.finalCaretClientRect;
                if (valid && caret.top < client.bottom && caret.bottom > client.top) {
                    HIMC imc = ImmGetContext(g_hNoteEdit);
                    if (imc) {
                        CANDIDATEFORM candidate{};
                        const bool read = ImmGetCandidateWindow(imc, 0, &candidate) != FALSE;
                        ImmReleaseContext(g_hNoteEdit, imc);
                        HDC dc = GetDC(g_hNoteEdit);
                        const int dpi = dc ? GetDeviceCaps(dc, LOGPIXELSY) : 96;
                        if (dc) ReleaseDC(g_hNoteEdit, dc);
                        const int gap = std::max(1, MulDiv(6, dpi > 0 ? dpi : 96, 96));
                        valid = !IsNoteImeComposing() && read && candidate.dwStyle == CFS_EXCLUDE &&
                            candidate.ptCurrentPos.x == std::clamp(caret.left, client.left, client.right - 1) &&
                            candidate.ptCurrentPos.y == std::clamp(caret.top, client.top, client.bottom - 1) &&
                            candidate.rcArea.top == std::max(client.top, after.finalCaretLineClientRect.top) - gap &&
                            candidate.rcArea.bottom == std::min(client.bottom, after.finalCaretLineClientRect.bottom) + gap;
                    }
                }
                valid = valid && verifyImeCharacterQuery();
                AppendUiAutomationTrace(L"math_render:scroll_before_paint message=" + std::to_wstring(message) +
                    L" valid=" + std::to_wstring(valid) + L" final_y=" +
                    std::to_wstring(after.finalCaretClientRect.top) + L" native_y=" +
                    std::to_wstring(haveCaret ? info.rcCaret.top : LONG_MAX));
                return valid;
            };
            if (!verifyScrollCompletion(WM_MOUSEWHEEL, MAKEWPARAM(0, static_cast<WORD>(-WHEEL_DELTA))) ||
                !verifyScrollCompletion(WM_VSCROLL, SB_TOP) ||
                !verifyScrollCompletion(WM_VSCROLL, SB_LINEDOWN) ||
                !verifyScrollCompletion(WM_MOUSEHWHEEL, MAKEWPARAM(0, static_cast<WORD>(WHEEL_DELTA))) ||
                !verifyScrollCompletion(WM_HSCROLL, SB_LEFT) ||
                !verifyScrollCompletion(WM_MOUSEWHEEL, MAKEWPARAM(MK_SHIFT, static_cast<WORD>(WHEEL_DELTA)))) {
                restoreBounds();
                if (outError) *outError = L"Scrolling retained old system caret coordinates until another event/paint.";
                return false;
            }
            // Scrolling must move the caret with the content, not clamp it
            // to the viewport's top edge. Windows clips its off-screen caret.
            SendMessageW(g_hNoteEdit, WM_VSCROLL, SB_BOTTOM, 0);
            RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
            const NoteUiSnapshot scrolled = CaptureNoteUiSnapshot();
            SCROLLINFO bottomScroll{};
            bottomScroll.cbSize = sizeof(bottomScroll);
            bottomScroll.fMask = SIF_RANGE | SIF_PAGE | SIF_POS;
            bool stableBottom = GetScrollInfo(g_hNoteEdit, SB_VERT, &bottomScroll) != FALSE &&
                bottomScroll.nPos == std::max(0, bottomScroll.nMax -
                    static_cast<int>(bottomScroll.nPage) + 1);
            const auto bottomObservation = ObserveNoteRenderRuntime();
            for (int wheel = 0; wheel < 12 && stableBottom; ++wheel) {
                SendMessageW(g_hNoteEdit, WM_MOUSEWHEEL,
                    MAKEWPARAM(0, static_cast<WORD>(-WHEEL_DELTA)), 0);
                // A real wheel gesture also delivers pointer motion. Neither
                // this nor a size-only publication may reveal an unmoved caret.
                SendMessageW(g_hNoteEdit, WM_MOUSEMOVE, 0, MAKELPARAM(16 + wheel, 16));
                SendMessageW(g_hNoteEdit, WM_SIZE, SIZE_RESTORED,
                    MAKELPARAM(narrowWidth, narrowHeight));
                RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
                SCROLLINFO current = bottomScroll;
                const auto observation = ObserveNoteRenderRuntime();
                stableBottom = GetScrollInfo(g_hNoteEdit, SB_VERT, &current) != FALSE &&
                    current.nPos == bottomScroll.nPos && observation.finalFrameActive &&
                    observation.canonicalRevision == bottomObservation.canonicalRevision &&
                    observation.modelMaterializations == bottomObservation.modelMaterializations;
                if (!stableBottom) {
                    AppendUiAutomationTrace(L"math_render:bottom_unstable wheel=" +
                        std::to_wstring(wheel) + L" pos=" + std::to_wstring(bottomScroll.nPos) +
                        L"->" + std::to_wstring(current.nPos) + L" revision=" +
                        std::to_wstring(bottomObservation.canonicalRevision) + L"->" +
                        std::to_wstring(observation.canonicalRevision) + L" models=" +
                        std::to_wstring(bottomObservation.modelMaterializations) + L"->" +
                        std::to_wstring(observation.modelMaterializations));
                }
            }
            // Even Home at the same source offset must reveal the caret after
            // manual scrolling; a passive-publication guard cannot block input.
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_HOME, 0);
            SendMessageW(g_hNoteEdit, WM_KEYUP, VK_HOME, 0);
            SendMessageW(g_hNoteEdit, WM_VSCROLL, SB_BOTTOM, 0);
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_HOME, 0);
            SendMessageW(g_hNoteEdit, WM_KEYUP, VK_HOME, 0);
            RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
            const NoteUiSnapshot resumed = CaptureNoteUiSnapshot();
            const bool keyboardRevealedCaret = resumed.finalFrameActive &&
                resumed.systemCaretMatchesFinal && resumed.finalCaretClientRect.top >= 0 &&
                resumed.finalCaretClientRect.bottom <= static_cast<int>(narrowedVertical.nPage);
            restoreBounds();
            RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
            const NoteUiSnapshot restored = CaptureNoteUiSnapshot();
            if (!narrowed.finalFrameActive || narrowed.finalStructuredLineCount == 0 ||
                narrowed.finalRawLineCount != beforeResize.finalRawLineCount || !narrowedScrollValid ||
                !stableBottom || !keyboardRevealedCaret ||
                !scrolled.finalFrameActive || !scrolled.systemCaretMatchesFinal ||
                scrolled.finalCaretClientRect.top >= 0 ||
                !restored.finalFrameActive || restored.finalStructuredLineCount == 0 ||
                restored.finalRawLineCount != beforeResize.finalRawLineCount) {
                AppendUiAutomationTrace(L"math_render:resize_failed before_raw=" +
                    std::to_wstring(beforeResize.finalRawLineCount) + L" narrow_raw=" +
                    std::to_wstring(narrowed.finalRawLineCount) + L" restored_raw=" +
                    std::to_wstring(restored.finalRawLineCount) + L" scroll=" +
                    std::to_wstring(narrowedScrollValid) + L" bottom=" +
                    std::to_wstring(stableBottom) + L" reveal=" +
                    std::to_wstring(keyboardRevealedCaret) + L" scrolled_top=" +
                    std::to_wstring(scrolled.finalCaretClientRect.top) + L" bottom_pos:max:page=" +
                    std::to_wstring(bottomScroll.nPos) + L":" + std::to_wstring(bottomScroll.nMax) +
                    L":" + std::to_wstring(bottomScroll.nPage) + L" pass=" +
                    std::to_wstring(pass) + L" scrolled=" +
                    DescribeNoteUiSnapshot(scrolled));
                return false;
            }
        }
        // A collapsed pane has no paintable pixels. Its valid publication
        // must survive that no-op paint and become usable again on restore.
        if (!SetWindowPos(g_hNoteEdit, nullptr, original.left, original.top,
                          originalWidth, 1, SWP_NOACTIVATE | SWP_NOZORDER)) {
            restoreBounds();
            return false;
        }
        RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
        const NoteUiSnapshot collapsed = CaptureNoteUiSnapshot();
        restoreBounds();
        RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
        return collapsed.finalFrameActive && CaptureNoteUiSnapshot().finalFrameActive;
    };
    if (!verifyFinalResizeRoundTrip()) {
        restorePrevious();
        if (outError) {
            *outError =
                L"Final note rendering did not survive a narrow resize/scrollbar round trip.";
        }
        return false;
    }

    // This exercises only the Win32 cancellation protocol, not a real IME
    // candidate UI: START followed by a flag-free COMPOSITION must restore
    // final ownership without relying on a later END notification.
    const std::wstring beforeImeCancellation = GetNoteAutomationIndexingText();
    SendMessageW(g_hNoteEdit, WM_IME_STARTCOMPOSITION, 0, 0);
    SendMessageW(g_hNoteEdit, WM_IME_COMPOSITION, 0, 0);
    RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
    const NoteUiSnapshot cancelledIme = CaptureNoteUiSnapshot();
    SendMessageW(g_hNoteEdit, WM_IME_ENDCOMPOSITION, 0, 0);
    if (!cancelledIme.finalFrameActive || cancelledIme.finalStructuredLineCount == 0 ||
        !cancelledIme.systemCaretMatchesFinal ||
        GetNoteAutomationIndexingText() != beforeImeCancellation) {
        restorePrevious();
        if (outError) *outError = L"IME cancellation stranded native fallback or changed canonical note text.";
        return false;
    }

    // Exercise real native EN_CHANGE notifications and the common acceptance
    // boundary, not a real IMM candidate UI. Provisional mutations cannot
    // enter canonical history; a partial result is independently undoable
    // after the remaining composition is cancelled.
    // A restored composition and a delayed EN_CHANGE are not a user edit.
    // Check both flag-free cancellation and END-only native cleanup, including
    // dirty/revision/redo state rather than merely equal visible strings.
    const auto verifyImeCancellationNoop = [&](bool flagFreeCancel) -> bool {
        SetFocus(g_hNoteEdit);
        const auto before = CaptureNoteUiSnapshot();
        const uint64_t revision = CurrentEditRevision();
        const bool dirty = g_noteDirty;
        const bool needsIntegrate = g_noteNeedsIntegrate;
        const bool redo = CanExecuteNoteUndoRedoFromFocus(false);
        SendMessageW(g_hNoteEdit, EM_SETSEL, localEditAnchorEnd, localEditAnchorEnd);
        SendMessageW(g_hNoteEdit, WM_IME_STARTCOMPOSITION, 0, 0);
        SendMessageW(g_hNoteEdit, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(L"仮"));
        SendMessageW(g_hNoteEdit, EM_SETSEL, localEditAnchorEnd, localEditAnchorEnd + 1);
        SendMessageW(g_hNoteEdit, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(L""));
        if (flagFreeCancel) SendMessageW(g_hNoteEdit, WM_IME_COMPOSITION, 0, 0);
        SendMessageW(g_hNoteEdit, WM_IME_ENDCOMPOSITION, 0, 0);
        SendMessageW(owner, WM_COMMAND,
            MAKEWPARAM(GetDlgCtrlID(g_hNoteEdit), EN_CHANGE), reinterpret_cast<LPARAM>(g_hNoteEdit));
        const auto after = CaptureNoteUiSnapshot();
        const bool unchanged = before.canonicalText == after.canonicalText &&
            CurrentEditRevision() == revision && g_noteDirty == dirty &&
            g_noteNeedsIntegrate == needsIntegrate &&
            CanExecuteNoteUndoRedoFromFocus(false) == redo && after.finalFrameActive &&
            after.systemCaretMatchesFinal && !IsNoteImeCanonicalChangeDeferred(g_hNoteEdit);
        AppendUiAutomationTrace(L"math_render:ime_cancel_noop flags=" +
            std::to_wstring(flagFreeCancel) + L" unchanged=" + std::to_wstring(unchanged));
        return unchanged;
    };
    if (!verifyImeCancellationNoop(true) || !verifyImeCancellationNoop(false)) {
        restorePrevious();
        if (outError) *outError = L"IME cancellation or a delayed notification changed revision, dirty state or redo history.";
        return false;
    }

    const auto verifyImeCanonicalOwnership = [&](bool rawPresentation, int insertion) -> bool {
        g_noteRawOnly = rawPresentation;
        UpdateNoteViewMode();
        SetFocus(g_hNoteEdit);
        const std::wstring original = GetNoteAutomationIndexingText();
        // The automation helper retains one CR per RichEdit hard break for
        // EM_SETSEL coordinates. Canonical text uses one LF at that boundary.
        std::wstring canonicalOriginal = original;
        std::replace(canonicalOriginal.begin(), canonicalOriginal.end(), L'\r', L'\n');
        SendMessageW(g_hNoteEdit, EM_SETSEL, insertion, insertion);
        SendMessageW(g_hNoteEdit, WM_IME_STARTCOMPOSITION, 0, 0);
        SendMessageW(g_hNoteEdit, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(L"仮"));
        RecordCurrentNoteTextEditForUndo(g_hNoteEdit);
        ResetNoteEditHistorySnapshot(g_hNoteEdit);
        const bool deferred = IsNoteImeCanonicalChangeDeferred(g_hNoteEdit) &&
            CaptureNoteUiSnapshot().canonicalText == canonicalOriginal;
        SendMessageW(g_hNoteEdit, EM_SETSEL, insertion, insertion + 1);
        SendMessageW(g_hNoteEdit, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(L"確未"));
        // Refresh unavailability in raw mode must not close the input anchor.
        SendMessageW(g_hNoteEdit, WM_SIZE, 0, 0);
        note::NoteImePreeditPayload remaining;
        remaining.text = L"未";
        remaining.caret = {1};
        const bool accepted = deferred &&
            AcceptNoteImeResultWithContinuation(g_hNoteEdit, L"確", remaining);
        std::wstring committed = original;
        committed.insert(static_cast<size_t>(insertion), L"確");
        std::wstring canonicalCommitted = canonicalOriginal;
        canonicalCommitted.insert(static_cast<size_t>(insertion), L"確");
        const NoteUiSnapshot partial = CaptureNoteUiSnapshot();
        AppendUiAutomationTrace(L"math_render:ime_partial_frame active=" +
            std::to_wstring(partial.finalFrameActive) + L" structured=" +
            std::to_wstring(partial.finalStructuredLineCount) + L" caret=" +
            std::to_wstring(partial.systemCaretMatchesFinal));
        const bool presentationExact = rawPresentation ? !partial.finalFrameActive :
            partial.finalFrameActive && partial.finalStructuredLineCount > 0 && partial.systemCaretMatchesFinal;
        bool characterQueryExact = true;
        if (accepted && !rawPresentation) {
            const auto runtimeBefore = ObserveNoteRenderRuntime();
            IMECHARPOSITION start{};
            start.dwSize = sizeof(start);
            IMECHARPOSITION end = start;
            end.dwCharPos = 1;
            POINT expected{partial.finalCaretClientRect.left, partial.finalCaretClientRect.top};
            characterQueryExact = ClientToScreen(g_hNoteEdit, &expected) &&
                SendMessageW(g_hNoteEdit, WM_IME_REQUEST, IMR_QUERYCHARPOSITION,
                    reinterpret_cast<LPARAM>(&start)) != 0 &&
                SendMessageW(g_hNoteEdit, WM_IME_REQUEST, IMR_QUERYCHARPOSITION,
                    reinterpret_cast<LPARAM>(&end)) != 0 &&
                end.pt.x == expected.x && end.pt.y == expected.y &&
                start.pt.x < end.pt.x && start.pt.y == end.pt.y &&
                start.cLineHeight == end.cLineHeight;
            IMECHARPOSITION outside = end;
            outside.dwCharPos = 2;
            const IMECHARPOSITION originalOutside = outside;
            characterQueryExact = characterQueryExact &&
                SendMessageW(g_hNoteEdit, WM_IME_REQUEST, IMR_QUERYCHARPOSITION,
                    reinterpret_cast<LPARAM>(&outside)) == 0 &&
                std::memcmp(&outside, &originalOutside, sizeof(outside)) == 0;
            const auto runtimeAfter = ObserveNoteRenderRuntime();
            characterQueryExact = characterQueryExact && runtimeAfter.finalFrameActive &&
                runtimeBefore.canonicalRevision == runtimeAfter.canonicalRevision &&
                runtimeBefore.modelMaterializations == runtimeAfter.modelMaterializations;
            AppendUiAutomationTrace(L"math_render:ime_preedit_character_query valid=" +
                std::to_wstring(characterQueryExact));
        }
        const bool partialExact = accepted && partial.canonicalText == canonicalCommitted &&
            presentationExact && characterQueryExact && IsNoteImeCanonicalChangeDeferred(g_hNoteEdit);
        const bool rejectsMismatch = accepted &&
            !AcceptNoteImeResultWithContinuation(g_hNoteEdit, L"誤", remaining) &&
            CaptureNoteUiSnapshot().canonicalText == canonicalCommitted;
        SendMessageW(g_hNoteEdit, EM_SETSEL, insertion + 1, insertion + 2);
        SendMessageW(g_hNoteEdit, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(L""));
        SendMessageW(g_hNoteEdit, WM_IME_ENDCOMPOSITION, 0, 0);
        const bool cancelledRemainder = GetNoteAutomationIndexingText() == committed &&
            CaptureNoteUiSnapshot().canonicalText == canonicalCommitted &&
            !IsNoteImeCanonicalChangeDeferred(g_hNoteEdit);
        const bool resultUndo = accepted && cancelledRemainder &&
            SendUiAutomationNoteUndoChangedText() &&
            GetNoteAutomationIndexingText() == original &&
            CaptureNoteUiSnapshot().canonicalText == canonicalOriginal;
        AppendUiAutomationTrace(L"math_render:ime_canonical_ownership raw=" +
            std::to_wstring(rawPresentation) + L" deferred=" +
            std::to_wstring(deferred) + L" partial=" + std::to_wstring(partialExact) +
            L" mismatch=" + std::to_wstring(rejectsMismatch) +
            L" cancel=" + std::to_wstring(cancelledRemainder) +
            L" undo=" + std::to_wstring(resultUndo));
        return deferred && partialExact && rejectsMismatch && cancelledRemainder && resultUndo;
    };
    if (!verifyImeCanonicalOwnership(false, localEditAnchorEnd) ||
        !verifyImeCanonicalOwnership(true, localEditAnchorEnd)) {
        restorePrevious();
        if (outError) *outError = L"IME preedit or partial-result notifications violated canonical text/history ownership.";
        return false;
    }
    g_noteRawOnly = false;
    UpdateNoteViewMode();

    // A short resized note cannot prove geometry after a large accumulated
    // native/final height difference. Prefix 1,408 source rows, then query the
    // original input line near the end through navigation, scrolling and a
    // partial-result preedit. Undo the fixture edit before all later probes.
    const std::wstring beforeLongIme = GetNoteAutomationIndexingText();
    std::wstring longPrefix;
    for (int block = 0; block < 128; ++block) {
        longPrefix += L"## Long IME heading " + std::to_wstring(block) + L"\n\n"
            L"Paragraph with **bold** and `code`.\n\n"
            L"$$\\frac{1}{2}$$\n\n"
            L"| Item | Example |\n| --- | --- |\n| row | `value` |\n\n\n";
    }
    InsertSnippetIntoNoteAt(0, longPrefix);
    const int longAnchor = FindNoteTextSnippetStart(localEditAnchor);
    bool longImeValid = longAnchor >= 0;
    if (longImeValid) {
        SetFocus(g_hNoteEdit);
        SendMessageW(g_hNoteEdit, EM_SETSEL, longAnchor, longAnchor);
        SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_F24, 1);
        SendMessageW(g_hNoteEdit, WM_KEYUP, VK_F24, 1);
        longImeValid = verifyImeCharacterQuery() && verifyImeCandidateRequests() &&
            ObserveNoteUiaCaretForAutomation(g_hNoteEdit);
        longImeValid = verifyRootMaximizeRoundTrip(true) && longImeValid;
        bool navigationAtomic = true;
        for (WPARAM key : {VK_LEFT, VK_RIGHT, VK_UP, VK_DOWN, VK_HOME, VK_END}) {
            const auto beforeNavigation = ObserveNoteRenderRuntime();
            const LONG_PTR beforeVisibleStyle = GetWindowLongPtrW(g_hNoteEdit, GWL_STYLE) & WS_VISIBLE;
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, key, 1);
            const auto afterNavigation = ObserveNoteRenderRuntime();
            navigationAtomic = beforeNavigation.finalFrameActive && afterNavigation.finalFrameActive &&
                afterNavigation.nativeRedrawDepth == 0 && afterNavigation.nativeRedrawRequested &&
                afterNavigation.nativeRedrawTransactions == beforeNavigation.nativeRedrawTransactions +
                    (beforeVisibleStyle != 0 ? 1 : 0) &&
                afterNavigation.clientPaintCount == beforeNavigation.clientPaintCount &&
                afterNavigation.canonicalRevision == beforeNavigation.canonicalRevision &&
                afterNavigation.modelMaterializations == beforeNavigation.modelMaterializations &&
                (GetWindowLongPtrW(g_hNoteEdit, GWL_STYLE) & WS_VISIBLE) == beforeVisibleStyle && navigationAtomic;
            longImeValid = verifyImeCharacterQuery() && ObserveNoteUiaCaretForAutomation(g_hNoteEdit) && longImeValid;
            SendMessageW(g_hNoteEdit, WM_KEYUP, key, 1);
        }
        // An independent outer owner can already have native redraw off.
        // Nested navigation/anchor work must not turn it back on.
        bool preservesOuterRedraw = true;
        SendMessageW(g_hNoteEdit, WM_SETREDRAW, FALSE, 0);
        for (WPARAM key : {VK_LEFT, VK_RIGHT}) {
            const auto beforeNavigation = ObserveNoteRenderRuntime();
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, key, 1);
            SendMessageW(g_hNoteEdit, WM_KEYUP, key, 1);
            const auto afterNavigation = ObserveNoteRenderRuntime();
            preservesOuterRedraw = !afterNavigation.nativeRedrawRequested &&
                afterNavigation.nativeRedrawDepth == 0 && afterNavigation.finalFrameActive &&
                afterNavigation.nativeRedrawTransactions == beforeNavigation.nativeRedrawTransactions && preservesOuterRedraw;
        }
        SendMessageW(g_hNoteEdit, WM_SETREDRAW, TRUE, 0);
        AppendUiAutomationTrace(L"math_render:navigation_atomic=" + std::to_wstring(navigationAtomic) +
            L" outer_redraw_preserved=" + std::to_wstring(preservesOuterRedraw));
        longImeValid = navigationAtomic && preservesOuterRedraw && longImeValid;
        for (WPARAM command : {SB_TOP, SB_BOTTOM, SB_LINEUP, SB_LINEDOWN}) {
            SendMessageW(g_hNoteEdit, WM_VSCROLL, command, 0);
            longImeValid = verifyImeCharacterQuery() && ObserveNoteUiaCaretForAutomation(g_hNoteEdit) && longImeValid;
        }
        SendMessageW(g_hNoteEdit, WM_MOUSEWHEEL,
            MAKEWPARAM(0, static_cast<WORD>(WHEEL_DELTA)), 0);
        longImeValid = verifyImeCharacterQuery() && longImeValid;
        longImeValid = verifyImeCanonicalOwnership(false,
            longAnchor + static_cast<int>(localEditAnchor.size())) && longImeValid;
        longImeValid = verifyEofHybridMutations() && longImeValid;
        longImeValid = verifyImeCanonicalOwnership(false,
            static_cast<int>(GetNoteAutomationIndexingText().size())) && longImeValid;
    }
    const bool longFixtureRestored = SendUiAutomationNoteUndoChangedText() &&
        GetNoteAutomationIndexingText() == beforeLongIme;
    AppendUiAutomationTrace(L"math_render:long_ime_geometry valid=" + std::to_wstring(longImeValid) +
        L" restored=" + std::to_wstring(longFixtureRestored) +
        L" prefix_length=" + std::to_wstring(longPrefix.size()));
    if (!longImeValid || !longFixtureRestored) {
        restorePrevious();
        if (outError) *outError = L"Long-note IME character geometry or fixture undo did not match final presentation.";
        return false;
    }

    const std::wstring tailAnchor = L"Inline dollar $x$";
    const std::wstring tailAppendFirst = L"TAILRENDERCHECKA";
    const std::wstring tailAppendSecond = L"TAILRENDERCHECKB";
    const std::wstring tailAppend = tailAppendFirst + tailAppendSecond;
    const int tailAnchorStart = FindNoteTextSnippetStart(tailAnchor);
    if (tailAnchorStart < 0) {
        restorePrevious();
        if (outError) *outError = L"Could not find the Markdown line used for trailing render testing.";
        return false;
    }
    InsertSnippetIntoNoteAt(static_cast<size_t>(tailAnchorStart) + tailAnchor.size(), tailAppendFirst);
    AppendUiAutomationTrace(L"math_render:after_first_tail_edit");
    RecomputeMathFromNote();
    InsertSnippetIntoNoteAt(static_cast<size_t>(tailAnchorStart) + tailAnchor.size() +
                                tailAppendFirst.size(),
                            tailAppendSecond);
    AppendUiAutomationTrace(L"math_render:after_second_tail_edit");
    // The UI harness must turn a render exception into a deterministic test
    // failure instead of letting an exception escape the window procedure.
    // The product route separately owns its recovery boundary; this records
    // which final-render transition needs that recovery if it regresses.
    try {
        RecomputeMathFromNote();
    } catch (const std::exception& ex) {
        restorePrevious();
        if (outError) {
            *outError = L"The second rendered-line refresh threw: " + UTF8ToWide(ex.what());
        }
        return false;
    } catch (...) {
        restorePrevious();
        if (outError) *outError = L"The second rendered-line refresh threw an unknown exception.";
        return false;
    }
    const NoteUiSnapshot tailSnapshot = CaptureNoteUiSnapshot();
    const bool tailVisible = tailSnapshot.renderedText.find(tailAppend) != std::wstring::npos;
    if (!SelectNoteTextSnippet(tailAppend)) {
        restorePrevious();
        if (outError) *outError = L"Could not select trailing render automation insertions for cleanup.";
        return false;
    }
    SendMessageW(g_hNoteEdit, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(L""));
    RecomputeMathFromNote();
    if (!SaveNoteIfDirty(owner)) {
        restorePrevious();
        if (outError) *outError = L"Could not reconcile the Markdown note after trailing render testing.";
        return false;
    }
    if (!tailVisible) {
        restorePrevious();
        if (outError) *outError = L"Text appended at a rendered line end was missing from the render cache.";
        return false;
    }

    // A long same-line edit must widen the final publication's horizontal
    // extent before the next paint. The final route may not obtain that width
    // from the retired raw-helper canvas; the observed range comes from the
    // immutable final frame after the accepted edit.
    const std::wstring pendingWidthProbe(192, L'W');
    const int pendingWidthAnchor = FindNoteTextSnippetStart(tailAnchor);
    if (pendingWidthAnchor < 0) {
        restorePrevious();
        if (outError) *outError = L"Could not find the pending-width render anchor.";
        return false;
    }
    const int pendingWidthInsertPos = pendingWidthAnchor + static_cast<int>(tailAnchor.size());
    SetFocus(g_hNoteEdit);
    SendMessageW(g_hNoteEdit, EM_SETSEL,
                 static_cast<WPARAM>(pendingWidthInsertPos),
                 static_cast<LPARAM>(pendingWidthInsertPos));
    if (!SendUiAutomationNoteTextInput(pendingWidthProbe)) {
        restorePrevious();
        if (outError) *outError = L"Could not enter the pending-width render probe.";
        return false;
    }
    AppendUiAutomationTrace(L"math_render:after_width_probe_input");
    SCROLLINFO pendingWidthScroll{};
    pendingWidthScroll.cbSize = sizeof(pendingWidthScroll);
    pendingWidthScroll.fMask = SIF_RANGE | SIF_PAGE;
    const bool pendingWidthExpanded =
        GetScrollInfo(g_hNoteEdit, SB_HORZ, &pendingWidthScroll) != 0 &&
        pendingWidthScroll.nMax >= static_cast<int>(pendingWidthScroll.nPage);
    if (!SelectNoteTextSnippet(pendingWidthProbe)) {
        restorePrevious();
        if (outError) *outError = L"Could not select the pending-width render probe for cleanup.";
        return false;
    }
    SendMessageW(g_hNoteEdit, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(L""));
    RecomputeMathFromNote();
    if (!SaveNoteIfDirty(owner)) {
        restorePrevious();
        if (outError) *outError = L"Could not reconcile the note after pending-width render testing.";
        return false;
    }
    if (!pendingWidthExpanded) {
        restorePrevious();
        if (outError) *outError = L"An accepted long edit did not expand the final render horizontal extent.";
        return false;
    }

    if (!SelectNoteTextSnippet(L"$x$")) {
        restorePrevious();
        if (outError) *outError = L"Could not select inline dollar math in the fixture note.";
        return false;
    }
    const NoteUiSnapshot inlineSnapshot = CaptureNoteUiSnapshot();
    if (!inlineSnapshot.selectedMathFound ||
        inlineSnapshot.selectedMathIsBlock ||
        inlineSnapshot.selectedMathDelimiter != L"$...$" ||
        inlineSnapshot.selectedMathNormalizedText != L"x") {
        restorePrevious();
        if (outError) {
            *outError =
                L"Inline dollar math selection was not reflected consistently in note UI state. " +
                DescribeNoteUiSnapshot(inlineSnapshot);
        }
        return false;
    }

    if (!SelectNoteTextSnippet(L"$$z$$")) {
        restorePrevious();
        if (outError) *outError = L"Could not select block dollar math in the fixture note.";
        return false;
    }
    const NoteUiSnapshot blockSnapshot = CaptureNoteUiSnapshot();
    if (!blockSnapshot.selectedMathFound ||
        !blockSnapshot.selectedMathIsBlock ||
        blockSnapshot.selectedMathDelimiter != L"$$...$$" ||
        blockSnapshot.selectedMathNormalizedText != L"z") {
        restorePrevious();
        if (outError) {
            *outError =
                L"Block dollar math selection was not reflected consistently in note UI state. " +
                DescribeNoteUiSnapshot(blockSnapshot);
        }
        return false;
    }

    for (const bool display : {false, true}) {
        const std::wstring snippet = display ? L"<math display='block'>\\frac{1}{2}</math>" : L"<math display=inline>x^2</>";
        if (!SelectNoteTextSnippet(snippet)) {
            restorePrevious();
            if (outError) *outError = L"Could not select named tag math in the fixture note.";
            return false;
        }
        const NoteUiSnapshot tagged = CaptureNoteUiSnapshot();
        if (!tagged.selectedMathFound || tagged.selectedMathIsBlock != display ||
            tagged.selectedMathDelimiter != (display ? L"<math>...</math>" : L"<math>...</>") ||
            tagged.selectedMathNormalizedText != (display ? L"\\frac{1}{2}" : L"x^2")) {
            restorePrevious();
            if (outError) *outError = L"Named tag math selection disagreed with the rendered note model. " +
                DescribeNoteUiSnapshot(tagged);
            return false;
        }
    }

    // Keep this terminal: the preceding math assertions intentionally use
    // programmatic selection replacement at unrelated offsets. A real table
    // caret route must be observed without letting that test-only helper
    // bypass the native selection transition that follows it.
    // A keyboard caret move inside a table is an actual post-default input
    // route. It must retain a final frame and make the table's atomic group
    // raw while unrelated rows remain structured. The snapshot is read-only
    // evidence from the same frame used by paint; it never observes LineCache.
    if (!SelectNoteTextSnippet(L"value")) {
        restorePrevious();
        if (outError) *outError = L"Could not select the table cell used for final-frame ownership testing.";
        return false;
    }
    SetFocus(g_hNoteEdit);
    SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_RIGHT, 1);
    const NoteUiSnapshot tableCaretSnapshot = CaptureNoteUiSnapshot();
    if (!tableCaretSnapshot.finalFrameActive ||
        tableCaretSnapshot.finalRawLineCount < 3 ||
        tableCaretSnapshot.finalStructuredLineCount == 0) {
        restorePrevious();
        if (outError) {
            *outError =
                L"A table caret did not make exactly its atomic table surface raw inside the final frame.";
        }
        return false;
    }

    // Measure actual native input + synchronous final paint at three lengths.
    // Only the owned automation note is changed; exact original text is
    // restored before switching views. No per-edit full textual snapshot is
    // allowed inside this probe, or its own diagnostics would hide locality.
    const auto verifyLongNoteRendering = [&]() -> bool {
        const std::wstring original = GetNoteAutomationIndexingText();
        LARGE_INTEGER frequency{};
        if (!QueryPerformanceFrequency(&frequency) || frequency.QuadPart <= 0) return false;
        const auto replaceAll = [&](const std::wstring& text) {
            SendMessageW(g_hNoteEdit, EM_SETSEL, 0, -1);
            SendMessageW(g_hNoteEdit, EM_REPLACESEL, TRUE, reinterpret_cast<LPARAM>(text.c_str()));
        };
        bool valid = true;
        for (const size_t rows : {128u, 1024u, 4096u}) {
            // A closed tag must not make unrelated plain-row typing rebuild
            // the document merely because its conservative flag is sticky.
            std::wstring fixture = L"<b>Long runtime probe</b>\r\r";
            size_t middle = 0;
            for (size_t row = 0; row < rows; ++row) {
                if (row == rows / 2) middle = fixture.size() + 8;
                fixture += L"plain row " + std::to_wstring(row) + L" unchanged text\r";
            }
            replaceAll(fixture);
            SetFocus(g_hNoteEdit);
            SendMessageW(g_hNoteEdit, EM_SETSEL, middle, middle);
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_RIGHT, 1);
            SendMessageW(g_hNoteEdit, WM_KEYUP, VK_RIGHT, 0xC0000001);
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_LEFT, 1);
            SendMessageW(g_hNoteEdit, WM_KEYUP, VK_LEFT, 0xC0000001);
            RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
            const auto baseline = ObserveNoteRenderRuntime();
            std::vector<int64_t> insertMicroseconds;
            std::vector<int64_t> deleteMicroseconds;
            insertMicroseconds.reserve(96);
            deleteMicroseconds.reserve(96);
            uint64_t revision = baseline.canonicalRevision;
            valid = baseline.finalFrameActive;
            for (size_t burst = 0; valid && burst < 8; ++burst) {
                for (const bool deleting : {false, true}) {
                    for (size_t edit = 0; valid && edit < 12; ++edit) {
                        LARGE_INTEGER start{}, finish{};
                        if (!QueryPerformanceCounter(&start)) { valid = false; break; }
                        SendMessageW(g_hNoteEdit, deleting ? WM_KEYDOWN : WM_CHAR,
                                     deleting ? VK_BACK : L'v', deleting ? 1 : 0);
                        if (deleting) {
                            SendMessageW(g_hNoteEdit, WM_CHAR, L'\b', 1);
                            SendMessageW(g_hNoteEdit, WM_KEYUP, VK_BACK, 0xC0000001);
                        }
                        RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
                        if (!QueryPerformanceCounter(&finish)) { valid = false; break; }
                        auto& samples = deleting ? deleteMicroseconds : insertMicroseconds;
                        samples.push_back(static_cast<int64_t>(
                            static_cast<double>(finish.QuadPart - start.QuadPart) * 1000000.0 /
                            static_cast<double>(frequency.QuadPart)));
                        const auto observed = ObserveNoteRenderRuntime();
                        valid = observed.finalFrameActive && observed.structuralPublicationWasLocalPatch &&
                            observed.modelMaterializations == baseline.modelMaterializations &&
                            observed.canonicalRevision == revision + 1;
                        if (!valid) {
                            AppendUiAutomationTrace(L"long_note_render:rejected frame=" +
                                std::to_wstring(observed.finalFrameActive) + L" local=" +
                                std::to_wstring(observed.structuralPublicationWasLocalPatch) +
                                L" models_before=" + std::to_wstring(baseline.modelMaterializations) +
                                L" models_after=" + std::to_wstring(observed.modelMaterializations) +
                                L" revision_before=" + std::to_wstring(revision) +
                                L" revision_after=" + std::to_wstring(observed.canonicalRevision));
                        }
                        revision = observed.canonicalRevision;
                    }
                }
            }
            std::sort(insertMicroseconds.begin(), insertMicroseconds.end());
            std::sort(deleteMicroseconds.begin(), deleteMicroseconds.end());
            const auto percentile = [](const std::vector<int64_t>& samples, size_t percent) {
                return samples.empty() ? int64_t{-1} : samples[(samples.size() - 1) * percent / 100];
            };
            const bool exact = GetNoteAutomationIndexingText() == fixture;
            AppendUiAutomationTrace(L"long_note_render:rows=" + std::to_wstring(rows) +
                L" local=" + std::to_wstring(valid) + L" exact=" + std::to_wstring(exact) +
                L" insert_samples=" + std::to_wstring(insertMicroseconds.size()) +
                L" insert_p50_us=" + std::to_wstring(percentile(insertMicroseconds, 50)) +
                L" insert_p95_us=" + std::to_wstring(percentile(insertMicroseconds, 95)) +
                L" delete_samples=" + std::to_wstring(deleteMicroseconds.size()) +
                L" delete_p50_us=" + std::to_wstring(percentile(deleteMicroseconds, 50)) +
                L" delete_p95_us=" + std::to_wstring(percentile(deleteMicroseconds, 95)));
            valid = valid && exact;
            if (!valid) break;
            // Removing just '>' makes the earlier close unrecognized. This
            // legitimately changes the suffix style and takes the full path;
            // it must still publish composed rows without a native paint.
            const size_t closingEnd = fixture.find(L"</b>") + 4;
            SendMessageW(g_hNoteEdit, EM_SETSEL, closingEnd, closingEnd);
            SendMessageW(g_hNoteEdit, WM_KEYDOWN, VK_F24, 1);
            const auto beforeClosingDeletion = ObserveNoteRenderRuntime();
            LARGE_INTEGER tagStart{}, tagFinish{};
            valid = QueryPerformanceCounter(&tagStart) != FALSE;
            if (valid) valid = SendUiAutomationNoteBackspace(1);
            RedrawWindow(g_hNoteEdit, nullptr, nullptr, RDW_INVALIDATE | RDW_UPDATENOW);
            valid = QueryPerformanceCounter(&tagFinish) != FALSE && valid;
            const auto afterClosingDeletion = ObserveNoteRenderRuntime();
            const auto tagSnapshot = CaptureNoteUiSnapshot();
            std::wstring withoutClosingEnd = fixture;
            withoutClosingEnd.erase(closingEnd - 1, 1);
            valid = valid && GetNoteAutomationIndexingText() == withoutClosingEnd &&
                tagSnapshot.finalFrameActive && tagSnapshot.finalStructuredLineCount > 0 &&
                afterClosingDeletion.canonicalRevision == beforeClosingDeletion.canonicalRevision + 1 &&
                afterClosingDeletion.nativeFallbackPaintCount == beforeClosingDeletion.nativeFallbackPaintCount;
            const auto tagUs = static_cast<int64_t>(
                static_cast<double>(tagFinish.QuadPart - tagStart.QuadPart) * 1000000.0 / frequency.QuadPart);
            AppendUiAutomationTrace(L"long_note_render:closing_delete rows=" + std::to_wstring(rows) +
                L" valid=" + std::to_wstring(valid) + L" elapsed_us=" + std::to_wstring(tagUs));
            if (!valid) break;
        }
        replaceAll(original);
        return valid && GetNoteAutomationIndexingText() == original && SaveNoteIfDirty(owner);
    };
    if (!verifyLongNoteRendering()) {
        restorePrevious();
        if (outError) *outError = L"Long-note input/deletion lost local publication, materialized full text or changed unchanged content.";
        return false;
    }

    // Keep real click/focus transitions terminal: the older probes above use
    // programmatic transport selections and must prepare their own caret state.
    if (!verifyRenderedClickInsertion()) {
        restorePrevious();
        if (outError) *outError = L"A rendered click did not preserve the source position through raw transition and insertion.";
        return false;
    }
    AppendUiAutomationTrace(L"math_render:rendered_click_insertion_ok");

    if (!RunUiAutomationInputAssistScenario(owner, outError)) {
        restorePrevious();
        return false;
    }

    g_noteRenderEnabled = previousRenderEnabled;
    g_noteRawOnly = previousRawOnly;
    const bool restored =
        RestoreUiAutomationNoteSelection(owner, previousNotePath, previousNoteIndex, outError);
    RefreshBottomPaneView();
    RefreshMainWindowUiState(owner);
    if (!vimVerticalValid && outError) {
        *outError = L"Vim vertical movement lost final geometry or its Normal raw preference (other render probes continued).";
    }
    return restored && vimVerticalValid;
}

static bool TestSelectionAndColorIsolationInvariants(HWND owner, std::wstring* outError) {
    if (!owner || !IsWindow(owner) || g_pdf.kind != DocKind::Pdf) return true;

    Annotation ann;
    ann.type = Annotation::Type::TextBox;
    ann.pageIndex = 0;
    ann.x1 = 100.0; ann.y1 = 100.0; ann.x2 = 200.0; ann.y2 = 150.0;
    ann.text = L"Automation Test Box";
    const COLORREF originalAnnotColor = RGB(255, 0, 0);
    ann.color = originalAnnotColor;
    InsertAnnotAt(ann, static_cast<int>(g_annots.size()));
    const int createdIdx = static_cast<int>(g_annots.size()) - 1;
    RefreshAnnotPanel();

    g_toolMode = ToolMode::TextBox;
    ClearAnnotationSelection();

    g_activeColor = RGB(0, 0, 255);
    ApplyActiveColorToSelectedAnnotation(g_hPdfView ? g_hPdfView : owner);

    if (g_annots[static_cast<size_t>(createdIdx)].color != originalAnnotColor) {
        if (outError) *outError = L"Invariant Violation: TextBox color was changed after commitment upon tool color update!";
        return false;
    }

    g_toolMode = ToolMode::Freehand;
    ClearAnnotationSelection();

    if (g_hAnnotList && SendMessageW(g_hAnnotList, LB_GETCURSEL, 0, 0) != static_cast<LPARAM>(-1)) {
        if (outError) *outError = L"Invariant Violation: Annotation selection in ListBox was not cleared upon switching to drawing tool!";
        return false;
    }

    if (GetActiveSelectedAnnotationIndex() != -1) {
        if (outError) *outError = L"Invariant Violation: Active selected annotation index was not -1 in creation tool mode!";
        return false;
    }

    if (g_hAnnotList) {
        g_toolMode = ToolMode::Select;
        SendMessageW(g_hAnnotList, LB_SETCURSEL, static_cast<WPARAM>(createdIdx), 0);
        g_activeColor = RGB(0, 255, 0);
        ApplyActiveColorToSelectedAnnotation(g_hPdfView ? g_hPdfView : owner);
        if (g_annots[static_cast<size_t>(createdIdx)].color != RGB(0, 255, 0)) {
            if (outError) *outError = L"Explicit Selection Failure: Color was not updated when explicitly selected in ListBox!";
            return false;
        }
    }

    if (createdIdx >= 0 && createdIdx < static_cast<int>(g_annots.size())) {
        DeleteAnnotationAtIndex(owner, createdIdx);
    }
    ClearAnnotationSelection();

    return true;
}

static void WriteUiAutomationResult(bool ok, const std::wstring& detail) {
    std::wstring pathValue;
    if (!ReadMainEnvVar(L"PDF_NOTE_SMALL_UI_AUTOMATION_RESULT_FILE", &pathValue) || pathValue.empty()) return;
    std::error_code ec;
    std::filesystem::path path(pathValue);
    if (path.has_parent_path()) {
        std::filesystem::create_directories(path.parent_path(), ec);
    }
    std::ofstream os(path, std::ios::binary | std::ios::trunc);
    if (!os) return;
    std::wstring payload = ok ? L"OK\n" : L"FAIL\n";
    if (!detail.empty()) payload += detail + L"\n";
    const std::string utf8 = WideToUTF8(payload);
    os.write(utf8.data(), static_cast<std::streamsize>(utf8.size()));
}

void AppendUiAutomationTrace(const std::wstring& line) {
    std::wstring pathValue;
    if (!ReadMainEnvVar(L"PDF_NOTE_SMALL_UI_AUTOMATION_RESULT_FILE", &pathValue) || pathValue.empty()) return;
    std::filesystem::path tracePath(pathValue);
    tracePath += L".trace.txt";
    std::error_code ec;
    if (tracePath.has_parent_path()) {
        std::filesystem::create_directories(tracePath.parent_path(), ec);
    }
    std::ofstream os(tracePath, std::ios::binary | std::ios::app);
    if (!os) return;
    const std::string utf8 = WideToUTF8(line + L"\n");
    os.write(utf8.data(), static_cast<std::streamsize>(utf8.size()));
}

enum class MainWindowLossEvent {
    None,
    Hidden,
    Destroyed,
    Minimized,
};

constexpr UINT_PTR kOwnedDialogPresenceAutomationTimerId = 0;
constexpr UINT kOwnedDialogPresenceAutomationCloseDelayMs = 20;

struct MainWindowPresenceAutomationState {
    HWND owner = nullptr;
    HWINEVENTHOOK hideHook = nullptr;
    HWINEVENTHOOK destroyHook = nullptr;
    HWINEVENTHOOK minimizeHook = nullptr;
    MainWindowLossEvent firstLossEvent = MainWindowLossEvent::None;
};

struct OwnedDialogCloseAutomationState {
    HWND owner = nullptr;
    UINT_PTR closeTimerId = 0;
    const wchar_t* expectedClass = nullptr;
    bool dialogWasOpened = false;
    bool closeWasPosted = false;
    int helpSearchStep = 0;
    bool helpSearchValidated = false;
    std::wstring helpSearchFailure;
    bool verifySilentChoices = false;
    bool keepOpenValidated = false;
    bool verifyColorChoices = false;
    bool colorChoicesValidated = false;
    int silentFinishCommand = 0; // 0 = WM_CLOSE; otherwise WM_COMMAND.
    std::wstring silentChoiceFailure;
};

static MainWindowPresenceAutomationState g_mainWindowPresenceAutomation;
static OwnedDialogCloseAutomationState g_ownedDialogCloseAutomation;
static constexpr int kUiAutomationHelpSearchControlId = 1006;
static constexpr int kUiAutomationHelpFindControlId = 1007;
static constexpr int kUiAutomationHelpSubtitleControlId = 1002;

static void CALLBACK RecordMainWindowPresenceEvent(HWINEVENTHOOK, DWORD event, HWND hwnd,
                                                    LONG objectId, LONG childId, DWORD, DWORD) {
    if (hwnd != g_mainWindowPresenceAutomation.owner ||
        g_mainWindowPresenceAutomation.firstLossEvent != MainWindowLossEvent::None) {
        return;
    }
    if (event == EVENT_OBJECT_HIDE && objectId == OBJID_WINDOW && childId == CHILDID_SELF) {
        g_mainWindowPresenceAutomation.firstLossEvent = MainWindowLossEvent::Hidden;
    } else if (event == EVENT_OBJECT_DESTROY && objectId == OBJID_WINDOW && childId == CHILDID_SELF) {
        g_mainWindowPresenceAutomation.firstLossEvent = MainWindowLossEvent::Destroyed;
    } else if (event == EVENT_SYSTEM_MINIMIZESTART) {
        g_mainWindowPresenceAutomation.firstLossEvent = MainWindowLossEvent::Minimized;
    }
}

static void StopMainWindowPresenceMonitor() {
    if (g_mainWindowPresenceAutomation.hideHook) {
        UnhookWinEvent(g_mainWindowPresenceAutomation.hideHook);
    }
    if (g_mainWindowPresenceAutomation.destroyHook) {
        UnhookWinEvent(g_mainWindowPresenceAutomation.destroyHook);
    }
    if (g_mainWindowPresenceAutomation.minimizeHook) {
        UnhookWinEvent(g_mainWindowPresenceAutomation.minimizeHook);
    }
    g_mainWindowPresenceAutomation.hideHook = nullptr;
    g_mainWindowPresenceAutomation.destroyHook = nullptr;
    g_mainWindowPresenceAutomation.minimizeHook = nullptr;
}

static bool StartMainWindowPresenceMonitor(HWND owner, std::wstring* outError) {
    if (!owner || !IsWindow(owner) || !IsWindowVisible(owner) || IsIconic(owner) || !IsWindowEnabled(owner)) {
        if (outError) *outError = L"Dialog visibility automation requires a visible, restored, enabled main window.";
        return false;
    }
    g_mainWindowPresenceAutomation = {};
    g_mainWindowPresenceAutomation.owner = owner;
    const DWORD processId = GetCurrentProcessId();
    const DWORD threadId = GetCurrentThreadId();
    g_mainWindowPresenceAutomation.hideHook = SetWinEventHook(
        EVENT_OBJECT_HIDE, EVENT_OBJECT_HIDE, nullptr, RecordMainWindowPresenceEvent,
        processId, threadId, WINEVENT_OUTOFCONTEXT);
    g_mainWindowPresenceAutomation.destroyHook = SetWinEventHook(
        EVENT_OBJECT_DESTROY, EVENT_OBJECT_DESTROY, nullptr, RecordMainWindowPresenceEvent,
        processId, threadId, WINEVENT_OUTOFCONTEXT);
    g_mainWindowPresenceAutomation.minimizeHook = SetWinEventHook(
        EVENT_SYSTEM_MINIMIZESTART, EVENT_SYSTEM_MINIMIZESTART, nullptr, RecordMainWindowPresenceEvent,
        processId, threadId, WINEVENT_OUTOFCONTEXT);
    if (g_mainWindowPresenceAutomation.hideHook && g_mainWindowPresenceAutomation.destroyHook &&
        g_mainWindowPresenceAutomation.minimizeHook) {
        return true;
    }
    StopMainWindowPresenceMonitor();
    g_mainWindowPresenceAutomation = {};
    if (outError) *outError = L"Could not install the main window presence monitor.";
    return false;
}

static const wchar_t* MainWindowLossEventName(MainWindowLossEvent event) {
    switch (event) {
    case MainWindowLossEvent::Hidden: return L"EVENT_OBJECT_HIDE";
    case MainWindowLossEvent::Destroyed: return L"EVENT_OBJECT_DESTROY";
    case MainWindowLossEvent::Minimized: return L"EVENT_SYSTEM_MINIMIZESTART";
    default: return L"unknown";
    }
}

static void CALLBACK CloseOwnedDialogForPresenceAutomation(HWND, UINT, UINT_PTR timerId, DWORD) {
    HWND owner = g_ownedDialogCloseAutomation.owner;
    if (!owner || !IsWindow(owner) || g_ownedDialogCloseAutomation.closeWasPosted) return;
    HWND dialog = GetWindow(owner, GW_ENABLEDPOPUP);
    if (!dialog || !IsWindow(dialog)) return;
    wchar_t className[64]{};
    if (GetClassNameW(dialog, className, static_cast<int>(std::size(className))) == 0 ||
        !g_ownedDialogCloseAutomation.expectedClass ||
        wcscmp(className, g_ownedDialogCloseAutomation.expectedClass) != 0) {
        return;
    }
    g_ownedDialogCloseAutomation.dialogWasOpened = true;
    if (g_ownedDialogCloseAutomation.verifyColorChoices) {
        wchar_t execute[64]{};
        wchar_t exit[64]{};
        GetWindowTextW(GetDlgItem(dialog, IDOK), execute, static_cast<int>(std::size(execute)));
        GetWindowTextW(GetDlgItem(dialog, IDCANCEL), exit, static_cast<int>(std::size(exit)));
        if (localization::Text(L"common.ok") != execute || localization::Text(L"common.cancel") != exit ||
            IsWindowEnabled(owner)) {
            g_ownedDialogCloseAutomation.silentChoiceFailure = L"Color editor action labels or modal owner state are incorrect.";
        } else {
            g_ownedDialogCloseAutomation.colorChoicesValidated = true;
        }
    }
    if (g_ownedDialogCloseAutomation.verifySilentChoices) {
        // Shared dialog IDs: execute / keep-open / exit; reuse the owned-dialog timer.
        HWND execute = GetDlgItem(dialog, 5102);
        HWND keep = GetDlgItem(dialog, 5103);
        HWND exit = GetDlgItem(dialog, 5104);
        const auto labelMatches = [](HWND button, const wchar_t* textId) {
            wchar_t text[64]{};
            return button && GetWindowTextW(button, text, static_cast<int>(std::size(text))) > 0 &&
                localization::Text(textId) == text;
        };
        if (!labelMatches(execute, L"dialog.button.yes") ||
            !labelMatches(keep, L"dialog.button.keep_open") ||
            !labelMatches(exit, L"dialog.button.cancel") || IsWindowEnabled(owner)) {
            g_ownedDialogCloseAutomation.silentChoiceFailure = L"Silent choice labels or modal owner state are incorrect.";
        } else if (!g_ownedDialogCloseAutomation.keepOpenValidated) {
            RECT client{};
            GetClientRect(dialog, &client);
            int previousRight = 0;
            for (HWND button : {GetDlgItem(dialog, 5200), execute, keep, exit}) {
                if (!button) continue;
                RECT bounds{};
                GetWindowRect(button, &bounds);
                MapWindowPoints(nullptr, dialog, reinterpret_cast<POINT*>(&bounds), 2);
                if (bounds.left < previousRight || bounds.right > client.right || bounds.bottom > client.bottom) {
                    g_ownedDialogCloseAutomation.silentChoiceFailure = L"Silent choice buttons overlap or lie outside the dialog.";
                }
                previousRight = bounds.right;
            }
            if (GetFocus() != exit) {
                g_ownedDialogCloseAutomation.silentChoiceFailure = L"The safe default exit button did not receive focus.";
            }
            SendMessageW(keep, BM_CLICK, 0, 0);
            if (!IsWindow(dialog) || !IsWindowVisible(dialog) || IsWindowEnabled(owner)) {
                g_ownedDialogCloseAutomation.silentChoiceFailure = L"Keep-open closed the dialog or released its modal owner.";
            } else {
                g_ownedDialogCloseAutomation.keepOpenValidated = true;
                return; // Observe the still-open dialog on the next timer tick.
            }
        }
    }
    if (wcscmp(className, L"HelpDialogClass") == 0) {
        HWND search = GetDlgItem(dialog, kUiAutomationHelpSearchControlId);
        HWND find = GetDlgItem(dialog, kUiAutomationHelpFindControlId);
        HWND subtitle = GetDlgItem(dialog, kUiAutomationHelpSubtitleControlId);
        if (!search || !find || !subtitle) {
            g_ownedDialogCloseAutomation.helpSearchFailure = L"Help search controls were not created.";
        } else if (g_ownedDialogCloseAutomation.helpSearchStep == 0) {
            SetWindowTextW(search, L"stage");
            g_ownedDialogCloseAutomation.helpSearchStep = 1;
            return;
        } else if (g_ownedDialogCloseAutomation.helpSearchStep == 1) {
            SendMessageW(find, BM_CLICK, 0, 0);
            g_ownedDialogCloseAutomation.helpSearchStep = 2;
            return;
        } else if (g_ownedDialogCloseAutomation.helpSearchStep == 2) {
            const int findLength = GetWindowTextLengthW(find);
            const int subtitleLength = GetWindowTextLengthW(subtitle);
            std::wstring findText(static_cast<size_t>(std::max(0, findLength)) + 1, L'\0');
            std::wstring subtitleText(static_cast<size_t>(std::max(0, subtitleLength)) + 1, L'\0');
            GetWindowTextW(find, findText.data(), findLength + 1);
            GetWindowTextW(subtitle, subtitleText.data(), subtitleLength + 1);
            findText.resize(static_cast<size_t>(std::max(0, findLength)));
            subtitleText.resize(static_cast<size_t>(std::max(0, subtitleLength)));
            if (findText != localization::Text(L"help.next") || subtitleText.find(L"1/") == std::wstring::npos) {
                g_ownedDialogCloseAutomation.helpSearchFailure =
                    L"Help search did not show the first match count and Next button.";
            } else {
                SetWindowTextW(search, L"stage ");
                g_ownedDialogCloseAutomation.helpSearchStep = 3;
                return;
            }
        } else if (g_ownedDialogCloseAutomation.helpSearchStep == 3) {
            const int findLength = GetWindowTextLengthW(find);
            std::wstring findText(static_cast<size_t>(std::max(0, findLength)) + 1, L'\0');
            GetWindowTextW(find, findText.data(), findLength + 1);
            findText.resize(static_cast<size_t>(std::max(0, findLength)));
            if (findText != localization::Text(L"help.search")) {
                g_ownedDialogCloseAutomation.helpSearchFailure =
                    L"Help search button did not return to Search after the query changed.";
            } else {
                g_ownedDialogCloseAutomation.helpSearchValidated = true;
            }
        }
    }
    const int finishCommand = g_ownedDialogCloseAutomation.silentFinishCommand;
    g_ownedDialogCloseAutomation.closeWasPosted =
        PostMessageW(dialog, finishCommand ? WM_COMMAND : WM_CLOSE,
                     static_cast<WPARAM>(finishCommand), 0) != FALSE;
    if (g_ownedDialogCloseAutomation.closeWasPosted) {
        KillTimer(nullptr, timerId);
        g_ownedDialogCloseAutomation.closeTimerId = 0;
    }
}

static bool BeginOwnedDialogPresenceAutomation(HWND owner, const wchar_t* expectedClass, std::wstring* outError) {
    if (!StartMainWindowPresenceMonitor(owner, outError)) return false;
    g_ownedDialogCloseAutomation = {};
    g_ownedDialogCloseAutomation.owner = owner;
    g_ownedDialogCloseAutomation.expectedClass = expectedClass;
    g_ownedDialogCloseAutomation.closeTimerId =
        SetTimer(nullptr, kOwnedDialogPresenceAutomationTimerId,
                 kOwnedDialogPresenceAutomationCloseDelayMs, CloseOwnedDialogForPresenceAutomation);
    if (g_ownedDialogCloseAutomation.closeTimerId != 0) return true;
    StopMainWindowPresenceMonitor();
    g_mainWindowPresenceAutomation = {};
    g_ownedDialogCloseAutomation = {};
    if (outError) *outError = L"Could not schedule the dialog close automation.";
    return false;
}

static bool EndOwnedDialogPresenceAutomation(HWND owner, const wchar_t* scenario, std::wstring* outError,
                                              bool requireDialog) {
    if (g_ownedDialogCloseAutomation.closeTimerId != 0) {
        KillTimer(nullptr, g_ownedDialogCloseAutomation.closeTimerId);
    }
    const OwnedDialogCloseAutomationState dialogResult = g_ownedDialogCloseAutomation;
    g_ownedDialogCloseAutomation = {};
    StopMainWindowPresenceMonitor();
    const MainWindowPresenceAutomationState monitorResult = g_mainWindowPresenceAutomation;
    g_mainWindowPresenceAutomation = {};

    if (dialogResult.verifySilentChoices &&
        (!dialogResult.keepOpenValidated || !dialogResult.silentChoiceFailure.empty())) {
        if (outError) *outError = dialogResult.silentChoiceFailure.empty()
            ? L"Silent keep-open choice was not observed." : dialogResult.silentChoiceFailure;
        return false;
    }
    if (dialogResult.verifyColorChoices &&
        (!dialogResult.colorChoicesValidated || !dialogResult.silentChoiceFailure.empty())) {
        if (outError) *outError = dialogResult.silentChoiceFailure.empty()
            ? L"Color editor choices were not observed." : dialogResult.silentChoiceFailure;
        return false;
    }
    if ((requireDialog && !dialogResult.dialogWasOpened) ||
        (dialogResult.dialogWasOpened && !dialogResult.closeWasPosted)) {
        if (outError) *outError = std::wstring(L"Dialog visibility automation did not open and close ") + scenario + L".";
        return false;
    }
    if (dialogResult.expectedClass && wcscmp(dialogResult.expectedClass, L"HelpDialogClass") == 0) {
        if (!dialogResult.helpSearchFailure.empty()) {
            if (outError) *outError = dialogResult.helpSearchFailure;
            return false;
        }
        if (!dialogResult.helpSearchValidated) {
            if (outError) *outError = L"Help search automation did not complete.";
            return false;
        }
    }
    if (monitorResult.firstLossEvent != MainWindowLossEvent::None) {
        AppendUiAutomationTrace(std::wstring(L"automation:main_window_lost:") +
                              MainWindowLossEventName(monitorResult.firstLossEvent));
        if (outError) *outError = std::wstring(L"Main window was lost while ") + scenario + L": " +
                                  MainWindowLossEventName(monitorResult.firstLossEvent) + L".";
        return false;
    }
    if (!IsWindow(owner) || !IsWindowVisible(owner) || IsIconic(owner) || !IsWindowEnabled(owner)) {
        if (outError) *outError = std::wstring(L"Main window was not visible, restored, and enabled after ") + scenario + L".";
        return false;
    }
    return true;
}

static bool RunUiAutomationHelpVisibilityScenario(HWND owner, std::wstring* outError) {
    if (!BeginOwnedDialogPresenceAutomation(owner, L"HelpDialogClass", outError)) return false;
    ShowHelpDialog(owner);
    return EndOwnedDialogPresenceAutomation(owner, L"closing help", outError);
}

static bool RunUiAutomationDialogOwnerVisibilityScenario(HWND owner, std::wstring* outError) {
    if (!BeginOwnedDialogPresenceAutomation(owner, L"SilentDialogClass", outError)) return false;
    SilentDialogOptions options;
    options.title = L"UI automation dialog-owner visibility";
    options.message = L"This dialog is automatically closed by UI automation.";
    options.kind = SoftNoticeKind::Info;
    options.buttons = SilentDialogButtons::Ok;
    options.defaultResult = SilentDialogResult::Ok;
    options.escapeResult = SilentDialogResult::Ok;
    const SilentDialogResult result = ShowSilentDialog(owner, options);
    if (result != SilentDialogResult::Ok) {
        std::wstring ignoredError;
        (void)EndOwnedDialogPresenceAutomation(owner, L"closing the silent dialog", &ignoredError);
        if (outError) *outError = L"Dialog visibility automation received an unexpected silent dialog result.";
        return false;
    }
    if (!EndOwnedDialogPresenceAutomation(owner, L"closing the silent dialog", outError)) return false;
    for (SilentDialogButtons buttons : {SilentDialogButtons::YesNo, SilentDialogButtons::OkCancel}) {
        for (int finishCommand : {5102, 5104, IDCANCEL, 0}) {
            if (!BeginOwnedDialogPresenceAutomation(owner, L"SilentDialogClass", outError)) return false;
            g_ownedDialogCloseAutomation.verifySilentChoices = true;
            g_ownedDialogCloseAutomation.silentFinishCommand = finishCommand;
            options.buttons = buttons;
            options.defaultResult = buttons == SilentDialogButtons::YesNo
                ? SilentDialogResult::No : SilentDialogResult::Cancel;
            options.escapeResult = options.defaultResult;
            options.paths = {{L"Long path", (std::filesystem::path(g_workspaceRoot) /
                std::wstring(180, L'x') / L"file.txt").wstring()}};
            const SilentDialogResult choice = ShowSilentDialog(owner, options);
            if (!EndOwnedDialogPresenceAutomation(owner, L"checking silent choices", outError)) return false;
            const SilentDialogResult expected = finishCommand == 5102
                ? (buttons == SilentDialogButtons::YesNo ? SilentDialogResult::Yes : SilentDialogResult::Ok)
                : options.escapeResult;
            if (choice != expected) {
                if (outError) *outError = L"Silent choice returned an unexpected action or cancellation result.";
                return false;
            }
        }
    }
    AppendUiAutomationTrace(L"automation:silent_choices_keep_open_execute_exit_ok");
    for (int finishCommand : {IDOK, IDCANCEL, 0}) {
        if (!BeginOwnedDialogPresenceAutomation(owner, L"PaletteColorEditorDlgClass", outError)) return false;
        g_ownedDialogCloseAutomation.verifyColorChoices = true;
        g_ownedDialogCloseAutomation.silentFinishCommand = finishCommand;
        const COLORREF original = RGB(19, 37, 53);
        const COLORREF initial = RGB(61, 79, 97);
        COLORREF picked = original;
        const bool accepted = PickColorDialog(owner, initial, &picked);
        if (!EndOwnedDialogPresenceAutomation(owner, L"checking color choices", outError)) return false;
        if (accepted != (finishCommand == IDOK) || picked != (accepted ? initial : original)) {
            if (outError) *outError = L"Color editor changed the color on cancellation or failed to return the accepted color.";
            return false;
        }
    }
    AppendUiAutomationTrace(L"automation:color_choices_accept_cancel_ok");
    return true;
}

static bool RunUiAutomationOrganizeDirtyAnnotationsScenario(HWND owner, std::wstring* outError) {
    const std::wstring originalPdf = CurrentLogicalPdfPath();
    const std::wstring originalSession = g_currentSessionPath;
    const std::wstring originalLayout = g_config.sessionFileLayout;
    if (originalPdf.empty() || originalSession.empty() ||
        !file_output::SaveNoteIfDirty(owner) || !file_output::SaveAnnotationsIfDirty(owner)) {
        if (outError) *outError = L"Organization regression requires a saved PDF/session.";
        return false;
    }
    std::string pdfBytes;
    if (!ReadFileBytesWin32(std::filesystem::path(originalPdf), pdfBytes)) return false;
    // All paths belong to this disposable automation workspace. The isolated
    // session prevents organization from moving other scenarios' fixtures.
    const auto session = std::filesystem::path(originalSession) / L"__ui_organize_dirty";
    const auto source = session / L"dirty.pdf";
    const auto destination = session / L"pdf" / L"dirty.pdf";
    std::wstring err;
    if (!atomic_write::AtomicWriteUtf8(source, pdfBytes, session, &err)) return false;
    const auto fail = [&](const wchar_t* message) {
        if (outError) *outError = message;
        return false;
    };
    const auto run = [&]() -> bool {
        g_currentSessionPath = session.wstring();
        g_config.sessionFileLayout = L"separate_directories";
        if (!OpenPdfWithAnnotations(owner, source.wstring())) return fail(L"Could not open organization fixture.");
        Annotation line;
        line.id = L"organize-unsaved-line";
        line.type = Annotation::Type::Line;
        line.pageIndex = 0;
        line.x1 = 10; line.y1 = 10; line.x2 = 40; line.y2 = 40;
        line.width = 2;
        line.color = RGB(24, 48, 72);
        g_annots.push_back(line);
        g_annotsDirty = true;
        g_annotsNeedsIntegrate = false;
        // Call the real UI entry immediately, before a timer can stage the edit.
        OrganizeCurrentSessionFiles(owner);
        std::vector<Annotation> saved;
        bool mismatch = false;
        if (CurrentLogicalPdfPath() != destination.wstring() || g_annotsDirty ||
            !clrop_bridge::LoadAnnotations(clrop_bridge::ClropPathForPdf(destination.wstring()),
                destination.wstring(), saved, mismatch, nullptr, err) || mismatch ||
            saved.size() != 1 || saved[0].id != line.id || saved[0].x2 != line.x2 ||
            g_annots.size() != 1 || g_annots[0].id != line.id) {
            return fail(L"Organization lost an annotation that had not yet been auto-staged.");
        }
        std::string after;
        if (!ReadFileBytesWin32(destination, after) || after != pdfBytes ||
            !CanExecuteWorkspaceOperationUndoRedo(true) || !ExecuteWorkspaceOperationUndoRedo(owner, true) ||
            !CanExecuteWorkspaceOperationUndoRedo(false) || !ExecuteWorkspaceOperationUndoRedo(owner, false) ||
            CurrentLogicalPdfPath() != destination.wstring() || g_annots.size() != 1 || g_annots[0].id != line.id) {
            return fail(L"Organization undo/redo did not preserve the original PDF and annotation.");
        }
        return true;
    };
    const bool passed = run();
    g_currentSessionPath = originalSession;
    g_config.sessionFileLayout = originalLayout;
    const bool restored = OpenPdfWithAnnotations(owner, originalPdf);
    RefreshCurrentSessionFiles();
    SyncLeftPaneSelection();
    RememberCurrentSessionFiles();
    if (!restored) return fail(L"Could not restore the original document after organization regression.");
    return passed;
}

static bool RunUiAutomationPaletteScenario(HWND owner, std::wstring* outError) {
    if (!owner || g_workspaceRoot.empty()) {
        if (outError) *outError = L"Palette automation requires a loaded workspace.";
        return false;
    }

    constexpr size_t kCount = kToolPaletteCommandSlotCapacity;
    COLORREF originalColors[kCount]{};
    LoadUserPaletteColorsForSettings(originalColors, kCount);
    const auto originalPalette = g_palette;
    const COLORREF originalActive = g_activeColor;
    const ToolMode originalMode = g_toolMode;
    const COLORREF originalTextColor = ToolColorForMode(ToolMode::TextBox);

    auto restore = [&]() {
        const bool paletteSaved = SaveUserPaletteColorsForSettings(originalColors, kCount);
        StoreToolColorForMode(ToolMode::TextBox, originalTextColor);
        g_toolMode = originalMode;
        g_activeColor = originalActive;
        if (originalPalette.size() == g_palette.size()) {
            g_palette = originalPalette;
            // Restore the application-owned custom palette color.
            g_paletteCustomColor = originalColors[static_cast<size_t>(kLastOkColorSlotIndex)];
        }
        const bool configSaved = TryPersistConfig();
        UpdateToolbarUI(owner);
        return paletteSaved && configSaved;
    };

    COLORREF colors[kCount]{};
    std::copy(std::begin(originalColors), std::end(originalColors), std::begin(colors));
    const COLORREF savedColor = RGB(0x0C, 0x22, 0x38);
    colors[2] = savedColor;
    if (!SaveUserPaletteColorsForSettings(colors, kCount)) {
        if (outError) *outError = L"Palette automation could not save its test colors.";
        return false;
    }

    // Check that the saved color appears somewhere in the rebuilt runtime palette
    // (exact slot count is dynamic now; it depends on whether dynamic slots are unique).
    bool foundSavedColor = false;
    for (COLORREF c : g_palette) {
        if (c == savedColor) {
            foundSavedColor = true;
            break;
        }
    }
    if (g_palette.empty() || !foundSavedColor) {
        restore();
        if (outError) *outError = L"Palette settings save did not refresh the runtime palette.";
        return false;
    }

    const std::filesystem::path palettePath =
        std::filesystem::path(g_workspaceRoot) / L"__pdf_note_workspace__" / L"__settings__" / L"user_palette.json";
    std::ifstream ifs(palettePath, std::ios::binary);
    std::string persisted((std::istreambuf_iterator<char>(ifs)), std::istreambuf_iterator<char>());
    // The test's own read handle must not block the checked atomic restore.
    ifs.close();
    if (persisted.find("#0C2238") == std::string::npos) {
        restore();
        if (outError) *outError = L"Palette settings save did not persist the selected color.";
        return false;
    }

    g_toolMode = ToolMode::TextBox;
    StoreToolColorForMode(g_toolMode, originalTextColor);
    g_activeColor = originalTextColor;
    UpdateToolbarUI(owner);
    EnsureToolbarPaletteButtons();
    if (g_colorButtons.size() < g_palette.size() || !g_colorButtons[2] || !IsWindow(g_colorButtons[2])) {
        restore();
        if (outError) *outError = L"Toolbar palette buttons were not created for the saved palette.";
        return false;
    }
    SendMessageW(owner, WM_COMMAND, MAKEWPARAM(ID_TOOL_COLOR_BASE + 2, BN_CLICKED), 0);
    if (g_activeColor != savedColor || ToolColorForMode(ToolMode::TextBox) != savedColor) {
        restore();
        if (outError) *outError = L"Toolbar palette selection did not apply to the active tool color.";
        return false;
    }

    if (!ApplyActivePaletteColorStep(g_hPdfView ? g_hPdfView : owner, 1, false) ||
        ToolColorForMode(ToolMode::TextBox) != colors[3]) {
        restore();
        if (outError) *outError = L"Palette color cycling did not use the saved runtime palette.";
        return false;
    }

    if (!restore()) {
        if (outError) *outError = L"Palette automation could not restore its original colors.";
        return false;
    }
    return true;
}

static bool ThemeBrushMatchesColor(HBRUSH brush, COLORREF expected) {
    LOGBRUSH info{};
    return brush && GetObjectW(brush, sizeof(info), &info) > 0 &&
           info.lbStyle == BS_SOLID && info.lbColor == expected;
}

static bool RunUiAutomationThemeSwitchScenario(HWND owner, std::wstring* outError) {
    if (!owner || !IsWindow(owner)) {
        if (outError) *outError = L"Theme automation requires the main window.";
        return false;
    }

    const std::wstring originalThemeName = g_themeName;
    const bool originalOwnerDraw = g_config.ownerDrawUi;
    std::vector<std::wstring> candidates;
    for (const auto& theme : g_themeCatalog) {
        if (theme.name != L"default" && theme.name != originalThemeName) {
            candidates.push_back(theme.name);
        }
    }
    if (candidates.size() < 2) {
        if (outError) *outError = L"Theme automation requires two alternate themes.";
        return false;
    }

    auto restore = [&]() -> bool {
        if (!ApplyThemeByName(originalThemeName, owner, /*persist=*/false)) return false;
        return g_config.ownerDrawUi == originalOwnerDraw;
    };
    auto fail = [&](const std::wstring& message) -> bool {
        const bool restored = restore();
        if (outError) {
            *outError = restored ? message : message + L" Theme restoration also failed.";
        }
        return false;
    };
    auto verifyAppliedTheme = [&](const std::wstring& expectedName) -> bool {
        if (g_themeName != expectedName || !g_config.ownerDrawUi) return false;
        if (!ThemeBrushMatchesColor(g_hThemeWindowBrush, g_theme.windowBg) ||
            !ThemeBrushMatchesColor(g_hThemePanelBrush, g_theme.panelBg) ||
            !ThemeBrushMatchesColor(g_hThemeToolbarBrush, g_theme.toolbarBg) ||
            !ThemeBrushMatchesColor(g_hThemeMenuBrush, g_theme.menuBg)) {
            return false;
        }
        if (!g_hBtnModeSelect ||
            (GetWindowLongPtrW(g_hBtnModeSelect, GWL_STYLE) & BS_OWNERDRAW) == 0) {
            return false;
        }
        HMENU menu = GetMenu(owner);
        MENUITEMINFOW item{};
        item.cbSize = sizeof(item);
        item.fMask = MIIM_FTYPE;
        return menu && GetMenuItemInfoW(menu, 0, TRUE, &item) &&
               (item.fType & MFT_OWNERDRAW) != 0;
    };

    if (!ApplyThemeByName(candidates[0], owner, /*persist=*/false) ||
        !verifyAppliedTheme(candidates[0])) {
        return fail(L"First theme did not update the UI resources and owner-draw controls.");
    }
    const COLORREF firstSelectionBg = g_theme.selectionBg;
    const COLORREF firstSelectionText = g_theme.selectionText;

    if (!ApplyThemeByName(candidates[1], owner, /*persist=*/false) ||
        !verifyAppliedTheme(candidates[1])) {
        return fail(L"Second theme did not update the UI resources and owner-draw controls.");
    }
    if (g_theme.selectionBg == firstSelectionBg && g_theme.selectionText == firstSelectionText) {
        return fail(L"Theme switch did not change the selection colors.");
    }
    RedrawWindow(owner, nullptr, nullptr, RDW_INVALIDATE | RDW_ALLCHILDREN | RDW_UPDATENOW);

    if (!restore()) {
        if (outError) *outError = L"Theme automation could not restore the original theme.";
        return false;
    }
    return true;
}

static bool RunUiAutomationSessionSortNumberingScenario(std::wstring* outError) {
    std::vector<SessionEntry> sessions;
    auto add = [&](const std::wstring& name) {
        SessionEntry s;
        s.displayName = name;
        s.path = name;
        sessions.push_back(std::move(s));
    };
    add(L"第10回");
    add(L"補講");
    add(L"第2回");
    add(L"第1回");

    if (ExtractNumericKey(L"第2回（3限）") != std::optional<int>{2} ||
        ExtractNumericKey(L"2026年度 第2回") != std::optional<int>{2} ||
        ExtractNumericKey(L"資料2_3") != std::optional<int>{2} ||
        ExtractNumericKey(L"第１０回") != std::optional<int>{10}) {
        if (outError) *outError = L"Session numeric key extraction failed.";
        return false;
    }

    auto asc = sessions;
    SortSessionsForDisplay(asc, SessionSortMode::NumericAsc);
    if (asc.size() != 4 || asc[0].displayName != L"第1回" || asc[1].displayName != L"第2回" ||
        asc[2].displayName != L"第10回" || asc[3].displayName != L"補講") {
        if (outError) *outError = L"Session numeric ascending sort failed.";
        return false;
    }

    auto desc = sessions;
    SortSessionsForDisplay(desc, SessionSortMode::NumericDesc);
    if (desc.size() != 4 || desc[0].displayName != L"第10回" || desc[1].displayName != L"第2回" ||
        desc[2].displayName != L"第1回" || desc[3].displayName != L"補講") {
        if (outError) *outError = L"Session numeric descending sort failed.";
        return false;
    }

    if (NextSessionNumberForSuggestions(sessions, SessionNumberingMode::CountPlusOne) != 5) {
        if (outError) *outError = L"Session count-based numbering failed.";
        return false;
    }
    if (NextSessionNumberForSuggestions(sessions, SessionNumberingMode::MaxNumberPlusOne) != 11) {
        if (outError) *outError = L"Session max-number-based numbering failed.";
        return false;
    }
    return true;
}

static bool RunUiAutomationWorkspaceConfigRoundTripScenario(std::wstring* outError) {
    if (g_workspaceRoot.empty()) {
        if (outError) *outError = L"Workspace configuration automation requires a workspace.";
        return false;
    }

    const WorkspaceConfig originalConfig = g_config;
    auto restore = [&]() {
        g_config = originalConfig;
        PersistConfig();
    };

    // Exercise the production serializer with values that plain JSON interpolation
    // corrupts. Keep this probe in the disposable automation workspace.
    WorkspaceConfig textProbe = originalConfig;
    const std::wstring special = L"日本語 \"引用\" \\ ] } $&\n改行\t末尾 😀";
    textProbe.classesDir = L"sub\\授業 ] $&";
    textProbe.clroNamePattern = special;
    textProbe.noteFontName = special;
    textProbe.noteBgThemeName = special;
    textProbe.quickNoteMathPlaceholderText = special;
    const auto textProbePath = std::filesystem::path(g_workspaceRoot) / L"workspace.json";
    std::wstring textProbeError;
    const bool textSaved = SaveWorkspaceConfigToFile(textProbePath, textProbe);
    const auto textLoaded = textSaved ? LoadWorkspaceConfigFromFile(textProbePath, &textProbeError)
                                    : std::optional<WorkspaceConfig>{};
    if (!textLoaded || textLoaded->classesDir != textProbe.classesDir ||
        textLoaded->clroNamePattern != special || textLoaded->noteFontName != special ||
        textLoaded->noteBgThemeName != special || textLoaded->quickNoteMathPlaceholderText != special) {
        restore();
        if (outError) *outError = L"Workspace JSON string round trip failed: " + textProbeError;
        return false;
    }

    g_config.language = L"en";
    g_config.pdfBitmapBudgetMiB = kPdfBitmapBudgetMiBMin;
    g_config.pointerOffsetX = 17;
    g_config.pointerOffsetY = -13;
    g_config.sessionFileLayout = L"session_root";
    g_config.noteOverlayRefreshDelayMs = 600;
    g_config.noteFullReparseDelayMs = 1200;
    g_config.debugLogs.previewTrace = true;
    g_config.debugLogs.switchTiming = true;
    g_config.debugLogs.crash = false;
    g_config.debugLogs.startupWatchdog = false;
    g_config.debugLogs.officeConversion = false;
    PersistConfig();

    std::wstring readError;
    const std::filesystem::path configPath = std::filesystem::path(g_workspaceRoot) / L"workspace.json";
    const auto loaded = LoadWorkspaceConfigFromFile(configPath, &readError);
    const bool matches = loaded &&
        loaded->language == L"en" &&
        loaded->pdfBitmapBudgetMiB == kPdfBitmapBudgetMiBMin &&
        loaded->pointerOffsetX == 17 &&
        loaded->pointerOffsetY == -13 &&
        loaded->sessionFileLayout == L"session_root" &&
        loaded->noteOverlayRefreshDelayMs == 600 &&
        loaded->noteFullReparseDelayMs == 1200 &&
        loaded->debugLogs.previewTrace &&
        loaded->debugLogs.switchTiming &&
        !loaded->debugLogs.crash &&
        !loaded->debugLogs.startupWatchdog &&
        !loaded->debugLogs.officeConversion;
    restore();
    if (!matches) {
        if (outError) {
            *outError = L"Workspace configuration save/load round trip did not preserve settings.";
            if (!readError.empty()) *outError += L" " + readError;
        }
        return false;
    }
    return true;
}

static bool RunUiAutomationWorkspaceConfigUnknownFieldScenario(std::wstring* outError) {
    if (g_workspaceRoot.empty()) {
        if (outError) *outError = L"Workspace configuration automation requires a workspace.";
        return false;
    }

    const std::filesystem::path configPath = std::filesystem::path(g_workspaceRoot) / L"workspace.json";
    auto readBytes = [&](std::string* out) {
        if (!out) return false;
        out->clear();
        std::ifstream input(configPath, std::ios::binary);
        if (!input) return false;
        *out = std::string((std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>());
        return static_cast<bool>(input) || input.eof();
    };
    std::string original;
    if (!readBytes(&original) || original.find("\"futureVersionOption\"") == std::string::npos) {
        if (outError) *outError = L"Unknown-field automation fixture was not loaded as expected.";
        return false;
    }

    const std::wstring originalLanguage = g_config.language;
    g_config.language = (originalLanguage == L"ja") ? L"en" : L"ja";
    PersistConfig();
    g_config.language = originalLanguage;

    std::string afterPersist;
    if (!readBytes(&afterPersist) || afterPersist != original) {
        if (outError) *outError = L"Unknown workspace.json fields were not protected from auto-persist.";
        return false;
    }
    return true;
}

static bool WriteUiAutomationTextFile(const std::filesystem::path& path, const std::string& text, std::wstring* outError) {
    std::error_code ec;
    std::filesystem::create_directories(path.parent_path(), ec);
    if (ec) {
        if (outError) *outError = L"Could not create automation settings directory.";
        return false;
    }
    std::ofstream out(path, std::ios::binary | std::ios::trunc);
    if (!out) {
        if (outError) *outError = L"Could not write automation test file: " + path.wstring();
        return false;
    }
    out.write(text.data(), static_cast<std::streamsize>(text.size()));
    return static_cast<bool>(out);
}

static bool CaptureUiAutomationSettingsBytes(std::map<std::wstring, std::optional<std::string>>* out) {
    if (!out || g_workspaceRoot.empty()) return false;
    out->clear();
    const std::filesystem::path root(g_workspaceRoot);
    const std::filesystem::path settings = root / L"__pdf_note_workspace__" / L"__settings__";
    const std::pair<const wchar_t*, std::filesystem::path> paths[] = {
        {L"workspace.json", root / L"workspace.json"},
        {L"user_palette.json", settings / L"user_palette.json"},
        {L"tool_shortcuts.json", settings / L"tool_shortcuts.json"},
        {L"schedule.json", settings / L"schedule.json"}
    };
    for (const auto& item : paths) {
        std::string bytes;
        if (ReadUiAutomationFileBytes(item.second, &bytes)) {
            out->emplace(item.first, std::move(bytes));
        } else {
            out->emplace(item.first, std::nullopt);
        }
    }
    return true;
}

static bool UiAutomationSettingsBytesEqual(const std::map<std::wstring, std::optional<std::string>>& a,
                                           const std::map<std::wstring, std::optional<std::string>>& b) {
    if (a.size() != b.size()) return false;
    for (const auto& kv : a) {
        const auto it = b.find(kv.first);
        if (it == b.end()) return false;
        if (kv.second.has_value() != it->second.has_value()) return false;
        if (kv.second && it->second && *kv.second != *it->second) return false;
    }
    return true;
}

static bool SettingsImportBackupExistsForAutomation() {
    if (g_workspaceRoot.empty()) return false;
    const std::filesystem::path escapeDir =
        std::filesystem::path(g_workspaceRoot) / L"__pdf_note_workspace__" / L"__escape__";
    std::error_code ec;
    if (!std::filesystem::is_directory(escapeDir, ec) || ec) return false;
    for (const auto& entry : std::filesystem::directory_iterator(escapeDir, ec)) {
        if (ec) break;
        if (!entry.is_directory(ec) || ec) {
            ec.clear();
            continue;
        }
        const std::wstring name = entry.path().filename().wstring();
        if (name.find(L"settings_import_") != 0) continue;
        if (std::filesystem::exists(entry.path() / L"manifest.txt", ec) && !ec) return true;
        ec.clear();
    }
    return false;
}

static bool RunUiAutomationSettingsBundleScenario(HWND owner, std::wstring* outError) {
    if (g_workspaceRoot.empty()) {
        if (outError) *outError = L"Settings bundle automation requires a workspace.";
        return false;
    }

    const WorkspaceConfig originalConfig = g_config;
    auto restoreConfig = [&]() {
        g_config = originalConfig;
        PersistConfig();
        ApplyConfigToUI(owner);
    };

    const std::filesystem::path root(g_workspaceRoot);
    const std::filesystem::path settings = root / L"__pdf_note_workspace__" / L"__settings__";
    const std::filesystem::path bundle = root / L"__pdf_note_workspace__" / L"__tmp__" / L"settings_bundle_test.pnssettings";
    const std::filesystem::path malformed = root / L"__pdf_note_workspace__" / L"__tmp__" / L"settings_bundle_bad.pnssettings";
    const std::filesystem::path duplicate = root / L"__pdf_note_workspace__" / L"__tmp__" / L"settings_bundle_duplicate.pnssettings";
    const std::filesystem::path unknown = root / L"__pdf_note_workspace__" / L"__tmp__" / L"settings_bundle_unknown.pnssettings";
    const std::filesystem::path oversized = root / L"__pdf_note_workspace__" / L"__tmp__" / L"settings_bundle_oversized.pnssettings";

    g_config.language = L"en";
    g_config.pointerOffsetX = 17;
    g_config.pointerOffsetY = -19;
    g_config.schedulePeriods = 2;
    g_config.scheduleStartTimes.assign(91, L"");
    g_config.scheduleStartTimes[0] = L"08:30";
    g_config.scheduleCells.assign(14, L"");
    g_config.scheduleCells[0] = L"automation schedule cell";
    PersistConfig();
    const std::string paletteJson = "{\n  \"colors\": [\"#112233\", \"#445566\", \"#778899\"]\n}\n";
    const std::string shortcutsJson = "{\n  \"version\": 1,\n  \"shortcuts\": [\n    { \"key\": \"Ctrl+1\", \"tool\": \"text\" }\n  ]\n}\n";
    if (!WriteUiAutomationTextFile(settings / L"user_palette.json", paletteJson, outError) ||
        !WriteUiAutomationTextFile(settings / L"tool_shortcuts.json", shortcutsJson, outError)) {
        restoreConfig();
        return false;
    }
    ApplyConfigToUI(owner);

    std::wstring err;
    if (!ExportSettingsPresetToFile(bundle, &err)) {
        restoreConfig();
        if (outError) *outError = L"Settings bundle export failed: " + err;
        return false;
    }
    std::map<std::wstring, std::optional<std::string>> exportedBytes;
    if (!CaptureUiAutomationSettingsBytes(&exportedBytes)) {
        restoreConfig();
        if (outError) *outError = L"Could not capture settings after bundle export.";
        return false;
    }

    g_config.language = L"ja";
    g_config.pointerOffsetX = -7;
    g_config.pointerOffsetY = 8;
    g_config.scheduleStartTimes[0] = L"10:10";
    g_config.scheduleCells[0] = L"mutated";
    PersistConfig();
    if (!WriteUiAutomationTextFile(settings / L"user_palette.json", "{ \"colors\": [\"#ABCDEF\"] }\n", outError) ||
        !WriteUiAutomationTextFile(settings / L"tool_shortcuts.json", "{ \"version\": 1, \"shortcuts\": [] }\n", outError)) {
        restoreConfig();
        return false;
    }

    if (!ImportSettingsPresetFromFile(bundle, &err)) {
        restoreConfig();
        if (outError) *outError = L"Settings bundle import failed: " + err;
        return false;
    }
    std::map<std::wstring, std::optional<std::string>> importedBytes;
    if (!CaptureUiAutomationSettingsBytes(&importedBytes) ||
        !UiAutomationSettingsBytesEqual(exportedBytes, importedBytes)) {
        std::wstring mismatch = L"";
        for (const auto& kv : exportedBytes) {
            const auto it = importedBytes.find(kv.first);
            if (it == importedBytes.end()) {
                mismatch += L" missing:" + kv.first;
            } else if (kv.second.has_value() != it->second.has_value()) {
                mismatch += L" presence:" + kv.first;
            } else if (kv.second && it->second && *kv.second != *it->second) {
                mismatch += L" bytes:" + kv.first;
                WriteUiAutomationTextFile(root / L"__pdf_note_workspace__" / L"__tmp__" / (kv.first + L".actual_after_import"),
                                          *it->second,
                                          nullptr);
            }
        }
        restoreConfig();
        if (outError) *outError = L"Settings bundle import did not restore the exported files." + mismatch;
        return false;
    }
    std::wstring readErr;
    const auto loaded = LoadWorkspaceConfigFromFile(root / L"workspace.json", &readErr);
    if (!loaded || loaded->language != L"en" || loaded->pointerOffsetX != 17 || loaded->pointerOffsetY != -19) {
        restoreConfig();
        if (outError) *outError = L"Imported workspace.json could not be reloaded.";
        return false;
    }

    const std::string malformedBytes = "PDF_NOTE_SETTINGS_BUNDLE_V1\nworkspace.json\t8\n{broken}\nEND\n";
    const std::string duplicateBytes = "PDF_NOTE_SETTINGS_BUNDLE_V1\nworkspace.json\t16\n{\"classesDir\":\".\"}\nworkspace.json\t16\n{\"classesDir\":\".\"}\nEND\n";
    const std::string unknownBytes = "PDF_NOTE_SETTINGS_BUNDLE_V1\nworkspace.json\t16\n{\"classesDir\":\".\"}\nsecret.json\t2\n{}\nEND\n";
    std::string largeBytes = "PDF_NOTE_SETTINGS_BUNDLE_V1\nworkspace.json\t524289\n";
    largeBytes.append(524289, 'x');
    largeBytes += "\nEND\n";
    if (!WriteUiAutomationTextFile(malformed, malformedBytes, outError) ||
        !WriteUiAutomationTextFile(duplicate, duplicateBytes, outError) ||
        !WriteUiAutomationTextFile(unknown, unknownBytes, outError) ||
        !WriteUiAutomationTextFile(oversized, largeBytes, outError)) {
        restoreConfig();
        return false;
    }

    const std::filesystem::path badInputs[] = {malformed, duplicate, unknown, oversized};
    for (const auto& bad : badInputs) {
        std::map<std::wstring, std::optional<std::string>> beforeBad;
        CaptureUiAutomationSettingsBytes(&beforeBad);
        if (ImportSettingsPresetFromFile(bad, &err)) {
            restoreConfig();
            if (outError) *outError = L"Invalid settings bundle was accepted: " + bad.filename().wstring();
            return false;
        }
        std::map<std::wstring, std::optional<std::string>> afterBad;
        CaptureUiAutomationSettingsBytes(&afterBad);
        if (!UiAutomationSettingsBytesEqual(beforeBad, afterBad)) {
            restoreConfig();
            if (outError) *outError = L"Invalid settings bundle changed active settings: " + bad.filename().wstring();
            return false;
        }
    }

    SetFaultInjectionPointForAutomation(L"settings_import_after_first_aux_write");
    std::map<std::wstring, std::optional<std::string>> beforeFault;
    CaptureUiAutomationSettingsBytes(&beforeFault);
    const bool faultAccepted = ImportSettingsPresetFromFile(bundle, &err);
    ClearFaultInjectionPointForAutomation();
    std::map<std::wstring, std::optional<std::string>> afterFault;
    CaptureUiAutomationSettingsBytes(&afterFault);
    if (faultAccepted || !UiAutomationSettingsBytesEqual(beforeFault, afterFault) ||
        !SettingsImportBackupExistsForAutomation()) {
        restoreConfig();
        if (outError) *outError = L"Settings bundle fault injection did not roll back and preserve a backup.";
        return false;
    }

    restoreConfig();
    return true;
}

static bool RunUiAutomationAppLogContractScenario(std::wstring* outError) {
    if (g_workspaceRoot.empty()) {
        if (outError) *outError = L"App-log automation requires a workspace.";
        return false;
    }
    if (!IsAppLogEnabled(AppLogKind::PreviewTrace) ||
        IsAppLogEnabled(AppLogKind::SwitchTiming) ||
        !IsAppLogEnabled(AppLogKind::Crash) ||
        IsAppLogEnabled(AppLogKind::StartupWatchdog) ||
        IsAppLogEnabled(AppLogKind::OfficeConversion)) {
        if (outError) *outError = L"App-log runtime configuration did not match the workspace settings.";
        return false;
    }
    constexpr const wchar_t* kToken = L"automation-log-contract";
    AppendAppLogLine(AppLogKind::PreviewTrace, kToken);
    AppendAppLogLine(AppLogKind::SwitchTiming, kToken);
    AppendAppLogLine(AppLogKind::Crash, kToken);
    AppendAppLogLine(AppLogKind::StartupWatchdog, kToken);
    AppendAppLogLine(AppLogKind::OfficeConversion, kToken);
    // Unconfigured/relative logging has no implicit destination. Restore the
    // selected workspace even if this boundary check returns early.
    struct RestoreLogRoot {
        std::wstring root;
        ~RestoreLogRoot() { SetAppLogWorkspaceRoot(root); }
    } restore{g_workspaceRoot};
    for (const auto& root : {std::wstring{}, std::wstring(L"relative-log-root")}) {
        SetAppLogWorkspaceRoot(root);
        for (const auto kind : {AppLogKind::PreviewTrace, AppLogKind::SwitchTiming,
                               AppLogKind::Crash, AppLogKind::StartupWatchdog,
                               AppLogKind::OfficeConversion}) {
            if (!AppLogPath(kind).empty()) {
                if (outError) *outError = L"Unconfigured logs resolved an implicit write destination.";
                return false;
            }
            AppendAppLogLine(kind, kToken);
        }
    }
    return true;
}

static bool RunUiAutomationWorkspaceConfigRecoveryScenario(std::wstring* outError) {
    if (g_workspaceRoot.empty()) {
        if (outError) *outError = L"Workspace configuration recovery automation requires a workspace.";
        return false;
    }
    const std::filesystem::path root(g_workspaceRoot);
    const std::filesystem::path configPath = root / L"workspace.json";
    const std::filesystem::path escapeDir = root / L"__pdf_note_workspace__" / L"__escape__";
    std::error_code ec;
    if (std::filesystem::exists(configPath, ec) || ec) {
        if (outError) *outError = L"Corrupt workspace.json was not removed from the active workspace root.";
        return false;
    }
    ec.clear();
    if (!std::filesystem::is_directory(escapeDir, ec) || ec) {
        if (outError) *outError = L"Corrupt workspace.json was not quarantined into __escape__.";
        return false;
    }
    for (const auto& entry : std::filesystem::directory_iterator(escapeDir, ec)) {
        if (!ec && entry.is_regular_file(ec) && !ec) return true;
        ec.clear();
    }
    if (outError) *outError = L"Workspace configuration quarantine directory contained no recovered file.";
    return false;
}

struct ToolbarChildFontAutomationState {
    HFONT expected = nullptr;
    int checkedCount = 0;
    bool hasMismatch = false;
    int mismatchedControlId = 0;
};

static BOOL CALLBACK VerifyToolbarChildUIFontForAutomation(HWND child, LPARAM lParam) {
    auto* state = reinterpret_cast<ToolbarChildFontAutomationState*>(lParam);
    if (!state || !child) return FALSE;
    ++state->checkedCount;
    const HFONT actual = reinterpret_cast<HFONT>(SendMessageW(child, WM_GETFONT, 0, 0));
    if (actual == state->expected) return TRUE;
    state->hasMismatch = true;
    state->mismatchedControlId = static_cast<int>(GetWindowLongPtrW(child, GWLP_ID));
    return FALSE;
}

static bool RunUiAutomationToolbarChildFontScenario(std::wstring* outError) {
    if (!g_hPdfToolbar || !IsWindow(g_hPdfToolbar) || !g_hUIFont) {
        if (outError) *outError = L"Toolbar font automation requires an initialized toolbar and UI font.";
        return false;
    }
    ToolbarChildFontAutomationState state{};
    state.expected = g_hUIFont;
    EnumChildWindows(g_hPdfToolbar, VerifyToolbarChildUIFontForAutomation,
                     reinterpret_cast<LPARAM>(&state));
    if (state.checkedCount <= 0) {
        if (outError) *outError = L"Toolbar font automation found no toolbar controls.";
        return false;
    }
    if (state.hasMismatch) {
        if (outError) {
            *outError = L"Toolbar control is missing the common UI font (control ID " +
                        std::to_wstring(state.mismatchedControlId) + L").";
        }
        return false;
    }
    return true;
}

static bool RunUiAutomationScenarios(HWND owner, std::wstring* outError) {
    ClearFaultInjectionPointForAutomation();
    AppendUiAutomationTrace(L"automation:start");
    std::wstring configOnlyValue;
    const bool configOnly = ReadMainEnvVar(L"PDF_NOTE_SMALL_UI_AUTOMATION_CONFIG_ONLY", &configOnlyValue) &&
                            (configOnlyValue == L"1" || configOnlyValue == L"true");
    std::wstring logContractOnlyValue;
    const bool logContractOnly = ReadMainEnvVar(L"PDF_NOTE_SMALL_UI_AUTOMATION_LOG_CONTRACT_ONLY", &logContractOnlyValue) &&
                                 (logContractOnlyValue == L"1" || logContractOnlyValue == L"true");
    std::wstring configRecoveryOnlyValue;
    const bool configRecoveryOnly = ReadMainEnvVar(L"PDF_NOTE_SMALL_UI_AUTOMATION_CONFIG_RECOVERY_ONLY", &configRecoveryOnlyValue) &&
                                    (configRecoveryOnlyValue == L"1" || configRecoveryOnlyValue == L"true");
    std::wstring configUnknownFieldOnlyValue;
    const bool configUnknownFieldOnly = ReadMainEnvVar(L"PDF_NOTE_SMALL_UI_AUTOMATION_CONFIG_UNKNOWN_FIELD_ONLY", &configUnknownFieldOnlyValue) &&
                                        (configUnknownFieldOnlyValue == L"1" || configUnknownFieldOnlyValue == L"true");
    std::wstring settingsBundleOnlyValue;
    const bool settingsBundleOnly = ReadMainEnvVar(L"PDF_NOTE_SMALL_UI_AUTOMATION_SETTINGS_BUNDLE_ONLY", &settingsBundleOnlyValue) &&
                                    (settingsBundleOnlyValue == L"1" || settingsBundleOnlyValue == L"true");
    std::wstring helpVisibilityOnlyValue;
    const bool helpVisibilityOnly = ReadMainEnvVar(L"PDF_NOTE_SMALL_UI_AUTOMATION_HELP_VISIBILITY_ONLY", &helpVisibilityOnlyValue) &&
                                    (helpVisibilityOnlyValue == L"1" || helpVisibilityOnlyValue == L"true");
    std::wstring dialogOwnerVisibilityOnlyValue;
    const bool dialogOwnerVisibilityOnly = ReadMainEnvVar(
        L"PDF_NOTE_SMALL_UI_AUTOMATION_DIALOG_OWNER_VISIBILITY_ONLY", &dialogOwnerVisibilityOnlyValue) &&
        (dialogOwnerVisibilityOnlyValue == L"1" || dialogOwnerVisibilityOnlyValue == L"true");
    std::wstring outputExportOnlyValue;
    const bool outputExportOnly = ReadMainEnvVar(
        L"PDF_NOTE_SMALL_UI_AUTOMATION_OUTPUT_EXPORT_ONLY", &outputExportOnlyValue) &&
        (outputExportOnlyValue == L"1" || outputExportOnlyValue == L"true");
    std::wstring targetSessionOnlyValue;
    const bool targetSessionOnly = ReadMainEnvVar(
        L"PDF_NOTE_SMALL_UI_AUTOMATION_TARGET_SESSION_ONLY", &targetSessionOnlyValue) &&
        (targetSessionOnlyValue == L"1" || targetSessionOnlyValue == L"true");
    std::wstring pdfOnlyValue;
    const bool pdfOnly = ReadMainEnvVar(L"PDF_NOTE_SMALL_UI_AUTOMATION_PDF_ONLY", &pdfOnlyValue) &&
                         (pdfOnlyValue == L"1" || pdfOnlyValue == L"true");
    std::wstring pdfiumRawOnlyValue;
    const bool pdfiumRawOnly = ReadMainEnvVar(
        L"PDF_NOTE_SMALL_UI_AUTOMATION_PDFIUM_RAW_ONLY", &pdfiumRawOnlyValue) &&
        (pdfiumRawOnlyValue == L"1" || pdfiumRawOnlyValue == L"true");
    std::wstring mathRenderOnlyValue;
    const bool mathRenderOnly = ReadMainEnvVar(
        L"PDF_NOTE_SMALL_UI_AUTOMATION_MATH_RENDER_ONLY", &mathRenderOnlyValue) &&
        (mathRenderOnlyValue == L"1" || mathRenderOnlyValue == L"true");
    std::wstring inputAssistOnlyValue;
    const bool inputAssistOnly = ReadMainEnvVar(
        L"PDF_NOTE_SMALL_UI_AUTOMATION_INPUT_ASSIST_ONLY", &inputAssistOnlyValue) &&
        (inputAssistOnlyValue == L"1" || inputAssistOnlyValue == L"true");
    if ((configOnly ? 1 : 0) + (logContractOnly ? 1 : 0) + (configRecoveryOnly ? 1 : 0) +
        (configUnknownFieldOnly ? 1 : 0) + (settingsBundleOnly ? 1 : 0) +
        (helpVisibilityOnly ? 1 : 0) + (dialogOwnerVisibilityOnly ? 1 : 0) +
        (outputExportOnly ? 1 : 0) + (targetSessionOnly ? 1 : 0) + (pdfOnly ? 1 : 0) +
        (pdfiumRawOnly ? 1 : 0) + (mathRenderOnly ? 1 : 0) + (inputAssistOnly ? 1 : 0) > 1) {
        if (outError) *outError = L"Only one focused UI automation mode may be selected.";
        return false;
    }
    if (!RunUiAutomationToolbarChildFontScenario(outError)) {
        AppendUiAutomationTrace(L"automation:toolbar_fonts_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:toolbar_fonts_ok");
    if (configOnly) {
        if (!RunUiAutomationWorkspaceConfigRoundTripScenario(outError)) {
            AppendUiAutomationTrace(L"automation:workspace_config_roundtrip_failed");
            return false;
        }
        AppendUiAutomationTrace(L"automation:workspace_config_roundtrip_ok");
        return true;
    }
    if (logContractOnly) {
        if (!RunUiAutomationAppLogContractScenario(outError)) {
            AppendUiAutomationTrace(L"automation:app_log_contract_failed");
            return false;
        }
        AppendUiAutomationTrace(L"automation:app_log_contract_ok");
        return true;
    }
    if (configRecoveryOnly) {
        if (!RunUiAutomationWorkspaceConfigRecoveryScenario(outError)) {
            AppendUiAutomationTrace(L"automation:workspace_config_recovery_failed");
            return false;
        }
        AppendUiAutomationTrace(L"automation:workspace_config_recovery_ok");
        return true;
    }
    if (configUnknownFieldOnly) {
        if (!RunUiAutomationWorkspaceConfigUnknownFieldScenario(outError)) {
            AppendUiAutomationTrace(L"automation:workspace_config_unknown_field_failed");
            return false;
        }
        AppendUiAutomationTrace(L"automation:workspace_config_unknown_field_ok");
        return true;
    }
    if (settingsBundleOnly) {
        if (!RunUiAutomationSettingsBundleScenario(owner, outError)) {
            AppendUiAutomationTrace(L"automation:settings_bundle_failed");
            return false;
        }
        AppendUiAutomationTrace(L"automation:settings_bundle_ok");
        return true;
    }
    if (helpVisibilityOnly) {
        if (!RunUiAutomationHelpVisibilityScenario(owner, outError)) {
            AppendUiAutomationTrace(L"automation:help_visibility_failed");
            return false;
        }
        AppendUiAutomationTrace(L"automation:help_visibility_ok");
        return true;
    }
    if (dialogOwnerVisibilityOnly) {
        if (!RunUiAutomationDialogOwnerVisibilityScenario(owner, outError)) {
            AppendUiAutomationTrace(L"automation:dialog_owner_visibility_failed");
            return false;
        }
        AppendUiAutomationTrace(L"automation:dialog_owner_visibility_ok");
        return true;
    }
    if (outputExportOnly) {
        if (!EnsureUiAutomationTargetSession(owner, outError)) {
            AppendUiAutomationTrace(L"automation:ensure_target_failed");
            return false;
        }
        AppendUiAutomationTrace(L"automation:ensure_target_ok");
        if (!RunUiAutomationOutputExportScenario(owner, outError)) {
            AppendUiAutomationTrace(L"automation:output_export_failed");
            return false;
        }
        AppendUiAutomationTrace(L"automation:output_export_ok");
        return true;
    }
    if (targetSessionOnly) {
        if (!EnsureUiAutomationTargetSession(owner, outError)) {
            AppendUiAutomationTrace(L"automation:ensure_target_failed");
            return false;
        }
        AppendUiAutomationTrace(L"automation:ensure_target_ok");
        return true;
    }
    if (pdfOnly) {
        if (!EnsureUiAutomationTargetSession(owner, outError, /*openNote=*/false)) {
            AppendUiAutomationTrace(L"automation:ensure_pdf_only_failed");
            return false;
        }
        AppendUiAutomationTrace(L"automation:ensure_pdf_only_ok");
        if (!RunUiAutomationPdfKeyboardScrollScenario(owner, outError)) return false;
        AppendUiAutomationTrace(L"automation:pdf_keyboard_scroll_ok");
        return true;
    }
    if (pdfiumRawOnly) {
        if (!RunUiAutomationPdfiumRawOpenScenario(outError)) {
            AppendUiAutomationTrace(L"automation:pdfium_raw_open_failed");
            return false;
        }
        AppendUiAutomationTrace(L"automation:pdfium_raw_open_ok");
        return true;
    }
    if (inputAssistOnly) {
        if (!EnsureUiAutomationTargetSession(owner, outError)) return false;
        const auto fixture = std::filesystem::path(g_currentSessionPath) / L"note_math.md";
        std::error_code fixtureError;
        if (!std::filesystem::exists(fixture, fixtureError) || fixtureError) {
            if (outError) *outError = L"Input assist Markdown fixture was not found.";
            return false;
        }
        LoadNoteFile(owner, fixture.wstring());
        SyncBottomPaneAfterNoteLoad(owner);
        if (NormalizePathKey(g_currentNotePath) != NormalizePathKey(fixture.wstring()) ||
            !NoteInputAssistSupportsMarkup()) {
            if (outError) *outError = L"Input assist Markdown fixture could not be opened.";
            return false;
        }
        if (!RunUiAutomationInputAssistScenario(owner, outError)) return false;
        AppendUiAutomationTrace(L"automation:input_assist_ok");
        return true;
    }
    // Keep the rendering responsiveness probe independent from clipboard
    // ownership. Desktop clipboard access is external to this process and
    // cannot decide whether final publication/scroll reentry is sound.
    if (mathRenderOnly) {
        if (!EnsureUiAutomationTargetSession(owner, outError)) {
            AppendUiAutomationTrace(L"automation:ensure_target_failed");
            return false;
        }
        AppendUiAutomationTrace(L"automation:ensure_target_ok");
        std::wstring renderedClickOnlyValue;
        const bool renderedClickOnly = ReadMainEnvVar(
            L"PDF_NOTE_SMALL_UI_AUTOMATION_RENDERED_CLICK_ONLY", &renderedClickOnlyValue) &&
            (renderedClickOnlyValue == L"1" || renderedClickOnlyValue == L"true");
        if (!RunUiAutomationMathRenderScenario(owner, outError, renderedClickOnly)) {
            AppendUiAutomationTrace(renderedClickOnly ? L"automation:rendered_click_failed"
                                                     : L"automation:math_render_failed");
            return false;
        }
        AppendUiAutomationTrace(renderedClickOnly ? L"automation:rendered_click_ok"
                                                 : L"automation:math_render_ok");
        return true;
    }
    if (!RunUiAutomationHelpVisibilityScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:help_visibility_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:help_visibility_ok");
    if (!RunUiAutomationDialogOwnerVisibilityScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:dialog_owner_visibility_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:dialog_owner_visibility_ok");
    if (!EnsureUiAutomationTargetSession(owner, outError)) {
        AppendUiAutomationTrace(L"automation:ensure_target_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:ensure_target_ok");
    if (!RunUiAutomationOutputExportScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:output_export_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:output_export_ok");
    if (!RunUiAutomationSessionSortNumberingScenario(outError)) {
        AppendUiAutomationTrace(L"automation:session_sort_numbering_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:session_sort_numbering_ok");
    if (!RunUiAutomationWorkspaceConfigRoundTripScenario(outError)) {
        AppendUiAutomationTrace(L"automation:workspace_config_roundtrip_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:workspace_config_roundtrip_ok");
    if (!TestSelectionAndColorIsolationInvariants(owner, outError)) {
        AppendUiAutomationTrace(L"automation:selection_invariants_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:selection_invariants_ok");
    if (!RunUiAutomationPaletteScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:palette_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:palette_ok");
    if (!RunUiAutomationThemeSwitchScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:theme_switch_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:theme_switch_ok");
    if (!RunUiAutomationNoteInputUndoRedoScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:note_input_undo_redo_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:note_input_undo_redo_ok");
    if (!RunUiAutomationNoteSaveScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:note_save_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:note_save_ok");
    if (!RunUiAutomationNoteIntegratedSaveHistoryScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:note_integrated_save_history_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:note_integrated_save_history_ok");
    if (!RunUiAutomationNoteSwitchUndoScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:note_switch_undo_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:note_switch_undo_ok");
    if (!RunUiAutomationStagedNoteRestoreViewScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:staged_note_restore_view_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:staged_note_restore_view_ok");
    if (!RunUiAutomationNoteBoundaryCommitScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:note_boundary_commit_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:note_boundary_commit_ok");
    if (!RunUiAutomationDeferredNoteInitialInputScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:deferred_note_initial_input_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:deferred_note_initial_input_ok");
    if (!RunUiAutomationExistingNoteRenderModeSaveScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:existing_note_render_mode_save_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:existing_note_render_mode_save_ok");
    if (!RunUiAutomationPdfActiveEditSaveScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:pdf_active_edit_save_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:pdf_active_edit_save_ok");
    if (!RunUiAutomationPdfTextboxUndoRedoScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:pdf_textbox_undo_redo_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:pdf_textbox_undo_redo_ok");
    if (!RunUiAutomationPdfTextboxEscCommitScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:pdf_textbox_esc_commit_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:pdf_textbox_esc_commit_ok");
    if (!RunUiAutomationPdfTextboxTripleClickCopyFocusScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:pdf_textbox_triple_click_copy_focus_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:pdf_textbox_triple_click_copy_focus_ok");
    if (!RunUiAutomationAnnotListLatestVisibleScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:annot_list_latest_visible_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:annot_list_latest_visible_ok");
    if (!RunUiAutomationFreehandAndAnnotationHistoryScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:freehand_annotation_history_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:freehand_annotation_history_ok");
    if (!RunUiAutomationPendingLinkCancelStageScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:pending_link_cancel_stage_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:pending_link_cancel_stage_ok");
    if (!RunUiAutomationExitBoundaryCommitScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:exit_boundary_commit_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:exit_boundary_commit_ok");
    if (!RunUiAutomationNoteRollbackScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:note_rollback_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:note_rollback_ok");
    if (!RunUiAutomationPdfRollbackScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:pdf_rollback_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:pdf_rollback_ok");
    if (!RunUiAutomationStartupLastOpenScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:startup_restore_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:startup_restore_ok");
    if (!RunUiAutomationOrganizeDirtyAnnotationsScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:organize_dirty_annotations_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:organize_dirty_annotations_ok");
    if (!RunUiAutomationOperationTransactionRecoveryScenario(outError)) {
        AppendUiAutomationTrace(L"automation:operation_tx_recovery_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:operation_tx_recovery_ok");
    if (!PrepareUiAutomationStagedExitScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:staged_exit_setup_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:staged_exit_ready");
    if (!RunUiAutomationMathRenderScenario(owner, outError)) {
        AppendUiAutomationTrace(L"automation:math_render_failed");
        return false;
    }
    AppendUiAutomationTrace(L"automation:math_render_ok");
    return true;
}
